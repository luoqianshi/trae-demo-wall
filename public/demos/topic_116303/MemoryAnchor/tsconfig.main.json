{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    // TODO(ts7): `moduleResolution: node10` and `baseUrl` are deprecated in TS6
    // and removed in TS7. Migrate to `moduleResolution: bundler` + baseUrl-less
    // paths before upgrading to TypeScript 7.
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "ES2022.Error"],
    "skipLibCheck": true,
    
    /* Strict Mode */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,

    /* Output */
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,

    /* Node-specific */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"],
      "@services/*": ["src/services/*"],
      "@database/*": ["src/database/*"],
      "@ai/*": ["src/ai/*"],
      "@scraper/*": ["src/scraper/*"],
      "@config/*": ["src/config/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/services/**/*",
    "src/database/**/*",
    "src/ai/**/*",
    "src/scraper/**/*",
    "src/config/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/renderer"
  ]
}