<wxs src="../../wxs/utils.wxs" module="u" />
<view class="topbar">
  <view class="brand">🌸 星耀</view>
  <view class="clock">{{topClock}}</view>
  <view class="day">第 {{season}} 季 · 第 {{day}} 天</view>
</view>

<view class="container">
  <view class="page-title">💌 翻牌 · 1v1 信箱</view>
  <view class="page-desc">未读 {{unreadCount}} 封 · 共 {{mails.length}} 封 · 5 天未回会掉粉</view>

  <block wx:if="{{mails.length === 0}}">
    <view class="empty">📭 暂时没有粉丝来信,去房间和粉丝互动一下吧</view>
  </block>

  <view class="inbox-list">
    <view wx:for="{{mails}}" wx:key="id" class="mail-item {{item.read ? '' : 'unread'}}" data-id="{{item.id}}" bindtap="onOpenMail">
      <view class="mail-avatar">{{item.avatarChar}}</view>
      <view class="mail-body">
        <view class="mail-head">
          <text class="mail-name">{{item.from}}</text>
          <text class="mail-time">{{item.time}}</text>
        </view>
        <view class="mail-preview">{{item.text}}</view>
        <view class="mail-foot">
          <text class="mail-ttl {{item.ttlClass}}">{{item.ttlText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="overlay {{showConv ? 'show' : ''}}">
  <view class="modal" catchtap="" style="text-align:left;max-height:80vh;overflow-y:auto">
    <view style="text-align:center">
      <view class="icon">💌</view>
      <view class="title">{{curMail.from}}</view>
      <view style="color:var(--muted);font-size:24rpx;margin-bottom:20rpx">{{curMail.time}} · {{curMail.ttlText}}</view>
    </view>
    <view class="chat-box">
      <view class="bubble-row">
        <view class="av">{{curMail.avatarChar}}</view>
        <view style="flex:1">
          <view class="name"><text class="chat-name">{{curMail.from}}</text><text class="chat-time">第 {{curMail.createdDay}} 天</text></view>
          <view class="text">{{curMail.text}}</view>
        </view>
      </view>
      <view wx:if="{{curMail.reply}}" class="bubble-row me">
        <view class="av">我</view>
        <view style="flex:1">
          <view class="name"><text class="chat-name">我</text><text class="chat-time">已回复</text></view>
          <view class="text">{{curMail.reply}}</view>
        </view>
      </view>
    </view>
    <block wx:if="{{!curMail.reply}}">
      <view class="quick-replies">
        <view wx:for="{{quickReplies}}" wx:key="text" class="quick-reply" data-idx="{{index}}" bindtap="onQuickReply">{{item.text}}</view>
      </view>
      <view class="reply-area" style="margin-top:20rpx">
        <input class="reply-input" placeholder="自己写一句…" maxlength="40" value="{{myInput}}" bindinput="onInput" />
        <button class="send-btn" bindtap="onSend">发送</button>
      </view>
    </block>
    <view class="actions">
      <button class="btn ghost" bindtap="onCloseConv">关闭</button>
    </view>
  </view>
</view>

<view class="toast {{toastShow ? 'show' : ''}}">{{toast}}</view>
