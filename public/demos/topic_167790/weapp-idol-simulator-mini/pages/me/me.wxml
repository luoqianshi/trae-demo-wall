<wxs src="../../wxs/utils.wxs" module="u" />
<view class="topbar">
  <view class="brand">🌸 星耀</view>
  <view class="clock">{{topClock}}</view>
  <view class="day">第 {{season}} 季 · 第 {{day}} 天</view>
</view>

<view class="container">
  <view class="me-hero">
    <view class="me-avatar">🌸</view>
    <view class="me-name">星耀练习生</view>
    <view class="me-sub">第 {{season}} 季 · 第 {{day}} 天 · {{quit ? '已退团' : graduated ? '已毕业' : '在役'}}</view>
  </view>

  <view class="me-list">
    <view class="me-row">
      <view class="l"><text class="ic">🎤</text>唱功</view>
      <view class="r">{{stats.sing}} / 100</view>
    </view>
    <view class="me-row">
      <view class="l"><text class="ic">💃</text>舞蹈</view>
      <view class="r">{{stats.dance}} / 100</view>
    </view>
    <view class="me-row">
      <view class="l"><text class="ic">💗</text>心情</view>
      <view class="r">{{stats.mood}} / 100</view>
    </view>
    <view class="me-row">
      <view class="l"><text class="ic">🫶</text>粉丝好感</view>
      <view class="r">{{stats.fans}} / 100</view>
    </view>
  </view>

  <view class="me-list" style="margin-top:24rpx">
    <view class="me-row">
      <view class="l"><text class="ic">🏆</text>本季排名</view>
      <view class="r">{{seasonRank ? '第 ' + seasonRank + ' / 50' : '赛季进行中'}}</view>
    </view>
    <view class="me-row">
      <view class="l"><text class="ic">📅</text>已坚持</view>
      <view class="r">第 {{season}} 季 · 第 {{day}} 天</view>
    </view>
    <view class="me-row">
      <view class="l"><text class="ic">📨</text>邮件数</view>
      <view class="r">未读 {{unreadCount}} / 共 {{mails.length}} 封</view>
    </view>
    <view class="me-row">
      <view class="l"><text class="ic">💬</text>房间消息</view>
      <view class="r">{{roomLogCount}} 条</view>
    </view>
  </view>

  <view style="margin-top:32rpx">
    <button class="btn" bindtap="onForceNextDay" wx:if="{{!paused && allDone}}">⏭️ 强制进入下一天</button>
    <button class="btn ghost" bindtap="onRestart" style="margin-top:16rpx">🔄 重新开始 (清空所有数据)</button>
  </view>

  <view class="page-desc" style="text-align:center;margin-top:32rpx">
    星耀 · 偶像成长手账 v1.0<br/>
    每天 2-5 段随机日程 · 15 天一季 · 10 季毕业
  </view>
</view>

<view class="overlay {{showRestart ? 'show' : ''}}">
  <view class="modal">
    <view class="icon">🔄</view>
    <view class="title">重新开始</view>
    <p>将清空所有进度(季数、属性、邮件、聊天记录),回到第 1 季·第 1 天</p>
    <view class="actions">
      <button class="btn" bindtap="onRestartConfirm">确定重新开始</button>
      <button class="btn ghost" bindtap="onRestartCancel">取消</button>
    </view>
  </view>
</view>

<view class="toast {{toastShow ? 'show' : ''}}">{{toast}}</view>
