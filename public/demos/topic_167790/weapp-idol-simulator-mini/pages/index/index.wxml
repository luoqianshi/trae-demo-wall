<wxs src="../../wxs/utils.wxs" module="u" />
<view class="topbar">
  <view class="brand">🌸 星耀</view>
  <view class="clock">{{topClock}}</view>
  <view class="day">第 {{season}} 季 · 第 {{day}} 天</view>
</view>

<view class="stats">
  <view class="stat">
    <view class="row"><text class="lbl">🎤 唱功</text><text class="val">{{stats.sing}}</text></view>
    <view class="bar"><view class="fill fill-s1" style="width: {{stats.sing}}%"></view></view>
  </view>
  <view class="stat">
    <view class="row"><text class="lbl">💃 舞蹈</text><text class="val">{{stats.dance}}</text></view>
    <view class="bar"><view class="fill fill-s2" style="width: {{stats.dance}}%"></view></view>
  </view>
  <view class="stat">
    <view class="row"><text class="lbl">💗 心情</text><text class="val">{{stats.mood}}</text></view>
    <view class="bar"><view class="fill fill-s4" style="width: {{stats.mood}}%"></view></view>
  </view>
</view>

<view class="container">
  <view class="page-title">🏠 今日公司安排</view>
  <view class="page-desc">第 {{season}} 季 · 第 {{day}} 天 · 起始 10:00 · 每天 {{segCount}} 段</view>

  <view class="timeline">
    <view>
      <view class="label">现在</view>
      <view class="clock-now">{{topClock}}</view>
    </view>
    <view class="label">结束 24:00</view>
  </view>

  <view class="company-schedule">
    <block wx:for="{{schedule}}" wx:key="key">
      <block wx:if="{{index > 0}}">
        <view class="rest-bar {{item.minute < minute ? 'past' : ''}}">
          <text class="rest-ico">☕</text>
          <text>休息 30 分钟 · {{u.fmtMin(item.prevEndMin)}} → {{u.fmtMin(item.minute)}}</text>
        </view>
      </block>
      <view class="sched-row {{item.done ? 'done' : ''}} {{!item.done && item.minute <= minute ? 'current' : ''}}">
        <view class="when">
          <text class="time">{{u.fmtMin(item.minute)}}</text>
          <text class="lbl">→ {{u.fmtMin(item.endMin)}}</text>
        </view>
        <view class="info">
          <view class="title"><text class="emo">{{item.emo}}</text>{{item.name}}</view>
          <view class="loc">📍 {{item.loc}}</view>
          <!-- 自由时间:4 选 1 -->
          <block wx:if="{{!item.done && !paused && item.isFree}}">
            <view class="free-hint">🆓 自由时间 · 选择你想做的事</view>
            <view class="free-grid">
              <view class="free-btn" data-choice="free_dance" bindtap="onFreeChoice">💃 练舞</view>
              <view class="free-btn" data-choice="free_sing" bindtap="onFreeChoice">🎵 唱歌</view>
              <view class="free-btn" data-choice="free_rest" bindtap="onFreeChoice">😴 休息</view>
              <view class="free-btn" data-choice="free_play" bindtap="onFreeChoice">🎮 游玩</view>
            </view>
          </block>
          <!-- 普通行程:参加/休息 -->
          <block wx:elif="{{!item.done && !paused}}">
            <view class="act-row">
              <button class="act-fast" data-idx="{{index}}" data-act="do" bindtap="onDo">▶ 参加</button>
              <button class="act-skip" data-idx="{{index}}" data-act="skip" bindtap="onDo">💤 休息</button>
            </view>
            <view class="act-hint">
              <block wx:if="{{item.minute <= minute}}">选择休息可避免消耗,但会有隐形损失 · 不选默认参加</block>
              <block wx:else>⏳ 提前参加 · 将从 {{u.fmtMin(item.minute)}} 进行到 {{u.fmtMin(item.endMin)}}</block>
            </view>
          </block>
          <block wx:elif="{{item.missed}}">
            <view class="act-hint skipped">⏰ 已错过 · 时间已过</view>
          </block>
          <block wx:elif="{{item.skipped}}">
            <view class="act-hint skipped">⏭️ 主动休息 · 有隐形损失</view>
          </block>
          <block wx:elif="{{item.done}}">
            <view class="act-hint">✓ 已完成 · {{item.name}}{{item.deltaText}}</view>
          </block>
        </view>
      </view>
    </block>
  </view>

  <block wx:if="{{allDone && minute < 1440}}">
    <button class="btn" bindtap="onEndDay">⏹️ 结束行程 · 提前下班</button>
  </block>
  <block wx:if="{{minute >= 1440}}">
    <button class="btn" bindtap="onEndDay">⏭️ 收工 · 进入下一天</button>
  </block>
</view>

<view class="overlay {{showEndDay ? 'show' : ''}}" bindtap="onCloseEndDay">
  <view class="modal" catchtap="">
    <view class="icon">🌙</view>
    <view class="title">今日行程已完成</view>
    <p>所有公司安排的行程都已执行完毕 ✨</p>
    <p>可以继续自由活动(房间/翻牌),或现在就结束今天?</p>
    <view class="actions">
      <button class="btn ghost" bindtap="onContinue">继续自由活动</button>
      <button class="btn" bindtap="onEndDayConfirm">⏹️ 结束今天 · 进入下一天</button>
    </view>
  </view>
</view>

<view class="overlay {{showRanking ? 'show' : ''}}" bindtap="onCloseRank">
  <view class="modal" catchtap="">
    <view class="icon">{{rankData.isTop ? '🎉' : '💔'}}</view>
    <view class="title">{{rankData.isTop ? '恭喜入围!' : '本季未入围'}}</view>
    <p>本季综合得分: <text style="color:var(--accent);font-weight:700">{{rankData.myScore}}</text></p>
    <p>你的本季排名: 第 <text style="color:var(--accent);font-weight:700">{{rankData.meIdx}}</text> / 50</p>
    <view style="text-align:left;max-height:380rpx;overflow:auto;margin:16rpx 0">
      <view wx:for="{{rankData.npcs}}" wx:key="name" class="me-row">
        <view class="l"><text class="ic">{{item.isMe ? '⭐' : '·'}}</text>第 {{index + 1}} · {{item.name}}</view>
        <view class="r">{{u.toFixed(item.score, 1)}}</view>
      </view>
    </view>
    <view class="actions">
      <block wx:if="{{rankData.isTop}}">
        <button class="btn" bindtap="onNextSeason">✨ 继续下季</button>
        <button class="btn ghost" bindtap="onQuit">🚪 退团</button>
      </block>
      <block wx:else>
        <button class="btn" bindtap="onNextSeason">继续下季 (人气+5 / 心情-3)</button>
        <button class="btn ghost" bindtap="onQuit">🚪 退团</button>
      </block>
    </view>
  </view>
</view>

<view class="overlay {{showGraduate ? 'show' : ''}}">
  <view class="modal">
    <view class="icon">🎓</view>
    <view class="title">恭喜毕业!</view>
    <p>你已经走完 10 季旅程 ✨</p>
    <view class="actions">
      <button class="btn" bindtap="onRestart">🔄 重新开始</button>
    </view>
  </view>
</view>

<!-- 退团弹幕彩蛋 -->
<view class="danmaku-overlay {{showDanmaku ? 'show' : ''}}">
  <view class="danmaku-list">
    <view wx:for="{{danmakuLines}}" wx:key="idx" class="danmaku-line" style="top: {{item.top}}rpx; animation-delay: {{item.delay}}s; animation-duration: {{item.dur}}s;">
      <text class="danmaku-av">{{item.av}}</text>
      <text class="danmaku-text">{{item.text}}</text>
    </view>
  </view>
</view>

<!-- 退团确认弹窗 -->
<view class="overlay {{showQuitConfirm ? 'show' : ''}}">
  <view class="modal">
    <view class="icon">🥺</view>
    <view class="title">确定要退团吗?</view>
    <p>粉丝们都在等你,真的要离开吗?</p>
    <view class="actions">
      <button class="btn" bindtap="onCancelQuit">💪 再坚持一下</button>
      <button class="btn ghost" bindtap="onQuitConfirm">🚪 确认退团</button>
    </view>
  </view>
</view>

<view class="overlay {{showQuit ? 'show' : ''}}">
  <view class="modal">
    <view class="icon">🚪</view>
    <view class="title">已退团</view>
    <p>感谢这段旅程,可以重新开始</p>
    <view class="actions">
      <button class="btn" bindtap="onRestart">🔄 重新开始</button>
    </view>
  </view>
</view>

<view class="toast {{toastShow ? 'show' : ''}}">{{toast}}</view>
