<wxs src="../../wxs/utils.wxs" module="u" />
<view class="topbar">
  <view class="brand">🌸 星耀</view>
  <view class="clock">{{topClock}}</view>
  <view class="day">第 {{season}} 季 · 第 {{day}} 天</view>
</view>

<view class="container">
  <view class="page-title">💬 粉丝房间</view>
  <view class="page-desc">粉丝日常分享群 · 当前 {{topClock}} · 共 {{logs.length}} 条消息</view>

  <scroll-view class="chat-box" scroll-y="true" scroll-into-view="{{lastId}}" scroll-with-animation="true" style="max-height:1000rpx">
    <block wx:for="{{logs}}" wx:key="idx">
      <view class="bubble-row {{item.me ? 'me' : ''}}" id="msg-{{item.idx}}">
        <view class="av" style="{{item.hiddenStyle}}">{{item.av}}</view>
        <view class="bubble-content">
          <view class="name" style="{{item.hiddenStyle}}">
            <text class="chat-name">{{item.who}}</text>
            <text class="chat-time">{{item.timeLabel}}</text>
          </view>
          <view class="text">{{item.text}}</view>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="quick-replies" wx:if="{{quickReplies.length > 0}}">
    <view wx:for="{{quickReplies}}" wx:key="text" class="quick-reply" data-idx="{{index}}" bindtap="onQuickReply">{{item.text}}</view>
  </view>

  <view class="reply-area">
    <input class="reply-input" placeholder="发消息到粉丝群…" maxlength="40" value="{{myInput}}" bindinput="onInput" bindconfirm="onSend" />
    <button class="send-btn" bindtap="onSend">发送</button>
  </view>
</view>

<view class="toast {{toastShow ? 'show' : ''}}">{{toast}}</view>
