/* app.wxss — 全局样式 */
page {
  --bg: #fff5f9;
  --bg2: #fce7ef;
  --bg3: #ffffff;
  --ink: #2a1635;
  --muted: #7c6283;
  --rule: #e8d2dd;
  --accent: #ff4f9a;
  --accent-soft: #ffd6e6;
  --accent2: #a06bff;
  --gold: #f6c544;
  --mint: #5fd8c0;
  --rose: #ff7a8a;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container { padding: 24rpx 32rpx 220rpx; }

/* ===== Top clock bar ===== */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--accent);
  color: #fff;
}
.topbar .brand { font-size: 32rpx; font-weight: 700; }
.topbar .clock {
  font-size: 34rpx;
  font-weight: 700;
  background: rgba(255,255,255,0.22);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-variant-numeric: tabular-nums;
}
.topbar .day {
  font-size: 26rpx;
  background: rgba(255,255,255,0.22);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* ===== Stats grid ===== */
.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: var(--bg);
}
.stat {
  background: var(--bg3);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--rule);
}
.stat .row { display: flex; justify-content: space-between; margin-bottom: 6rpx; }
.stat .lbl { font-size: 24rpx; font-weight: 700; }
.stat .val { font-size: 28rpx; font-weight: 700; color: var(--accent); }
.stat .bar { height: 12rpx; background: var(--bg2); border-radius: 999rpx; overflow: hidden; }
.stat .fill { height: 100%; }
.fill-s1 { background: var(--accent); }
.fill-s2 { background: var(--accent2); }
.fill-s3 { background: var(--gold); }
.fill-s4 { background: var(--mint); }

/* ===== Page header ===== */
.page-title { font-size: 36rpx; font-weight: 700; margin: 16rpx 0 8rpx; }
.page-desc { font-size: 24rpx; color: var(--muted); margin-bottom: 20rpx; }

/* ===== Timeline ===== */
.timeline {
  background: var(--bg3);
  border: 1rpx solid var(--rule);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
}
.timeline .clock-now { font-size: 36rpx; font-weight: 700; color: var(--accent); }
.timeline .label { color: var(--muted); font-weight: 600; }

/* ===== Schedule row ===== */
.sched-row {
  background: var(--bg3);
  border: 3rpx solid var(--rule);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: grid;
  grid-template-columns: 140rpx 1fr;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.sched-row .when { text-align: center; }
.sched-row .when .time { font-size: 36rpx; font-weight: 700; color: var(--accent); display: block; }
.sched-row .when .lbl { font-size: 24rpx; color: var(--muted); font-weight: 600; }
.sched-row .info { min-width: 0; overflow: hidden; }
.sched-row .info .title { font-size: 30rpx; font-weight: 700; margin-bottom: 4rpx; display: flex; align-items: center; gap: 8rpx; }
.sched-row .info .title .emo { font-size: 36rpx; }
.sched-row .info .loc { font-size: 24rpx; color: var(--muted); }
.sched-row .info .delta { font-size: 24rpx; color: var(--accent2); font-weight: 700; margin-top: 4rpx; }
.sched-row .info .delta .up { color: var(--mint); margin-right: 8rpx; }
.sched-row .info .delta .down { color: var(--rose); margin-right: 8rpx; }
.sched-row.done { background: var(--bg2); opacity: 0.6; }
.sched-row.done .when .time { color: var(--mint); text-decoration: line-through; }
.sched-row.current { border-color: var(--accent); background: #fff8f3; }

.rest-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 20rpx;
  background: #f5f0e6;
  border: 2rpx dashed #d4c5a8;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  font-weight: 700;
  margin: -8rpx 0;
}
.rest-bar.past { opacity: 0.45; }
.rest-bar .rest-ico { font-size: 32rpx; }

.act-row { display: flex; gap: 16rpx; margin-top: 16rpx; width: 100%; overflow: hidden; }
.act-fast {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}
.act-skip {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  background: var(--bg3);
  color: var(--muted);
  border: 3rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}
.act-hint { font-size: 22rpx; color: var(--muted); margin-top: 10rpx; font-weight: 600; }
.act-hint.skipped { color: var(--rose); }
.act-hint.auto { color: var(--gold); }

/* ===== Free time choice ===== */
.free-hint {
  font-size: 24rpx;
  color: var(--accent2);
  font-weight: 700;
  margin-top: 12rpx;
}
.free-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
}
.free-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--bg2);
  border: 2rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}
.free-btn:active { background: var(--accent-soft); }

.btn {
  width: 100%;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 18rpx;
  padding: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 24rpx;
}
.btn.ghost {
  background: var(--bg3);
  color: var(--ink);
  border: 2rpx solid var(--rule);
}

/* ===== Modal ===== */
.overlay {
  position: fixed; inset: 0;
  background: rgba(42, 22, 53, 0.6);
  display: none;
  align-items: center; justify-content: center;
  z-index: 999;
}
.overlay.show { display: flex; }
.modal {
  width: 88%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  text-align: center;
}
.modal .icon { font-size: 80rpx; margin-bottom: 12rpx; }
.modal .title { font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx; }
.modal p { font-size: 26rpx; color: var(--ink); margin-bottom: 12rpx; }
.modal .actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 24rpx; }
.modal .actions .btn { margin-top: 0; }

/* ===== Toast ===== */
.toast {
  position: fixed; left: 50%; top: 30%;
  transform: translateX(-50%);
  background: rgba(42, 22, 53, 0.86);
  color: #fff;
  padding: 18rpx 30rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  z-index: 9999;
  display: none;
  white-space: nowrap;
}
.toast.show { display: block; }

/* ===== Mail list ===== */
.inbox-list { display: flex; flex-direction: column; gap: 16rpx; }
.mail-item {
  background: var(--bg3);
  border: 1rpx solid var(--rule);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}
.mail-item.unread { background: #fff8f3; }
.mail-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 28rpx;
  flex-shrink: 0;
}
.mail-body { flex: 1; min-width: 0; }
.mail-head { display: flex; justify-content: space-between; margin-bottom: 4rpx; }
.mail-name { font-size: 28rpx; font-weight: 700; }
.mail-time { font-size: 22rpx; color: var(--muted); }
.mail-preview { font-size: 26rpx; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mail-ttl { display: inline-block; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: var(--bg2); color: var(--muted); font-weight: 700; }
.mail-ttl.warn { background: #fff3d6; color: #b8730a; }
.mail-ttl.urgent { background: var(--rose); color: #fff; }

.empty { text-align: center; color: var(--muted); padding: 80rpx 0; font-size: 28rpx; }

/* ===== Chat (room / mail conv) ===== */
.chat-box {
  background: var(--bg);
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--rule);
  max-height: 880rpx;
  min-height: 600rpx;
}
.bubble-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; align-items: flex-start; }
.bubble-row.me { flex-direction: row-reverse; }
.bubble-content { min-width: 0; display: flex; flex-direction: column; }
.bubble-row.me .bubble-content { align-items: flex-end; }
.bubble-row:not(.me) .bubble-content { align-items: flex-start; max-width: 75%; }
.av {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--accent2);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700;
  flex-shrink: 0;
}
.bubble-row.me .av { background: var(--gold); color: #5a3a00; }
.bubble-row .name { font-size: 22rpx; color: var(--muted); margin-bottom: 4rpx; font-weight: 600; display: flex; gap: 10rpx; align-items: baseline; }
.chat-name { color: var(--ink); font-weight: 700; font-size: 24rpx; }
.chat-time { font-size: 20rpx; color: var(--muted); font-weight: 500; }
.bubble-row .text {
  max-width: 100%;
  padding: 14rpx 20rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: var(--bg3);
  border: 1rpx solid var(--rule);
  word-wrap: break-word;
  display: inline-block;
}
.bubble-row.me .text { background: var(--accent); color: #fff; border: none; }

.reply-area {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0;
  margin-top: 16rpx;
}
.reply-input {
  flex: 1;
  padding: 16rpx 24rpx;
  border: 3rpx solid var(--rule);
  border-radius: 999rpx;
  font-size: 28rpx;
  background: var(--bg);
}
.send-btn {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.quick-replies { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.quick-reply {
  padding: 12rpx 22rpx;
  background: var(--bg2);
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ===== Me page ===== */
.me-hero {
  background: var(--accent);
  color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.me-avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 700;
  margin: 0 auto 16rpx;
}
.me-name { font-size: 36rpx; font-weight: 700; }
.me-sub { font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; }

.me-list { background: var(--bg3); border-radius: 24rpx; overflow: hidden; }
.me-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--rule);
}
.me-row:last-child { border-bottom: none; }
.me-row .l { font-size: 28rpx; font-weight: 600; display: flex; align-items: center; gap: 12rpx; }
.me-row .l .ic { font-size: 32rpx; }
.me-row .r { font-size: 28rpx; color: var(--muted); font-weight: 600; }

.rank-table { width: 100%; border-collapse: collapse; margin: 12rpx 0; }
.rank-table th, .rank-table td { padding: 6rpx 4rpx; font-size: 22rpx; text-align: left; }
.rank-table .me { color: var(--accent); font-weight: 700; }

/* ===== Danmaku (退团弹幕彩蛋) ===== */
.danmaku-overlay {
  position: fixed; inset: 0;
  background: rgba(42, 22, 53, 0.85);
  z-index: 9998;
  display: none;
  overflow: hidden;
}
.danmaku-overlay.show { display: block; }
.danmaku-list { position: relative; width: 100%; height: 100%; }
.danmaku-line {
  position: absolute;
  left: 100%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
  animation: danmaku-scroll linear forwards;
}
.danmaku-av {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: var(--accent2);
  color: #fff;
  font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.danmaku-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}
@keyframes danmaku-scroll {
  from { left: 100%; }
  to { left: -120%; }
}
