/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e8d2dd;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  gap: 4rpx;
}
.tab-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 2rpx;
}
.tab-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #7c6283;
}
.tab-item.active .tab-icon {
  transform: scale(1.15);
  transition: transform 0.2s;
}
.tab-item.active .tab-text {
  color: #ff4f9a;
  font-weight: 700;
  font-size: 26rpx;
}
.tab-badge {
  position: absolute;
  top: 8rpx;
  right: 50%;
  margin-right: -40rpx;
  background: #ff4f9a;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 0 6rpx;
}
