// wxs/utils.wxs — WXML 工具函数
var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
module.exports = {
  fmtMin: function(m) { return pad(Math.floor(m / 60)) + ':' + pad(m % 60); },
  toFixed: function(v, n) {
    n = n || 1;
    if (typeof v !== 'number') v = parseFloat(v) || 0;
    return v.toFixed(n);
  }
};
