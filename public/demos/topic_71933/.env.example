# ===== 应用配置 =====
APP_NAME=一键搬运
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 存储路径 =====
STORAGE_DIR=./storage
TEMP_DIR=./storage/temp
OUTPUT_DIR=./storage/output

# ===== 快手开放平台 =====
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=
KUAISHOU_REDIRECT_URI=http://localhost:8000/api/v1/auth/kuaishou/callback

# ===== 抖音开放平台（β阶段启用） =====
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=

# ===== 下载配置 =====
DOWNLOAD_TIMEOUT=120
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_CONCURRENCY=3

# ===== 去重配置 =====
DEDUP_SPEED_MIN=0.95
DEDUP_SPEED_MAX=1.05
DEDUP_RANDOM_PADDING_BYTES=1024
