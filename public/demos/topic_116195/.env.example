# ==================== Django核心配置 ====================
# 密钥（生产环境必须修改）
SECRET_KEY=your-secret-key-here-change-in-production

# 调试模式（生产环境设为False）
DEBUG=True

# 允许的主机（生产环境配置具体域名，多个用逗号分隔）
ALLOWED_HOSTS=*

# ==================== 数据库配置 ====================
# 开发环境默认使用SQLite，无需配置
# 生产环境使用MySQL时取消注释以下配置
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=code_diagnosis_platform
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306

# ==================== Ollama配置（本地LLM） ====================
# Ollama服务地址
OLLAMA_BASE_URL=http://localhost:11434

# 使用的模型名称
OLLAMA_MODEL=qwen2.5-coder:7b

# 请求超时时间（秒）
OLLAMA_TIMEOUT=30

# ==================== Redis配置 ====================
# Redis主机地址
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis数据库编号
REDIS_DB=0

# ==================== 日志配置 ====================
# Django日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
DJANGO_LOG_LEVEL=INFO
