/* 我的页面样式 */
.settings-page {
  padding: 0 0 40rpx;
  background: #FFF9F2;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部欢迎卡片 ---------- */
.profile-card {
  margin: 24rpx 32rpx 0;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FFA76A 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.25);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 48rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.profile-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* ---------- 通用 section ---------- */
.settings-section {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-header {
  font-size: 24rpx;
  color: #A0A0A0;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.settings-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-label {
  font-size: 30rpx;
  color: #2D2D2D;
}

.settings-value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.settings-value {
  font-size: 28rpx;
  color: #6B6B6B;
}

.settings-arrow {
  font-size: 32rpx;
  color: #A0A0A0;
  font-weight: 700;
}

/* ---------- 学习数据统计网格 ---------- */
.stats-grid {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #F0E8E0;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF8C42;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #A0A0A0;
}

/* ---------- 成就徽章网格 ---------- */
.badges-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(25% - 12rpx);
  padding: 12rpx 0;
}

.badge-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.badge-name {
  font-size: 22rpx;
  color: #2D2D2D;
  text-align: center;
}

.badge-locked {
  opacity: 0.35;
}

.badge-unlocked {
  opacity: 1;
}

/* ---------- 重置按钮 ---------- */
.reset-section {
  margin: 40rpx 32rpx;
}

.reset-btn {
  width: 100%;
  height: 80rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  min-height: auto;
  background: transparent;
  color: #FF5252;
  font-size: 28rpx;
  border: 2rpx solid #FFCDD2;
  border-radius: 40rpx;
}

.reset-btn::after {
  border: none;
}

.reset-btn:active {
  background: #FFEBEE;
}
