<view class="page settings-page">

  <!-- 顶部欢迎区 -->
  <view class="profile-card">
    <view class="avatar">
      <text class="avatar-emoji">📚</text>
    </view>
    <view class="profile-info">
      <text class="profile-greeting">你好，小同学！</text>
      <text class="profile-sub">{{currentGradeName}}{{currentTermName}} · 语文学习中</text>
    </view>
  </view>

  <!-- 学习数据概览 -->
  <view class="settings-section">
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{stats.completedLessons}}</text>
        <text class="stat-label">已完成课</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{stats.streak}}</text>
        <text class="stat-label">连续打卡</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{achievements.length}}</text>
        <text class="stat-label">成就徽章</text>
      </view>
    </view>
  </view>

  <!-- 学习设置 -->
  <view class="settings-section">
    <view class="section-header">学习设置</view>
    <view class="settings-row" bindtap="onChangeGrade">
      <text class="settings-label">学习年级</text>
      <view class="settings-value-row">
        <text class="settings-value">{{currentGradeName}}</text>
        <text class="settings-arrow">›</text>
      </view>
    </view>
    <view class="settings-row" bindtap="onChangeTerm">
      <text class="settings-label">学期</text>
      <view class="settings-value-row">
        <text class="settings-value">{{currentTermName}}</text>
        <text class="settings-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 成就徽章 -->
  <view class="settings-section">
    <view class="section-header">成就徽章</view>
    <view class="badges-grid">
      <view
        wx:for="{{achievements}}"
        wx:for-item="badge"
        wx:key="id"
        class="badge-item {{badge.unlockedAt ? 'badge-unlocked' : 'badge-locked'}}"
      >
        <text class="badge-icon">{{badge.unlockedAt ? badge.icon : '🔒'}}</text>
        <text class="badge-name">{{badge.name}}</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="settings-section">
    <view class="section-header">关于</view>
    <view class="settings-row" bindtap="onShowPrivacy">
      <text class="settings-label">隐私协议</text>
      <view class="settings-value-row">
        <text class="settings-arrow">›</text>
      </view>
    </view>
    <view class="settings-row" bindtap="onShowAgreement">
      <text class="settings-label">用户协议</text>
      <view class="settings-value-row">
        <text class="settings-arrow">›</text>
      </view>
    </view>
    <view class="settings-row">
      <text class="settings-label">版本</text>
      <text class="settings-value">1.0.0</text>
    </view>
    <view class="settings-row">
      <text class="settings-label">伴学小程序</text>
      <text class="settings-value">用 AI 陪伴成长</text>
    </view>
  </view>

  <!-- 重置按钮 -->
  <view class="reset-section">
    <button class="reset-btn" bindtap="onResetProgress">重置学习进度</button>
  </view>

</view>
