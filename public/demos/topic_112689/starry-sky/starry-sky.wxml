<view class="page-container">
  <view class="starry-header">
    <view class="header-info">
      <text class="title-main">{{gradeName}}古诗星空</text>
      <text class="title-sub">已收集 {{learnedCount}}/{{totalCount}} 颗星</text>
    </view>
  </view>

  <view class="canvas-wrap">
    <canvas canvas-id="starryCanvas" class="starry-canvas"></canvas>
    <view class="canvas-touch-layer" bindtap="onCanvasTap"></view>
  </view>

  <view class="poem-popup" wx:if="{{showPopup}}">
    <view class="popup-mask" bindtap="hidePopup"></view>
    <view class="popup-card">
      <view class="popup-star-decor left">✦</view>
      <view class="popup-star-decor right">✧</view>
      <view class="popup-close" bindtap="hidePopup">×</view>
      <view class="popup-body">
        <view class="poem-title">
          <rich-text nodes="{{popupTitleHtml}}"></rich-text>
        </view>
        <view class="poem-author" wx:if="{{popupAuthorHtml}}">
          <rich-text nodes="{{popupAuthorHtml}}"></rich-text>
        </view>
        <view class="poem-divider"></view>
        <view class="poem-content">
          <view wx:for="{{popupPoemLines}}" wx:key="text" wx:for-item="line" class="poem-line">
            <rich-text nodes="{{line.html}}"></rich-text>
          </view>
        </view>
      </view>
      <view class="popup-footer">
        <button class="btn-recite {{isPlaying ? 'playing' : ''}}" bindtap="recitePoem">
          <text class="btn-icon">{{isPlaying ? '⏸' : '🔊'}}</text>
          <text class="btn-text">{{isPlaying ? '停止朗读' : '朗读古诗'}}</text>
        </button>
        <button class="btn-learned" wx:if="{{selectedPoem && !selectedPoem.learned}}" bindtap="markAsLearned">
          <text class="btn-icon">⭐</text>
          <text class="btn-text">点亮这颗星</text>
        </button>
      </view>
    </view>
  </view>
</view>
