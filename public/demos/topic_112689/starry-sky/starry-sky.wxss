.page-container {
  width: 100vw;
  height: 100vh;
  background: #0a0e27;
  position: relative;
  overflow: hidden;
}

.starry-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 70rpx 32rpx 28rpx;
  background: linear-gradient(180deg, rgba(10,14,39,0.95) 0%, rgba(10,14,39,0.5) 80%, transparent 100%);
}

.header-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title-main {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFD700;
  text-shadow: 0 0 20rpx rgba(255,215,0,0.5);
}

.title-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  letter-spacing: 2rpx;
}

.canvas-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.starry-canvas {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.canvas-touch-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
}

.poem-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(5,8,20,0.85);
}

.popup-card {
  position: relative;
  width: 640rpx;
  background: linear-gradient(160deg, #1a1f3a 0%, #0f1329 100%);
  border-radius: 32rpx;
  border: 2rpx solid rgba(255,215,0,0.2);
  box-shadow: 0 0 80rpx rgba(255,215,0,0.15), 0 20rpx 60rpx rgba(0,0,0,0.5);
  padding: 56rpx 44rpx 40rpx;
  animation: popupIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes popupIn {
  from { opacity: 0; transform: scale(0.8) translateY(40rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.popup-star-decor {
  position: absolute;
  font-size: 40rpx;
  color: #FFD700;
  opacity: 0.4;
}
.popup-star-decor.left { top: 24rpx; left: 28rpx; }
.popup-star-decor.right { bottom: 24rpx; right: 28rpx; font-size: 28rpx; }

.popup-close {
  position: absolute;
  top: 20rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: rgba(255,255,255,0.5);
  z-index: 2;
}

.popup-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poem-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFD700;
  text-shadow: 0 0 20rpx rgba(255,215,0,0.3);
  margin-bottom: 16rpx;
  text-align: center;
}

.poem-author {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 28rpx;
}

.poem-divider {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,215,0,0.4), transparent);
  margin-bottom: 32rpx;
}

.poem-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.poem-line {
  font-size: 38rpx;
  color: #fff;
  letter-spacing: 8rpx;
  line-height: 1.8;
  text-align: center;
}

.popup-footer {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.btn-recite, .btn-learned {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 40rpx;
  height: 76rpx;
  min-height: auto;
  margin: 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
  line-height: 1;
}

.btn-recite {
  background: linear-gradient(135deg, rgba(100,200,255,0.2), rgba(100,200,255,0.05));
  color: #7dd3fc;
  border: 2rpx solid rgba(125,211,252,0.3);
}

.btn-recite.playing {
  background: linear-gradient(135deg, rgba(255,100,100,0.25), rgba(255,100,100,0.08));
  color: #fca5a5;
  border-color: rgba(252,165,165,0.4);
}

.btn-recite::after {
  border: none;
}

.btn-learned {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #1a1f3a;
  font-weight: 700;
}

.btn-learned::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
}
