<view class="page">
  <!-- 顶部品牌区域 -->
  <view class="brand">
    <text class="brand-title">伴学</text>
    <text class="brand-subtitle">开始今天的学习</text>
  </view>

  <!-- 步骤一：选择年级 -->
  <view class="step">
    <text class="step-title">① 选择年级</text>
    <view class="capsule-list">
      <view
        wx:for="{{grades}}"
        wx:key="id"
        class="capsule {{selectedGrade && selectedGrade.id === item.id ? 'capsule-active' : ''}}"
        bind:tap="selectGrade"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 步骤二：选择学期 -->
  <view class="step" wx:if="{{terms.length > 0}}">
    <text class="step-title">② 选择学期</text>
    <view class="capsule-list">
      <view
        wx:for="{{terms}}"
        wx:key="id"
        class="capsule {{selectedTerm && selectedTerm.id === item.id ? 'capsule-active' : ''}}"
        bind:tap="selectTerm"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 步骤三：选择学科 -->
  <view class="step" wx:if="{{subjects.length > 0}}">
    <text class="step-title">③ 选择学科</text>
    <view class="capsule-list">
      <view
        wx:for="{{subjects}}"
        wx:key="id"
        class="capsule {{selectedSubject && selectedSubject.id === item.id ? 'capsule-active' : ''}}"
        bind:tap="selectSubject"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 底部固定按钮 -->
  <view class="footer">
    <button
      class="start-btn {{canStart ? 'start-btn-active' : 'start-btn-disabled'}}"
      disabled="{{!canStart}}"
      bind:tap="startLearning"
    >
      开始学习
    </button>
  </view>
</view>