.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 160rpx;
  background-color: var(--color-surface);
  box-sizing: border-box;
}

/* 品牌区域 */
.brand {
  margin-bottom: 48rpx;
  text-align: center;
}
.brand-title {
  display: block;
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  line-height: 1.3;
}
.brand-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-regular);
}

/* 选择步骤 */
.step {
  margin-bottom: 40rpx;
}
.step-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

/* 胶囊列表 */
.capsule-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 胶囊按钮 */
.capsule {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: 9999rpx;
  background: #fff;
  border: 2rpx solid #E0D8D0;
  box-sizing: border-box;
  transition: all 0.2s ease;
}
.capsule text {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

/* 选中态 */
.capsule-active {
  background: #FF8C42;
  border-color: #FF8C42;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.25);
}
.capsule-active text {
  color: #fff;
}

/* 底部固定按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(to top, var(--color-surface) 60%, transparent);
  z-index: 10;
}

.start-btn {
  width: 100%;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  min-height: auto;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  border: none;
  outline: none;
  transition: all 0.2s ease;
}

.start-btn::after {
  border: none;
}

.start-btn-active {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 66, 0.3);
}
.start-btn-active:active {
  opacity: 0.85;
}

.start-btn-disabled {
  background: #E0D8D0;
  color: #fff;
}