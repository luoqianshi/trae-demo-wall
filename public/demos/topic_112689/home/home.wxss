/* 课程列表页样式 — 与 app.wxss 品牌变量一致 */

.page {
  padding-bottom: 20rpx;
}

/* ---------- 年级·学期·学科标签 ---------- */
.selector-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  background-color: var(--color-background);
}

.selector-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 40rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary);
  box-shadow: var(--shadow-card);
}

.selector-text {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: #FFFFFF;
}

.selector-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---------- Hero 插画区 ---------- */
.hero-section {
  padding: 8rpx 32rpx 32rpx;
  background-color: var(--color-background);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-image {
  width: 100%;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-elevated);
}

.hero-slogan {
  margin-top: 24rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

/* ---------- 每日打卡卡片 ---------- */
.checkin-card {
  padding: 8rpx 32rpx 0;
}

.checkin-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.checkin-inner.checked-in {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border: 2rpx solid rgba(255, 213, 79, 0.4);
}

.checkin-inner.not-checked {
  background-color: var(--color-surface);
  border: 2rpx solid var(--color-border);
}

.checkin-icon {
  font-size: 56rpx;
  flex-shrink: 0;
}

.checkin-info {
  flex: 1;
  min-width: 0;
}

.checkin-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.checkin-streak-num {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary-dark);
}

.checkin-streak-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.checkin-status {
  margin-left: auto;
  font-size: var(--font-size-xs);
  color: var(--color-text-hint);
}

.checkin-sub {
  margin-top: 4rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

/* ---------- 学习进度摘要 ---------- */
.progress-summary {
  padding: 24rpx 32rpx 0;
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.progress-count {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.progress-bar-bg {
  width: 100%;
  height: 6rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-divider);
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background-color: var(--color-primary);
  border-radius: var(--radius-full);
  transition: width 0.4s ease;
}

/* ---------- 课程列表 ---------- */
.course-list {
  padding: 32rpx 32rpx 0;
}

/* 单元分组 */
.unit-section {
  margin-bottom: 40rpx;
}

.unit-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.unit-icon {
  font-size: 36rpx;
}

.unit-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

/* 课程卡片网格 */
.lesson-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.lesson-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-background);
  box-shadow: var(--shadow-card);
  min-height: 144rpx;
}

/* 序号徽章 */
.lesson-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lesson-badge.completed {
  background-color: var(--color-primary);
  color: #FFFFFF;
  font-weight: var(--font-weight-bold);
}

.lesson-badge.in_progress {
  background-color: var(--color-primary-lighter);
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.lesson-badge.not_started {
  background-color: var(--color-divider);
  color: var(--color-text-hint);
  font-weight: var(--font-weight-medium);
}

.badge-num {
  font-size: var(--font-size-sm);
}

/* 课程卡片内容区 */
.lesson-body {
  flex: 1;
  min-width: 0;
}

.lesson-title {
  display: block;
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: 1.4;
}

.lesson-type-tag {
  display: inline-block;
  margin-top: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  background-color: var(--color-secondary-lighter);
  color: var(--color-secondary-dark);
}

.lesson-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

/* 进度状态点 */
.progress-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.progress-dot.completed {
  background-color: var(--color-progress-dot-active);
  box-shadow: 0 0 6rpx rgba(255, 140, 66, 0.5);
}

.progress-dot.in_progress {
  background: linear-gradient(90deg, var(--color-progress-dot-active) 50%, var(--color-progress-dot-inactive) 50%);
  box-shadow: 0 0 4rpx rgba(255, 140, 66, 0.3);
  animation: star-glow 2s ease-in-out infinite;
}

.progress-dot.not_started {
  background-color: var(--color-progress-dot-inactive);
}

.progress-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-hint);
}

/* 空状态 / 加载中 */
.empty-state,
.loading-state {
  text-align: center;
  padding: 64rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-hint);
}

/* 进度点发光动画 */
@keyframes star-glow {
  0%, 100% { box-shadow: 0 0 4rpx rgba(255, 140, 66, 0.3); }
  50% { box-shadow: 0 0 8rpx rgba(255, 140, 66, 0.6); }
}