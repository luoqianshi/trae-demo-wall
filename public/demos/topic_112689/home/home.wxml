<!-- 课程列表首页 -->
<view class="page">

  <!-- 年级·学期·学科标签 -->
  <view class="selector-bar">
    <view class="selector-tag" bindtap="goIndex">
      <text class="selector-text">{{gradeName}} · {{termName}} · {{subjectName}}</text>
      <text class="selector-arrow">▼</text>
    </view>
  </view>

  <!-- Hero 插画区 -->
  <view class="hero-section">
    <image class="hero-image" src="../../assets/hero-illustration.jpg" mode="widthFix" />
    <text class="hero-slogan">开始今天的学习吧！</text>
  </view>

  <!-- 每日打卡卡片 -->
  <view class="checkin-card" wx:if="{{checkedIn}}">
    <view class="checkin-inner checked-in">
      <text class="checkin-icon">🔥</text>
      <view class="checkin-info">
        <view class="checkin-row">
          <text class="checkin-streak-num">{{streak}}</text>
          <text class="checkin-streak-label">天连续</text>
          <text class="checkin-status">今日已打卡</text>
        </view>
        <text class="checkin-sub">已连续 {{streak}} 天，累计 {{totalDays}} 天 👍</text>
      </view>
    </view>
  </view>
  <view class="checkin-card" wx:else>
    <view class="checkin-inner not-checked">
      <text class="checkin-icon">📅</text>
      <view class="checkin-info">
        <view class="checkin-row">
          <text class="checkin-streak-num">{{streak}}</text>
          <text class="checkin-streak-label">天连续</text>
          <text class="checkin-status">今日还未打卡</text>
        </view>
        <text class="checkin-sub">完成一节课即可自动打卡</text>
      </view>
    </view>
  </view>

  <!-- 学习进度摘要 -->
  <view class="progress-summary" wx:if="{{totalCount > 0}}">
    <view class="progress-header">
      <text class="progress-label">学习进度</text>
      <text class="progress-count">{{completedCount}}/{{totalCount}} 课 · {{progressPercent}}%</text>
    </view>
    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <!-- 课程列表：按单元分组 -->
  <view class="course-list">
    <block wx:for="{{units}}" wx:key="id" wx:for-item="unit">
      <view class="unit-section">
        <view class="unit-title">
          <text class="unit-icon">{{unit.icon}}</text>
          <rich-text class="unit-name" nodes="{{unit.titlePinyin}}"></rich-text>
        </view>
        <view class="lesson-grid">
          <view
            class="lesson-card"
            wx:for="{{unit.lessons}}"
            wx:key="id"
            wx:for-item="lesson"
            data-grade="{{gradeId}}"
            data-term="{{termId}}"
            data-subject="{{subjectId}}"
            data-unit="{{unit.id}}"
            data-lesson="{{lesson.id}}"
            bindtap="goLesson"
          >
            <view class="lesson-badge {{lesson.state}}">
              <text class="badge-num">{{lesson.no}}</text>
            </view>
            <view class="lesson-body">
              <rich-text class="lesson-title" nodes="{{lesson.titlePinyin}}"></rich-text>
              <text class="lesson-type-tag" wx:if="{{lesson.type === 'poem'}}">古诗</text>
              <view class="lesson-progress">
                <view class="progress-dot {{lesson.state}}"></view>
                <text class="progress-text">
                  <text wx:if="{{lesson.state === 'completed'}}">已完成</text>
                  <text wx:elif="{{lesson.state === 'in_progress'}}">学习中</text>
                  <text wx:else>未开始</text>
                </text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:if="{{units.length === 0 && !loading}}">
      <text>该年级/学期/学科暂无课程数据</text>
    </view>
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中…</text>
    </view>
  </view>

</view>