/* 课程详情页样式 */
.lesson-page {
  padding-bottom: 120rpx;
  background: #FFF9F2;
  min-height: 100vh;
}

/* 课程标题区 */
.lesson-header {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
}

.lesson-badge {
  width: 48rpx;
  height: 48rpx;
  background: #FF8C42;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.lesson-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D2D2D;
  line-height: 1.3;
}

/* 古诗卡片 */
.poem-card {
  margin: 0 32rpx 24rpx;
  background: #E8F4FF;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
}

.poem-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.poem-meta {
  font-size: 26rpx;
  color: #6B6B6B;
  margin-bottom: 20rpx;
}

.poem-divider {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,140,66,0.3), transparent);
  margin: 0 auto 24rpx;
}

.poem-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.poem-line {
  font-size: 32rpx;
  color: #2D2D2D;
  line-height: 2;
  text-align: center;
}

.poem-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.recite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 36rpx;
  height: 64rpx;
  min-height: auto;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #1976D2;
  background: rgba(25,118,210,0.08);
  border: 2rpx solid rgba(25,118,210,0.25);
  line-height: 1;
  margin: 0;
}

.recite-btn::after {
  border: none;
}

.recite-btn.reciting {
  color: #D32F2F;
  background: rgba(211,47,47,0.08);
  border-color: rgba(211,47,47,0.25);
}

.recite-icon {
  font-size: 28rpx;
}

/* 视频区 */
.video-section {
  margin: 0 32rpx 24rpx;
}

.video-placeholder {
  background: #F0E8E0;
  border-radius: 16rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-hint {
  font-size: 28rpx;
  color: #A0A0A0;
}

.video-player {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
}

/* 闯关区 */
.quiz-section {
  margin: 0 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2D2D;
  margin-bottom: 20rpx;
}

.question-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.question-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2D2D;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* 选项按钮 — 胶囊样式 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 2rpx solid #F0E8E0;
  border-radius: 40rpx;
  background: #FFFFFF;
  transition: all 0.2s ease;
}

.option-item:active {
  opacity: 0.8;
}

.option-selected {
  border-width: 2rpx;
}

.option-correct {
  border-color: #4CAF50;
  background: #E8F5E9;
}

.option-wrong {
  border-color: #FF5252;
  background: #FFEBEE;
}

.option-label {
  width: 40rpx;
  height: 40rpx;
  background: #FFF0E0;
  color: #FF8C42;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.option-text {
  font-size: 28rpx;
  color: #2D2D2D;
  flex: 1;
}

.option-feedback {
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.feedback-correct {
  color: #4CAF50;
}

.feedback-wrong {
  color: #FF5252;
}

/* 结果反馈横幅 */
.result-banner {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: center;
}

.result-correct {
  background: #E8F5E9;
  color: #2E7D32;
}

.result-wrong {
  background: #FFEBEE;
  color: #C62828;
}

/* 底部固定按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.04);
}

.complete-btn {
  width: 100%;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  min-height: auto;
  background: #FF8C42;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 44rpx;
  border: none;
}

.complete-btn::after {
  border: none;
}

.complete-btn:active {
  opacity: 0.85;
}