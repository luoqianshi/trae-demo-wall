<view class="page lesson-page">
  <!-- 课程标题区 -->
  <view class="lesson-header">
    <view class="lesson-badge">{{lessonNo}}</view>
    <rich-text class="lesson-title" nodes="{{lessonTitle}}"></rich-text>
  </view>

  <!-- 古诗区（type===poem 时显示） -->
  <view wx:if="{{lessonType === 'poem' && poemLines.length}}" class="poem-card">
    <view class="poem-title"><rich-text nodes="{{poemName}}"></rich-text></view>
    <view class="poem-meta"><rich-text nodes="{{poemMeta}}"></rich-text></view>
    <view class="poem-divider"></view>
    <view class="poem-body">
      <view wx:for="{{poemLines}}" wx:for-item="line" wx:key="text" class="poem-line">
        <rich-text nodes="{{line.html}}"></rich-text>
      </view>
    </view>
    <view class="poem-actions">
      <button class="recite-btn {{isReciting ? 'reciting' : ''}}" bindtap="onRecite">
        <text class="recite-icon">{{isReciting ? '⏸' : '🔊'}}</text>
        <text>{{isReciting ? '停止朗读' : '朗读古诗'}}</text>
      </button>
    </view>
  </view>

  <!-- 视频/动画播放区 -->
  <view class="video-section">
    <view class="video-placeholder">
      <text class="video-hint" wx:if="{{!videoUrl}}">视频正在制作中</text>
      <video wx:else src="{{videoUrl}}" controls class="video-player"></video>
    </view>
  </view>

  <!-- 闯关时间：题目列表 -->
  <view class="quiz-section">
    <view class="section-title">闯关时间</view>
    <view wx:for="{{interactions}}" wx:for-item="q" wx:key="id" class="question-card">
      <view class="question-text">
        <rich-text nodes="{{q.renderedQuestion}}"></rich-text>
      </view>
      <view class="options-list">
        <view
          wx:for="{{q.options}}"
          wx:for-item="opt"
          wx:for-index="optIndex"
          wx:key="optIndex"
          class="option-item {{q.selectedIndex === optIndex ? (q.isCorrect ? 'option-correct' : 'option-wrong') : ''}} {{q.selectedIndex === optIndex ? 'option-selected' : ''}}"
          data-question-id="{{q.id}}"
          data-answer-index="{{optIndex}}"
          bindtap="onOptionTap"
        >
          <text class="option-label">{{optIndex + 1}}</text>
          <rich-text class="option-text" nodes="{{q.renderedOptions[optIndex]}}"></rich-text>
          <text wx:if="{{q.selectedIndex === optIndex && q.isCorrect}}" class="option-feedback feedback-correct">✓</text>
          <text wx:if="{{q.selectedIndex === optIndex && !q.isCorrect}}" class="option-feedback feedback-wrong">✗</text>
        </view>
      </view>
      <view wx:if="{{q.showResult}}" class="result-banner {{q.isCorrect ? 'result-correct' : 'result-wrong'}}">
        <text wx:if="{{q.isCorrect}}">回答正确！太棒了！</text>
        <text wx:if="{{!q.isCorrect}}">答错了，正确答案是第 {{q.correctIndex + 1}} 项</text>
      </view>
    </view>
  </view>

  <!-- 底部固定按钮 -->
  <view class="bottom-bar">
    <button class="complete-btn" bindtap="onComplete">完成本期课程</button>
  </view>
</view>