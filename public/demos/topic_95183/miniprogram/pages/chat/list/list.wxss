.chat-list-container {
  min-height: 100vh;
}

.sprout-card {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #FFF8E1, #FFF0F5);
  box-shadow: var(--shadow-pink);
}

.sprout-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sprout-title {
  display: block;
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 700;
}

.sprout-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

.sprout-scroll {
  white-space: nowrap;
}

.sprout-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 150rpx;
  margin-right: 22rpx;
  padding: 18rpx 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
}

.sprout-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  font-size: 42rpx;
}

.sprout-name {
  display: block;
  width: 100%;
  margin-top: 10rpx;
  font-size: 24rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sprout-time {
  color: var(--text-sub);
  font-size: 20rpx;
}

.sprout-match-btn {
  margin-top: 10rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.5;
}

.sprout-match-btn::after {
  border: none;
}

.match-list {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-pink);
}

.match-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.match-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  font-size: 48rpx;
  flex-shrink: 0;
}

.match-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.match-name {
  font-size: 32rpx;
  font-weight: 500;
}

.match-time {
  font-size: 22rpx;
  color: var(--text-sub);
}

.match-preview {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-expire {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  color: #8d6e63;
  font-size: 22rpx;
}

.match-expire.expired {
  background: #eeeeee;
  color: #999;
}

.match-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
