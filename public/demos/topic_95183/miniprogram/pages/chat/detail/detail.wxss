.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.custom-nav {
  display: flex;
  align-items: center;
  padding: 40rpx 0 20rpx;
  background: linear-gradient(180deg, var(--bg), transparent);
}

.nav-back {
  font-size: 56rpx;
  padding: 0 16rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.nav-online {
  font-size: 20rpx;
  color: #4CAF50;
  font-weight: normal;
}

.nav-more {
  font-size: 40rpx;
  padding: 0 16rpx;
}

.safety-bar,
.boundary-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  background: #FFF8E1;
  font-size: 24rpx;
  color: #5d4037;
}

.safety-btn {
  margin-left: auto;
  color: var(--accent);
  font-weight: 500;
}

.boundary-bar {
  background: #FFEBEE;
  color: #C62828;
}

.expire-bar {
  padding: 14rpx 0;
  background: #FFF8E1;
  color: #8d6e63;
  font-size: 24rpx;
  text-align: center;
}

.expire-bar.expired {
  background: #eeeeee;
  color: #999;
}

.date-order-bar {
  padding: 18rpx 0;
  background: linear-gradient(135deg, #FFF0F5, #FFF8E1);
  border-top: 2rpx solid rgba(248, 187, 208, 0.38);
  border-bottom: 2rpx solid rgba(248, 187, 208, 0.38);
}

.date-order-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-order-title {
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 700;
}

.date-order-status {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: #fff;
  font-size: 22rpx;
}

.date-order-sub {
  display: block;
  margin-top: 8rpx;
  color: #8D4A60;
  font-size: 22rpx;
}

.date-start-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  background: linear-gradient(135deg, #FFF0F5, #FFF8E1);
  border-bottom: 2rpx solid rgba(248, 187, 208, 0.38);
}

.date-start-title,
.date-start-sub {
  display: block;
}

.date-start-title {
  color: var(--text-main);
  font-size: 25rpx;
  font-weight: 700;
}

.date-start-sub {
  margin-top: 5rpx;
  color: #8D4A60;
  font-size: 21rpx;
}

.date-start-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 22rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  font-size: 24rpx;
}

.date-start-btn::after {
  border: none;
}

.date-invite-overlay {
  position: fixed;
  inset: 0;
  z-index: 65;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(30, 18, 28, 0.52);
}

.date-invite-card {
  width: 100%;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(233, 30, 99, 0.22);
}

.date-invite-title {
  display: block;
  color: var(--accent);
  font-size: 38rpx;
  font-weight: 800;
}

.date-invite-sub {
  display: block;
  margin: 12rpx 0 22rpx;
  color: var(--text-sub);
  font-size: 25rpx;
  line-height: 1.6;
}

.date-package-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.date-package {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(248, 187, 208, 0.55);
  color: var(--text-main);
  background: #FFF8FB;
  font-size: 27rpx;
}

.date-package.active {
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 700;
  background: #FFF0F5;
}

.date-fee-box {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 20rpx 0 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  color: #8D4A60;
  background: #FFF0F5;
  font-size: 23rpx;
}

.date-boundary-copy {
  display: block;
  color: var(--text-sub);
  font-size: 22rpx;
  line-height: 1.5;
}

.date-invite-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.date-cancel,
.date-confirm {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.date-cancel {
  color: var(--accent);
  background: #fff;
  border: 2rpx solid var(--primary-light);
}

.date-confirm {
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--accent));
}

.date-cancel::after,
.date-confirm::after {
  border: none;
}

.boundary-tags {
  flex: 1;
  white-space: nowrap;
}

.boundary-tags text {
  display: inline-block;
  margin-right: 16rpx;
}

.message-list {
  flex: 1;
  padding: 24rpx 0;
}

.message-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.message-item.self {
  align-items: flex-end;
}

.message-item.other {
  align-items: flex-start;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
}

.self .message-bubble {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.other .message-bubble {
  background: #fff;
  color: var(--text-main);
  border-bottom-left-radius: 4rpx;
}

.message-time {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.chat-footer {
  background: #fff;
  border-top: 2rpx solid #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  background: #fff;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  background: var(--bg);
  border-radius: var(--radius-lg);
  padding: 20rpx 28rpx;
  font-size: 30rpx;
}

.send-btn {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-radius: var(--radius-md);
  padding: 18rpx 30rpx;
  font-size: 28rpx;
  margin: 0;
}

.send-btn::after {
  border: none;
}

.expired-chat-tip {
  padding: 24rpx 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  color: var(--text-sub);
  font-size: 26rpx;
  text-align: center;
  border-top: 2rpx solid #f5f5f5;
}
