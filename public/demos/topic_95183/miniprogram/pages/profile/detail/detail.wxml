<view class="container profile-container">
  <swiper class="photo-swiper" indicator-dots circular>
    <swiper-item wx:for="{{user.avatarUrls}}" wx:key="*this">
      <view class="photo-slide avatar-placeholder" style="background: {{item}};">
        <text class="photo-emoji">{{user.isPhotoBlur ? '👤' : '👸'}}</text>
      </view>
    </swiper-item>
  </swiper>

  <view class="card">
    <view class="profile-header">
      <text class="profile-name">{{user.nickname}}</text>
      <view class="identity-tag">{{user.identity === 'princess' ? '👸 公主' : '🤴 王子'}}</view>
      <text class="profile-age">{{user.age}}岁</text>
    </view>
    <view class="profile-meta">
      <view class="meta-item">📍 {{user.city}}</view>
      <view class="meta-item">📏 {{user.height}}cm</view>
      <view class="meta-item">♈ {{user.constellation}}</view>
      <view class="meta-item">🔮 {{user.mbti}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{user.openingLine}}">
    <view class="section-title">💬 破冰开场白</view>
    <text class="opening-line">{{user.openingLine}}</text>
  </view>

  <view class="card">
    <view class="section-title">💌 Date 价格</view>
    <text class="opening-line">一日 date ¥69 · 双日 date ¥129 · 三日 date ¥189</text>
    <text class="text-sub">服务完成后对方到账 80%，平台收取 20% 推广服务费。</text>
  </view>

  <view class="card" wx:if="{{user.aboutMe}}">
    <view class="section-title">📝 关于我</view>
    <text class="about-text">{{user.aboutMe}}</text>
  </view>

  <view class="card" wx:if="{{user.relationshipGoals.length}}">
    <view class="section-title">💞 交往目标</view>
    <view class="tag-list">
      <text class="tag" wx:for="{{user.relationshipGoals}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{user.interests.length}}">
    <view class="section-title">😊 兴趣</view>
    <view class="tag-list">
      <text class="tag" wx:for="{{user.interests}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{user.wantToDo.length}}">
    <view class="section-title">🌟 一日想做</view>
    <view class="tag-list">
      <text class="tag" wx:for="{{user.wantToDo}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{user.cannotDo.length}}">
    <view class="section-title">🚫 边界提醒</view>
    <view class="tag-list">
      <text class="tag tag-danger" wx:for="{{user.cannotDo}}" wx:key="*this">{{item}}</text>
    </view>
    <text class="warning-text">请尊重对方边界，违反可能导致账号封禁</text>
  </view>

  <view class="bottom-actions">
    <button class="btn-secondary" bindtap="onPass">不感兴趣</button>
    <button class="btn-primary" bindtap="onPotato">🥔 投土豆</button>
  </view>
</view>
