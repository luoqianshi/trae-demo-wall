.index-container {
  padding: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.index-container swipe-card {
  flex: 1;
  min-height: 0;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx 10rpx;
  background: linear-gradient(180deg, var(--bg) 0%, rgba(255, 240, 245, 0.52) 72%, transparent 100%);
}

.location-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 30rpx rgba(233, 30, 99, 0.08);
}

.location-text {
  font-size: 26rpx;
  font-weight: 600;
}

.filter-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(248, 187, 208, 0.72);
  border-radius: 999rpx;
  padding: 7rpx 16rpx;
  color: var(--accent);
  font-size: 24rpx;
  line-height: 1.2;
  box-shadow: 0 10rpx 30rpx rgba(233, 30, 99, 0.08);
}

.filter-summary {
  color: var(--text-sub);
  font-size: 20rpx;
  margin-top: 2rpx;
}

.filter-panel {
  margin: 0 32rpx 12rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-pink);
  border: 2rpx solid rgba(248, 187, 208, 0.5);
}

.filter-row {
  margin-bottom: 18rpx;
}

.filter-label {
  display: block;
  margin-bottom: 4rpx;
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: 500;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.filter-reset,
.filter-apply {
  flex: 1;
  margin: 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  padding: 14rpx 0;
}

.filter-reset {
  background: #fff;
  color: var(--accent);
  border: 2rpx solid var(--primary-light);
}

.filter-apply {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
}

.filter-reset::after,
.filter-apply::after {
  border: none;
}

.location-auth-overlay {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(30, 18, 28, 0.52);
  backdrop-filter: blur(12rpx);
}

.location-auth-card {
  width: 100%;
  padding: 36rpx 34rpx 32rpx;
  border-radius: 30rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 18rpx 52rpx rgba(233, 30, 99, 0.16);
}

.location-auth-copy {
  display: block;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-sub);
}

.location-auth-btn {
  margin: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 28rpx;
}

.location-auth-btn::after {
  border: none;
}

.swipe-count {
  font-size: 22rpx;
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.92);
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 30rpx rgba(233, 30, 99, 0.08);
}

.member-badge {
  background: linear-gradient(135deg, var(--gold), #FFA000);
  color: #5d4037;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.vip-banner {
  position: fixed;
  bottom: 180rpx;
  left: 32rpx;
  right: 32rpx;
  background: linear-gradient(135deg, #FFF6D7, #FFE6A7);
  padding: 18rpx 30rpx;
  border-radius: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 14rpx 36rpx rgba(255, 193, 7, 0.18);
}

.vip-text {
  font-size: 26rpx;
  color: #5d4037;
  font-weight: 500;
}

.vip-arrow {
  font-size: 32rpx;
  color: #5d4037;
}

.match-overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 36%, rgba(255, 236, 179, 0.34), transparent 34%),
    radial-gradient(circle at 15% 18%, rgba(248, 187, 208, 0.36), transparent 28%),
    rgba(30, 18, 28, 0.58);
  backdrop-filter: blur(14rpx);
  animation: matchFadeIn 260ms ease-out;
}

.match-card {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 80rpx 42rpx 38rpx;
  border-radius: 52rpx;
  background:
    radial-gradient(circle at 50% 8%, rgba(255, 236, 179, 0.96) 0%, rgba(255, 240, 245, 0.96) 46%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 32rpx 100rpx rgba(233, 30, 99, 0.38), inset 0 0 0 2rpx rgba(255, 255, 255, 0.82);
  text-align: center;
  animation: matchCardPop 620ms cubic-bezier(0.18, 1.35, 0.28, 1);
}

.match-glow {
  position: absolute;
  top: 10rpx;
  left: 50%;
  width: 300rpx;
  height: 300rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 202, 40, 0.55), rgba(248, 187, 208, 0.28), transparent 70%);
  filter: blur(18rpx);
  animation: glowPulse 1.25s ease-in-out infinite;
}

.match-potato {
  position: relative;
  display: block;
  font-size: 168rpx;
  line-height: 1;
  margin-bottom: 12rpx;
  text-shadow: 0 0 24rpx rgba(255, 193, 7, 0.96), 0 0 48rpx rgba(233, 30, 99, 0.72);
  filter: drop-shadow(0 0 24rpx rgba(255, 193, 7, 0.96)) drop-shadow(0 0 48rpx rgba(233, 30, 99, 0.72));
  animation: potatoShakeScale 820ms cubic-bezier(0.1, 1.6, 0.16, 1), potatoFloat 2.2s ease-in-out 820ms infinite;
}

.match-title {
  position: relative;
  display: block;
  color: #E91E63;
  font-size: 78rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
  text-shadow: 0 6rpx 18rpx rgba(233, 30, 99, 0.24), 0 0 32rpx rgba(255, 193, 7, 0.34);
}

.match-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--text-main);
  font-size: 34rpx;
  font-weight: 600;
}

.match-copy {
  display: block;
  margin: 20rpx auto 34rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.7;
}

.match-quick-title {
  margin: 4rpx 0 14rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.match-quick-replies {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.match-quick-emoji {
  flex: 1;
  margin: 0;
  padding: 14rpx 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 240, 245, 0.96);
  color: var(--accent);
  font-size: 30rpx;
  line-height: 1.2;
}

.match-quick-emoji text {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
}

.match-quick-emoji::after {
  border: none;
}

.match-actions {
  display: flex;
  gap: 18rpx;
}

.match-primary,
.match-secondary {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
}

.match-primary {
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--accent));
}

.match-secondary {
  color: var(--accent);
  background: #fff;
  border: 2rpx solid var(--primary-light);
}

.match-primary::after,
.match-secondary::after {
  border: none;
}

.sakura-field {
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
}

.sakura {
  position: absolute;
  font-size: 42rpx;
  opacity: 0;
  animation: sakuraFirework 1.05s cubic-bezier(0.18, 0.92, 0.24, 1) forwards, sakuraDrift 2.4s ease-in 1.02s forwards;
}

.sakura-core {
  position: absolute;
  left: 50%;
  top: 49%;
  color: rgba(255, 236, 179, 0.96);
  font-size: 72rpx;
  opacity: 0;
  transform: translate(-50%, -50%);
  text-shadow: 0 0 34rpx rgba(255, 193, 7, 0.85);
  animation: sakuraCoreFlash 900ms ease-out forwards;
}

.sakura-1 { left: 50%; top: 49%; animation-delay: 40ms, 1.06s; --sx: -330rpx; --sy: -330rpx; --dx: -60rpx; --dy: 180rpx; --rot: -96deg; }
.sakura-2 { left: 50%; top: 49%; animation-delay: 55ms, 1.08s; --sx: -150rpx; --sy: -400rpx; --dx: -30rpx; --dy: 210rpx; --rot: 82deg; }
.sakura-3 { left: 50%; top: 49%; animation-delay: 70ms, 1.1s; --sx: 70rpx; --sy: -420rpx; --dx: 20rpx; --dy: 220rpx; --rot: -68deg; }
.sakura-4 { left: 50%; top: 49%; animation-delay: 85ms, 1.12s; --sx: 300rpx; --sy: -330rpx; --dx: 70rpx; --dy: 190rpx; --rot: 120deg; }
.sakura-5 { left: 50%; top: 49%; animation-delay: 100ms, 1.14s; --sx: 410rpx; --sy: -90rpx; --dx: 90rpx; --dy: 170rpx; --rot: -142deg; }
.sakura-6 { left: 50%; top: 49%; animation-delay: 115ms, 1.16s; --sx: 360rpx; --sy: 150rpx; --dx: 70rpx; --dy: 190rpx; --rot: 158deg; }
.sakura-7 { left: 50%; top: 49%; animation-delay: 130ms, 1.18s; --sx: 160rpx; --sy: 320rpx; --dx: 40rpx; --dy: 210rpx; --rot: -110deg; }
.sakura-8 { left: 50%; top: 49%; animation-delay: 145ms, 1.2s; --sx: -80rpx; --sy: 360rpx; --dx: -20rpx; --dy: 220rpx; --rot: 96deg; }
.sakura-9 { left: 50%; top: 49%; animation-delay: 160ms, 1.22s; --sx: -300rpx; --sy: 220rpx; --dx: -70rpx; --dy: 190rpx; --rot: -150deg; }
.sakura-10 { left: 50%; top: 49%; animation-delay: 175ms, 1.24s; --sx: -410rpx; --sy: -40rpx; --dx: -90rpx; --dy: 170rpx; --rot: 130deg; }
.sakura-11 { left: 50%; top: 49%; animation-delay: 90ms, 1.08s; --sx: -220rpx; --sy: -150rpx; --dx: -55rpx; --dy: 160rpx; --rot: 66deg; }
.sakura-12 { left: 50%; top: 49%; animation-delay: 105ms, 1.1s; --sx: -40rpx; --sy: -240rpx; --dx: -10rpx; --dy: 180rpx; --rot: -54deg; }
.sakura-13 { left: 50%; top: 49%; animation-delay: 120ms, 1.12s; --sx: 170rpx; --sy: -170rpx; --dx: 45rpx; --dy: 160rpx; --rot: 112deg; }
.sakura-14 { left: 50%; top: 49%; animation-delay: 135ms, 1.14s; --sx: 240rpx; --sy: 30rpx; --dx: 60rpx; --dy: 170rpx; --rot: -124deg; }
.sakura-15 { left: 50%; top: 49%; animation-delay: 150ms, 1.16s; --sx: 80rpx; --sy: 220rpx; --dx: 35rpx; --dy: 190rpx; --rot: 76deg; }
.sakura-16 { left: 50%; top: 49%; animation-delay: 165ms, 1.18s; --sx: -160rpx; --sy: 190rpx; --dx: -35rpx; --dy: 190rpx; --rot: -86deg; }
.sakura-17 { left: 50%; top: 49%; animation-delay: 180ms, 1.2s; --sx: -250rpx; --sy: 20rpx; --dx: -65rpx; --dy: 170rpx; --rot: 148deg; }
.sakura-18 { left: 50%; top: 49%; animation-delay: 195ms, 1.22s; --sx: 0rpx; --sy: -330rpx; --dx: 10rpx; --dy: 205rpx; --rot: -180deg; }
.sakura-19 { left: 50%; top: 49%; animation-delay: 210ms, 1.24s; --sx: 330rpx; --sy: 260rpx; --dx: 95rpx; --dy: 210rpx; --rot: 210deg; }
.sakura-20 { left: 50%; top: 49%; animation-delay: 225ms, 1.26s; --sx: -360rpx; --sy: 300rpx; --dx: -95rpx; --dy: 210rpx; --rot: -210deg; }

@keyframes matchFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes matchCardPop {
  0% { opacity: 0; transform: translateY(70rpx) scale(0.82); }
  68% { opacity: 1; transform: translateY(-10rpx) scale(1.035); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes potatoShakeScale {
  0% { opacity: 0; transform: translateY(90rpx) scale(0.18) rotate(-10deg); }
  26% { opacity: 1; transform: translateY(-28rpx) scale(1.55) rotate(8deg); }
  40% { transform: translateX(-14rpx) translateY(8rpx) scale(1.18) rotate(-6deg); }
  52% { transform: translateX(14rpx) translateY(-8rpx) scale(1.34) rotate(5deg); }
  64% { transform: translateX(-9rpx) translateY(4rpx) scale(1.12) rotate(-4deg); }
  78% { transform: translateX(6rpx) translateY(-4rpx) scale(1.08) rotate(3deg); }
  100% { opacity: 1; transform: translateX(0) translateY(0) scale(1) rotate(0); }
}

@keyframes potatoFloat {
  0%, 100% { transform: translateY(0) rotate(0); }
  50% { transform: translateY(-10rpx) rotate(3deg); }
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.6; transform: translateX(-50%) scale(0.88); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.15); }
}

@keyframes sakuraCoreFlash {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2) rotate(0); }
  35% { opacity: 1; transform: translate(-50%, -50%) scale(1.45) rotate(20deg); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(2.2) rotate(90deg); }
}

@keyframes sakuraFirework {
  0% { opacity: 0; transform: translate(0, 0) scale(0.24) rotate(0); }
  18% { opacity: 1; }
  100% { opacity: 1; transform: translate(var(--sx), var(--sy)) scale(1.12) rotate(var(--rot)); }
}

@keyframes sakuraDrift {
  0% { opacity: 1; transform: translate(var(--sx), var(--sy)) scale(1.12) rotate(var(--rot)); }
  100% { opacity: 0; transform: translate(calc(var(--sx) + var(--dx)), calc(var(--sy) + var(--dy))) scale(0.92) rotate(calc(var(--rot) + 120deg)); }
}

.super-overlay {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(26, 22, 40, 0.58);
  backdrop-filter: blur(12rpx);
}

.super-card {
  width: 100%;
  padding: 48rpx 34rpx 34rpx;
  border-radius: 44rpx;
  text-align: center;
  background: radial-gradient(circle at 50% 0%, #E8EAF6, #FFF8E1 44%, #fff 100%);
  box-shadow: 0 28rpx 86rpx rgba(63, 81, 181, 0.28);
}

.super-star {
  display: block;
  font-size: 104rpx;
  margin-bottom: 10rpx;
}

.super-title {
  display: block;
  color: #3F51B5;
  font-size: 52rpx;
  font-weight: 800;
}

.super-copy {
  display: block;
  margin: 14rpx 0 24rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.6;
}

.super-plans {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.super-plan {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff;
  color: var(--text-main);
  font-size: 26rpx;
}

.super-plan.hot {
  border: 3rpx solid #3F51B5;
  color: #3F51B5;
  font-weight: 700;
}

.super-actions {
  display: flex;
  gap: 16rpx;
}

.super-secondary,
.super-primary {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.super-secondary {
  color: #3F51B5;
  background: #fff;
}

.super-primary {
  color: #fff;
  background: linear-gradient(135deg, #5C6BC0, #3F51B5);
}

.super-secondary::after,
.super-primary::after {
  border: none;
}
