<view class="container login-container login-step-{{step}}">
  <view class="logo-section">
    <text class="logo-icon">🥔</text>
    <text class="logo-title">Potato U</text>
    <text class="logo-subtitle">一日限定陪伴匹配平台</text>
  </view>

  <view class="identity-section" wx:if="{{step === 1}}">
    <text class="section-title">选择你的身份</text>
    <view class="identity-options">
      <view class="identity-card" bindtap="selectIdentity" data-identity="princess">
        <text class="identity-emoji">👸</text>
        <text class="identity-name">一日公主</text>
      </view>
      <view class="identity-card" bindtap="selectIdentity" data-identity="prince">
        <text class="identity-emoji">🤴</text>
        <text class="identity-name">一日王子</text>
      </view>
    </view>
  </view>

  <view class="nickname-section register-card" wx:if="{{step === 2}}">
    <view class="register-card-head">
      <text class="section-title register-title">完善注册信息</text>
      <text class="text-sub register-sub">给今天的匹配准备一个轻量身份</text>
    </view>

    <view class="suggestion-pill">已推荐昵称：{{suggestedNickname}}</view>

    <view class="register-field">
      <text class="form-label-inline">昵称</text>
      <view class="picker-input register-input" style="padding:0;">
        <input class="register-input-inner" type="text" placeholder="输入昵称" value="{{nickname}}" bindinput="onNicknameInput" cursor-spacing="80" adjust-position="{{true}}" maxlength="12" />
      </view>
      <text class="nickname-tip">昵称仅可修改3次</text>
    </view>

    <view class="register-field">
      <text class="form-label-inline">年龄</text>
      <picker bindchange="onAgeChange" range="{{ageOptions}}">
        <view class="picker-input register-input">{{age || '选择年龄'}} ›</view>
      </picker>
    </view>

    <view class="register-field">
      <text class="form-label-inline">星座</text>
      <picker bindchange="onConstellationChange" range="{{constellations}}">
        <view class="picker-input register-input">{{constellation || '选择星座'}} ›</view>
      </picker>
    </view>

    <button class="btn-primary register-submit" bindtap="completeLogin">进入 Potato U</button>
  </view>

  <view class="privacy-promise">
    <text>🔒 我们承诺：不读取你的微信好友，保护你的隐私</text>
  </view>
</view>
