<view class="container likes-container">
  <view class="likes-list" wx:if="{{likedMe.length}}">
    <view class="like-item" wx:for="{{likedMe}}" wx:key="userId">
      <view class="like-avatar avatar-placeholder" style="background: {{item.avatar}};"><text>{{item.identity === 'princess' ? '👸' : '🤴'}}</text></view>
      <view class="like-info"><text class="like-name">{{item.nickname}}</text><text class="like-meta">{{item.age}}岁 · {{item.city}}</text></view>
      <button class="btn-primary like-btn" bindtap="returnPotato" data-userid="{{item.userId}}">🥔 回投土豆</button>
    </view>
  </view>
  <view class="empty-state" wx:else>
    <text class="empty-icon">🥔</text>
    <text class="empty-title">还没有人投土豆</text>
    <text class="empty-sub">完善资料，增加曝光，让更多人看到你</text>
  </view>
</view>
