<view class="container settings-container">
  <view class="menu-list">
    <view class="menu-item"><text class="menu-text">照片模糊</text><switch checked="{{isPhotoBlur}}" bindchange="onBlurChange" color="#E91E63" /></view>
    <view class="menu-item" bindtap="clearSwiped"><text class="menu-text">清除滑动记录</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="clearCache"><text class="menu-text">清除缓存</text><text class="menu-arrow">›</text></view>
  </view>
  <view class="menu-list danger-zone">
    <view class="menu-item" bindtap="logout"><text class="menu-text accent">退出登录</text></view>
    <view class="menu-item" bindtap="deleteAccount"><text class="menu-text danger">注销账号</text></view>
  </view>
  <view class="version-info"><text>Potato U v1.0.0</text></view>
</view>
