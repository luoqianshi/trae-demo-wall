.menu-list {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-pink);
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-text {
  font-size: 30rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-sub);
}

.danger-zone {
  margin-top: 48rpx;
}

.accent {
  color: var(--accent);
}

.danger {
  color: var(--danger);
}

.version-info {
  text-align: center;
  padding: 48rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
