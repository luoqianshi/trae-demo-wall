<view class="container visitors-container">
  <view class="card locked-card" wx:if="{{!isMember}}">
    <text class="locked-icon">👀</text>
    <text class="locked-title">访客记录</text>
    <text class="locked-sub">开通会员后，可查看最近谁浏览过你的资料。</text>
    <button class="btn-primary unlock-btn" bindtap="goToVip">开通会员解锁</button>
  </view>

  <view wx:else>
    <view class="card visitors-summary">
      <text class="summary-num">{{visitors.length}}</text>
      <text class="summary-text">位访客看过你</text>
    </view>
    <view class="visitor-list">
      <view class="visitor-item" wx:for="{{visitors}}" wx:key="userId">
        <view class="visitor-avatar avatar-placeholder" style="background: {{item.avatar}};">
          <text>{{item.identity === 'princess' ? '👸' : '🤴'}}</text>
        </view>
        <view class="visitor-info">
          <text class="visitor-name">{{item.nickname}}</text>
          <text class="visitor-meta">{{item.age}}岁 · {{item.city}} · {{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
