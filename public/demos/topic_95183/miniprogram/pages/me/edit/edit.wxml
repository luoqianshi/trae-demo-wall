<view class="container edit-container">
  <view class="card">
    <view class="section-title">📷 照片</view>
    <view class="photo-grid">
      <view class="photo-item avatar-placeholder" wx:for="{{form.avatarUrls}}" wx:key="*this" style="background: {{item}}; background-image: url({{item}}); background-size: cover; background-position: center;" bindtap="previewPhoto" data-url="{{item}}">
        <text>👤</text>
        <view class="cover-badge" wx:if="{{index === 0}}">主封面</view>
        <view class="cover-action" wx:else catchtap="setCoverPhoto" data-index="{{index}}">设为主封面</view>
        <view class="photo-order-actions">
          <text class="photo-order-btn" wx:if="{{index > 0}}" catchtap="movePhoto" data-index="{{index}}" data-direction="up">前移</text>
          <text class="photo-order-btn" wx:if="{{index < form.avatarUrls.length - 1}}" catchtap="movePhoto" data-index="{{index}}" data-direction="down">后移</text>
        </view>
        <view class="photo-remove" catchtap="removePhoto" data-index="{{index}}">×</view>
      </view>
      <view class="photo-add" bindtap="addPhoto" wx:if="{{form.avatarUrls.length < 9}}"><text>+</text></view>
    </view>
    <text class="photo-tip">最多上传9张照片，需要读取手机相册权限</text>
  </view>

  <view class="card">
    <view class="section-title">📝 基本信息</view>
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" value="{{form.nickname}}" bindinput="onInput" data-field="nickname" disabled="{{nicknameLocked}}" />
      <text class="nickname-tip">{{nicknameLocked ? '昵称仅可修改3次，当前已锁定' : '昵称仅可修改3次，请确认后保存'}}</text>
    </view>
    <view class="form-item"><text class="form-label">关于我</text><textarea class="form-textarea" value="{{form.aboutMe}}" bindinput="onInput" data-field="aboutMe" maxlength="200" /><text class="char-count">{{form.aboutMe.length}}/200</text></view>
    <view class="form-item"><text class="form-label">身高 (cm)</text><input class="form-input" type="number" value="{{form.height}}" bindinput="onInput" data-field="height" /></view>
    <view class="form-item"><text class="form-label">城市</text><input class="form-input" value="{{form.city}}" bindinput="onInput" data-field="city" /></view>
    <view class="form-item"><text class="form-label">星座</text><picker bindchange="onPickerChange" data-field="constellation" range="{{constellations}}"><view class="picker-value">{{form.constellation || '请选择'}} ›</view></picker></view>
    <view class="form-item"><text class="form-label">MBTI</text><picker bindchange="onPickerChange" data-field="mbti" range="{{mbtiTypes}}"><view class="picker-value">{{form.mbti || '请选择'}} ›</view></picker></view>
  </view>

  <view class="card">
    <view class="section-title">😊 兴趣</view>
    <tag-picker tags="{{interestTags}}" selected="{{form.interests}}" bind:change="onInterestsChange" />
  </view>

  <view class="card">
    <view class="section-title">💞 交往目标</view>
    <text class="text-sub">你想要什么？</text>
    <tag-picker tags="{{relationshipGoalTags}}" selected="{{form.relationshipGoals}}" bind:change="onRelationshipGoalChange" />
  </view>

  <view class="card"><view class="section-title">🌟 一日想做</view><tag-picker tags="{{wantToDoTags}}" selected="{{form.wantToDo}}" bind:change="onWantToDoChange" /></view>
  <view class="card"><view class="section-title">🚫 不可做边界</view><tag-picker tags="{{cannotDoTags}}" selected="{{form.cannotDo}}" bind:change="onCannotDoChange" type="danger" /></view>

  <view class="card">
    <view class="section-title">💬 破冰开场白</view>
    <textarea class="form-textarea opening-textarea" value="{{form.openingLine}}" bindinput="onInput" data-field="openingLine" maxlength="60" placeholder="例如：先从一杯咖啡和一次轻松聊天开始吧～" />
    <text class="text-sub">展示在资料页，比语音录制更稳定，也更方便审核和保存。</text>
  </view>

  <view class="card">
    <view class="section-title">📱 个人微信号</view>
    <input class="form-input" value="{{form.wechatId}}" bindinput="onInput" data-field="wechatId" placeholder="填写你的微信号" />
    <button class="status-sync-btn wechat-paste-btn" bindtap="fillWechatExample">填入示例微信号</button>
    <text class="text-sub">微信号仅作为个人资料备用信息，date 邀请和订单沟通优先在平台内完成。</text>
  </view>

  <view class="card">
    <view class="flex-between">
      <view><view class="section-title no-margin">🌫️ 照片模糊</view><text class="text-sub">对未匹配用户展示模糊照片</text></view>
      <switch checked="{{form.isPhotoBlur}}" bindchange="onBlurChange" color="#E91E63" />
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="saveProfile">保存资料</button>
</view>
