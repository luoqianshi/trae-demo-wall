.edit-container {
  padding-bottom: 60rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item,
.photo-add {
  height: 200rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  position: relative;
  overflow: hidden;
}

.photo-add {
  background: var(--bg);
  border: 4rpx dashed var(--primary-light);
  color: var(--primary);
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
}

.cover-badge,
.cover-action {
  position: absolute;
  left: 10rpx;
  bottom: 48rpx;
  padding: 6rpx 12rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 20rpx;
  background: rgba(233, 30, 99, 0.88);
}

.cover-action {
  background: rgba(0, 0, 0, 0.52);
}

.photo-order-actions {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.photo-order-btn {
  padding: 4rpx 10rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 20rpx;
  background: rgba(0, 0, 0, 0.48);
}

.photo-tip,
.nickname-tip {
  display: block;
  margin-top: 12rpx;
  color: var(--text-sub);
  font-size: 22rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.form-input,
.form-textarea,
.picker-value {
  width: 100%;
  min-height: 88rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  background: var(--bg);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.form-input[disabled] {
  color: var(--text-sub);
  background: #F7EDF1;
}

.form-textarea {
  height: 160rpx;
}

.opening-textarea {
  height: 140rpx;
  margin-bottom: 12rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.emoji-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.emoji-option {
  font-size: 48rpx;
  padding: 16rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
  border: 4rpx solid transparent;
}

.emoji-option.selected {
  border-color: var(--accent);
  background: var(--primary-light);
}

.voice-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.voice-record-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.voice-tip {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.wechat-status-box {
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 20rpx;
}

.wechat-status-text {
  display: block;
  color: var(--text-main);
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.status-sync-btn {
  margin: 0;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  padding: 14rpx 24rpx;
}

.status-sync-btn::after {
  border: none;
}

.no-margin {
  margin-bottom: 0;
}

.save-btn {
  margin-top: 48rpx;
}
