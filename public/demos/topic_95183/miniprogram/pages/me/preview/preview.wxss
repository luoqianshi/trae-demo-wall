.profile-container {
  padding-bottom: 160rpx;
}

.photo-swiper {
  height: 600rpx;
  margin: -32rpx -32rpx 24rpx;
}

.photo-slide {
  width: 100%;
  height: 100%;
  font-size: 160rpx;
}

.photo-emoji {
  opacity: 0.42;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.profile-name {
  font-size: 44rpx;
  font-weight: 600;
}

.profile-meta,
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-item {
  background: var(--bg);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.about-text {
  font-size: 28rpx;
  line-height: 1.8;
}

.opening-line {
  display: block;
  margin-top: 12rpx;
  background: var(--bg);
  border: 2rpx solid var(--primary-light);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.7;
}

.warning-text {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--accent);
  background: #FFEBEE;
  padding: 16rpx;
  border-radius: var(--radius-sm);
}

.preview-edit-btn {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
}
