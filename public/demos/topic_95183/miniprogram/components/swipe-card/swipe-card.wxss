.swipe-card-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 240, 245, 0.86) 0%, #fff 100%);
}

.card-stack {
  position: relative;
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}

.card {
  position: absolute;
  top: 0;
  left: 6%;
  right: 6%;
  width: 88%;
  max-width: 680rpx;
  height: calc(100% - 40rpx);
  max-height: calc(100vh - 280rpx);
  background: #fff;
  border-radius: 44rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(233, 30, 99, 0.08);
  border: 2rpx solid rgba(248, 187, 208, 0.35);
  transition: transform 0.35s ease-out, opacity 0.35s ease-out;
  display: flex;
  flex-direction: column;
}

.top-card {
  transition: none;
}

.card.swiping-potato,
.card.swiping-pass,
.card.swiping-super {
  transition: transform 0.35s ease-out, opacity 0.35s ease-out !important;
}

.card-photo {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  font-size: 120rpx;
}

.photo-emoji {
  opacity: 0.42;
}

.blur-overlay {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.blur-text {
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
}

.opening-badge {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  background: rgba(255, 236, 179, 0.96);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #5d4037;
  font-size: 24rpx;
  font-weight: 500;
}

.card-info {
  padding: 16rpx 22rpx;
  background: #fff;
  flex-shrink: 0;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.age {
  font-size: 26rpx;
  color: var(--text-sub);
}

.info-meta {
  display: flex;
  gap: 14rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.info-about {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 6rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.info-interests {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.date-service-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.date-price {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8D4A00;
  background: #FFF3CD;
  font-size: 24rpx;
  font-weight: 700;
}

.date-service {
  color: var(--text-sub);
  font-size: 21rpx;
}

.swipe-indicator {
  position: absolute;
  top: 60rpx;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  font-size: 40rpx;
  font-weight: bold;
  border: 6rpx solid;
  transform: rotate(-15deg);
}

.potato-indicator {
  right: 40rpx;
  color: #8D6E63;
  border-color: #8D6E63;
  background: rgba(255, 236, 179, 0.85);
}

.pass-indicator {
  left: 40rpx;
  color: var(--danger);
  border-color: var(--danger);
}

.super-indicator {
  left: 50%;
  transform: translateX(-50%);
  color: #FFA000;
  border-color: #FFA000;
}

.card-actions {
  display: flex;
  justify-content: center;
  gap: 36rpx;
  align-items: center;
  padding: 12rpx 0 16rpx;
  background: #fff;
  flex-shrink: 0;
}

.action-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(233, 30, 99, 0.12);
}

.pass-btn {
  border: 4rpx solid rgba(255, 82, 82, 0.7);
}

.super-btn {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(255, 160, 0, 0.72);
  font-size: 32rpx;
}

.potato-btn {
  border: 4rpx solid rgba(141, 110, 99, 0.72);
  background: linear-gradient(135deg, #FFF8E1, #FFE7B0);
}
