<view class="swipe-card-container">
  <view class="card-stack" wx:if="{{displayCards.length}}">
    <view
      class="card {{card.status}} {{card.isTop ? 'top-card' : ''}}"
      wx:for="{{displayCards}}"
      wx:key="userId"
      wx:for-item="card"
      style="transform: translateX({{card.isTop ? offsetX : 0}}px) translateY({{card.isTop ? offsetY : 0}}px) rotate({{card.isTop ? rotate : 0}}deg); z-index: {{card.zIndex}}; opacity: {{card.isTop ? opacity : 1}};"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtap="openDetail"
      data-userid="{{card.userId}}"
    >
      <view class="card-photo">
        <view class="photo-placeholder avatar-placeholder" style="background: {{card.avatarUrls[0]}};">
          <text class="photo-emoji">{{card.isPhotoBlur ? '👤' : '👸'}}</text>
        </view>
        <view wx:if="{{card.isPhotoBlur}}" class="blur-overlay">
          <text class="blur-text">匹配后查看清晰照片</text>
        </view>
        <view class="opening-badge" wx:if="{{card.openingLine}}">
          <text class="opening-icon">💬</text>
          <text class="opening-text">有破冰开场白</text>
        </view>
      </view>

      <view class="card-info">
        <view class="info-header">
          <text class="nickname">{{card.nickname}}</text>
          <view class="identity-tag {{card.identity}}">
            {{card.identity === 'princess' ? '👸 公主' : '🤴 王子'}}
          </view>
          <text class="age">{{card.age}}岁</text>
        </view>

        <view class="info-meta">
          <text>📍 {{card.city}}</text>
          <text>{{card.distanceKm}}km</text>
          <text>📏 {{card.height}}cm</text>
          <text>♈ {{card.constellation}}</text>
        </view>

        <view class="date-service-row">
          <text class="date-price">¥69/天起</text>
          <text class="date-service">平台保障 · 20%推广服务费</text>
        </view>

        <view class="info-tags" wx:if="{{card.previewWantToDo && card.previewWantToDo.length}}">
          <text class="tag" wx:for="{{card.previewWantToDo}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="info-about" wx:if="{{card.aboutMe}}">{{card.aboutMe}}</view>
        <view class="info-interests" wx:if="{{card.interests && card.interests.length}}">
          <text class="tag tag-secondary" wx:for="{{card.interests}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="card-actions">
        <view class="action-btn pass-btn" catchtap="onPass"><text>❌</text></view>
        <view class="action-btn super-btn" catchtap="onSuperLike"><text>⭐</text></view>
        <view class="action-btn potato-btn" catchtap="onLike"><text>🥔</text></view>
      </view>

      <view class="swipe-indicator potato-indicator" wx:if="{{card.isTop && offsetX > 50}}">
        <text>🥔 POTATO</text>
      </view>
      <view class="swipe-indicator pass-indicator" wx:if="{{card.isTop && offsetX < -50}}">
        <text>❌ NOPE</text>
      </view>
      <view class="swipe-indicator super-indicator" wx:if="{{card.isTop && offsetY < -50}}">
        <text>⭐ SUPER</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{displayCards.length === 0}}">
    <text class="empty-icon">🥔</text>
    <text class="empty-title">今日推荐已看完</text>
    <text class="empty-sub">明天再来发现新的人吧～</text>
    <button class="btn-secondary" bindtap="onReload">刷新试试</button>
  </view>
</view>
