.voice-player {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg);
  padding: 20rpx 28rpx;
  border-radius: var(--radius-md);
}

.voice-wave {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 40rpx;
}

.wave-bar {
  width: 8rpx;
  background: var(--primary);
  border-radius: 4rpx;
  height: 16rpx;
}

.wave-bar:nth-child(2) {
  height: 28rpx;
}

.wave-bar:nth-child(3) {
  height: 20rpx;
}

.wave-bar.playing {
  animation: wave 0.6s infinite alternate;
}

.wave-bar.playing:nth-child(1) { animation-delay: 0s; }
.wave-bar.playing:nth-child(2) { animation-delay: 0.2s; }
.wave-bar.playing:nth-child(3) { animation-delay: 0.4s; }

@keyframes wave {
  from { height: 12rpx; }
  to { height: 40rpx; }
}

.voice-duration {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 500;
}

.voice-status {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-left: auto;
}
