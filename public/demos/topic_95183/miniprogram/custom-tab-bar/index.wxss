.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  padding: 10rpx 0 calc(10rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #f7edf2;
  box-shadow: 0 -8rpx 28rpx rgba(233, 30, 99, 0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
}

.tab-item.active {
  color: #E91E63;
}

.tab-text {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
}
