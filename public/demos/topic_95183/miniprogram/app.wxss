page {
  --primary: #F48FB1;
  --primary-light: #F8BBD0;
  --champagne: #F5E6D3;
  --gold: #FFECB3;
  --bg: #FFF0F5;
  --card: #FFFFFF;
  --accent: #E91E63;
  --text-main: #333333;
  --text-sub: #888888;
  --danger: #FF5252;
  --success: #69F0AE;
  --shadow-pink: 0 8rpx 32rpx rgba(244, 143, 177, 0.15);
  --radius-lg: 48rpx;
  --radius-md: 32rpx;
  --radius-sm: 24rpx;
}

page {
  background-color: var(--bg);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-pink);
  margin-bottom: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(233, 30, 99, 0.28);
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

.btn-secondary {
  background: var(--card);
  color: var(--accent);
  border: 2rpx solid var(--primary-light);
  border-radius: var(--radius-lg);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  text-align: center;
}

.tag {
  display: inline-block;
  background: var(--bg);
  border: 2rpx solid var(--primary-light);
  color: var(--accent);
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin: 6rpx;
}

.tag-active {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-color: transparent;
}

.tag-danger {
  background: #FFEBEE;
  border-color: #EF9A9A;
  color: #C62828;
}

.tag-danger.tag-active {
  background: linear-gradient(135deg, #FF8A80, #FF5252);
  color: #fff;
  border-color: transparent;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--text-main);
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-sub {
  color: var(--text-sub);
  font-size: 24rpx;
}

.avatar-placeholder {
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 600;
}

.identity-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--bg);
  color: var(--accent);
  border: 2rpx solid var(--primary-light);
}

.empty-state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-sub);
  display: block;
  margin-bottom: 32rpx;
}
