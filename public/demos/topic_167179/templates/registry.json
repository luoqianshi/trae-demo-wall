{
  "version": "2.0",
  "updatedAt": "2026-07-15",
  "categories": {
    "gold_standard": {
      "label": "金标准模板",
      "description": "经过验收的高质量模板，适用于竖屏新闻短视频的口播包装",
      "templates": [
        {
          "id": "single-stat",
          "name": "单一核心数据",
          "category": "data_card",
          "purpose": "突出展示一个核心数据/关键指标",
          "useCases": ["GDP 增长数据", "营收/利润数字", "用户量/销量", "单一关键 KPI"],
          "duration": 3,
          "variables": {
            "mainNumber": { "type": "string", "label": "主数字", "example": "3.2%" },
            "subText": { "type": "string", "label": "说明文字", "example": "同比增长" },
            "theme": { "type": "enum", "options": ["amber", "blue"], "default": "amber" }
          }
        },
        {
          "id": "data-compare",
          "name": "双数据对比",
          "category": "data_card",
          "purpose": "左右对比展示两个相关数据",
          "useCases": ["同比/环比对比", "两个指标并列", "前后数据对比", "A/B 两组数据"],
          "duration": 3,
          "variables": {
            "textLeft": { "type": "string", "label": "左侧数据", "example": "202家企业" },
            "textRight": { "type": "string", "label": "右侧数据", "example": "440个产品" },
            "theme": { "type": "enum", "options": ["amber", "blue"], "default": "amber" }
          }
        },
        {
          "id": "trend-ratio",
          "name": "趋势/比例数据",
          "category": "data_card",
          "purpose": "展示带趋势方向或比例的数值",
          "useCases": ["增长率/下降率", "占比/完成率", "涨跌数据带箭头", "百分比+趋势方向"],
          "duration": 3,
          "variables": {
            "mainNumber": { "type": "string", "label": "主数字", "example": "+15.8%" },
            "trendDirection": { "type": "enum", "options": ["up", "down", "flat"], "label": "趋势方向", "default": "up" },
            "subText": { "type": "string", "label": "说明文字", "example": "较上季度" },
            "theme": { "type": "enum", "options": ["amber", "blue"], "default": "amber" }
          }
        },
        {
          "id": "quote-callout",
          "name": "人物观点花字",
          "category": "quote_highlight",
          "purpose": "高亮展示一句话观点/引语",
          "useCases": ["专家观点", "政策要点", "金句/语录", "人物发言摘要"],
          "duration": 3,
          "variables": {
            "quoteText": { "type": "string", "label": "引语文字", "example": "科技创新是第一动力" },
            "speaker": { "type": "string", "label": "说话人/身份", "example": "专家表示" },
            "theme": { "type": "enum", "options": ["amber", "blue"], "default": "amber" }
          }
        },
        {
          "id": "data-to-conclusion",
          "name": "双数据到结论",
          "category": "data_card",
          "purpose": "两个数据铺垫→推出核心结论（三段式）",
          "useCases": ["数据支撑结论", "现象→本质", "两个条件→得出结果", "对比→结论"],
          "duration": 3,
          "variables": {
            "textLeft": { "type": "string", "label": "左侧数据", "example": "202家企业" },
            "textRight": { "type": "string", "label": "右侧数据", "example": "440个产品" },
            "textResult": { "type": "string", "label": "中央结论", "example": "成功中选" },
            "theme": { "type": "enum", "options": ["amber", "blue"], "default": "amber" }
          }
        }
      ]
    },
    "basic_presets": {
      "label": "基础预设",
      "description": "每类包装类型的基础预设样式",
      "templates": [
        {
          "id": "data_card_v1", "name": "大气数字", "category": "data_card", "folder": "data_card", "presetKey": "classic",
          "purpose": "核心KPI、关键指标", "duration": 3
        },
        {
          "id": "data_card_v2", "name": "对比卡片", "category": "data_card", "folder": "data_card", "presetKey": "compare",
          "purpose": "同比环比、前后对比", "duration": 3
        },
        {
          "id": "data_card_v3", "name": "趋势卡片", "category": "data_card", "folder": "data_card", "presetKey": "trend",
          "purpose": "增长/下降数据，数字配箭头", "duration": 3
        },
        {
          "id": "data_card_v4", "name": "环形进度", "category": "data_card", "folder": "data_card", "presetKey": "ring",
          "purpose": "完成率、占比、进度类", "duration": 3
        },
        {
          "id": "data_card_v5", "name": "迷你标签", "category": "data_card", "folder": "data_card", "presetKey": "tag",
          "purpose": "次要数据、辅助指标", "duration": 3
        },
        {
          "id": "quote_highlight_v1", "name": "左线引用", "category": "quote_highlight", "folder": "quote_highlight", "presetKey": "classic",
          "purpose": "标准引语高亮", "duration": 3
        },
        {
          "id": "quote_highlight_v2", "name": "居中引用", "category": "quote_highlight", "folder": "quote_highlight", "presetKey": "center",
          "purpose": "短句金句居中展示", "duration": 3
        },
        {
          "id": "quote_highlight_v3", "name": "说话人卡片", "category": "quote_highlight", "folder": "quote_highlight", "presetKey": "speaker",
          "purpose": "带发言人的引用", "duration": 3
        },
        {
          "id": "quote_highlight_v4", "name": "气泡引用", "category": "quote_highlight", "folder": "quote_highlight", "presetKey": "bubble",
          "purpose": "对话气泡样式", "duration": 3
        },
        {
          "id": "quote_highlight_v5", "name": "下划线强调", "category": "quote_highlight", "folder": "quote_highlight", "presetKey": "underline",
          "purpose": "底部粗线+引号", "duration": 3
        },
        {
          "id": "timeline_node_v1", "name": "单节点", "category": "timeline_node", "folder": "timeline", "presetKey": "classic",
          "purpose": "单一时间点强调", "duration": 3
        },
        {
          "id": "timeline_node_v2", "name": "双节点对比", "category": "timeline_node", "folder": "timeline", "presetKey": "dual",
          "purpose": "前后两个时间点并列", "duration": 3
        },
        {
          "id": "timeline_node_v3", "name": "流程轴", "category": "timeline_node", "folder": "timeline", "presetKey": "flow",
          "purpose": "横向时间流程", "duration": 3
        },
        {
          "id": "timeline_node_v4", "name": "日期卡片", "category": "timeline_node", "folder": "timeline", "presetKey": "date_card",
          "purpose": "大日期+事件简述", "duration": 3
        },
        {
          "id": "timeline_node_v5", "name": "里程碑", "category": "timeline_node", "folder": "timeline", "presetKey": "milestone",
          "purpose": "上下交错里程碑", "duration": 3
        },
        {
          "id": "title_card_v1", "name": "大气标题", "category": "title_card", "folder": "title_card", "presetKey": "classic",
          "purpose": "章节大标题", "duration": 3
        },
        {
          "id": "title_card_v2", "name": "副标题卡片", "category": "title_card", "folder": "title_card", "presetKey": "subtitle",
          "purpose": "主标题+副标题", "duration": 3
        },
        {
          "id": "title_card_v3", "name": "左线标题", "category": "title_card", "folder": "title_card", "presetKey": "left_bar",
          "purpose": "左侧强调线+标题", "duration": 3
        },
        {
          "id": "title_card_v4", "name": "结论卡片", "category": "title_card", "folder": "title_card", "presetKey": "conclusion",
          "purpose": "段落结论、总结句", "duration": 3
        },
        {
          "id": "title_card_v5", "name": "章节标签", "category": "title_card", "folder": "title_card", "presetKey": "chapter",
          "purpose": "编号+小标题", "duration": 3
        }
      ]
    },
    "story_graphic": {
      "label": "故事图形（长时长信息图）",
      "description": "8秒以上全屏信息图，不参与3秒包装点自动推荐，需人工选用",
      "templates": [
        {
          "id": "media_radar",
          "name": "媒体雷达图",
          "category": "story_graphic",
          "purpose": "全屏信息图，多维度媒体报道/话题雷达展示",
          "duration": 8,
          "note": "需人工选用，不被3秒包装点自动推荐"
        },
        {
          "id": "us_marketcap_race",
          "name": "市值竞速动画",
          "category": "story_graphic",
          "purpose": "全屏信息图，动态柱状图展示市值/数据排名变化",
          "duration": 15,
          "note": "需人工选用，不被3秒包装点自动推荐"
        }
      ]
    }
  },
  "selectionGuide": {
    "单一核心数据": "single-stat",
    "两个数据对比": "data-compare",
    "带趋势/比例的数据": "trend-ratio",
    "一句话观点/引语": "quote-callout",
    "两个数据推出一个结论": "data-to-conclusion",
    "复杂多维度全屏图": "故事图形（需人工选用）"
  }
}
