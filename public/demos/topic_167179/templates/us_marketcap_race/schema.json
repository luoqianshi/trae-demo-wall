{
  "templateId": "us_marketcap_race",
  "description": "美股十年最高市值公司排名动画（Bar Chart Race）",
  "params": {
    "title": { "type": "string", "required": false, "default": "Top US Companies by Market Cap", "description": "顶部标题文字" },
    "subtitle": { "type": "string", "required": false, "description": "副标题（时间范围）" },
    "dataSource": { "type": "string", "required": false, "default": "Data: S&P Global / Yahoo Finance", "description": "底部数据来源标注" },
    "theme": { "type": "string", "enum": ["blue", "amber"], "default": "blue", "description": "主题色" },
    "timeSeries": {
      "type": "array",
      "required": true,
      "description": "时间序列数据，每个元素包含 date 和 companies 数组",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "description": "日期，格式 YYYY-MM" },
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "description": "公司英文名称" },
                "value": { "type": "number", "description": "市值（美元）" }
              }
            }
          }
        }
      }
    }
  },
  "settings": {
    "resolution": { "type": "array", "default": [1080, 1700] },
    "fps": { "type": "number", "default": 25 },
    "duration": { "type": "number", "default": 15 },
    "format": { "type": "string", "default": "mov-prores4444" }
  }
}
