{
  "templateId": "data_card",
  "description": "数据可视化卡 - 数字/百分比/金额等",
  "params": {
    "mainText": { "type": "string", "required": true, "description": "主文本（数字展示）" },
    "number": { "type": "string", "required": true, "description": "数字值" },
    "unit": { "type": "string", "required": false, "description": "单位" },
    "subText": { "type": "string", "required": true, "description": "描述文字" },
    "source": { "type": "string", "required": false, "description": "数据来源" },
    "displayText": { "type": "string", "required": false, "description": "包装上实际显示的短文案（优先于 mainText）" },
    "preset": { "type": "string", "required": false, "description": "预设样式 key：classic/compare/trend/ring/tag" },
    "theme": { "type": "string", "enum": ["amber", "blue"], "default": "amber" }
  },
  "settings": {
    "resolution": { "type": "array", "default": [1080, 1700] },
    "fps": { "type": "number", "default": 25 },
    "duration": { "type": "number", "default": 3 },
    "format": { "type": "string", "default": "mov-prores4444" }
  }
}