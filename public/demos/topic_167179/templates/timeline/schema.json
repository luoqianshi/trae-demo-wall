{
  "templateId": "timeline",
  "description": "时间轴 - 2-5个节点的时间顺序表达",
  "params": {
    "mainText": { "type": "string", "required": false, "description": "标题" },
    "items": {
      "type": "array",
      "required": true,
      "minItems": 2,
      "maxItems": 5,
      "description": "时间节点列表",
      "items": {
        "time": { "type": "string", "required": true, "description": "时间标签" },
        "text": { "type": "string", "required": true, "description": "事件描述" }
      }
    },
    "displayText": { "type": "string", "required": false, "description": "包装上实际显示的短文案（优先于 mainText）" },
    "preset": { "type": "string", "required": false, "description": "预设样式 key：classic/dual/flow/date_card/milestone" },
    "theme": { "type": "string", "enum": ["amber", "blue"], "default": "amber" }
  },
  "settings": {
    "resolution": { "type": "array", "default": [1080, 1700] },
    "fps": { "type": "number", "default": 25 },
    "duration": { "type": "number", "default": 3 },
    "format": { "type": "string", "default": "mov-prores4444" }
  }
}