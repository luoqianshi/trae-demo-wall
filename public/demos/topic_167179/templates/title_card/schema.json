{
  "templateId": "title_card",
  "description": "标题卡片 - 章节过渡/段落标题/结论提示",
  "params": {
    "mainText": { "type": "string", "required": true, "description": "主标题" },
    "subText": { "type": "string", "required": false, "description": "副标题" },
    "source": { "type": "string", "required": false, "description": "底部标签/来源" },
    "displayText": { "type": "string", "required": false, "description": "包装上实际显示的短文案（优先于 mainText）" },
    "preset": { "type": "string", "required": false, "description": "预设样式 key：classic/subtitle/left_bar/conclusion/chapter" },
    "chapterNumber": { "type": "string", "required": false, "description": "章节编号（chapter 预设使用）" },
    "lottieBackground": { "type": "string", "required": false, "description": "可选 Lottie 背景动画 URL/路径" },
    "theme": { "type": "string", "enum": ["amber", "blue"], "default": "amber" }
  },
  "settings": {
    "resolution": { "type": "array", "default": [1080, 1700] },
    "fps": { "type": "number", "default": 25 },
    "duration": { "type": "number", "default": 3 },
    "format": { "type": "string", "default": "mov-prores4444" }
  }
}