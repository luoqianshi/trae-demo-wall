{
  "templateId": "quote_highlight",
  "description": "观点花字 - 突出显示观点/引语",
  "params": {
    "mainText": { "type": "string", "required": true, "description": "主文本（观点/引语）" },
    "subText": { "type": "string", "required": false, "description": "副文本（角色/身份）" },
    "source": { "type": "string", "required": false, "description": "来源" },
    "displayText": { "type": "string", "required": false, "description": "包装上实际显示的短文案（优先于 mainText）" },
    "preset": { "type": "string", "required": false, "description": "预设样式 key：classic/center/speaker/bubble/underline" },
    "theme": { "type": "string", "enum": ["amber", "blue"], "default": "amber", "description": "主题色" }
  },
  "settings": {
    "resolution": { "type": "array", "default": [1080, 1700] },
    "fps": { "type": "number", "default": 25 },
    "duration": { "type": "number", "default": 3 },
    "format": { "type": "string", "default": "mov-prores4444" }
  }
}