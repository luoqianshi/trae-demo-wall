{
  "templateId": "media_radar",
  "description": "新闻媒体影响力雷达图（六边形蜘蛛图）",
  "params": {
    "title": { "type": "string", "required": false, "default": "2026 全球主流媒体影响力评估", "description": "顶部主标题" },
    "subtitle": { "type": "string", "required": false, "default": "Media Influence Radar", "description": "顶部副标题" },
    "source": { "type": "string", "required": false, "default": "数据来源：Media Impact Index 2026", "description": "底部数据来源标注" },
    "dimensions": {
      "type": "array",
      "required": false,
      "default": ["时效性", "深度报道", "公信力", "传播力", "原创性", "社交热度"],
      "description": "六个维度标签"
    },
    "datasets": {
      "type": "array",
      "required": true,
      "description": "三组对比数据",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "媒体名称" },
          "color": { "type": "string", "description": "数据颜色" },
          "values": { "type": "array", "items": { "type": "number" }, "description": "六个维度的分值（0-100）" }
        }
      }
    },
    "theme": { "type": "string", "enum": ["blue", "amber"], "default": "blue", "description": "主装饰色" }
  },
  "settings": {
    "resolution": { "type": "array", "default": [1080, 1700] },
    "fps": { "type": "number", "default": 30 },
    "duration": { "type": "number", "default": 8 },
    "format": { "type": "string", "default": "mov-prores4444" }
  }
}
