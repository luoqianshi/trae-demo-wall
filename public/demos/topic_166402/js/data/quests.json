{
  "quests": [
    {
      "id": "main_001",
      "type": "main",
      "title": "丝绸之路的召唤",
      "description": "敦煌大漠深处，一股东归的古老力量正在黄沙之下苏醒。慧明法师手中的无名残经似乎与此息息相关。前去拜访慧明法师，探听丝路异象之源。",
      "objectives": [
        { "id": "obj_1", "description": "前往敦煌寻访慧明法师", "target": 1, "progress": 0 },
        { "id": "obj_2", "description": "聆听慧明法师讲述残经来历", "target": 1, "progress": 0 }
      ],
      "rewards": { "gold": 100, "items": [] },
      "prerequisites": [],
      "npcTrigger": "huiming"
    },
    {
      "id": "main_002",
      "type": "main",
      "title": "断刀与旧案",
      "description": "戍边校尉王虎暗中尾随一支来路不明的商队，线索竟指向他二十年前一桩不愿提起的旧案。协助王虎追查商队真相，了结尘封多年的心结。",
      "objectives": [
        { "id": "obj_1", "description": "与王虎接头了解案情", "target": 1, "progress": 0 },
        { "id": "obj_2", "description": "潜入可疑商队查证货物", "target": 1, "progress": 0 },
        { "id": "obj_3", "description": "将查得线索回报王虎", "target": 1, "progress": 0 }
      ],
      "rewards": { "gold": 200, "items": [{ "id": "broken_blade", "name": "无鞘断刀", "count": 1 }] },
      "prerequisites": ["main_001"],
      "npcTrigger": "wanghu"
    },
    {
      "id": "side_001",
      "type": "side",
      "title": "走散的驼队",
      "description": "康居宝的驼队在大漠中遭遇百年不遇的黑沙暴，骆驼散失大半，珍稀货物毁损过半。这位粟特商贾正为寻回走散的货物焦头烂额，前去搭把手吧。",
      "objectives": [
        { "id": "obj_1", "description": "在沙暴过处寻回散落的货物", "target": 3, "progress": 0 },
        { "id": "obj_2", "description": "护送货物返回康居宝处", "target": 1, "progress": 0 }
      ],
      "rewards": { "gold": 150, "items": [{ "id": "silk", "name": "上等丝绸", "count": 2 }] },
      "prerequisites": [],
      "npcTrigger": "kangjubao"
    },
    {
      "id": "side_002",
      "type": "side",
      "title": "天音舞的密信",
      "description": "龟兹末代公主阿依古丽收到一封辗转千里的密信：故国遗臣已在敦煌聚义，欲迎她归国复位。她托你将回信暗中送达敦煌故人手中，切记不可走漏风声。",
      "objectives": [
        { "id": "obj_1", "description": "接收阿依古丽托付的密信", "target": 1, "progress": 0 },
        { "id": "obj_2", "description": "避开耳目将密信送达敦煌故人", "target": 1, "progress": 0 }
      ],
      "rewards": { "gold": 120, "items": [{ "id": "kucha_jade", "name": "龟兹王徽玉佩", "count": 1 }] },
      "prerequisites": [],
      "npcTrigger": "ayiguli"
    },
    {
      "id": "side_003",
      "type": "side",
      "title": "沙中青天",
      "description": "大漠侠客黑风追查当年灭门惨案的幕后真凶，那柄刻着被磨去李字的无鞘断刀是他唯一的线索。他请你协助清剿盘踞商道、劫掠商旅的马贼，还丝路一片清明。",
      "objectives": [
        { "id": "obj_1", "description": "击退盘踞商道的马贼", "target": 4, "progress": 0 },
        { "id": "obj_2", "description": "寻得马贼头目身上的可疑信物", "target": 1, "progress": 0 },
        { "id": "obj_3", "description": "将信物交予黑风辨认", "target": 1, "progress": 0 }
      ],
      "rewards": { "gold": 180, "items": [{ "id": "li_charm", "name": "残缺李字符牌", "count": 1 }] },
      "prerequisites": [],
      "npcTrigger": "heifeng"
    }
  ]
}
