                <span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span>
                <span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span>
                <span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span><span class="heatmap-cell heatmap-cell--0"></span>
              </div>
            </div>
          </div>
          <!-- Legend -->
          <div class="heatmap-legend">
            <span class="heatmap-legend-label">少</span>
            <div class="heatmap-legend-squares">
              <span class="heatmap-legend-cell heatmap-cell--0"></span>
              <span class="heatmap-legend-cell heatmap-cell--1"></span>
              <span class="heatmap-legend-cell heatmap-cell--2"></span>
              <span class="heatmap-legend-cell heatmap-cell--3"></span>
            </div>
            <span class="heatmap-legend-end">多</span>
          </div>
        </div>
      </div>

      <!-- C) Monthly Stats Card -->
      <div class="monthly-section">
        <div class="monthly-card">
          <div class="monthly-title">本月统计</div>
          <div class="monthly-stats">书写 15 天 · 日均 280 字 · 最活跃：哲学思考</div>
          <div class="monthly-progress-label">本月目标 20 天，已完成 15 天</div>
          <div class="monthly-progress-track">
            <div class="monthly-progress-fill"></div>
          </div>
        </div>
      </div>

      <!-- Bottom spacing for nav -->
      <div class="bottom-spacer"></div>

    </div>

    <!-- Bottom Tab Bar -->
    <nav class="tab-bar">

      <!-- Tab 1: 首页 (Home) -->
      <button class="tab-item tab-item--inactive" aria-label="首页" data-dom-id="nav-home">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9.5z"/>
        </svg>
        <span class="tab-item-label">首页</span>
      </button>

      <!-- Tab 2: 回顾 (Review / Calendar) -->
      <button class="tab-item tab-item--inactive" aria-label="回顾" data-dom-id="nav-review">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="3"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <path d="M8 14l2.5 2.5L16 11"/>
        </svg>
        <span class="tab-item-label">回顾</span>
      </button>

      <!-- Tab 3: 活动 (Activity / Grid) - ACTIVE -->
      <button class="tab-item tab-item--active" aria-label="活动" data-dom-id="nav-activity">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="8" height="8" rx="2"/>
          <rect x="13" y="3" width="8" height="8" rx="2"/>
          <rect x="3" y="13" width="8" height="8" rx="2"/>
          <rect x="13" y="13" width="8" height="8" rx="2"/>
        </svg>
        <span class="tab-item-label">活动</span>
      </button>

      <!-- Tab 4: 设置 (Settings / Gear) -->
      <button class="tab-item tab-item--inactive" aria-label="设置" data-dom-id="nav-settings">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
        </svg>
        <span class="tab-item-label">设置</span>
      </button>

    </nav>

  </div>

    <style>
    /* ── Reset ── */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow-x: hidden;
      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'Noto Sans SC', sans-serif;
      background: #FAFAFA;
      color: #18181B;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ── Shell Layout ── */
    .app-shell {
      position: relative;
      width: 375px;
      min-height: 812px;
      max-width: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      background: #FAFAFA;
    }

    /* ── Status Bar ── */
    .status-bar {
      position: relative;
      width: 100%;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      background: transparent;
      z-index: 100;
      flex-shrink: 0;
    }

    .status-bar-time {
      font-size: 15px;
      font-weight: 600;
      color: #18181B;
      letter-spacing: 0.02em;
    }

    .status-bar-icons {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .status-bar-icons svg {
      display: block;
    }

    /* ── System Capsule ── */
    .sys-capsule {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      width: 87px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(0, 0, 0, 0.06);
      border-radius: 9999px;
      padding: 3px 8px;
      z-index: 101;
    }

    .sys-capsule span {
      font-size: 12px;
      font-weight: 500;
      color: #18181B;
      line-height: 1;
    }

    .sys-capsule .capsule-divider {
      width: 1px;
      height: 14px;
      background: rgba(0, 0, 0, 0.12);
      flex-shrink: 0;
    }

    /* ── Page Content Area ── */
    .page-content {
      flex: 1;
      width: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
    }

    /* ── Bottom Tab Bar ── */
    .tab-bar {
      position: relative;
      width: 100%;
      height: 83px;
      display: flex;
      align-items: flex-start;
      justify-content: space-around;
      background: #FFFFFF;
      box-shadow: 0 -1px 12px rgba(0, 0, 0, 0.05);
      padding-top: 8px;
      padding-bottom: 34px;
      flex-shrink: 0;
      z-index: 100;
    }

    .tab-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 4px;
      width: 25%;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      text-decoration: none;
      background: none;
      border: none;
      outline: none;
    }

    .tab-item svg {
      display: block;
      transition: color 0.2s ease;
    }

    .tab-item-label {
      font-size: 10px;
      font-weight: 500;
      line-height: 1;
      transition: color 0.2s ease;
    }

    /* ── Tab States ── */
    .tab-item--active svg {
      color: #F97316;
    }

    .tab-item--active .tab-item-label {
      color: #F97316;
    }

    .tab-item--inactive svg {
      color: #A1A1AA;
    }

    .tab-item--inactive .tab-item-label {
      color: #A1A1AA;
    }

    /* ── Page Title ── */
    .page-title {
      padding: 16px 20px 0;
      font-size: 20px;
      font-weight: 700;
      color: #18181B;
    }

    .page-subtitle {
      padding: 4px 20px 0;
      font-size: 13px;
      color: #A1A1AA;
    }

    /* ── Stats Summary Row ── */
    .stats-row {
      display: flex;
      gap: 10px;
      padding: 16px 20px;
    }

    .stat-card {
      flex: 1;
      background: #FFFFFF;
      border-radius: 16px;
      padding: 18px 12px;
      text-align: center;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    }

    .stat-number {
      font-size: 32px;
      font-weight: 700;
      line-height: 1.2;
    }

    .stat-number--gradient {
      background: linear-gradient(135deg, #F97316, #F59E0B);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .stat-number--dark {
      color: #18181B;
    }

    .stat-label {
      font-size: 12px;
      color: #71717A;
      margin-top: 4px;
    }

    /* ── Heatmap Section ── */
    .heatmap-section {
      padding: 16px 20px;
    }

    .heatmap-card {
      background: #FFFFFF;
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    }

    .heatmap-title {
      font-size: 14px;
      font-weight: 600;
      color: #18181B;
      margin-bottom: 16px;
    }

    /* Month labels */
    .heatmap-months {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      padding: 0 2px;
    }

    .heatmap-month-label {
      font-size: 10px;
      color: #A1A1AA;
      width: calc(100% / 12);
      text-align: center;
    }

    /* CSS Grid Heatmap */
    .heatmap-row-wrapper {
      display: flex;
    }

    .heatmap-days {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-right: 6px;
      flex-shrink: 0;
    }

    .heatmap-day-label {
      font-size: 9px;
      color: #A1A1AA;
      line-height: 14px;
      height: 14px;
      text-align: right;
    }

    .heatmap-grid-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }

    .heatmap-grid-wrapper::-webkit-scrollbar {
      display: none;
    }

    .heatmap-grid {
      display: grid;
      grid-template-rows: repeat(7, 14px);
      grid-auto-flow: column;
      gap: 3px;
      grid-auto-columns: 14px;
    }

    .heatmap-cell {
      width: 14px;
      height: 14px;
      border-radius: 3px;
    }

    .heatmap-cell--0 { background: #F5F5F5; }
    .heatmap-cell--1 { background: #FED7AA; }
    .heatmap-cell--2 { background: #FB923C; }
    .heatmap-cell--3 { background: #F97316; }

    /* Legend */
    .heatmap-legend {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      margin-top: 12px;
    }

    .heatmap-legend-label {
      font-size: 10px;
      color: #A1A1AA;
      margin-right: 4px;
    }

    .heatmap-legend-squares {
      display: flex;
      gap: 3px;
      align-items: center;
    }

    .heatmap-legend-cell {
      width: 10px;
      height: 10px;
      border-radius: 2px;
    }

    .heatmap-legend-end {
      font-size: 10px;
      color: #A1A1AA;
      margin-left: 4px;
    }

    /* ── Monthly Stats Card ── */
    .monthly-section {
      padding: 16px 20px;
    }

    .monthly-card {
      background: #FFFFFF;
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    }

    .monthly-title {
      font-size: 14px;
      font-weight: 600;
      color: #18181B;
      margin-bottom: 12px;
    }

    .monthly-stats {
      font-size: 13px;
      color: #71717A;
      line-height: 1.8;
      margin-bottom: 16px;
    }

    .monthly-progress-label {
      font-size: 12px;
      color: #71717A;
      margin-bottom: 8px;
    }

    .monthly-progress-track {
      width: 100%;
      height: 8px;
      background: #F5F5F5;
      border-radius: 4px;
      overflow: hidden;
    }

    .monthly-progress-fill {
      width: 75%;
      height: 100%;
      background: linear-gradient(135deg, #F97316, #F59E0B);
      border-radius: 4px;
    }

    /* ── Bottom spacing for nav ── */
    .bottom-spacer {
      height: 100px;
    }
  </style>
</body>
</html>
