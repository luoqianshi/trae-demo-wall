# ===== 演示模式（推荐 demo 阶段使用）=====
# 设为 true 时只用本地题库（app/data/scenarios.json + EXTENDED_SCENARIOS），
# 无需联网、无需 ARK Key。注意：即使不设此项，只要没有 ARK_API_KEY，
# 后端也会自动进入演示模式（见 route.ts 的 isDemoMode()）。
DEMO_MODE=true

# ===== ARK 实时生成模式（可选，演示模式下不需要）=====
# 火山方舟 ARK API Key；填了且 DEMO_MODE 不为 true 时启用实时生成。
# ARK_API_KEY=your_ark_api_key
# ARK_MODEL=doubao-seed-2-0-mini-260428
