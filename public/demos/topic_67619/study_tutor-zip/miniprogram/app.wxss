page {
  background-color: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #333;
  font-size: 28rpx;
}

.container {
  padding: 32rpx;
}

.btn-primary {
  background-color: #1296db;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-primary[disabled] {
  background-color: #cccccc;
}
