.meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  background: #e8f4fd;
  color: #1296db;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.section {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.hint-step {
  margin: 16rpx 0;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.step-label {
  display: inline-block;
  background: #1296db;
  color: white;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.btn-next {
  background: white;
  color: #1296db;
  border: 2rpx solid #1296db;
  border-radius: 8rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
}

.solve-step {
  display: flex;
  margin: 16rpx 0;
}

.step-num {
  font-weight: 600;
  margin-right: 16rpx;
  color: #1296db;
}

.step-body {
  flex: 1;
}

.step-basis {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.final-answer {
  margin-top: 24rpx;
  padding: 16rpx;
  background: #fff8e1;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.actions {
  margin: 32rpx 0;
}

.feedback {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.feedback-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-fb {
  flex: 1;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.btn-fb-good {
  background: #e8f5e9;
  color: #2e7d32;
}

.btn-fb-bad {
  background: #fbe9e7;
  color: #c62828;
}

.feedback-done {
  text-align: center;
  color: #888;
  padding: 24rpx;
}
