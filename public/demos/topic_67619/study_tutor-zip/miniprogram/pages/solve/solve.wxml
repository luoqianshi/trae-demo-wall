<view class="container" wx:if="{{solution}}">
  <view class="meta">
    <text class="tag">{{solution.topic}}</text>
    <text class="tag">{{solution.difficulty}}</text>
  </view>

  <view class="section">
    <view class="section-title">题意理解</view>
    <view class="section-body">{{solution.restatement}}</view>
  </view>

  <view class="section">
    <view class="section-title">思路提示</view>
    <view class="hint-step">
      <text class="step-label">第 1 层</text>
      <text>{{solution.hint1}}</text>
    </view>
    <view wx:if="{{visibleLevel >= 2}}" class="hint-step">
      <text class="step-label">第 2 层</text>
      <text>{{solution.hint2}}</text>
    </view>

    <button wx:if="{{visibleLevel === 1}}" class="btn-next" bindtap="showHint2">
      还是没思路，再细一点
    </button>
    <button wx:if="{{visibleLevel === 2}}" class="btn-next" bindtap="showFull">
      直接看完整解析
    </button>
  </view>

  <view wx:if="{{visibleLevel >= 3}}" class="section">
    <view class="section-title">完整解析</view>
    <view wx:for="{{solution.solution_steps}}" wx:key="step" class="solve-step">
      <text class="step-num">{{item.step}}.</text>
      <view class="step-body">
        <text>{{item.content}}</text>
        <view class="step-basis">{{item.basis}}</view>
      </view>
    </view>
    <view class="final-answer">
      最终答案：<formula-renderer latex="{{solution.final_answer}}" />
    </view>
  </view>

  <view class="actions">
    <button
      class="btn-primary"
      bindtap="addToMistakes"
      loading="{{savingMistake}}"
      disabled="{{savingMistake}}"
    >
      加入错题本
    </button>
  </view>

  <view wx:if="{{visibleLevel >= 3 && !feedbackSubmitted}}" class="feedback">
    <text>AI 生成 · 最后核对：你</text>
    <view>答案对吗？</view>
    <view class="feedback-btns">
      <button class="btn-fb btn-fb-good" data-correct="true" bindtap="submitFeedback">对</button>
      <button class="btn-fb btn-fb-bad" data-correct="false" bindtap="submitFeedback">错</button>
    </view>
  </view>

  <view wx:if="{{feedbackSubmitted}}" class="feedback-done">
    已收到反馈，谢谢
  </view>
</view>
