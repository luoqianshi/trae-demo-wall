<view class="container">
  <view class="header">
    <text class="title">错题本</text>
    <text class="count">{{items.length}} 道</text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <view wx:elif="{{items.length === 0}}" class="empty">
    还没有错题，先去拍一道题试试
  </view>

  <view wx:else>
    <view
      wx:for="{{items}}"
      wx:key="_id"
      class="card"
      data-id="{{item._id}}"
      bindtap="openMistake"
    >
      <view class="card-meta">
        <text class="tag">{{item.question.topic}}</text>
        <text class="tag">{{item.question.difficulty}}</text>
      </view>
      <view class="card-text">{{item.question.cleanedText}}</view>
      <view class="card-footer">
        <text class="time">{{item.addedAt}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>
</view>
