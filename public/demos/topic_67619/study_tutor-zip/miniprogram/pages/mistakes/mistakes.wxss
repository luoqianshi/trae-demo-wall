.header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.count {
  color: #888;
  font-size: 28rpx;
}

.empty {
  text-align: center;
  color: #888;
  padding: 120rpx 0;
}

.card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag {
  background: #e8f4fd;
  color: #1296db;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.card-text {
  font-size: 30rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-footer {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaa;
}

.error {
  margin-top: 24rpx;
  color: #e74c3c;
  text-align: center;
}
