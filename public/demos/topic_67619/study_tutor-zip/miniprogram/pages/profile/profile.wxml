<view class="container">
  <view class="card">
    <view class="row">
      <text class="label">当前方案</text>
      <text class="value">{{plan === 'pro' ? '订阅会员' : '免费版'}}</text>
    </view>
    <view class="row">
      <text class="label">今日已用</text>
      <text class="value">{{dailyUsed}} / {{dailyLimit}}</text>
    </view>
    <view class="row" wx:if="{{plan === 'free'}}">
      <text class="label">剩余</text>
      <text class="value">{{remaining}} 次</text>
    </view>
  </view>

  <button wx:if="{{plan === 'free'}}" class="btn-primary" bindtap="upgrade">
    升级订阅（W2 上线）
  </button>

  <view class="card">
    <view class="hint">
      W1 内测阶段，每日免费 100 次。正式上线后免费额度 3 次/日。
    </view>
  </view>
</view>
