.card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 30rpx;
}

.label {
  color: #888;
}

.value {
  font-weight: 500;
}

.hint {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}
