<view class="container">
  <view class="hero">
    <view class="title">拍下不会的题</view>
    <view class="subtitle">AI 分步讲明白</view>
  </view>

  <button
    class="btn-primary"
    bindtap="chooseAndUpload"
    loading="{{uploading}}"
    disabled="{{uploading}}"
  >
    {{uploading ? '识别中...' : '拍照 / 选图'}}
  </button>

  <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>
</view>
