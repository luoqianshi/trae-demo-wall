.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.confidence-bar {
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.confidence.low {
  color: #e74c3c;
  font-weight: 600;
}

.preview {
  width: 100%;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
}

.text-input {
  width: 100%;
  min-height: 200rpx;
  background: white;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.segments {
  margin-top: 24rpx;
}

.hint {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.segment {
  padding: 16rpx;
  background: white;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
}

.segment-low {
  border-left: 6rpx solid #e74c3c;
  background: #fdf2f2;
}

.error {
  margin-top: 24rpx;
  color: #e74c3c;
  text-align: center;
}
