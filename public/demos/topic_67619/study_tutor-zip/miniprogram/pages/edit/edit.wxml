<view class="container">
  <view class="title">检查题目</view>

  <view class="confidence-bar">
    <text>识别置信度：</text>
    <text class="confidence {{confidence < 0.7 ? 'low' : ''}}">
      {{confidence < 0.7 ? '偏低，请重点核对' : '良好'}}
    </text>
  </view>

  <image
    wx:if="{{fileID}}"
    class="preview"
    src="{{fileID}}"
    mode="widthFix"
  />

  <textarea
    class="text-input"
    value="{{text}}"
    bindinput="onTextInput"
    placeholder="修正题目内容..."
    auto-height
    maxlength="-1"
  />

  <view wx:if="{{segments.length}}" class="segments">
    <view class="hint">识别片段（红色为低置信，请重点核对）：</view>
    <view
      wx:for="{{segments}}"
      wx:key="index"
      class="segment {{item.confidence < 0.7 ? 'segment-low' : ''}}"
    >
      {{item.text}}
    </view>
  </view>

  <button
    class="btn-primary"
    bindtap="submit"
    loading="{{submitting}}"
    disabled="{{submitting}}"
  >
    {{submitting ? '生成讲解中...' : '让 AI 讲解'}}
  </button>

  <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>
</view>
