{
  "name": "webmotion-mcp",
  "version": "1.0.0",
  "description": "WebMotion MCP Server - 让 AI Agent 能够生成和编辑 MG 动画代码，导出透明通道视频素材",
  "type": "mcp-server",
  "transport": {
    "type": "stdio",
    "command": "node",
    "args": ["server.js"]
  },
  "tools": [
    {
      "name": "generate_animation",
      "description": "根据文案文本生成 MG 动画场景。AI 分析文案中的关键重点，为每个重点生成 Canvas 2D 动画代码。生成的动画带透明通道，可叠加在视频上使用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "需要生成动画的文案文本。例如科普脚本、产品介绍、知识点讲解等。"
          },
          "sceneCount": {
            "type": "number",
            "description": "期望生成的场景数量（3-5个为佳）。可选，默认由 AI 自动判断。",
            "default": 4
          },
          "style": {
            "type": "string",
            "description": "动画风格描述。例如：科技感、活泼、商务、教育等。",
            "default": "现代简约"
          },
          "resolution": {
            "type": "string",
            "description": "画布分辨率。",
            "enum": ["1920x1080", "1280x720", "1080x1080", "1080x1920"],
            "default": "1280x720"
          },
          "fps": {
            "type": "number",
            "description": "帧率。",
            "enum": [24, 30, 60],
            "default": 30
          }
        },
        "required": ["text"]
      }
    },
    {
      "name": "generate_single_scene",
      "description": "生成单个动画场景的 Canvas 2D 代码。用于在现有项目中添加新场景或修改特定场景。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "动画效果描述。例如：'一个从左到右滑入的标题文字，带有淡入效果'"
          },
          "duration": {
            "type": "number",
            "description": "动画时长（秒）。",
            "default": 3
          },
          "width": {
            "type": "number",
            "description": "画布宽度。",
            "default": 1280
          },
          "height": {
            "type": "number",
            "description": "画布高度。",
            "default": 720
          }
        },
        "required": ["description"]
      }
    },
    {
      "name": "list_templates",
      "description": "列出所有可用的动画模板。模板包含预设的动画代码，可以直接使用或作为起点修改。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "get_template",
      "description": "获取指定模板的完整代码。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "description": "模板 ID",
            "enum": ["typewriter", "bounce-text", "bar-chart", "particles", "gradient-text", "circle-burst"]
          }
        },
        "required": ["templateId"]
      }
    },
    {
      "name": "export_animation",
      "description": "将动画导出为带透明通道的视频素材。支持 PNG 序列帧（ZIP）和 WebM with Alpha 格式。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Canvas 2D 动画代码"
          },
          "duration": {
            "type": "number",
            "description": "动画时长（秒）",
            "default": 3
          },
          "fps": {
            "type": "number",
            "description": "帧率",
            "default": 30
          },
          "format": {
            "type": "string",
            "description": "导出格式",
            "enum": ["png", "webm"],
            "default": "png"
          },
          "width": {
            "type": "number",
            "description": "画布宽度",
            "default": 1280
          },
          "height": {
            "type": "number",
            "description": "画布高度",
            "default": 720
          }
        },
        "required": ["code"]
      }
    },
    {
      "name": "validate_code",
      "description": "验证动画代码是否能正确运行，返回语法检查结果和预览信息。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "要验证的 Canvas 2D 动画代码"
          }
        },
        "required": ["code"]
      }
    }
  ],
  "prompts": [
    {
      "name": "mg_animation_from_script",
      "description": "从文案脚本生成 MG 动画的提示模板",
      "arguments": [
        {
          "name": "script",
          "description": "文案脚本内容",
          "required": true
        },
        {
          "name": "style",
          "description": "动画风格",
          "required": false
        }
      ]
    }
  ]
}
