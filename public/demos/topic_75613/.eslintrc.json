{
  "env": {
    "browser": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-console": "off",
    "no-extra-semi": "warn",
    "no-unreachable": "warn",
    "no-redeclare": "warn",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": "warn",
    "no-constant-condition": "warn",
    "eqeqeq": "warn",
    "curly": "warn",
    "semi": ["warn", "always"]
  },
  "globals": {
    "PolicyMateStore": "readonly",
    "PolicyMateMatcher": "readonly",
    "PolicyMateRouter": "readonly",
    "PolicyMateA11y": "readonly",
    "PolicyMateApp": "readonly"
  }
}
