<!-- 科普知识 -->
<view class="knowledge-page">
  <!-- 分类Tab -->
  <view class="tabs-container">
    <scroll-view class="tabs-scroll" scroll-x>
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="tab-item {{currentCategory === item ? 'active' : ''}}"
        bindtap="switchCategory"
        data-category="{{item}}"
      >
        <text>{{item}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 文章列表 -->
  <view class="article-list" wx:if="{{!showDetail}}">
    <view class="article-card" wx:for="{{articles}}" wx:key="id" bindtap="showArticleDetail" data-index="{{index}}">
      <view class="article-header">
        <text class="article-title">{{item.title}}</text>
      </view>
      <text class="article-summary">{{item.summary}}</text>
      <view class="article-footer">
        <view class="tags">
          <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
        <text class="views">📖 {{item.views}}</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{articles.length === 0}}">
      <text>暂无相关文章</text>
    </view>
  </view>

  <!-- 文章详情页 -->
  <view class="detail-page" wx:if="{{showDetail && currentArticle}}">
    <view class="detail-header">
      <text class="back-btn" bindtap="closeDetail">← 返回</text>
      <text class="detail-title">{{currentArticle.title}}</text>
      <view class="detail-meta">
        <text class="views-count">阅读 {{currentArticle.views}}</text>
        <view class="detail-tags">
          <text class="tag" wx:for="{{currentArticle.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
      </view>
    </view>

    <view class="detail-content">
      <text class="detail-text" wx:for="{{currentArticle.contentLines}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="detail-actions">
      <button class="action-btn" open-type="share">
        ↗️ 分享文章
      </button>
    </view>
  </view>
</view>
