<!-- 首页 - fit-diet-app Screen 1 莫兰迪风格 -->
<scroll-view class="home-page" scroll-y enable-back-to-top>
  <view class="home-content">

    <!-- 1. 顶部问候区 -->
    <view class="header-row" bindtap="onTapAvatar">
      <view class="greeting">
        <text class="greeting-text">{{greeting}}，{{displayName}}</text>
        <text class="greeting-sub" wx:if="{{isLoggedIn}}">减脂目标 · 已坚持{{persistDays}}天</text>
        <text class="greeting-sub login-tip" wx:else>点击登录，开启健康生活</text>
      </view>
      <view class="avatar">
        <image wx:if="{{isLoggedIn && userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else class="avatar-icon">人</text>
      </view>
    </view>

    <!-- 2. 热量卡片 -->
    <view class="card cal-card">
      <view class="cal-header">
        <text class="cal-title">今日热量摄入</text>
        <text class="cal-target">目标 {{nutritionTarget.calories}} kcal</text>
      </view>
      <view class="progress-row">
        <text class="cal-number">{{todayCalories}}</text>
        <text class="cal-label">kcal 已摄入</text>
      </view>
      <view class="bar-bg">
        <view class="bar-fill" style="width: {{calorieProgress}}%"></view>
      </view>
      <view class="macro-grid">
        <view class="macro-box protein">
          <text class="macro-name">蛋白质</text>
          <text class="macro-value protein-text">{{todayProtein}}g / {{nutritionTarget.protein}}g</text>
        </view>
        <view class="macro-box carb">
          <text class="macro-name">碳水</text>
          <text class="macro-value carb-text">{{todayCarb}}g / {{nutritionTarget.carb}}g</text>
        </view>
        <view class="macro-box fat">
          <text class="macro-name">脂肪</text>
          <text class="macro-value fat-text">{{todayFat}}g / {{nutritionTarget.fat}}g</text>
        </view>
        <view class="macro-box fiber">
          <text class="macro-name">膳食纤维</text>
          <text class="macro-value fiber-text">{{todayFiber}}g / {{nutritionTarget.fiber}}g</text>
        </view>
        <view class="macro-box vitaminC">
          <text class="macro-name">维生素C</text>
          <text class="macro-value vitaminC-text">{{todayVitaminC}}mg / {{nutritionTarget.vitaminC}}mg</text>
        </view>
        <view class="macro-box calcium">
          <text class="macro-name">钙</text>
          <text class="macro-value calcium-text">{{todayCalcium}}mg / {{nutritionTarget.calcium}}mg</text>
        </view>
      </view>
    </view>

    <!-- 3. 快捷操作 -->
    <view class="quick-actions">
      <view class="action-btn meal" bindtap="quickAdd" data-type="breakfast">
        <view class="action-circle meal-circle">
          <text class="action-icon-text">餐</text>
        </view>
        <text class="action-label meal-label">记录饮食</text>
      </view>
      <view class="action-btn exercise" bindtap="navigateToTool" data-path="/pages/exercise/exercise">
        <view class="action-circle exercise-circle">
          <text class="action-icon-text">动</text>
        </view>
        <text class="action-label exercise-label">记录运动</text>
      </view>
      <view class="action-btn recipe" bindtap="navigateToTool" data-path="/pages/recipe/recipe">
        <view class="action-circle recipe-circle">
          <text class="action-icon-text">谱</text>
        </view>
        <text class="action-label recipe-label">食谱库</text>
      </view>
    </view>

    <!-- 4. 今日三餐列表 -->
    <view class="card meal-section">
      <view class="meal-header">
        <text class="meal-section-title">今日三餐</text>
        <text class="add-btn" bindtap="quickAdd" data-type="breakfast">+ 添加</text>
      </view>
      <view class="meal-list">
        <view class="meal-item" bindtap="quickAdd" data-type="breakfast">
          <view class="meal-icon-wrap bf">
            <text class="meal-icon-text">早</text>
          </view>
          <view class="meal-info">
            <text class="meal-name">早餐</text>
            <text class="meal-detail">{{meals.breakfast.desc}}</text>
          </view>
          <text class="meal-cal bf-cal">{{meals.breakfast.cal}} kcal</text>
        </view>
        <view class="meal-item" bindtap="quickAdd" data-type="lunch">
          <view class="meal-icon-wrap lunch">
            <text class="meal-icon-text">午</text>
          </view>
          <view class="meal-info">
            <text class="meal-name">午餐</text>
            <text class="meal-detail">{{meals.lunch.desc}}</text>
          </view>
          <text class="meal-cal lunch-cal">{{meals.lunch.cal}} kcal</text>
        </view>
        <view class="meal-item" bindtap="quickAdd" data-type="dinner">
          <view class="meal-icon-wrap dinner">
            <text class="meal-icon-text">晚</text>
          </view>
          <view class="meal-info">
            <text class="meal-name">晚餐</text>
            <text class="meal-detail">{{meals.dinner.desc}}</text>
          </view>
          <text class="meal-cal dinner-cal">{{meals.dinner.cal}} kcal</text>
        </view>
      </view>
    </view>

    <!-- 5. 运动消耗卡片 -->
    <view class="card exercise-card">
      <view class="ex-icon-wrap">
        <text class="ex-icon-text">动</text>
      </view>
      <view class="ex-info">
        <text class="ex-name">今日运动消耗</text>
        <text class="ex-detail">{{exerciseDesc}}</text>
      </view>
      <text class="ex-cal">-{{exerciseCalories}}</text>
    </view>

  </view>
</scroll-view>
