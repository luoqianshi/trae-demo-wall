<!-- 食谱详情 -->
<view class="recipe-detail-page" wx:if="{{recipeInfo}}">
  <!-- 食谱图片区域 -->
  <view class="recipe-hero">
    <image wx:if="{{recipeInfo.image}}" class="hero-img" src="{{recipeInfo.image}}" mode="aspectFill" />
    <view wx:else class="hero-fallback" style="background: {{heroGradient}};"></view>
    <view class="hero-overlay">
      <text class="recipe-name">{{recipeInfo.name}}</text>
      <view class="tags">
        <text class="tag" wx:for="{{recipeInfo.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 营养数据卡片 -->
  <view class="card nutrition-card">
    <view class="section-header">
      <text class="section-title">营养数据</text>
      <text class="servings-info">{{recipeInfo.servings}}人份</text>
    </view>
    <view class="nutrition-grid">
      <view class="nutrition-item highlight">
        <text class="nutrition-value">{{recipeInfo.nutrition.calories}}</text>
        <text class="nutrition-unit">kcal</text>
        <text class="nutrition-label">总热量</text>
      </view>
      <view class="nutrition-item">
        <text class="nutrition-value protein">{{recipeInfo.nutrition.protein}}g</text>
        <text class="nutrition-label">蛋白质</text>
      </view>
      <view class="nutrition-item">
        <text class="nutrition-value carb">{{recipeInfo.nutrition.carbs}}g</text>
        <text class="nutrition-label">碳水</text>
      </view>
      <view class="nutrition-item">
        <text class="nutrition-value fat">{{recipeInfo.nutrition.fat}}g</text>
        <text class="nutrition-label">脂肪</text>
      </view>
    </view>
    <view class="time-info">
      <text class="time-item">准备 {{recipeInfo.prepTime}}分钟</text>
    </view>
  </view>

  <!-- 配料清单 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">配料清单</text>
      <text class="copy-btn" bindtap="copyIngredients">一键复制</text>
    </view>
    <view class="ingredients-list">
      <view class="ingredient-item" wx:for="{{recipeInfo.ingredients}}" wx:key="name">
        <view class="ingredient-check"></view>
        <view class="ingredient-info">
          <text class="ingredient-name">{{item.name}}</text>
          <text class="ingredient-amount">{{item.amount}}</text>
          <text class="ingredient-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 详细做法步骤 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">详细做法</text>
    </view>
    <view class="steps-list">
      <view class="step-item" wx:for="{{recipeInfo.steps}}" wx:key="step">
        <view class="step-number-wrapper">
          <text class="step-number">{{item.step}}</text>
        </view>
        <view class="step-content">
          <text class="step-text">{{item.text}}</text>
          <text class="step-time" wx:if="{{item.time > 0}}">
            {{item.time}}{{item.unit}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 小贴士区域 -->
  <view class="card tips-card" wx:if="{{recipeInfo.tips}}">
    <text class="tips-icon">*</text>
    <text class="tips-text">{{recipeInfo.tips}}</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="collect-btn {{recipeInfo.isCollected ? 'collected' : ''}}" bindtap="toggleCollect">
      {{recipeInfo.isCollected ? '已收藏' : '收藏'}}
    </button>
    <button class="diet-btn" bindtap="addToDietRecord">
      加入饮食记录
    </button>
  </view>
</view>
