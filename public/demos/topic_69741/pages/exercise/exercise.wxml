<!-- 运动记录 - 莫兰迪风格 fit-diet-app Screen 4 -->
<view class="exercise-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">运动记录</text>
    <text class="page-subtitle">今日消耗与热量缺口联动</text>
  </view>

  <!-- 热量缺口卡片 -->
  <view class="card deficit-card">
    <view class="def-row">
      <text class="def-label">热量缺口</text>
      <text class="def-value">-{{calorieDeficit}} kcal</text>
    </view>
    <text class="def-detail">摄入 {{intakeCalories}} kcal - 消耗 {{burnCalories}} kcal - 基础代谢 {{basalMetabolic}} kcal</text>
    <view class="bar-bg">
      <view class="bar-fill" style="width: {{deficitPercent}}%"></view>
    </view>
    <!-- 今日总消耗 -->
    <view class="today-summary-row">
      <text class="summary-label">今日总消耗</text>
      <text class="summary-value">{{todaySummary.totalCalories}} kcal · {{todaySummary.totalTime}}分钟 · {{todaySummary.exerciseCount}}次运动</text>
    </view>
  </view>

  <!-- 上次运动（记忆模式） -->
  <view class="card" wx:if="{{showLastSection}}">
    <text class="section-title">上次运动</text>
    <view class="last-exercise-list">
      <view
        wx:for="{{lastExerciseRecords}}"
        wx:key="name"
        class="last-exercise-item"
        bindtap="quickAddLast"
        data-record="{{item}}"
      >
        <view class="last-ex-icon {{item.type === '有氧' ? 'cardio' : item.type === '力量' ? 'strength' : 'hiit'}}">{{item.icon}}</view>
        <view class="last-ex-info">
          <text class="last-ex-name">{{item.name}}</text>
          <text class="last-ex-detail">{{item.type}} · {{item.duration}}分钟 · {{item.caloriesPerMin}}kcal/分</text>
        </view>
        <text class="last-ex-add">快速添加</text>
      </view>
    </view>
  </view>

  <!-- 运动类型选择 -->
  <view class="card type-card">
    <text class="section-title">运动类型</text>
    <view class="ex-type-grid">
      <view class="ex-type-item cardio {{exerciseType === '有氧' ? 'active' : ''}}" bindtap="switchType" data-type="有氧">
        <view class="type-icon-wrap cardio-bg">
          <text class="type-emoji">跑</text>
        </view>
        <text class="type-label cardio-text">有氧运动</text>
      </view>
      <view class="ex-type-item strength {{exerciseType === '力量' ? 'active' : ''}}" bindtap="switchType" data-type="力量">
        <view class="type-icon-wrap strength-bg">
          <text class="type-emoji">力</text>
        </view>
        <text class="type-label strength-text">力量训练</text>
      </view>
      <view class="ex-type-item hiit {{exerciseType === 'HIIT' ? 'active' : ''}}" bindtap="switchType" data-type="HIIT">
        <view class="type-icon-wrap hiit-bg">
          <text class="type-emoji">燃</text>
        </view>
        <text class="type-label hiit-text">HIIT/其他</text>
      </view>
    </view>
  </view>

  <!-- 选择运动 -->
  <view class="card">
    <text class="section-title">选择运动</text>
    <view class="exercise-list">
      <view
        wx:for="{{filteredExercises}}"
        wx:key="id"
        class="exercise-item {{selectedExercise && selectedExercise.id === item.id ? 'selected' : ''}}"
        bindtap="selectExercise"
        data-exercise="{{item}}"
      >
        <view class="ex-item-icon {{item.type === '有氧' ? 'cardio' : item.type === '力量' ? 'strength' : 'hiit'}}">{{item.icon}}</view>
        <view class="ex-item-info">
          <text class="ex-item-name">{{item.name}}</text>
          <text class="ex-item-detail">{{item.type}} · {{item.caloriesPerMin}} kcal/分</text>
        </view>
        <view class="ex-item-check {{selectedExercise && selectedExercise.id === item.id ? 'checked' : ''}}">
          <text wx:if="{{selectedExercise && selectedExercise.id === item.id}}">✓</text>
        </view>
      </view>
    </view>
    <!-- 自定义运动按钮 -->
    <view class="custom-exercise-btn" bindtap="openCustomModal">
      <text class="custom-plus">+</text>
      <text class="custom-label">自定义运动</text>
    </view>
    <button class="add-exercise-btn" bindtap="showAddModal" disabled="{{!selectedExercise}}">
      {{selectedExercise ? '添加运动记录' : '请选择运动类型'}}
    </button>
  </view>

  <!-- 运动记录列表 -->
  <view class="card" wx:if="{{exerciseHistory.length > 0}}">
    <text class="section-title">运动记录</text>
    <view class="ex-log-list">
      <view class="ex-log-item" wx:for="{{exerciseHistory}}" wx:key="id">
        <view class="ex-log-icon {{item.type === '有氧' ? 'cardio' : item.type === '力量' ? 'strength' : 'hiit'}}">{{item.icon}}</view>
        <view class="ex-log-info">
          <text class="name">{{item.name}} · {{item.duration}}分钟</text>
          <text class="detail">{{item.type}} · {{item.date}} {{item.time}}</text>
        </view>
        <view class="ex-log-right">
          <text class="ex-log-cal {{item.type === '有氧' ? 'cardio' : item.type === '力量' ? 'strength' : 'hiit'}}">-{{item.calories}} kcal</text>
          <text class="delete-btn" bindtap="deleteRecord" data-index="{{index}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提示卡片 -->
  <view class="tip-card">
    <text class="tip-title">运动前后怎么吃？</text>
    <text class="tip-desc">练前30min补充碳水，练后30min内摄入蛋白质，帮助肌肉恢复与生长</text>
  </view>

  <!-- 添加运动弹窗 -->
  <view class="modal-mask" wx:if="{{showAddModal}}" bindtap="cancelAdd"></view>
  <view class="modal-content" wx:if="{{showAddModal}}">
    <view class="modal-header">
      <text class="modal-title">添加{{selectedExercise.name}}</text>
      <text class="modal-sub">{{selectedExercise.icon}} {{selectedExercise.type}}</text>
    </view>
    <view class="modal-body">
      <text class="input-label">运动时长（分钟）</text>
      <input
        class="modal-input"
        type="digit"
        value="{{duration}}"
        bindinput="onDurationModalInput"
        placeholder="请输入运动时长"
        focus="{{showAddModal}}"
      />
      <view class="calorie-preview" wx:if="{{duration > 0}}">
        <text class="preview-label">预计消耗</text>
        <text class="preview-value">{{selectedExercise.caloriesPerMin * duration}} kcal</text>
      </view>
    </view>
    <view class="modal-actions">
      <button class="modal-btn cancel" bindtap="cancelAdd">取消</button>
      <button class="modal-btn confirm" bindtap="confirmAdd">确认添加</button>
    </view>
  </view>

  <!-- 自定义运动弹窗 -->
  <view class="modal-mask" wx:if="{{showCustomModal}}" bindtap="closeCustomModal"></view>
  <view class="modal-content" wx:if="{{showCustomModal}}">
    <view class="modal-header">
      <text class="modal-title">自定义运动</text>
      <text class="modal-sub">添加你常用的运动类型</text>
    </view>
    <view class="modal-body">
      <text class="input-label">运动名称</text>
      <input
        class="modal-input"
        type="text"
        value="{{customName}}"
        bindinput="onCustomNameInput"
        placeholder="如：广场舞"
        focus="{{showCustomModal}}"
      />
      <text class="input-label">每分钟消耗卡路里（kcal）</text>
      <input
        class="modal-input"
        type="digit"
        value="{{customCalories}}"
        bindinput="onCustomCaloriesInput"
        placeholder="如：6"
      />
      <text class="input-label">运动分类</text>
      <view class="custom-type-row">
        <view class="custom-type-item {{customType === '有氧' ? 'active cardio-type' : ''}}" bindtap="selectCustomType" data-type="有氧">
          <text>有氧</text>
        </view>
        <view class="custom-type-item {{customType === '力量' ? 'active strength-type' : ''}}" bindtap="selectCustomType" data-type="力量">
          <text>力量</text>
        </view>
        <view class="custom-type-item {{customType === 'HIIT' ? 'active hiit-type' : ''}}" bindtap="selectCustomType" data-type="HIIT">
          <text>HIIT</text>
        </view>
      </view>
    </view>
    <view class="modal-actions">
      <button class="modal-btn cancel" bindtap="closeCustomModal">取消</button>
      <button class="modal-btn confirm" bindtap="saveCustomExercise">保存</button>
    </view>
  </view>
</view>
