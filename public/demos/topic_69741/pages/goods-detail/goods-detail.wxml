<!-- 商品详情页面 -->
<view class="goods-detail-page" wx:if="{{goodsDetail}}">
  <!-- 商品图片区 -->
  <view class="goods-image-section {{goodsDetail.imgClass}}">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="goods-image-placeholder">
      <text class="placeholder-icon">{{goodsDetail.emoji}}</text>
    </view>
  </view>

  <!-- 商品信息区 -->
  <view class="card goods-info-card">
    <view class="goods-header">
      <text class="goods-name">{{goodsDetail.name}}</text>
      <text class="goods-price">¥{{goodsDetail.price}}</text>
    </view>
    <view class="goods-tags">
      <view class="tag tag-condition">{{goodsDetail.condition}}</view>
      <view class="tag tag-category">{{goodsDetail.category}}</view>
    </view>
    <view class="goods-time">
      <text class="time-icon">🕐</text>
      <text class="time-text">{{goodsDetail.time}}</text>
    </view>
  </view>

  <!-- 卖家信息区 -->
  <view class="card seller-card">
    <view class="section-header">
      <text class="section-title">卖家信息</text>
    </view>
    <view class="seller-info">
      <view class="seller-avatar">
        <text class="avatar-placeholder">👤</text>
      </view>
      <view class="seller-detail">
        <text class="seller-nickname">{{goodsDetail.seller.nickname}}</text>
        <view class="seller-contact">
          <text class="contact-label">微信号：</text>
          <text class="contact-value">{{goodsDetail.seller.wechat}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品描述区 -->
  <view class="card description-card">
    <view class="section-header">
      <text class="section-title">商品描述</text>
    </view>
    <view class="description-content">
      <text class="description-text">{{goodsDetail.description}}</text>
    </view>
  </view>

  <!-- 同类推荐区域 -->
  <view class="card similar-card" wx:if="{{similarGoods.length > 0}}">
    <view class="section-header">
      <text class="section-title">同类推荐</text>
    </view>
    <scroll-view class="similar-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="similar-list">
        <view class="similar-item" wx:for="{{similarGoods}}" wx:key="id" bindtap="goToSimilarDetail" data-id="{{item.id}}">
          <view class="similar-image goods-image-{{item.imgClass}}">
            <text class="similar-emoji">{{item.emoji}}</text>
            <view class="similar-condition">{{item.condition}}</view>
          </view>
          <view class="similar-info">
            <text class="similar-name">{{item.name}}</text>
            <text class="similar-price">¥{{item.price}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部操作按钮区 -->
  <view class="bottom-action">
    <button class="action-btn collect-btn {{goodsDetail.isCollected ? 'collected' : ''}}" bindtap="toggleCollect">
      <text class="btn-icon">{{goodsDetail.isCollected ? '❤️' : '🤍'}}</text>
      <text class="btn-text">{{goodsDetail.isCollected ? '已收藏' : '收藏'}}</text>
    </button>
    <button class="action-btn contact-btn" bindtap="contactSeller">
      <text class="btn-icon">💬</text>
      <text class="btn-text">联系卖家</text>
    </button>
    <button class="action-btn buy-btn" bindtap="wantToBuy">
      <text class="btn-icon">🛒</text>
      <text class="btn-text">我想要</text>
    </button>
  </view>
</view>
