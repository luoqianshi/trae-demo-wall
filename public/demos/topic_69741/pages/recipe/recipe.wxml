<!-- 食谱库页面 -->
<view class="recipe-page">

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon-s">&#x1F50D;</text>
      <input
        class="search-input"
        placeholder="输入食材，AI帮你找食谱"
        placeholder-class="search-placeholder"
        value="{{searchText}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{searchText}}" bindtap="clearSearch">
        <text class="clear-icon">&#x2715;</text>
      </view>
    </view>
    <view class="search-btn" bindtap="onSearch">
      <text class="search-btn-text">搜索</text>
    </view>
  </view>

  <scroll-view class="recipe-scroll" scroll-y>

    <!-- 搜索中状态 -->
    <view class="searching-state" wx:if="{{searching}}">
      <view class="searching-spinner"></view>
      <text class="searching-text">AI正在为你搜索食谱...</text>
      <text class="searching-sub">通常需要3-8秒</text>
    </view>

    <!-- 搜索结果 -->
    <block wx:elif="{{searchResults.length > 0}}">
      <view class="section-header-row">
        <text class="section-label">搜索结果</text>
        <text class="section-count">{{searchResults.length}}个食谱</text>
      </view>
      <view class="recipe-list">
        <view class="recipe-list-item" wx:for="{{searchResults}}" wx:key="id" bindtap="goToAiDetail" data-index="{{index}}">
          <image class="list-item-img" src="{{item.image}}" mode="aspectFill" lazy-load />
          <view class="list-item-info">
            <text class="list-item-name">{{item.name}}</text>
            <view class="list-item-tags">
              <text class="mini-badge mb-{{item.category}}">{{item.badgeText}}</text>
              <text class="list-item-cal">{{item.calories}} kcal</text>
            </view>
            <text class="list-item-detail">蛋白质{{item.protein}}g · 碳水{{item.carb}}g · 脂肪{{item.fat}}g</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 默认推荐页面 -->
    <block wx:if="{{!searching && searchResults.length === 0}}">

      <!-- 横向推荐 -->
      <view class="section-header-row">
        <text class="section-label">热门推荐</text>
      </view>
      <scroll-view class="recommend-scroll" scroll-x>
        <view class="recommend-list">
          <view class="recommend-card" wx:for="{{recommendedRecipes}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
            <image class="recommend-img" src="{{item.image}}" mode="aspectFill" lazy-load />
            <view class="recommend-info">
              <text class="recommend-name">{{item.name}}</text>
              <view class="recommend-meta">
                <text class="mini-badge mb-{{item.category}}">{{item.badgeText}}</text>
                <text class="recommend-cal">{{item.calories}} kcal</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 食谱列表（紧凑单列） -->
      <view class="section-header-row">
        <text class="section-label">全部食谱</text>
        <text class="section-count">{{recommendedRecipes.length}}个</text>
      </view>
      <view class="recipe-list">
        <view class="recipe-list-item" wx:for="{{recommendedRecipes}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
          <image class="list-item-img" src="{{item.image}}" mode="aspectFill" lazy-load />
          <view class="list-item-info">
            <text class="list-item-name">{{item.name}}</text>
            <view class="list-item-tags">
              <text class="mini-badge mb-{{item.category}}">{{item.badgeText}}</text>
              <text class="list-item-cal">{{item.calories}} kcal</text>
            </view>
            <text class="list-item-detail">蛋白质{{item.protein}}g · 碳水{{item.carb}}g · 脂肪{{item.fat}}g</text>
          </view>
        </view>
      </view>

      <!-- 用户食谱 -->
      <block wx:if="{{userRecipes.length > 0}}">
        <view class="section-header-row">
          <text class="section-label">我的食谱</text>
          <text class="section-count">{{userRecipes.length}}个</text>
        </view>
        <view class="recipe-list">
          <view class="recipe-list-item" wx:for="{{userRecipes}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
            <image wx:if="{{item.image}}" class="list-item-img" src="{{item.image}}" mode="aspectFill" />
            <view wx:else class="list-item-img-placeholder">
              <text class="placeholder-char">{{item.name[0]}}</text>
            </view>
            <view class="list-item-info">
              <text class="list-item-name">{{item.name}}</text>
              <view class="list-item-tags">
                <text class="mini-badge mb-user">自制</text>
                <text class="list-item-cal">{{item.ingredients.length}}种食材</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>

    <view style="height: 140rpx;"></view>
  </scroll-view>

  <!-- 分享食谱悬浮按钮 -->
  <view class="share-fab" bindtap="showShareRecipeModal">
    <text class="share-fab-icon">+</text>
    <text class="share-fab-text">分享食谱</text>
  </view>

  <!-- 分享食谱弹窗 -->
  <view class="share-modal-mask" wx:if="{{showShareModal}}" bindtap="hideShareModal"></view>
  <view class="share-modal" wx:if="{{showShareModal}}">
    <view class="share-modal-header">
      <text class="share-modal-title">分享我的食谱</text>
      <view class="share-modal-close" bindtap="hideShareModal">
        <text class="close-text">&#x2715;</text>
      </view>
    </view>
    <scroll-view class="share-modal-body" scroll-y>
      <view class="share-upload-area">
        <view class="share-media-list">
          <view class="share-media-item" wx:for="{{shareImages}}" wx:key="index">
            <image class="share-media-thumb" src="{{item.thumb}}" mode="aspectFill" />
            <view class="share-media-del" bindtap="removeShareImage" data-index="{{index}}">
              <text class="del-text">&#x2715;</text>
            </view>
            <view class="share-media-type" wx:if="{{item.type === 'video'}}">
              <text class="type-text">视频</text>
            </view>
          </view>
          <view class="share-media-add" wx:if="{{shareImages.length < 3}}" bindtap="chooseShareMedia">
            <text class="add-icon">+</text>
            <text class="add-text">图片/视频</text>
          </view>
        </view>
      </view>
      <view class="share-field">
        <text class="share-label">食谱名称</text>
        <input class="share-input" placeholder="给你的食谱起个名字" value="{{shareForm.name}}" bindinput="onShareNameInput" />
      </view>
      <view class="share-field">
        <text class="share-label">分类</text>
        <view class="share-category-row">
          <view class="share-cat-item {{shareForm.category === 'loseFat' ? 'active cat-fat' : ''}}" data-cat="loseFat" catchtap="onShareCatTap">
            <text class="share-cat-text">减脂</text>
          </view>
          <view class="share-cat-item {{shareForm.category === 'gainMuscle' ? 'active cat-muscle' : ''}}" data-cat="gainMuscle" catchtap="onShareCatTap">
            <text class="share-cat-text">增肌</text>
          </view>
          <view class="share-cat-item {{shareForm.category === 'controlSugar' ? 'active cat-sugar' : ''}}" data-cat="controlSugar" catchtap="onShareCatTap">
            <text class="share-cat-text">控糖</text>
          </view>
        </view>
      </view>
      <view class="share-field">
        <text class="share-label">食材（每行一种，如：鸡胸肉 150g）</text>
        <textarea class="share-textarea" placeholder="鸡胸肉 150g&#10;西兰花 100g&#10;橄榄油 5ml" value="{{shareForm.ingredients}}" bindinput="onShareIngredientsInput" auto-height />
      </view>
      <view class="share-field">
        <text class="share-label">做法（每行一步）</text>
        <textarea class="share-textarea" placeholder="1. 鸡胸肉腌制10分钟&#10;2. 西兰花焯水&#10;3. 煎鸡胸肉至金黄" value="{{shareForm.steps}}" bindinput="onShareStepsInput" auto-height />
      </view>
      <view class="share-field">
        <text class="share-label">小贴士（选填）</text>
        <textarea class="share-textarea" placeholder="分享一些烹饪技巧..." value="{{shareForm.tips}}" bindinput="onShareTipsInput" auto-height />
      </view>
    </scroll-view>
    <view class="share-modal-footer">
      <view class="share-submit-btn" bindtap="submitShareRecipe">
        <text class="share-submit-text">发布食谱</text>
      </view>
    </view>
  </view>

</view>
