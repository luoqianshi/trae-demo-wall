/* 社区页面 - 莫兰迪风格 */

.community-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding-bottom: 140rpx;
}

/* ========== Tab栏样式 ========== */
.tab-container {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #F2ECEE;
  padding: 24rpx 32rpx 20rpx;
}

.tab-wrapper {
  display: flex;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 16rpx rgba(166, 166, 178, 0.15);
}

.tab-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
}

.tab-item.active {
  background: #96AD93;
  box-shadow: 0 4rpx 12rpx rgba(150, 173, 147, 0.3);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #A6A6B2;
}

.tab-item.active .tab-text {
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== 内容区域 ========== */
.content-wrapper {
  padding: 0 32rpx;
}

/* ========== 动态列表样式 ========== */
.post-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(166, 166, 178, 0.12);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-text-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-letter {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #4E5969;
  margin-bottom: 4rpx;
}

.time {
  font-size: 24rpx;
  color: #A6A6B2;
}

.post-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #4E5969;
  word-break: break-all;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2ECEE;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.action-item:active {
  background: #F2ECEE;
}

.action-icon {
  font-size: 32rpx;
}

.action-count {
  font-size: 27rpx;
  color: #A6A6B2;
  font-weight: 500;
}

.action-count.liked {
  color: #CC858E;
  font-weight: 600;
}

.comment-section {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #FAFBFC;
  border-radius: 12rpx;
}

.comment-item {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.comment-item:last-child {
  margin-bottom: 0;
}

.comment-user {
  color: #96AD93;
  font-weight: 600;
}

.comment-text {
  color: #4E5969;
}

/* ========== 闲置市场样式 ========== */
.category-scroll {
  margin: 24rpx 32rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding: 0 4rpx;
}

.category-item {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #A6A6B2;
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx rgba(166, 166, 178, 0.1);
}

.category-item.active {
  background: #B5B5C1;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(181, 181, 193, 0.3);
}

/* ========== 品牌推荐区域 ========== */
.brand-section {
  margin: 0 32rpx 24rpx;
}

.brand-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx 16rpx;
}

.brand-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4E5969;
}

.brand-join-link {
  font-size: 24rpx;
  color: #96AD93;
  font-weight: 500;
}

.brand-scroll {
  white-space: nowrap;
}

.brand-list {
  display: flex;
  gap: 16rpx;
  padding: 0 4rpx;
  white-space: nowrap;
}

.brand-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 220rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(166, 166, 178, 0.1);
  flex-shrink: 0;
}

.brand-card.brand-sage {
  background: #96AD93;
}

.brand-card.brand-orange {
  background: #E3A37D;
}

.brand-card.brand-lavender {
  background: #B5B5C1;
}

.brand-emoji {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.brand-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  line-height: 1.3;
  margin-bottom: 4rpx;
}

.brand-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 16rpx;
}

.brand-enter-btn {
  background: rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

.brand-enter-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* ========== 商品列表 - 简单flex两列布局 ========== */
.goods-container {
  padding: 0 32rpx;
}

.goods-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.goods-item {
  width: calc(50% - 10rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(166, 166, 178, 0.12);
}

.goods-image {
  position: relative;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-image-sage {
  background: #96AD93;
}

.goods-image-lavender {
  background: #B5B5C1;
}

.goods-image-orange {
  background: #E3A37D;
}

.goods-image-rose {
  background: #CC858E;
}

.goods-emoji {
  font-size: 80rpx;
}

.condition-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #4E5969;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.goods-info {
  padding: 20rpx;
}

.goods-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #4E5969;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #CC858E;
}

.goods-category {
  font-size: 22rpx;
  color: #A6A6B2;
  background: #F2ECEE;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.seller-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid #F2ECEE;
}

.seller-name {
  font-size: 24rpx;
  color: #4E5969;
  font-weight: 500;
}

.seller-time {
  font-size: 22rpx;
  color: #A6A6B2;
}

.want-btn {
  margin-top: 16rpx;
  height: 56rpx;
  background: #E3A37D;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.want-btn text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.want-btn:active {
  opacity: 0.8;
}

/* ========== 发布打卡按钮 ========== */
.publish-btn {
  position: fixed;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  height: 96rpx;
  background: #96AD93;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(150, 173, 147, 0.4);
  z-index: 100;
}

.publish-btn text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.publish-btn:active {
  opacity: 0.9;
}

/* ========== 发布闲置悬浮按钮 ========== */
.fab-publish {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  background: #E3A37D;
  border-radius: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(227, 163, 125, 0.5);
  z-index: 100;
}

.fab-icon {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

.fab-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-top: 2rpx;
}

.fab-publish:active {
  opacity: 0.8;
}

/* ========== 底部占位 ========== */
.bottom-spacer {
  height: 160rpx;
}

/* ========== 弹窗通用样式 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(166, 166, 178, 0.5);
  z-index: 999;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #F2ECEE;
  margin-bottom: 28rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4E5969;
}

.close-btn {
  font-size: 40rpx;
  color: #A6A6B2;
  padding: 8rpx;
}

.publish-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  padding: 40rpx 32rpx 60rpx;
  box-shadow: 0 -8rpx 32rpx rgba(166, 166, 178, 0.2);
}

.publish-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: #4E5969;
  background: #F2ECEE;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #A6A6B2;
  margin-bottom: 28rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.cancel-btn {
  background: #F2ECEE;
  color: #A6A6B2;
}

.submit-btn {
  background: #96AD93;
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(150, 173, 147, 0.3);
}

.submit-btn.disabled {
  background: #E8EAEC;
  box-shadow: none;
}

.cancel-btn::after,
.submit-btn::after {
  border: none;
}

.comment-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  padding: 40rpx 32rpx 60rpx;
  box-shadow: 0 -8rpx 32rpx rgba(166, 166, 178, 0.2);
}

.comment-input {
  width: 100%;
  height: 88rpx;
  background: #F2ECEE;
  border-radius: 44rpx;
  padding: 0 32rpx;
  font-size: 29rpx;
  color: #4E5969;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

/* ========== 图片上传区域 ========== */
.image-upload-area {
  margin-bottom: 20rpx;
}

.image-upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-thumb {
  width: 100%;
  height: 100%;
}

.image-delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 12rpx 0 12rpx;
  line-height: 1;
}

.image-upload-add {
  width: 160rpx;
  height: 160rpx;
  background: #F2ECEE;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed #C8C8D4;
}

.add-icon {
  font-size: 48rpx;
  color: #A6A6B2;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #A6A6B2;
}

.image-count-tip {
  text-align: right;
  font-size: 22rpx;
  color: #A6A6B2;
  margin-top: 12rpx;
}

/* ========== 品牌入驻弹窗 ========== */
.brand-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  padding: 40rpx 32rpx 60rpx;
  box-shadow: 0 -8rpx 32rpx rgba(166, 166, 178, 0.2);
}

.brand-modal-content {
  padding: 16rpx 0;
}

.join-step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.step-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.join-step-1 {
  background: #96AD93;
}

.join-step-2 {
  background: #E3A37D;
}

.join-step-3 {
  background: #B5B5C1;
}

.step-detail {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #4E5969;
  margin-bottom: 4rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #A6A6B2;
}

.join-contact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  background: #F2ECEE;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.join-contact-label {
  font-size: 26rpx;
  color: #4E5969;
}

.join-contact-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #96AD93;
}

.join-copy-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #96AD93;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(150, 173, 147, 0.3);
}

.join-copy-btn::after {
  border: none;
}

.join-copy-btn:active {
  opacity: 0.9;
}
