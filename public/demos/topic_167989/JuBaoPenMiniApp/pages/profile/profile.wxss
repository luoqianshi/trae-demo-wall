page {
  background-color: #F7F9FC;
}

.container {
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  border-radius: 0 0 28rpx 28rpx;
  padding: 120rpx 40rpx 80rpx;
  text-align: center;
  color: #fff;
}

.avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
}

.user-id {
  font-size: 24rpx;
  margin-top: 12rpx;
  opacity: 0.85;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: #fff;
  border-radius: 24rpx;
  margin: -40rpx 32rpx 32rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 1;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3436;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #95A5A6;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #F0F0F0;
}

.menu-list {
  padding: 0 32rpx 32rpx;
}

.menu-group {
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 28rpx;
  color: #95A5A6;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.group-body {
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 0.5px solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #2D3436;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C0C0C0;
  margin-left: 16rpx;
}

.bg-purple { background-color: rgba(108, 92, 231, 0.12); }
.bg-green { background-color: rgba(0, 184, 148, 0.12); }
.bg-orange { background-color: rgba(243, 156, 18, 0.12); }
.bg-blue { background-color: rgba(52, 152, 219, 0.12); }
.bg-pink { background-color: rgba(255, 105, 180, 0.12); }
.bg-red { background-color: rgba(231, 76, 60, 0.12); }
