<view class="container">
  <view class="header">
    <view class="avatar-wrap">
      <view class="avatar">{{profile.avatar}}</view>
    </view>
    <view class="nickname">{{profile.name}}</view>
    <view class="user-id">{{profile.id}}</view>
  </view>

  <view class="stats-bar">
    <view class="stats-item">
      <view class="stats-value">{{stats.saved}}</view>
      <view class="stats-label">累计省钱</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-value">{{stats.coupons}}</view>
      <view class="stats-label">已领优惠</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-value">{{stats.checkin}}</view>
      <view class="stats-label">连续签到</view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-group" wx:for="{{menuGroups}}" wx:key="index" wx:for-item="group">
      <view class="group-title">{{group.title}}</view>
      <view class="group-body">
        <view class="menu-item" wx:for="{{group.items}}" wx:key="index" wx:for-item="item" bindtap="onTapMenuItem" data-url="{{item.url}}">
          <view class="menu-icon {{item.bg}}">{{item.icon}}</view>
          <view class="menu-text">{{item.text}}</view>
          <view class="menu-arrow">›</view>
        </view>
      </view>
    </view>
  </view>
</view>
