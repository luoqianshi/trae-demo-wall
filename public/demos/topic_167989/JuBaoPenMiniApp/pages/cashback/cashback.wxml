<view class="container">
  <view class="header">
    <view class="header-title">返现活动</view>
    <view class="header-subtitle">消费拿返现，越花越省</view>
  </view>

  <view class="stats-bar">
    <view class="stats-item">
      <view class="stats-value">{{stats.ongoing}}</view>
      <view class="stats-label">进行中</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-value">{{stats.returned}}</view>
      <view class="stats-label">已返现</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-value">{{stats.pending}}</view>
      <view class="stats-label">待到账</view>
    </view>
  </view>

  <view class="card-list">
    <view class="cb-card" wx:for="{{cashbacks}}" wx:key="index" bindtap="onTapCard" data-index="{{index}}">
      <view class="card-icon {{item.bg}}">{{item.icon}}</view>
      <view class="card-info">
        <view class="card-title">{{item.title}}</view>
        <view class="card-desc">{{item.desc}}</view>
      </view>
      <view class="card-right">
        <view class="card-rate">{{item.rate}}</view>
        <view class="card-label">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>
