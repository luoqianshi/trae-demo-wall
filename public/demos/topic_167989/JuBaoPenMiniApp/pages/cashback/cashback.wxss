page {
  background-color: #F7F9FC;
}

.container {
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #F39C12, #E67E22);
  border-radius: 0 0 28rpx 28rpx;
  padding: 120rpx 40rpx 80rpx;
  text-align: center;
  color: #fff;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
}

.header-subtitle {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: #fff;
  border-radius: 24rpx;
  margin: -40rpx 32rpx 32rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 1;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D3436;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #95A5A6;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #F0F0F0;
}

.card-list {
  padding: 0 32rpx 32rpx;
}

.cb-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 30rpx;
  color: #2D3436;
  font-weight: 500;
}

.card-desc {
  font-size: 24rpx;
  color: #95A5A6;
  margin-top: 8rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-right {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.card-rate {
  font-size: 32rpx;
  color: #E74C3C;
  font-weight: bold;
}

.card-label {
  font-size: 22rpx;
  color: #95A5A6;
  margin-top: 4rpx;
}

.bg-green { background-color: rgba(0, 184, 148, 0.12); }
.bg-orange { background-color: rgba(243, 156, 18, 0.12); }
.bg-blue { background-color: rgba(52, 152, 219, 0.12); }
.bg-red { background-color: rgba(231, 76, 60, 0.12); }
.bg-purple { background-color: rgba(108, 92, 231, 0.12); }
