page {
  background-color: #F7F9FC;
}

.container {
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #E74C3C, #C0392B);
  border-radius: 0 0 48rpx 48rpx;
  padding: 120rpx 40rpx 60rpx;
  color: #fff;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
}

.header-subtitle {
  font-size: 26rpx;
  text-align: center;
  margin-top: 12rpx;
  opacity: 0.9;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  margin-top: 50rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.85;
}

.list {
  padding: 30rpx;
}

.rp-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.rp-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.bg-red { background-color: rgba(231, 76, 60, 0.12); }
.bg-orange { background-color: rgba(243, 156, 18, 0.12); }
.bg-blue { background-color: rgba(52, 152, 219, 0.12); }
.bg-green { background-color: rgba(0, 184, 148, 0.12); }

.rp-info {
  flex: 1;
  min-width: 0;
}

.rp-title {
  font-size: 30rpx;
  color: #2D3436;
  font-weight: 500;
}

.rp-source {
  font-size: 24rpx;
  color: #95A5A6;
  margin-top: 8rpx;
}

.rp-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.rp-time {
  font-size: 22rpx;
  color: #E74C3C;
  margin-right: 16rpx;
}

.rp-limit {
  font-size: 22rpx;
  color: #95A5A6;
}

.rp-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.rp-amount {
  font-size: 36rpx;
  color: #E74C3C;
  font-weight: bold;
}

.btn-claim {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #E74C3C, #C0392B);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 32rpx;
  border-radius: 28rpx;
  text-align: center;
}
