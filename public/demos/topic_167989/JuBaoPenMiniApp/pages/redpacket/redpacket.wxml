<view class="container">
  <view class="header">
    <view class="header-title">今日红包</view>
    <view class="header-subtitle">每天更新，手慢无</view>
    <view class="stats-bar">
      <view class="stat-item">
        <view class="stat-value">{{stats.count}}</view>
        <view class="stat-label">今日红包</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{stats.total}}</view>
        <view class="stat-label">总面值</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{stats.claimed}}</view>
        <view class="stat-label">已领取</view>
      </view>
    </view>
  </view>

  <view class="list">
    <view class="rp-card" wx:for="{{redpackets}}" wx:key="index">
      <view class="rp-icon {{item.bg}}">{{item.icon}}</view>
      <view class="rp-info">
        <view class="rp-title">{{item.title}}</view>
        <view class="rp-source">{{item.source}} · {{item.condition}}</view>
        <view class="rp-meta">
          <text class="rp-time">{{item.time}}</text>
          <text class="rp-limit">{{item.limit}}</text>
        </view>
      </view>
      <view class="rp-right">
        <view class="rp-amount">{{item.amount}}</view>
        <view class="btn-claim" data-index="{{index}}" bindtap="claimRedpacket">领取</view>
      </view>
    </view>
  </view>
</view>
