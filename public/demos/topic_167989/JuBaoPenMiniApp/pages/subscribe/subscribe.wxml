<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack">
      <text class="icon-back">←</text>
    </view>
    <view class="nav-title">我的关注</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 关注列表 -->
  <view class="sub-list">
    <view class="sub-card" wx:for="{{subList}}" wx:key="index">
      <view class="sub-icon {{item.bg}}">{{item.icon}}</view>
      <view class="sub-info">
        <view class="sub-name">{{item.name}}</view>
        <view class="sub-count">{{item.count}}</view>
      </view>
      <view class="toggle-switch {{item.on ? 'on' : ''}}" data-index="{{index}}" bindtap="toggleSwitch">
        <view class="toggle-dot"></view>
      </view>
    </view>
  </view>
</view>
