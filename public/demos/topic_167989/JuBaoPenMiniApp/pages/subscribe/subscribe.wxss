.container {
  min-height: 100vh;
  background-color: #F7F9FC;
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-top: 40rpx;
  padding-bottom: 20rpx;
}

.nav-back {
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  font-size: 36rpx;
  color: #2D3436;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2D3436;
}

.nav-placeholder {
  width: 60rpx;
}

/* 关注列表 */
.sub-list {
  margin-top: 20rpx;
}

.sub-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.sub-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.bg-red { background-color: #FFE5E5; }
.bg-green { background-color: #E5F5E5; }
.bg-blue { background-color: #E5F0FF; }
.bg-orange { background-color: #FFF0E5; }
.bg-purple { background-color: #F0E5FF; }
.bg-pink { background-color: #FFE5F0; }

.sub-info {
  flex: 1;
}

.sub-name {
  font-size: 30rpx;
  color: #2D3436;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.sub-count {
  font-size: 24rpx;
  color: #95A5A6;
}

/* 开关 */
.toggle-switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: #DFE6E9;
  position: relative;
  transition: background-color 0.3s;
}

.toggle-switch.on {
  background-color: #3498DB;
}

.toggle-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background-color: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
}

.toggle-switch.on .toggle-dot {
  left: 40rpx;
}
