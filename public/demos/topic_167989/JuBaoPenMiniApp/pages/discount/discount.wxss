page {
  background-color: #F7F9FC;
}

.container {
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #00B894, #00A381);
  border-radius: 0 0 48rpx 48rpx;
  padding: 120rpx 40rpx 60rpx;
  color: #fff;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
}

.header-subtitle {
  font-size: 26rpx;
  text-align: center;
  margin-top: 12rpx;
  opacity: 0.9;
}

.category-bar {
  white-space: nowrap;
  padding: 24rpx 30rpx;
  background-color: #fff;
  margin: 24rpx 30rpx 0;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.category-item {
  display: inline-block;
  font-size: 26rpx;
  color: #95A5A6;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  transition: all 0.2s;
}

.category-item.active {
  background: linear-gradient(135deg, #00B894, #00A381);
  color: #fff;
}

.discount-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 30rpx;
}

.discount-card {
  width: 48%;
  background-color: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.discount-emoji {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.bg-red { background-color: rgba(231, 76, 60, 0.12); }
.bg-green { background-color: rgba(0, 184, 148, 0.12); }
.bg-blue { background-color: rgba(52, 152, 219, 0.12); }
.bg-orange { background-color: rgba(243, 156, 18, 0.12); }
.bg-purple { background-color: rgba(155, 89, 182, 0.12); }
.bg-pink { background-color: rgba(255, 121, 121, 0.12); }

.discount-info {
  padding: 20rpx 24rpx 28rpx;
}

.discount-title {
  font-size: 28rpx;
  color: #2D3436;
  font-weight: 500;
  line-height: 1.4;
}

.discount-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.discount-price {
  font-size: 32rpx;
  color: #E74C3C;
  font-weight: bold;
  margin-right: 12rpx;
}

.discount-original {
  font-size: 24rpx;
  color: #95A5A6;
  text-decoration: line-through;
}

.discount-badge {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #E74C3C;
  background-color: rgba(231, 76, 60, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
