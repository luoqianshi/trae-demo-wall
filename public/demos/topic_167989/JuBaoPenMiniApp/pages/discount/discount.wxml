<view class="container">
  <view class="header">
    <view class="header-title">超值优惠</view>
    <view class="header-subtitle">精选全网最低价</view>
  </view>

  <scroll-view class="category-bar" scroll-x enable-flex>
    <view class="category-item {{activeCategory === index ? 'active' : ''}}" wx:for="{{categories}}" wx:key="index" data-index="{{index}}" bindtap="switchCategory">
      {{item}}
    </view>
  </scroll-view>

  <view class="discount-grid">
    <view class="discount-card" wx:for="{{discounts}}" wx:key="index">
      <view class="discount-emoji {{item.bg}}">{{item.emoji}}</view>
      <view class="discount-info">
        <view class="discount-title">{{item.title}}</view>
        <view class="discount-price-row">
          <text class="discount-price">{{item.price}}</text>
          <text class="discount-original" wx:if="{{item.original}}">{{item.original}}</text>
        </view>
        <view class="discount-badge">{{item.badge}}</view>
      </view>
    </view>
  </view>
</view>
