.container {
  padding-bottom: 20rpx;
}

/* Home Header */
.home-header {
  background: linear-gradient(135deg, #5DADE2 0%, #3498DB 50%, #2E86C1 100%);
  padding: 32rpx;
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
}
.greeting {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}
.app-name {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.search-box {
  background: rgba(255,255,255,0.2);
  border-radius: 40rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  gap: 16rpx;
  backdrop-filter: blur(4px);
}
.search-icon-text {
  font-size: 28rpx;
  opacity: 0.8;
}
.search-box text {
  font-size: 28rpx;
  opacity: 0.7;
  color: #fff;
}

/* Quick Grid */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 32rpx;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.quick-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.quick-item text {
  font-size: 22rpx;
  color: #636E72;
}

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}
.more {
  font-size: 24rpx;
  color: #95A5A6;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.arrow {
  font-size: 28rpx;
}

/* Picks Tabs */
.picks-tabs {
  display: flex;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #E8ECF0;
}
.picks-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0 16rpx;
  font-size: 28rpx;
  color: #95A5A6;
  position: relative;
  transition: all 0.2s;
}
.picks-tab.active {
  color: #3498DB;
  font-weight: 600;
}
.picks-tab.active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #3498DB;
  border-radius: 4rpx;
}

/* Coupon Scroll */
.coupon-scroll {
  white-space: nowrap;
  padding: 24rpx 32rpx 32rpx;
}
.coupon-card {
  width: 400rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  display: inline-block;
  margin-right: 20rpx;
  vertical-align: top;
}
.coupon-top {
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.coupon-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: #E74C3C;
}
.symbol { font-size: 28rpx; font-weight: 700; }
.amount { font-size: 64rpx; font-weight: 700; }
.coupon-info { text-align: right; }
.platform { font-size: 24rpx; color: #636E72; display: block; }
.type { font-size: 20rpx; color: #B2BEC3; margin-top: 4rpx; display: block; }
.coupon-bottom {
  background: #FFF5F5;
  padding: 16rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx dashed #FADADD;
}
.expire { font-size: 20rpx; color: #E74C3C; }
.btn-claim {
  background: #E74C3C;
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
}

/* Mini List */
.mini-list {
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.mini-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  align-items: center;
}
.mini-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.mini-info { flex: 1; }
.mini-title { font-size: 26rpx; font-weight: 600; color: #2D3436; display: block; }
.mini-desc { font-size: 22rpx; color: #95A5A6; margin-top: 6rpx; display: block; }
.mini-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}
.mini-val { font-size: 32rpx; font-weight: 700; color: #E74C3C; }
.mini-btn {
  background: #3498DB;
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
  border: none;
  margin-top: 8rpx;
  line-height: 1.4;
}

/* Banner */
.banner-section { padding: 32rpx; }
.banner-card {
  background: linear-gradient(135deg, #F39C12 0%, #E67E22 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.banner-tag {
  font-size: 22rpx;
  background: rgba(255,255,255,0.25);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 16rpx;
}
.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  display: block;
}
.banner-desc {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
}

/* Deal List */
.deal-list {
  padding: 0 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.deal-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.deal-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: #E8F8F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  flex-shrink: 0;
}
.deal-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.deal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.deal-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.deal-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.deal-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #E74C3C;
}
.original {
  font-size: 22rpx;
  color: #B2BEC3;
  text-decoration: line-through;
  font-weight: 400;
  margin-left: 8rpx;
}

.bottom-space {
  height: 40rpx;
}
