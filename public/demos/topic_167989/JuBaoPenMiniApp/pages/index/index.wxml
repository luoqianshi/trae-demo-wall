<view class="container">
  <!-- Home Header -->
  <view class="home-header">
    <view class="greeting">下午好，省钱小达人</view>
    <view class="app-name">聚宝盆</view>
    <view class="search-box" bindtap="goSearch">
      <text class="search-icon-text">🔍</text>
      <text>搜索优惠、红包、返现...</text>
    </view>
  </view>

  <!-- Quick Grid -->
  <view class="quick-grid">
    <view class="quick-item" wx:for="{{quickNavs}}" wx:key="index" bindtap="goQuickNav" data-url="{{item.url}}">
      <view class="quick-icon {{item.bg}}">{{item.icon}}</view>
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- Today Picks -->
  <view class="section-header">
    <text class="section-title">今日精选</text>
  </view>
  <view class="picks-tabs">
    <view class="picks-tab {{activePicksTab === index ? 'active' : ''}}"
          wx:for="{{picksTabs}}" wx:key="index"
          bindtap="switchPicksTab" data-index="{{index}}">{{item}}</view>
  </view>

  <!-- 红包 tab -->
  <view class="picks-content" hidden="{{activePicksTab !== 0}}">
    <scroll-view class="coupon-scroll" scroll-x>
      <view class="coupon-card" wx:for="{{coupons}}" wx:key="index">
        <view class="coupon-top">
          <view class="coupon-value">
            <text class="symbol">¥</text>
            <text class="amount">{{item.value}}</text>
          </view>
          <view class="coupon-info">
            <text class="platform">{{item.platform}}</text>
            <text class="type">{{item.type}}</text>
          </view>
        </view>
        <view class="coupon-bottom">
          <text class="expire">{{item.expire}}</text>
          <button class="btn-claim">立即领取</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 返现 tab -->
  <view class="picks-content" hidden="{{activePicksTab !== 1}}">
    <view class="mini-list">
      <view class="mini-card" wx:for="{{cashbackList}}" wx:key="index">
        <view class="mini-icon {{item.bg}}">{{item.icon}}</view>
        <view class="mini-info">
          <text class="mini-title">{{item.title}}</text>
          <text class="mini-desc">{{item.desc}}</text>
        </view>
        <view class="mini-right">
          <text class="mini-val">{{item.val}}</text>
          <button class="mini-btn">{{item.btn}}</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 优惠 tab -->
  <view class="picks-content" hidden="{{activePicksTab !== 2}}">
    <view class="mini-list">
      <view class="mini-card" wx:for="{{discountList}}" wx:key="index">
        <view class="mini-icon {{item.bg}}">{{item.icon}}</view>
        <view class="mini-info">
          <text class="mini-title">{{item.title}}</text>
          <text class="mini-desc">{{item.desc}}</text>
        </view>
        <view class="mini-right">
          <text class="mini-val">{{item.val}}</text>
          <button class="mini-btn">{{item.btn}}</button>
        </view>
      </view>
    </view>
  </view>

  <!-- Banner -->
  <view class="banner-section">
    <view class="banner-card">
      <text class="banner-tag">限时活动</text>
      <view class="banner-title">新人专享红包大礼包</view>
      <view class="banner-desc">首次使用领 8.8 元红包，消费满 20 即可抵扣</view>
    </view>
  </view>

  <!-- Hot Deals -->
  <view class="section-header">
    <text class="section-title">热门优惠活动</text>
    <view class="more" bindtap="goMoreDiscount">
      <text>更多</text>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="deal-list">
    <view class="deal-item" wx:for="{{hotDeals}}" wx:key="index">
      <view class="deal-img">{{item.emoji}}</view>
      <view class="deal-content">
        <text class="deal-title">{{item.title}}</text>
        <view class="deal-meta">
          <text class="deal-tag" style="background:{{item.tagColor}};color:{{item.tagTextColor}}">{{item.tag}}</text>
          <text class="deal-price">{{item.price}} <text class="original">{{item.original}}</text></text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
