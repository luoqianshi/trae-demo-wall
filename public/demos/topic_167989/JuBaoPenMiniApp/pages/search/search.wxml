<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack">
      <text class="icon-back">←</text>
    </view>
    <view class="search-box">
      <input class="search-input" placeholder="搜索优惠" value="{{keyword}}" bindinput="onInput" />
    </view>
    <view class="nav-cancel" bindtap="onCancel">取消</view>
  </view>

  <!-- 热门分类标签 -->
  <view class="section-title">热门分类</view>
  <view class="tag-list">
    <view class="tag-item" wx:for="{{searchTags}}" wx:key="index" data-tag="{{item}}" bindtap="onTagTap">
      {{item}}
    </view>
  </view>

  <!-- 热搜榜 -->
  <view class="section-title">热搜榜</view>
  <view class="hot-list">
    <view class="hot-item" wx:for="{{hotSearches}}" wx:key="rank" data-text="{{item.text}}" bindtap="onHotTap">
      <view class="hot-rank {{item.top ? 'top' : ''}}">{{item.rank}}</view>
      <view class="hot-text">{{item.text}}</view>
      <view class="hot-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
    </view>
  </view>
</view>
