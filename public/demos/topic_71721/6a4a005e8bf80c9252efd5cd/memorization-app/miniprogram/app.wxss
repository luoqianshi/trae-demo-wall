/* app.wxss 全局样式 */
page {
  background: #F5F6FA;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(90deg, #4A90D9 0%, #5BA0E9 100%);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 48rpx;
  height: 80rpx;
  line-height: 76rpx;
  font-size: 30rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #E8F1FB;
  color: #4A90D9;
}

/* 标题 */
.title-lg { font-size: 40rpx; font-weight: 600; }
.title-md { font-size: 32rpx; font-weight: 600; }
.text-gray { color: #999; font-size: 26rpx; }
.text-tip  { color: #B0B0B0; font-size: 24rpx; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #B0B0B0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }

/* flex 工具 */
.flex { display: flex; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
