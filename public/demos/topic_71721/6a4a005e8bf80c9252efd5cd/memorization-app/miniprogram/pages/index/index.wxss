/* pages/index/index.wxss */
.page { min-height: 100vh; padding-bottom: 40rpx; }

.header {
  position: relative;
  padding: 40rpx 32rpx 100rpx;
  overflow: hidden;
}
.header-bg {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #4A90D9 0%, #5BA0E9 100%);
  border-radius: 0 0 40rpx 40rpx;
}
.header-content { position: relative; color: #fff; }
.hello { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }
.date  { font-size: 26rpx; opacity: 0.9; margin-bottom: 20rpx; }
.streak {
  display: inline-block;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.streak .fire { margin-right: 4rpx; }
.streak .num  { font-weight: 700; margin: 0 4rpx; }

.summary-bar {
  margin: -70rpx 32rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.12);
  position: relative;
}
.summary-item {
  flex: 1;
  text-align: center;
}
.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}
.summary-num.highlight { color: #4A90D9; }
.summary-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background: #EEE;
}

.section { padding: 0 32rpx; }
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title text:first-child {
  font-size: 32rpx;
  font-weight: 600;
}

.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.task-top {
  display: flex;
  align-items: center;
}
.subject-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 80rpx; height: 80rpx;
  background: #F0F7FF;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
}
.task-info { flex: 1; }
.task-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.task-meta { display: flex; gap: 12rpx; }
.task-meta .tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
}
.round-badge {
  background: #FFF3E0;
  color: #F5A623;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.go-btn { margin-top: 30rpx; width: 60%; }

.tip-card {
  margin: 30rpx 32rpx;
  background: #FFFBEB;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #F5A623;
}
.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #B8860B;
  margin-bottom: 8rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #8B7355;
  line-height: 1.7;
}
