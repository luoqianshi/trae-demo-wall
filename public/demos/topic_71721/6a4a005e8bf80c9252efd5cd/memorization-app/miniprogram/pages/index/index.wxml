<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 顶部头部 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="hello">你好,{{userInfo.nickname || '同学'}} 👋</view>
      <view class="date">{{today}}</view>
      <view class="streak">
        <text class="fire">🔥</text> 已连续打卡 <text class="num">{{streak}}</text> 天
      </view>
    </view>
  </view>

  <!-- 今日任务概览 -->
  <view class="summary-bar">
    <view class="summary-item">
      <view class="summary-num">{{tasks.length}}</view>
      <view class="summary-label">待复习</view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item" bindtap="goLearn">
      <view class="summary-num {{isLearnDay ? 'highlight' : ''}}">{{isLearnDay ? '今' : '—'}}</view>
      <view class="summary-label">学新日</view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item" bindtap="goLearn">
      <view class="summary-num">+</view>
      <view class="summary-label">去学新</view>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="section">
    <view class="section-title">
      <text>今日复习任务</text>
      <text class="text-tip" wx:if="{{tasks.length}}">跟着读 3 遍即可</text>
    </view>

    <block wx:if="{{loading}}">
      <view class="empty">加载中...</view>
    </block>

    <block wx:elif="{{tasks.length === 0}}">
      <view class="empty">
        <view class="empty-icon">🎉</view>
        <view>今天没有复习任务</view>
        <view class="text-tip" wx:if="{{isLearnDay}}">今天是学新日,去学点新内容吧</view>
        <button class="btn-primary go-btn" wx:if="{{isLearnDay}}" bindtap="goLearn">去学新</button>
      </view>
    </block>

    <block wx:else>
      <view class="task-card" wx:for="{{tasks}}" wx:key="record_id" data-task="{{item}}" bindtap="onReview">
        <view class="task-top">
          <view class="subject-icon">{{item.subject.icon}}</view>
          <view class="task-info">
            <view class="task-title">{{item.title}}</view>
            <view class="task-meta">
              <text class="tag">{{item.subject.name}}</text>
              <text class="tag">{{item.unit}}</text>
            </view>
          </view>
          <view class="round-badge">第{{item.round}}/{{item.total_rounds}}轮</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 学习提示 -->
  <view class="tip-card">
    <view class="tip-title">💡 艾宾浩斯抗遗忘曲线</view>
    <view class="tip-text">学新后第 1、2、3、4、5、6、7、9、11、13、15、17、19、21 天分别复习,共 14 轮,21 天形成长期记忆。</view>
  </view>
</view>
