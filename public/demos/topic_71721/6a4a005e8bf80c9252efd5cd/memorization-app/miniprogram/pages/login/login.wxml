<!-- pages/login/login.wxml -->
<view class="login-page">
  <view class="logo-area">
    <view class="logo">📚</view>
    <view class="title">背诵打卡</view>
    <view class="subtitle">艾宾浩斯抗遗忘 · 初中背诵好帮手</view>
  </view>

  <view class="card form-card">
    <view class="input-label">昵称(可选)</view>
    <input class="input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onInput" />

    <button class="btn-primary" bindtap="onWxLogin">微信一键登录</button>
    <button class="btn-secondary test-btn" bindtap="onTestLogin">测试登录(无需微信)</button>
  </view>

  <view class="tips">
    <view>· 每天 10-20 分钟,跟着读 3 遍</view>
    <view>· 21 天 14 轮复习,抵抗遗忘</view>
    <view>· 覆盖语数英、物化生、史地政 9 学科</view>
  </view>
</view>
