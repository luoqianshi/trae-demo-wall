/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #4A90D9 0%, #5BA0E9 30%, #F5F6FA 30%);
}

.logo-area {
  text-align: center;
  padding: 40rpx 0 60rpx;
}
.logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}
.subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.form-card {
  margin-top: 40rpx;
}
.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.input {
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 40rpx;
  font-size: 30rpx;
}

.test-btn {
  margin-top: 24rpx;
}

.tips {
  margin-top: 60rpx;
  padding: 0 20rpx;
  color: #999;
  font-size: 26rpx;
  line-height: 2.2;
}
