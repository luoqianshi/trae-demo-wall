/* pages/stats/stats.wxss */
.stats-page { padding: 24rpx 32rpx 60rpx; }

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.stat-cell {
  background: linear-gradient(135deg, #4A90D9 0%, #5BA0E9 100%);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #fff;
}
.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}
.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.section { padding: 28rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.week-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 20rpx 0;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.bar {
  width: 50rpx;
  background: linear-gradient(180deg, #5BA0E9, #4A90D9);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 10rpx;
}
.bar-num {
  font-size: 22rpx;
  color: #4A90D9;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.bar-label {
  font-size: 18rpx;
  color: #999;
  margin-top: 8rpx;
  white-space: nowrap;
  transform: scale(0.85);
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}
.record-item:last-child { border-bottom: none; }
.record-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.record-icon { font-size: 32rpx; margin-right: 12rpx; }
.record-title { font-size: 28rpx; font-weight: 600; flex: 1; }
.record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #5BA0E9);
  border-radius: 6rpx;
  transition: width 0.3s;
}
.progress-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  text-align: right;
}
