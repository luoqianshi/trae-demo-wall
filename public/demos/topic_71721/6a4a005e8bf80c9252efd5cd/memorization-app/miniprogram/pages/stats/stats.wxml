<!-- pages/stats/stats.wxml -->
<view class="stats-page" wx:if="{{stats}}">
  <!-- 数据概览 -->
  <view class="stats-grid">
    <view class="stat-cell">
      <view class="stat-num">{{stats.streak}}</view>
      <view class="stat-label">连续打卡</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num">{{stats.total_learned}}</view>
      <view class="stat-label">已学内容</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num">{{stats.total_finished}}</view>
      <view class="stat-label">完成全部复习</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num">{{stats.today_review_done}}</view>
      <view class="stat-label">今日复习</view>
    </view>
  </view>

  <!-- 最近 7 天 -->
  <view class="card section">
    <view class="section-title">最近 7 天打卡</view>
    <view class="week-chart">
      <view class="bar-col" wx:for="{{stats.last_7_days}}" wx:key="date">
        <view class="bar" style="height: {{item.count * 60 + 10}}rpx"></view>
        <view class="bar-num" wx:if="{{item.count > 0}}">{{item.count}}</view>
        <view class="bar-label">{{item.date}}</view>
      </view>
    </view>
  </view>

  <!-- 学习记录 -->
  <view class="card section">
    <view class="section-title">学习记录与复习进度</view>

    <block wx:if="{{learnList.length === 0}}">
      <view class="empty">
        <view class="empty-icon">📝</view>
        <view>还没有学习记录</view>
      </view>
    </block>

    <block wx:else>
      <view class="record-item" wx:for="{{learnList}}" wx:key="id">
        <view class="record-top">
          <text class="record-icon">{{item.subject.icon}}</text>
          <text class="record-title">{{item.title}}</text>
        </view>
        <view class="record-meta">
          <text class="text-tip">学新:{{item.learn_date}}</text>
          <text class="text-tip" wx:if="{{item.next_review}}">下次复习:{{item.next_review}}</text>
          <text class="text-tip" wx:else>✅ 已完成全部</text>
        </view>
        <view class="progress-bar">
          <view class="progress-inner" style="width: {{item.progress}}%"></view>
        </view>
        <view class="progress-text">{{item.completed_rounds.length}} / {{item.total_rounds}} 轮 ({{item.progress}}%)</view>
      </view>
    </block>
  </view>
</view>
