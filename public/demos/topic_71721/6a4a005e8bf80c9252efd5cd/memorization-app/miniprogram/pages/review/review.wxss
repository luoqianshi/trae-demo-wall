/* pages/review/review.wxss */
.review-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 60rpx;
}

.rv-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.rv-subject {
  font-size: 26rpx;
  color: #4A90D9;
  margin-bottom: 12rpx;
}
.rv-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.rv-meta { display: flex; gap: 12rpx; }

.rv-body-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.rv-body-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
  font-weight: 500;
}
.rv-body {
  font-size: 32rpx;
  line-height: 2.1;
  color: #222;
  white-space: pre-wrap;
  letter-spacing: 1rpx;
}
.rv-tip {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #FFFBEB;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.7;
}
.rv-tip-label { font-weight: 600; color: #B8860B; }

.rv-progress {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 32rpx;
  text-align: center;
}
.rv-progress-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}
.rv-dots {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}
.rv-dot {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: #F0F0F0;
  color: #999;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s;
}
.rv-dot.done {
  background: linear-gradient(135deg, #4A90D9, #5BA0E9);
  color: #fff;
  transform: scale(1.1);
}

.rv-actions {
  padding: 0 16rpx;
}
.read-btn { margin-bottom: 20rpx; }
.rv-skip {
  text-align: center;
  color: #B0B0B0;
  font-size: 26rpx;
  padding: 20rpx;
}
.rv-done-tip {
  text-align: center;
  color: #4CAF50;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
