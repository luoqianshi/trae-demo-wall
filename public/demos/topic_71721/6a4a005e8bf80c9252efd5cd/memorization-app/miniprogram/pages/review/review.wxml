<!-- pages/review/review.wxml -->
<view class="review-page" wx:if="{{task}}">
  <!-- 头部 -->
  <view class="rv-header">
    <view class="rv-subject">{{task.subject.icon}} {{task.subject.name}}</view>
    <view class="rv-title">{{task.title}}</view>
    <view class="rv-meta">
      <text class="tag">{{task.unit}}</text>
      <text class="tag">第 {{task.round}}/{{task.total_rounds}} 轮复习</text>
    </view>
  </view>

  <!-- 背诵正文 -->
  <view class="rv-body-card">
    <view class="rv-body-label">📖 背诵内容</view>
    <view class="rv-body">{{task.body}}</view>
    <view class="rv-tip" wx:if="{{task.tip}}">
      <text class="rv-tip-label">💡 提示:</text>
      <text>{{task.tip}}</text>
    </view>
  </view>

  <!-- 跟读进度 -->
  <view class="rv-progress">
    <view class="rv-progress-label">
      跟读进度 {{readCount}} / {{targetCount}}
    </view>
    <view class="rv-dots">
      <view class="rv-dot {{readCount >= 1 ? 'done' : ''}}">1</view>
      <view class="rv-dot {{readCount >= 2 ? 'done' : ''}}">2</view>
      <view class="rv-dot {{readCount >= 3 ? 'done' : ''}}">3</view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="rv-actions">
    <block wx:if="{{!finished}}">
      <button class="btn-primary read-btn" bindtap="onRead" loading="{{reading}}" disabled="{{reading}}">
        {{reading ? '朗读中...' : '🔊 跟读一遍(第 ' + (readCount + 1) + ' 遍)'}}
      </button>
      <view class="rv-skip" bindtap="onSkip">跳过</view>
    </block>
    <block wx:else>
      <view class="rv-done-tip">✅ 已完成 3 遍跟读</view>
      <button class="btn-primary" bindtap="onFinish">完成打卡</button>
    </block>
  </view>
</view>
