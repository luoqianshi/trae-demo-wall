<!-- pages/settings/settings.wxml -->
<view class="settings-page" wx:if="{{userInfo}}">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="avatar">{{userInfo.nickname ? userInfo.nickname.charAt(0) : '我'}}</view>
    <view class="user-info">
      <view class="user-name">{{userInfo.nickname || '同学'}}</view>
      <view class="user-sub">初中背诵打卡 · 艾宾浩斯抗遗忘</view>
    </view>
  </view>

  <!-- 学期设置 -->
  <view class="card setting-item" bindtap="onSemesterChange">
    <view class="setting-left">
      <text class="setting-icon">📅</text>
      <text class="setting-name">当前学期</text>
    </view>
    <view class="setting-right">
      <text class="setting-value">{{semesterLabel}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 学新频率 -->
  <view class="card setting-block">
    <view class="setting-block-title">
      <text class="setting-icon">⚡</text>
      <text>每周学新次数</text>
    </view>
    <view class="freq-options">
      <view class="freq-option {{learnPerWeek === 2 ? 'active' : ''}}" data-freq="2" bindtap="onFreqChange">
        <view class="freq-num">2</view>
        <view class="freq-label">次/周</view>
        <view class="freq-tip">周二、周五</view>
      </view>
      <view class="freq-option {{learnPerWeek === 4 ? 'active' : ''}}" data-freq="4" bindtap="onFreqChange">
        <view class="freq-num">4</view>
        <view class="freq-label">次/周</view>
        <view class="freq-tip">周一周二周四周五</view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card about-card">
    <view class="about-title">关于本程序</view>
    <view class="about-text">
      本程序为公益小程序,基于艾宾浩斯抗遗忘曲线,为初中学生提供背诵复习提醒。
      覆盖语数英、物化生、史地政 9 学科,贴合人教版教材。
    </view>
    <view class="about-curve">
      <view class="about-curve-title">复习节点(共 14 轮)</view>
      <view class="curve-dots">
        <text class="curve-dot">1</text>
        <text class="curve-dot">2</text>
        <text class="curve-dot">3</text>
        <text class="curve-dot">4</text>
        <text class="curve-dot">5</text>
        <text class="curve-dot">6</text>
        <text class="curve-dot">7</text>
        <text class="curve-dot">9</text>
        <text class="curve-dot">11</text>
        <text class="curve-dot">13</text>
        <text class="curve-dot">15</text>
        <text class="curve-dot">17</text>
        <text class="curve-dot">19</text>
        <text class="curve-dot">21</text>
      </view>
      <view class="about-curve-tip">第 N 天复习,跟着读 3 遍即可</view>
    </view>
  </view>

  <!-- 退出登录 -->
  <button class="logout-btn" bindtap="onLogout">退出登录</button>
</view>
