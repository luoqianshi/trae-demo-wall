/* pages/settings/settings.wxss */
.settings-page { padding: 24rpx 32rpx 60rpx; }

.user-card {
  background: linear-gradient(135deg, #4A90D9 0%, #5BA0E9 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  color: #fff;
}
.avatar {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  margin-right: 24rpx;
}
.user-name { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }
.user-sub  { font-size: 24rpx; opacity: 0.9; }

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.setting-left { display: flex; align-items: center; }
.setting-icon { font-size: 36rpx; margin-right: 16rpx; }
.setting-name { font-size: 30rpx; }
.setting-right { display: flex; align-items: center; }
.setting-value { font-size: 28rpx; color: #666; margin-right: 12rpx; }
.arrow { font-size: 36rpx; color: #CCC; }

.setting-block { padding: 28rpx; }
.setting-block-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}
.freq-options {
  display: flex;
  gap: 20rpx;
}
.freq-option {
  flex: 1;
  background: #F5F6FA;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  border: 4rpx solid transparent;
}
.freq-option.active {
  background: #E8F1FB;
  border-color: #4A90D9;
}
.freq-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #4A90D9;
}
.freq-label { font-size: 24rpx; color: #666; margin: 4rpx 0 12rpx; }
.freq-tip { font-size: 22rpx; color: #999; }

.about-card { padding: 28rpx; }
.about-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.about-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}
.about-curve {
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 20rpx;
}
.about-curve-title {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}
.curve-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.curve-dot {
  background: #4A90D9;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
}
.about-curve-tip {
  font-size: 22rpx;
  color: #999;
}

.logout-btn {
  margin-top: 40rpx;
  background: #fff;
  color: #F56C6C;
  border: 2rpx solid #F56C6C;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}
