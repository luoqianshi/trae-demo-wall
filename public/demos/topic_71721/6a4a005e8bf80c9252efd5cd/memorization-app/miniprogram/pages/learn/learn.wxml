<!-- pages/learn/learn.wxml -->
<view class="learn-page">
  <!-- 学期选择 -->
  <view class="semester-bar" bindtap="onSelectSemester">
    <text class="sem-label">当前学期</text>
    <text class="sem-value">{{semesterLabel}}</text>
    <text class="sem-arrow">切换 ▼</text>
  </view>

  <!-- 学科 tab -->
  <scroll-view class="subject-tabs" scroll-x>
    <view
      class="subject-tab {{selectedSubject === item.code ? 'active' : ''}}"
      wx:for="{{subjects}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="onSelectSubject"
    >
      <text class="subj-icon">{{item.icon}}</text>
      <text class="subj-name">{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 内容列表 -->
  <view class="content-list">
    <block wx:if="{{loading}}">
      <view class="empty">加载中...</view>
    </block>
    <block wx:elif="{{contents.length === 0}}">
      <view class="empty">
        <view class="empty-icon">📭</view>
        <view>该学期/学科暂无内容</view>
        <view class="text-tip">可在管理后台添加</view>
      </view>
    </block>
    <block wx:else>
      <view class="content-card" wx:for="{{contents}}" wx:key="id">
        <view class="content-main" data-id="{{item.id}}" bindtap="onContent">
          <view class="content-title">{{item.title}}</view>
          <view class="content-unit">{{item.unit}}</view>
          <view class="content-tip" wx:if="{{item.tip}}">{{item.tip}}</view>
        </view>
        <view class="content-action">
          <block wx:if="{{learnedIds.indexOf(item.id) > -1}}">
            <view class="learned-tag">✓ 已学</view>
          </block>
          <block wx:else>
            <button class="learn-btn" data-id="{{item.id}}" catchtap="onLearn">+ 学新</button>
          </block>
        </view>
      </view>
    </block>
  </view>
</view>
