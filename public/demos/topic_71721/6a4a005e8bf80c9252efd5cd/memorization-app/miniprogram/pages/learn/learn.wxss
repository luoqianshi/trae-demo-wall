/* pages/learn/learn.wxss */
.learn-page { min-height: 100vh; padding-bottom: 40rpx; }

.semester-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #EEE;
}
.sem-label { font-size: 26rpx; color: #999; margin-right: 16rpx; }
.sem-value { flex: 1; font-size: 30rpx; font-weight: 600; color: #333; }
.sem-arrow { font-size: 24rpx; color: #4A90D9; }

.subject-tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 16rpx;
  border-bottom: 2rpx solid #EEE;
}
.subject-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 8rpx;
  border-radius: 12rpx;
  min-width: 100rpx;
}
.subject-tab.active {
  background: #E8F1FB;
}
.subj-icon { font-size: 40rpx; margin-bottom: 4rpx; }
.subj-name { font-size: 22rpx; color: #666; }
.subject-tab.active .subj-name { color: #4A90D9; font-weight: 600; }

.content-list { padding: 24rpx 32rpx; }

.content-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.content-main { flex: 1; }
.content-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.4;
}
.content-unit {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.content-tip {
  font-size: 24rpx;
  color: #B0B0B0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.content-action { margin-left: 20rpx; }

.learn-btn {
  background: linear-gradient(90deg, #4A90D9 0%, #5BA0E9 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  border: none;
}

.learned-tag {
  color: #4CAF50;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 20rpx;
  background: #E8F5E9;
  border-radius: 24rpx;
}
