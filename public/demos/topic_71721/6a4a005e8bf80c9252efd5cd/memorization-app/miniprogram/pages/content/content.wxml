<!-- pages/content/content.wxml -->
<view class="content-page" wx:if="{{content}}">
  <view class="ct-header">
    <view class="ct-title">{{content.title}}</view>
    <view class="ct-meta">
      <text class="tag">{{content.unit}}</text>
    </view>
  </view>

  <view class="ct-body-card">
    <view class="ct-body-label">📖 背诵内容</view>
    <view class="ct-body">{{content.body}}</view>
  </view>

  <view class="ct-tip-card" wx:if="{{content.tip}}">
    <view class="ct-tip-label">💡 背诵提示</view>
    <view class="ct-tip-text">{{content.tip}}</view>
  </view>
</view>

<view class="empty" wx:elif="{{!loading}}">内容不存在</view>
