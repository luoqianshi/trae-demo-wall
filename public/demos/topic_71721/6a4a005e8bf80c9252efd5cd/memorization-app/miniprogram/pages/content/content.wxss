/* pages/content/content.wxss */
.content-page { padding: 24rpx 32rpx 60rpx; }

.ct-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.ct-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.ct-meta { display: flex; gap: 12rpx; }

.ct-body-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.ct-body-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
}
.ct-body {
  font-size: 32rpx;
  line-height: 2.1;
  white-space: pre-wrap;
  letter-spacing: 1rpx;
}

.ct-tip-card {
  background: #FFFBEB;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #F5A623;
}
.ct-tip-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #B8860B;
  margin-bottom: 8rpx;
}
.ct-tip-text {
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.7;
}
