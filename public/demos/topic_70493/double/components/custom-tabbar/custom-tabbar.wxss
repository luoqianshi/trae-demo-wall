.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(26, 26, 46, 0.95);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
}

.tab-icon {
  font-size: 40rpx;
}

.tab-name {
  font-size: 22rpx;
  color: #666;
}

.tab-item.active .tab-name {
  color: #ffd700;
}

.tab-item.active {
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  top: 8rpx;
  width: 8rpx;
  height: 8rpx;
  background: #ffd700;
  border-radius: 50%;
}