.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
  font-weight: 600;
}

.relation-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}

.relation-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.relation-item.selected {
  background: rgba(255, 215, 0, 0.1);
  border-color: rgba(255, 215, 0, 0.5);
}

.relation-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.relation-name {
  font-size: 24rpx;
  color: #e8e8e8;
}

.relation-item.selected .relation-name {
  color: #ffd700;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.input-field::placeholder {
  color: #666;
}

.friend-input-wrap {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.friend-input {
  flex: 1;
}

.invite-btn {
  padding: 20rpx 32rpx;
  font-size: 26rpx;
}

.friend-tag {
  padding: 20rpx 32rpx;
  background: rgba(144, 238, 144, 0.15);
  color: #90ee90;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.invite-tip {
  font-size: 24rpx;
  color: #666;
  margin-top: 16rpx;
}

.submit-wrap {
  margin-top: 80rpx;
}

.submit-btn {
  width: 100%;
  padding: 32rpx;
  font-size: 32rpx;
}

.submit-btn.disabled {
  opacity: 0.5;
}