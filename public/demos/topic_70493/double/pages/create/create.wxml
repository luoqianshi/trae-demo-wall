<view class="container">
  <view class="section">
    <view class="section-title">选择关系类型</view>
    <view class="relation-grid">
      <view 
        wx:for="{{relationTypes}}" 
        wx:key="id"
        class="relation-item {{selectedType === item.id ? 'selected' : ''}}"
        bindtap="selectRelation"
        data-type="{{item.id}}"
      >
        <view class="relation-icon">{{item.icon}}</view>
        <view class="relation-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedType === 'custom'}}" class="section">
    <view class="section-title">自定义关系名称</view>
    <input 
      class="input-field" 
      placeholder="输入自定义关系名称"
      value="{{customRelation}}"
      bindinput="inputCustomRelation"
    />
  </view>

  <view class="section">
    <view class="section-title">长河名称</view>
    <input 
      class="input-field" 
      placeholder="给这条长河起个名字"
      value="{{riverName}}"
      bindinput="inputRiverName"
    />
  </view>

  <view class="section">
    <view class="section-title">绑定好友</view>
    <view class="friend-input-wrap">
      <input 
        class="input-field friend-input" 
        placeholder="好友昵称"
        value="{{friendName}}"
        bindinput="inputFriendName"
        disabled="{{friendName !== ''}}"
      />
      <button 
        wx:if="{{friendName === ''}}" 
        class="btn-secondary invite-btn" 
        bindtap="inviteFriend"
      >
        邀请好友
      </button>
      <view wx:else class="friend-tag">{{friendName}} ✓</view>
    </view>
    <view class="invite-tip">发送邀请后，对方确认即可绑定</view>
  </view>

  <view class="submit-wrap">
    <button 
      class="btn-primary submit-btn {{canSubmit ? '' : 'disabled'}}" 
      bindtap="createRiver"
      disabled="{{!canSubmit}}"
    >
      创建记忆长河
    </button>
  </view>
</view>