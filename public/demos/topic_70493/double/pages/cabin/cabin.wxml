<view class="cabin-container">
  <view class="cabin-header">
    <view class="header-title">船舱回忆录</view>
    <view class="header-subtitle">珍藏你们的每一段记忆</view>
  </view>

  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-value">{{allBottles.length}}</text>
      <text class="stat-label">总记忆</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{matchedCount}}</text>
      <text class="stat-label">共鸣记忆</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{riverCount}}</text>
      <text class="stat-label">长河数</text>
    </view>
  </view>

  <view class="filter-tabs">
    <view 
      wx:for="{{filterOptions}}" 
      wx:key="id"
      class="filter-tab {{currentFilter === item.id ? 'active' : ''}}"
      bindtap="changeFilter"
      data-filter="{{item.id}}"
    >
      <text class="filter-icon">{{item.icon}}</text>
      <text class="filter-name">{{item.name}}</text>
    </view>
  </view>

  <view wx:if="{{showEmpty}}" class="empty-state">
    <view class="empty-icon">📦</view>
    <view class="empty-title">船舱还是空的</view>
    <view class="empty-desc">快去河道投下你的第一个漂流瓶吧</view>
  </view>

  <scroll-view wx:else scroll-y class="bottle-list">
    <view class="timeline">
      <view 
        wx:for="{{filteredBottles}}" 
        wx:key="id"
        class="timeline-item"
      >
        <view class="timeline-dot {{item.status === 'matched' ? 'matched' : ''}}"></view>
        <view class="timeline-line"></view>
        
        <view class="bottle-card" bindtap="goToRiver" data-riverid="{{item.riverId}}">
          <view class="card-header">
            <view class="river-tag">{{item.riverName}}</view>
            <view class="bottle-type">{{item.bottleTypeName}}</view>
          </view>
          
          <view class="card-content">
            <text class="content-text">{{item.content}}</text>
          </view>

          <view class="card-footer">
            <text class="bottle-time">{{item.timeStr}}</text>
            <view class="card-actions">
              <view class="action-btn" bindtap="deleteBottle" data-riverid="{{item.riverId}}" data-bottleid="{{item.id}}">
                <text class="action-icon">🗑️</text>
              </view>
            </view>
          </view>

          <view wx:if="{{item.status === 'matched'}}" class="matched-badge">
            <text class="badge-icon">💫</text>
            <text class="badge-text">已共鸣</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <custom-tabbar current="cabin"></custom-tabbar>
</view>