.cabin-container {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  padding-bottom: 160rpx;
}

.cabin-header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #8b8b8b;
}

.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffd700;
}

.stat-label {
  font-size: 24rpx;
  color: #8b8b8b;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.filter-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.filter-tab.active {
  background: rgba(255, 215, 0, 0.1);
  border-color: rgba(255, 215, 0, 0.5);
}

.filter-icon {
  font-size: 32rpx;
}

.filter-name {
  font-size: 24rpx;
  color: #8b8b8b;
}

.filter-tab.active .filter-name {
  color: #ffd700;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #666;
}

.bottle-list {
  height: calc(100vh - 400rpx);
}

.timeline {
  position: relative;
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  margin-bottom: 32rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 32rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.timeline-dot.matched {
  background: #ffd700;
  box-shadow: 0 0 16rpx rgba(255, 215, 0, 0.5);
}

.timeline-line {
  position: absolute;
  left: 7rpx;
  top: 56rpx;
  width: 2rpx;
  height: calc(100% + 20rpx);
  background: rgba(255, 255, 255, 0.1);
}

.bottle-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 24rpx;
  position: relative;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.river-tag {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}

.bottle-type {
  font-size: 24rpx;
  color: #8b8b8b;
}

.card-content {
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 30rpx;
  color: #fff;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bottle-time {
  font-size: 24rpx;
  color: #666;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx;
}

.action-icon {
  font-size: 28rpx;
}

.matched-badge {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 215, 0, 0.2);
  border-radius: 20rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #ffd700;
}