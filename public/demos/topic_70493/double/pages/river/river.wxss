.river-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.river-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 60rpx 32rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
  background: linear-gradient(180deg, rgba(26, 26, 46, 0.9) 0%, transparent 100%);
}

.river-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.season-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
}

.season-icon {
  font-size: 28rpx;
}

.season-name {
  font-size: 24rpx;
  color: #fff;
}

.river-scene {
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.water-surface {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 150, 255, 0.1) 100%);
}

.ripple {
  position: absolute;
  bottom: 100rpx;
  width: 100rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  animation: ripple 4s ease-in-out infinite;
}

.ripple-1 { left: 20%; animation-delay: 0s; }
.ripple-2 { left: 50%; animation-delay: 1.5s; }
.ripple-3 { left: 70%; animation-delay: 3s; }

.boat {
  position: absolute;
  bottom: 150rpx;
  transition: left 0.1s ease-out;
  z-index: 5;
}

.boat-body {
  font-size: 80rpx;
  animation: boatFloat 4s ease-in-out infinite;
}

.bottles-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 100rpx;
}

.bottle {
  position: absolute;
  width: 100rpx;
  height: 140rpx;
  cursor: pointer;
  z-index: 3;
}

.bottle-inner {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 10rpx 10rpx 20rpx 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bottleFloat 3s ease-in-out infinite;
}

.bottle-content {
  font-size: 20rpx;
  color: #fff;
  text-align: center;
  line-height: 1.4;
}

.bottle-personal .bottle-inner {
  background: rgba(200, 200, 220, 0.1);
}

.bottle-matched {
  z-index: 4;
}

.bottle-matched .bottle-inner {
  background: rgba(255, 215, 0, 0.15);
  border-color: rgba(255, 215, 0, 0.5);
}

.bottle-glow {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border-radius: 15rpx;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.3) 0%, transparent 70%);
  animation: glow 2s ease-in-out infinite;
}

.matched-pairs {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 100rpx;
}

.matched-pair {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 4;
}

.pair-bottle {
  width: 80rpx;
  height: 110rpx;
}

.pair-bottle .bottle-inner {
  width: 100%;
  height: 100%;
  background: rgba(255, 215, 0, 0.2);
  border-color: rgba(255, 215, 0, 0.6);
  animation: bottleFloat 3s ease-in-out infinite;
}

.pair-bottle.bottle-a {
  animation-delay: 0s;
}

.pair-bottle.bottle-b {
  animation-delay: 0.5s;
}

.gold-band {
  width: 40rpx;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(255, 215, 0, 0.8) 0%, rgba(255, 170, 0, 0.8) 100%);
  border-radius: 2rpx;
  position: relative;
}

.gold-band::before,
.gold-band::after {
  content: '';
  position: absolute;
  top: -6rpx;
  width: 12rpx;
  height: 16rpx;
  background: rgba(255, 215, 0, 0.5);
  border-radius: 50%;
}

.gold-band::before { left: 0; }
.gold-band::after { right: 0; }

.river-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-around;
  background: linear-gradient(0deg, rgba(26, 26, 46, 0.95) 0%, transparent 100%);
}

.footer-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
}

.footer-btn.primary {
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
}

.footer-btn.primary .footer-text {
  color: #1a1a2e;
}

.footer-icon {
  font-size: 36rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #8b8b8b;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.detail-content {
  width: 100%;
  max-height: 80vh;
  background: #1a1a2e;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease-out;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #8b8b8b;
  font-size: 28rpx;
}

.matched-detail {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-label {
  font-size: 26rpx;
  color: #8b8b8b;
}

.memory-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
}

.memory-card.full {
  margin-bottom: 24rpx;
}

.memory-content {
  font-size: 30rpx;
  color: #fff;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.memory-time {
  font-size: 24rpx;
  color: #666;
}

.vs-divider {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.vs-text {
  font-size: 28rpx;
  color: #ffd700;
  font-weight: 600;
}

.match-keywords {
  background: rgba(255, 215, 0, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.keywords-label {
  font-size: 24rpx;
  color: #ffd700;
}

.keywords-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.keyword-tag {
  padding: 8rpx 20rpx;
  background: rgba(255, 215, 0, 0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffd700;
}

.single-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
}

.detail-actions {
  display: flex;
  justify-content: center;
  gap: 60rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 24rpx;
  color: #8b8b8b;
}

@keyframes ripple {
  0%, 100% { transform: scaleX(1); opacity: 0.2; }
  50% { transform: scaleX(2); opacity: 0.5; }
}

@keyframes boatFloat {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50% { transform: translateY(-15rpx) rotate(3deg); }
}

@keyframes bottleFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

@keyframes glow {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}