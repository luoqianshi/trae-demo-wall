<view class="river-container" style="background: {{seasonBg}}">
  <view class="river-header">
    <view class="river-title">{{riverName}}</view>
    <view class="season-btn" bindtap="switchSeason">
      <text class="season-icon">🍃</text>
      <text class="season-name">{{seasonName}}</text>
    </view>
  </view>

  <view class="river-scene" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <view class="water-surface">
      <view class="ripple ripple-1"></view>
      <view class="ripple ripple-2"></view>
      <view class="ripple ripple-3"></view>
    </view>

    <view class="boat" style="left: {{boatPosition}}rpx;">
      <view class="boat-body">⛵</view>
    </view>

    <view class="bottles-container">
      <view 
        wx:for="{{bottlesWithPosition}}" 
        wx:key="id"
        class="bottle {{item.bottleClass}}"
        style="left: {{item.left}}rpx; top: {{item.top}}rpx; animation-delay: {{item.delay}}s; opacity: {{item.opacity}}"
        bindtap="openBottle"
        data-id="{{item.id}}"
      >
        <view class="bottle-inner">
          <text class="bottle-content">{{item.contentPreview}}</text>
        </view>
        <view wx:if="{{item.bottleClass === 'bottle-matched'}}" class="bottle-glow"></view>
      </view>
    </view>

    <view wx:if="{{matchedPairsWithPosition.length > 0}}" class="matched-pairs">
      <view 
        wx:for="{{matchedPairsWithPosition}}" 
        wx:key="bottle1.id"
        class="matched-pair"
        style="left: {{item.left}}rpx; top: {{item.top}}rpx;"
      >
        <view class="pair-bottle bottle-a" bindtap="openBottle" data-id="{{item.bottle1.id}}">
          <view class="bottle-inner">
            <text class="bottle-content">{{item.bottle1.contentPreview}}</text>
          </view>
        </view>
        <view class="gold-band"></view>
        <view class="pair-bottle bottle-b" bindtap="openBottle" data-id="{{item.bottle2.id}}">
          <view class="bottle-inner">
            <text class="bottle-content">{{item.bottle2.contentPreview}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="river-footer">
    <view class="footer-btn" bindtap="goToCabin">
      <text class="footer-icon">🏠</text>
      <text class="footer-text">船舱</text>
    </view>
    <view class="footer-btn primary" bindtap="goToEditor">
      <text class="footer-icon">📝</text>
      <text class="footer-text">写漂流瓶</text>
    </view>
    <view class="footer-btn" bindtap="goToMessage">
      <text class="footer-icon">💬</text>
      <text class="footer-text">留言</text>
    </view>
  </view>

  <view wx:if="{{showDetail}}" class="detail-modal" bindtap="closeDetail">
    <view class="detail-content" catchtap="closeDetail">
      <view class="detail-header">
        <text class="detail-title">记忆详情</text>
        <view class="close-btn" bindtap="closeDetail">✕</view>
      </view>

      <view wx:if="{{selectedPair}}" class="matched-detail">
        <view class="detail-section">
          <view class="section-label">我的视角</view>
          <view class="memory-card">
            <view class="memory-content">{{selectedPairBottle1Content}}</view>
            <view class="memory-time">{{selectedPairBottle1Time}}</view>
          </view>
        </view>

        <view class="vs-divider">
          <text class="vs-text">VS</text>
        </view>

        <view class="detail-section">
          <view class="section-label">TA的视角</view>
          <view class="memory-card">
            <view class="memory-content">{{selectedPairBottle2Content}}</view>
            <view class="memory-time">{{selectedPairBottle2Time}}</view>
          </view>
        </view>

        <view class="match-keywords">
          <text class="keywords-label">共鸣关键词：</text>
          <view class="keywords-list">
            <text wx:for="{{selectedPairKeywords}}" wx:key="*this" class="keyword-tag">{{item}}</text>
          </view>
        </view>
      </view>

      <view wx:else class="single-detail">
        <view class="memory-card full">
          <view class="memory-content">{{selectedBottleContent}}</view>
          <view class="memory-time">{{selectedBottleTime}}</view>
        </view>
        
        <view class="single-actions">
          <button class="action-btn" bindtap="saveBottle">收纳到船舱</button>
          <button class="action-btn secondary" bindtap="releaseBottle">放流</button>
        </view>
      </view>

      <view class="detail-actions">
        <view class="action-item">
          <text class="action-icon">💬</text>
          <text class="action-text">留言</text>
        </view>
        <view class="action-item">
          <text class="action-icon">❤️</text>
          <text class="action-text">珍藏</text>
        </view>
      </view>
    </view>
  </view>
</view>