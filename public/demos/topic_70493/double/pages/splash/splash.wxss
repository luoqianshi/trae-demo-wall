.splash-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #0d1117 0%, #1a1a2e 50%, #16213e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  z-index: 9999;
}

.splash-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(ellipse at 20% 80%, rgba(255, 215, 0, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(135, 206, 250, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(255, 183, 197, 0.05) 0%, transparent 70%);
  animation: bgPulse 4s ease-in-out infinite;
}

@keyframes bgPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.splash-content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.bottle-container {
  position: relative;
  width: 200rpx;
  height: 300rpx;
  margin-bottom: 40rpx;
}

.bottle {
  position: absolute;
  width: 120rpx;
  height: 200rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.bottle-body {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx 20rpx 40rpx 40rpx;
  position: relative;
  backdrop-filter: blur(10px);
}

.bottle-neck {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 5rpx 5rpx 0 0;
}

.bottle-glow {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 20rpx 20rpx 40rpx 40rpx;
  background: radial-gradient(ellipse at 30% 30%, rgba(255, 215, 0, 0.3) 0%, transparent 60%);
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.6; }
}

.bottle-reflection {
  position: absolute;
  width: 20rpx;
  height: 80rpx;
  left: 20rpx;
  top: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0%, transparent 100%);
  border-radius: 10rpx;
}

.float-animation {
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translate(-50%, -50%) translateY(0); }
  50% { transform: translate(-50%, -50%) translateY(-20rpx); }
}

.ripple {
  position: absolute;
  width: 100rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 215, 0, 0.3);
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  animation: ripple 3s ease-out infinite;
}

.ripple-2 {
  animation-delay: 0.5s;
  width: 140rpx;
}

.ripple-3 {
  animation-delay: 1s;
  width: 180rpx;
}

@keyframes ripple {
  0% { transform: translateX(-50%) scale(0.5); opacity: 1; }
  100% { transform: translateX(-50%) scale(2); opacity: 0; }
}

.title-container {
  text-align: center;
  margin-bottom: 60rpx;
}

.main-title {
  font-size: 56rpx;
  font-weight: 600;
  color: #ffd700;
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.5);
  display: block;
  margin-bottom: 20rpx;
}

.sub-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
}

.fade-in {
  animation: fadeIn 1s ease-out forwards;
}

.fade-in-delay {
  animation: fadeIn 1s ease-out 0.5s forwards;
  opacity: 0;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.story-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.story-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  opacity: 0;
  animation: slideIn 0.8s ease-out forwards;
}

.story-icon {
  font-size: 36rpx;
}

.story-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(-30rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.progress-bar {
  width: 300rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3rpx;
  margin-bottom: 60rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd700, #ffb7c5);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.start-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2) 0%, rgba(255, 183, 197, 0.2) 100%);
  border: 2rpx solid rgba(255, 215, 0, 0.5);
  border-radius: 50rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.start-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.btn-text {
  font-size: 30rpx;
  color: #ffd700;
  font-weight: 500;
}

.btn-arrow {
  font-size: 32rpx;
  color: #ffd700;
  animation: arrowPulse 1s ease-in-out infinite;
}

@keyframes arrowPulse {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(10rpx); }
}

.floating-particles {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.particle {
  position: absolute;
  font-size: 24rpx;
  opacity: 0;
  animation: particleFloat 4s ease-in-out infinite;
}

@keyframes particleFloat {
  0% { opacity: 0; transform: translateY(100rpx); }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-100rpx); }
}