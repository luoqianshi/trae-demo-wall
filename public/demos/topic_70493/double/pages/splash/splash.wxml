<view class="splash-container">
  <view class="splash-bg"></view>
  
  <view class="splash-content">
    <view class="bottle-container">
      <view class="bottle float-animation">
        <view class="bottle-body">
          <view class="bottle-neck"></view>
          <view class="bottle-glow"></view>
        </view>
        <view class="bottle-reflection"></view>
      </view>
      <view class="ripple ripple-1"></view>
      <view class="ripple ripple-2"></view>
      <view class="ripple ripple-3"></view>
    </view>
    
    <view class="title-container">
      <text class="main-title fade-in">双人记忆摆渡船</text>
      <text class="sub-title fade-in-delay">每一条河，都藏着两个人的故事</text>
    </view>
    
    <view class="story-container">
      <view class="story-item" wx:for="{{storyTexts}}" wx:key="index" style="animation-delay: {{item.delay}}s">
        <view class="story-icon">{{item.icon}}</view>
        <text class="story-text">{{item.text}}</text>
      </view>
    </view>
    
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    
    <view class="start-btn" bindtap="enterApp">
      <text class="btn-text">开始旅程</text>
      <view class="btn-arrow">→</view>
    </view>
  </view>
  
  <view class="floating-particles">
    <view class="particle" wx:for="{{particles}}" wx:key="index" 
          style="left: {{item.left}}%; top: {{item.top}}%; animation-delay: {{item.delay}}s;">✨</view>
  </view>
</view>