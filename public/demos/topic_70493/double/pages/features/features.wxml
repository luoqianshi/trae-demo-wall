<view class="features-container">
  <view class="features-header">
    <view class="header-title">特色功能</view>
    <view class="header-subtitle">探索更多美好体验</view>
  </view>

  <view class="feature-card" bindtap="toggleWordCloud">
    <view class="card-icon word-cloud-icon">☁️</view>
    <view class="card-info">
      <view class="card-title">关键词词云墙</view>
      <view class="card-desc">生成你们专属的记忆关键词海报</view>
    </view>
    <view class="card-arrow">→</view>
  </view>

  <view class="feature-card" bindtap="toggleYearReport">
    <view class="card-icon report-icon">📊</view>
    <view class="card-info">
      <view class="card-title">年度记忆报告</view>
      <view class="card-desc">回顾一年来的美好时光</view>
    </view>
    <view class="card-arrow">→</view>
  </view>

  <view class="feature-section">
    <view class="section-header">
      <view class="section-icon">🎨</view>
      <view class="section-title">四季皮肤中心</view>
    </view>
    <view class="season-grid">
      <view 
        wx:for="{{seasons}}" 
        wx:key="id"
        class="season-item {{currentSeason === item.id ? 'active' : ''}}"
        bindtap="changeSeason"
        data-season="{{item.id}}"
      >
        <view class="season-icon">{{item.icon}}</view>
        <view class="season-name">{{item.name}}</view>
        <view class="season-indicator"></view>
      </view>
    </view>
  </view>

  <view class="feature-card about-card">
    <view class="card-icon about-icon">💌</view>
    <view class="card-info">
      <view class="card-title">关于我们</view>
      <view class="card-desc">记录不是一个人的独白，是两个人的双向看见</view>
    </view>
    <view class="card-arrow">→</view>
  </view>

  <view class="version-info">
    <text class="version-text">双人记忆摆渡船 v1.0.0</text>
  </view>

  <view wx:if="{{showWordCloud}}" class="modal-overlay" bindtap="toggleWordCloud">
    <view class="modal-content" catchtap="toggleWordCloud">
      <view class="modal-header">
        <text class="modal-title">记忆词云</text>
        <view class="modal-close" bindtap="toggleWordCloud">✕</view>
      </view>
      
      <view class="word-cloud-container">
        <view wx:if="{{wordCloudData.length === 0}}" class="empty-wordcloud">
          <text class="empty-icon">☁️</text>
          <text class="empty-text">记忆积累中，稍后解锁专属标签</text>
        </view>
        <view wx:else class="word-cloud">
          <view 
            wx:for="{{wordCloudData}}" 
            wx:key="word"
            class="word-item"
            style="font-size: {{item.size}}rpx; color: {{item.color}}; top: {{item.top}}%; left: {{item.left}}%; transform: rotate({{item.rotate}}deg);"
          >
            {{item.word}}
          </view>
        </view>
      </view>

      <view class="modal-actions">
        <button class="modal-btn" bindtap="saveWordCloud">保存图片</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showYearReport}}" class="modal-overlay" bindtap="toggleYearReport">
    <view class="modal-content report-modal" catchtap="toggleYearReport">
      <view class="modal-header">
        <text class="modal-title">{{yearReportYear}}年度记忆报告</text>
        <view class="modal-close" bindtap="toggleYearReport">✕</view>
      </view>

      <view class="report-content">
        <view class="report-section">
          <view class="report-stat main">
            <text class="stat-value">{{yearReportTotal}}</text>
            <text class="stat-label">年度记忆总数</text>
          </view>
        </view>

        <view class="report-grid">
          <view class="report-stat">
            <text class="stat-value">{{yearReportMatched}}</text>
            <text class="stat-label">共鸣记忆</text>
          </view>
          <view class="report-stat">
            <text class="stat-value">{{yearReportRelations}}</text>
            <text class="stat-label">关系长河</text>
          </view>
        </view>

        <view class="report-section">
          <view class="section-label">年度高频关键词</view>
          <view class="keywords-wrap">
            <text 
              wx:for="{{yearReportKeywords}}" 
              wx:key="*this"
              class="keyword-item"
            >{{item}}</text>
            <text wx:if="{{yearReportKeywords.length === 0}}" class="no-data">暂无数据</text>
          </view>
        </view>

        <view class="report-summary">
          <text class="summary-text">{{yearReportSummary}}</text>
        </view>
      </view>

      <view class="modal-actions">
        <button class="modal-btn" bindtap="saveYearReport">生成长图</button>
      </view>
    </view>
  </view>

  <custom-tabbar current="features"></custom-tabbar>
</view>