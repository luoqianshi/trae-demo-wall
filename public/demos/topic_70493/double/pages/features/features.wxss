.features-container {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  padding-bottom: 160rpx;
}

.features-header {
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #8b8b8b;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.word-cloud-icon {
  background: rgba(135, 206, 250, 0.15);
}

.report-icon {
  background: rgba(255, 170, 0, 0.15);
}

.about-icon {
  background: rgba(255, 182, 193, 0.15);
}

.card-info {
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #8b8b8b;
}

.card-arrow {
  font-size: 32rpx;
  color: #666;
}

.feature-section {
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  color: #fff;
}

.season-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.season-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  position: relative;
}

.season-item.active {
  border-color: rgba(255, 215, 0, 0.5);
  background: rgba(255, 215, 0, 0.1);
}

.season-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.season-name {
  font-size: 22rpx;
  color: #8b8b8b;
  text-align: center;
}

.season-item.active .season-name {
  color: #ffd700;
}

.season-indicator {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffd700;
  opacity: 0;
}

.season-item.active .season-indicator {
  opacity: 1;
}

.about-card {
  margin-bottom: 40rpx;
}

.version-info {
  text-align: center;
  padding: 40rpx;
}

.version-text {
  font-size: 24rpx;
  color: #666;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: #1a1a2e;
  border-radius: 32rpx;
  padding: 32rpx;
  animation: slideUp 0.3s ease-out;
}

.report-modal {
  max-height: 90vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #8b8b8b;
  font-size: 28rpx;
}

.word-cloud-container {
  height: 400rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.empty-wordcloud {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #666;
}

.word-cloud {
  position: relative;
  height: 100%;
}

.word-item {
  position: absolute;
  font-weight: 600;
  white-space: nowrap;
}

.report-content {
  margin-bottom: 32rpx;
}

.report-section {
  margin-bottom: 24rpx;
}

.report-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
}

.report-stat.main {
  padding: 40rpx;
}

.report-stat.main .stat-value {
  font-size: 72rpx;
  color: #ffd700;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #8b8b8b;
}

.report-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.section-label {
  font-size: 28rpx;
  color: #8b8b8b;
  margin-bottom: 16rpx;
}

.keywords-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.keyword-item {
  padding: 12rpx 24rpx;
  background: rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #ffd700;
}

.no-data {
  font-size: 26rpx;
  color: #666;
}

.report-summary {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  text-align: center;
}

.summary-text {
  font-size: 28rpx;
  color: #ccc;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
}

@keyframes slideUp {
  from { transform: translateY(50rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}