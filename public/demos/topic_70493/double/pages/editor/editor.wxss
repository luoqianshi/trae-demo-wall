.editor-container {
  min-height: 100vh;
  background: #1a1a2e;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 32rpx 20rpx;
  background: rgba(26, 26, 46, 0.95);
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  font-size: 32rpx;
  color: #fff;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.submit-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
}

.editor-content {
  padding: 32rpx;
}

.bottle-type-section {
  margin-bottom: 32rpx;
}

.type-title {
  font-size: 28rpx;
  color: #8b8b8b;
  margin-bottom: 16rpx;
}

.type-options {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.type-option.selected {
  background: rgba(255, 215, 0, 0.1);
  border-color: rgba(255, 215, 0, 0.5);
}

.type-icon {
  font-size: 48rpx;
}

.type-name {
  font-size: 28rpx;
  color: #fff;
}

.type-option.selected .type-name {
  color: #ffd700;
}

.type-desc {
  font-size: 22rpx;
  color: #666;
}

.input-section {
  margin-bottom: 32rpx;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #fff;
  line-height: 1.6;
}

.content-input::placeholder {
  color: #666;
}

.input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.template-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.template-icon {
  font-size: 24rpx;
}

.template-text {
  font-size: 24rpx;
  color: #8b8b8b;
}

.char-count {
  font-size: 24rpx;
  color: #666;
}

.image-section {
  margin-bottom: 160rpx;
}

.section-title {
  font-size: 28rpx;
  color: #8b8b8b;
  margin-bottom: 16rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.image-item {
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.add-btn {
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #666;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.templates-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.templates-content {
  width: 100%;
  max-height: 70vh;
  background: #1a1a2e;
  border-radius: 32rpx 32rpx 0 0;
  animation: slideUp 0.3s ease-out;
}

.templates-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.templates-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: #8b8b8b;
  font-size: 28rpx;
}

.category-tabs {
  white-space: nowrap;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.category-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
}

.category-tab.active {
  background: rgba(255, 215, 0, 0.15);
}

.tab-icon {
  font-size: 36rpx;
}

.tab-name {
  font-size: 24rpx;
  color: #8b8b8b;
}

.category-tab.active .tab-name {
  color: #ffd700;
}

.templates-list {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 400rpx;
}

.template-item {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.template-title {
  font-size: 28rpx;
  color: #ffd700;
  margin-bottom: 12rpx;
}

.template-content {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.6;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}