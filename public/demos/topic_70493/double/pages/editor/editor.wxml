<view class="editor-container">
  <view class="editor-header">
    <view class="back-btn" bindtap="goBack">←</view>
    <view class="header-title">写漂流瓶</view>
    <button class="submit-btn" bindtap="submitBottle">投入长河</button>
  </view>

  <view class="editor-content">
    <view class="bottle-type-section">
      <view class="type-title">选择瓶体类型</view>
      <view class="type-options">
        <view 
          class="type-option {{bottleType === 'personal' ? 'selected' : ''}}"
          bindtap="selectBottleType"
          data-type="personal"
        >
          <view class="type-icon">📭</view>
          <view class="type-name">私人念想瓶</view>
          <view class="type-desc">记录自己的心事</view>
        </view>
        <view 
          class="type-option {{bottleType === 'shared' ? 'selected' : ''}}"
          bindtap="selectBottleType"
          data-type="shared"
        >
          <view class="type-icon">✨</view>
          <view class="type-name">金色共鸣瓶</view>
          <view class="type-desc">期待对方回应</view>
        </view>
      </view>
    </view>

    <view class="input-section">
      <textarea 
        class="content-input"
        placeholder="写下你们的故事..."
        value="{{content}}"
        bindinput="inputContent"
        maxlength="2000"
      />
      <view class="input-footer">
        <view class="template-btn" bindtap="toggleTemplates">
          <text class="template-icon">📋</text>
          <text class="template-text">使用模板</text>
        </view>
        <text class="char-count">{{content.length}}/2000</text>
      </view>
    </view>

    <view class="image-section">
      <view class="section-title">添加配图</view>
      <view class="image-grid">
        <view 
          wx:for="{{images}}" 
          wx:key="*this"
          class="image-item"
        >
          <image src="{{item}}" mode="aspectFill" class="image-preview" />
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">✕</view>
        </view>
        <view 
          wx:if="{{images.length < 9}}" 
          class="image-item add-btn"
          bindtap="chooseImage"
        >
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showTemplates}}" class="templates-modal" bindtap="toggleTemplates">
    <view class="templates-content" catchtap="toggleTemplates">
      <view class="templates-header">
        <text class="templates-title">记录模板</text>
        <view class="close-btn" bindtap="toggleTemplates">✕</view>
      </view>

      <scroll-view scroll-x class="category-tabs">
        <view 
          wx:for="{{templateCategories}}" 
          wx:key="id"
          class="category-tab {{currentCategory === item.id ? 'active' : ''}}"
          bindtap="changeCategory"
          data-category="{{item.id}}"
        >
          <text class="tab-icon">{{item.icon}}</text>
          <text class="tab-name">{{item.name}}</text>
        </view>
      </scroll-view>

      <scroll-view scroll-y class="templates-list">
        <view 
          wx:for="{{templateList}}" 
          wx:key="id"
          class="template-item"
          bindtap="applyTemplate"
          data-template="{{item}}"
        >
          <view class="template-title">{{item.title}}</view>
          <view class="template-content">{{item.content}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>