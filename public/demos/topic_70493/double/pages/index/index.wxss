.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8b8b8b;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 215, 0, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.boat-icon {
  font-size: 80rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-title {
  font-size: 36rpx;
  color: #fff;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8b8b8b;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 28rpx 80rpx;
  font-size: 30rpx;
}

.river-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.river-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 28rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.river-card:active {
  transform: scale(0.98);
}

.card-glow {
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.3) 0%, transparent 70%);
  pointer-events: none;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.relation-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: rgba(255, 215, 0, 0.15);
  color: #ffd700;
}

.relation-tag.lover {
  background: rgba(255, 182, 193, 0.15);
  color: #ffb7c5;
}

.relation-tag.friend {
  background: rgba(135, 206, 250, 0.15);
  color: #87ceeb;
}

.relation-tag.family {
  background: rgba(144, 238, 144, 0.15);
  color: #90ee90;
}

.relation-tag.childhood {
  background: rgba(221, 160, 221, 0.15);
  color: #dda0dd;
}

.status-text {
  font-size: 24rpx;
  color: #8b8b8b;
}

.card-body {
  margin-bottom: 20rpx;
}

.river-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.river-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #8b8b8b;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.update-time {
  font-size: 22rpx;
  color: #666;
}

.arrow-icon {
  font-size: 28rpx;
  color: #8b8b8b;
}

.floating-btn {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 112rpx;
  height: 112rpx;
  background: #ffd700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
  z-index: 100;
}

.float-icon {
  font-size: 56rpx;
  color: #1a1a2e;
  font-weight: 300;
}

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(5deg); }
}