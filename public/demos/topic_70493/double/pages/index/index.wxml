<view class="container">
  <view class="header">
    <view class="title">我的记忆长河</view>
    <view class="subtitle">每一条河，都藏着两个人的故事</view>
  </view>

  <view wx:if="{{showEmpty}}" class="empty-state">
    <view class="empty-illustration">
      <view class="boat-icon">⛵</view>
    </view>
    <view class="empty-title">还没有专属河道</view>
    <view class="empty-desc">和重要的人一起攒回忆吧</view>
    <button class="btn-primary empty-btn" bindtap="goToCreate">创建第一条长河</button>
  </view>

  <view wx:else class="river-list">
    <view 
      wx:for="{{riversWithInfo}}" 
      wx:key="id" 
      class="river-card"
      bindtap="goToRiver"
      data-id="{{item.id}}"
    >
      <view class="card-header">
        <view class="relation-tag {{item.status}}">{{item.relationName}}</view>
        <view class="status-text">{{item.statusText}}</view>
      </view>
      
      <view class="card-body">
        <view class="river-name">{{item.name}}</view>
        <view class="river-meta">
          <text class="meta-item">
            <text class="meta-icon">✨</text>
            {{item.resonanceCount}} 共鸣记忆
          </text>
          <text class="meta-item">
            <text class="meta-icon">🍃</text>
            {{item.seasonName}}
          </text>
        </view>
      </view>

      <view class="card-footer">
        <text class="update-time">最近更新 {{item.updateTime}}</text>
        <view class="arrow-icon">→</view>
      </view>

      <view class="card-glow" style="opacity: {{item.glowOpacity}}"></view>
    </view>
  </view>

  <view class="floating-btn" bindtap="goToCreate">
    <text class="float-icon">+</text>
  </view>

  <custom-tabbar current="index"></custom-tabbar>
</view>