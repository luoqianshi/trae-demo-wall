{
  "process_area": "SWE.01",
  "name": "软件需求分析",
  "description": "建立并维护软件需求项及其结构",
  "target_levels": [1, 2, 3],
  "check_items": [
    {"id":"SWE.01.BP1","check_item":"需求是否包含唯一标识符","standard_ref":"ASPICE V4.0 SWE.1.BP1","key_elements":["需求ID","编号","标识","REQ"],"review_guide":"检查每个需求是否有唯一可追溯的标识符","common_issues":["需求编号重复","缺少版本号"],"severity":"high","applicable_levels":[1,2,3]},
    {"id":"SWE.01.BP2","check_item":"需求是否结构化组织","standard_ref":"ASPICE V4.0 SWE.1.BP2","key_elements":["功能需求","非功能需求","分类","结构"],"review_guide":"检查需求是否按类别（功能/非功能/安全）结构化组织","common_issues":["需求混杂无分类","缺少层级结构"],"severity":"medium","applicable_levels":[1,2,3]},
    {"id":"SWE.01.BP3","check_item":"需求是否定义优先级","standard_ref":"ASPICE V4.0 SWE.1.BP3","key_elements":["优先级","P1","P2","P3","关键","重要"],"review_guide":"检查每个需求是否标注了优先级","common_issues":["所有需求都是高优先级","优先级定义模糊"],"severity":"medium","applicable_levels":[2,3]},
    {"id":"SWE.01.BP4","check_item":"需求是否可测试","standard_ref":"ASPICE V4.0 SWE.1.BP4","key_elements":["验收标准","测试","验证","通过","指标"],"review_guide":"检查需求是否包含可量化的验收标准","common_issues":["需求描述模糊不可测","缺少定量指标"],"severity":"high","applicable_levels":[1,2,3]},
    {"id":"SWE.01.BP5","check_item":"安全需求是否标识 ASIL 等级","standard_ref":"ASPICE V4.0 SWE.1.BP5; ISO 26262-6:2018 8.4.3","key_elements":["ASIL","安全等级","功能安全"],"review_guide":"检查安全需求是否标注了ASIL等级","common_issues":["安全需求缺少ASIL标注","ASIL等级分配不合理"],"severity":"high","applicable_levels":[1,2,3]},
    {"id":"SWE.01.BP6","check_item":"需求是否双向可追溯","standard_ref":"ASPICE V4.0 SWE.1.BP6","key_elements":["追溯","追踪","矩阵","trace","映射"],"review_guide":"检查是否存在需求追溯矩阵","common_issues":["无追溯矩阵","追溯关系不完整"],"severity":"high","applicable_levels":[2,3]},
    {"id":"SWE.01.BP7","check_item":"需求变更是否影响评估","standard_ref":"ASPICE V4.0 SWE.1.BP7","key_elements":["变更","影响分析","变更历史","版本"],"review_guide":"检查是否有需求变更影响分析记录","common_issues":["变更无记录","未做影响分析"],"severity":"high","applicable_levels":[2,3]},
    {"id":"SWE.01.BP8","check_item":"需求是否使用标准语言","standard_ref":"ASPICE V4.0 SWE.1.BP8","key_elements":["应当","必须","shall","需"],"review_guide":"检查是否使用标准需求用语","common_issues":["使用模糊用语","需求表述不一致"],"severity":"medium","applicable_levels":[1,2,3]}
  ]
}