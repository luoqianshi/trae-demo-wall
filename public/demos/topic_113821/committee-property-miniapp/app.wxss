page {
  --bg: #f6f1e8;
  --bg2: #fffaf1;
  --ink: #17201a;
  --muted: #6c7169;
  --rule: #d8d0c2;
  --accent: #2f6f55;
  --accent2: #b46a37;
  --soft: #e7efe6;
  --warn: #fff0da;
  --danger: #d9534f;
  --shadow: rgba(23, 32, 26, 0.08);
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, sans-serif;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.page {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--bg2);
  border: 1rpx solid var(--rule);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--rule);
  background: var(--bg2);
  color: var(--accent);
  line-height: 1.4;
}

button.btn {
  margin: 0;
  line-height: 1.4;
}

button.btn::after {
  border: none;
}

.btn-primary {
  background: var(--accent);
  color: var(--bg2);
  border-color: var(--accent);
}

.btn-warn {
  background: var(--warn);
  color: var(--accent2);
  border-color: var(--accent2);
}

.btn-block {
  width: 100%;
  display: flex;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--soft);
  color: var(--accent);
  margin-right: 12rpx;
}

.tag-warn {
  background: var(--warn);
  color: var(--accent2);
}

.tag-muted {
  background: #eee;
  color: var(--muted);
}

.tag-danger {
  background: #fde8e8;
  color: var(--danger);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 0 20rpx;
  letter-spacing: -0.02em;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 0 20rpx;
}

.section-header text:first-child {
  font-size: 32rpx;
  font-weight: 700;
}

.section-header text:last-child {
  font-size: 24rpx;
  color: var(--accent);
}

.divider {
  height: 1rpx;
  background: var(--rule);
  margin: 20rpx 0;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.text-accent {
  color: var(--accent);
}

.text-warn {
  color: var(--accent2);
}

.text-danger {
  color: var(--danger);
}

.fs-22 { font-size: 22rpx; }
.fs-24 { font-size: 24rpx; }
.fs-26 { font-size: 26rpx; }
.fs-28 { font-size: 28rpx; }
.fs-30 { font-size: 30rpx; }
.fs-32 { font-size: 32rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-24 { margin-bottom: 24rpx; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--muted);
  font-size: 26rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pill {
  background: var(--soft);
  color: var(--accent);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}

.pill-warn {
  background: var(--warn);
  color: var(--accent2);
}

.pill-danger {
  background: #fde8e8;
  color: var(--danger);
}

.mini-card {
  background: var(--bg2);
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.mini-card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.mini-card-desc {
  font-size: 24rpx;
  color: var(--muted);
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.button-row .btn {
  flex: 1;
  height: 60rpx;
  font-size: 24rpx;
  padding: 0;
}
