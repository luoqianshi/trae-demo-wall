.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fffaf1;
  display: flex;
  box-shadow: 0 -2rpx 16rpx rgba(23, 32, 26, 0.06);
  border-top: 1rpx solid #d8d0c2;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #6c7169;
  padding: 8rpx 0;
}

.tab-item.active {
  color: #2f6f55;
}

.tab-icon {
  font-size: 36rpx;
  line-height: 1;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
}
