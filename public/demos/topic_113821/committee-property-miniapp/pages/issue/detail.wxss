.page {
  padding-bottom: 120rpx;
}

.detail-header {
  background: #fffaf1;
  padding: 32rpx;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  margin: -24rpx -24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 26, 0.06);
}

.tag-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #17201a;
  line-height: 1.4;
  letter-spacing: -0.02em;
}

.detail-meta-row {
  display: flex;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #d8d0c2;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-label {
  font-size: 22rpx;
  color: #6c7169;
}

.meta-value {
  font-size: 26rpx;
  color: #17201a;
  font-weight: 500;
}

.desc-text {
  font-size: 28rpx;
  color: #17201a;
  line-height: 1.7;
}

.vote-progress {
  margin-top: 8rpx;
}

.vote-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6c7169;
}

.vote-percent {
  color: #2f6f55;
  font-weight: 600;
}

.vote-bar {
  height: 12rpx;
  background: #e7efe6;
  border-radius: 6rpx;
  overflow: hidden;
}

.vote-bar-fill {
  height: 100%;
  background: #2f6f55;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.material-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.material-item:last-child {
  border-bottom: none;
}

.material-icon {
  width: 64rpx;
  height: 64rpx;
  background: #e7efe6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.material-info {
  flex: 1;
  min-width: 0;
}

.material-name {
  font-size: 26rpx;
  color: #17201a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-size {
  font-size: 22rpx;
  color: #6c7169;
  margin-top: 4rpx;
}

.material-action {
  font-size: 24rpx;
  color: #2f6f55;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: #e7efe6;
  border-radius: 8rpx;
}

.order-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
  font-size: 26rpx;
  color: #17201a;
}

.order-link:last-child {
  border-bottom: none;
}

.link-arrow {
  color: #6c7169;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 6rpx;
  width: 20rpx;
  height: 20rpx;
  background: #2f6f55;
  border-radius: 50%;
  border: 4rpx solid #e7efe6;
}

.timeline-time {
  font-size: 22rpx;
  color: #6c7169;
  margin-bottom: 6rpx;
}

.timeline-text {
  font-size: 26rpx;
  color: #17201a;
  line-height: 1.5;
}

.timeline-operator {
  font-size: 22rpx;
  color: #2f6f55;
  margin-top: 6rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fffaf1;
  padding: 20rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(23, 32, 26, 0.06);
  border-top: 1rpx solid #d8d0c2;
}

.vote-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 32, 26, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.vote-modal.show {
  opacity: 1;
  visibility: visible;
}

.vote-modal-content {
  width: 80%;
  background: #fffaf1;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
}

.vote-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17201a;
  text-align: center;
  margin-bottom: 8rpx;
}

.vote-modal-subtitle {
  font-size: 26rpx;
  color: #6c7169;
  text-align: center;
  margin-bottom: 32rpx;
}

.vote-options {
  margin-bottom: 32rpx;
}

.vote-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #d8d0c2;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #17201a;
}

.vote-option.selected {
  border-color: #2f6f55;
  background: #e7efe6;
  color: #2f6f55;
  font-weight: 600;
}

.option-radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d8d0c2;
  border-radius: 50%;
  margin-right: 16rpx;
}

.vote-option.selected .option-radio {
  border-color: #2f6f55;
  background: #2f6f55;
  box-shadow: inset 0 0 0 6rpx #fffaf1;
}

.vote-modal-actions {
  display: flex;
  gap: 16rpx;
}

.vote-modal-actions .btn {
  flex: 1;
}
