.page {
  padding: 0 0 40rpx;
}

.tab-bar {
  white-space: nowrap;
  background: #fffaf1;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #d8d0c2;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #6c7169;
  border-radius: 999rpx;
  margin-right: 16rpx;
  background: #f6f1e8;
}

.tab-item.active {
  background: #2f6f55;
  color: #fffaf1;
  font-weight: 600;
}

.issue-list {
  padding: 24rpx;
}

.issue-item {
  margin-bottom: 20rpx;
}

.issue-top {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.issue-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #17201a;
  margin-bottom: 10rpx;
}

.issue-desc {
  font-size: 26rpx;
  color: #6c7169;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.issue-meta {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #d8d0c2;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-label {
  font-size: 22rpx;
  color: #6c7169;
}

.meta-value {
  font-size: 24rpx;
  color: #17201a;
  font-weight: 500;
}
