<view class="page">
  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view wx:for="{{tabs}}" wx:key="key" 
          class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </scroll-view>

  <view class="issue-list">
    <view wx:if="{{list.length === 0}}" class="empty">
      <text>暂无议题</text>
    </view>
    <view wx:for="{{list}}" wx:key="id" class="card issue-item" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="issue-top">
        <view class="tag">{{item.category}}</view>
        <view class="tag {{item.status === 'overdue' ? 'tag-danger' : (item.status === 'voting' || item.status === 'acceptance' ? 'tag-warn' : '')}}">
          {{item.statusText}}
        </view>
      </view>
      <view class="issue-title">{{item.title}}</view>
      <view class="issue-desc">{{item.description}}</view>
      <view class="issue-meta">
        <view class="meta-item">
          <text class="meta-label">负责人</text>
          <text class="meta-value">{{item.leader}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">截止</text>
          <text class="meta-value">{{item.deadline}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">意见</text>
          <text class="meta-value">{{item.feedbackCount}}条</text>
        </view>
      </view>
    </view>
  </view>
</view>
