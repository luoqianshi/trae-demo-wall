<view class="page" wx:if="{{detail}}">
  <view class="detail-header">
    <view class="tag-row">
      <view class="tag">{{detail.category}}</view>
      <view class="tag {{detail.status === 'voting' || detail.status === 'acceptance' ? 'tag-warn' : (detail.status === 'overdue' ? 'tag-danger' : '')}}">
        {{detail.statusText}}
      </view>
    </view>
    <view class="detail-title">{{detail.title}}</view>
    <view class="detail-meta-row">
      <view class="meta-item">
        <text class="meta-label">负责人</text>
        <text class="meta-value">{{detail.leader}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">截止日期</text>
        <text class="meta-value">{{detail.deadline}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">业主意见</text>
        <text class="meta-value">{{detail.feedbackCount}}条</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{detail.voteInfo}}">
    <view class="card-title">🗳️ 业主表决</view>
    <view class="vote-progress">
      <view class="vote-stats">
        <text>已投票：{{detail.voteInfo.votedCount}} / {{detail.voteInfo.totalVoters}} 户</text>
        <text class="vote-percent">{{(detail.voteInfo.votedCount / detail.voteInfo.totalVoters * 100).toFixed(1)}}%</text>
      </view>
      <view class="vote-bar">
        <view class="vote-bar-fill" style="width: {{detail.voteInfo.votedCount / detail.voteInfo.totalVoters * 100}}%"></view>
      </view>
    </view>
    <button class="btn btn-primary btn-block mt-16" bindtap="showVoteModal">参与表决</button>
  </view>

  <view class="card">
    <view class="card-title">📝 议题说明</view>
    <view class="desc-text">{{detail.description}}</view>
  </view>

  <view class="card" wx:if="{{detail.materials && detail.materials.length > 0}}">
    <view class="card-title">📎 相关材料</view>
    <view wx:for="{{detail.materials}}" wx:key="name" 
          class="material-item" data-name="{{item.name}}" bindtap="downloadMaterial">
      <view class="material-icon">📄</view>
      <view class="material-info">
        <view class="material-name">{{item.name}}</view>
        <view class="material-size">{{item.size}}</view>
      </view>
      <view class="material-action">下载</view>
    </view>
  </view>

  <view class="card" wx:if="{{detail.relatedOrders && detail.relatedOrders.length > 0}}">
    <view class="card-title">🔗 关联工单</view>
    <view wx:for="{{detail.relatedOrders}}" wx:key="*this" 
          class="order-link" data-id="{{item}}" bindtap="goToOrder">
      <text>工单 #{{item}}</text>
      <text class="link-arrow">></text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">⏱️ 处理进度</view>
    <view class="timeline">
      <view wx:for="{{detail.timeline}}" wx:key="time" class="timeline-item">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-time">{{item.time}}</view>
          <view class="timeline-text">{{item.content}}</view>
          <view class="timeline-operator">{{item.operator}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn btn-block" bindtap="submitFeedback">提交意见</button>
  </view>

  <view class="vote-modal {{showVote ? 'show' : ''}}" catchtap="hideVoteModal">
    <view class="vote-modal-content" catchtap="">
      <view class="vote-modal-title">参与表决</view>
      <view class="vote-modal-subtitle">{{detail.title}}</view>
      <view class="vote-options">
        <view class="vote-option {{selectedOption === '同意' ? 'selected' : ''}}" data-option="同意" bindtap="selectOption">
          <view class="option-radio"></view>
          <text>同意</text>
        </view>
        <view class="vote-option {{selectedOption === '不同意' ? 'selected' : ''}}" data-option="不同意" bindtap="selectOption">
          <view class="option-radio"></view>
          <text>不同意</text>
        </view>
        <view class="vote-option {{selectedOption === '弃权' ? 'selected' : ''}}" data-option="弃权" bindtap="selectOption">
          <view class="option-radio"></view>
          <text>弃权</text>
        </view>
      </view>
      <view class="vote-modal-actions">
        <button class="btn" bindtap="hideVoteModal">取消</button>
        <button class="btn btn-primary" bindtap="submitVote">确认提交</button>
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:else>
  <text>议题不存在或已删除</text>
</view>
