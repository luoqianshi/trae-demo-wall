.page {
  padding-bottom: 140rpx;
}

.detail-header {
  background: #fffaf1;
  padding: 32rpx;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  margin: -24rpx -24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 26, 0.06);
}

.tag-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #17201a;
  line-height: 1.4;
  letter-spacing: -0.02em;
}

.detail-id {
  font-size: 22rpx;
  color: #6c7169;
  margin-top: 12rpx;
  font-family: monospace;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
  font-size: 26rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #6c7169;
  width: 180rpx;
  flex-shrink: 0;
}

.info-value {
  color: #17201a;
  flex: 1;
}

.info-value.link {
  color: #2f6f55;
}

.text-danger {
  color: #d9534f;
  font-weight: 500;
}

.desc-text {
  font-size: 28rpx;
  color: #17201a;
  line-height: 1.7;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  background: #e7efe6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.image-item.small {
  width: 140rpx;
  height: 140rpx;
}

.image-placeholder {
  font-size: 20rpx;
  color: #6c7169;
  text-align: center;
  padding: 0 8rpx;
  word-break: break-all;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 6rpx;
  width: 20rpx;
  height: 20rpx;
  background: #2f6f55;
  border-radius: 50%;
  border: 4rpx solid #e7efe6;
}

.timeline-time {
  font-size: 22rpx;
  color: #6c7169;
  margin-bottom: 6rpx;
}

.timeline-text {
  font-size: 26rpx;
  color: #17201a;
  line-height: 1.5;
}

.timeline-operator {
  font-size: 22rpx;
  color: #2f6f55;
  margin-top: 6rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fffaf1;
  padding: 20rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(23, 32, 26, 0.06);
  border-top: 1rpx solid #d8d0c2;
  display: flex;
  gap: 16rpx;
}

.bottom-bar .btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.progress-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 32, 26, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.progress-modal.show {
  opacity: 1;
  visibility: visible;
}

.progress-modal-content {
  width: 85%;
  background: #fffaf1;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
}

.progress-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17201a;
  text-align: center;
  margin-bottom: 24rpx;
}

.progress-textarea {
  width: 100%;
  height: 200rpx;
  background: #f6f1e8;
  border: 1rpx solid #d8d0c2;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #17201a;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.progress-modal-actions {
  display: flex;
  gap: 16rpx;
}

.progress-modal-actions .btn {
  flex: 1;
}
