.page {
  padding: 0 0 40rpx;
  min-height: 100vh;
}

.tab-bar {
  white-space: nowrap;
  background: #fffaf1;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #d8d0c2;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #6c7169;
  border-radius: 999rpx;
  margin-right: 16rpx;
  background: #f6f1e8;
}

.tab-item.active {
  background: #2f6f55;
  color: #fffaf1;
  font-weight: 600;
}

.order-list {
  padding: 24rpx;
}

.order-item {
  margin-bottom: 20rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-id {
  font-size: 22rpx;
  color: #6c7169;
  font-family: monospace;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #17201a;
  margin-bottom: 8rpx;
}

.order-desc {
  font-size: 26rpx;
  color: #6c7169;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.order-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6c7169;
}

.meta-icon {
  font-size: 24rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #d8d0c2;
}

.view-detail {
  font-size: 24rpx;
  color: #2f6f55;
  font-weight: 500;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: #2f6f55;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(47, 111, 85, 0.4);
  z-index: 100;
}

.fab-icon {
  color: #fffaf1;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 300;
}
