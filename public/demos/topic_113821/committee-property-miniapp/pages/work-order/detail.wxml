<view class="page" wx:if="{{detail}}">
  <view class="detail-header">
    <view class="tag-row">
      <view class="tag">{{detail.type}}</view>
      <view class="tag {{detail.isOverdue ? 'tag-danger' : (detail.status === 'waiting_acceptance' ? 'tag-warn' : '')}}">
        {{detail.statusText}}
      </view>
      <view class="tag tag-muted" wx:if="{{detail.priority === 'high'}}">高优先级</view>
    </view>
    <view class="detail-title">{{detail.title}}</view>
    <view class="detail-id">工单编号：{{detail.id}}</view>
  </view>

  <view class="card">
    <view class="info-row">
      <text class="info-label">📍 位置</text>
      <text class="info-value">{{detail.location}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">👤 联系人</text>
      <text class="info-value">{{detail.contact}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">📞 联系电话</text>
      <text class="info-value link" bindtap="callPhone">{{detail.phone}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">⏰ 创建时间</text>
      <text class="info-value">{{detail.createTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">📅 截止时间</text>
      <text class="info-value {{detail.isOverdue ? 'text-danger' : ''}}">{{detail.deadline}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">📝 问题描述</view>
    <view class="desc-text">{{detail.description}}</view>
    <view class="image-grid" wx:if="{{detail.images && detail.images.length > 0}}">
      <view wx:for="{{detail.images}}" wx:key="*this" class="image-item">
        <text class="image-placeholder">🖼️ {{item}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">⏱️ 处理进度</view>
    <view class="timeline">
      <view wx:for="{{detail.progress}}" wx:key="time" class="timeline-item">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-time">{{item.time}}</view>
          <view class="timeline-text">{{item.content}}</view>
          <view class="timeline-operator">{{item.operator}}</view>
          <view class="image-grid" wx:if="{{item.images && item.images.length > 0}}">
            <view wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="image-item small">
              <text class="image-placeholder">🖼️ {{img}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <block wx:if="{{currentRole === 'property'}}">
      <block wx:if="{{detail.status === 'pending'}}">
        <button class="btn" bindtap="assignOrder">转派</button>
        <button class="btn btn-primary" bindtap="acceptOrder">接单</button>
      </block>
      <block wx:elif="{{detail.status === 'processing' || detail.status === 'dispatched'}}">
        <button class="btn" bindtap="assignOrder">转派</button>
        <button class="btn btn-primary" bindtap="submitProgress">提交进展</button>
      </block>
      <block wx:else>
        <button class="btn btn-primary btn-block" bindtap="submitProgress">查看详情</button>
      </block>
    </block>
    <block wx:elif="{{currentRole === 'committee'}}">
      <block wx:if="{{detail.status === 'waiting_acceptance'}}">
        <button class="btn" bindtap="acceptanceReject">退回</button>
        <button class="btn btn-primary" bindtap="acceptancePass">验收通过</button>
      </block>
      <block wx:else>
        <button class="btn btn-primary btn-block">催办</button>
      </block>
    </block>
    <block wx:else>
      <block wx:if="{{detail.status === 'completed' && !detail.rating}}">
        <button class="btn btn-primary btn-block" bindtap="rateOrder">去评价</button>
      </block>
      <block wx:else>
        <button class="btn btn-primary btn-block" bindtap="callPhone">联系物业</button>
      </block>
    </block>
  </view>

  <view class="progress-modal {{showProgressModal ? 'show' : ''}}" catchtap="hideProgressModal">
    <view class="progress-modal-content" catchtap="">
      <view class="progress-modal-title">提交处理进展</view>
      <textarea class="progress-textarea" 
                placeholder="请输入处理进展说明..." 
                value="{{progressText}}"
                bindinput="onProgressInput"
                maxlength="500" />
      <view class="progress-modal-actions">
        <button class="btn" bindtap="hideProgressModal">取消</button>
        <button class="btn btn-primary" bindtap="confirmProgress">确认提交</button>
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:else>
  <text>工单不存在或已删除</text>
</view>
