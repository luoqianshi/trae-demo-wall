<view class="page">
  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view wx:for="{{tabs}}" wx:key="key" 
          class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </scroll-view>

  <view class="order-list">
    <view wx:if="{{list.length === 0}}" class="empty">
      <text>暂无工单</text>
    </view>
    <view wx:for="{{list}}" wx:key="id" class="card order-item" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="order-top">
        <view class="order-id">#{{item.id}}</view>
        <view class="tag {{item.isOverdue ? 'tag-danger' : (item.status === 'waiting_acceptance' ? 'tag-warn' : '')}}">
          {{item.statusText}}
        </view>
      </view>
      <view class="order-title">{{item.title}}</view>
      <view class="order-desc">{{item.description}}</view>
      <view class="order-meta">
        <view class="meta-item">
          <text class="meta-icon">📍</text>
          <text>{{item.location}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-icon">👤</text>
          <text>{{item.contact}}</text>
        </view>
      </view>
      <view class="order-footer">
        <text class="muted fs-22">{{item.source}} · {{item.createTime}}</text>
        <text class="view-detail">查看详情 ></text>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="goToSubmit" wx:if="{{currentRole === 'owner'}}">
    <text class="fab-icon">+</text>
  </view>
</view>
