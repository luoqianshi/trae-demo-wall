.page {
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(135deg, #fffaf1, #e7efe6);
  padding: 48rpx 32rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  margin: -24rpx -24rpx 32rpx;
}

.hero-content {
  max-width: 100%;
}

.community-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #17201a;
  letter-spacing: -0.03em;
}

.building-info {
  font-size: 26rpx;
  color: #6c7169;
  margin-top: 8rpx;
}

.section {
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-header text:first-child {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201a;
}

.section-header text:last-child {
  font-size: 24rpx;
  color: #2f6f55;
}

.announcement-card {
  margin-bottom: 20rpx;
}

.announcement-top {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 26, 0.08);
  margin-bottom: 16rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  background: #e7efe6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.entry-text {
  font-size: 24rpx;
  color: #17201a;
}

.entry-icon-warn {
  background: #fff0da;
}

.entry-grid-sm {
  padding: 24rpx 16rpx;
}

.entry-grid-sm .entry-icon {
  width: 72rpx;
  height: 72rpx;
  font-size: 32rpx;
  border-radius: 20rpx;
}

.entry-grid-sm .entry-text {
  font-size: 22rpx;
}

.meeting-card {
  background: linear-gradient(135deg, #fffaf1, #e7efe6);
}

.meeting-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.meeting-title {
  font-size: 28rpx;
  font-weight: 700;
}

.meeting-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #17201a;
  margin-bottom: 8rpx;
}

.meeting-info {
  font-size: 24rpx;
  color: #6c7169;
  margin-bottom: 8rpx;
}

.bill-card {
  background: #fffaf1;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #b46a37;
}

.access-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.access-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.access-icon {
  width: 80rpx;
  height: 80rpx;
  background: #e7efe6;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.access-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.access-desc {
  font-size: 22rpx;
  color: #6c7169;
}

.access-btn {
  flex: none;
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}
