<view class="page">
  <view class="hero">
    <view class="hero-content">
      <view class="community-name">{{communityName}}</view>
      <view class="building-info">{{buildingInfo}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>📢 小区公告</text>
      <text bindtap="goToAnnouncementList">查看全部 ></text>
    </view>
    <view wx:for="{{topAnnouncements}}" wx:key="id" class="card announcement-card" data-id="{{item.id}}" bindtap="goToAnnouncement">
      <view class="announcement-top">
        <view class="tag tag-warn" wx:if="{{item.isTop}}">置顶</view>
        <view class="tag">{{item.type}}</view>
      </view>
      <view class="card-title">{{item.title}}</view>
      <view class="row-between mt-8">
        <text class="muted fs-22">{{item.publisher}} · {{item.publishTime}}</text>
        <text class="muted fs-22">已读 {{item.readCount}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="entry-grid">
      <view wx:for="{{entries}}" wx:key="text" class="entry-item" data-path="{{item.path}}" bindtap="goToPage">
        <view class="entry-icon">{{item.icon}}</view>
        <view class="entry-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="entry-grid">
      <view wx:for="{{entries2}}" wx:key="text" class="entry-item" data-path="{{item.path}}" bindtap="goToPage">
        <view class="entry-icon entry-icon-warn">{{item.icon}}</view>
        <view class="entry-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="entry-grid entry-grid-sm">
      <view wx:for="{{entries3}}" wx:key="text" class="entry-item" data-path="{{item.path}}" bindtap="goToPage">
        <view class="entry-icon entry-icon-sm">{{item.icon}}</view>
        <view class="entry-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{ownerMeeting}}" class="section">
    <view class="card meeting-card" data-path="/pages/meeting/meeting" bindtap="goToPage">
      <view class="meeting-header">
        <view class="meeting-title">🏛️ 业主大会</view>
        <view class="tag tag-warn">{{ownerMeeting.statusText}}</view>
      </view>
      <view class="meeting-name">{{ownerMeeting.title}}</view>
      <view class="meeting-info">
        <text>签到进度：{{ownerMeeting.signInCount}}/{{ownerMeeting.totalOwners}}户</text>
      </view>
      <view class="button-row">
        <view class="btn btn-primary">去签到</view>
        <view class="btn">查看议程</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>🔥 进行中的公共事项</text>
      <text bindtap="goToIssueList">查看全部 ></text>
    </view>
    <view wx:if="{{activeIssues.length === 0}}" class="empty">
      <text>暂无进行中的事项</text>
    </view>
    <view wx:for="{{activeIssues}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goToIssue">
      <view class="mini-card-title">{{item.title}}</view>
      <view class="mini-card-desc">{{item.statusText}} · 负责人：{{item.leader}}</view>
      <view class="button-row">
        <view class="btn btn-primary">查看材料</view>
        <view class="btn">参与讨论</view>
      </view>
    </view>
  </view>

  <view wx:if="{{unpaidBills.length > 0}}" class="section">
    <view class="section-header">
      <text>💰 缴费提醒</text>
      <text data-path="/pages/payment/payment" bindtap="goToPage">查看全部 ></text>
    </view>
    <view wx:for="{{unpaidBills}}" wx:key="id" class="mini-card bill-card" data-path="/pages/payment/payment?type={{item.type === '物业费' ? 'property' : 'parking'}}" bindtap="goToPage">
      <view class="row-between">
        <view class="mini-card-title">{{item.type}} · {{item.period}}</view>
        <view class="bill-amount">¥{{item.amount}}</view>
      </view>
      <view class="mini-card-desc">截止日期：{{item.dueDate}}</view>
      <view class="button-row">
        <view class="btn btn-primary">去缴费</view>
        <view class="btn">查看明细</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>📝 我的工单</text>
      <text bindtap="goToOrderList">查看全部 ></text>
    </view>
    <view wx:if="{{myOrders.length === 0}}" class="empty">
      <text>暂无工单</text>
    </view>
    <view wx:for="{{myOrders}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goToOrder">
      <view class="row-between">
        <view class="mini-card-title">{{item.title}}</view>
        <view class="tag {{item.isOverdue ? 'tag-danger' : ''}}">{{item.statusText}}</view>
      </view>
      <view class="mini-card-desc">{{item.location}} · {{item.createTime}}</view>
    </view>
  </view>

  <view class="section">
    <view class="card access-card" data-path="/pages/access/access" bindtap="goToPage">
      <view class="access-left">
        <view class="access-icon">📱</view>
        <view>
          <view class="access-title">门禁通行</view>
          <view class="access-desc">点击生成临时通行码 · 支持远程开门</view>
        </view>
      </view>
      <view class="btn btn-primary access-btn">生成二维码</view>
    </view>
  </view>
</view>
