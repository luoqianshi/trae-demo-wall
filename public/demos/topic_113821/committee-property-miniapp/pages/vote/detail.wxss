.page {
  padding-bottom: 140rpx;
}

.detail-header {
  background: #fffaf1;
  padding: 32rpx;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  margin: -24rpx -24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 26, 0.06);
}

.tag-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #17201a;
  line-height: 1.4;
  letter-spacing: -0.02em;
}

.detail-time {
  font-size: 24rpx;
  color: #6c7169;
  margin-top: 16rpx;
}

.vote-progress-card {
  background: linear-gradient(135deg, #e7efe6, #fffaf1);
  border: 1rpx solid #d8d0c2;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #17201a;
}

.progress-percent {
  color: #2f6f55;
  font-size: 32rpx;
  font-weight: 700;
}

.progress-bar {
  height: 16rpx;
  background: #d8d0c2;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: #2f6f55;
  border-radius: 8rpx;
  transition: width 0.5s;
}

.progress-stats {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #6c7169;
}

.desc-text {
  font-size: 28rpx;
  color: #17201a;
  line-height: 1.7;
}

.material-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.material-item:last-child {
  border-bottom: none;
}

.material-icon {
  width: 64rpx;
  height: 64rpx;
  background: #e7efe6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.material-info {
  flex: 1;
  min-width: 0;
}

.material-name {
  font-size: 26rpx;
  color: #17201a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-size {
  font-size: 22rpx;
  color: #6c7169;
  margin-top: 4rpx;
}

.material-action {
  font-size: 24rpx;
  color: #2f6f55;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: #e7efe6;
  border-radius: 8rpx;
}

.vote-options {
  margin-top: 8rpx;
}

.vote-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.vote-option.selected {
  border-color: #2f6f55;
  background: #e7efe6;
}

.vote-option.disabled {
  opacity: 0.9;
}

.option-radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d8d0c2;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.vote-option.selected .option-radio {
  border-color: #2f6f55;
  background: #2f6f55;
  box-shadow: inset 0 0 0 6rpx #fffaf1;
}

.option-content {
  flex: 1;
  position: relative;
  z-index: 2;
}

.option-label {
  font-size: 28rpx;
  color: #17201a;
  font-weight: 500;
}

.option-result {
  font-size: 24rpx;
  color: #6c7169;
  margin-top: 6rpx;
}

.option-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: #e7efe6;
  opacity: 0.5;
  z-index: 1;
}

.option-bar-fill {
  height: 100%;
  background: #e7efe6;
  transition: width 0.5s;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fffaf1;
  padding: 20rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(23, 32, 26, 0.06);
  border-top: 1rpx solid #d8d0c2;
}

.bottom-bar .btn {
  height: 88rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
}
