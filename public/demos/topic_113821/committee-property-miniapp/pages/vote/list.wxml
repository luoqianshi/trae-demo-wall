<view class="page">
  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view wx:for="{{tabs}}" wx:key="key" 
          class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </scroll-view>

  <view class="vote-list">
    <view wx:if="{{list.length === 0}}" class="empty">
      <text>暂无表决</text>
    </view>
    <view wx:for="{{list}}" wx:key="id" class="card vote-item" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="vote-top">
        <view class="tag {{item.status === 'ongoing' ? '' : (item.status === 'ended' ? 'tag-muted' : 'tag-warn')}}">
          {{item.statusText}}
        </view>
        <text class="vote-time">截止：{{item.endTime}}</text>
      </view>
      <view class="vote-title">{{item.title}}</view>
      <view class="vote-desc">{{item.description}}</view>
      <view class="vote-stats">
        <view class="vote-stat">
          <text class="stat-num">{{item.votedCount}}</text>
          <text class="stat-label">已投票</text>
        </view>
        <view class="vote-stat">
          <text class="stat-num">{{item.totalVoters}}</text>
          <text class="stat-label">总业主</text>
        </view>
        <view class="vote-stat">
          <text class="stat-num">{{item.votedCount > 0 ? (item.votedCount / item.totalVoters * 100).toFixed(1) : 0}}%</text>
          <text class="stat-label">参与率</text>
        </view>
      </view>
    </view>
  </view>
</view>
