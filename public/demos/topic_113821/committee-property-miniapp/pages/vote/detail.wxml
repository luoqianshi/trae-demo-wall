<view class="page" wx:if="{{detail}}">
  <view class="detail-header">
    <view class="tag-row">
      <view class="tag {{detail.status === 'ongoing' ? '' : (detail.status === 'ended' ? 'tag-muted' : 'tag-warn')}}">
        {{detail.statusText}}
      </view>
      <view class="tag tag-muted">发起人：{{detail.sponsor}}</view>
    </view>
    <view class="detail-title">{{detail.title}}</view>
    <view class="detail-time">
      <text>投票截止：{{detail.endTime}}</text>
    </view>
  </view>

  <view class="vote-progress-card">
    <view class="progress-header">
      <text>📊 投票进度</text>
      <text class="progress-percent">{{(detail.votedCount / detail.totalVoters * 100).toFixed(1)}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{detail.votedCount / detail.totalVoters * 100}}%"></view>
    </view>
    <view class="progress-stats">
      <text>已投票：{{detail.votedCount}} 户</text>
      <text>总户数：{{detail.totalVoters}} 户</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">📝 表决说明</view>
    <view class="desc-text">{{detail.description}}</view>
  </view>

  <view class="card" wx:if="{{detail.materials && detail.materials.length > 0}}">
    <view class="card-title">📎 相关材料</view>
    <view wx:for="{{detail.materials}}" wx:key="name" 
          class="material-item" data-name="{{item.name}}" bindtap="downloadMaterial">
      <view class="material-icon">📄</view>
      <view class="material-info">
        <view class="material-name">{{item.name}}</view>
        <view class="material-size">{{item.size}}</view>
      </view>
      <view class="material-action">下载</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">🗳️ 表决选项</view>
    <view class="vote-options">
      <view wx:for="{{detail.options}}" wx:key="label" 
            class="vote-option {{selectedOption === item.label ? 'selected' : ''}} {{hasVoted || detail.status !== 'ongoing' ? 'disabled' : ''}}"
            data-option="{{item.label}}" bindtap="selectOption">
        <view class="option-radio"></view>
        <view class="option-content">
          <view class="option-label">{{item.label}}</view>
          <view class="option-result" wx:if="{{detail.status === 'ended' || hasVoted}}">
            <text>{{item.count}} 票 ({{item.percentage}}%)</text>
          </view>
        </view>
        <view class="option-bar" wx:if="{{detail.status === 'ended' || hasVoted}}">
          <view class="option-bar-fill" style="width: {{item.percentage}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <block wx:if="{{detail.status === 'ongoing' && !hasVoted}}">
      <button class="btn btn-primary btn-block" bindtap="submitVote">确认提交表决</button>
    </block>
    <block wx:elif="{{detail.status === 'ongoing' && hasVoted}}">
      <button class="btn btn-block" disabled>您已完成表决</button>
    </block>
    <block wx:elif="{{detail.status === 'upcoming'}}">
      <button class="btn btn-block" disabled>表决尚未开始</button>
    </block>
    <block wx:else>
      <button class="btn btn-block" disabled>表决已结束</button>
    </block>
  </view>
</view>

<view class="empty" wx:else>
  <text>表决不存在或已删除</text>
</view>
