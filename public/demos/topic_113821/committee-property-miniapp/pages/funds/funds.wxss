.page {
  padding-bottom: 40rpx;
}

.tab-bar {
  display: flex;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6c7169;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #2f6f55;
  color: #fffaf1;
  font-weight: 600;
}

.summary-card {
  background: linear-gradient(135deg, #2f6f55, #3a8567);
  color: #fffaf1;
  text-align: center;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.summary-amount {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  letter-spacing: -0.02em;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 250, 241, 0.3);
}

.item-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 6rpx;
}

.item-value {
  font-size: 30rpx;
  font-weight: 600;
}

.item-value.income {
  color: #a8e6cf;
}

.item-value.expense {
  color: #ffb3b3;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-header text {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201a;
}

.month-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  overflow-x: auto;
}

.month-tab {
  padding: 12rpx 24rpx;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6c7169;
  white-space: nowrap;
}

.month-tab.active {
  background: #2f6f55;
  color: #fffaf1;
  border-color: #2f6f55;
}

.month-detail {
  margin-bottom: 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
  font-size: 28rpx;
  font-weight: 600;
}

.detail-section {
  margin-top: 24rpx;
}

.detail-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #17201a;
  margin-bottom: 12rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #6c7169;
}

.detail-total {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx dashed #d8d0c2;
  font-size: 26rpx;
  font-weight: 600;
  color: #17201a;
}

.income {
  color: #2f6f55;
}

.expense {
  color: #d9534f;
}

.fund-record {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.fund-record:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.record-type {
  width: 72rpx;
  height: 40rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.income-type {
  background: #e7efe6;
  color: #2f6f55;
}

.expense-type {
  background: #fde8e8;
  color: #d9534f;
}

.record-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #17201a;
  margin-bottom: 4rpx;
}

.record-date {
  font-size: 22rpx;
  color: #6c7169;
}

.record-right {
  text-align: right;
}

.record-amount {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.record-balance {
  font-size: 22rpx;
  color: #6c7169;
}

.tip-card {
  background: #fff0da;
  border: 1rpx solid #b46a37;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #b46a37;
  margin-bottom: 12rpx;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #6c7169;
  line-height: 1.6;
}
