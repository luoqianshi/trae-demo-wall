<view class="page">
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="key" 
          class="tab-item {{currentTab === item.key ? 'active' : ''}}"
          data-tab="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </view>

  <block wx:if="{{currentTab === 'income'}}">
    <view class="card summary-card">
      <view class="summary-title">公共收益累计结余</view>
      <view class="summary-amount">¥{{publicIncome.totalBalance}}</view>
      <view class="summary-row">
        <view class="summary-item">
          <view class="item-label">本月收入</view>
          <view class="item-value income">+¥{{publicIncome.monthIncome}}</view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <view class="item-label">本月支出</view>
          <view class="item-value expense">-¥{{publicIncome.monthExpense}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text>📅 月度明细</text>
      </view>
      <view class="month-tabs">
        <view wx:for="{{publicIncome.monthlyRecords}}" wx:key="month"
              class="month-tab {{selectedMonth === index ? 'active' : ''}}"
              data-index="{{index}}" bindtap="selectMonth">
          {{item.month}}
        </view>
      </view>

      <view wx:if="{{publicIncome.monthlyRecords[selectedMonth]}}" class="card month-detail">
        <view class="detail-row">
          <text>本月结余</text>
          <text class="income">+¥{{publicIncome.monthlyRecords[selectedMonth].balance}}</text>
        </view>

        <view class="detail-section">
          <view class="detail-section-title">收入明细</view>
          <view wx:for="{{publicIncome.monthlyRecords[selectedMonth].incomeItems}}" wx:key="name" class="detail-item">
            <text>{{item.name}}</text>
            <text class="income">+¥{{item.amount}}</text>
          </view>
          <view class="detail-total">
            <text>收入合计</text>
            <text class="income">+¥{{publicIncome.monthlyRecords[selectedMonth].income}}</text>
          </view>
        </view>

        <view class="detail-section">
          <view class="detail-section-title">支出明细</view>
          <view wx:for="{{publicIncome.monthlyRecords[selectedMonth].expenseItems}}" wx:key="name" class="detail-item">
            <text>{{item.name}}</text>
            <text class="expense">-¥{{item.amount}}</text>
          </view>
          <view class="detail-total">
            <text>支出合计</text>
            <text class="expense">-¥{{publicIncome.monthlyRecords[selectedMonth].expense}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{currentTab === 'fund'}}">
    <view class="card summary-card">
      <view class="summary-title">维修基金账户余额</view>
      <view class="summary-amount">¥{{maintenanceFund.balance}}</view>
      <view class="summary-row">
        <view class="summary-item">
          <view class="item-label">累计收入</view>
          <view class="item-value income">+¥{{maintenanceFund.totalIncome}}</view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <view class="item-label">累计支出</view>
          <view class="item-value expense">-¥{{maintenanceFund.totalExpense}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text>📋 收支明细</text>
      </view>
      <view class="card">
        <view wx:for="{{maintenanceFund.records}}" wx:key="date" class="fund-record">
          <view class="record-left">
            <view class="record-type {{item.type === '收入' ? 'income-type' : 'expense-type'}}">
              {{item.type}}
            </view>
            <view>
              <view class="record-item-name">{{item.item}}</view>
              <view class="record-date">{{item.date}}</view>
            </view>
          </view>
          <view class="record-right">
            <view class="record-amount {{item.type === '收入' ? 'income' : 'expense'}}">
              {{item.type === '收入' ? '+' : ''}}¥{{item.amount}}
            </view>
            <view class="record-balance">余额：¥{{item.balance}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="tip-card">
    <view class="tip-title">💡 说明</view>
    <view class="tip-content">
      <view class="tip-item">1. 数据由业委会定期录入并公示</view>
      <view class="tip-item">2. 如对数据有疑问，请联系业委会</view>
      <view class="tip-item">3. 详细纸质档案可到业委会办公室查阅</view>
    </view>
  </view>
</view>
