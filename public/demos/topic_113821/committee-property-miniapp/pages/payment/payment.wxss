.page {
  padding-bottom: 160rpx;
}

.type-switch {
  display: flex;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6c7169;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.type-item.active {
  background: #2f6f55;
  color: #fffaf1;
  font-weight: 600;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-header text:first-child {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201a;
}

.section-header text:last-child {
  font-size: 24rpx;
  color: #2f6f55;
}

.bill-card {
  position: relative;
  margin-bottom: 16rpx;
}

.bill-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.bill-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d8d0c2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fffaf1;
}

.checkbox.checked {
  background: #2f6f55;
  border-color: #2f6f55;
}

.bill-period {
  font-size: 30rpx;
  font-weight: 600;
  color: #17201a;
  margin-bottom: 4rpx;
}

.bill-type {
  font-size: 22rpx;
  color: #6c7169;
}

.bill-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #b46a37;
}

.paid-amount {
  color: #6c7169;
  text-decoration: line-through;
  font-size: 28rpx;
}

.bill-info {
  font-size: 24rpx;
  color: #6c7169;
  margin-bottom: 12rpx;
}

.bill-detail {
  font-size: 24rpx;
  color: #2f6f55;
  text-align: right;
}

.bill-card.paid {
  opacity: 0.8;
}

.paid-tag {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  background: #e7efe6;
  color: #2f6f55;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.pay-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fffaf1;
  border-top: 1rpx solid #d8d0c2;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(23, 32, 26, 0.08);
}

.pay-left {
  flex: 1;
}

.pay-total {
  font-size: 26rpx;
  color: #17201a;
  margin-bottom: 4rpx;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #b46a37;
}

.pay-count {
  font-size: 22rpx;
  color: #6c7169;
}

.pay-btn {
  width: 240rpx;
  height: 80rpx;
  font-size: 28rpx;
}

.pay-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 32, 26, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.pay-modal {
  width: 600rpx;
  background: #fffaf1;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17201a;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-amount {
  text-align: center;
  margin-bottom: 32rpx;
  padding: 32rpx 0;
  background: #f6f1e8;
  border-radius: 16rpx;
}

.amount-label {
  display: block;
  font-size: 24rpx;
  color: #6c7169;
  margin-bottom: 8rpx;
}

.amount-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #b46a37;
}

.modal-detail {
  margin-bottom: 32rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #d8d0c2;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-item text:first-child {
  color: #6c7169;
}

.detail-item text:last-child {
  color: #17201a;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-actions .btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}
