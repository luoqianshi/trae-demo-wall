<view class="page">
  <view class="type-switch">
    <view wx:for="{{typeOptions}}" wx:key="key" 
          class="type-item {{currentType === item.key ? 'active' : ''}}"
          data-type="{{item.key}}" bindtap="switchType">
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{unpaidBills.length > 0}}" class="section">
    <view class="section-header">
      <text>待缴费 ({{unpaidBills.length}})</text>
      <text bindtap="selectAll">{{selectedBills.length === unpaidBills.length ? '取消全选' : '全选'}}</text>
    </view>
    <view wx:for="{{unpaidBills}}" wx:key="id" class="card bill-card" data-id="{{item.id}}" bindtap="toggleSelect">
      <view class="bill-header">
        <view class="bill-left">
          <view class="checkbox {{selectedBills.indexOf(item.id) > -1 ? 'checked' : ''}}">
            <text wx:if="{{selectedBills.indexOf(item.id) > -1}}">✓</text>
          </view>
          <view>
            <view class="bill-period">{{item.period}}</view>
            <view class="bill-type">{{item.type}}</view>
          </view>
        </view>
        <view class="bill-amount">¥{{item.amount}}</view>
      </view>
      <view class="bill-info">
        <text>截止日期：{{item.dueDate}}</text>
      </view>
      <view class="bill-detail" catchtap="goToDetail" data-id="{{item.id}}">
        查看明细 >
      </view>
    </view>
  </view>

  <view wx:if="{{paidBills.length > 0}}" class="section">
    <view class="section-header">
      <text>已缴费 ({{paidBills.length}})</text>
    </view>
    <view wx:for="{{paidBills}}" wx:key="id" class="card bill-card paid" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="bill-header">
        <view class="bill-left">
          <view>
            <view class="bill-period">{{item.period}}</view>
            <view class="bill-type">{{item.type}}</view>
          </view>
        </view>
        <view class="bill-amount paid-amount">¥{{item.amount}}</view>
      </view>
      <view class="bill-info">
        <text>支付时间：{{item.paidTime}}</text>
      </view>
      <view class="paid-tag">已支付</view>
    </view>
  </view>

  <view wx:if="{{unpaidBills.length === 0 && paidBills.length === 0}}" class="empty">
    <text>暂无账单记录</text>
  </view>

  <view wx:if="{{unpaidBills.length > 0}}" class="pay-bar">
    <view class="pay-left">
      <view class="pay-total">
        合计：<text class="total-amount">¥{{totalAmount}}</text>
      </view>
      <view class="pay-count">已选{{selectedBills.length}}项</view>
    </view>
    <button class="btn btn-primary pay-btn" bindtap="goToPay">
      立即缴费
    </button>
  </view>

  <view wx:if="{{showPayConfirm}}" class="pay-modal-mask" bindtap="cancelPay">
    <view class="pay-modal" catchtap="">
      <view class="modal-title">确认支付</view>
      <view class="modal-amount">
        <text class="amount-label">支付金额</text>
        <text class="amount-value">¥{{totalAmount}}</text>
      </view>
      <view class="modal-detail">
        <view class="detail-item">
          <text>缴费项目</text>
          <text>{{currentType === 'property' ? '物业费' : '停车费'}}</text>
        </view>
        <view class="detail-item">
          <text>账单数量</text>
          <text>{{selectedBills.length}}项</text>
        </view>
        <view class="detail-item">
          <text>支付方式</text>
          <text>微信支付</text>
        </view>
      </view>
      <view class="modal-actions">
        <view class="btn" bindtap="cancelPay">取消</view>
        <view class="btn btn-primary" bindtap="confirmPay">确认支付</view>
      </view>
    </view>
  </view>
</view>
