.page {
  padding-bottom: 40rpx;
}

.tab-bar {
  display: flex;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6c7169;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #b46a37;
  color: #fffaf1;
  font-weight: 600;
}

.task-card {
  margin-bottom: 20rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #17201a;
}

.task-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.info-label {
  color: #6c7169;
}

.info-value {
  color: #17201a;
}

.progress-section {
  margin-bottom: 20rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f6f1e8;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #b46a37, #cc8855);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.task-actions {
  margin-top: 8rpx;
}

.completed-time {
  font-size: 24rpx;
  color: #2f6f55;
  margin-bottom: 16rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.record-icon {
  width: 64rpx;
  height: 64rpx;
  background: #fff0da;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.record-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #17201a;
  margin-bottom: 4rpx;
}

.record-name {
  font-size: 24rpx;
  color: #6c7169;
  margin-bottom: 4rpx;
}

.record-meta {
  font-size: 22rpx;
  color: #6c7169;
  display: flex;
  gap: 8rpx;
}

.record-right {
  text-align: right;
}

.record-date {
  font-size: 24rpx;
  color: #6c7169;
  margin-bottom: 8rpx;
}

.task-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 32, 26, 0.5);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.task-modal {
  background: #fffaf1;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #d8d0c2;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17201a;
}

.modal-close {
  font-size: 48rpx;
  color: #6c7169;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-progress {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #d8d0c2;
}

.progress-info {
  font-size: 26rpx;
  color: #6c7169;
  margin-bottom: 12rpx;
}

.items-list {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
}

.check-item {
  background: #f6f1e8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.check-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #17201a;
  flex: 1;
  margin-right: 16rpx;
}

.item-status {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.status-dot {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  border: 1rpx solid #d8d0c2;
  color: #6c7169;
  background: #fffaf1;
}

.status-dot.normal.active {
  background: #e7efe6;
  border-color: #2f6f55;
  color: #2f6f55;
}

.status-dot.issue.active {
  background: #fde8e8;
  border-color: #d9534f;
  color: #d9534f;
}

.item-remark {
  font-size: 24rpx;
  color: #6c7169;
  margin-bottom: 12rpx;
  padding: 8rpx 12rpx;
  background: #fff0da;
  border-radius: 8rpx;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.item-action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #6c7169;
}

.modal-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d8d0c2;
}
