<view class="page">
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="key" 
          class="tab-item {{currentTab === item.key ? 'active' : ''}}"
          data-tab="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </view>

  <block wx:if="{{currentTab === 'daily'}}">
    <view wx:if="{{inspectionData.dailyTasks.length === 0}}" class="empty">
      <text>暂无日常巡检任务</text>
    </view>
    <view wx:for="{{inspectionData.dailyTasks}}" wx:key="id" class="card task-card">
      <view class="task-header">
        <view class="task-title">{{item.type}}</view>
        <view class="tag {{item.status === 'in_progress' ? 'tag-warn' : ''}}">
          {{item.status === 'in_progress' ? '进行中' : item.status === 'completed' ? '已完成' : '待开始'}}
        </view>
      </view>
      <view class="task-info">
        <view class="info-item">
          <text class="info-label">日期</text>
          <text class="info-value">{{item.date}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">区域</text>
          <text class="info-value">{{item.area}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">进度</text>
          <text class="info-value">{{item.completedItems}}/{{item.totalItems}}项</text>
        </view>
      </view>
      <view class="progress-section">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.completedItems / item.totalItems * 100}}%"></view>
        </view>
      </view>
      <view class="task-actions">
        <button class="btn btn-primary btn-block" data-id="{{item.id}}" bindtap="startDailyInspection">
          {{item.status === 'in_progress' ? '继续巡检' : '开始巡检'}}
        </button>
      </view>
    </view>
  </block>

  <block wx:if="{{currentTab === 'periodic'}}">
    <view wx:if="{{inspectionData.periodicTasks.length === 0}}" class="empty">
      <text>暂无专项巡检任务</text>
    </view>
    <view wx:for="{{inspectionData.periodicTasks}}" wx:key="id" class="card task-card">
      <view class="task-header">
        <view class="task-title">{{item.name}}</view>
        <view class="tag {{item.status === 'pending' ? 'tag-warn' : item.status === 'completed' ? '' : 'tag-muted'}}">
          {{item.status === 'pending' ? '待开始' : item.status === 'completed' ? '已完成' : '即将开始'}}
        </view>
      </view>
      <view class="task-info">
        <view class="info-item">
          <text class="info-label">周期</text>
          <text class="info-value">{{item.cycle}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">截止日期</text>
          <text class="info-value">{{item.deadline}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">检查项</text>
          <text class="info-value">{{item.totalItems}}项</text>
        </view>
      </view>
      <view wx:if="{{item.completedTime}}" class="completed-time">
        完成时间：{{item.completedTime}}
      </view>
      <view class="task-actions">
        <view class="button-row">
          <view class="btn" data-id="{{item.id}}" bindtap="startPeriodicInspection">查看模板</view>
          <view class="btn btn-primary" data-id="{{item.id}}" wx:if="{{item.status === 'pending'}}" bindtap="startPeriodicInspection">开始检查</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{currentTab === 'records'}}">
    <view wx:if="{{inspectionData.records.length === 0}}" class="empty">
      <text>暂无巡检记录</text>
    </view>
    <view class="card">
      <view wx:for="{{inspectionData.records}}" wx:key="id" class="record-item">
        <view class="record-left">
          <view class="record-icon">📋</view>
          <view>
            <view class="record-type">{{item.type}}</view>
            <view class="record-name" wx:if="{{item.name}}">{{item.name}}</view>
            <view class="record-meta">
              <text>巡检员：{{item.inspector}}</text>
              <text>·</text>
              <text>问题：{{item.issuesFound}}个</text>
            </view>
          </view>
        </view>
        <view class="record-right">
          <view class="record-date">{{item.date}}</view>
          <view class="tag">{{item.status === 'completed' ? '已完成' : '进行中'}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{showTaskDetail && currentTask}}" class="task-modal-mask" bindtap="closeTaskDetail">
    <view class="task-modal" catchtap="">
      <view class="modal-header">
        <view class="modal-title">{{currentTask.type}}</view>
        <view class="modal-close" bindtap="closeTaskDetail">×</view>
      </view>
      <view class="modal-progress">
        <view class="progress-info">
          <text>进度：{{currentTask.completedItems}}/{{currentTask.totalItems}}项</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{currentTask.completedItems / currentTask.totalItems * 100}}%"></view>
        </view>
      </view>
      <scroll-view class="items-list" scroll-y>
        <view wx:for="{{currentTask.items}}" wx:key="id" class="check-item">
          <view class="check-item-header">
            <view class="item-name">{{index + 1}}. {{item.name}}</view>
            <view class="item-status">
              <view class="status-dot normal {{item.status === 'normal' ? 'active' : ''}}" 
                    data-item-id="{{item.id}}" data-status="normal" bindtap="markItemStatus">正常</view>
              <view class="status-dot issue {{item.status === 'issue' ? 'active' : ''}}" 
                    data-item-id="{{item.id}}" data-status="issue" bindtap="markItemStatus">有问题</view>
            </view>
          </view>
          <view wx:if="{{item.remark}}" class="item-remark">
            备注：{{item.remark}}
          </view>
          <view class="item-actions">
            <view class="item-action-btn" data-item-id="{{item.id}}" bindtap="addRemark">
              📝 添加备注
            </view>
            <view class="item-action-btn" data-item-id="{{item.id}}" bindtap="uploadPhoto">
              📷 上传照片
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn btn-primary btn-block" bindtap="submitInspection">提交巡检结果</button>
      </view>
    </view>
  </view>
</view>
