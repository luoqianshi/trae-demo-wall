<view class="page">
  <view class="type-switch">
    <view wx:for="{{typeOptions}}" wx:key="key" 
          class="type-item {{type === item.key ? 'active' : ''}}"
          data-type="{{item.key}}" bindtap="switchType">
      {{item.label}}
    </view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <view class="form-label">标题 <text class="required">*</text></view>
      <input class="form-input" placeholder="请简要描述问题或建议" 
             value="{{title}}" bindinput="onTitleInput" maxlength="50" />
    </view>

    <view class="form-item" wx:if="{{type === 'repair'}}">
      <view class="form-label">位置</view>
      <input class="form-input" placeholder="请填写具体位置，如：3栋18楼电梯厅" 
             value="{{location}}" bindinput="onLocationInput" maxlength="100" />
    </view>

    <view class="form-item">
      <view class="form-label">分类</view>
      <view class="category-row">
        <view wx:for="{{categoryOptions}}" wx:key="key" 
              class="category-item {{category === item.key ? 'active' : ''}}"
              data-key="{{item.key}}" bindtap="selectCategory">
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">详细描述 <text class="required">*</text></view>
      <textarea class="form-textarea" placeholder="请详细描述问题或建议内容..." 
                value="{{description}}" bindinput="onDescInput" maxlength="500" />
    </view>

    <view class="form-item">
      <view class="form-label">上传照片</view>
      <view class="image-upload-row">
        <view wx:for="{{images}}" wx:key="*this" class="uploaded-image">
          <image src="{{item}}" mode="aspectFill" class="img" />
          <view class="remove-btn" data-index="{{index}}" bindtap="removeImage">×</view>
        </view>
        <view class="upload-btn" wx:if="{{images.length < 3}}" bindtap="addImage">
          <text class="upload-plus">+</text>
          <text class="upload-text">添加照片</text>
        </view>
      </view>
      <view class="form-hint">最多上传3张照片，帮助我们更快定位问题</view>
    </view>
  </view>

  <view class="submit-section">
    <button class="btn btn-primary btn-block submit-btn" bindtap="submit">提交</button>
    <view class="submit-tip">
      <text>提交后物业将在1个工作日内响应</text>
    </view>
  </view>
</view>
