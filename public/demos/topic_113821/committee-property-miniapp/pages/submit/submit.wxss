.page {
  padding-bottom: 60rpx;
}

.type-switch {
  display: flex;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6c7169;
  border-radius: 12rpx;
}

.type-item.active {
  background: #2f6f55;
  color: #fffaf1;
  font-weight: 600;
}

.form-section {
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 32rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #17201a;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.required {
  color: #d9534f;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #f6f1e8;
  border: 1rpx solid #d8d0c2;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #17201a;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background: #f6f1e8;
  border: 1rpx solid #d8d0c2;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #17201a;
  box-sizing: border-box;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 12rpx 28rpx;
  background: #f6f1e8;
  border: 1rpx solid #d8d0c2;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6c7169;
}

.category-item.active {
  background: #e7efe6;
  border-color: #2f6f55;
  color: #2f6f55;
  font-weight: 500;
}

.image-upload-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.uploaded-image {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image .img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(23, 32, 26, 0.6);
  color: #fffaf1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  background: #f6f1e8;
  border: 2rpx dashed #d8d0c2;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-plus {
  font-size: 48rpx;
  color: #6c7169;
  line-height: 1;
  font-weight: 300;
}

.upload-text {
  font-size: 22rpx;
  color: #6c7169;
}

.form-hint {
  font-size: 22rpx;
  color: #6c7169;
  margin-top: 12rpx;
}

.submit-section {
  padding: 0 8rpx;
}

.submit-btn {
  height: 88rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
}

.submit-tip {
  text-align: center;
  font-size: 24rpx;
  color: #6c7169;
  margin-top: 16rpx;
}
