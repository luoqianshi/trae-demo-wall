.page {
  padding-bottom: 40rpx;
}

.meeting-card {
  background: linear-gradient(135deg, #fffaf1, #e7efe6);
  margin-bottom: 24rpx;
}

.meeting-header {
  margin-bottom: 16rpx;
}

.meeting-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff0da;
  color: #b46a37;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #b46a37;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.meeting-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #17201a;
  margin-bottom: 16rpx;
  letter-spacing: -0.02em;
}

.meeting-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #6c7169;
}

.meta-icon {
  font-size: 28rpx;
}

.sign-section {
  padding-top: 24rpx;
  border-top: 1rpx solid #d8d0c2;
}

.sign-btn-wrap {
  text-align: center;
}

.sign-btn {
  height: 88rpx;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.sign-tip {
  font-size: 22rpx;
  color: #6c7169;
}

.signed-in {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.signed-icon {
  font-size: 40rpx;
}

.signed-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f6f55;
}

.tab-bar {
  display: flex;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6c7169;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #2f6f55;
  color: #fffaf1;
  font-weight: 600;
}

.agenda-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.agenda-item:last-child {
  border-bottom: none;
}

.agenda-num {
  width: 40rpx;
  height: 40rpx;
  background: #e7efe6;
  color: #2f6f55;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.agenda-text {
  flex: 1;
  font-size: 28rpx;
  color: #17201a;
  line-height: 1.6;
  padding-top: 4rpx;
}

.material-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.material-item:last-child {
  border-bottom: none;
}

.material-icon {
  font-size: 40rpx;
}

.material-info {
  flex: 1;
}

.material-name {
  font-size: 28rpx;
  color: #17201a;
  margin-bottom: 4rpx;
}

.material-size {
  font-size: 22rpx;
  color: #6c7169;
}

.material-download {
  font-size: 24rpx;
  color: #2f6f55;
  padding: 8rpx 16rpx;
  background: #e7efe6;
  border-radius: 8rpx;
}

.vote-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.vote-item:last-child {
  border-bottom: none;
}

.vote-info {
  flex: 1;
}

.vote-title {
  font-size: 28rpx;
  color: #17201a;
  margin-bottom: 8rpx;
}

.vote-arrow {
  color: #6c7169;
  font-size: 28rpx;
}

.section {
  margin-top: 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-header text {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201a;
}

.history-item {
  margin-bottom: 12rpx;
}
