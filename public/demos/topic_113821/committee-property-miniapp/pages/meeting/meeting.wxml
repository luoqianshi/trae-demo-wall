<view class="page">
  <view wx:if="{{currentMeeting}}" class="card meeting-card">
    <view class="meeting-header">
      <view class="meeting-status">
        <view class="status-dot"></view>
        <text>{{currentMeeting.statusText}}</text>
      </view>
    </view>
    <view class="meeting-title">{{currentMeeting.title}}</view>
    <view class="meeting-meta">
      <view class="meta-item">
        <text class="meta-icon">📅</text>
        <text>{{currentMeeting.startTime}} ~ {{currentMeeting.endTime}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-icon">📍</text>
        <text>{{currentMeeting.location}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-icon">👥</text>
        <text>已签到 {{currentMeeting.signInCount}}/{{currentMeeting.totalOwners}} 户</text>
      </view>
    </view>

    <view class="sign-section">
      <view wx:if="{{!hasSignedIn}}" class="sign-btn-wrap">
        <button class="btn btn-primary btn-block sign-btn" bindtap="handleSignIn">
          立即签到
        </button>
        <view class="sign-tip">请在会议期间完成签到，签到后可参与表决</view>
      </view>
      <view wx:if="{{hasSignedIn}}" class="signed-in">
        <view class="signed-icon">✅</view>
        <view class="signed-text">已签到</view>
      </view>
    </view>
  </view>

  <view wx:if="{{currentMeeting}}" class="tab-bar">
    <view class="tab-item {{currentTab === 'agenda' ? 'active' : ''}}" data-tab="agenda" bindtap="switchTab">
      会议议程
    </view>
    <view class="tab-item {{currentTab === 'materials' ? 'active' : ''}}" data-tab="materials" bindtap="switchTab">
      会议材料
    </view>
    <view class="tab-item {{currentTab === 'votes' ? 'active' : ''}}" data-tab="votes" bindtap="switchTab">
      表决事项
    </view>
  </view>

  <view wx:if="{{currentMeeting && currentTab === 'agenda'}}" class="card">
    <view class="card-title">📋 会议议程</view>
    <view wx:for="{{currentMeeting.agenda}}" wx:key="*this" class="agenda-item">
      <view class="agenda-num">{{index + 1}}</view>
      <view class="agenda-text">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{currentMeeting && currentTab === 'materials'}}" class="card">
    <view class="card-title">📎 会议材料</view>
    <view wx:if="{{currentMeeting.materials.length === 0}}" class="empty">
      <text>暂无材料</text>
    </view>
    <view wx:for="{{currentMeeting.materials}}" wx:key="name" class="material-item" data-name="{{item.name}}" bindtap="downloadMaterial">
      <view class="material-icon">📄</view>
      <view class="material-info">
        <view class="material-name">{{item.name}}</view>
        <view class="material-size">{{item.size}}</view>
      </view>
      <view class="material-download">下载</view>
    </view>
  </view>

  <view wx:if="{{currentMeeting && currentTab === 'votes'}}" class="card">
    <view class="card-title">🗳️ 表决事项</view>
    <view wx:if="{{currentMeeting.voteItems.length === 0}}" class="empty">
      <text>暂无表决事项</text>
    </view>
    <view wx:for="{{currentMeeting.voteItems}}" wx:key="id" class="vote-item" data-id="{{item.id}}" bindtap="goToVote">
      <view class="vote-info">
        <view class="vote-title">{{item.title}}</view>
        <view class="vote-status">
          <view class="tag tag-warn">进行中</view>
        </view>
      </view>
      <view class="vote-arrow">></view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>📜 历史会议</text>
    </view>
    <view wx:if="{{historyMeetings.length === 0}}" class="empty">
      <text>暂无历史会议</text>
    </view>
    <view wx:for="{{historyMeetings}}" wx:key="id" class="mini-card history-item">
      <view class="row-between">
        <view class="mini-card-title">{{item.title}}</view>
        <view class="tag tag-muted">{{item.statusText}}</view>
      </view>
      <view class="mini-card-desc">{{item.startTime}} ~ {{item.endTime}}</view>
    </view>
  </view>
</view>
