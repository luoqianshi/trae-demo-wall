<view class="page">
  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view wx:for="{{tabs}}" wx:key="key" 
          class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="switchTab">
      {{item.label}}
    </view>
  </scroll-view>

  <view class="announcement-list">
    <view wx:if="{{list.length === 0}}" class="empty">
      <text>暂无公告</text>
    </view>
    <view wx:for="{{list}}" wx:key="id" class="card announcement-item" data-id="{{item.id}}" bindtap="goToDetail">
      <view class="announcement-top">
        <view class="tag tag-warn" wx:if="{{item.isTop}}">置顶</view>
        <view class="tag">{{item.type}}</view>
      </view>
      <view class="announcement-title">{{item.title}}</view>
      <view class="row-between mt-12">
        <text class="muted fs-22">{{item.publisher}} · {{item.publishTime}}</text>
        <text class="muted fs-22">已读 {{item.readCount}}</text>
      </view>
    </view>
  </view>
</view>
