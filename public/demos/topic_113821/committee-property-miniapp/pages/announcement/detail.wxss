.page {
  padding-bottom: 40rpx;
}

.detail-header {
  background: #fffaf1;
  padding: 32rpx;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  margin: -24rpx -24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 26, 0.06);
}

.tag-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #17201a;
  line-height: 1.4;
  letter-spacing: -0.02em;
}

.detail-meta {
  font-size: 24rpx;
  color: #6c7169;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  opacity: 0.5;
}

.detail-content {
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 28rpx;
  color: #17201a;
  line-height: 1.8;
  white-space: pre-wrap;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.attachments {
  margin-top: 24rpx;
}

.attachment-item {
  display: flex;
  align-items: center;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.attachment-icon {
  width: 72rpx;
  height: 72rpx;
  background: #e7efe6;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.attachment-info {
  flex: 1;
  min-width: 0;
}

.attachment-name {
  font-size: 26rpx;
  color: #17201a;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-size {
  font-size: 22rpx;
  color: #6c7169;
  margin-top: 4rpx;
}

.attachment-action {
  font-size: 24rpx;
  color: #2f6f55;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: #e7efe6;
  border-radius: 8rpx;
}
