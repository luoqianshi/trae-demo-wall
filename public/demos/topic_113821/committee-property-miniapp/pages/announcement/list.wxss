.page {
  padding: 0 0 40rpx;
}

.tab-bar {
  white-space: nowrap;
  background: #fffaf1;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #d8d0c2;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #6c7169;
  border-radius: 999rpx;
  margin-right: 16rpx;
  background: #f6f1e8;
}

.tab-item.active {
  background: #2f6f55;
  color: #fffaf1;
  font-weight: 600;
}

.announcement-list {
  padding: 24rpx;
}

.announcement-item {
  margin-bottom: 20rpx;
}

.announcement-top {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.announcement-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #17201a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
