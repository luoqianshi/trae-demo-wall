.page {
  padding-bottom: 60rpx;
}

.profile-header {
  background: linear-gradient(135deg, #2f6f55, #3d8b6b);
  padding: 48rpx 32rpx 64rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: -24rpx -24rpx 32rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 250, 241, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  color: #fffaf1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.role-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(255, 250, 241, 0.2);
  border-radius: 8rpx;
  font-size: 22rpx;
}

.role-switch-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.role-switch-desc {
  font-size: 24rpx;
  color: #6c7169;
  margin-bottom: 20rpx;
}

.role-row {
  display: flex;
  gap: 16rpx;
}

.role-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  background: #f6f1e8;
  border: 1rpx solid #d8d0c2;
  border-radius: 16rpx;
}

.role-item.active {
  background: #e7efe6;
  border-color: #2f6f55;
}

.role-icon {
  font-size: 40rpx;
}

.role-label {
  font-size: 24rpx;
  color: #6c7169;
}

.role-item.active .role-label {
  color: #2f6f55;
  font-weight: 600;
}

.menu-group {
  margin-top: 32rpx;
}

.menu-group-title {
  font-size: 26rpx;
  color: #6c7169;
  margin-bottom: 12rpx;
  padding: 0 8rpx;
}

.menu-card {
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #d8d0c2;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #17201a;
}

.menu-arrow {
  font-size: 24rpx;
  color: #6c7169;
}

.version-info {
  text-align: center;
  font-size: 22rpx;
  color: #6c7169;
  margin-top: 48rpx;
}
