<view class="page">
  <view class="profile-header">
    <view class="avatar">👤</view>
    <view class="user-info">
      <view class="user-name">阳光花园业主</view>
      <view class="user-role">
        <view class="role-tag">{{roleConfig.name}}视角</view>
      </view>
    </view>
  </view>

  <view class="card role-switch-card">
    <view class="card-title">🎭 角色切换（演示用）</view>
    <view class="role-switch-desc">点击可切换不同角色视角，体验不同功能</view>
    <view class="role-row">
      <view wx:for="{{roleOptions}}" wx:key="key" 
            class="role-item {{currentRole === item.key ? 'active' : ''}}"
            data-role="{{item.key}}" bindtap="switchRole">
        <view class="role-icon">{{item.icon}}</view>
        <view class="role-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view wx:for="{{menuGroups}}" wx:for-item="group" wx:key="title" class="menu-group">
    <view class="menu-group-title">{{group.title}}</view>
    <view class="menu-card">
      <view wx:for="{{group.items}}" wx:for-item="item" wx:key="label" 
            class="menu-item" data-path="{{item.path}}" bindtap="goToMenu">
        <view class="menu-left">
          <text class="menu-icon">{{item.icon}}</text>
          <text class="menu-label">{{item.label}}</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="version-info">
    <text>v1.0.0 · MVP 版本</text>
  </view>
</view>
