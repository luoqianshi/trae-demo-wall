<view class="page">
  <view class="hero">
    <view class="hero-title">物业工作台</view>
    <view class="hero-subtitle">阳光花园物业服务中心</view>
    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-num">{{stats.newOrders || 0}}</view>
        <view class="stat-label">新工单</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.rectification || 0}}</view>
        <view class="stat-label">整改</view>
      </view>
      <view class="stat-item">
        <view class="stat-num warn">{{stats.overdue || 0}}</view>
        <view class="stat-label">超时</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.pendingAcceptance || 0}}</view>
        <view class="stat-label">待验收</view>
      </view>
    </view>
  </view>

  <view class="entry-grid">
    <view wx:for="{{entries}}" wx:key="text" class="entry-item" data-path="{{item.path}}" bindtap="handleEntry">
      <view class="entry-icon">{{item.icon}}</view>
      <view class="entry-text">{{item.text}}</view>
    </view>
  </view>

  <view class="entry-grid entry-grid-sm">
    <view wx:for="{{entries2}}" wx:key="text" class="entry-item" data-path="{{item.path}}" bindtap="handleEntry">
      <view class="entry-icon entry-icon-warn">{{item.icon}}</view>
      <view class="entry-text">{{item.text}}</view>
    </view>
  </view>

  <view wx:if="{{inspectionData}}" class="section">
    <view class="section-header">
      <text>🔍 今日巡检</text>
      <text data-path="/pages/inspection/inspection" bindtap="handleEntry">查看全部 ></text>
    </view>
    <view wx:for="{{inspectionData.dailyTasks}}" wx:key="id" class="mini-card inspection-card" data-path="/pages/inspection/inspection?tab=daily" bindtap="handleEntry">
      <view class="row-between">
        <view class="mini-card-title">{{item.type}} · {{item.area}}</view>
        <view class="tag tag-warn" wx:if="{{item.status === 'in_progress'}}">进行中</view>
      </view>
      <view class="mini-card-desc">
        进度：{{item.completedItems}}/{{item.totalItems}} 项
      </view>
      <view class="inspection-progress">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{item.completedItems / item.totalItems * 100}}%"></view>
        </view>
      </view>
      <view class="button-row">
        <view class="btn btn-primary">继续巡检</view>
      </view>
    </view>
  </view>

  <view wx:if="{{inspectionData}}" class="section">
    <view class="section-header">
      <text>📋 待完成专项巡检</text>
      <text data-path="/pages/inspection/inspection?tab=periodic" bindtap="handleEntry">查看全部 ></text>
    </view>
    <view wx:for="{{inspectionData.periodicTasks}}" wx:key="id" wx:if="{{item.status === 'pending' || item.status === 'upcoming'}}" class="mini-card" data-path="/pages/inspection/inspection?tab=periodic" bindtap="handleEntry">
      <view class="row-between">
        <view class="mini-card-title">{{item.name}}</view>
        <view class="tag {{item.status === 'pending' ? 'tag-warn' : 'tag-muted'}}">{{item.status === 'pending' ? '待开始' : '即将开始'}}</view>
      </view>
      <view class="mini-card-desc">周期：{{item.cycle}} · 截止：{{item.deadline}}</view>
      <view class="button-row">
        <view class="btn btn-primary" wx:if="{{item.status === 'pending'}}">开始检查</view>
        <view class="btn" wx:if="{{item.status === 'upcoming'}}">查看模板</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>🆕 新工单</text>
      <text bindtap="goToOrderList">查看全部 ></text>
    </view>
    <view wx:if="{{newOrders.length === 0}}" class="empty">
      <text>暂无新工单</text>
    </view>
    <view wx:for="{{newOrders}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goToOrder">
      <view class="row-between">
        <view class="mini-card-title">{{item.title}}</view>
        <view class="tag {{item.isOverdue ? 'tag-danger' : 'tag-warn'}}">{{item.statusText}}</view>
      </view>
      <view class="mini-card-desc">来源：{{item.source}} · {{item.location}}</view>
      <view class="button-row">
        <view class="btn btn-primary" data-id="{{item.id}}" data-action="accept" catchtap="handleOrder">接单</view>
        <view class="btn" data-id="{{item.id}}" data-action="assign" catchtap="handleOrder">转派</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>🔧 整改工单</text>
      <text bindtap="goToOrderList">查看全部 ></text>
    </view>
    <view wx:if="{{rectificationOrders.length === 0}}" class="empty">
      <text>暂无整改工单</text>
    </view>
    <view wx:for="{{rectificationOrders}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goToOrder">
      <view class="row-between">
        <view class="mini-card-title">{{item.title}}</view>
        <view class="tag {{item.isOverdue ? 'tag-danger' : ''}}">{{item.statusText}}</view>
      </view>
      <view class="mini-card-desc">来源：{{item.source}} · 截止：{{item.deadline}}</view>
      <view class="button-row">
        <view class="btn btn-primary" data-id="{{item.id}}" data-action="progress" catchtap="handleOrder">提交进展</view>
        <view class="btn" data-id="{{item.id}}" data-action="assign" catchtap="handleOrder">转派</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>⏳ 待验收事项</text>
      <text bindtap="goToOrderList">查看全部 ></text>
    </view>
    <view wx:if="{{pendingAcceptance.length === 0}}" class="empty">
      <text>暂无待验收事项</text>
    </view>
    <view wx:for="{{pendingAcceptance}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goToOrder">
      <view class="row-between">
        <view class="mini-card-title">{{item.title}}</view>
        <view class="tag tag-warn">待验收</view>
      </view>
      <view class="mini-card-desc">已上传完成照片，等待业委会验收</view>
    </view>
  </view>
</view>
