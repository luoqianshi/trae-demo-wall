<view class="page">
  <view class="hero">
    <view class="hero-title">业委会工作台</view>
    <view class="hero-subtitle">阳光花园业主委员会</view>
    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-num">{{stats.pendingReview || 0}}</view>
        <view class="stat-label">待审核</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.pendingAcceptance || 0}}</view>
        <view class="stat-label">待验收</view>
      </view>
      <view class="stat-item">
        <view class="stat-num warn">{{stats.overdue || 0}}</view>
        <view class="stat-label">超时</view>
      </view>
    </view>
  </view>

  <view class="entry-grid">
    <view wx:for="{{entries}}" wx:key="text" class="entry-item" data-path="{{item.path}}" data-action="{{item.action}}" bindtap="handleEntry">
      <view class="entry-icon">{{item.icon}}</view>
      <view class="entry-text">{{item.text}}</view>
    </view>
  </view>

  <view class="entry-grid entry-grid-sm">
    <view wx:for="{{entries2}}" wx:key="text" class="entry-item" data-path="{{item.path}}" bindtap="handleEntry">
      <view class="entry-icon entry-icon-warn">{{item.icon}}</view>
      <view class="entry-text">{{item.text}}</view>
    </view>
  </view>

  <view wx:if="{{inspectionData}}" class="section">
    <view class="section-header">
      <text>🔍 物业巡检监督</text>
      <text data-path="/pages/inspection/inspection" bindtap="handleEntry">查看全部 ></text>
    </view>
    <view class="mini-card inspection-card" data-path="/pages/inspection/inspection" bindtap="handleEntry">
      <view class="row-between">
        <view class="mini-card-title">今日巡检进度</view>
        <view class="tag tag-warn">进行中</view>
      </view>
      <view class="mini-card-desc">
        日常巡检：{{inspectionData.dailyTasks[0].completedItems}}/{{inspectionData.dailyTasks[0].totalItems}} 项
      </view>
      <view class="inspection-stats">
        <view class="stat-item">
          <text class="stat-num">{{inspectionData.records.length}}</text>
          <text class="stat-label">历史记录</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{inspectionData.periodicTasks.length}}</text>
          <text class="stat-label">专项巡检</text>
        </view>
        <view class="stat-item">
          <text class="stat-num warn">{{inspectionData.periodicTasks.filter(t => t.status === 'pending').length}}</text>
          <text class="stat-label">待完成</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>📋 进行中的议题</text>
      <text bindtap="goToIssueList">查看全部 ></text>
    </view>
    <view wx:if="{{pendingIssues.length === 0}}" class="empty">
      <text>暂无进行中的议题</text>
    </view>
    <view wx:for="{{pendingIssues}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goToIssue">
      <view class="row-between">
        <view class="mini-card-title">{{item.title}}</view>
        <view class="tag">{{item.statusText}}</view>
      </view>
      <view class="mini-card-desc">负责人：{{item.leader}} · 截止：{{item.deadline}}</view>
      <view class="button-row">
        <view class="btn btn-primary" data-id="{{item.id}}" data-action="view" catchtap="handleIssue">查看</view>
        <view class="btn" data-id="{{item.id}}" data-action="urge" catchtap="handleIssue">催办</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>✅ 待验收整改</text>
      <text bindtap="goToOrderList">查看全部 ></text>
    </view>
    <view wx:if="{{acceptanceOrders.length === 0}}" class="empty">
      <text>暂无待验收事项</text>
    </view>
    <view wx:for="{{acceptanceOrders}}" wx:key="id" class="mini-card" data-id="{{item.id}}" bindtap="goToOrder">
      <view class="row-between">
        <view class="mini-card-title">{{item.title}}</view>
        <view class="tag tag-warn">待验收</view>
      </view>
      <view class="mini-card-desc">物业已反馈，等待业委会验收</view>
      <view class="button-row">
        <view class="btn btn-primary" data-id="{{item.id}}" data-action="accept" catchtap="handleAcceptance">验收</view>
        <view class="btn" data-id="{{item.id}}" data-action="reject" catchtap="handleAcceptance">退回</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text>📝 公告草稿</text>
    </view>
    <view wx:if="{{draftAnnouncements.length === 0}}" class="empty">
      <text>暂无草稿</text>
    </view>
    <view wx:for="{{draftAnnouncements}}" wx:key="title" class="mini-card">
      <view class="mini-card-title">{{item.title}}</view>
      <view class="mini-card-desc">{{item.status}}</view>
    </view>
  </view>
</view>
