.page {
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(135deg, #2f6f55, #3d8b6b);
  padding: 48rpx 32rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  margin: -24rpx -24rpx 32rpx;
  color: #fffaf1;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.stats-row {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.stat-item {
  flex: 1;
  background: rgba(255, 250, 241, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-num.warn {
  color: #ffd700;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.section {
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-header text:first-child {
  font-size: 30rpx;
  font-weight: 700;
  color: #17201a;
}

.section-header text:last-child {
  font-size: 24rpx;
  color: #2f6f55;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 26, 0.08);
  margin-bottom: 32rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  background: #e7efe6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.entry-text {
  font-size: 24rpx;
  color: #17201a;
}

.entry-grid-sm {
  padding: 24rpx 16rpx;
  margin-bottom: 24rpx;
}

.entry-grid-sm .entry-icon {
  width: 72rpx;
  height: 72rpx;
  font-size: 32rpx;
  border-radius: 20rpx;
}

.entry-grid-sm .entry-text {
  font-size: 22rpx;
}

.entry-icon-warn {
  background: #fff0da;
}

.inspection-card {
  margin-bottom: 0;
}

.inspection-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #d8d0c2;
}

.inspection-stats .stat-item {
  flex: 1;
  text-align: center;
  background: #f6f1e8;
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
}

.inspection-stats .stat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #2f6f55;
  display: block;
}

.inspection-stats .stat-num.warn {
  color: #b46a37;
}

.inspection-stats .stat-label {
  font-size: 20rpx;
  color: #6c7169;
  margin-top: 4rpx;
  display: block;
}
