<view class="page">
  <view class="card">
    <view class="card-title">选择门禁</view>
    <view class="door-grid">
      <view wx:for="{{doorList}}" wx:key="id" 
            class="door-item {{selectedDoor.id === item.id ? 'active' : ''}}"
            data-door="{{item}}" bindtap="selectDoor">
        <view class="door-icon">🚪</view>
        <view class="door-name">{{item.name}}</view>
        <view class="door-status" wx:if="{{item.status === 'active'}}">可用</view>
      </view>
    </view>
  </view>

  <view class="card qr-card">
    <view class="qr-header">
      <view class="qr-title">扫码开门</view>
      <view class="qr-subtitle">请将二维码对准门禁扫描设备</view>
    </view>
    
    <view wx:if="{{!qrCodeVisible}}" class="qr-placeholder" bindtap="generateQRCode">
      <view class="qr-placeholder-icon">📱</view>
      <view class="qr-placeholder-text">点击生成通行二维码</view>
      <view class="qr-placeholder-desc">当前门禁：{{selectedDoor.name}}</view>
    </view>

    <view wx:if="{{qrCodeVisible}}" class="qr-display">
      <view class="qr-code-box">
        <view class="qr-code-fake">
          <view class="qr-pattern"></view>
          <view class="qr-code-text">{{qrCodeText}}</view>
        </view>
      </view>
      <view class="qr-info">
        <view class="qr-countdown">
          <text class="countdown-num">{{countDown}}</text>
          <text class="countdown-unit">秒后失效</text>
        </view>
        <view class="qr-expire">有效期至：{{expireTime}}</view>
      </view>
      <view class="qr-actions">
        <view class="btn btn-primary" bindtap="refreshQRCode">刷新二维码</view>
        <view class="btn" bindtap="closeQRCode">关闭</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">最近开门记录</view>
    <view wx:if="{{recentRecords.length === 0}}" class="empty">
      <text>暂无开门记录</text>
    </view>
    <view wx:for="{{recentRecords}}" wx:key="time" class="record-item">
      <view class="record-left">
        <view class="record-icon">✅</view>
        <view>
          <view class="record-door">{{item.door}}</view>
          <view class="record-type">{{item.type}}</view>
        </view>
      </view>
      <view class="record-time">{{item.time}}</view>
    </view>
  </view>

  <view class="tip-card">
    <view class="tip-title">💡 使用提示</view>
    <view class="tip-content">
      <view class="tip-item">1. 二维码每60秒自动刷新，请注意时效</view>
      <view class="tip-item">2. 请在门禁设备前再生成二维码，避免失效</view>
      <view class="tip-item">3. 如遇问题请联系物业服务中心</view>
    </view>
  </view>
</view>
