.page {
  padding-bottom: 40rpx;
}

.door-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.door-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f6f1e8;
  border: 2rpx solid #d8d0c2;
  border-radius: 16rpx;
  gap: 8rpx;
}

.door-item.active {
  background: #e7efe6;
  border-color: #2f6f55;
}

.door-icon {
  font-size: 40rpx;
}

.door-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #17201a;
}

.door-status {
  font-size: 20rpx;
  color: #2f6f55;
}

.qr-card {
  text-align: center;
}

.qr-header {
  margin-bottom: 24rpx;
}

.qr-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17201a;
  margin-bottom: 8rpx;
}

.qr-subtitle {
  font-size: 24rpx;
  color: #6c7169;
}

.qr-placeholder {
  background: #f6f1e8;
  border: 2rpx dashed #d8d0c2;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.qr-placeholder-icon {
  font-size: 80rpx;
}

.qr-placeholder-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #17201a;
}

.qr-placeholder-desc {
  font-size: 24rpx;
  color: #6c7169;
}

.qr-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.qr-code-box {
  padding: 32rpx;
  background: #fffaf1;
  border: 1rpx solid #d8d0c2;
  border-radius: 20rpx;
}

.qr-code-fake {
  width: 320rpx;
  height: 320rpx;
  background: linear-gradient(45deg, #17201a 25%, transparent 25%),
              linear-gradient(-45deg, #17201a 25%, transparent 25%),
              linear-gradient(45deg, transparent 75%, #17201a 75%),
              linear-gradient(-45deg, transparent 75%, #17201a 75%);
  background-size: 20rpx 20rpx;
  background-position: 0 0, 0 10rpx, 10rpx -10rpx, -10rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.qr-pattern {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #17201a;
  background: #fffaf1;
}

.qr-pattern::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  background: #17201a;
  border-radius: 50%;
}

.qr-code-text {
  background: #fffaf1;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  color: #6c7169;
  font-family: monospace;
  z-index: 1;
}

.qr-info {
  text-align: center;
}

.qr-countdown {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.countdown-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #b46a37;
}

.countdown-unit {
  font-size: 24rpx;
  color: #6c7169;
}

.qr-expire {
  font-size: 22rpx;
  color: #6c7169;
}

.qr-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.qr-actions .btn {
  flex: 1;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #d8d0c2;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-icon {
  width: 64rpx;
  height: 64rpx;
  background: #e7efe6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.record-door {
  font-size: 28rpx;
  font-weight: 600;
  color: #17201a;
  margin-bottom: 4rpx;
}

.record-type {
  font-size: 22rpx;
  color: #6c7169;
}

.record-time {
  font-size: 24rpx;
  color: #6c7169;
}

.tip-card {
  background: #fff0da;
  border: 1rpx solid #b46a37;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #b46a37;
  margin-bottom: 12rpx;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #6c7169;
  line-height: 1.6;
}
