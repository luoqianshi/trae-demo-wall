<view class="message-preview">
  <!-- 正常预览模式 -->
  <block wx:if="{{!isEditing}}">
    <view class="preview-header">
      <text class="preview-title">生成结果</text>
      <text wx:if="{{isFallback}}" class="fallback-tag">本地模板</text>
    </view>
    
    <view wx:if="{{content}}" class="message-preview-box">
      <rich-text nodes="{{richNodes}}" user-select></rich-text>
    </view>
    
    <view wx:else class="empty-state">
      <text>选择场景并填写信息后，点击上方按钮生成沟通话术</text>
    </view>
    
    <view wx:if="{{content && editable}}" class="action-group">
      <button class="btn-secondary" bindtap="onCopy">一键复制</button>
      <button class="btn-secondary" bindtap="onRegenerate">换一种说法</button>
      <button class="btn-secondary" bindtap="onEdit">编辑</button>
    </view>
  </block>
  
  <!-- 编辑模式 -->
  <block wx:else>
    <view class="preview-header">
      <text class="preview-title">编辑话术</text>
    </view>
    <textarea 
      class="textarea-field" 
      value="{{editContent}}"
      bindinput="onEditInput"
      maxlength="800"
      auto-height
    />
    <view class="action-group m-t-24">
      <button class="btn-primary" bindtap="onSaveEdit">保存</button>
      <button class="btn-secondary" bindtap="onCancelEdit">取消</button>
    </view>
  </block>
</view>
