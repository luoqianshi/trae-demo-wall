.message-preview {
  width: 100%;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.3rpx;
}

.fallback-tag {
  font-size: 22rpx;
  color: var(--warning);
  background: #FFF8E8;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.action-group {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
