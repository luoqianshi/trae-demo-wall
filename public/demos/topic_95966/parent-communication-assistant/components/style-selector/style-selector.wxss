.style-selector {
  width: 100%;
}

.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-item {
  width: calc(50% - 8rpx);
  background: #F0F4F8;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.style-item.active {
  background: #E8F1FB;
  border-color: #4A90D9;
}

.style-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.style-item.active .style-name {
  color: #4A90D9;
}

.style-desc {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.style-item.active .style-desc {
  color: #7BA8E0;
}
