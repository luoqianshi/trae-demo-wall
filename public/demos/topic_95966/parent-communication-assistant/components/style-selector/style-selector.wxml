<view class="style-selector">
  <view class="style-list">
    <view 
      wx:for="{{styles}}" 
      wx:key="id"
      class="style-item {{value === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <text class="style-name">{{item.name}}</text>
      <text class="style-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
