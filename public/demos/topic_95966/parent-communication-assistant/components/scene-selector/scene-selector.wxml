<view class="scene-selector">
  <view class="scene-grid">
    <view 
      wx:for="{{scenes}}" 
      wx:key="id"
      class="scene-item {{value === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <text class="scene-icon">{{item.icon}}</text>
      <text class="scene-name">{{item.name}}</text>
    </view>
  </view>
</view>
