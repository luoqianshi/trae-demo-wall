.channel-selector {
  width: 100%;
}

.channel-list {
  display: flex;
  gap: 16rpx;
}

.channel-item {
  flex: 1;
  background: #F0F4F8;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.channel-item.active {
  background: #E8F1FB;
  border-color: #4A90D9;
}

.channel-name {
  font-size: 26rpx;
  color: #666666;
}

.channel-item.active .channel-name {
  color: #4A90D9;
  font-weight: 500;
}
