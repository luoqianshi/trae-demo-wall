<view class="channel-selector">
  <view class="channel-list">
    <view 
      wx:for="{{channels}}" 
      wx:key="id"
      class="channel-item {{value === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <text class="channel-name">{{item.name}}</text>
    </view>
  </view>
</view>
