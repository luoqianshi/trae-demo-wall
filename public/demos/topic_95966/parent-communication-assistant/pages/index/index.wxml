<view class="container">
  <!-- 欢迎卡片 -->
  <view class="welcome-card">
    <view class="welcome-content">
      <text class="welcome-title">家长沟通助手</text>
      <text class="welcome-desc">快速生成专业得体的家长沟通话术</text>
    </view>
    <view class="welcome-btn" bindtap="onNavigateToGenerate">
      <text>立即生成</text>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{todayCount}}</text>
      <text class="stat-label">今日生成</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">累计生成</text>
    </view>
  </view>

  <!-- 快捷功能 -->
  <view class="card">
    <text class="card-title">快捷功能</text>
    <view class="quick-actions">
      <view 
        wx:for="{{quickActions}}" 
        wx:key="id"
        class="quick-action-item"
        data-id="{{item.id}}"
        bindtap="onQuickAction"
      >
        <view class="quick-icon" style="background: {{item.color}}20; color: {{item.color}};">
          <text>{{item.icon}}</text>
        </view>
        <text class="quick-name">{{item.name}}</text>
        <text class="quick-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="card" wx:if="{{recentHistory.length > 0}}">
    <view class="flex-between">
      <text class="card-title">最近生成</text>
      <text class="text-primary" style="font-size: 26rpx;" bindtap="onQuickAction" data-id="history">查看全部</text>
    </view>
    <view class="recent-list">
      <view 
        wx:for="{{recentHistory}}" 
        wx:key="id"
        class="recent-item"
        data-id="{{item.id}}"
        bindtap="onHistoryItemTap"
      >
        <view class="recent-info">
          <text class="recent-name">{{item.studentName}}</text>
          <text class="recent-scene">{{item.sceneName}}</text>
        </view>
        <text class="recent-time">{{item.timeStr}}</text>
      </view>
    </view>
  </view>

  <!-- 内容弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal">
    <view class="modal-box" catchtap="">
      <view class="modal-header">
        <view class="modal-title-row">
          <text class="modal-student-name">{{selectedItem.studentName}}</text>
          <text class="modal-scene-tag">{{selectedItem.sceneName}}</text>
        </view>
        <text class="modal-close" bindtap="onCloseModal">✕</text>
      </view>
      <scroll-view scroll-y class="modal-body">
        <text class="modal-content-text">{{selectedItem.content}}</text>
      </scroll-view>
      <view class="modal-footer">
        <button class="btn-primary" bindtap="onCopyContent" style="flex:1;">复制内容</button>
      </view>
    </view>
  </view>
</view>
