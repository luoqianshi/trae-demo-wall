.welcome-card {
  background: linear-gradient(135deg, #5B6CF0 0%, #7C5CFC 50%, #9F7AEA 100%);
  border-radius: var(--radius-xl);
  padding: 52rpx 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(91, 108, 240, 0.25);
}

.welcome-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.welcome-card::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  right: 60rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.welcome-content {
  position: relative;
  z-index: 1;
}

.welcome-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.welcome-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  display: block;
  letter-spacing: 0.5rpx;
}

.welcome-btn {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: var(--radius-md);
  padding: 18rpx 36rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stats-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--primary);
  display: block;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 10rpx;
  display: block;
  letter-spacing: 0.3rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: linear-gradient(to bottom, transparent, var(--border-medium), transparent);
  border-radius: 1rpx;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
}

.quick-action-item {
  flex: 1;
  background: var(--bg-input);
  border-radius: var(--radius-lg);
  padding: 32rpx 16rpx;
  text-align: center;
  border: 1rpx solid var(--border-light);
  transition: all 0.3s ease;
}

.quick-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin: 0 auto 14rpx;
  box-shadow: var(--shadow-sm);
}

.quick-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.3rpx;
}

.quick-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
}

.recent-list {
  margin-top: 16rpx;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recent-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.recent-scene {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.recent-time {
  font-size: 24rpx;
  color: var(--text-quaternary);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 29, 38, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 85%;
  max-height: 70vh;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 36rpx 0;
}

.modal-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.modal-student-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-scene-tag {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-tertiary);
  padding: 8rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-input);
}

.modal-body {
  flex: 1;
  min-height: 0;
  padding: 28rpx 36rpx;
  max-height: 50vh;
}

.modal-content-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-footer {
  padding: 20rpx 36rpx 36rpx;
}
