.generate-container {
  padding: 16rpx 24rpx 24rpx;
}

.compact-card {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.compact-title {
  margin-bottom: 14rpx;
  font-size: 26rpx;
}

.compact-input {
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  min-height: 72rpx;
}

.compact-textarea {
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  min-height: 120rpx;
}

.preference-row {
  display: flex;
  gap: 28rpx;
}

.preference-col {
  flex: 1;
}

.pref-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

.pref-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pref-option {
  padding: 10rpx 18rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  font-weight: 500;
}

.pref-option.active {
  background: var(--primary-bg);
  color: var(--primary);
  border-color: rgba(91, 108, 240, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(91, 108, 240, 0.08);
}

.generate-btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-lg);
  letter-spacing: 2rpx;
}
