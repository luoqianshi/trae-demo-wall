<view class="container generate-container">
  <!-- 沟通场景 -->
  <view class="card compact-card">
    <text class="section-title compact-title">沟通场景</text>
    <scene-selector value="{{scene}}" bindchange="onSceneChange" />
  </view>

  <!-- 学生信息 -->
  <view class="card compact-card">
    <view class="form-row">
      <view class="form-col">
        <text class="section-title compact-title">学生姓名 <text class="required">*</text></text>
        <input 
          class="input-field compact-input" 
          placeholder="请输入姓名"
          value="{{studentName}}"
          bindinput="onStudentNameInput"
          maxlength="20"
        />
      </view>
    </view>
    <view class="form-row m-t-16">
      <text class="section-title compact-title">表现描述（选填）</text>
      <textarea 
        class="textarea-field compact-textarea" 
        placeholder="如：本次考试成绩85分，较上次进步10分..."
        value="{{description}}"
        bindinput="onDescriptionInput"
        maxlength="500"
      />
    </view>
  </view>

  <!-- 输出偏好 -->
  <view class="card compact-card">
    <text class="section-title compact-title">输出偏好</text>
    <view class="preference-row">
      <view class="preference-col">
        <text class="pref-label">风格</text>
        <view class="pref-options">
          <view 
            wx:for="{{styles}}"
            wx:key="id"
            class="pref-option {{style === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onStyleTap"
          >{{item.name}}</view>
        </view>
      </view>
      <view class="preference-col">
        <text class="pref-label">渠道</text>
        <view class="pref-options">
          <view 
            wx:for="{{channels}}"
            wx:key="id"
            class="pref-option {{channel === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onChannelTap"
          >{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <button 
    class="btn-primary generate-btn" 
    bindtap="onGenerate"
    loading="{{isGenerating}}"
    disabled="{{isGenerating || !studentName}}"
  >
    {{isGenerating ? '生成中...' : '生成话术'}}
  </button>

  <!-- 生成结果 -->
  <view class="card compact-card" wx:if="{{generatedContent}}">
    <message-preview 
      content="{{generatedContent}}"
      isFallback="{{isFallback}}"
      bindregenerate="onRegenerate"
      bindedit="onEdit"
    />
  </view>
</view>
