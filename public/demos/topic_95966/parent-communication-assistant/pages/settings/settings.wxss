.form-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 14rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

.form-input {
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: var(--primary);
  background: var(--bg-card);
  box-shadow: 0 0 0 4rpx rgba(91, 108, 240, 0.08);
}

.form-picker {
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-picker .placeholder {
  color: var(--text-tertiary);
}

.arrow {
  color: var(--text-quaternary);
  font-size: 28rpx;
}

.style-options,
.channel-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-option,
.channel-option {
  padding: 14rpx 28rpx;
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  font-weight: 500;
}

.style-option.active,
.channel-option.active {
  background: var(--primary-bg);
  color: var(--primary);
  border-color: rgba(91, 108, 240, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(91, 108, 240, 0.08);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  transition: all 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.apikey-status {
  margin-bottom: 18rpx;
  padding: 18rpx 0;
}

.apikey-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 10rpx;
}

.apikey-value {
  font-size: 28rpx;
  color: var(--primary);
  font-family: 'SF Mono', Menlo, monospace;
  background: var(--primary-bg);
  padding: 10rpx 18rpx;
  border-radius: var(--radius-sm);
  display: inline-block;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.privacy-tip {
  text-align: center;
  padding: 28rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  letter-spacing: 0.3rpx;
}
