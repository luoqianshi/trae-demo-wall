<view class="container">
  <!-- 教师信息 -->
  <view class="card">
    <text class="card-title">教师信息</text>
    
    <view class="form-item">
      <text class="form-label">教师姓名</text>
      <input 
        class="form-input"
        placeholder="请输入您的姓名"
        value="{{settings.teacherName}}"
        bindinput="onTeacherNameInput"
      />
    </view>
    
    <view class="form-item">
      <text class="form-label">任教科目</text>
      <picker mode="selector" range="{{subjects}}" bindchange="onSubjectChange">
        <view class="form-picker">
          <text wx:if="{{settings.subject}}">{{settings.subject}}</text>
          <text wx:else class="placeholder">请选择任教科目</text>
          <text class="arrow">></text>
        </view>
      </picker>
    </view>
    
    <view class="form-item">
      <text class="form-label">任教年级</text>
      <picker mode="selector" range="{{grades}}" bindchange="onGradeChange">
        <view class="form-picker">
          <text wx:if="{{settings.grade}}">{{settings.grade}}</text>
          <text wx:else class="placeholder">请选择任教年级</text>
          <text class="arrow">></text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 默认偏好 -->
  <view class="card">
    <text class="card-title">默认偏好</text>
    
    <view class="form-item">
      <text class="form-label">默认输出风格</text>
      <view class="style-options">
        <view 
          wx:for="{{styles}}"
          wx:key="id"
          class="style-option {{settings.defaultStyle === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onStyleChange"
        >
          {{item.name}}
        </view>
      </view>
    </view>
    
    <view class="form-item">
      <text class="form-label">默认发送渠道</text>
      <view class="channel-options">
        <view 
          wx:for="{{channels}}"
          wx:key="id"
          class="channel-option {{settings.defaultChannel === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onChannelChange"
        >
          {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <!-- DeepSeek API Key -->
  <view class="card">
    <text class="card-title">DeepSeek API Key</text>
    
    <view class="apikey-status" wx:if="{{hasApiKey}}">
      <text class="apikey-label">当前已配置</text>
      <text class="apikey-value">{{apiKeyMasked}}</text>
    </view>
    <view class="apikey-status" wx:else>
      <text class="apikey-label">未配置 API Key，话术生成将使用本地模板</text>
    </view>
    
    <view class="form-item" style="border-bottom: none;">
      <input 
        class="form-input"
        placeholder="输入 DeepSeek API Key"
        value="{{apiKey}}"
        bindinput="onApiKeyInput"
        password
      />
    </view>
    
    <view class="action-group">
      <button class="btn-primary" style="flex: 1;" bindtap="onSaveApiKey">保存 Key</button>
      <button wx:if="{{hasApiKey}}" class="btn-secondary" style="flex: 1;" bindtap="onClearApiKey">清除 Key</button>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="card">
    <text class="card-title">数据管理</text>
    
    <view class="menu-item" bindtap="onExportHistory">
      <text class="menu-label">导出沟通记录</text>
      <text class="arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="onClearHistory">
      <text class="menu-label text-danger">清空历史记录</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-label">关于</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <button class="btn-primary m-b-24" bindtap="onSave">保存设置</button>

  <!-- 隐私提示 -->
  <view class="privacy-tip">
    <text>所有数据仅存储在本地设备中，不会上传至服务器。卸载小程序或清除缓存将导致数据丢失。</text>
  </view>
</view>
