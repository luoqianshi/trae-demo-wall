/* 搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  transition: all 0.3s ease;
}

.search-input:focus {
  border-color: var(--primary);
  box-shadow: var(--shadow-md), 0 0 0 4rpx rgba(91, 108, 240, 0.08);
}

/* 筛选区域 */
.filter-section {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  overflow: hidden;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 30rpx;
}

.filter-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.3rpx;
}

.filter-badge {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.filter-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-clear {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.filter-arrow {
  font-size: 22rpx;
  color: var(--text-quaternary);
  transition: transform 0.3s;
}

.filter-arrow.expanded {
  transform: rotate(180deg);
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  padding: 0 30rpx 26rpx;
  gap: 14rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-input);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.filter-tag.active {
  background: var(--primary-bg);
  color: var(--primary);
  border-color: rgba(91, 108, 240, 0.25);
  box-shadow: 0 2rpx 8rpx rgba(91, 108, 240, 0.08);
}

.filter-tag-text {
  font-size: 24rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.result-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.action-btns {
  display: flex;
  gap: 28rpx;
}

.action-text {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

/* 隐私提示 */
.privacy-tip {
  background: linear-gradient(135deg, #FFFBF0 0%, #FFF8E8 100%);
  border-radius: var(--radius-sm);
  padding: 14rpx 22rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.15);
}

.privacy-text {
  font-size: 24rpx;
  color: var(--warning);
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  transition: all 0.2s ease;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.history-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.history-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.3rpx;
}

.history-scene {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.history-time {
  font-size: 24rpx;
  color: var(--text-quaternary);
  flex-shrink: 0;
}

.history-content-wrap {
  margin-bottom: 18rpx;
}

.history-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  display: block;
}

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-meta {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.history-style-tag,
.history-channel-tag {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: var(--bg-input);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.history-fallback {
  font-size: 22rpx;
  color: var(--warning);
  background: #FFF8E8;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
}

.history-actions {
  display: flex;
  gap: 20rpx;
}

.history-action-btn {
  font-size: 24rpx;
  color: var(--primary);
  padding: 4rpx 8rpx;
  font-weight: 500;
}

.history-action-btn.danger {
  color: var(--danger);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 29, 38, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-box {
  width: 88%;
  max-height: 75vh;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 36rpx 0;
}

.detail-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-student-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.detail-scene-tag {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.detail-close {
  font-size: 36rpx;
  color: var(--text-tertiary);
  padding: 8rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-input);
}

.detail-meta-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  padding: 14rpx 36rpx 0;
}

.detail-time {
  font-size: 24rpx;
  color: var(--text-quaternary);
}

.detail-style-tag,
.detail-channel-tag {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: var(--bg-input);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.detail-body {
  flex: 1;
  min-height: 0;
  padding: 28rpx 36rpx;
  max-height: 50vh;
}

.detail-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-footer {
  padding: 20rpx 36rpx 36rpx;
  display: flex;
  gap: 16rpx;
}
