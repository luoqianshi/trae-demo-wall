<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input 
      class="search-input"
      placeholder="搜索学生姓名..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <!-- 场景筛选（多选） -->
  <view class="filter-section">
    <view class="filter-header" bindtap="onToggleFilterPanel">
      <view class="filter-header-left">
        <text class="filter-title">场景筛选</text>
        <text class="filter-badge" wx:if="{{selectedScenes.length > 0}}">{{selectedScenes.length}}项</text>
      </view>
      <view class="filter-header-right">
        <text class="filter-clear" wx:if="{{selectedScenes.length > 0}}" catchtap="onClearFilter">清除</text>
        <text class="filter-arrow {{showFilterPanel ? 'expanded' : ''}}">v</text>
      </view>
    </view>
    
    <view class="filter-tags" wx:if="{{showFilterPanel}}">
      <view 
        wx:for="{{sceneOptions}}"
        wx:key="id"
        class="filter-tag {{selectedScenes.indexOf(item.id) >= 0 ? 'active' : ''}}"
        data-scene="{{item.id}}"
        bindtap="onSceneFilter"
      >
        <text>{{item.icon}}</text>
        <text class="filter-tag-text">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar" wx:if="{{filteredHistory.length > 0}}">
    <text class="result-count">共 {{filteredHistory.length}} 条记录</text>
    <view class="action-btns">
      <text class="action-text" bindtap="onExport">导出</text>
      <text class="action-text text-danger" bindtap="onClearAll">清空</text>
    </view>
  </view>

  <!-- 隐私提示 -->
  <view class="privacy-tip">
    <text class="privacy-text">数据仅存储在本地，卸载小程序或清除缓存将丢失</text>
  </view>

  <!-- 历史列表 -->
  <view class="history-list" wx:if="{{filteredHistory.length > 0}}">
    <view 
      wx:for="{{filteredHistory}}" 
      wx:key="id"
      class="history-item"
    >
      <!-- 头部：姓名、场景、时间 -->
      <view class="history-header" data-id="{{item.id}}" bindtap="onItemTap">
        <view class="history-info">
          <text class="history-name">{{item.studentName}}</text>
          <text class="history-scene">{{item.sceneName}}</text>
        </view>
        <text class="history-time">{{item.timeStr}}</text>
      </view>
      
      <!-- 内容预览 -->
      <view class="history-content-wrap" data-id="{{item.id}}" bindtap="onItemTap">
        <text class="history-content">{{item.content.substring(0, 100)}}{{item.content.length > 100 ? '...' : ''}}</text>
      </view>
      
      <!-- 底部：标签和操作 -->
      <view class="history-footer">
        <view class="history-meta">
          <text class="history-style-tag">{{item.styleName}}</text>
          <text class="history-channel-tag">{{item.channelName}}</text>
          <text wx:if="{{item.isFallback}}" class="history-fallback">本地模板</text>
        </view>
        <view class="history-actions">
          <text class="history-action-btn" data-id="{{item.id}}" bindtap="onCopyFromList">复制</text>
          <text class="history-action-btn" data-id="{{item.id}}" bindtap="onRegenerateFromList">再次生成</text>
          <text class="history-action-btn danger" data-id="{{item.id}}" bindtap="deleteItem">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无历史记录</text>
    <text class="empty-desc" wx:if="{{selectedScenes.length > 0}}">当前筛选条件下无匹配记录，试试清除筛选</text>
    <text class="empty-desc" wx:else>生成的话术将自动保存到这里</text>
  </view>

  <!-- 内容详情弹窗 -->
  <view class="detail-mask" wx:if="{{showDetailModal}}" bindtap="onCloseDetailModal">
    <view class="detail-box" catchtap="">
      <view class="detail-header">
        <view class="detail-title-row">
          <text class="detail-student-name">{{selectedItem.studentName}}</text>
          <text class="detail-scene-tag">{{selectedItem.sceneName}}</text>
        </view>
        <text class="detail-close" bindtap="onCloseDetailModal">✕</text>
      </view>
      <view class="detail-meta-row">
        <text class="detail-time">{{selectedItem.timeStr}}</text>
        <text class="detail-style-tag">{{selectedItem.styleName}}</text>
        <text class="detail-channel-tag">{{selectedItem.channelName}}</text>
      </view>
      <scroll-view scroll-y class="detail-body">
        <text class="detail-content">{{selectedItem.content}}</text>
      </scroll-view>
      <view class="detail-footer">
        <button class="btn-secondary" style="flex:1;" bindtap="onRegenerateFromDetail">再次生成</button>
        <button class="btn-primary" style="flex:1;" bindtap="onCopyContent">复制内容</button>
      </view>
    </view>
  </view>
</view>
