page {
  background-color: #F0F2F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #1A1D26;
  --primary: #5B6CF0;
  --primary-light: #818CF8;
  --primary-dark: #4F5BD5;
  --primary-bg: #EEF0FE;
  --primary-bg-light: #F5F6FF;
  --accent: #7C5CFC;
  --success: #34D399;
  --warning: #FBBF24;
  --danger: #F56565;
  --text-primary: #1A1D26;
  --text-secondary: #6B7280;
  --text-tertiary: #9CA3AF;
  --text-quaternary: #D1D5DB;
  --bg-card: #FFFFFF;
  --bg-input: #F7F8FA;
  --bg-hover: #F9FAFB;
  --border-light: #F0F1F3;
  --border-medium: #E5E7EB;
  --shadow-sm: 0 1rpx 3rpx rgba(0, 0, 0, 0.02), 0 1rpx 2rpx rgba(0, 0, 0, 0.03);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.03), 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.04), 0 4rpx 8rpx rgba(0, 0, 0, 0.02);
  --shadow-glow: 0 4rpx 16rpx rgba(91, 108, 240, 0.12);
  --radius-sm: 10rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
}

.container {
  padding: 20rpx 24rpx;
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: 0.3rpx;
}

.section-title .required {
  color: var(--danger);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-glow);
  letter-spacing: 1rpx;
  position: relative;
  overflow: hidden;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: linear-gradient(135deg, #B4BFD6 0%, #C4BBE0 100%);
  color: #FFFFFF;
  box-shadow: none;
}

.btn-secondary {
  background: var(--primary-bg-light);
  color: var(--primary);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border: 1rpx solid rgba(91, 108, 240, 0.15);
}

.btn-secondary::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  background: var(--bg-input);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.tag.active {
  background: var(--primary-bg);
  color: var(--primary);
  border-color: rgba(91, 108, 240, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(91, 108, 240, 0.08);
}

.input-field {
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-field:focus {
  border-color: var(--primary);
  background: var(--bg-card);
  box-shadow: 0 0 0 4rpx rgba(91, 108, 240, 0.08);
}

.textarea-field {
  background: var(--bg-input);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.textarea-field:focus {
  border-color: var(--primary);
  background: var(--bg-card);
  box-shadow: 0 0 0 4rpx rgba(91, 108, 240, 0.08);
}

.message-preview-box {
  background: linear-gradient(135deg, var(--primary-bg-light) 0%, #FAFBFF 100%);
  border-radius: var(--radius-md);
  padding: 32rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-primary);
  min-height: 200rpx;
  white-space: pre-wrap;
  word-break: break-all;
  border: 1rpx solid rgba(91, 108, 240, 0.08);
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.text-danger {
  color: var(--danger);
}

.m-t-16 {
  margin-top: 16rpx;
}

.m-t-24 {
  margin-top: 24rpx;
}

.m-b-16 {
  margin-bottom: 16rpx;
}

.m-b-24 {
  margin-bottom: 24rpx;
}

.p-t-16 {
  padding-top: 16rpx;
}

/* 列表项样式 */
.list-item {
  background: var(--bg-card);
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

/* 操作按钮组 */
.action-group {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-group button {
  flex: 1;
  font-size: 26rpx;
}
