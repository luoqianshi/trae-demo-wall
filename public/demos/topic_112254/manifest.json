{
  "manifest_version": 3,
  "name": "杀死那个撒谎者",
  "version": "1.0.0",
  "description": "AI引用两阶段验真工具 · 让虚假引用无处遁形",
  "permissions": ["storage"],
  "host_permissions": ["https://api.crossref.org/*", "https://api.semanticscholar.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "杀死那个撒谎者"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
