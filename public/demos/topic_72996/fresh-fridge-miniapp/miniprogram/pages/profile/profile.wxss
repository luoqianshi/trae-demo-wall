.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.profile-header {
  position: relative;
  padding-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.avatar-section {
  position: relative;
  display: flex;
  align-items: center;
  padding: 80rpx 32rpx 0;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.user-region {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
  display: block;
}

.edit-btn {
  background-color: rgba(255, 255, 255, 0.25);
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
}

.edit-btn text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.taste-board {
  margin: -20rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
  padding: 32rpx;
}

.board-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.board-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.board-setting {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #FF6B35;
}

.board-setting .arrow {
  font-size: 28rpx;
  margin-left: 4rpx;
}

.board-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.board-stat-item {
  text-align: center;
  flex: 1;
}

.board-stat-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF6F00;
  display: block;
}

.board-stat-value.warning {
  color: #F44336;
}

.board-stat-label {
  font-size: 24rpx;
  color: #FF8F00;
  margin-top: 6rpx;
  display: block;
}

.board-tags-section,
.board-categories {
  margin-bottom: 20rpx;
}

.board-categories {
  margin-bottom: 0;
}

.tags-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.taste-tag {
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #FFE0B2 0%, #FFCC80 100%);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #E65100;
  font-weight: 500;
}

.no-tags {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.category-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.category-name {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.category-count {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF6B35;
}

.menu-section {
  padding: 0 24rpx;
}

.menu-card {
  margin-bottom: 20rpx;
  padding: 0;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}

.menu-badge {
  background-color: #F44336;
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  min-width: 32rpx;
  text-align: center;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  background-color: #fff;
  padding: 28rpx;
  border-radius: 20rpx;
  text-align: center;
}

.logout-btn text {
  font-size: 30rpx;
  color: #F44336;
  font-weight: 500;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
