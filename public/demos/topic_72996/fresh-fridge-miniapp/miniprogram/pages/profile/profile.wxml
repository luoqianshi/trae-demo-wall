<view class="container">
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="avatar-section">
      <image class="avatar" src="{{userInfo && userInfo.avatarUrl || 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=cute%20food%20avatar%20cartoon%20style&image_size=square'}}"></image>
      <view class="user-info">
        <text class="user-name">{{userInfo && userInfo.nickName || '美食达人'}}</text>
        <text class="user-region">📍 {{userPreferences && userPreferences.hometown || '未设置家乡'}}</text>
      </view>
      <view class="edit-btn" bindtap="onEditProfile">
        <text>编辑</text>
      </view>
    </view>
  </view>

  <view class="taste-board card">
    <view class="board-header">
      <text class="board-title">📊 个人口味看板</text>
      <view class="board-setting" bindtap="onGoPreferences">
        <text>设置</text>
        <text class="arrow">›</text>
      </view>
    </view>
    
    <view class="board-stats">
      <view class="board-stat-item">
        <text class="board-stat-value">{{tasteBoard.monthPurchased}}</text>
        <text class="board-stat-label">本月购入</text>
      </view>
      <view class="board-stat-item">
        <text class="board-stat-value warning">{{tasteBoard.expiredWaste}}</text>
        <text class="board-stat-label">过期浪费</text>
      </view>
      <view class="board-stat-item">
        <text class="board-stat-value">{{tasteBoard.favoriteTags.length}}</text>
        <text class="board-stat-label">爱吃标签</text>
      </view>
    </view>

    <view class="board-tags-section">
      <text class="tags-title">🏷️ 爱吃标签</text>
      <view class="tags-list">
        <block wx:for="{{tasteBoard.favoriteTags}}" wx:key="*this">
          <view class="taste-tag">{{item}}</view>
        </block>
        <view wx:if="{{tasteBoard.favoriteTags.length === 0}}" class="no-tags">
          <text>暂无标签，去设置口味偏好吧~</text>
        </view>
      </view>
    </view>

    <view class="board-categories">
      <text class="tags-title">🥘 本月分类</text>
      <view class="category-list">
        <block wx:for="{{tasteBoard.categories}}" wx:key="name">
          <view class="category-item">
            <text class="category-icon">{{item.icon}}</text>
            <text class="category-name">{{item.name}}</text>
            <text class="category-count">{{item.count}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card card">
      <view class="menu-item" bindtap="onGoPreferences">
        <text class="menu-icon">🍽️</text>
        <text class="menu-name">我的口味偏好</text>
        <text class="menu-desc">{{userPreferences && userPreferences.hometown || '未设置'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-id="fridge">
        <text class="menu-icon">🧊</text>
        <text class="menu-name">我的冰箱</text>
        <text class="menu-desc">{{stats.fridgeCount}}件食材</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-id="votes">
        <text class="menu-icon">🗳️</text>
        <text class="menu-name">我的投票</text>
        <text class="menu-desc">{{stats.voteCount}}次参与</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-card card">
      <view class="menu-item" bindtap="onMenuTap" data-id="messages">
        <text class="menu-icon">🔔</text>
        <text class="menu-name">消息通知</text>
        <view wx:if="{{menuItems[3].badge > 0}}" class="menu-badge">
          <text>{{menuItems[3].badge}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-id="settings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-name">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-id="help">
        <text class="menu-icon">❓</text>
        <text class="menu-name">帮助中心</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="logout-section">
    <view class="logout-btn" bindtap="onLogout">
      <text>退出登录</text>
    </view>
  </view>
</view>
