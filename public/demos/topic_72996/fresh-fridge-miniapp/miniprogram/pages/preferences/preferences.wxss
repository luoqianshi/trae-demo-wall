.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.section-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}

.region-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.region-value {
  font-size: 30rpx;
  color: #333;
}

.region-value.placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.category-item.selected {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-color: #FF6B35;
}

.cat-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 24rpx;
  color: #666;
}

.category-item.selected .cat-name {
  color: #FF6B35;
  font-weight: 600;
}

.cat-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.taste-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.taste-item {
  flex: 0 0 calc(33.33% - 11rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #f8f8f8;
  border-radius: 20rpx;
  border: 3rpx solid #e0e0e0;
  transition: all 0.3s;
}

.taste-item.selected {
  background: #fff;
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.taste-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.taste-name {
  font-size: 26rpx;
  color: #666;
}

.taste-item.selected .taste-name {
  font-weight: 600;
  color: #333;
}

.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  padding: 28rpx;
  background: #e0e0e0;
  border-radius: 30rpx;
  text-align: center;
  transition: all 0.3s;
}

.save-btn.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.save-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.save-btn:not(.active) text {
  color: #999;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel {
  font-size: 28rpx;
  color: #999;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.picker-confirm {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
}

.picker-view {
  height: 480rpx;
}

.picker-item {
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}
