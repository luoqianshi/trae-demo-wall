<view class="container">
  <view class="section card">
    <view class="section-header">
      <text class="section-icon">🏠</text>
      <text class="section-title">家乡地区</text>
    </view>
    <view class="region-picker" bindtap="onShowRegionPicker">
      <text class="region-value {{hometown ? '' : 'placeholder'}}">{{hometown || '请选择家乡地区'}}</text>
      <text class="picker-arrow">›</text>
    </view>
    <text class="section-tip">选择家乡地区，推荐当地特色美食</text>
  </view>

  <view class="section card">
    <view class="section-header">
      <text class="section-icon">🍽️</text>
      <text class="section-title">爱吃品类</text>
    </view>
    <view class="category-grid">
      <block wx:for="{{categories}}" wx:key="id">
        <view class="category-item {{selectedCategories.indexOf(item.id) > -1 ? 'selected' : ''}}" 
              bindtap="onToggleCategory" data-id="{{item.id}}">
          <text class="cat-icon">{{item.icon}}</text>
          <text class="cat-name">{{item.name}}</text>
          <view wx:if="{{selectedCategories.indexOf(item.id) > -1}}" class="cat-check">✓</view>
        </view>
      </block>
    </view>
    <text class="section-tip">选择你爱吃的品类，最多选5个</text>
  </view>

  <view class="section card">
    <view class="section-header">
      <text class="section-icon">👅</text>
      <text class="section-title">口味偏好</text>
    </view>
    <view class="taste-grid">
      <block wx:for="{{tastes}}" wx:key="id">
        <view class="taste-item {{selectedTastes.indexOf(item.id) > -1 ? 'selected' : ''}}" 
              bindtap="onToggleTaste" data-id="{{item.id}}"
              style="border-color: {{selectedTastes.indexOf(item.id) > -1 ? item.color : '#e0e0e0'}}">
          <text class="taste-emoji">{{item.emoji}}</text>
          <text class="taste-name">{{item.name}}</text>
        </view>
      </block>
    </view>
    <text class="section-tip">选择你喜欢的口味，最多选3个</text>
  </view>

  <view class="save-section">
    <view class="save-btn {{canSave ? 'active' : ''}}" bindtap="onSave">
      <text>保存设置</text>
    </view>
  </view>
</view>

<view wx:if="{{showRegionPicker}}" class="picker-modal" bindtap="onHideRegionPicker">
  <view class="picker-content" catchtap="stopPropagation">
    <view class="picker-header">
      <text class="picker-cancel" bindtap="onHideRegionPicker">取消</text>
      <text class="picker-title">选择地区</text>
      <text class="picker-confirm" bindtap="onConfirmRegion">确定</text>
    </view>
    <picker-view class="picker-view" indicator-style="height: 80rpx;" value="{{regionValue}}" bindchange="onRegionChange">
      <picker-view-column>
        <view wx:for="{{provinces}}" wx:key="code" class="picker-item">{{item.name}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{cities}}" wx:key="code" class="picker-item">{{item.name}}</view>
      </picker-view-column>
    </picker-view>
  </view>
</view>
