<view class="food-manage-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索美食名称"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" class="clear-icon" bindtap="onClearKeyword">✕</text>
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-bar" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
    <block wx:for="{{categories}}" wx:key="id">
      <view class="cat-item {{activeCategory === item.id ? 'active' : ''}}" bindtap="onCategoryChange" data-id="{{item.id}}">
        <text class="cat-name">{{item.name}}</text>
      </view>
    </block>
  </scroll-view>

  <!-- 美食列表 -->
  <view class="food-list" wx:if="{{list.length > 0}}">
    <block wx:for="{{list}}" wx:key="_id">
      <view class="food-card">
        <view class="card-top">
          <image class="food-image" mode="aspectFill" src="{{item.images[0] || ''}}" />
          <view class="food-info">
            <view class="info-header">
              <text class="food-name">{{item.name}}</text>
              <view wx:if="{{item.isOfficial}}" class="official-tag">
                <text>官方</text>
              </view>
            </view>
            <text class="food-origin" wx:if="{{item.origin}}">📍 {{item.origin}}</text>
            <view class="food-meta">
              <text class="meta-text">{{item.priceMin}}-{{item.priceMax}}{{item.priceUnit}}</text>
              <view wx:if="{{item.canMail}}" class="mail-tag">
                <text>可邮寄</text>
              </view>
            </view>
            <view class="food-stats">
              <text class="stat-item">🔥 {{item.hotScore || 0}}</text>
              <text class="stat-item">👍 {{item.voteCount || 0}}</text>
              <text class="stat-item">❤️ {{item.favoriteCount || 0}}</text>
            </view>
          </view>
        </view>

        <view class="card-actions">
          <view class="action-btn pin" bindtap="onPin" data-item="{{item}}">
            <text>📌 置顶</text>
          </view>
          <view class="action-btn edit" bindtap="onShowEdit" data-item="{{item}}">
            <text>✏️ 编辑</text>
          </view>
          <view class="action-btn delete" bindtap="onDelete" data-item="{{item}}">
            <text>🗑 删除</text>
          </view>
        </view>
      </view>
    </block>

    <view class="load-more" wx:if="{{loadingMore}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore}}">
      <text>— 已经到底啦 —</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="state-wrap" wx:if="{{loading && list.length === 0}}">
    <text class="state-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="state-wrap" wx:if="{{isEmpty && !loading}}">
    <text class="state-icon">🍽️</text>
    <text class="state-title">暂无美食数据</text>
    <text class="state-text">点击右下角按钮新增美食</text>
  </view>

  <!-- 新增按钮 -->
  <view class="float-btn" bindtap="onShowCreate">
    <text class="float-icon">+</text>
    <text class="float-text">新增</text>
  </view>
</view>

<!-- 编辑/新增弹窗 -->
<view wx:if="{{showEdit}}" class="modal-mask" bindtap="onCloseEdit">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">{{editMode === 'create' ? '新增美食' : '编辑美食'}}</text>
      <text class="modal-close" bindtap="onCloseEdit">✕</text>
    </view>

    <scroll-view class="modal-body" scroll-y="true">
      <!-- 图片上传 -->
      <view class="form-section">
        <text class="form-label">美食图片</text>
        <view class="image-grid">
          <block wx:for="{{formData.images}}" wx:key="*this">
            <view class="image-item">
              <image class="upload-image" mode="aspectFill" src="{{item}}" data-index="{{index}}" bindtap="onPreviewFormImage" />
              <view class="image-delete" data-index="{{index}}" bindtap="onDeleteFormImage">✕</view>
            </view>
          </block>
          <view wx:if="{{formData.images.length < 9}}" class="image-add" bindtap="onChooseImage">
            <text class="add-icon">+</text>
            <text class="add-text">上传</text>
          </view>
        </view>
      </view>

      <!-- 名称 -->
      <view class="form-section">
        <text class="form-label">美食名称 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入美食名称" value="{{formData.name}}" data-field="name" bindinput="onFormInput" />
      </view>

      <!-- 品类 -->
      <view class="form-section">
        <text class="form-label">品类</text>
        <picker mode="selector" range="{{categories}}" range-key="name" value="{{editingCategoryIndex}}" bindchange="onCategoryPickerChange">
          <view class="form-picker">
            <text class="picker-text">{{categories[editingCategoryIndex].name}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <!-- 产地 -->
      <view class="form-section">
        <text class="form-label">产地</text>
        <input class="form-input" placeholder="请输入产地" value="{{formData.origin}}" data-field="origin" bindinput="onFormInput" />
      </view>

      <!-- 简介 -->
      <view class="form-section">
        <text class="form-label">简介</text>
        <textarea class="form-textarea" placeholder="请输入简介" maxlength="200" value="{{formData.description}}" data-field="description" bindinput="onFormInput" />
      </view>

      <!-- 价格 -->
      <view class="form-section">
        <text class="form-label">参考价格</text>
        <view class="price-row">
          <input class="form-input price-input" type="digit" placeholder="最低价" value="{{formData.priceMin}}" data-field="priceMin" bindinput="onFormInput" />
          <text class="price-sep">-</text>
          <input class="form-input price-input" type="digit" placeholder="最高价" value="{{formData.priceMax}}" data-field="priceMax" bindinput="onFormInput" />
          <input class="form-input unit-input" placeholder="单位" value="{{formData.priceUnit}}" data-field="priceUnit" bindinput="onFormInput" />
        </view>
      </view>

      <!-- 可邮寄 -->
      <view class="form-section switch-row">
        <text class="form-label">可邮寄</text>
        <switch checked="{{formData.canMail}}" bindchange="onCanMailChange" color="#FF6B35" />
      </view>
    </scroll-view>

    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="onCloseEdit">取消</view>
      <view class="modal-btn confirm" bindtap="onSaveFood">保存</view>
    </view>
  </view>
</view>
