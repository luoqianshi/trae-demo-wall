<view class="dashboard-page">
  <!-- 头部 -->
  <view class="dash-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">数据看板</text>
      <text class="header-sub">食鲜冰箱运营概览</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-wrap">
    <text class="state-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 核心数据卡片 -->
    <view class="section">
      <view class="section-title">核心数据</view>
      <view class="core-grid">
        <view class="core-card">
          <text class="core-value">{{core.totalUsers}}</text>
          <text class="core-label">总用户数</text>
        </view>
        <view class="core-card">
          <text class="core-value highlight">{{core.todayNewUsers}}</text>
          <text class="core-label">今日新增</text>
        </view>
        <view class="core-card">
          <text class="core-value">{{core.totalSubmissions}}</text>
          <text class="core-label">总投稿量</text>
        </view>
        <view class="core-card" bindtap="onGoAudit">
          <text class="core-value danger">{{core.pendingSubmissions}}</text>
          <text class="core-label">待审核数</text>
        </view>
      </view>
    </view>

    <!-- 冰箱使用数据 -->
    <view class="section">
      <view class="section-title">冰箱使用数据</view>
      <view class="fridge-card">
        <view class="fridge-row">
          <view class="fridge-cell">
            <text class="fridge-value">{{fridge.avgFridgePerUser}}</text>
            <text class="fridge-label">人均囤货数</text>
          </view>
          <view class="fridge-divider"></view>
          <view class="fridge-cell">
            <text class="fridge-value {{fridge.expiryRate > 30 ? 'danger' : ''}}">{{fridge.expiryRate}}%</text>
            <text class="fridge-label">过期率</text>
          </view>
          <view class="fridge-divider"></view>
          <view class="fridge-cell">
            <text class="fridge-value">{{fridge.expiredFridge}}</text>
            <text class="fridge-label">过期件数</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 投稿量趋势 -->
    <view class="section">
      <view class="section-title">投稿量趋势（近7天）</view>
      <view class="trend-card">
        <view class="trend-chart">
          <block wx:for="{{submissionTrend}}" wx:key="date">
            <view class="trend-bar-wrap">
              <view class="trend-bar-container">
                <view class="trend-bar" style="height: {{trendMax > 0 ? (item.count / trendMax * 100) : 0}}%;">
                  <text class="trend-num" wx:if="{{item.count > 0}}">{{item.count}}</text>
                </view>
              </view>
              <text class="trend-date">{{item.date}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- 提醒打开率 -->
    <view class="section">
      <view class="section-title">提醒打开率统计</view>
      <view class="reminder-card">
        <view class="reminder-circle">
          <text class="reminder-percent">{{reminder.reminderOpenRate}}%</text>
          <text class="reminder-sub">打开率</text>
        </view>
        <view class="reminder-info">
          <view class="reminder-row">
            <text class="reminder-label">已开启提醒</text>
            <text class="reminder-value">{{reminder.notificationOn}} 人</text>
          </view>
          <view class="reminder-row">
            <text class="reminder-label">总用户数</text>
            <text class="reminder-value">{{reminder.totalUsers}} 人</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 热门美食 TOP10 -->
    <view class="section">
      <view class="section-title">热门美食 TOP10</view>
      <view class="top-list" wx:if="{{topFoods.length > 0}}">
        <block wx:for="{{topFoods}}" wx:key="_id">
          <view class="top-item">
            <view class="top-rank rank-{{item.rank}}">
              <text class="rank-text">{{item.rank}}</text>
            </view>
            <image wx:if="{{item.image}}" class="top-image" mode="aspectFill" src="{{item.image}}" data-current="{{item.image}}" data-urls="{{[item.image]}}" bindtap="onPreviewTopImage" />
            <view wx:else class="top-image default-image">
              <text>🍽️</text>
            </view>
            <view class="top-info">
              <text class="top-name">{{item.name}}</text>
              <text class="top-origin" wx:if="{{item.origin}}">📍 {{item.origin}}</text>
              <view class="top-bar-wrap">
                <view class="top-bar" style="width: {{topMaxScore > 0 ? (item.hotScore / topMaxScore * 100) : 0}}%;"></view>
              </view>
            </view>
            <text class="top-score">{{item.hotScore}}</text>
          </view>
        </block>
      </view>
      <view wx:else class="empty-top">
        <text class="empty-text">暂无数据</text>
      </view>
    </view>
  </block>
</view>
