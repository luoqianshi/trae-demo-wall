.dashboard-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.dash-header {
  position: relative;
  padding: 60rpx 40rpx 80rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.header-content {
  position: relative;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 44rpx;
  color: #ffffff;
  font-weight: 700;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.section {
  padding: 0 24rpx;
  margin-top: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

/* 核心数据 */
.core-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.core-card {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.core-value {
  font-size: 48rpx;
  color: #333;
  font-weight: 700;
  line-height: 1.2;
}

.core-value.highlight {
  color: #FF6B35;
}

.core-value.danger {
  color: #F44336;
}

.core-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 冰箱使用数据 */
.fridge-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.fridge-row {
  display: flex;
  align-items: center;
}

.fridge-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fridge-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.fridge-value {
  font-size: 40rpx;
  color: #FF6B35;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.fridge-value.danger {
  color: #F44336;
}

.fridge-label {
  font-size: 24rpx;
  color: #999;
}

/* 投稿趋势 */
.trend-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 280rpx;
}

.trend-bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
}

.trend-bar-container {
  flex: 1;
  width: 40rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-bottom: 12rpx;
}

.trend-bar {
  width: 100%;
  background: linear-gradient(180deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  position: relative;
  transition: height 0.5s ease;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.trend-num {
  font-size: 20rpx;
  color: #ffffff;
  margin-top: 6rpx;
}

.trend-date {
  font-size: 22rpx;
  color: #999;
}

/* 提醒打开率 */
.reminder-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
}

.reminder-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0EB 0%, #FFE0D6 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.reminder-percent {
  font-size: 44rpx;
  color: #FF6B35;
  font-weight: 700;
}

.reminder-sub {
  font-size: 22rpx;
  color: #FF6B35;
  margin-top: 4rpx;
}

.reminder-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reminder-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-label {
  font-size: 26rpx;
  color: #999;
}

.reminder-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 热门 TOP10 */
.top-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.top-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.top-item:last-child {
  border-bottom: none;
}

.top-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.top-rank.rank-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
}

.top-rank.rank-2 {
  background: linear-gradient(135deg, #C0C0C0 0%, #A8A8A8 100%);
}

.top-rank.rank-3 {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
}

.rank-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #999;
}

.top-rank.rank-1 .rank-text,
.top-rank.rank-2 .rank-text,
.top-rank.rank-3 .rank-text {
  color: #ffffff;
}

.top-image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  background: #f5f5f5;
}

.default-image {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.top-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.top-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-origin {
  font-size: 22rpx;
  color: #999;
  margin: 4rpx 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-bar-wrap {
  height: 8rpx;
  background: #f5f5f5;
  border-radius: 4rpx;
  overflow: hidden;
}

.top-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 4rpx;
}

.top-score {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.empty-top {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #bbb;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.state-text {
  font-size: 28rpx;
  color: #999;
}
