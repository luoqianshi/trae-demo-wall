<view class="risk-page">
  <!-- 顶部说明 -->
  <view class="info-banner">
    <text class="info-icon">⚠️</text>
    <view class="info-text-wrap">
      <text class="info-title">{{activeTab === 'abnormalVote' ? '异常投票监控' : '广告账号限流'}}</text>
      <text class="info-desc" wx:if="{{activeTab === 'abnormalVote'}}">单日投票 ≥ {{threshold}} 次的账号视为异常</text>
      <text class="info-desc" wx:else>被标记为广告账号的限流列表</text>
    </view>
  </view>

  <!-- 标签栏 -->
  <view class="tab-bar">
    <block wx:for="{{tabs}}" wx:key="id">
      <view class="tab-item {{activeTab === item.id ? 'active' : ''}}" bindtap="onTabChange" data-id="{{item.id}}">
        <text class="tab-name">{{item.name}}</text>
      </view>
    </block>
  </view>

  <!-- 列表 -->
  <view class="risk-list" wx:if="{{list.length > 0}}">
    <block wx:for="{{list}}" wx:key="openid">
      <view class="risk-card">
        <view class="card-header">
          <view class="user-info">
            <image wx:if="{{item.avatarUrl}}" class="user-avatar" mode="aspectFill" src="{{item.avatarUrl}}" />
            <view wx:else class="user-avatar default-avatar">
              <text>👤</text>
            </view>
            <view class="user-meta">
              <text class="user-name">{{item.nickname || '未命名用户'}}</text>
              <text class="user-openid" bindtap="onCopyOpenid" data-openid="{{item.openid}}">ID: {{item.openid}}</text>
            </view>
          </view>
          <view class="status-tags">
            <view wx:if="{{item.isBanned}}" class="status-tag banned">
              <text>已封禁</text>
            </view>
            <view wx:if="{{item.isAdLimited}}" class="status-tag limited">
              <text>限流中</text>
            </view>
            <view wx:if="{{item.isAbnormal}}" class="status-tag abnormal">
              <text>异常</text>
            </view>
          </view>
        </view>

        <!-- 统计数据 -->
        <view class="stat-grid">
          <view class="stat-cell" wx:if="{{activeTab === 'abnormalVote'}}">
            <text class="stat-value">{{item.todayVoteCount}}</text>
            <text class="stat-label">今日投票</text>
          </view>
          <view class="stat-cell">
            <text class="stat-value">{{item.totalVoteCount || 0}}</text>
            <text class="stat-label">总投票</text>
          </view>
          <view class="stat-cell" wx:if="{{item.adReason}}">
            <text class="stat-value text-sm">{{item.adReason}}</text>
            <text class="stat-label">限流原因</text>
          </view>
        </view>

        <!-- 操作 -->
        <view class="card-actions">
          <view class="action-btn {{item.isBanned ? 'unban' : 'ban'}}" bindtap="onBan" data-item="{{item}}">
            <text>{{item.isBanned ? '解封账号' : '封禁账号'}}</text>
          </view>
          <view class="action-btn {{item.isAdLimited ? 'unlimit' : 'limit'}}" bindtap="onLimitAd" data-item="{{item}}">
            <text>{{item.isAdLimited ? '解除限流' : '加入限流'}}</text>
          </view>
          <view wx:if="{{activeTab === 'abnormalVote'}}" class="action-btn clean" bindtap="onCleanVotes" data-item="{{item}}">
            <text>清理票数</text>
          </view>
        </view>
      </view>
    </block>

    <view class="load-more" wx:if="{{loadingMore}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore}}">
      <text>— 已经到底啦 —</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="state-wrap" wx:if="{{loading && list.length === 0}}">
    <text class="state-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="state-wrap" wx:if="{{isEmpty && !loading}}">
    <text class="state-icon">🛡️</text>
    <text class="state-title">暂无异常账号</text>
    <text class="state-text">{{activeTab === 'abnormalVote' ? '今日暂无异常投票账号' : '暂无限流账号'}}</text>
  </view>
</view>
