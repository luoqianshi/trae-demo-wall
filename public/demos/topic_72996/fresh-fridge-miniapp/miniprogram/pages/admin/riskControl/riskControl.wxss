.risk-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.info-banner {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.info-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.info-text-wrap {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.info-title {
  font-size: 30rpx;
  color: #E65100;
  font-weight: 600;
}

.info-desc {
  font-size: 24rpx;
  color: #BF360C;
  margin-top: 4rpx;
}

.tab-bar {
  display: flex;
  background: #ffffff;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 30rpx;
  margin: 0 8rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.tab-name {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active .tab-name {
  color: #ffffff;
  font-weight: 600;
}

.risk-list {
  padding: 20rpx 24rpx;
}

.risk-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.default-avatar {
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.user-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-openid {
  font-size: 22rpx;
  color: #bbb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tags {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
  flex-shrink: 0;
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.status-tag text {
  font-size: 22rpx;
}

.status-tag.banned {
  background: rgba(244, 67, 54, 0.1);
}

.status-tag.banned text {
  color: #F44336;
}

.status-tag.limited {
  background: rgba(255, 152, 0, 0.1);
}

.status-tag.limited text {
  color: #FF9800;
}

.status-tag.abnormal {
  background: rgba(156, 39, 176, 0.1);
}

.status-tag.abnormal text {
  color: #9C27B0;
}

.stat-grid {
  display: flex;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  color: #FF6B35;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.stat-value.text-sm {
  font-size: 24rpx;
  color: #FF9800;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.action-btn text {
  font-size: 26rpx;
}

.action-btn.ban {
  background: rgba(244, 67, 54, 0.1);
  color: #F44336;
}

.action-btn.unban {
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.action-btn.limit {
  background: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.action-btn.unlimit {
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.action-btn.clean {
  background: rgba(156, 39, 176, 0.1);
  color: #9C27B0;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  color: #bbb;
  font-size: 24rpx;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.state-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.state-title {
  font-size: 32rpx;
  color: #999;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.state-text {
  font-size: 26rpx;
  color: #bbb;
}
