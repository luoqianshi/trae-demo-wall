<view class="audit-page">
  <!-- 顶部标签栏 -->
  <view class="tab-bar">
    <block wx:for="{{tabs}}" wx:key="id">
      <view class="tab-item {{activeTab === item.id ? 'active' : ''}}" bindtap="onTabChange" data-id="{{item.id}}">
        <text class="tab-name">{{item.name}}</text>
      </view>
    </block>
  </view>

  <!-- 审核列表 -->
  <view class="audit-list" wx:if="{{list.length > 0}}">
    <block wx:for="{{list}}" wx:key="_id">
      <view class="audit-card">
        <view class="card-header">
          <view class="card-title-wrap">
            <text class="card-title">{{item.name}}</text>
            <view class="type-tag {{item.submissionType === 'correction' ? 'tag-correction' : 'tag-new'}}">
              <text>{{item.submissionType === 'correction' ? '纠错' : '新投稿'}}</text>
            </view>
          </view>
          <view class="card-status">
            <text class="status-text">待审核</text>
          </view>
        </view>

        <view class="card-images" wx:if="{{item.images.length > 0}}">
          <image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:for-index="imgIdx"
            wx:key="*this"
            class="card-image"
            mode="aspectFill"
            src="{{img}}"
            data-current="{{img}}"
            data-urls="{{item.images}}"
            bindtap="onPreviewImage"
          />
        </view>

        <view class="card-info">
          <view class="info-row">
            <text class="info-label">品类</text>
            <text class="info-value">{{item.category}}</text>
          </view>
          <view class="info-row" wx:if="{{item.originFull}}">
            <text class="info-label">产地</text>
            <text class="info-value">{{item.originFull}}</text>
          </view>
          <view class="info-row" wx:if="{{item.shopName}}">
            <text class="info-label">店铺</text>
            <text class="info-value">{{item.shopName}}</text>
          </view>
          <view class="info-row" wx:if="{{item.shopAddress}}">
            <text class="info-label">地址</text>
            <text class="info-value">{{item.shopAddress}}</text>
          </view>
          <view class="info-row" wx:if="{{item.priceMin}}">
            <text class="info-label">价格</text>
            <text class="info-value">{{item.priceMin}}-{{item.priceMax}}{{item.priceUnit}}</text>
          </view>
        </view>

        <view class="card-footer">
          <text class="card-time">{{item.createTimeText}}</text>
          <view class="card-actions">
            <view class="action-btn view" bindtap="onViewDetail" data-item="{{item}}">详情</view>
            <view class="action-btn reject" bindtap="onShowReject" data-item="{{item}}">驳回</view>
            <view class="action-btn approve" bindtap="onApprove" data-item="{{item}}">通过</view>
          </view>
        </view>
      </view>
    </block>

    <view class="load-more" wx:if="{{loadingMore}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore}}">
      <text>— 已经到底啦 —</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="state-wrap" wx:if="{{loading && list.length === 0}}">
    <text class="state-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="state-wrap" wx:if="{{isEmpty && !loading}}">
    <text class="state-icon">✅</text>
    <text class="state-title">暂无待审核内容</text>
    <text class="state-text">所有投稿都已处理完毕</text>
  </view>
</view>

<!-- 详情抽屉 -->
<view wx:if="{{showDetail}}" class="drawer-mask" bindtap="onCloseDetail">
  <view class="drawer-container" catchtap="stopPropagation">
    <view class="drawer-header">
      <text class="drawer-title">投稿详情</text>
      <text class="drawer-close" bindtap="onCloseDetail">✕</text>
    </view>

    <scroll-view class="drawer-body" scroll-y="true" wx:if="{{currentItem}}">
      <swiper class="detail-swiper" wx:if="{{currentItem.images.length > 0}}" current="{{currentImageIndex}}" bindchange="onSwiperChange" indicator-dots="{{currentItem.images.length > 1}}" indicator-active-color="#FF6B35">
        <swiper-item wx:for="{{currentItem.images}}" wx:key="*this">
          <image class="detail-image" mode="aspectFit" src="{{item}}" />
        </swiper-item>
      </swiper>

      <view class="detail-section">
        <view class="section-title">美食信息</view>
        <view class="detail-row">
          <text class="detail-label">名称</text>
          <text class="detail-value">{{currentItem.name}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">品类</text>
          <text class="detail-value">{{currentItem.category}}</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.originFull}}">
          <text class="detail-label">产地</text>
          <text class="detail-value">{{currentItem.originFull}}</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.bestTasteMonths.length > 0}}">
          <text class="detail-label">赏味月份</text>
          <text class="detail-value">{{currentItem.bestTasteMonths}}月</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.priceMin}}">
          <text class="detail-label">参考价</text>
          <text class="detail-value">{{currentItem.priceMin}}-{{currentItem.priceMax}}{{currentItem.priceUnit}}</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.tips}}">
          <text class="detail-label">简介</text>
          <text class="detail-value">{{currentItem.tips}}</text>
        </view>
      </view>

      <view class="detail-section" wx:if="{{currentItem.shopName || currentItem.shopAddress}}">
        <view class="section-title">店铺信息</view>
        <view class="detail-row" wx:if="{{currentItem.shopName}}">
          <text class="detail-label">店铺</text>
          <text class="detail-value">{{currentItem.shopName}}</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.shopAddress}}">
          <text class="detail-label">地址</text>
          <text class="detail-value">{{currentItem.shopAddress}}</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.shopYears}}">
          <text class="detail-label">开业年限</text>
          <text class="detail-value">{{currentItem.shopYears}}年</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.canMail}}">
          <text class="detail-label">可邮寄</text>
          <text class="detail-value">是（{{currentItem.mailPackage}}）</text>
        </view>
        <view class="detail-row" wx:if="{{currentItem.bossWechat}}">
          <text class="detail-label">微信</text>
          <text class="detail-value">{{currentItem.bossWechat}}</text>
        </view>
      </view>

      <view class="detail-actions">
        <view class="action-btn reject" bindtap="onShowReject" data-item="{{currentItem}}">驳回</view>
        <view class="action-btn approve" bindtap="onApprove" data-item="{{currentItem}}">通过审核</view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 驳回弹窗 -->
<view wx:if="{{showReject}}" class="modal-mask" bindtap="onCloseReject">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-title">填写驳回原因</view>
    <textarea
      class="reject-textarea"
      placeholder="请填写驳回原因，将反馈给用户"
      maxlength="200"
      value="{{rejectReason}}"
      bindinput="onRejectInput"
    />
    <view class="modal-actions">
      <view class="modal-btn cancel" bindtap="onCloseReject">取消</view>
      <view class="modal-btn confirm" bindtap="onConfirmReject">确认驳回</view>
    </view>
  </view>
</view>
