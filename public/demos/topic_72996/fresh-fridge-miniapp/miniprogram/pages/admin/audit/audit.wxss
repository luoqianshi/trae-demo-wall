.audit-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.tab-bar {
  display: flex;
  background: #ffffff;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 30rpx;
  margin: 0 8rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.tab-name {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active .tab-name {
  color: #ffffff;
  font-weight: 600;
}

.audit-list {
  padding: 20rpx 24rpx;
}

.audit-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.type-tag {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.type-tag text {
  font-size: 22rpx;
}

.tag-new {
  background: rgba(255, 107, 53, 0.1);
}

.tag-new text {
  color: #FF6B35;
}

.tag-correction {
  background: rgba(33, 150, 243, 0.1);
}

.tag-correction text {
  color: #2196F3;
}

.card-status {
  background: rgba(255, 193, 7, 0.1);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.status-text {
  font-size: 22rpx;
  color: #FFC107;
  font-weight: 500;
}

.card-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

.card-info {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  padding: 8rpx 0;
}

.info-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-time {
  font-size: 24rpx;
  color: #bbb;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn.view {
  background: #f0f0f0;
  color: #666;
}

.action-btn.reject {
  background: rgba(244, 67, 54, 0.1);
  color: #F44336;
}

.action-btn.approve {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  color: #ffffff;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  color: #bbb;
  font-size: 24rpx;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.state-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.state-title {
  font-size: 32rpx;
  color: #999;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.state-text {
  font-size: 26rpx;
  color: #bbb;
}

/* 详情抽屉 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.drawer-container {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.drawer-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.drawer-body {
  flex: 1;
  padding: 24rpx 32rpx 40rpx;
}

.detail-swiper {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.detail-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.detail-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #FF6B35;
}

.detail-row {
  display: flex;
  padding: 10rpx 0;
}

.detail-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.detail-actions .action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
}

/* 驳回弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 80%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.reject-textarea {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #F44336 0%, #FF6B6B 100%);
  color: #ffffff;
  font-weight: 500;
}
