.admin-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx;
}

.state-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.state-title {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.state-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.state-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 24rpx;
}

.state-actions .btn-primary,
.state-actions .btn-secondary {
  width: 80%;
}

.admin-content {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.admin-header {
  position: relative;
  padding: 60rpx 40rpx 80rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.header-info {
  position: relative;
  display: flex;
  align-items: center;
}

.admin-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
}

.admin-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.admin-title {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 700;
}

.admin-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.admin-tag {
  position: relative;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 30rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.module-grid {
  padding: 0 32rpx;
  margin-top: -40rpx;
  position: relative;
}

.module-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease;
}

.module-card:active {
  transform: scale(0.98);
}

.module-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF0EB 0%, #FFE0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.module-icon {
  font-size: 48rpx;
}

.module-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.module-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.module-desc {
  font-size: 24rpx;
  color: #999;
}

.module-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.admin-footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #bbb;
}
