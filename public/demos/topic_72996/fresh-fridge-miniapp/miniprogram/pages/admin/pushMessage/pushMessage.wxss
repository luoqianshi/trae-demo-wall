.push-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.form-section {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #F44336;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.radio-group {
  display: flex;
  gap: 40rpx;
}

.radio-item {
  display: flex;
  align-items: center;
}

.radio-text {
  font-size: 28rpx;
  color: #333;
  margin-left: 8rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 22rpx;
  color: #999;
}

.preview-result {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 107, 53, 0.08);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.preview-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #666;
}

.preview-num {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: 700;
  margin: 0 4rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.action-btn.loading {
  opacity: 0.6;
}

.action-btn.preview {
  background: #f0f0f0;
  color: #666;
}

.action-btn.send {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  color: #ffffff;
  font-weight: 500;
}

/* 历史记录 */
.history-section {
  background: transparent;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.history-list {
  /* */
}

.history-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-scope {
  background: rgba(255, 107, 53, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.history-scope text {
  font-size: 22rpx;
  color: #FF6B35;
}

.history-content {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.history-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-stat {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 500;
}

.history-time {
  font-size: 22rpx;
  color: #bbb;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  color: #bbb;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #bbb;
}
