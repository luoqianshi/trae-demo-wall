<view class="push-page">
  <!-- 推送表单 -->
  <view class="form-card">
    <view class="card-title-wrap">
      <text class="card-icon">📨</text>
      <text class="card-title">发布时令活动通知</text>
    </view>

    <!-- 标题 -->
    <view class="form-section">
      <text class="form-label">消息标题 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入消息标题" maxlength="30" value="{{title}}" bindinput="onTitleInput" />
    </view>

    <!-- 内容 -->
    <view class="form-section">
      <text class="form-label">消息内容 <text class="required">*</text></text>
      <textarea class="form-textarea" placeholder="请输入消息内容（如时令活动、上新通知等）" maxlength="200" value="{{content}}" bindinput="onContentInput" />
    </view>

    <!-- 发送范围 -->
    <view class="form-section">
      <text class="form-label">发送范围</text>
      <radio-group class="radio-group" bindchange="onScopeChange">
        <label class="radio-item">
          <radio value="all" checked="{{scope === 'all'}}" color="#FF6B35" />
          <text class="radio-text">全部用户</text>
        </label>
        <label class="radio-item">
          <radio value="region" checked="{{scope === 'region'}}" color="#FF6B35" />
          <text class="radio-text">指定地区用户</text>
        </label>
      </radio-group>
    </view>

    <!-- 地区选择 -->
    <view class="form-section" wx:if="{{scope === 'region'}}">
      <text class="form-label">选择省份</text>
      <picker mode="selector" range="{{provinceNames}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
        <view class="form-picker">
          <text class="picker-text">{{selectedProvince || '请选择省份'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 预览结果 -->
    <view class="preview-result" wx:if="{{showPreview}}">
      <text class="preview-icon">👥</text>
      <text class="preview-text">将推送至 <text class="preview-num">{{previewCount}}</text> 位用户</text>
    </view>

    <!-- 操作按钮 -->
    <view class="form-actions">
      <view class="action-btn preview {{previewing ? 'loading' : ''}}" bindtap="onPreview">
        <text>{{previewing ? '预览中...' : '发送预览'}}</text>
      </view>
      <view class="action-btn send {{sending ? 'loading' : ''}}" bindtap="onSend">
        <text>{{sending ? '推送中...' : '确认推送'}}</text>
      </view>
    </view>
  </view>

  <!-- 历史推送记录 -->
  <view class="history-section">
    <view class="section-title">历史推送记录</view>

    <view wx:if="{{history.length > 0}}" class="history-list">
      <block wx:for="{{history}}" wx:key="_id">
        <view class="history-card">
          <view class="history-header">
            <text class="history-title">{{item.title}}</text>
            <view class="history-scope">
              <text>{{item.scope === 'all' ? '全部' : (item.region.province || '地区')}}</text>
            </view>
          </view>
          <text class="history-content">{{item.content}}</text>
          <view class="history-footer">
            <view class="history-stat">
              <text class="stat-icon">👥</text>
              <text class="stat-text">{{item.targetCount}} 人</text>
            </view>
            <text class="history-time">{{item.createTimeText}}</text>
          </view>
        </view>
      </block>

      <view class="load-more" wx:if="{{loadingMore}}">
        <text>加载中...</text>
      </view>
      <view class="load-more" wx:elif="{{!hasMore}}">
        <text>— 没有更多记录 —</text>
      </view>
    </view>

    <view wx:if="{{loadingHistory && history.length === 0}}" class="empty-state">
      <text class="empty-text">加载中...</text>
    </view>

    <view wx:if="{{!loadingHistory && history.length === 0}}" class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无推送记录</text>
    </view>
  </view>
</view>
