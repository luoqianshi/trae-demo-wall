<view class="admin-page">
  <!-- 鉴权中 -->
  <view wx:if="{{checking}}" class="state-wrap">
    <view class="state-icon">⏳</view>
    <text class="state-text">正在验证管理员身份...</text>
  </view>

  <!-- 非管理员 -->
  <view wx:elif="{{denied}}" class="state-wrap">
    <view class="state-icon">🔒</view>
    <text class="state-title">无访问权限</text>
    <text class="state-text">当前账号不在管理员列表中</text>
    <view class="state-actions">
      <view class="btn-primary" bindtap="onRetryCheck">重新验证</view>
      <view class="btn-secondary" bindtap="onBackHome">返回首页</view>
    </view>
  </view>

  <!-- 管理员首页 -->
  <view wx:else class="admin-content">
    <view class="admin-header">
      <view class="header-bg"></view>
      <view class="header-info">
        <view class="admin-avatar">🛠️</view>
        <view class="admin-meta">
          <text class="admin-title">管理后台</text>
          <text class="admin-sub">食鲜冰箱运营管理</text>
        </view>
      </view>
      <view class="admin-tag">
        <text class="tag-text">管理员</text>
      </view>
    </view>

    <view class="module-grid">
      <block wx:for="{{modules}}" wx:key="id">
        <view class="module-card" bindtap="onModuleTap" data-path="{{item.path}}">
          <view class="module-icon-wrap">
            <text class="module-icon">{{item.icon}}</text>
          </view>
          <view class="module-body">
            <text class="module-name">{{item.name}}</text>
            <text class="module-desc">{{item.desc}}</text>
          </view>
          <text class="module-arrow">›</text>
        </view>
      </block>
    </view>

    <view class="admin-footer">
      <text class="footer-text">管理后台 v1.0</text>
    </view>
  </view>
</view>
