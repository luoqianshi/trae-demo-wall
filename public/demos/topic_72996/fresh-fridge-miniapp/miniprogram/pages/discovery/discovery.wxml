<view class="container">
  <view class="header">
    <text class="header-title">美食榜单</text>
  </view>

  <view class="main-tabs">
    <view class="main-tab {{activeTab === 'season' ? 'active' : ''}}" bindtap="onTabChange" data-tab="season">
      <text class="main-tab-text">季节榜</text>
    </view>
    <view class="main-tab {{activeTab === 'region' ? 'active' : ''}}" bindtap="onTabChange" data-tab="region">
      <text class="main-tab-text">地区榜</text>
    </view>
    <view class="main-tab-indicator" style="left: {{activeTab === 'season' ? '0' : '50%'}}"></view>
  </view>

  <view wx:if="{{activeTab === 'season'}}" class="season-panel">
    <view class="season-tabs">
      <view wx:for="{{seasons}}" wx:key="key"
            class="season-tab {{activeSeason === item.key ? 'active' : ''}}"
            bindtap="onSeasonTap" data-season="{{item.key}}">
        <text class="season-icon">{{item.icon}}</text>
        <text class="season-name">{{item.name}}</text>
      </view>
    </view>

    <view class="food-list">
      <view wx:for="{{seasonFoods}}" wx:key="_id"
            class="rank-food-card {{index < 3 ? 'top' : ''}}"
            bindtap="onFoodTap" data-id="{{item._id}}">
        <view class="rank-badge rank-{{index + 1}}">
          <text class="rank-text">{{index + 1}}</text>
        </view>
        <image class="food-image" mode="aspectFill" src="{{item.images[0] || item.image || 'https://placehold.co/300x300/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}" data-src="{{item.images[0] || item.image}}"></image>
        <view class="food-info">
          <view class="food-header">
            <text class="food-name">{{item.name}}</text>
            <view wx:if="{{item.canMail}}" class="mail-tag">
              <text>可邮寄</text>
            </view>
          </view>
          <text class="food-origin">📍 {{item.origin}}</text>
          <view class="food-meta">
            <text class="food-months">赏味：{{item.seasonMonths[0]}}-{{item.seasonMonths[item.seasonMonths.length - 1]}}月</text>
          </view>
          <view class="food-hot">
            <text class="hot-icon">🔥</text>
            <text class="hot-score">{{item.hotScore || item.voteCount || 0}}票</text>
          </view>
        </view>
      </view>

      <view wx:if="{{seasonFoods.length === 0 && !seasonLoading}}" class="empty-state">
        <text class="empty-icon">🍽️</text>
        <text class="empty-text">暂无当季美食</text>
      </view>

      <view wx:if="{{seasonLoading}}" class="loading-state">
        <text>加载中...</text>
      </view>

      <view wx:if="{{!seasonHasMore && seasonFoods.length > 0}}" class="no-more">
        <text>— 已经到底啦 —</text>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'region'}}" class="region-panel">
    <view class="region-selector" bindtap="openRegionPicker">
      <text class="region-icon">📍</text>
      <text class="region-text">{{selectedProvince}}{{selectedCity}}{{selectedDistrict}}</text>
      <text class="region-arrow">▼</text>
    </view>

    <view class="region-sub-tabs">
      <view class="region-sub-tab {{regionTab === 'local' ? 'active' : ''}}" bindtap="onRegionTabChange" data-tab="local">
        <text>本地堂食榜</text>
      </view>
      <view class="region-sub-tab {{regionTab === 'mail' ? 'active' : ''}}" bindtap="onRegionTabChange" data-tab="mail">
        <text>异地邮寄榜</text>
      </view>
    </view>

    <view class="food-list">
      <view wx:for="{{regionFoods}}" wx:key="_id"
            class="rank-food-card {{index < 3 ? 'top' : ''}}"
            bindtap="onFoodTap" data-id="{{item._id}}">
        <view class="rank-badge rank-{{index + 1}}">
          <text class="rank-text">{{index + 1}}</text>
        </view>
        <image class="food-image" mode="aspectFill" src="{{item.images[0] || item.image || 'https://placehold.co/300x300/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}" data-src="{{item.images[0] || item.image}}"></image>
        <view class="food-info">
          <view class="food-header">
            <text class="food-name">{{item.name}}</text>
            <view wx:if="{{item.canMail}}" class="mail-tag">
              <text>可邮寄</text>
            </view>
          </view>
          <text class="food-origin">📍 {{item.origin}}</text>
          <view class="food-meta">
            <text class="food-months">赏味：{{item.seasonMonths[0]}}-{{item.seasonMonths[item.seasonMonths.length - 1]}}月</text>
          </view>
          <view class="food-hot">
            <text class="hot-icon">🔥</text>
            <text class="hot-score">{{item.hotScore || item.voteCount || 0}}票</text>
          </view>
        </view>
      </view>

      <view wx:if="{{regionFoods.length === 0 && !regionLoading}}" class="empty-state">
        <text class="empty-icon">🍽️</text>
        <text class="empty-text">暂无该地区美食</text>
      </view>

      <view wx:if="{{regionLoading}}" class="loading-state">
        <text>加载中...</text>
      </view>

      <view wx:if="{{!regionHasMore && regionFoods.length > 0}}" class="no-more">
        <text>— 已经到底啦 —</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showRegionPicker}}" class="picker-mask" bindtap="closeRegionPicker">
    <view class="picker-container" catchtap="">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="closeRegionPicker">取消</text>
        <text class="picker-title">选择地区</text>
        <text class="picker-confirm" bindtap="confirmRegionPicker">确定</text>
      </view>

      <view class="picker-body">
        <picker-view class="picker-view" indicator-style="height: 80rpx;"
                     value="{{[pickerProvinceIndex, pickerCityIndex, pickerDistrictIndex]}}"
                     bindchange="onPickerChange">
          <picker-view-column>
            <view wx:for="{{pickerProvinces}}" wx:key="code" class="picker-item">
              {{item.name}}
            </view>
          </picker-view-column>
          <picker-view-column>
            <view wx:for="{{pickerCities}}" wx:key="code" class="picker-item">
              {{item.name}}
            </view>
          </picker-view-column>
          <picker-view-column>
            <view wx:for="{{pickerDistricts}}" wx:key="code" class="picker-item">
              {{item.name}}
            </view>
          </picker-view-column>
        </picker-view>
      </view>
    </view>
  </view>
</view>
