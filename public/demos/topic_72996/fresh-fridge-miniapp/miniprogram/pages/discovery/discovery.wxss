.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  padding: 60rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.main-tabs {
  display: flex;
  position: relative;
  background-color: #ffffff;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.main-tab {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
}

.main-tab-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
}

.main-tab.active .main-tab-text {
  color: #FF6B35;
  font-weight: 600;
}

.main-tab-indicator {
  position: absolute;
  bottom: 0;
  width: 50%;
  height: 6rpx;
  background-color: #FF6B35;
  border-radius: 3rpx;
  transition: left 0.3s ease;
}

.season-panel,
.region-panel {
  padding: 0 24rpx;
}

.season-tabs {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.season-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.season-tab.active {
  background-color: #FFF0EB;
  transform: scale(1.05);
}

.season-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.season-name {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.season-tab.active .season-name {
  color: #FF6B35;
  font-weight: 600;
}

.region-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.region-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.region-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  text-align: center;
}

.region-arrow {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.region-sub-tabs {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.region-sub-tab {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.region-sub-tab.active {
  background-color: #FF6B35;
  color: #ffffff;
  font-weight: 500;
}

.food-list {
  padding-top: 20rpx;
}

.rank-food-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.rank-food-card:active {
  transform: scale(0.98);
}

.rank-food-card.top {
  background: linear-gradient(135deg, #FFFEF7 0%, #FFF5EB 100%);
}

.rank-badge {
  position: absolute;
  left: -4rpx;
  top: -4rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx 8rpx 16rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.rank-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
}

.rank-2 {
  background: linear-gradient(135deg, #C0C0C0 0%, #A8A8A8 100%);
}

.rank-3 {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
}

.rank-badge:not(.rank-1):not(.rank-2):not(.rank-3) {
  background-color: #f0f0f0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx 6rpx 12rpx 6rpx;
}

.rank-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.rank-badge:not(.rank-1):not(.rank-2):not(.rank-3) .rank-text {
  font-size: 26rpx;
  color: #999;
}

.food-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.food-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.food-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.food-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mail-tag {
  background-color: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.mail-tag text {
  font-size: 22rpx;
  color: #4CAF50;
}

.food-origin {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-meta {
  margin-bottom: 8rpx;
}

.food-months {
  font-size: 24rpx;
  color: #999;
}

.food-hot {
  display: flex;
  align-items: center;
}

.hot-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.hot-score {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-state text {
  font-size: 26rpx;
  color: #999;
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more text {
  font-size: 24rpx;
  color: #ccc;
}

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-container {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel {
  font-size: 30rpx;
  color: #999;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.picker-confirm {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: 500;
}

.picker-body {
  padding: 20rpx 0 40rpx;
}

.picker-view {
  width: 100%;
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #333;
}
