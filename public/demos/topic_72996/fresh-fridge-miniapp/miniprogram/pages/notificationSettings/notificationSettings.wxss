.settings-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.intro {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.15);
}

.intro-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.intro-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E65100;
  margin-bottom: 6rpx;
}

.intro-desc {
  font-size: 24rpx;
  color: #BF6A00;
}

.settings-group {
  padding: 12rpx 32rpx;
  margin-bottom: 24rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.setting-info {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.setting-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.setting-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.setting-divider {
  height: 1rpx;
  background: #f0f0f0;
}

.tips {
  padding: 24rpx 16rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 12rpx;
}

.tips-line {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  line-height: 1.8;
}
