<view class="detail-page" wx:if="{{foodDetail}}">
  <swiper class="detail-swiper" indicator-dots="{{foodDetail.images && foodDetail.images.length > 1}}" autoplay="{{true}}" interval="3000" duration="500" circular="{{true}}" bindchange="onImageChange" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
    <block wx:for="{{foodDetail.images}}" wx:key="index">
      <swiper-item>
        <image class="swiper-image" mode="aspectFill" src="{{item}}" binderror="onImageError" data-index="{{index}}" data-src="{{item}}"></image>
      </swiper-item>
    </block>
    <swiper-item wx:if="{{!foodDetail.images || foodDetail.images.length === 0}}">
      <image class="swiper-image" mode="aspectFill" src="https://placehold.co/400x400/FF6B35/FFFFFF?text=Delicious+Food"></image>
    </swiper-item>
  </swiper>

  <view class="back-btn" bindtap="onBack">
    <text class="back-icon">‹</text>
  </view>

  <view class="detail-content">
    <view class="detail-header card">
      <view class="detail-title-row">
        <text class="detail-name">{{foodDetail.name}}</text>
      </view>
      <view class="detail-tags">
        <text class="tag tag-primary" wx:if="{{categoryName}}">{{categoryName}}</text>
        <text class="tag tag-success" wx:if="{{foodDetail.isMailable || foodDetail.canMail}}">可邮寄</text>
        <text class="tag tag-warning" wx:if="{{foodDetail.canOnlineBuy}}">支持网购</text>
      </view>
    </view>

    <view class="info-card card">
      <view class="info-row">
        <view class="info-item">
          <text class="info-label">📍 产地</text>
          <text class="info-value">{{foodDetail.origin || '暂无'}}</text>
        </view>
      </view>
      <view class="info-row">
        <view class="info-item">
          <text class="info-label">📅 最佳赏味</text>
          <text class="info-value">
            <block wx:if="{{foodDetail.bestMonths && foodDetail.bestMonths.length > 0}}">
              <text wx:for="{{foodDetail.bestMonths}}" wx:key="index">{{item}}月{{index < foodDetail.bestMonths.length - 1 ? '、' : ''}}</text>
            </block>
            <block wx:else>全年</block>
          </text>
        </view>
      </view>
      <view class="info-row">
        <view class="info-item">
          <text class="info-label">💰 参考价格</text>
          <text class="info-value price">
            <block wx:if="{{foodDetail.priceMin && foodDetail.priceMax}}">
              ¥{{foodDetail.priceMin}} - ¥{{foodDetail.priceMax}} {{foodDetail.priceUnit || ''}}
            </block>
            <block wx:elif="{{foodDetail.price}}">
              ¥{{foodDetail.price}}
            </block>
            <block wx:else>暂无</block>
          </text>
        </view>
      </view>
    </view>

    <view class="stats-card card">
      <view class="stats-item">
        <text class="stats-value">🔥 {{foodDetail.voteCount || foodDetail.hotScore || 0}}</text>
        <text class="stats-label">热度</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-value">⭐ {{foodDetail.favoriteCount || foodDetail.collects || 0}}</text>
        <text class="stats-label">收藏</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-value">🍽️ {{foodDetail.wantCount || 0}}</text>
        <text class="stats-label">想吃</text>
      </view>
    </view>

    <view class="taste-card card" wx:if="{{foodDetail.tasteTags && foodDetail.tasteTags.length > 0}}">
      <text class="section-title">口味标签</text>
      <view class="taste-tags">
        <text class="taste-tag" wx:for="{{foodDetail.tasteTags}}" wx:key="index">{{item}}</text>
      </view>
    </view>

    <view class="section card" wx:if="{{foodDetail.description}}">
      <text class="section-title">美食简介</text>
      <text class="section-content">{{foodDetail.description}}</text>
    </view>

    <view class="shop-section card" wx:if="{{isSnackCategory && foodDetail.shop}}">
      <view class="section-header">
        <text class="section-title">🏪 小吃老店</text>
      </view>
      <view class="shop-info">
        <view class="shop-info-item">
          <text class="shop-label">店铺全称</text>
          <text class="shop-value">{{foodDetail.shop.name || '暂无'}}</text>
        </view>
        <view class="shop-info-item">
          <text class="shop-label">门店地址</text>
          <text class="shop-value">{{foodDetail.shop.address || '暂无'}}</text>
        </view>
        <view class="shop-info-item" wx:if="{{foodDetail.shop.established}}">
          <text class="shop-label">开业年限</text>
          <text class="shop-value">{{2026 - foodDetail.shop.established}}年</text>
        </view>
      </view>
      <view class="shop-tags" wx:if="{{foodDetail.shopTags && foodDetail.shopTags.length > 0}}">
        <text class="shop-tag" wx:for="{{foodDetail.shopTags}}" wx:key="index">{{item}}</text>
      </view>
      <view class="shop-tags" wx:elif="{{foodDetail.shop.tags && foodDetail.shop.tags.length > 0}}">
        <text class="shop-tag" wx:for="{{foodDetail.shop.tags}}" wx:key="index">{{item}}</text>
      </view>
    </view>

    <view class="mail-section card" wx:if="{{(foodDetail.isMailable || foodDetail.canMail) && (foodDetail.mailInfo || isSnackCategory)}}">
      <view class="section-header">
        <text class="section-title">📦 邮寄详情</text>
      </view>
      <view class="mail-info">
        <view class="mail-info-item">
          <text class="mail-label">是否支持邮寄</text>
          <text class="mail-value mail-success">{{foodDetail.isMailable || foodDetail.canMail ? '支持' : '不支持'}}</text>
        </view>
        <view class="mail-info-item" wx:if="{{foodDetail.mailInfo && foodDetail.mailInfo.packaging}}">
          <text class="mail-label">邮寄包装</text>
          <text class="mail-value">{{foodDetail.mailInfo.packaging}}</text>
        </view>
        <view class="mail-info-item" wx:if="{{foodDetail.mailInfo && foodDetail.mailInfo.delivery}}">
          <text class="mail-label">可用快递</text>
          <text class="mail-value">{{foodDetail.mailInfo.delivery}}</text>
        </view>
        <view class="mail-info-item" wx:if="{{foodDetail.mailInfo && foodDetail.mailInfo.shelfLife}}">
          <text class="mail-label">真空保质期</text>
          <text class="mail-value">{{foodDetail.mailInfo.shelfLife}}天</text>
        </view>
        <view class="mail-info-item" wx:if="{{foodDetail.shippingFee !== undefined && foodDetail.shippingFee !== null}}">
          <text class="mail-label">运费规则</text>
          <text class="mail-value">{{foodDetail.shippingFee === 0 ? '包邮' : '¥' + foodDetail.shippingFee}}</text>
        </view>
        <view class="mail-info-item" wx:if="{{foodDetail.remoteArea}}">
          <text class="mail-label">偏远地区</text>
          <text class="mail-value">{{foodDetail.remoteArea}}</text>
        </view>
      </view>
    </view>

    <view class="buy-section card" wx:if="{{isSnackCategory && (foodDetail.buyChannels || foodDetail.shop)}}">
      <view class="section-header">
        <text class="section-title">🛒 购买渠道</text>
      </view>
      <view class="buy-channels">
        <view class="buy-channel-item" wx:if="{{foodDetail.shop && foodDetail.shop.wechat}}" bindtap="onCopyText" data-text="{{foodDetail.shop.wechat}}">
          <view class="channel-icon">💬</view>
          <view class="channel-info">
            <text class="channel-label">老板微信</text>
            <text class="channel-value">{{foodDetail.shop.wechat}}</text>
          </view>
          <text class="copy-btn">复制</text>
        </view>
        <view class="buy-channel-item" wx:if="{{foodDetail.taobaoShop || (foodDetail.shop && foodDetail.shop.taobao)}}" bindtap="onCopyText" data-text="{{foodDetail.taobaoShop || (foodDetail.shop && foodDetail.shop.taobao)}}">
          <view class="channel-icon">🛍️</view>
          <view class="channel-info">
            <text class="channel-label">淘宝店铺</text>
            <text class="channel-value">{{foodDetail.taobaoShop || (foodDetail.shop && foodDetail.shop.taobao)}}</text>
          </view>
          <text class="copy-btn">复制</text>
        </view>
        <view class="buy-channel-item" wx:if="{{foodDetail.pddShop || (foodDetail.shop && foodDetail.shop.pdd)}}" bindtap="onCopyText" data-text="{{foodDetail.pddShop || (foodDetail.shop && foodDetail.shop.pdd)}}">
          <view class="channel-icon">🏪</view>
          <view class="channel-info">
            <text class="channel-label">拼多多店铺</text>
            <text class="channel-value">{{foodDetail.pddShop || (foodDetail.shop && foodDetail.shop.pdd)}}</text>
          </view>
          <text class="copy-btn">复制</text>
        </view>
      </view>
    </view>

    <view class="tips-section card" wx:if="{{isSnackCategory && (foodDetail.mailTips || (foodDetail.shop && foodDetail.shop.tips))}}">
      <view class="section-header">
        <text class="section-title">💡 邮寄避雷贴士</text>
      </view>
      <view class="tips-content">
        <text>{{foodDetail.mailTips || (foodDetail.shop && foodDetail.shop.tips)}}</text>
      </view>
    </view>

    <view class="vote-section card">
      <view class="section-header">
        <text class="section-title">🗳️ 美食投票</text>
        <text class="vote-count">{{foodDetail.voteCount || 0}}票</text>
      </view>
      <view class="vote-buttons">
        <view class="vote-btn {{hasVoted ? 'voted' : ''}}" bindtap="onVote" data-type="general">
          <text class="vote-icon">👍</text>
          <text class="vote-text">{{hasVoted ? '已投票' : '投一票'}}</text>
        </view>
        <view class="vote-btn mail-vote {{hasVoted ? 'voted' : ''}}" wx:if="{{foodDetail.isMailable || foodDetail.canMail}}" bindtap="onVote" data-type="mail">
          <text class="vote-icon">📦</text>
          <text class="vote-text">{{hasVoted ? '已评' : '邮寄口感'}}</text>
        </view>
      </view>
      <view class="mail-vote-stats" wx:if="{{(foodDetail.isMailable || foodDetail.canMail) && (foodDetail.mailVoteCount > 0)}}">
        <text class="mail-vote-label">邮寄口感评分：</text>
        <text class="mail-vote-value">{{foodDetail.mailVoteCount}}人评价</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>

  <view class="bottom-bar">
    <view class="action-buttons">
      <view class="action-btn {{isFavorited ? 'active' : ''}}" bindtap="onToggleFavorite">
        <text class="action-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
        <text class="action-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="action-btn {{isWanted ? 'active' : ''}}" bindtap="onToggleWant">
        <text class="action-icon">{{isWanted ? '🍽️' : '📋'}}</text>
        <text class="action-text">{{isWanted ? '已想吃' : '想吃'}}</text>
      </view>
      <button class="action-btn share-btn" open-type="share">
        <text class="action-icon">📤</text>
        <text class="action-text">分享</text>
      </button>
    </view>
    <view class="main-buttons">
      <view class="main-btn fridge-btn {{isInFridge ? 'disabled' : ''}}" bindtap="onAddToFridge">
        <text>{{isInFridge ? '已在冰箱' : '移入冰箱'}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{loading}}" class="loading">
  <text>加载中...</text>
</view>
