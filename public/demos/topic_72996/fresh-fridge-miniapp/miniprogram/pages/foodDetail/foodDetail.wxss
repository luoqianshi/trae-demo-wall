.detail-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.detail-swiper {
  width: 100%;
  height: 560rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.back-btn {
  position: fixed;
  top: 60rpx;
  left: 30rpx;
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.back-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.detail-content {
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
  padding: 0 24rpx;
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-header {
  border-radius: 20rpx 20rpx 0 0;
  margin-bottom: 20rpx;
}

.detail-title-row {
  margin-bottom: 20rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.4;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #666;
}

.tag-primary {
  background-color: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
}

.tag-success {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.tag-warning {
  background-color: rgba(255, 193, 7, 0.1);
  color: #FFC107;
}

.info-card .info-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-card .info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-card .info-row:first-child {
  padding-top: 0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  max-width: 60%;
  text-align: right;
}

.info-value.price {
  color: #FF6B35;
  font-weight: 600;
}

.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #f0f0f0;
}

.taste-card .section-title {
  margin-bottom: 20rpx;
}

.taste-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.taste-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8DC 100%);
  color: #FF6B35;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.shop-info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.shop-info-item:last-child {
  border-bottom: none;
}

.shop-label {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.shop-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.shop-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.shop-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background-color: rgba(255, 193, 7, 0.1);
  color: #FF9800;
}

.mail-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.mail-info-item:last-child {
  border-bottom: none;
}

.mail-label {
  font-size: 28rpx;
  color: #999;
}

.mail-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.mail-value.mail-success {
  color: #4CAF50;
  font-weight: 500;
}

.buy-channels {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.buy-channel-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
}

.channel-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.channel-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.channel-label {
  font-size: 24rpx;
  color: #999;
}

.channel-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.copy-btn {
  font-size: 26rpx;
  color: #FF6B35;
  padding: 8rpx 20rpx;
  background-color: rgba(255, 107, 53, 0.1);
  border-radius: 20rpx;
}

.tips-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  padding: 20rpx;
  background-color: #FFF9E6;
  border-radius: 12rpx;
  border-left: 6rpx solid #FFC107;
}

.vote-count {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 500;
}

.vote-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.vote-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 20rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8DC 100%);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.vote-btn.voted {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.vote-btn.voted .vote-icon,
.vote-btn.voted .vote-text {
  color: #fff;
}

.vote-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.vote-text {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 500;
}

.mail-vote-stats {
  display: flex;
  justify-content: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.mail-vote-label {
  font-size: 26rpx;
  color: #999;
}

.mail-vote-value {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 500;
}

.bottom-space {
  height: 40rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-buttons {
  display: flex;
  gap: 30rpx;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 22rpx;
  color: #999;
}

.action-btn.active .action-text {
  color: #FF6B35;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: none;
  border: none;
  padding: 0;
  line-height: 1;
}

.share-btn::after {
  border: none;
}

.main-buttons {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.main-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.fridge-btn {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  color: #fff;
}

.fridge-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
}
