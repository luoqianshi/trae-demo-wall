<view class="guide-container">
  <view class="header">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{getProgressWidth()}}"></view>
    </view>
    <view class="step-indicator">
      <text class="step-text">{{currentStep}}/{{totalSteps}}</text>
    </view>
  </view>

  <view class="content">
    <view class="step-header">
      <text class="step-title">{{getStepTitle()}}</text>
      <text class="step-desc">{{getStepDescription()}}</text>
    </view>

    <view class="step-content" wx:if="{{currentStep === 1}}">
      <view class="picker-group">
        <view class="picker-item">
          <text class="picker-label">省份</text>
          <picker mode="selector" range="{{provinceNames}}" bindchange="handleProvinceChange">
            <view class="picker-value">
              <text>{{selectedProvince || '请选择省份'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="picker-item" wx:if="{{selectedProvince}}">
          <text class="picker-label">城市</text>
          <picker mode="selector" range="{{cityNames}}" bindchange="handleCityChange">
            <view class="picker-value">
              <text>{{selectedCity || '请选择城市'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="picker-item" wx:if="{{selectedCity && districts.length > 0}}">
          <text class="picker-label">区县</text>
          <picker mode="selector" range="{{districtNames}}" bindchange="handleDistrictChange">
            <view class="picker-value">
              <text>{{selectedDistrict || '请选择区县'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="step-content" wx:if="{{currentStep === 2}}">
      <view class="category-grid">
        <view 
          class="category-card {{isCategorySelected(cat.id) ? 'selected' : ''}}"
          wx:for="{{categories}}" 
          wx:key="id"
          bindtap="toggleCategory"
          data-id="{{cat.id}}"
        >
          <text class="category-icon">{{cat.icon}}</text>
          <text class="category-name">{{cat.name}}</text>
          <view class="category-check" wx:if="{{isCategorySelected(cat.id)}}">✓</view>
        </view>
      </view>
      <text class="selected-count">已选择 {{selectedCategories.length}} 个类别</text>
    </view>

    <view class="step-content" wx:if="{{currentStep === 3}}">
      <view class="taste-grid">
        <view 
          class="taste-card {{isTasteSelected(taste.id) ? 'selected' : ''}}"
          wx:for="{{tastes}}" 
          wx:key="id"
          bindtap="toggleTaste"
          data-id="{{taste.id}}"
        >
          <text class="taste-emoji">{{taste.emoji}}</text>
          <text class="taste-name">{{taste.name}}</text>
          <view class="taste-check" wx:if="{{isTasteSelected(taste.id)}}">✓</view>
        </view>
      </view>
      <text class="selected-count">已选择 {{selectedTastes.length}} 个口味</text>
    </view>
  </view>

  <view class="footer">
    <button class="next-btn" bindtap="nextStep" loading="{{loading}}">
      {{currentStep === 3 ? '完成引导' : '下一步'}}
    </button>
  </view>
</view>