.guide-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  display: flex;
  flex-direction: column;
}

.header {
  padding: 60rpx 40rpx 30rpx;
  position: relative;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.step-indicator {
  position: absolute;
  right: 40rpx;
  top: 60rpx;
}

.step-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.content {
  flex: 1;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx;
  overflow-y: auto;
}

.step-header {
  margin-bottom: 40rpx;
  text-align: center;
}

.step-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.step-desc {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.picker-group {
  background: #f8f8f8;
  border-radius: 20rpx;
  padding: 20rpx;
}

.picker-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  color: #333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #ccc;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20rpx;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  position: relative;
}

.category-card.selected {
  background: #FFF3E0;
  border-color: #FF6B35;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
}

.category-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.taste-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.taste-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  position: relative;
}

.taste-card.selected {
  background: #FFF3E0;
  border-color: #FF6B35;
}

.taste-emoji {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.taste-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
}

.taste-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selected-count {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #FF6B35;
  margin-top: 30rpx;
}

.footer {
  padding: 30rpx 40rpx 60rpx;
  background: #fff;
}

.next-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}

.next-btn::after {
  border: none;
}