<view class="container">
  <view class="header">
    <text class="header-title">🧊 食鲜冰箱</text>
    <view class="header-actions">
      <view class="action-btn-mini" bindtap="onToggleSelectMode">
        <text>{{isSelectMode ? '取消' : '管理'}}</text>
      </view>
    </view>
  </view>

  <view class="seasonal-sticker" bindtap="onStickerTap">
    <text class="sticker-icon">🌟</text>
    <view class="sticker-content">
      <text class="sticker-title">本月应季推荐</text>
      <text class="sticker-desc">{{seasonalRecommend}}</text>
    </view>
  </view>

  <view class="fridge-wrapper">
    <view class="fridge-body {{isDoorOpen ? 'door-open' : ''}}">
      <view class="fridge-top">
        <view class="fridge-brand">食鲜</view>
        <view class="fridge-display">
          <text class="temp-cold">冷藏 {{stats.coldCount}}/{{stats.coldCapacity}}</text>
          <text class="temp-fresh">保鲜 {{stats.freshCount}}/{{stats.freshCapacity}}</text>
        </view>
      </view>

      <view class="fridge-doors" bindtap="onOpenDoor">
        <view class="door door-left {{isDoorOpen ? 'open-left' : ''}}">
          <view class="door-handle"></view>
          <view class="door-content">
            <text class="door-title">🥰 想吃清单</text>
            <text class="door-count">{{wantList.length}} 件想吃</text>
            <view class="door-preview">
              <block wx:for="{{wantList.slice(0, 3)}}" wx:key="_id">
                <image class="preview-img" src="{{item.image || 'https://placehold.co/120x120/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}"></image>
              </block>
              <view wx:if="{{wantList.length > 3}}" class="preview-more">+{{wantList.length - 3}}</view>
            </view>
            <view class="door-want-tags">
              <block wx:for="{{wantList.slice(0, 2)}}" wx:key="_id">
                <text class="mini-name">{{item.name}}</text>
              </block>
            </view>
            <text class="door-hint">点击开门查看详情</text>
          </view>
        </view>
        <view class="door door-right {{isDoorOpen ? 'open-right' : ''}}">
          <view class="door-handle"></view>
          <view class="door-content">
            <text class="door-title">❄️ 冰箱容量</text>
            <text class="door-count">{{stats.coldCount + stats.freshCount}} 件食材</text>
            <view class="door-status">
              <view class="status-dot fresh"></view>
              <text class="status-text">新鲜 {{stats.coldCount + stats.freshCount - stats.expiredCount}}</text>
            </view>
            <view class="door-status" wx:if="{{stats.expiredCount > 0}}">
              <view class="status-dot expired"></view>
              <text class="status-text">过期 {{stats.expiredCount}}</text>
            </view>
            <view class="capacity-bar">
              <view class="capacity-fill" style="width: {{(stats.coldCount + stats.freshCount) / (stats.coldCapacity + stats.freshCapacity) * 100}}%"></view>
            </view>
            <text class="door-hint">点击开门查看</text>
          </view>
        </view>
      </view>

      <view class="fridge-inside {{isDoorOpen ? 'visible' : ''}}">
        <view class="inside-tabs">
          <view class="inside-tab {{activeInsideTab === 'cold' ? 'active' : ''}}" bindtap="onInsideTabChange" data-tab="cold">
            <text>🥶 冷藏层</text>
            <text class="tab-count">{{coldItems.length}}/{{stats.coldCapacity}}</text>
          </view>
          <view class="inside-tab {{activeInsideTab === 'fresh' ? 'active' : ''}}" bindtap="onInsideTabChange" data-tab="fresh">
            <text>🌿 保鲜层</text>
            <text class="tab-count">{{freshItems.length}}/{{stats.freshCapacity}}</text>
          </view>
          <view class="inside-tab {{activeInsideTab === 'expired' ? 'active' : ''}}" bindtap="onInsideTabChange" data-tab="expired">
            <text>⚠️ 过期区</text>
            <text class="tab-count expired-count">{{expiredItems.length}}</text>
          </view>
        </view>

        <scroll-view class="inside-content" scroll-y>
          <block wx:if="{{activeInsideTab === 'cold'}}">
            <view wx:if="{{coldItems.length === 0}}" class="empty-inside">
              <text class="empty-icon">🥶</text>
              <text class="empty-text">冷藏层空空如也</text>
            </view>
            <view wx:for="{{coldItems}}" wx:key="_id" class="fridge-item-card {{item.status}}">
              <image class="item-img" src="{{item.image || 'https://placehold.co/120x120/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}"></image>
              <view class="item-info">
                <text class="item-name">{{item.name}}</text>
                <text class="item-origin">{{item.origin}}</text>
                <view class="item-bottom">
                  <text class="expire-date">{{item.expireDateStr}}</text>
                  <view class="status-badge {{item.status}}">
                    {{item.status === 'fresh' ? '新鲜' : item.status === 'warning' ? '临期' : '过期'}}
                  </view>
                </view>
              </view>
              <view class="item-note-btn" bindtap="onEditNote" data-item="{{item}}">📝</view>
              <view wx:if="{{isSelectMode}}" class="item-checkbox {{selectedIds.indexOf(item._id) > -1 ? 'checked' : ''}}" catchtap="onToggleSelect" data-id="{{item._id}}">
                <text wx:if="{{selectedIds.indexOf(item._id) > -1}}">✓</text>
              </view>
            </view>
          </block>

          <block wx:if="{{activeInsideTab === 'fresh'}}">
            <view wx:if="{{freshItems.length === 0}}" class="empty-inside">
              <text class="empty-icon">🌿</text>
              <text class="empty-text">保鲜层空空如也</text>
            </view>
            <view wx:for="{{freshItems}}" wx:key="_id" class="fridge-item-card {{item.status}}">
              <image class="item-img" src="{{item.image || 'https://placehold.co/120x120/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}"></image>
              <view class="item-info">
                <text class="item-name">{{item.name}}</text>
                <text class="item-origin">{{item.origin}}</text>
                <view class="item-bottom">
                  <text class="expire-date">{{item.expireDateStr}}</text>
                  <view class="status-badge {{item.status}}">
                    {{item.status === 'fresh' ? '新鲜' : item.status === 'warning' ? '临期' : '过期'}}
                  </view>
                </view>
              </view>
              <view class="item-note-btn" bindtap="onEditNote" data-item="{{item}}">📝</view>
              <view wx:if="{{isSelectMode}}" class="item-checkbox {{selectedIds.indexOf(item._id) > -1 ? 'checked' : ''}}" catchtap="onToggleSelect" data-id="{{item._id}}">
                <text wx:if="{{selectedIds.indexOf(item._id) > -1}}">✓</text>
              </view>
            </view>
          </block>

          <block wx:if="{{activeInsideTab === 'expired'}}">
            <view wx:if="{{expiredItems.length === 0}}" class="empty-inside">
              <text class="empty-icon">✨</text>
              <text class="empty-text">没有过期食材</text>
              <text class="empty-sub">继续保持哦~</text>
            </view>
            <view wx:for="{{expiredItems}}" wx:key="_id" class="fridge-item-card expired">
              <image class="item-img" src="{{item.image || 'https://placehold.co/120x120/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}"></image>
              <view class="item-info">
                <text class="item-name">{{item.name}}</text>
                <text class="item-origin">{{item.origin}}</text>
                <view class="item-bottom">
                  <text class="expire-date">已过期{{item.daysRemaining}}天</text>
                  <view class="status-badge expired">已过期</view>
                </view>
              </view>
              <view wx:if="{{isSelectMode}}" class="item-checkbox {{selectedIds.indexOf(item._id) > -1 ? 'checked' : ''}}" catchtap="onToggleSelect" data-id="{{item._id}}">
                <text wx:if="{{selectedIds.indexOf(item._id) > -1}}">✓</text>
              </view>
            </view>
            <view wx:if="{{expiredItems.length > 0}}" class="clear-expired-btn" bindtap="onClearExpired">
              <text>🗑️ 一键清理过期食材</text>
            </view>
          </block>
        </scroll-view>

        <view class="close-door-btn" catchtap="onCloseDoor">
          <text>关闭冰箱门</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isDoorOpen && isSelectMode && selectedIds.length > 0}}" class="batch-actions">
    <view class="batch-info">
      <text>已选 {{selectedIds.length}} 件</text>
    </view>
    <view class="batch-btn delete-btn" bindtap="onBatchDelete">
      <text>删除选中</text>
    </view>
  </view>
</view>

<view class="want-list-panel {{showWantPanel ? 'show' : ''}}">
  <view class="panel-header">
    <text class="panel-title">🥰 想吃清单</text>
    <view class="panel-actions">
      <view class="panel-btn" bindtap="onToggleWantSelectMode">
        <text>{{isWantSelectMode ? '取消' : '管理'}}</text>
      </view>
      <view class="panel-close" bindtap="onCloseWantPanel">✕</view>
    </view>
  </view>

  <view class="want-actions" wx:if="{{isWantSelectMode && selectedWantIds.length > 0}}">
    <text class="want-selected-count">已选 {{selectedWantIds.length}} 件</text>
    <view class="want-action-btn move-btn" bindtap="onBatchMoveToFridge">
      <text>🧊 移入冰箱</text>
    </view>
    <view class="want-action-btn delete-btn" bindtap="onBatchDeleteWant">
      <text>删除</text>
    </view>
  </view>

  <scroll-view class="want-list" scroll-y>
    <view wx:if="{{wantList.length === 0}}" class="empty-want">
      <text class="empty-icon">🍽️</text>
      <text class="empty-text">想吃清单空空如也</text>
      <text class="empty-sub">去榜单发现美食吧~</text>
    </view>

    <view wx:for="{{wantList}}" wx:key="_id" 
          class="want-item {{item.outOfSeason ? 'out-of-season' : ''}} {{isWantSelectMode && selectedWantIds.indexOf(item._id) > -1 ? 'selected' : ''}}"
          data-id="{{item._id}}"
          bindlongpress="onWantItemLongPress"
          bindtouchstart="onWantTouchStart"
          bindtouchmove="onWantTouchMove"
          bindtouchend="onWantTouchEnd">
      <view wx:if="{{isWantSelectMode}}" class="want-checkbox" catchtap="onToggleWantSelect" data-id="{{item._id}}">
        <text>{{selectedWantIds.indexOf(item._id) > -1 ? '✓' : ''}}</text>
      </view>
      <image class="want-img" src="{{item.image || 'https://placehold.co/120x120/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}"></image>
      <view class="want-info">
        <view class="want-name-row">
          <text class="want-name">{{item.name}}</text>
          <view wx:if="{{item.outOfSeason}}" class="out-of-season-tag">本年度已下市</view>
        </view>
        <text class="want-origin">{{item.origin}}</text>
        <view class="want-bottom">
          <text class="want-shelf">赏味期约 {{item.shelfLifeDays}} 天</text>
        </view>
      </view>
      <view class="want-actions-mini" wx:if="{{!isWantSelectMode}}">
        <view class="mini-btn move" catchtap="onMoveSingleToFridge" data-item="{{item}}">🧊</view>
        <view class="mini-btn delete" catchtap="onDeleteWantItem" data-id="{{item._id}}">🗑️</view>
      </view>
    </view>
  </scroll-view>
</view>

<view wx:if="{{showNoteModal}}" class="modal-overlay" bindtap="onCloseNoteModal">
  <view class="modal-content note-modal" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">美食备忘录</text>
    </view>
    <view class="modal-body">
      <text class="note-food-name">{{currentNoteItem.name}}</text>
      <textarea class="note-input" placeholder="记录保存方式、注意事项..." value="{{noteText}}" bindinput="onNoteInput" maxlength="100"></textarea>
      <text class="note-tip">可备注保存方式，如：开封后3天内吃完</text>
    </view>
    <view class="modal-footer">
      <view class="btn-secondary" bindtap="onCloseNoteModal">取消</view>
      <view class="btn-primary" bindtap="onSaveNote">保存</view>
    </view>
  </view>
</view>
