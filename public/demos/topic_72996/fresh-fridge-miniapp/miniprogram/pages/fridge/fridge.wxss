.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5E6 0%, #FFE8CC 100%);
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 32rpx 20rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF6B35;
}

.action-btn-mini {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
}

.seasonal-sticker {
  display: flex;
  align-items: center;
  margin: 0 32rpx 20rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFE0B2 0%, #FFCC80 100%);
  border-radius: 20rpx;
  transform: rotate(-1deg);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.2);
}

.sticker-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.sticker-content {
  flex: 1;
}

.sticker-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #E65100;
  margin-bottom: 4rpx;
}

.sticker-desc {
  font-size: 24rpx;
  color: #FF6F00;
}

.fridge-wrapper {
  padding: 0 24rpx;
  perspective: 1000px;
}

.fridge-body {
  position: relative;
  background: linear-gradient(180deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  min-height: 900rpx;
}

.fridge-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(180deg, #1565C0 0%, #1976D2 100%);
}

.fridge-brand {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.fridge-display {
  display: flex;
  gap: 20rpx;
}

.temp-cold,
.temp-fresh {
  font-size: 22rpx;
  color: #E3F2FD;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-family: monospace;
}

.fridge-doors {
  display: flex;
  position: relative;
  z-index: 10;
  min-height: 800rpx;
}

.door {
  flex: 1;
  position: relative;
  background: linear-gradient(135deg, #E3F2FD 0%, #90CAF9 100%);
  transition: transform 0.6s ease-in-out;
  transform-style: preserve-3d;
  min-height: 800rpx;
  border: 4rpx solid #64B5F6;
}

.door-left {
  border-right: 2rpx solid #64B5F6;
  border-radius: 0 0 0 24rpx;
  transform-origin: left center;
}

.door-right {
  border-left: 2rpx solid #64B5F6;
  border-radius: 0 0 24rpx 0;
  transform-origin: right center;
}

.door-left.open-left {
  transform: rotateY(-100deg);
}

.door-right.open-right {
  transform: rotateY(100deg);
}

.door-want-tags {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.mini-name {
  font-size: 20rpx;
  color: #455A64;
  background: rgba(255, 255, 255, 0.6);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capacity-bar {
  width: 80%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.capacity-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #8BC34A 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.door-handle {
  position: absolute;
  top: 50%;
  width: 12rpx;
  height: 120rpx;
  background: linear-gradient(180deg, #FFD54F 0%, #FFB300 100%);
  border-radius: 6rpx;
  transform: translateY(-50%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.door-left .door-handle {
  right: 16rpx;
}

.door-right .door-handle {
  left: 16rpx;
}

.door-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40rpx 20rpx;
}

.door-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1565C0;
  margin-bottom: 12rpx;
}

.door-count {
  font-size: 24rpx;
  color: #1976D2;
  margin-bottom: 24rpx;
}

.door-preview {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.preview-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.preview-more {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #1565C0;
  font-weight: 600;
}

.door-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-dot.fresh {
  background: #4CAF50;
}

.status-dot.expired {
  background: #F44336;
}

.status-text {
  font-size: 24rpx;
  color: #455A64;
}

.door-hint {
  font-size: 22rpx;
  color: #90A4AE;
  margin-top: 20rpx;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.fridge-inside {
  position: absolute;
  top: 80rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #E8F5E9 0%, #C8E6C9 100%);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease 0.3s, visibility 0.3s ease 0.3s;
  display: flex;
  flex-direction: column;
  z-index: 5;
  pointer-events: none;
}

.fridge-inside.visible {
  opacity: 1;
  visibility: visible;
  z-index: 20;
  pointer-events: auto;
}

.inside-tabs {
  display: flex;
  padding: 16rpx 20rpx;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.5);
}

.inside-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 12rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s;
}

.inside-tab text:first-child {
  font-size: 24rpx;
  font-weight: 600;
}

.inside-tab .tab-count {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.inside-tab.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  color: #fff;
  transform: scale(1.02);
}

.inside-tab.active .tab-count {
  color: rgba(255, 255, 255, 0.8);
}

.tab-count.expired-count {
  color: #F44336 !important;
}

.inside-tab.active .tab-count.expired-count {
  color: rgba(255, 255, 255, 0.8) !important;
}

.inside-content {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.fridge-item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  border-left: 8rpx solid #4CAF50;
}

.fridge-item-card.fresh {
  border-left-color: #4CAF50;
}

.fridge-item-card.warning {
  border-left-color: #FFC107;
}

.fridge-item-card.expired {
  border-left-color: #F44336;
  opacity: 0.8;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.item-origin {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.expire-date {
  font-size: 22rpx;
  color: #666;
}

.status-badge {
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.status-badge.fresh {
  background: #E8F5E9;
  color: #4CAF50;
}

.status-badge.warning {
  background: #FFF8E1;
  color: #FFA000;
}

.status-badge.expired {
  background: #FFEBEE;
  color: #F44336;
}

.item-note-btn {
  font-size: 36rpx;
  padding: 8rpx;
  margin-left: 8rpx;
}

.item-checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #ddd;
  border-radius: 50%;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.item-checkbox.checked {
  background: #FF6B35;
  border-color: #FF6B35;
}

.empty-inside {
  text-align: center;
  padding: 80rpx 0;
}

.empty-inside .empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-inside .empty-text {
  font-size: 30rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.empty-inside .empty-sub {
  font-size: 24rpx;
  color: #999;
}

.close-door-btn {
  margin: 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 30rpx;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.clear-expired-btn {
  margin: 20rpx 0;
  padding: 24rpx;
  background: #FFEBEE;
  border-radius: 20rpx;
  text-align: center;
  color: #F44336;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx dashed #F44336;
}

.batch-actions {
  position: fixed;
  bottom: 120rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.batch-info {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.batch-btn {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.batch-btn.delete-btn {
  background: #FFEBEE;
  color: #F44336;
}

.want-list-panel {
  position: fixed;
  top: 0;
  right: -100%;
  width: 85%;
  height: 100vh;
  background: #fff;
  z-index: 1000;
  transition: right 0.4s ease;
  display: flex;
  flex-direction: column;
  box-shadow: -8rpx 0 32rpx rgba(0, 0, 0, 0.1);
}

.want-list-panel.show {
  right: 0;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 80rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.panel-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.panel-btn {
  font-size: 26rpx;
  color: #fff;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.panel-close {
  font-size: 36rpx;
  color: #fff;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.want-actions {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFF8E1;
  border-bottom: 1rpx solid #FFE082;
}

.want-selected-count {
  flex: 1;
  font-size: 26rpx;
  color: #FF6F00;
  font-weight: 600;
}

.want-action-btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-left: 16rpx;
}

.want-action-btn.move-btn {
  background: #E8F5E9;
  color: #4CAF50;
}

.want-action-btn.delete-btn {
  background: #FFEBEE;
  color: #F44336;
}

.want-list {
  flex: 1;
  padding: 20rpx;
}

.want-item {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  position: relative;
  transition: all 0.3s;
}

.want-item.out-of-season {
  opacity: 0.5;
  filter: grayscale(0.7);
}

.want-item.selected {
  background: #FFF3E0;
  border: 2rpx solid #FF6B35;
}

.want-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #ddd;
  border-radius: 50%;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

.want-item.selected .want-checkbox {
  background: #FF6B35;
  border-color: #FF6B35;
}

.want-img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
}

.want-info {
  flex: 1;
}

.want-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.want-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.out-of-season-tag {
  font-size: 18rpx;
  color: #9E9E9E;
  background: #EEEEEE;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.want-origin {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.want-bottom {
  display: flex;
  align-items: center;
}

.want-shelf {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF3E0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.want-actions-mini {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.mini-btn {
  font-size: 32rpx;
  padding: 4rpx;
}

.empty-want {
  text-align: center;
  padding: 120rpx 0;
}

.empty-want .empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-want .empty-text {
  font-size: 30rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.empty-want .empty-sub {
  font-size: 24rpx;
  color: #999;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.note-modal {
  width: 85%;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.modal-body {
  padding: 32rpx;
}

.note-food-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
  margin-bottom: 20rpx;
  text-align: center;
}

.note-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.note-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn-secondary,
.btn-primary {
  flex: 1;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-secondary {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.btn-primary {
  color: #FF6B35;
}
