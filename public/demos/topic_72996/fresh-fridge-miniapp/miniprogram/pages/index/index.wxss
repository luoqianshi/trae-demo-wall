.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  padding: 60rpx 32rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
  flex: 1;
}

.filter-section {
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.filter-scroll {
  white-space: nowrap;
}

.filter-tabs {
  display: inline-flex;
  padding: 20rpx 32rpx;
  gap: 24rpx;
}

.filter-tab {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.filter-tab.active {
  background-color: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
  font-weight: 600;
}

.tab-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
  transform: scale(0.8);
}

.filter-panel {
  background-color: #fff;
  padding: 20rpx 32rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.filter-option.active {
  background-color: #FF6B35;
  color: #fff;
}

.seasonal-section {
  margin-top: 24rpx;
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
}

.seasonal-scroll {
  white-space: nowrap;
}

.seasonal-list {
  display: inline-flex;
  gap: 20rpx;
}

.seasonal-card {
  width: 320rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.seasonal-image {
  width: 100%;
  height: 200rpx;
}

.seasonal-info {
  padding: 20rpx;
}

.seasonal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.seasonal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 12rpx;
}

.mail-tag {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.seasonal-origin {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seasonal-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.seasonal-price {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
}

.seasonal-hot {
  font-size: 22rpx;
  color: #FF6B35;
}

.quick-entry {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  margin: 24rpx 32rpx 0;
  border-radius: 20rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FFF0E6 0%, #FFE4D6 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.entry-text {
  font-size: 24rpx;
  color: #666;
}

.tag-section {
  margin-top: 24rpx;
}

.tag-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.tag-list {
  display: inline-flex;
  gap: 16rpx;
}

.feature-tag {
  padding: 16rpx 28rpx;
  background-color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
  transition: all 0.3s;
}

.feature-tag.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  color: #fff;
}

.waterfall-section {
  margin-top: 24rpx;
  padding: 0 32rpx;
}

.waterfall-container {
  display: flex;
  gap: 20rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.food-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-image {
  width: 100%;
  height: 320rpx;
}

.card-content {
  padding: 20rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-origin {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-price {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: 600;
}

.card-mail-tag {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.card-hot {
  font-size: 22rpx;
  color: #FF6B35;
}

.empty-tip {
  padding: 60rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  width: 100%;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
