<view class="page-container">
  <view class="header">
    <view class="search-bar" bindtap="onSearchTap">
      <view class="search-icon">🔍</view>
      <text class="search-placeholder">搜索美食、城市、店铺...</text>
    </view>
  </view>

  <view class="filter-section">
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-tabs">
        <view class="filter-tab {{activeFilterTab === 'region' ? 'active' : ''}}" bindtap="onFilterTabTap" data-tab="region">
          <text>{{regionFilterText}}</text>
          <text class="tab-arrow">▼</text>
        </view>
        <view class="filter-tab {{activeFilterTab === 'category' ? 'active' : ''}}" bindtap="onFilterTabTap" data-tab="category">
          <text>{{categoryFilterText}}</text>
          <text class="tab-arrow">▼</text>
        </view>
        <view class="filter-tab {{activeFilterTab === 'time' ? 'active' : ''}}" bindtap="onFilterTabTap" data-tab="time">
          <text>{{timeFilterText}}</text>
          <text class="tab-arrow">▼</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{showFilterPanel}}" class="filter-panel">
      <view wx:if="{{activeFilterTab === 'region'}}" class="filter-options">
        <view class="filter-option {{regionFilter === 'all' ? 'active' : ''}}" bindtap="onRegionFilterTap" data-value="all">全国</view>
        <view class="filter-option {{regionFilter === 'hometown' ? 'active' : ''}}" bindtap="onRegionFilterTap" data-value="hometown">家乡</view>
        <view class="filter-option {{regionFilter === 'custom' ? 'active' : ''}}" bindtap="onRegionFilterTap" data-value="custom">自选省市</view>
      </view>

      <view wx:if="{{activeFilterTab === 'category'}}" class="filter-options">
        <view class="filter-option {{categoryFilter === 'all' ? 'active' : ''}}" bindtap="onCategoryFilterTap" data-value="all">全品类</view>
        <view class="filter-option {{categoryFilter === 'fruit' ? 'active' : ''}}" bindtap="onCategoryFilterTap" data-value="fruit">时令水果</view>
        <view class="filter-option {{categoryFilter === 'vegetable' ? 'active' : ''}}" bindtap="onCategoryFilterTap" data-value="vegetable">生鲜食材</view>
        <view class="filter-option {{categoryFilter === 'snack' ? 'active' : ''}}" bindtap="onCategoryFilterTap" data-value="snack">地方小吃</view>
        <view class="filter-option {{categoryFilter === 'seasonal' ? 'active' : ''}}" bindtap="onCategoryFilterTap" data-value="seasonal">季节限定</view>
      </view>

      <view wx:if="{{activeFilterTab === 'time'}}" class="filter-options">
        <view class="filter-option {{timeFilter === 'month' ? 'active' : ''}}" bindtap="onTimeFilterTap" data-value="month">按月份</view>
        <view class="filter-option {{timeFilter === 'season' ? 'active' : ''}}" bindtap="onTimeFilterTap" data-value="season">按季节</view>
        <view class="filter-option {{timeFilter === 'week' ? 'active' : ''}}" bindtap="onTimeFilterTap" data-value="week">本周应季</view>
      </view>
    </view>
  </view>

  <view class="seasonal-section">
    <view class="section-header">
      <text class="section-title">🌿 时令今日</text>
      <text class="section-subtitle">{{currentMonth}}月应季推荐</text>
    </view>
    <scroll-view class="seasonal-scroll" scroll-x>
      <view class="seasonal-list">
        <view wx:for="{{seasonalFoods}}" wx:key="_id" class="seasonal-card" bindtap="onFoodTap" data-id="{{item._id}}">
          <image class="seasonal-image" mode="aspectFill" src="{{item.images && item.images[0] ? item.images[0] : 'https://placehold.co/300x200/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}" data-src="{{item.images && item.images[0]}}"></image>
          <view class="seasonal-info">
            <view class="seasonal-top">
              <text class="seasonal-name">{{item.name}}</text>
              <view wx:if="{{item.canMail}}" class="mail-tag">可邮寄</view>
            </view>
            <text class="seasonal-origin">📍 {{item.origin}}</text>
            <view class="seasonal-bottom">
              <text class="seasonal-price">¥{{item.priceMin}}起</text>
              <text class="seasonal-hot">🔥 {{item.hotScore || item.voteCount || 0}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{seasonalFoods.length === 0}}" class="empty-tip">
          <text>暂无时令美食</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="quick-entry">
    <view class="entry-item" bindtap="onSeasonRankTap">
      <view class="entry-icon">🏆</view>
      <text class="entry-text">季节榜</text>
    </view>
    <view class="entry-item" bindtap="onRegionRankTap">
      <view class="entry-icon">🗺️</view>
      <text class="entry-text">地区榜</text>
    </view>
    <view class="entry-item" bindtap="onSubmitTap">
      <view class="entry-icon">📝</view>
      <text class="entry-text">我要投稿</text>
    </view>
    <view class="entry-item" bindtap="onFridgeTap">
      <view class="entry-icon">🧊</view>
      <text class="entry-text">我的冰箱</text>
    </view>
  </view>

  <view class="tag-section">
    <scroll-view class="tag-scroll" scroll-x>
      <view class="tag-list">
        <view class="feature-tag {{activeTag === 'mailable' ? 'active' : ''}}" bindtap="onFeatureTagTap" data-tag="mailable">
          <text>📦 可邮寄小吃</text>
        </view>
        <view class="feature-tag {{activeTag === 'seasonal' ? 'active' : ''}}" bindtap="onFeatureTagTap" data-tag="seasonal">
          <text>🌟 当季必吃</text>
        </view>
        <view class="feature-tag {{activeTag === 'fresh' ? 'active' : ''}}" bindtap="onFeatureTagTap" data-tag="fresh">
          <text>🥬 支持网购生鲜</text>
        </view>
        <view class="feature-tag {{activeTag === 'hometown' ? 'active' : ''}}" bindtap="onFeatureTagTap" data-tag="hometown">
          <text>🏠 本地家乡美食</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="waterfall-section">
    <view class="section-header">
      <text class="section-title">✨ 为你推荐</text>
    </view>
    <view class="waterfall-container">
      <view class="waterfall-column">
        <view wx:for="{{leftColumn}}" wx:key="_id" class="food-card" bindtap="onFoodTap" data-id="{{item._id}}">
          <image class="card-image" mode="aspectFill" src="{{item.images && item.images[0] ? item.images[0] : 'https://placehold.co/300x300/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}" data-src="{{item.images && item.images[0]}}"></image>
          <view class="card-content">
            <text class="card-name">{{item.name}}</text>
            <text class="card-origin">📍 {{item.origin}}</text>
            <view class="card-bottom">
              <text class="card-price">¥{{item.priceMin}}</text>
              <view wx:if="{{item.canMail}}" class="card-mail-tag">可邮寄</view>
            </view>
            <view class="card-hot">
              <text>🔥 {{item.hotScore || item.voteCount || 0}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="waterfall-column">
        <view wx:for="{{rightColumn}}" wx:key="_id" class="food-card" bindtap="onFoodTap" data-id="{{item._id}}">
          <image class="card-image" mode="aspectFill" src="{{item.images && item.images[0] ? item.images[0] : 'https://placehold.co/300x300/FF6B35/FFFFFF?text=Food'}}" binderror="onImageError" data-id="{{item._id}}" data-src="{{item.images && item.images[0]}}"></image>
          <view class="card-content">
            <text class="card-name">{{item.name}}</text>
            <text class="card-origin">📍 {{item.origin}}</text>
            <view class="card-bottom">
              <text class="card-price">¥{{item.priceMin}}</text>
              <view wx:if="{{item.canMail}}" class="card-mail-tag">可邮寄</view>
            </view>
            <view class="card-hot">
              <text>🔥 {{item.hotScore || item.voteCount || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="loading-more">
      <text>加载中...</text>
    </view>
    <view wx:if="{{!hasMore && recommendList.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>
