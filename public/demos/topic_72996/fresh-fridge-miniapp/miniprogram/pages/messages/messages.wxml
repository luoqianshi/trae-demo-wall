<view class="messages-page">
  <view class="top-bar">
    <view class="top-actions">
      <view class="top-action-btn" bindtap="onMarkAllRead">
        <text class="action-icon">✓</text>
        <text class="action-text">全部已读</text>
      </view>
      <view class="top-action-btn danger" bindtap="onClearAll">
        <text class="action-icon">🗑</text>
        <text class="action-text">清空</text>
      </view>
    </view>
    <view class="settings-entry" bindtap="onOpenSettings">
      <text class="settings-icon">⚙️</text>
      <text class="settings-text">通知设置</text>
    </view>
  </view>

  <scroll-view class="tab-bar" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
    <block wx:for="{{tabs}}" wx:key="id">
      <view class="tab-item {{activeTab === item.id ? 'active' : ''}}" bindtap="onTabChange" data-id="{{item.id}}">
        <text class="tab-name">{{item.name}}</text>
        <view wx:if="{{item.id === 'all' ? unreadTotal : unreadBreakdown[item.id]}}" class="tab-badge">
          {{item.id === 'all' ? (unreadTotal > 99 ? '99+' : unreadTotal) : (unreadBreakdown[item.id] > 99 ? '99+' : unreadBreakdown[item.id])}}
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="unread-summary" wx:if="{{unreadTotal > 0}}">
    <text class="summary-text">共 <text class="summary-num">{{unreadTotal}}</text> 条未读消息</text>
  </view>

  <view class="message-list" wx:if="{{messages.length > 0}}">
    <block wx:for="{{messages}}" wx:key="_id">
      <view class="message-item {{item.isRead ? 'read' : 'unread'}}" bindtap="onMessageTap" data-item="{{item}}">
        <view class="msg-icon" style="background: {{item.meta.bg}}; color: {{item.meta.color}};">
          <text>{{item.meta.icon}}</text>
        </view>
        <view class="msg-body">
          <view class="msg-header">
            <text class="msg-title">{{item.title}}</text>
            <view wx:if="{{!item.isRead}}" class="unread-dot"></view>
          </view>
          <text class="msg-content">{{item.content}}</text>
          <view class="msg-footer">
            <text class="msg-tag" wx:if="{{item.foodName}}">🍖 {{item.foodName}}</text>
            <text class="msg-time">{{item.createTimeText}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="load-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="load-more" wx:elif="{{!hasMore}}">
      <text>没有更多消息了</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{isEmpty}}">
    <text class="empty-icon">📭</text>
    <text class="empty-title">暂无消息</text>
    <text class="empty-desc">时令上新、临期与囤货提醒会在这里通知你</text>
  </view>
</view>
