.messages-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #ffffff;
}

.top-actions {
  display: flex;
  align-items: center;
}

.top-action-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(255, 107, 53, 0.1);
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.top-action-btn.danger {
  background: rgba(244, 67, 54, 0.1);
}

.top-action-btn .action-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.top-action-btn .action-text {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
}

.top-action-btn.danger .action-text {
  color: #F44336;
}

.settings-entry {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
}

.settings-entry .settings-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.settings-entry .settings-text {
  font-size: 24rpx;
  color: #666;
}

.tab-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.tab-item .tab-name {
  font-size: 26rpx;
  color: #666;
}

.tab-item.active .tab-name {
  color: #ffffff;
  font-weight: 600;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
  background: #F44336;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
}

.tab-item.active .tab-badge {
  background: #ffffff;
  color: #FF6B35;
}

.unread-summary {
  padding: 16rpx 32rpx;
}

.unread-summary .summary-text {
  font-size: 24rpx;
  color: #999;
}

.unread-summary .summary-num {
  color: #FF6B35;
  font-weight: 700;
}

.message-list {
  padding: 0 24rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.message-item.unread {
  background: linear-gradient(180deg, #FFFAF5 0%, #ffffff 100%);
}

.message-item.unread::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #FF6B35 0%, #FF8C42 100%);
}

.msg-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.msg-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-item.unread .msg-title {
  color: #1a1a1a;
}

.message-item.read .msg-title {
  color: #888;
  font-weight: 500;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: #F44336;
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.msg-content {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.message-item.read .msg-content {
  color: #aaa;
}

.msg-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.msg-tag {
  font-size: 22rpx;
  color: #FF6B35;
  background: rgba(255, 107, 53, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  font-size: 22rpx;
  color: #bbb;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  color: #bbb;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-state .empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-state .empty-title {
  font-size: 32rpx;
  color: #999;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-state .empty-desc {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
}
