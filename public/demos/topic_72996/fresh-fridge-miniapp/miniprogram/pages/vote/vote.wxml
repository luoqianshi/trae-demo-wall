<view class="container">
  <view class="header">
    <text class="header-title">美食投票榜</text>
    <text class="header-sub">每天为心仪的美食投票，助力上榜</text>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id"
          class="tab-item {{activeTab === item.id ? 'active' : ''}}"
          bindtap="onTabChange" data-id="{{item.id}}">
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="vote-list">
    <view wx:for="{{voteList}}" wx:key="_id" class="vote-card card" bindtap="onFoodTap" data-id="{{item._id}}">
      <view class="rank-badge rank-{{item.rank <= 3 ? item.rank : 'normal'}}">{{item.rank}}</view>
      <image class="food-image" src="{{item.images[0] || 'https://placehold.co/300x300/FF6B35/FFFFFF?text=Food'}}" mode="aspectFill" binderror="onImageError" data-id="{{item._id}}" data-src="{{item.images[0]}}"></image>
      <view class="food-info">
        <text class="food-name ellipsis">{{item.name}}</text>
        <text class="food-meta">{{item.categoryName}}{{item.origin ? ' · ' + item.origin : ''}}</text>
        <view class="vote-stat">
          <text class="vote-num">{{item.displayVotes}}</text>
          <text class="vote-label">票</text>
        </view>
      </view>
      <view class="vote-action" catchtap="onVote" data-id="{{item._id}}">
        <text wx:if="{{votedIds.indexOf(item._id) > -1}}" class="voted-tag">✓ 已投</text>
        <text wx:else class="vote-btn">投票</text>
      </view>
    </view>

    <view wx:if="{{isEmpty && !loading}}" class="empty-state">
      <text class="empty-icon">🗳️</text>
      <text class="empty-text">暂无投票数据</text>
    </view>

    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
