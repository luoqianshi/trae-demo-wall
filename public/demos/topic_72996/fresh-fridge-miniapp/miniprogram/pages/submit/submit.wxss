.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 顶部说明 */
.header {
  padding: 48rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  display: block;
}

/* 区块卡片 */
.section {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.section-tag {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #FF6B35;
  background: rgba(255, 107, 53, 0.1);
  border-radius: 20rpx;
}

.snack-header {
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #FFE0B2;
  margin-bottom: 28rpx;
}

.snack-tag {
  color: #fff;
  background: #FF6B35;
}

.snack-section {
  background: linear-gradient(180deg, #FFF8F0 0%, #ffffff 30%);
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.required {
  color: #FF6B35;
  margin-left: 8rpx;
  font-size: 28rpx;
}

.multi-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #999;
  background: #f0f0f0;
  border-radius: 16rpx;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.form-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 品类选择 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  width: calc(33.33% - 11rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.3s;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.category-item.selected {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-color: #FF6B35;
}

.cat-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.category-item.selected .cat-name {
  color: #FF6B35;
  font-weight: 600;
}

.cat-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
  display: block;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
}

.add-icon {
  font-size: 64rpx;
  color: #ccc;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.upload-progress {
  margin-top: 20rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FF8C42 100%);
  transition: width 0.2s;
}

.progress-text {
  display: block;
  font-size: 22rpx;
  color: #FF6B35;
  margin-top: 8rpx;
  text-align: center;
}

/* 选择器行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.picker-value.placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 价格 */
.price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-input {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.price-divider {
  font-size: 32rpx;
  color: #ccc;
  margin-top: 24rpx;
}

.unit-picker {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  margin-top: 24rpx;
}

.unit-text {
  font-size: 26rpx;
  color: #333;
}

/* 开关项 */
.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-item .form-label {
  margin-bottom: 0;
}

/* 年限输入 */
.years-input {
  display: flex;
  align-items: center;
  position: relative;
}

.years-input .form-input {
  padding-right: 60rpx;
}

.years-unit {
  position: absolute;
  right: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 快递多选 */
.express-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.express-item {
  padding: 16rpx 28rpx;
  background: #f8f8f8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.express-item.selected {
  background: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
  border-color: #FF6B35;
  font-weight: 500;
}

/* 购买渠道 */
.channel-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.channel-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.channel-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.channel-input {
  flex: 1;
  height: 60rpx;
  background: transparent;
  padding: 0;
}

/* 审核说明 */
.audit-tip {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #FFF8E1;
  border-radius: 20rpx;
  display: flex;
  align-items: flex-start;
}

.audit-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.audit-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.audit-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.audit-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-btn {
  padding: 28rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 40rpx;
  text-align: center;
  transition: all 0.3s;
}

.submit-btn.disabled {
  background: #ccc;
}

.submit-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 弹窗 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel {
  font-size: 28rpx;
  color: #999;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.picker-confirm {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
}

.picker-view {
  height: 480rpx;
}

.picker-item {
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}

/* 月份多选弹窗 */
.month-picker-content {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 32rpx;
  gap: 20rpx;
}

.month-item {
  width: calc(25% - 15rpx);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.month-item.selected {
  background: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
  border-color: #FF6B35;
  font-weight: 600;
}

/* 成功弹窗 */
.success-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.success-content {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  color: #fff;
  border-radius: 50%;
  font-size: 72rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.success-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
  text-align: center;
}

.success-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 40rpx;
  text-align: center;
}

.success-btn text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
