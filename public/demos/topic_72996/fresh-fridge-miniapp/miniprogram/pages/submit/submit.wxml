<view class="container">
  <!-- 顶部说明 -->
  <view class="header">
    <view class="header-title">发布投稿</view>
    <view class="header-desc">分享你的食鲜发现，让更多人品尝到美味</view>
  </view>

  <!-- 基础信息 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">基础信息</text>
      <text class="section-tag">必填</text>
    </view>

    <!-- 美食名称 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-text">美食名称</text>
        <text class="required">*</text>
      </view>
      <input class="form-input" placeholder="请输入美食名称" value="{{formData.name}}" bindinput="onInputName" maxlength="20" />
    </view>

    <!-- 品类选择 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-text">品类选择</text>
        <text class="required">*</text>
      </view>
      <view class="category-grid">
        <block wx:for="{{categories}}" wx:key="id">
          <view class="category-item {{formData.category === item.id ? 'selected' : ''}}" bindtap="onSelectCategory" data-id="{{item.id}}">
            <text class="cat-icon">{{item.icon}}</text>
            <text class="cat-name">{{item.name}}</text>
            <view wx:if="{{formData.category === item.id}}" class="cat-check">✓</view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">实拍图片</text>
      <text class="section-tag">必填</text>
    </view>
    <view class="image-grid">
      <block wx:for="{{formData.images}}" wx:key="*this">
        <view class="image-item">
          <image src="{{item}}" mode="aspectFill" class="preview-img" bindtap="onPreviewImage" data-index="{{index}}" />
          <view class="image-delete" catchtap="onDeleteImage" data-index="{{index}}">×</view>
        </view>
      </block>
      <view wx:if="{{formData.images.length < 9}}" class="image-add" bindtap="onChooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">{{formData.images.length}}/9</text>
      </view>
    </view>
    <view wx:if="{{isUploading}}" class="upload-progress">
      <view class="progress-bar">
        <view class="progress-inner" style="width: {{uploadProgress}}%;"></view>
      </view>
      <text class="progress-text">上传中 {{uploadProgress}}%</text>
    </view>
    <text class="form-tip">至少上传1张，最多9张实拍图片</text>
  </view>

  <!-- 产地信息 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">产地信息</text>
      <text class="section-tag">必填</text>
    </view>
    <view class="form-item">
      <view class="form-label">
        <text class="label-text">产地</text>
        <text class="required">*</text>
      </view>
      <view class="picker-row" bindtap="onShowRegionPicker">
        <text class="picker-value {{formData.originFull ? '' : 'placeholder'}}">{{formData.originFull || '请选择省/市/区'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 赏味时间 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">赏味时间</text>
      <text class="section-tag">必填</text>
    </view>

    <!-- 上市月份 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-text">上市月份</text>
        <text class="required">*</text>
      </view>
      <picker mode="selector" range="{{monthLabels}}" value="{{onShelfMonthIndex < 0 ? 0 : onShelfMonthIndex}}" bindchange="onSingleMonthChange" data-type="onShelfMonth">
        <view class="picker-row">
          <text class="picker-value {{formData.onShelfMonth ? '' : 'placeholder'}}">{{formData.onShelfMonth ? formData.onShelfMonth + '月' : '请选择上市月份'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 最佳赏味月份 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-text">最佳赏味月份</text>
        <text class="required">*</text>
        <text class="multi-tag">多选</text>
      </view>
      <view class="picker-row" bindtap="onShowMonthPicker" data-type="bestTasteMonths">
        <text class="picker-value {{formData.bestTasteMonths.length > 0 ? '' : 'placeholder'}}">
          {{formData.bestTasteMonths.length > 0 ? formData.bestTasteMonths : '请选择最佳赏味月份'}}{{formData.bestTasteMonths.length > 0 ? '月' : ''}}
        </text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <!-- 下市月份 -->
    <view class="form-item">
      <view class="form-label">
        <text class="label-text">下市月份</text>
        <text class="required">*</text>
      </view>
      <picker mode="selector" range="{{monthLabels}}" value="{{offShelfMonthIndex < 0 ? 0 : offShelfMonthIndex}}" bindchange="onSingleMonthChange" data-type="offShelfMonth">
        <view class="picker-row">
          <text class="picker-value {{formData.offShelfMonth ? '' : 'placeholder'}}">{{formData.offShelfMonth ? formData.offShelfMonth + '月' : '请选择下市月份'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <text class="form-tip">上市月份需早于下市月份</text>
  </view>

  <!-- 参考价格 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">参考价格</text>
      <text class="section-tag">必填</text>
    </view>
    <view class="price-row">
      <view class="price-input">
        <text class="price-label">最低价</text>
        <input class="form-input" type="digit" placeholder="0.00" value="{{formData.priceMin}}" bindinput="onInputPriceMin" />
      </view>
      <text class="price-divider">~</text>
      <view class="price-input">
        <text class="price-label">最高价</text>
        <input class="form-input" type="digit" placeholder="0.00" value="{{formData.priceMax}}" bindinput="onInputPriceMax" />
      </view>
      <picker mode="selector" range="{{priceUnits}}" value="{{priceUnitIndex}}" bindchange="onPriceUnitChange">
        <view class="unit-picker">
          <text class="unit-text">{{priceUnits[priceUnitIndex]}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <text class="form-tip">最低价不能大于最高价</text>
  </view>

  <!-- 食用小贴士 -->
  <view class="section card">
    <view class="section-header">
      <text class="section-title">食用小贴士</text>
      <text class="section-tag">必填</text>
    </view>
    <textarea class="form-textarea" placeholder="分享食用方法、搭配建议、注意事项等" value="{{formData.tips}}" bindinput="onInputTips" maxlength="200" />
    <text class="form-tip">{{formData.tips.length}}/200</text>
  </view>

  <!-- 小吃店铺专属信息 -->
  <block wx:if="{{isSnackShop}}">
    <view class="section card snack-section">
      <view class="section-header snack-header">
        <text class="section-title">🏪 店铺专属信息</text>
        <text class="section-tag snack-tag">小吃必填</text>
      </view>

      <!-- 店铺名称 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-text">店铺名称</text>
          <text class="required">*</text>
        </view>
        <input class="form-input" placeholder="请输入店铺名称" value="{{formData.shopName}}" bindinput="onInputShopName" maxlength="30" />
      </view>

      <!-- 门店地址 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-text">门店地址</text>
          <text class="required">*</text>
        </view>
        <textarea class="form-textarea" placeholder="请输入详细门店地址" value="{{formData.shopAddress}}" bindinput="onInputShopAddress" maxlength="100" />
      </view>

      <!-- 开业年限 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-text">开业年限</text>
          <text class="required">*</text>
        </view>
        <view class="years-input">
          <input class="form-input" type="number" placeholder="请输入开业年限" value="{{formData.shopYears}}" bindinput="onInputShopYears" />
          <text class="years-unit">年</text>
        </view>
      </view>

      <!-- 是否支持邮寄 -->
      <view class="form-item switch-item">
        <view class="form-label">
          <text class="label-text">是否支持邮寄</text>
        </view>
        <switch checked="{{formData.canMail}}" bindchange="onCanMailChange" color="#FF6B35" />
      </view>

      <!-- 邮寄相关字段（仅当支持邮寄时显示） -->
      <block wx:if="{{formData.canMail}}">
        <!-- 邮寄包装 -->
        <view class="form-item">
          <view class="form-label">
            <text class="label-text">邮寄包装</text>
            <text class="required">*</text>
          </view>
          <picker mode="selector" range="{{mailPackages}}" value="{{mailPackageIndex}}" bindchange="onMailPackageChange">
            <view class="picker-row">
              <text class="picker-value {{formData.mailPackage ? '' : 'placeholder'}}">{{formData.mailPackage || '请选择邮寄包装'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>

        <!-- 可用快递 -->
        <view class="form-item">
          <view class="form-label">
            <text class="label-text">可用快递</text>
            <text class="required">*</text>
            <text class="multi-tag">多选</text>
          </view>
          <view class="express-grid">
            <block wx:for="{{expressOptions}}" wx:key="*this">
              <view class="express-item {{selectedExpress.indexOf(item) > -1 ? 'selected' : ''}}" bindtap="onToggleExpress" data-express="{{item}}">
                <text>{{item}}</text>
              </view>
            </block>
          </view>
        </view>

        <!-- 真空保质期 -->
        <view class="form-item">
          <view class="form-label">
            <text class="label-text">真空保质期</text>
            <text class="required">*</text>
          </view>
          <view class="years-input">
            <input class="form-input" type="number" placeholder="请输入保质期天数" value="{{formData.shelfLifeDays}}" bindinput="onInputShelfLife" />
            <text class="years-unit">天</text>
          </view>
        </view>

        <!-- 运费规则 -->
        <view class="form-item">
          <view class="form-label">
            <text class="label-text">运费规则</text>
            <text class="required">*</text>
          </view>
          <textarea class="form-textarea" placeholder="例如：满99包邮，不足99运费10元" value="{{formData.shippingRule}}" bindinput="onInputShippingRule" maxlength="100" />
        </view>

        <!-- 偏远地区是否发货 -->
        <view class="form-item switch-item">
          <view class="form-label">
            <text class="label-text">偏远地区是否发货</text>
          </view>
          <switch checked="{{formData.remoteAreaShip}}" bindchange="onRemoteAreaChange" color="#FF6B35" />
        </view>
      </block>

      <!-- 购买渠道 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-text">购买渠道</text>
        </view>
        <view class="channel-list">
          <view class="channel-item">
            <text class="channel-label">老板微信</text>
            <input class="form-input channel-input" placeholder="请输入老板微信号" value="{{formData.bossWechat}}" bindinput="onInputBossWechat" />
          </view>
          <view class="channel-item">
            <text class="channel-label">淘宝店铺</text>
            <input class="form-input channel-input" placeholder="请输入淘宝店铺名" value="{{formData.taobaoShop}}" bindinput="onInputTaobaoShop" />
          </view>
          <view class="channel-item">
            <text class="channel-label">拼多多店铺</text>
            <input class="form-input channel-input" placeholder="请输入拼多多店铺名" value="{{formData.pddShop}}" bindinput="onInputPddShop" />
          </view>
        </view>
      </view>

      <!-- 邮寄避雷贴士 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-text">邮寄避雷贴士</text>
        </view>
        <textarea class="form-textarea" placeholder="分享邮寄避雷经验，例如哪些地区易损、收到后如何保存等" value="{{formData.mailTips}}" bindinput="onInputMailTips" maxlength="200" />
        <text class="form-tip">{{formData.mailTips.length}}/200</text>
      </view>
    </view>
  </block>

  <!-- 审核说明 -->
  <view class="audit-tip card">
    <text class="audit-icon">📋</text>
    <view class="audit-content">
      <text class="audit-title">审核说明</text>
      <text class="audit-text">投稿提交后将进入审核队列，通过机器初审和人工审核后将在榜单公开展示。请确保内容真实、图片原创。</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <view class="submit-btn {{isSubmitting ? 'disabled' : ''}}" bindtap="onSubmit">
      <text>{{isSubmitting ? '提交中...' : '提交投稿'}}</text>
    </view>
  </view>
</view>

<!-- 产地选择弹窗 -->
<view wx:if="{{showRegionPicker}}" class="picker-modal" bindtap="onHideRegionPicker">
  <view class="picker-content" catchtap="stopPropagation">
    <view class="picker-header">
      <text class="picker-cancel" bindtap="onHideRegionPicker">取消</text>
      <text class="picker-title">选择产地</text>
      <text class="picker-confirm" bindtap="onConfirmRegion">确定</text>
    </view>
    <picker-view class="picker-view" indicator-style="height: 80rpx;" value="{{regionIndex}}" bindchange="onRegionChange">
      <picker-view-column>
        <view wx:for="{{regionColumns[0]}}" wx:key="*this" class="picker-item">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{regionColumns[1]}}" wx:key="*this" class="picker-item">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{regionColumns[2]}}" wx:key="*this" class="picker-item">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>
</view>

<!-- 最佳赏味月份多选弹窗 -->
<view wx:if="{{showMonthPicker}}" class="picker-modal" bindtap="onHideMonthPicker">
  <view class="picker-content month-picker-content" catchtap="stopPropagation">
    <view class="picker-header">
      <text class="picker-cancel" bindtap="onHideMonthPicker">取消</text>
      <text class="picker-title">选择最佳赏味月份</text>
      <text class="picker-confirm" bindtap="onConfirmMonth">确定</text>
    </view>
    <view class="month-grid">
      <block wx:for="{{months}}" wx:key="*this">
        <view class="month-item {{formData.bestTasteMonths.indexOf(item) > -1 ? 'selected' : ''}}" bindtap="onToggleMonth" data-month="{{item}}">
          <text>{{item}}月</text>
        </view>
      </block>
    </view>
  </view>
</view>

<!-- 提交成功弹窗 -->
<view wx:if="{{showSuccess}}" class="success-modal">
  <view class="success-content">
    <view class="success-icon">✓</view>
    <text class="success-title">提交成功</text>
    <text class="success-desc">您的投稿已进入审核队列</text>
    <text class="success-tip">审核通过后将在榜单公开展示</text>
    <view class="success-btn" bindtap="onViewSubmission">
      <text>知道了</text>
    </view>
  </view>
</view>
