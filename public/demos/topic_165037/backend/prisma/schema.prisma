generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String
  nickname      String?
  examStage     Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userVocabulary  UserVocabulary[]
  readingHistory  ReadingHistory[]
}

model Article {
  id               String    @id @default(cuid())
  title            String
  sourceUrl        String?
  sourceName       String?
  category         String?
  originalContent  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  variants  ArticleVariant[]

  @@index([category])
  @@index([createdAt])
}

model ArticleVariant {
  id                String    @id @default(cuid())
  articleId         String
  difficultyLevel   Int
  content           String
  translatedContent String
  wordCount         Int
  createdAt         DateTime  @default(now())

  article       Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  readingHistory ReadingHistory[]

  @@unique([articleId, difficultyLevel])
  @@index([articleId])
  @@index([difficultyLevel])
}

model QuizQuestion {
  id                 String    @id @default(cuid())
  articleVariantId   String
  question           String
  optionA            String
  optionB            String
  optionC            String
  optionD            String
  correctAnswer      String
  explanation        String
  questionType       String?
  orderNum           Int       @default(1)
  createdAt          DateTime  @default(now())

  articleVariant  ArticleVariant @relation(fields: [articleVariantId], references: [id], onDelete: Cascade)
  quizAnswers     QuizAnswer[]

  @@index([articleVariantId])
}

model UserVocabulary {
  id                String    @id @default(cuid())
  userId            String
  word              String
  phonetic          String?
  meaning           String
  example           String?
  consecutiveKnown  Int       @default(0)
  lastReviewDate    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId])
  @@index([lastReviewDate])
}

model ReadingHistory {
  id                String    @id @default(cuid())
  userId            String
  articleVariantId  String
  score             Int?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleVariant ArticleVariant @relation(fields: [articleVariantId], references: [id], onDelete: Cascade)
  quizAnswers    QuizAnswer[]

  @@index([userId])
  @@index([completedAt])
}

model QuizAnswer {
  id                String    @id @default(cuid())
  readingHistoryId  String
  questionId        String
  userAnswer        String?
  isCorrect         Boolean?

  readingHistory  ReadingHistory @relation(fields: [readingHistoryId], references: [id], onDelete: Cascade)
  question        QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([readingHistoryId])
  @@index([questionId])
}
