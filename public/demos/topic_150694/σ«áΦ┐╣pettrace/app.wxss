page {
  background-color: #FFF9F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Open Sans', 'Helvetica Neue', sans-serif;
  color: #2D3436;
  line-height: 1.6;
}

:root {
  --primary: #FF7A59;
  --primary-light: #FFA987;
  --secondary: #4ECDC4;
  --warm-bg: #FFF9F5;
  --text-primary: #2D3436;
  --text-secondary: #636E72;
  --border: #F0E6E0;
}

.container {
  padding: 0 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border: none;
  border-radius: 16rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.btn-primary:hover {
  opacity: 0.9;
}

.btn-secondary {
  background: #FFFFFF;
  color: #FF7A59;
  border: 2rpx solid #FF7A59;
  border-radius: 16rpx;
  font-weight: 600;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #2D3436;
}

.section-subtitle {
  font-size: 28rpx;
  color: #636E72;
  margin-bottom: 32rpx;
}

.status-lost {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
}

.status-found {
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
  color: white;
}

.status-adopt {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.status-found-back {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: white;
}
