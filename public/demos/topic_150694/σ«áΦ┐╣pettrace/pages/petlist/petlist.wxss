.page {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: 20px;
}

.list-header {
  background: linear-gradient(135deg, #FF7A59 0%, #FF9F7F 100%);
  padding: 30px 24px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 20px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4px;
}

.header-count {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.85);
}

.filter-bar {
  background: #fff;
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-tabs {
  display: flex;
  gap: 8px;
}

.filter-tab {
  padding: 8px 16px;
  font-size: 14px;
  color: #666;
  background: #F5F5F5;
  border-radius: 20px;
  transition: all 0.3s;
}

.filter-tab.active {
  background: #FF7A59;
  color: #fff;
}

.sort-btn {
  padding: 8px 16px;
  font-size: 14px;
  color: #666;
  background: #F5F5F5;
  border-radius: 20px;
  transition: all 0.3s;
}

.sort-btn.active {
  background: #FF7A59;
  color: #fff;
}

.pet-scroll {
  height: calc(100vh - 180px);
}

.pet-list {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pet-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  display: flex;
}

.pet-image-wrap {
  width: 120px;
  height: 120px;
  position: relative;
  flex-shrink: 0;
}

.pet-image {
  width: 100%;
  height: 100%;
}

.pet-status {
  position: absolute;
  top: 8px;
  left: 8px;
  padding: 3px 8px;
  font-size: 11px;
  color: #fff;
  border-radius: 4px;
}

.pet-status.lost {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.pet-status.found {
  background: linear-gradient(135deg, #4ECDC4 0%, #6DD5ED 100%);
}

.pet-distance {
  position: absolute;
  bottom: 8px;
  left: 8px;
  font-size: 10px;
  color: #fff;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.pet-info {
  flex: 1;
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pet-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.pet-gender {
  font-size: 14px;
}

.pet-breed {
  font-size: 13px;
  color: #666;
}

.pet-meta {
  display: flex;
  gap: 12px;
}

.pet-time {
  font-size: 12px;
  color: #999;
}

.pet-location {
  font-size: 12px;
  color: #999;
}

.pet-actions {
  display: flex;
  gap: 16px;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 16px;
  color: #666;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 13px;
  color: #999;
}
