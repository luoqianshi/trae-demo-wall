<view class="page">
  <view class="search-header">
    <view class="header-left">
      <view class="back-btn" bindtap="goBack">
        <text>←</text>
      </view>
      <text class="header-title">AI智能搜索</text>
    </view>
  </view>

  <scroll-view class="search-scroll" scroll-y>
    <view class="image-upload-section">
      <text class="section-title">📷 上传宠物照片</text>
      <view class="upload-area" bindtap="chooseImage">
        <image class="upload-preview" src="{{uploadImage}}" wx:if="{{uploadImage}}" mode="aspectFill" />
        <view class="upload-placeholder" wx:else>
          <text class="upload-icon">📸</text>
          <text class="upload-text">点击上传宠物照片</text>
          <text class="upload-hint">支持 JPG、PNG 格式，最多9张</text>
        </view>
      </view>
      <view class="upload-actions" wx:if="{{uploadImage}}">
        <view class="upload-action-btn" bindtap="chooseImage">重新上传</view>
        <view class="upload-action-btn cancel" bindtap="clearImage">删除</view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="filter-section">
      <text class="section-title">🐾 文字描述智能筛选</text>
      <text class="section-subtitle">补充详细信息，缩小搜索范围，让匹配更精准</text>

      <view class="filter-row">
        <view class="filter-item">
          <text class="filter-label">🐶 宠物类型</text>
          <picker mode="selector" range="{{petTypes}}" bindchange="onPetTypeChange">
            <view class="filter-picker">{{selectedPetType || '全部类型'}}</view>
          </picker>
        </view>
        <view class="filter-item">
          <text class="filter-label">📅 丢失时间</text>
          <picker mode="selector" range="{{timeOptions}}" bindchange="onTimeChange">
            <view class="filter-picker">{{selectedTime || '不限时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="filter-row" wx:if="{{showOtherPetType}}">
        <view class="filter-item full">
          <text class="filter-label">📝 其他类型</text>
          <input class="filter-input" placeholder="请输入宠物类型，如：仓鼠、兔子等" value="{{otherPetType}}" bindinput="onOtherPetTypeInput" />
        </view>
      </view>

      <view class="filter-row">
        <view class="filter-item full">
          <text class="filter-label">📍 所在城市</text>
          <picker mode="selector" range="{{cities}}" bindchange="onCityChange">
            <view class="filter-picker">{{selectedCity || '选择城市'}}</view>
          </picker>
        </view>
      </view>

      <view class="filter-row">
        <view class="filter-item">
          <text class="filter-label">📍 丢失位置</text>
          <picker mode="selector" range="{{areas}}" bindchange="onAreaChange">
            <view class="filter-picker">{{selectedArea || '选择区域'}}</view>
          </picker>
        </view>
        <view class="filter-item">
          <text class="filter-label">📍 具体地点</text>
          <input class="filter-input" placeholder="输入具体地点" value="{{locationDetail}}" bindinput="onLocationInput" />
        </view>
      </view>

      <view class="filter-row">
        <text class="filter-label">⭐ 宠物特征/习惯</text>
      </view>
      <view class="feature-tags">
        <view class="feature-tag {{selectedFeatures.includes('温顺亲人') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="温顺亲人">温顺亲人</view>
        <view class="feature-tag {{selectedFeatures.includes('胆小怕人') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="胆小怕人">胆小怕人</view>
        <view class="feature-tag {{selectedFeatures.includes('活泼好动') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="活泼好动">活泼好动</view>
        <view class="feature-tag {{selectedFeatures.includes('已绝育') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="已绝育">已绝育</view>
        <view class="feature-tag {{selectedFeatures.includes('有项圈') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="有项圈">有项圈</view>
        <view class="feature-tag {{selectedFeatures.includes('有芯片') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="有芯片">有芯片</view>
        <view class="feature-tag {{selectedFeatures.includes('会握手') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="会握手">会握手</view>
        <view class="feature-tag {{selectedFeatures.includes('爱吃零食') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="爱吃零食">爱吃零食</view>
        <view class="feature-tag {{selectedFeatures.includes('害怕打雷') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="害怕打雷">害怕打雷</view>
        <view class="feature-tag {{selectedFeatures.includes('喜欢玩球') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="喜欢玩球">喜欢玩球</view>
        <view class="feature-tag {{selectedFeatures.includes('不怕生') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="不怕生">不怕生</view>
        <view class="feature-tag other {{otherFeature ? 'active' : ''}}" bindtap="showOtherInput">
          <text>+ 其他</text>
        </view>
      </view>

      <view class="other-input-wrap" wx:if="{{showOther}}">
        <input class="other-input" placeholder="请输入其他特征..." value="{{otherFeature}}" bindinput="onOtherInput" />
      </view>

      <view class="filter-row">
        <text class="filter-label">📝 详细描述（AI智能分析）</text>
        <text class="ai-label">AI</text>
      </view>
      <textarea class="description-textarea" placeholder="请详细描述丢失/发现情况，AI将自动分析并提取关键信息填入筛选条件...

例如：
• 6月25日傍晚在望京花园小区门口丢失
• 金毛犬，2岁，公，戴红色项圈" value="{{description}}" bindinput="onDescriptionInput" />

      <view class="action-buttons">
        <view class="action-btn secondary" bindtap="clearAll">
          <text>🗑️ 清空</text>
        </view>
        <view class="action-btn primary" bindtap="aiAnalyze">
          <text>✏️ AI智能分析</text>
        </view>
      </view>
    </view>

    <view class="result-section" wx:if="{{showResults}}">
      <text class="section-title">🔍 搜索结果</text>
      <view class="result-list">
        <view class="result-card" wx:for="{{searchResults}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
          <image class="result-image" src="{{item.image}}" mode="aspectFill" />
          <view class="result-info">
            <text class="result-name">{{item.name}}</text>
            <text class="result-meta">{{item.breed}} · {{item.gender}} · {{item.age}}</text>
            <text class="result-location">📍 {{item.location}}</text>
            <text class="result-distance">距离 {{item.distance}}km</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
