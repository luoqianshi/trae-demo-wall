.page {
  min-height: 100vh;
  background-color: #FFF9F5;
}

.search-header {
  background: linear-gradient(135deg, #FF7A59 0%, #FF9F7F 100%);
  padding: 60px 24px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.back-btn {
  width: 36px;
  height: 36px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 18px;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #fff;
}

.search-scroll {
  height: calc(100vh - 100px);
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
}

.section-subtitle {
  font-size: 13px;
  color: #999;
  margin-bottom: 16px;
}

.image-upload-section {
  padding: 20px;
  background: #fff;
}

.upload-area {
  width: 100%;
  height: 200px;
  border: 2px dashed #E0E0E0;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.upload-icon {
  font-size: 48px;
}

.upload-text {
  font-size: 15px;
  color: #666;
}

.upload-hint {
  font-size: 12px;
  color: #999;
}

.upload-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 12px;
}

.upload-action-btn {
  padding: 8px 16px;
  font-size: 13px;
  color: #FF7A59;
  background: #FFF0EB;
  border-radius: 20px;
}

.upload-action-btn.cancel {
  color: #999;
  background: #F5F5F5;
}

.divider {
  height: 12px;
  background: #F8F9FA;
}

.filter-section {
  padding: 20px;
  background: #fff;
}

.filter-row {
  display: flex;
  gap: 16px;
  margin-bottom: 16px;
}

.filter-item {
  flex: 1;
}

.filter-item.full {
  flex: 100%;
}

.filter-label {
  font-size: 13px;
  color: #666;
  margin-bottom: 8px;
  display: block;
}

.ai-label {
  font-size: 12px;
  color: #FF7A59;
  background: #FFF0EB;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: 8px;
}

.filter-picker {
  padding: 12px 16px;
  background: #F8F9FA;
  border-radius: 8px;
  font-size: 14px;
  color: #333;
}

.filter-input {
  padding: 12px 16px;
  background: #F8F9FA;
  border-radius: 8px;
  font-size: 14px;
  color: #333;
  width: 100%;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.feature-tag {
  padding: 8px 14px;
  background: #F5F5F5;
  border-radius: 20px;
  font-size: 13px;
  color: #666;
}

.feature-tag.active {
  background: #FFF0EB;
  color: #FF7A59;
}

.feature-tag.other {
  background: #FF7A59;
  color: #fff;
}

.feature-tag.other.active {
  background: #FF9F7F;
}

.other-input-wrap {
  margin-bottom: 16px;
}

.other-input {
  padding: 12px 16px;
  background: #F8F9FA;
  border-radius: 8px;
  font-size: 14px;
  color: #333;
  width: 100%;
  border: 1px solid #FF7A59;
}

.description-textarea {
  width: 100%;
  height: 160px;
  padding: 12px 16px;
  background: #F8F9FA;
  border-radius: 8px;
  font-size: 14px;
  color: #333;
  margin-bottom: 16px;
}

.action-buttons {
  display: flex;
  gap: 12px;
}

.action-btn {
  flex: 1;
  padding: 14px;
  text-align: center;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 500;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF7A59 0%, #FF9F7F 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #666;
}

.result-section {
  padding: 20px;
  background: #fff;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.result-card {
  display: flex;
  background: #F8F9FA;
  border-radius: 12px;
  overflow: hidden;
}

.result-image {
  width: 100px;
  height: 100px;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.result-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.result-meta {
  font-size: 13px;
  color: #666;
}

.result-location {
  font-size: 12px;
  color: #999;
}

.result-distance {
  font-size: 12px;
  color: #FF7A59;
}

.bottom-space {
  height: 30px;
}
