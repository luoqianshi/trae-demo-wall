.page {
  min-height: 100vh;
  background: #FFF9F5;
  display: flex;
  flex-direction: column;
}

.login-header {
  position: relative;
  height: 200rpx;
  background: linear-gradient(180deg, #FFF5F0 0%, #FFFFFF 100%);
  overflow: hidden;
}

.login-cat {
  position: absolute;
  left: 10%;
  bottom: 10rpx;
}

.login-dog {
  position: absolute;
  right: 10%;
  bottom: 10rpx;
}

.cat-body {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  animation: catIdle 2.5s ease-in-out infinite;
}

.cat-ear {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 24rpx solid #FFB8A0;
  top: 4rpx;
}

.cat-ear-left {
  left: 12rpx;
  transform: rotate(-15deg);
}

.cat-ear-right {
  right: 12rpx;
  transform: rotate(15deg);
}

.cat-ear::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 14rpx solid #FF8A65;
  top: 8rpx;
  left: -10rpx;
}

.cat-face {
  position: absolute;
  width: 80rpx;
  height: 72rpx;
  background: linear-gradient(180deg, #FFCCB3 0%, #FFB8A0 100%);
  border-radius: 50% 50% 45% 45%;
  top: 16rpx;
  left: 10rpx;
}

.cat-eye {
  position: absolute;
  width: 10rpx;
  height: 14rpx;
  background: #2D3436;
  border-radius: 50%;
  top: 26rpx;
  animation: blink 3s ease-in-out infinite;
}

.cat-eye-left { left: 20rpx; }
.cat-eye-right { right: 20rpx; }

.cat-nose {
  position: absolute;
  width: 8rpx;
  height: 6rpx;
  background: #FF6B8A;
  border-radius: 50%;
  top: 42rpx;
  left: 50%;
  transform: translateX(-50%);
}

.cat-mouth {
  position: absolute;
  width: 16rpx;
  height: 8rpx;
  border: 2rpx solid #2D3436;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  top: 48rpx;
  left: 50%;
  transform: translateX(-50%);
}

.cat-tail {
  position: absolute;
  width: 10rpx;
  height: 32rpx;
  background: #FFB8A0;
  border-radius: 12rpx;
  right: -4rpx;
  bottom: 12rpx;
  transform-origin: bottom center;
  transform: rotate(25deg);
  animation: catTail 1.5s ease-in-out infinite;
}

.dog-body {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  animation: dogIdle 2s ease-in-out infinite;
}

.dog-ear {
  position: absolute;
  width: 24rpx;
  height: 36rpx;
  background: #D4A574;
  border-radius: 50%;
  top: 10rpx;
}

.dog-ear-left {
  left: 4rpx;
  transform: rotate(-20deg);
}

.dog-ear-right {
  right: 4rpx;
  transform: rotate(20deg);
}

.dog-face {
  position: absolute;
  width: 80rpx;
  height: 72rpx;
  background: linear-gradient(180deg, #E8C9A0 0%, #D4B896 100%);
  border-radius: 50% 50% 45% 45%;
  top: 20rpx;
  left: 10rpx;
}

.dog-eye {
  position: absolute;
  width: 12rpx;
  height: 14rpx;
  background: #2D3436;
  border-radius: 50%;
  top: 24rpx;
  animation: blink 3.5s ease-in-out infinite;
}

.dog-eye-left { left: 18rpx; }
.dog-eye-right { right: 18rpx; }

.dog-nose {
  position: absolute;
  width: 14rpx;
  height: 10rpx;
  background: #2D3436;
  border-radius: 50%;
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
}

.dog-mouth {
  position: absolute;
  width: 18rpx;
  height: 8rpx;
  border: 2rpx solid #2D3436;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
  top: 50rpx;
  left: 50%;
  transform: translateX(-50%);
}

.dog-tail {
  position: absolute;
  width: 10rpx;
  height: 28rpx;
  background: #D4A574;
  border-radius: 12rpx;
  left: -4rpx;
  bottom: 14rpx;
  transform-origin: bottom center;
  transform: rotate(-30deg);
  animation: dogTail 0.6s ease-in-out infinite;
}

@keyframes catIdle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes dogIdle {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-4rpx) rotate(-2deg); }
  75% { transform: translateY(-4rpx) rotate(2deg); }
}

@keyframes blink {
  0%, 45%, 55%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(0.1); }
}

@keyframes catTail {
  0%, 100% { transform: rotate(25deg); }
  50% { transform: rotate(40deg); }
}

@keyframes dogTail {
  0%, 100% { transform: rotate(-30deg); }
  50% { transform: rotate(-50deg); }
}

.login-content {
  flex: 1;
  padding: 40rpx 48rpx;
}

.login-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.logo-icon {
  font-size: 48rpx;
}

.logo-text {
  font-size: 40rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.login-subtitle {
  text-align: center;
  font-size: 26rpx;
  color: #636E72;
  display: block;
  margin-bottom: 40rpx;
}

.login-tabs {
  display: flex;
  background: #F8F5F2;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}

.login-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #636E72;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.login-tab.active {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  font-weight: 600;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.form-item {
  position: relative;
  display: flex;
  align-items: center;
}

.form-icon {
  position: absolute;
  left: 28rpx;
  font-size: 32rpx;
  z-index: 1;
}

.form-input {
  width: 100%;
  padding: 28rpx 28rpx 28rpx 80rpx;
  background: white;
  border: 2rpx solid #F0E6E0;
  border-radius: 20rpx;
  font-size: 30rpx;
}

.form-input:focus {
  border-color: #FF7A59;
}

.code-btn {
  position: absolute;
  right: 16rpx;
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, rgba(255,122,89,0.1) 0%, rgba(255,169,135,0.1) 100%);
  color: #FF7A59;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.code-btn.disabled {
  background: #F0E6E0;
  color: #B2BEC3;
}

.agreement {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 24rpx;
  color: #636E72;
  gap: 8rpx;
}

.agree-checkbox {
  margin-right: 8rpx;
}

.link {
  color: #FF7A59;
}

.submit-btn {
  padding: 28rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 20rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.social-login {
  margin-top: 48rpx;
}

.divider {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #F0E6E0;
}

.divider text {
  font-size: 24rpx;
  color: #B2BEC3;
}

.social-icons {
  display: flex;
  justify-content: center;
  gap: 64rpx;
}

.social-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.social-icon text:first-child {
  font-size: 64rpx;
}

.social-icon text:last-child {
  font-size: 24rpx;
  color: #636E72;
}
