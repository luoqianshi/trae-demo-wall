<view class="page">
  <view class="login-header">
    <view class="login-cat">
      <view class="cat-body">
        <view class="cat-ear cat-ear-left"></view>
        <view class="cat-ear cat-ear-right"></view>
        <view class="cat-face">
          <view class="cat-eye cat-eye-left"></view>
          <view class="cat-eye cat-eye-right"></view>
          <view class="cat-nose"></view>
          <view class="cat-mouth"></view>
        </view>
        <view class="cat-tail"></view>
      </view>
    </view>
    <view class="login-dog">
      <view class="dog-body">
        <view class="dog-ear dog-ear-left"></view>
        <view class="dog-ear dog-ear-right"></view>
        <view class="dog-face">
          <view class="dog-eye dog-eye-left"></view>
          <view class="dog-eye dog-eye-right"></view>
          <view class="dog-nose"></view>
          <view class="dog-mouth"></view>
        </view>
        <view class="dog-tail"></view>
      </view>
    </view>
  </view>

  <view class="login-content">
    <view class="login-logo">
      <text class="logo-icon">🐾</text>
      <text class="logo-text">宠迹 PetTrace</text>
    </view>
    <text class="login-subtitle">{{currentTab === 'login' ? '登录后体验完整功能' : '注册账号，开启寻宠之旅'}}</text>

    <view class="login-tabs">
      <view class="login-tab {{currentTab === 'login' ? 'active' : ''}}" bindtap="switchTab" data-tab="login">登录</view>
      <view class="login-tab {{currentTab === 'register' ? 'active' : ''}}" bindtap="switchTab" data-tab="register">注册</view>
    </view>

    <view class="login-form">
      <view class="form-item">
        <text class="form-icon">📱</text>
        <input class="form-input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      
      <view class="form-item" wx:if="{{currentTab === 'register'}}">
        <text class="form-icon">👤</text>
        <input class="form-input" placeholder="请设置昵称" value="{{nickname}}" bindinput="onNicknameInput" />
      </view>

      <view class="form-item">
        <text class="form-icon">🔑</text>
        <input class="form-input" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
        <view class="code-btn {{codeBtnDisabled ? 'disabled' : ''}}" bindtap="sendCode" wx:if="{{!codeBtnDisabled}}">获取验证码</view>
        <view class="code-btn disabled" wx:else>{{codeCountdown}}s后重发</view>
      </view>

      <view class="agreement">
        <checkbox class="agree-checkbox" checked="{{agreed}}" bindchange="onAgreeChange" />
        <text>我已阅读并同意</text>
        <text class="link">《用户协议》</text>
        <text>和</text>
        <text class="link">《隐私政策》</text>
      </view>

      <view class="submit-btn {{!canSubmit ? 'disabled' : ''}}" bindtap="submitForm">
        <text>{{currentTab === 'login' ? '登 录' : '注 册'}}</text>
      </view>
    </view>

    <view class="social-login">
      <view class="divider">
        <text>其他登录方式</text>
      </view>
      <view class="social-icons">
        <view class="social-icon wechat" bindtap="socialLogin" data-platform="wechat">
          <text>💚</text>
          <text>微信</text>
        </view>
        <view class="social-icon weibo" bindtap="socialLogin" data-platform="weibo">
          <text>❤️</text>
          <text>微博</text>
        </view>
        <view class="social-icon qq" bindtap="socialLogin" data-platform="qq">
          <text>💙</text>
          <text>QQ</text>
        </view>
      </view>
    </view>
  </view>
</view>
