.page {
  min-height: 100vh;
  background: #FFF9F5;
  padding-bottom: 160rpx;
}

.detail-gallery {
  position: relative;
  width: 100%;
  height: 560rpx;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-status {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: white;
}

.detail-status.lost {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
}

.detail-status.found {
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
}

.detail-status.adopt {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.detail-favorite {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.detail-back {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: white;
  z-index: 1;
}

.detail-body {
  padding: 32rpx;
  margin-top: -40rpx;
  position: relative;
  background: #FFF9F5;
  border-radius: 40rpx 40rpx 0 0;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.detail-name {
  font-size: 44rpx;
  font-weight: 900;
  color: #2D3436;
  display: block;
  margin-bottom: 8rpx;
}

.detail-breed {
  font-size: 28rpx;
  color: #636E72;
}

.detail-distance {
  font-size: 26rpx;
  color: #FF7A59;
}

.detail-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.detail-info-item {
  display: flex;
  gap: 16rpx;
  background: white;
  padding: 20rpx;
  border-radius: 16rpx;
}

.info-icon {
  font-size: 32rpx;
}

.info-label {
  font-size: 22rpx;
  color: #B2BEC3;
  display: block;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 26rpx;
  color: #2D3436;
  font-weight: 500;
}

.detail-section {
  background: white;
  padding: 28rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  display: block;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #636E72;
  line-height: 1.6;
}

.publisher-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.publisher-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: white;
}

.publisher-info {
  flex: 1;
}

.publisher-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  display: block;
  margin-bottom: 8rpx;
}

.publisher-meta {
  display: flex;
  gap: 16rpx;
}

.publisher-meta text {
  font-size: 22rpx;
  color: #B2BEC3;
}

.contact-btn {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.comment-count {
  font-size: 26rpx;
  color: #636E72;
}

.comment-input-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.comment-input {
  flex: 1;
  padding: 20rpx;
  background: #F8F5F2;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn {
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: white;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
  background: #F8F5F2;
  padding: 20rpx;
  border-radius: 0 20rpx 20rpx 20rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D3436;
}

.comment-time {
  font-size: 22rpx;
  color: #B2BEC3;
}

.comment-text {
  font-size: 28rpx;
  color: #636E72;
  line-height: 1.5;
}

.comment-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #B2BEC3;
}

.reply-box {
  display: none;
  flex: 1;
  gap: 12rpx;
  margin-top: 16rpx;
}

.reply-box.show {
  display: flex;
}

.reply-input {
  flex: 1;
  padding: 16rpx;
  background: white;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.reply-btn {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.comment-replies {
  margin-top: 16rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #F0E6E0;
}

.reply-item {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
}

.reply-avatar {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: white;
  flex-shrink: 0;
}

.reply-content {
  flex: 1;
}

.reply-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2D3436;
}

.reply-text {
  font-size: 24rpx;
  color: #636E72;
}

.reply-time {
  font-size: 20rpx;
  color: #B2BEC3;
  display: block;
  margin-top: 4rpx;
}

.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
}

.action-btn.secondary {
  background: #F8F5F2;
  color: #636E72;
}
