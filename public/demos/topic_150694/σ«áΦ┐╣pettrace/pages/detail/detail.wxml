<view class="page">
  <view class="detail-gallery">
    <image class="detail-image" src="{{pet.image}}" mode="aspectFill" />
    <view class="detail-status {{pet.type}}">{{pet.statusText}}</view>
    <view class="detail-favorite" bindtap="toggleFavorite">
      <text>{{isFavorite ? '❤️' : '🤍'}}</text>
    </view>
    <view class="detail-back" bindtap="goBack">
      <text>←</text>
    </view>
  </view>

  <view class="detail-body">
    <view class="detail-header">
      <view>
        <text class="detail-name">{{pet.name}}</text>
        <text class="detail-breed">{{pet.breed}} · {{pet.gender}} · {{pet.age}}</text>
      </view>
      <view class="detail-distance">
        <text>📍 {{pet.distance}}km</text>
      </view>
    </view>

    <view class="detail-info-grid">
      <view class="detail-info-item">
        <text class="info-icon">⏰</text>
        <view>
          <text class="info-label">发布时间</text>
          <text class="info-value">{{pet.publishTime}}</text>
        </view>
      </view>
      <view class="detail-info-item">
        <text class="info-icon">📍</text>
        <view>
          <text class="info-label">丢失位置</text>
          <text class="info-value">{{pet.location}}</text>
        </view>
      </view>
      <view class="detail-info-item">
        <text class="info-icon">📅</text>
        <view>
          <text class="info-label">丢失时间</text>
          <text class="info-value">{{pet.lostTime}}</text>
        </view>
      </view>
      <view class="detail-info-item">
        <text class="info-icon">🐾</text>
        <view>
          <text class="info-label">特征</text>
          <text class="info-value">{{pet.features}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <text class="section-title">📝 详细描述</text>
      <text class="section-content">{{pet.description}}</text>
    </view>

    <view class="detail-section">
      <text class="section-title">👤 发布人</text>
      <view class="publisher-card">
        <view class="publisher-avatar">{{pet.publisherAvatar}}</view>
        <view class="publisher-info">
          <text class="publisher-name">{{pet.publisher}}</text>
          <view class="publisher-meta">
            <text>✅ 实名认证</text>
            <text>📅 注册2年</text>
          </view>
        </view>
        <view class="contact-btn" bindtap="contactPublisher">
          <text>💬 联系TA</text>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="comment-header">
        <text class="section-title">💬 留言交流</text>
        <text class="comment-count">({{pet.commentCount}})</text>
      </view>
      <view class="comment-input-box">
        <input class="comment-input" placeholder="说点什么吧..." value="{{commentInput}}" bindinput="onCommentInput" bindconfirm="postComment" />
        <view class="send-btn" bindtap="postComment">发送</view>
      </view>
      <view class="comment-list">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <view class="comment-avatar">{{item.avatar}}</view>
          <view class="comment-content">
            <view class="comment-header">
              <text class="comment-name">{{item.name}}</text>
              <text class="comment-time">{{item.time}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
            <view class="comment-actions">
              <view class="action-btn" bindtap="likeComment" data-id="{{item.id}}">
                <text>{{item.liked ? '❤️' : '🤍'}}</text>
                <text>{{item.likes}}</text>
              </view>
              <view class="action-btn" bindtap="replyComment" data-id="{{item.id}}">
                <text>💬 回复</text>
              </view>
            </view>
            <view class="reply-box {{replyId === item.id ? 'show' : ''}}" wx:if="{{replyId === item.id}}">
              <input class="reply-input" placeholder="回复{{item.name}}..." value="{{replyInput}}" bindinput="onReplyInput" bindconfirm="submitReply" />
              <view class="reply-btn" bindtap="submitReply">发送</view>
            </view>
            <view class="comment-replies" wx:if="{{item.hasReplies}}">
              <view class="reply-item" wx:for="{{item.replies}}" wx:key="index" wx:for-item="reply">
                <view class="reply-avatar">{{reply.avatar}}</view>
                <view class="reply-content">
                  <text class="reply-name">{{reply.name}}</text>
                  <text class="reply-text">{{reply.content}}</text>
                  <text class="reply-time">{{reply.time}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="detail-actions">
    <view class="action-btn secondary" bindtap="sharePet">
      <text>🔗 分享扩散</text>
    </view>
    <view class="action-btn primary" bindtap="contactPublisher">
      <text>📞 立即联系发布人</text>
    </view>
  </view>
</view>
