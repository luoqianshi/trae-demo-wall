<view class="page">
  <view class="adoption-header">
    <text class="header-title">领养平台</text>
    <text class="header-subtitle">给流浪毛孩子一个温暖的家</text>
  </view>

  <view class="filter-tabs">
    <view class="filter-tab {{currentType === 'all' ? 'active' : ''}}" bindtap="setType" data-type="all">全部</view>
    <view class="filter-tab {{currentType === 'dog' ? 'active' : ''}}" bindtap="setType" data-type="dog">🐶 狗狗</view>
    <view class="filter-tab {{currentType === 'cat' ? 'active' : ''}}" bindtap="setType" data-type="cat">🐱 猫咪</view>
  </view>

  <view class="adoption-list">
    <view class="adoption-card" wx:for="{{adoptedPets}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="adoption-image-wrap">
        <image class="adoption-image" src="{{item.image}}" mode="aspectFill" />
        <view class="adoption-status">待领养</view>
      </view>
      <view class="adoption-orange-bar">
        <text class="orange-bar-title">{{item.name}} · {{item.breed}} · {{item.age}}</text>
        <text class="orange-bar-desc">{{item.features}}</text>
      </view>
      <view class="adoption-info">
        <view class="adoption-meta">
          <text class="meta-item">{{item.location}}</text>
          <text class="meta-item">📍 {{item.distance}}km</text>
        </view>
        <view class="adoption-publisher">
          <text class="publisher-icon">🏠</text>
          <text>{{item.publisher}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{adoptedPets.length === 0}}">
    <text class="empty-icon">🐾</text>
    <text class="empty-text">暂无待领养的宠物</text>
    <text class="empty-hint">稍后再来看看吧</text>
  </view>

  <view class="action-bar">
    <view class="action-btn primary" bindtap="goToPublish">
      <text>📝 发布领养信息</text>
    </view>
    <view class="action-btn secondary" bindtap="goToPreference">
      <text>❤️ 我的领养偏好</text>
    </view>
  </view>
</view>
