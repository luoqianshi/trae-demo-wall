.page {
  min-height: 100vh;
  background: #FFF9F5;
  padding-bottom: 280rpx;
}

.adoption-header {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  padding: 48rpx 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 900;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.filter-tabs {
  display: flex;
  background: rgba(255,255,255,0.95);
  margin: -32rpx 32rpx 32rpx;
  border-radius: 28rpx;
  padding: 12rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 122, 89, 0.15);
  backdrop-filter: blur(10px);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 16rpx;
  font-size: 30rpx;
  color: #636E72;
  border-radius: 22rpx;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.filter-tab.active {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 89, 0.35);
  transform: translateY(-2rpx);
}

.adoption-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.adoption-card {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.adoption-image-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.adoption-image {
  width: 100%;
  height: 100%;
}

.adoption-status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.adoption-orange-bar {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.orange-bar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
}

.orange-bar-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.adoption-info {
  padding: 20rpx 24rpx;
  background: white;
}

.adoption-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #636E72;
}

.adoption-publisher {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0E6E0;
}

.publisher-icon {
  font-size: 24rpx;
}

.adoption-publisher text:last-child {
  font-size: 24rpx;
  color: #636E72;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #636E72;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #B2BEC3;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.action-btn {
  padding: 24rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
}

.action-btn.secondary {
  background: #F8F5F2;
  color: #636E72;
}
