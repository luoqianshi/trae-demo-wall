<view class="page">
  <view class="pref-header">
    <view class="back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <text class="header-title">我的领养偏好</text>
    <text class="header-subtitle">设置偏好条件，AI为你智能匹配</text>
  </view>

  <scroll-view class="pref-scroll" scroll-y>
    <view class="pref-section">
      <text class="section-title">🐾 宠物类型</text>
      <view class="type-tags">
        <view class="type-tag {{selectedTypes.includes('dog') ? 'active' : ''}}" bindtap="toggleType" data-type="dog">🐶 狗狗</view>
        <view class="type-tag {{selectedTypes.includes('cat') ? 'active' : ''}}" bindtap="toggleType" data-type="cat">🐱 猫咪</view>
        <view class="type-tag {{selectedTypes.includes('other') ? 'active' : ''}}" bindtap="toggleType" data-type="other">🐾 其他</view>
      </view>
    </view>

    <view class="pref-section">
      <text class="section-title">👫 性别偏好</text>
      <view class="type-tags">
        <view class="type-tag {{selectedGenders.includes('公') ? 'active' : ''}}" bindtap="toggleGender" data-gender="公">公</view>
        <view class="type-tag {{selectedGenders.includes('母') ? 'active' : ''}}" bindtap="toggleGender" data-gender="母">母</view>
        <view class="type-tag {{selectedGenders.includes('不限') ? 'active' : ''}}" bindtap="toggleGender" data-gender="不限">不限</view>
      </view>
    </view>

    <view class="pref-section">
      <text class="section-title">🎂 年龄偏好</text>
      <view class="type-tags">
        <view class="type-tag {{selectedAges.includes('幼年') ? 'active' : ''}}" bindtap="toggleAge" data-age="幼年">幼年（1岁以下）</view>
        <view class="type-tag {{selectedAges.includes('成年') ? 'active' : ''}}" bindtap="toggleAge" data-age="成年">成年（1-5岁）</view>
        <view class="type-tag {{selectedAges.includes('老年') ? 'active' : ''}}" bindtap="toggleAge" data-age="老年">老年（5岁以上）</view>
      </view>
    </view>

    <view class="pref-section">
      <text class="section-title">⭐ 特征偏好</text>
      <view class="feature-tags">
        <view class="feature-tag {{selectedFeatures.includes('已绝育') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="已绝育">已绝育</view>
        <view class="feature-tag {{selectedFeatures.includes('已打疫苗') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="已打疫苗">已打疫苗</view>
        <view class="feature-tag {{selectedFeatures.includes('亲人') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="亲人">亲人</view>
        <view class="feature-tag {{selectedFeatures.includes('活泼') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="活泼">活泼</view>
        <view class="feature-tag {{selectedFeatures.includes('温顺') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="温顺">温顺</view>
        <view class="feature-tag {{selectedFeatures.includes('适合新手') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="适合新手">适合新手</view>
        <view class="feature-tag {{selectedFeatures.includes('适合有经验') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="适合有经验">适合有经验</view>
      </view>
    </view>

    <view class="pref-section">
      <text class="section-title">📍 所在城市</text>
      <picker mode="selector" range="{{cities}}" bindchange="onCityChange">
        <view class="pref-picker">{{selectedCity || '请选择城市'}}</view>
      </picker>
    </view>

    <view class="pref-section">
      <text class="section-title">📝 补充说明</text>
      <textarea class="pref-textarea" placeholder="可补充你对领养宠物的其他要求或期望..." value="{{extraNote}}" bindinput="onNoteInput" />
    </view>

    <view class="pref-section">
      <view class="daily-push-row">
        <view class="daily-push-info">
          <text class="push-title">每日推送</text>
          <text class="push-desc">开启后每天为你推送符合条件的新宠物</text>
        </view>
        <switch checked="{{dailyPush}}" bindchange="togglePush" color="#FF7A59" />
      </view>
    </view>

    <view class="match-result" wx:if="{{showResult}}">
      <text class="section-title">🎯 AI为你推荐的宠物</text>
      <view class="result-list">
        <view class="result-card" wx:for="{{matchResults}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
          <image class="result-image" src="{{item.image}}" mode="aspectFill" />
          <view class="result-info">
            <text class="result-name">{{item.name}}</text>
            <text class="result-breed">{{item.breed}} · {{item.age}}</text>
            <text class="result-location">📍 {{item.location}}</text>
          </view>
        </view>
      </view>
      <view class="no-result" wx:if="{{matchResults.length === 0}}">
        <text>暂无符合条件的宠物，稍后再来看看吧</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="action-bar">
    <view class="action-btn primary" bindtap="startMatch">
      <text>🎯 AI智能匹配</text>
    </view>
  </view>
</view>
