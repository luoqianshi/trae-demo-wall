.page {
  min-height: 100vh;
  background: #FFF9F5;
}

.pref-header {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  padding: 80rpx 32rpx 40rpx;
  position: relative;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 900;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.pref-scroll {
  height: calc(100vh - 220rpx);
}

.pref-section {
  padding: 32rpx;
  padding-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  display: block;
  margin-bottom: 20rpx;
}

.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-tag {
  padding: 16rpx 28rpx;
  background: white;
  color: #636E72;
  border-radius: 32rpx;
  font-size: 26rpx;
  border: 2rpx solid #F0E6E0;
  transition: all 0.3s;
}

.type-tag.active {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 89, 0.3);
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.feature-tag {
  padding: 14rpx 24rpx;
  background: white;
  color: #636E72;
  border-radius: 28rpx;
  font-size: 24rpx;
  border: 2rpx solid #F0E6E0;
  transition: all 0.3s;
}

.feature-tag.active {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-color: transparent;
  font-weight: 600;
}

.pref-picker {
  padding: 24rpx 28rpx;
  background: white;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #2D3436;
  border: 2rpx solid #F0E6E0;
}

.pref-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: white;
  border-radius: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #F0E6E0;
  box-sizing: border-box;
}

.daily-push-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F0E6E0;
}

.daily-push-info {
  flex: 1;
}

.push-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  display: block;
  margin-bottom: 8rpx;
}

.push-desc {
  font-size: 24rpx;
  color: #636E72;
}

.match-result {
  padding: 32rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-card {
  display: flex;
  gap: 20rpx;
  background: white;
  padding: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.result-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.result-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.result-breed {
  font-size: 26rpx;
  color: #636E72;
}

.result-location {
  font-size: 24rpx;
  color: #B2BEC3;
}

.no-result {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #B2BEC3;
}

.bottom-space {
  height: 140rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.action-btn {
  padding: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 89, 0.3);
}
