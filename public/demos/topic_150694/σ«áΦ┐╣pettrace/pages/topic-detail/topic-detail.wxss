.page {
  min-height: 100vh;
  background: #F8F5F2;
}

.topic-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 80rpx 32rpx 40rpx;
  position: relative;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.topic-title {
  font-size: 44rpx;
  font-weight: 900;
  color: white;
  display: block;
  margin-bottom: 12rpx;
}

.topic-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.topic-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.topic-stats .stat-item {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.topic-actions {
  display: flex;
  justify-content: flex-end;
}

.join-btn {
  padding: 16rpx 40rpx;
  background: rgba(255,255,255,0.25);
  color: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255,255,255,0.5);
}

.join-btn.joined {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.8);
}

.topic-scroll {
  height: calc(100vh - 280rpx);
}

.post-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  background: white;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.post-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: white;
}

.post-author-info {
  display: flex;
  flex-direction: column;
}

.post-author {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

.post-time {
  font-size: 22rpx;
  color: #B2BEC3;
}

.post-content {
  font-size: 28rpx;
  color: #2D3436;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.post-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.post-tag {
  padding: 8rpx 16rpx;
  background: #F0E6FF;
  color: #667eea;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0E6E0;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #636E72;
}

.comment-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0E6E0;
  display: none;
}

.comment-section.show {
  display: block;
}

.comment-input-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.comment-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #F8F5F2;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.send-btn {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.comment-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2D3436;
}

.comment-time {
  font-size: 20rpx;
  color: #B2BEC3;
}

.comment-text {
  font-size: 26rpx;
  color: #636E72;
  line-height: 1.5;
}

.bottom-space {
  height: 60rpx;
}
