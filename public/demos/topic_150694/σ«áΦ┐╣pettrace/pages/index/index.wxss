.page {
  min-height: 100vh;
  background: #FFF9F5;
}

.hero-section {
  position: relative;
  height: 520rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 50%, #FFD9C9 100%);
}

.hero-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: -50%;
  width: 200%;
  height: 100%;
  background: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.15) 0%, transparent 50%);
}

.hero-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.logo-icon {
  width: 80rpx;
  height: 80rpx;
  background: white;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.logo-text {
  font-size: 44rpx;
  font-weight: 900;
  color: white;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 48rpx;
}

.hero-buttons {
  display: flex;
  gap: 24rpx;
}

.hero-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.hero-btn.primary {
  background: white;
  color: #FF7A59;
}

.hero-btn.secondary {
  background: rgba(255,255,255,0.2);
  color: white;
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255,255,255,0.3);
}

.filter-section {
  padding: 0 32rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.filter-tabs {
  background: white;
  border-radius: 24rpx;
  padding: 8rpx;
  display: flex;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: #636E72;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  font-weight: 600;
}

.filter-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.sort-btn {
  padding: 16rpx 24rpx;
  background: white;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #636E72;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.pet-list-section {
  padding: 40rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
}

.section-more {
  font-size: 24rpx;
  color: #FF7A59;
}

.pet-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pet-card {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.pet-image-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.pet-image {
  width: 100%;
  height: 100%;
}

.pet-status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.pet-status.lost {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
}

.pet-status.found {
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
  color: white;
}

.pet-status.adopt {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.pet-distance {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  background: rgba(0,0,0,0.5);
  color: white;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.pet-info {
  padding: 24rpx;
}

.pet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.pet-gender {
  font-size: 28rpx;
}

.pet-breed {
  font-size: 26rpx;
  color: #636E72;
  margin-bottom: 12rpx;
}

.pet-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pet-time, .pet-location {
  font-size: 24rpx;
  color: #B2BEC3;
}

.pet-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0E6E0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #636E72;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  background: white;
  margin-top: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.quick-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.action-icon.scan {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
}

.action-icon.publish {
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
}

.action-icon.adopt {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.action-icon.hospital {
  background: linear-gradient(135deg, #FDBA74 0%, #FB923C 100%);
}

.quick-action text {
  font-size: 24rpx;
  color: #636E72;
}
