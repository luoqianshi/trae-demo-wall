<view class="page">
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <view class="logo-area">
        <view class="logo-icon">🐾</view>
        <text class="logo-text">宠迹 PetTrace</text>
      </view>
      <text class="hero-title">AI智能寻宠</text>
      <text class="hero-subtitle">让每一次走失都有重逢的希望</text>
      <view class="hero-buttons">
        <view class="hero-btn primary" bindtap="goToScan">
          <text class="btn-icon">📷</text>
          <text>拍照识图</text>
        </view>
        <view class="hero-btn secondary" bindtap="goToSearch">
          <text class="btn-icon">🔍</text>
          <text>文字搜索</text>
        </view>
      </view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-tabs">
      <view class="filter-tab {{currentFilter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-type="all">全部</view>
      <view class="filter-tab {{currentFilter === 'lost' ? 'active' : ''}}" bindtap="setFilter" data-type="lost">走失寻回</view>
      <view class="filter-tab {{currentFilter === 'found' ? 'active' : ''}}" bindtap="setFilter" data-type="found">发现流浪</view>
    </view>
    <view class="filter-actions">
      <view class="sort-btn" bindtap="toggleSort">
        <text>{{sortBy === 'time' ? '⏰ 最新' : '📍 最近'}}</text>
      </view>
    </view>
  </view>

  <view class="pet-list-section">
    <view class="section-header">
      <text class="section-title">附近最新发布</text>
      <text class="section-more" bindtap="goToPetList">查看更多 →</text>
    </view>
    <view class="pet-list">
      <view class="pet-card" wx:for="{{filteredPets}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="pet-image-wrap">
          <image class="pet-image" src="{{item.image}}" mode="aspectFill" />
          <view class="pet-status {{item.statusClass}}">
            {{item.statusText}}
          </view>
          <view class="pet-distance">📍 {{item.distance}}km</view>
        </view>
        <view class="pet-info">
          <view class="pet-header">
            <text class="pet-name">{{item.name}}</text>
            <text class="pet-gender">{{item.genderIcon}}</text>
          </view>
          <text class="pet-breed">{{item.breed}} · {{item.age}}</text>
          <view class="pet-meta">
            <text class="pet-time">{{item.publishTime}}</text>
            <text class="pet-location">{{item.location}}</text>
          </view>
          <view class="pet-actions">
            <view class="action-item">
              <text>💬</text>
              <text>{{item.commentCount}}</text>
            </view>
            <view class="action-item" bindtap="toggleFavorite" data-id="{{item.id}}">
              <text>{{item.isFavorite ? '❤️' : '🤍'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="quick-action" bindtap="goToScan">
      <view class="action-icon scan">📷</view>
      <text>AI识图</text>
    </view>
    <view class="quick-action" bindtap="goToPublish">
      <view class="action-icon publish">📝</view>
      <text>发布信息</text>
    </view>
    <view class="quick-action" bindtap="goToAdoption">
      <view class="action-icon adopt">🏠</view>
      <text>领养中心</text>
    </view>
    <view class="quick-action" bindtap="goToHospital">
      <view class="action-icon hospital">🏥</view>
      <text>合作医院</text>
    </view>
  </view>
</view>
