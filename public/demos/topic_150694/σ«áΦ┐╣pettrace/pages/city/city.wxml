<view class="page">
  <view class="city-header">
    <view class="location-info">
      <text class="location-icon">📍</text>
      <text class="location-text">北京市 · 朝阳区</text>
      <text class="location-arrow">▼</text>
    </view>
    <view class="notification-badge" bindtap="showAllNotifications">
      <text>12 条新消息</text>
    </view>
  </view>

  <view class="map-section">
    <view class="map-container">
      <view class="map-bg"></view>
      <view class="map-pins">
        <view class="map-pin pulse" style="top: 28%; left: 32%;" bindtap="goToDetail" data-id="0">
          <text>🐕</text>
        </view>
        <view class="map-pin secondary pulse" style="top: 48%; left: 58%;" bindtap="goToDetail" data-id="1">
          <text>🐱</text>
        </view>
        <view class="map-pin" style="top: 62%; left: 22%;" bindtap="goToDetail" data-id="2">
          <text>🐶</text>
        </view>
        <view class="map-pin" style="top: 38%; left: 72%;" bindtap="goToDetail" data-id="3">
          <text>🐕</text>
        </view>
        <view class="map-pin secondary" style="top: 55%; left: 42%;" bindtap="goToDetail" data-id="6">
          <text>🐩</text>
        </view>
        <view class="map-pin" style="top: 75%; left: 80%;" bindtap="goToDetail" data-id="8">
          <text>🐕</text>
        </view>
        <view class="map-pin hospital" style="top: 20%; left: 75%;">
          <text>🏥</text>
        </view>
        <view class="map-pin hospital secondary" style="top: 82%; left: 15%;">
          <text>🏥</text>
        </view>
      </view>
      <view class="map-legend">
        <view class="legend-item">
          <view class="legend-dot lost"></view>
          <text>走失寻回</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot found"></view>
          <text>发现流浪</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot hospital"></view>
          <text>宠物医院</text>
        </view>
      </view>
    </view>
  </view>

  <view class="notifications-section">
    <view class="section-header">
      <text class="section-title">附近动态</text>
      <text class="section-more" bindtap="showAllNotifications">查看全部 →</text>
    </view>
    <view class="notification-list">
      <view class="notification-item" wx:for="{{notifications}}" wx:key="id" bindtap="goToDetail" data-id="{{item.petId}}">
        <image class="notification-avatar" src="{{item.image}}" mode="aspectFill" />
        <view class="notification-content">
          <text class="notification-title">{{item.title}}</text>
          <text class="notification-desc">{{item.desc}}</text>
          <text class="notification-time">{{item.time}}</text>
        </view>
      </view>
    </view>
    <view class="show-more-btn" bindtap="showAllNotifications" wx:if="{{showMoreBtn}}">
      <text>查看全部12条消息</text>
    </view>
  </view>
</view>
