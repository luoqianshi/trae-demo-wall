.page {
  min-height: 100vh;
  background: #FFF9F5;
}

.city-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: white;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.location-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-icon {
  font-size: 32rpx;
}

.location-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
}

.location-arrow {
  font-size: 24rpx;
  color: #B2BEC3;
}

.notification-badge {
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.map-section {
  padding: 24rpx 32rpx;
}

.map-container {
  position: relative;
  height: 400rpx;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
}

.map-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #E8F5F3 0%, #FFF5F0 100%);
}

.map-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(255,122,89,0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,122,89,0.05) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
}

.map-pins {
  position: relative;
  width: 100%;
  height: 100%;
}

.map-pin {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  border: 4rpx solid #FF7A59;
}

.map-pin.secondary {
  border-color: #4ECDC4;
}

.map-pin.hospital {
  border-color: #667eea;
}

.map-pin.pulse::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255,122,89,0.3);
  transform: translate(-50%, -50%);
  animation: pulse 2s ease-in-out infinite;
}

.map-pin.secondary.pulse::after {
  background: rgba(78,205,196,0.3);
}

@keyframes pulse {
  0%, 100% {
    width: 100%;
    height: 100%;
    opacity: 0.5;
  }
  50% {
    width: 160%;
    height: 160%;
    opacity: 0;
  }
}

.map-legend {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  display: flex;
  gap: 24rpx;
  background: rgba(255,255,255,0.9);
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.lost {
  background: #FF7A59;
}

.legend-dot.found {
  background: #4ECDC4;
}

.legend-dot.hospital {
  background: #667eea;
}

.legend-item text {
  font-size: 22rpx;
  color: #636E72;
}

.notifications-section {
  padding: 0 32rpx 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
}

.section-more {
  font-size: 24rpx;
  color: #FF7A59;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-item {
  display: flex;
  gap: 20rpx;
  background: white;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.notification-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.notification-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

.notification-desc {
  font-size: 24rpx;
  color: #636E72;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-time {
  font-size: 22rpx;
  color: #B2BEC3;
}

.show-more-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 24rpx;
  background: white;
  border: 2rpx dashed #F0E6E0;
  border-radius: 20rpx;
  color: #FF7A59;
  font-size: 28rpx;
}
