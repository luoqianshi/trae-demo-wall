<view class="page">
  <view class="community-header">
    <text class="header-title">附近社区</text>
    <text class="header-subtitle">与同城爱宠人士互助交流</text>
  </view>

  <view class="groups-section">
    <view class="section-header">
      <text class="section-title">热门交流群</text>
      <text class="section-more">查看更多 →</text>
    </view>
    <view class="group-list">
      <view class="group-card" wx:for="{{groups}}" wx:key="id">
        <view class="group-avatar">{{item.icon}}</view>
        <view class="group-info">
          <text class="group-name">{{item.name}}</text>
          <text class="group-desc">{{item.desc}}</text>
          <view class="group-meta">
            <text class="meta-item">👥 {{item.members}} 人</text>
            <text class="meta-item">📍 {{item.location}}</text>
          </view>
        </view>
        <view class="group-action">
          <view class="join-btn {{item.joined ? 'joined' : ''}}" bindtap="toggleJoin" data-id="{{item.id}}">
            <text>{{item.joined ? '已加入' : '加入'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="topics-section">
    <view class="section-header">
      <text class="section-title">热门话题</text>
      <text class="section-more">查看更多 →</text>
    </view>
    <view class="topic-list">
      <view class="topic-card" wx:for="{{topics}}" wx:key="id" bindtap="goToTopic" data-id="{{item.id}}">
        <text class="topic-title">{{item.title}}</text>
        <text class="topic-desc">{{item.desc}}</text>
        <view class="topic-stats">
          <text class="stat-item">📝 {{item.posts}} 帖子</text>
          <text class="stat-item">👥 {{item.members}} 成员</text>
        </view>
      </view>
    </view>
  </view>

  <view class="hot-posts-section">
    <view class="section-header">
      <text class="section-title">最新动态</text>
    </view>
    <view class="post-list">
      <view class="post-card" wx:for="{{posts}}" wx:key="id">
        <view class="post-header">
          <view class="post-avatar">{{item.avatar}}</view>
          <view class="post-author-info">
            <text class="post-author">{{item.author}}</text>
            <text class="post-time">{{item.time}}</text>
          </view>
        </view>
        <text class="post-content">{{item.content}}</text>
        <view class="post-images" wx:if="{{item.hasImages}}">
          <image class="post-image" wx:for="{{item.images}}" wx:key="index" src="{{item}}" mode="aspectFill" />
        </view>
        <view class="post-tags">
          <text class="post-tag" wx:for="{{item.tags}}" wx:key="index">#{{item}}</text>
        </view>
        <view class="post-actions">
          <view class="action-btn" bindtap="likePost" data-id="{{item.id}}">
            <text>{{item.liked ? '❤️' : '🤍'}}</text>
            <text>{{item.likes}}</text>
          </view>
          <view class="action-btn" bindtap="toggleComments" data-id="{{item.id}}">
            <text>💬</text>
            <text>{{item.comments}}</text>
          </view>
          <view class="action-btn" bindtap="sharePost" data-id="{{item.id}}">
            <text>🔗</text>
            <text>分享</text>
          </view>
        </view>
        <view class="comment-section {{showCommentsId === item.id ? 'show' : ''}}">
          <view class="comment-input-box">
            <input class="comment-input" placeholder="说点什么吧..." value="{{commentInput}}" bindinput="onCommentInput" />
            <view class="send-btn" bindtap="postComment" data-id="{{item.id}}">发送</view>
          </view>
          <view class="comment-list">
            <view class="comment-item" wx:for="{{item.commentList}}" wx:key="id" wx:for-item="comment">
              <view class="comment-avatar">{{comment.avatar}}</view>
              <view class="comment-content">
                <view class="comment-header">
                  <text class="comment-name">{{comment.name}}</text>
                  <text class="comment-time">{{comment.time}}</text>
                </view>
                <text class="comment-text">{{comment.content}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
