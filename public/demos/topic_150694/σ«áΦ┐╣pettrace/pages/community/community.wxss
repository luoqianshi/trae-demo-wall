.page {
  min-height: 100vh;
  background: #FFF9F5;
}

.community-header {
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
  padding: 48rpx 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 900;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.groups-section {
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
}

.section-more {
  font-size: 24rpx;
  color: #FF7A59;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: white;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.group-avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
  flex-shrink: 0;
  overflow: hidden;
}

.group-avatar text {
  font-size: 48rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.group-info {
  flex: 1;
}

.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  display: block;
  margin-bottom: 8rpx;
}

.group-desc {
  font-size: 24rpx;
  color: #636E72;
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #B2BEC3;
}

.join-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.join-btn.joined {
  background: #F0E6E0;
  color: #636E72;
}

.topics-section {
  padding: 0 32rpx;
}

.topic-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.topic-card {
  background: white;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.topic-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
  display: block;
  margin-bottom: 8rpx;
}

.topic-desc {
  font-size: 22rpx;
  color: #636E72;
  display: block;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.topic-stats {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  font-size: 20rpx;
  color: #B2BEC3;
}

.hot-posts-section {
  padding: 32rpx;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  background: white;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.post-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: white;
}

.post-author-info {
  display: flex;
  flex-direction: column;
}

.post-author {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

.post-time {
  font-size: 22rpx;
  color: #B2BEC3;
}

.post-content {
  font-size: 28rpx;
  color: #2D3436;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.post-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.post-tag {
  padding: 8rpx 16rpx;
  background: #FFF5F0;
  color: #FF7A59;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0E6E0;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #636E72;
}

.comment-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0E6E0;
  display: none;
}

.comment-section.show {
  display: block;
}

.comment-input-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.comment-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #F8F5F2;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.send-btn {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #FF7A59 0%, #FFA987 100%);
  color: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #7EDDD6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.comment-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #2D3436;
}

.comment-time {
  font-size: 20rpx;
  color: #B2BEC3;
}

.comment-text {
  font-size: 26rpx;
  color: #636E72;
  line-height: 1.5;
}
