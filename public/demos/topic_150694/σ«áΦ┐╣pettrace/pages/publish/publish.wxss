.page {
  min-height: 100vh;
  background-color: #FFF9F5;
}

.publish-header {
  background: #fff;
  padding: 60px 24px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #F0F0F0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.back-btn {
  width: 36px;
  height: 36px;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 18px;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 36px;
  height: 36px;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 16px;
}

.publish-scroll {
  height: calc(100vh - 180px);
}

.publish-form {
  padding: 20px;
  background: #fff;
}

.form-section {
  text-align: center;
  padding: 20px 0 30px;
}

.section-title {
  font-size: 20px;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8px;
}

.section-subtitle {
  font-size: 14px;
  color: #999;
}

.form-item {
  margin-bottom: 20px;
}

.form-row {
  display: flex;
  gap: 16px;
}

.form-item.half {
  flex: 1;
}

.form-label {
  font-size: 14px;
  color: #333;
  font-weight: 500;
  margin-bottom: 8px;
  display: block;
}

.form-input {
  padding: 14px 16px;
  background: #F8F9FA;
  border-radius: 8px;
  font-size: 15px;
  color: #333;
  width: 100%;
}

.form-picker {
  padding: 14px 16px;
  background: #F8F9FA;
  border-radius: 8px;
  font-size: 15px;
  color: #333;
}

.upload-area {
  width: 100%;
  height: 160px;
  border: 2px dashed #E0E0E0;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.upload-icon {
  font-size: 40px;
}

.upload-text {
  font-size: 15px;
  color: #666;
}

.upload-hint {
  font-size: 12px;
  color: #999;
}

.form-textarea {
  width: 100%;
  height: 120px;
  padding: 14px 16px;
  background: #F8F9FA;
  border-radius: 8px;
  font-size: 15px;
  color: #333;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.feature-tag {
  padding: 10px 16px;
  background: #F5F5F5;
  border-radius: 20px;
  font-size: 14px;
  color: #666;
}

.feature-tag.active {
  background: #FFF0EB;
  color: #FF7A59;
}

.bottom-space {
  height: 30px;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 12px;
  padding: 16px 20px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid #F0F0F0;
}

.action-btn {
  flex: 1;
  padding: 14px;
  text-align: center;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 500;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF7A59 0%, #FF9F7F 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #666;
}
