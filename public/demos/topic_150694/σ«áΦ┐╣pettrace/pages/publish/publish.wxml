<view class="page">
  <view class="publish-header">
    <view class="header-left">
      <view class="back-btn" bindtap="goBack">
        <text>←</text>
      </view>
      <text class="header-title">发布领养信息</text>
    </view>
    <view class="close-btn" bindtap="goBack">
      <text>✕</text>
    </view>
  </view>

  <scroll-view class="publish-scroll" scroll-y>
    <view class="publish-form">
      <view class="form-section">
        <text class="section-title">🐾 发布领养信息</text>
        <text class="section-subtitle">填写宠物信息，帮助它们找到温暖的家</text>
      </view>

      <view class="form-item">
        <text class="form-label">A 宠物名称</text>
        <input class="form-input" placeholder="请输入宠物名称" value="{{formData.name}}" bindinput="onNameInput" />
      </view>

      <view class="form-row">
        <view class="form-item half">
          <text class="form-label">🐶 宠物类型</text>
          <picker mode="selector" range="{{petTypes}}" bindchange="onPetTypeChange">
            <view class="form-picker">{{formData.petType || '请选择'}}</view>
          </picker>
        </view>
        <view class="form-item half">
          <text class="form-label">👫 性别</text>
          <picker mode="selector" range="{{genders}}" bindchange="onGenderChange">
            <view class="form-picker">{{formData.gender || '请选择'}}</view>
          </picker>
        </view>
      </view>
      <view class="form-item" wx:if="{{showOtherPetType}}">
        <text class="form-label">📝 其他类型</text>
        <input class="form-input" placeholder="请输入宠物类型，如：仓鼠、兔子等" value="{{formData.otherPetType}}" bindinput="onOtherPetTypeInput" />
      </view>

      <view class="form-item">
        <text class="form-label">🐾 品种</text>
        <input class="form-input" placeholder="如：金毛、橘猫、布偶猫等" value="{{formData.breed}}" bindinput="onBreedInput" />
      </view>

      <view class="form-item">
        <text class="form-label">🎂 年龄/体重</text>
        <input class="form-input" placeholder="如：2岁、6个月、5kg" value="{{formData.age}}" bindinput="onAgeInput" />
      </view>

      <view class="form-item">
        <text class="form-label">📍 所在城市</text>
        <picker mode="selector" range="{{cities}}" bindchange="onCityChange">
          <view class="form-picker">{{formData.city || '请选择城市'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">📸 上传照片</text>
        <view class="upload-area" bindtap="chooseImage">
          <image class="upload-preview" src="{{formData.image}}" wx:if="{{formData.image}}" mode="aspectFill" />
          <view class="upload-placeholder" wx:else>
            <text class="upload-icon">☁️</text>
            <text class="upload-text">点击上传宠物照片</text>
            <text class="upload-hint">支持 JPG、PNG 格式，最多9张</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">📝 详细描述</text>
        <textarea class="form-textarea" placeholder="请描述宠物的基本情况、性格特点、健康状况、领养要求等..." value="{{formData.description}}" bindinput="onDescriptionInput" />
      </view>

      <view class="form-item">
        <text class="form-label">🏷️ 宠物特征标签</text>
        <view class="feature-tags">
          <view class="feature-tag {{formData.features.includes('已绝育') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="已绝育">已绝育</view>
          <view class="feature-tag {{formData.features.includes('已打疫苗') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="已打疫苗">已打疫苗</view>
          <view class="feature-tag {{formData.features.includes('亲人') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="亲人">亲人</view>
          <view class="feature-tag {{formData.features.includes('健康') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="健康">健康</view>
          <view class="feature-tag {{formData.features.includes('活泼') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="活泼">活泼</view>
          <view class="feature-tag {{formData.features.includes('温顺') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="温顺">温顺</view>
          <view class="feature-tag {{formData.features.includes('适合有经验者') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="适合有经验者">适合有经验者</view>
          <view class="feature-tag {{formData.features.includes('适合新手') ? 'active' : ''}}" bindtap="toggleFeature" data-feature="适合新手">适合新手</view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">❤️ 领养要求</text>
        <textarea class="form-textarea" placeholder="请说明对领养人的要求，如：需要稳定住所、接受回访、签订领养协议等..." value="{{formData.requirement}}" bindinput="onRequirementInput" />
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="action-bar">
    <view class="action-btn secondary" bindtap="goBack">
      <text>取消</text>
    </view>
    <view class="action-btn primary" bindtap="submitForm">
      <text>✈️ 发布领养</text>
    </view>
  </view>
</view>
