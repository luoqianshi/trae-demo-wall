<view class="page">
  <view class="mine-header">
    <view class="header-bg"></view>
    <view class="user-info">
      <view class="user-avatar" bindtap="goToLogin" wx:if="{{!userInfo}}">
        <text>👤</text>
      </view>
      <view class="user-avatar" wx:else>
        <text>{{userInfo.avatar}}</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{userName}}</text>
        <text class="user-phone" wx:if="{{hasPhone}}">{{userInfo.phone}}</text>
      </view>
      <view class="edit-btn" bindtap="goToLogin">
        <text>编辑</text>
      </view>
    </view>
    
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{myPosts}}</text>
        <text class="stat-label">发布</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{myFavorites}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{myAdoptions}}</text>
        <text class="stat-label">领养</text>
      </view>
    </view>
  </view>

  <view class="mine-content">
    <view class="menu-section">
      <view class="menu-card">
        <view class="menu-item" bindtap="goToMyPosts">
          <text class="menu-icon">📝</text>
          <text class="menu-text">我的发布</text>
          <text class="menu-arrow">→</text>
        </view>
        <view class="menu-item" bindtap="goToFavorites">
          <text class="menu-icon">❤️</text>
          <text class="menu-text">我的收藏</text>
          <text class="menu-arrow">→</text>
        </view>
        <view class="menu-item" bindtap="goToAdoptions">
          <text class="menu-icon">🏠</text>
          <text class="menu-text">领养记录</text>
          <text class="menu-arrow">→</text>
        </view>
        <view class="menu-item" bindtap="goToMessages">
          <text class="menu-icon">💬</text>
          <text class="menu-text">消息通知</text>
          <text class="menu-arrow">→</text>
          <view class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</view>
        </view>
      </view>

      <view class="menu-card">
        <view class="menu-item" bindtap="goToHospital">
          <text class="menu-icon">🏥</text>
          <text class="menu-text">合作医院</text>
          <text class="menu-arrow">→</text>
        </view>
        <view class="menu-item" bindtap="goToGuide">
          <text class="menu-icon">📖</text>
          <text class="menu-text">领养须知</text>
          <text class="menu-arrow">→</text>
        </view>
        <view class="menu-item" bindtap="goToAgreement">
          <text class="menu-icon">📄</text>
          <text class="menu-text">用户协议</text>
          <text class="menu-arrow">→</text>
        </view>
        <view class="menu-item" bindtap="goToSettings">
          <text class="menu-icon">⚙️</text>
          <text class="menu-text">设置</text>
          <text class="menu-arrow">→</text>
        </view>
      </view>
    </view>

    <view class="footer">
      <text class="footer-text">宠迹 PetTrace v1.0.0</text>
      <text class="footer-copyright">让每一次走失都有重逢的希望</text>
    </view>
  </view>
</view>
