<view class="page">
  <view class="header-section">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="header-top">
        <view class="page-title-row">
          <text class="page-title">{{role === 'employee' ? '我的薪资' : '薪资查询'}}</text>
          <picker 
            mode="selector" 
            range="{{monthList}}"
            value="{{monthIndex}}"
            bindchange="onMonthChange"
            wx:if="{{role !== 'employee'}}"
          >
            <view class="month-picker">
              <text class="calendar-icon">📅</text>
              <text class="month-text">{{currentMonth}}</text>
              <text class="month-arrow">▾</text>
            </view>
          </picker>
        </view>
        
        <view class="user-badge" wx:if="{{role === 'employee'}}">
          <text class="user-name">{{userInfo.name}}</text>
        </view>
      </view>

      <view class="search-bar" wx:if="{{role !== 'employee'}}">
        <view class="search-input">
          <text class="search-icon">🔍</text>
          <input 
            placeholder="搜索员工姓名/工号" 
            placeholder-class="search-placeholder"
            value="{{keyword}}"
            bindinput="onSearchInput"
          />
        </view>
        <picker 
          mode="selector" 
          range="{{departmentOptions}}" 
          range-key="label"
          bindchange="onDepartmentChange"
          wx:if="{{isAdmin}}"
        >
          <view class="dept-filter">
            <text class="filter-icon">🏢</text>
          </view>
        </picker>
      </view>

      <view class="tab-bar" wx:if="{{role !== 'employee'}}">
        <view 
          class="tab-item {{activeTab === 'list' ? 'active' : ''}}"
          data-tab="list"
          bindtap="switchTab"
        >
          <text class="tab-icon">📋</text>
          <text>薪资明细</text>
        </view>
        <view 
          class="tab-item {{activeTab === 'stats' ? 'active' : ''}}"
          data-tab="stats"
          bindtap="switchTab"
        >
          <text class="tab-icon">📊</text>
          <text>统计汇总</text>
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{role === 'employee'}}">
    <view class="summary-card-section" wx:if="{{personalHistory.length > 0}}">
      <view class="summary-card">
        <view class="summary-header">
          <text class="summary-title">💼 薪资概览</text>
          <text class="summary-count">近{{personalHistory.length}}个月</text>
        </view>
        <view class="summary-main">
          <view class="main-label">累计实发</view>
          <view class="main-value">
            <text class="currency">¥</text>
            <text class="amount">{{totalNetStr}}</text>
          </view>
        </view>
        <view class="summary-grid">
          <view class="summary-item">
            <view class="item-label">月均实发</view>
            <view class="item-value success">¥{{avgNetStr}}</view>
          </view>
          <view class="summary-item">
            <view class="item-label">最高月薪</view>
            <view class="item-value primary">¥{{maxNetStr}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="trend-section" wx:if="{{personalHistory.length > 0}}">
      <view class="section-header">
        <text class="section-title">📈 薪资趋势</text>
      </view>
      <view class="trend-chart">
        <view class="chart-bars">
          <view 
            wx:for="{{personalHistory}}" 
            wx:key="id"
            class="bar-item"
          >
            <view class="bar-wrapper">
              <view 
                class="bar-fill" 
                style="height: {{item.barHeight}}%"
              ></view>
            </view>
            <text class="bar-label">{{item.monthShort}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="history-section">
      <view class="section-header">
        <text class="section-title">📋 历史薪资</text>
      </view>
      
      <view class="history-list" wx:if="{{personalHistory.length > 0}}">
        <view 
          wx:for="{{personalHistory}}" 
          wx:key="id"
          class="history-card"
          data-id="{{item.id}}"
          data-month="{{item.month}}"
          bindtap="viewHistoryDetail"
        >
          <view class="history-left">
            <view class="month-badge-custom">
              <text class="month-main">{{item.month}}</text>
            </view>
            <view class="history-info">
              <view class="history-salary">
                <text class="salary-value">¥{{item.netSalaryStr}}</text>
              </view>
              <view class="history-detail">
                <text>应发 ¥{{item.grossSalaryStr}}</text>
                <text class="dot">·</text>
                <text>个税 ¥{{item.personalIncomeTaxStr}}</text>
              </view>
            </view>
          </view>
          <view class="history-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{personalHistory.length === 0}}">
        <view class="empty-card">
          <view class="empty-illustration">
            <text class="empty-emoji">📋</text>
          </view>
          <view class="empty-title">暂无薪资记录</view>
          <view class="empty-desc">薪资核算完成后将在这里显示</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <block wx:if="{{activeTab === 'list'}}">
      <view class="list-section">
        <view class="section-header-row">
          <text class="section-title-text">薪资列表</text>
          <text class="section-count">共 {{salaryList.length}} 人</text>
        </view>
        
        <view class="salary-list" wx:if="{{salaryList.length > 0}}">
          <view 
            wx:for="{{salaryList}}" 
            wx:key="id"
            class="salary-card-item"
            data-id="{{item.id}}"
            bindtap="viewDetail"
          >
            <view class="avatar-wrap">
              <view class="salary-avatar">{{item.initials}}</view>
            </view>
            <view class="emp-info">
              <view class="emp-top">
                <text class="emp-name">{{item.name}}</text>
                <view class="dept-badge">{{item.department}}</view>
              </view>
              <view class="emp-position">{{item.position}}</view>
            </view>
            <view class="salary-right">
              <view class="net-salary">¥{{item.netSalaryStr}}</view>
              <view class="gross-hint">应发 ¥{{item.grossSalaryStr}}</view>
            </view>
            <view class="card-arrow">›</view>
          </view>
        </view>

        <view class="empty-state" wx:if="{{salaryList.length === 0}}">
          <view class="empty-card">
            <view class="empty-illustration">
              <text class="empty-emoji">🔍</text>
            </view>
            <view class="empty-title">暂无匹配数据</view>
            <view class="empty-desc">试试调整筛选条件</view>
            <view class="empty-action" wx:if="{{isAdmin}}" bindtap="gotoSalaryCalc">
              <text class="action-text">去核算薪资</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{activeTab === 'stats'}}">
      <view class="stats-section" wx:if="{{statistics}}">
        <view class="stats-overview-card">
          <view class="overview-title">📊 本月统计概览</view>
          <view class="overview-grid">
            <view class="overview-item">
              <view class="overview-value primary">{{statistics.totalCount}}</view>
              <view class="overview-label">在职人数</view>
            </view>
            <view class="overview-item">
              <view class="overview-value success">¥{{statistics.totalNetStr}}</view>
              <view class="overview-label">实发总额</view>
            </view>
            <view class="overview-item">
              <view class="overview-value warning">¥{{statistics.avgNetStr}}</view>
              <view class="overview-label">人均薪资</view>
            </view>
            <view class="overview-item">
              <view class="overview-value info">¥{{statistics.totalGrossStr}}</view>
              <view class="overview-label">应发总额</view>
            </view>
          </view>
        </view>

        <view class="dept-stats-section" wx:if="{{deptStatistics.length > 0}}">
          <view class="section-header-row">
            <text class="section-title-text">部门薪资统计</text>
            <view class="export-btn" wx:if="{{isAdmin}}" bindtap="openExportModal">
              <text class="export-icon">📤</text>
              <text>导出</text>
            </view>
          </view>
          
          <view class="dept-list">
            <view 
              wx:for="{{deptStatistics}}" 
              wx:key="department"
              class="dept-stat-card"
            >
              <view class="dept-card-header">
                <view class="dept-icon-wrap">🏢</view>
                <view class="dept-info">
                  <view class="dept-name">{{item.department}}</view>
                  <view class="dept-count">{{item.count}} 人</view>
                </view>
                <view class="dept-salary">
                  <text class="dept-avg">¥{{item.avgNetStr}}</text>
                  <text class="dept-salary-label">人均</text>
                </view>
              </view>
              <view class="dept-progress">
                <view class="progress-bar">
                  <view 
                    class="progress-fill" 
                    style="width: {{item.progressPercent}}%"
                  ></view>
                </view>
              </view>
              <view class="dept-detail-row">
                <view class="dept-detail-item">
                  <text class="detail-label">应发总额</text>
                  <text class="detail-value">¥{{item.totalGrossStr}}</text>
                </view>
                <view class="dept-detail-item">
                  <text class="detail-label">实发总额</text>
                  <text class="detail-value success">¥{{item.totalNetStr}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{!statistics || statistics.totalCount === 0}}">
        <view class="empty-card">
          <view class="empty-illustration">
            <text class="empty-emoji">📊</text>
          </view>
          <view class="empty-title">暂无统计数据</view>
          <view class="empty-desc">完成薪资核算后查看统计</view>
        </view>
      </view>
    </block>
  </block>

  <view class="modal-mask" wx:if="{{showExportModal}}" catchtap="closeExportModal">
    <view class="modal-content bottom-sheet" catchtap="">
      <view class="sheet-handle"></view>
      <view class="sheet-title">导出统计报表</view>
      
      <view class="export-list">
        <view class="export-item" bindtap="exportStats" data-type="stats-excel">
          <view class="export-icon-wrap blue">
            <text class="export-icon">📊</text>
          </view>
          <view class="export-info">
            <view class="export-name">导出 Excel 表格</view>
            <view class="export-desc">数据完整，支持二次编辑</view>
          </view>
          <text class="export-arrow">›</text>
        </view>
        <view class="export-item" bindtap="exportStats" data-type="stats-pdf">
          <view class="export-icon-wrap red">
            <text class="export-icon">📄</text>
          </view>
          <view class="export-info">
            <view class="export-name">导出 PDF 文档</view>
            <view class="export-desc">格式规范，适合打印存档</view>
          </view>
          <text class="export-arrow">›</text>
        </view>
      </view>

      <view class="sheet-cancel" bindtap="closeExportModal">取消</view>
    </view>
  </view>
</view>
