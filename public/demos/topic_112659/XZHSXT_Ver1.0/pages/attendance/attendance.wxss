.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.header-section {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 340rpx;
  background: linear-gradient(135deg, #0891b2 0%, #06b6d4 50%, #22d3ee 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  position: relative;
  z-index: 10;
  padding: 60rpx 32rpx 0;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.lock-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.lock-badge.locked {
  background: rgba(239, 68, 68, 0.2);
  color: #fecaca;
}

.lock-badge.unlocked {
  background: rgba(16, 185, 129, 0.2);
  color: #bbf7d0;
}

.lock-icon {
  font-size: 24rpx;
}

.month-picker {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  backdrop-filter: blur(10rpx);
}

.calendar-icon {
  font-size: 28rpx;
}

.month-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.month-arrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 16rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #9ca3af;
}

.dept-filter {
  width: 84rpx;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.filter-icon {
  font-size: 36rpx;
}

.stats-section {
  padding: 0 24rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 20;
}

.stats-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.stat-item.stat-main {
  flex: 1.2;
  padding-right: 20rpx;
}

.stat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-icon-wrap.small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
}

.stat-icon {
  font-size: 36rpx;
}

.stat-icon-sm {
  font-size: 28rpx;
}

.stat-content {
  min-width: 0;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.stat-value-sm {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.stat-label-sm {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 2rpx;
}

.stat-divider {
  width: 2rpx;
  height: 72rpx;
  background: linear-gradient(180deg, transparent, #e5e7eb, transparent);
  margin: 0 12rpx;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 24rpx 8rpx;
}

.action-card {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.action-card:active {
  transform: scale(0.97);
}

.action-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.action-icon-wrap.blue {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.action-icon-wrap.orange {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  flex: 1;
  min-width: 0;
}

.action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.action-desc {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}

.action-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.list-section {
  padding: 24rpx 24rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.title-count {
  font-size: 24rpx;
  color: #6b7280;
}

.attendance-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.attendance-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
}

.card-main {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  position: relative;
}

.avatar-wrap {
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.avatar.status-normal {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
  color: #16a34a;
}

.avatar.status-warning {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #d97706;
}

.avatar.status-danger {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
  color: #dc2626;
}

.status-dot {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
}

.status-dot.status-normal {
  background-color: #22c55e;
}

.status-dot.status-warning {
  background-color: #f59e0b;
}

.status-dot.status-danger {
  background-color: #ef4444;
}

.emp-info {
  flex: 1;
  min-width: 0;
}

.emp-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.emp-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.new-tag {
  padding: 2rpx 12rpx;
  background: linear-gradient(135deg, #a78bfa, #8b5cf6);
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.emp-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.emp-no,
.emp-dept {
  font-size: 24rpx;
  color: #6b7280;
}

.dot {
  color: #d1d5db;
  font-size: 20rpx;
}

.emp-stats {
  display: flex;
  gap: 20rpx;
}

.mini-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  min-width: 64rpx;
}

.mini-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.mini-label {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.deduction-box {
  text-align: right;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  min-width: 140rpx;
}

.deduction-box.no-ded {
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
}

.deduction-box.has-ded {
  background: linear-gradient(135deg, #fef2f2, #fee2e2);
}

.ded-label {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.deduction-box.no-ded .ded-value {
  color: #16a34a;
}

.deduction-box.has-ded .ded-value {
  color: #dc2626;
}

.ded-value {
  font-size: 28rpx;
  font-weight: 700;
}

.expand-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
  transition: transform 0.25s ease;
}

.expand-btn.expanded {
  transform: rotate(90deg);
  background: #e0e7ff;
}

.expand-icon {
  font-size: 32rpx;
  color: #6b7280;
  font-weight: 300;
  line-height: 1;
}

.card-detail {
  padding: 0 24rpx 24rpx;
  border-top: 2rpx solid #f3f4f6;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.detail-section {
  margin-top: 20rpx;
}

.detail-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-item {
  width: calc(33.33% - 8rpx);
  text-align: center;
  padding: 16rpx 8rpx;
  background: #f9fafb;
  border-radius: 14rpx;
}

.detail-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.detail-label {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
}

.ded-list {
  background: #fef2f2;
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
}

.ded-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #fecaca;
}

.ded-item:last-child {
  border-bottom: none;
}

.ded-item.total {
  padding-top: 16rpx;
  margin-top: 4rpx;
  border-top: 2rpx solid #fca5a5;
  border-bottom: none;
}

.ded-name {
  font-size: 26rpx;
  color: #6b7280;
}

.ded-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #dc2626;
}

.total-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #b91c1c;
}

.detail-actions {
  margin-top: 20rpx;
}

.btn-edit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 76rpx;
  background: linear-gradient(135deg, #06b6d4, #0891b2);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(8, 145, 178, 0.3);
}

.btn-icon {
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-illustration {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #cffafe, #a5f3fc);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-emoji {
  font-size: 90rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6b7280;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  max-width: 750rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 50%;
  font-size: 28rpx;
  color: #6b7280;
}

.modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.edit-emp-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #ecfeff, #cffafe);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
}

.edit-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #06b6d4, #0891b2);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.edit-emp-info {
  flex: 1;
}

.edit-emp-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #164e63;
  margin-bottom: 6rpx;
}

.edit-emp-dept {
  font-size: 24rpx;
  color: #0e7490;
}

.form-section {
  margin-bottom: 28rpx;
}

.form-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
  border-left: 6rpx solid #06b6d4;
  line-height: 1.2;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.form-field {
  width: calc(50% - 8rpx);
}

.form-field.full-width {
  width: 100%;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.field-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.field-input:focus {
  border-color: #06b6d4;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(6, 182, 212, 0.1);
}

.deduction-card {
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  border-radius: 20rpx;
  overflow: hidden;
}

.ded-card-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
  background: rgba(251, 191, 36, 0.2);
}

.title-icon {
  font-size: 28rpx;
}

.ded-card-body {
  padding: 16rpx 24rpx 20rpx;
}

.ded-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.ded-row-label {
  font-size: 26rpx;
  color: #78350f;
}

.ded-row-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #b45309;
}

.ded-row.total {
  border-top: 2rpx solid #fcd34d;
  padding-top: 16rpx;
  margin-top: 8rpx;
}

.total-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #92400e;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f3f4f6;
  flex-shrink: 0;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.btn-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #06b6d4, #0891b2);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(8, 145, 178, 0.35);
}

.btn-confirm.full-width {
  flex: none;
  width: 100%;
}

.import-result-card {
  text-align: center;
  padding: 40rpx 20rpx 20rpx;
}

.result-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 28rpx;
}

.result-stats {
  display: flex;
  gap: 16rpx;
}

.result-stat {
  flex: 1;
  padding: 24rpx 12rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.result-stat.success {
  background: #dcfce7;
}

.result-stat.fail {
  background: #fee2e2;
}

.result-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 6rpx;
}

.result-stat.success .result-num {
  color: #16a34a;
}

.result-stat.fail .result-num {
  color: #dc2626;
}

.result-label {
  font-size: 24rpx;
  color: #6b7280;
}

.error-section {
  margin: 24rpx 32rpx 0;
}

.error-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #991b1b;
  margin-bottom: 16rpx;
}

.error-icon {
  font-size: 28rpx;
}

.error-list {
  max-height: 300rpx;
  background: #fef2f2;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.error-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #fecaca;
}

.error-item:last-child {
  border-bottom: none;
}

.error-emp {
  font-size: 26rpx;
  color: #1f2937;
}

.error-reason {
  font-size: 24rpx;
  color: #dc2626;
}
