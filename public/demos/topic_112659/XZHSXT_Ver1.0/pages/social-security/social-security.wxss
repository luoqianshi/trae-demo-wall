.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.header-section {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 40%, #a78bfa 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  position: relative;
  z-index: 10;
  padding: 60rpx 32rpx 0;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.lock-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.lock-badge.locked {
  background: rgba(239, 68, 68, 0.25);
  color: #fecaca;
}

.lock-badge.unlocked {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.lock-icon {
  font-size: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 30rpx;
  opacity: 0.5;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 16rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #9ca3af;
}

.dept-filter {
  width: 84rpx;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.filter-icon {
  font-size: 36rpx;
}

.stats-section {
  padding: 0 24rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 20;
}

.stats-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.15);
}

.stats-grid {
  display: flex;
  gap: 12rpx;
}

.stats-divider {
  height: 2rpx;
  background: #f3f4f6;
  margin: 16rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 12rpx;
}

.stat-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-icon-wrap.purple {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
}

.stat-icon-wrap.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.stat-icon-wrap.green {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.stat-icon-wrap.orange {
  background: linear-gradient(135deg, #ffedd5, #fed7aa);
}

.stat-icon {
  font-size: 28rpx;
}

.stat-info {
  flex: 1;
  min-width: 0;
}

.stat-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 2rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #6b7280;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx 8rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 80rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.97);
}

.action-btn.primary {
  background: linear-gradient(135deg, #7c3aed, #8b5cf6);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.35);
}

.action-btn.secondary {
  background: #f3f4f6;
  color: #374151;
}

.action-btn.success {
  background: linear-gradient(135deg, #059669, #10b981);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(5, 150, 105, 0.35);
}

.btn-icon {
  font-size: 28rpx;
}

.btn-text {
  font-size: 26rpx;
}

.batch-select-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #d1d5db;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: bold;
  transition: all 0.15s ease;
}

.checkbox.checked {
  background: linear-gradient(135deg, #7c3aed, #8b5cf6);
  border-color: #8b5cf6;
}

.select-text {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.selected-count {
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 600;
}

.list-section {
  padding: 16rpx 24rpx 0;
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-count {
  font-size: 24rpx;
  color: #6b7280;
}

.ss-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ss-card {
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.15s ease;
}

.ss-card:active {
  transform: scale(0.98);
}

.select-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  background: #f9fafb;
  border-right: 2rpx solid #f3f4f6;
}

.card-content {
  flex: 1;
  padding: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.emp-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
  color: #7c3aed;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.emp-info {
  flex: 1;
  min-width: 0;
}

.emp-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 4rpx;
}

.emp-meta {
  font-size: 22rpx;
  color: #6b7280;
}

.total-badge {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 10rpx 16rpx;
  background: linear-gradient(135deg, #faf5ff, #f3e8ff);
  border-radius: 12rpx;
}

.badge-label {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
  margin-bottom: 4rpx;
}

.badge-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #7c3aed;
}

.detail-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-col {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.col-label {
  font-size: 22rpx;
  color: #6b7280;
}

.col-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}

.col-value.danger {
  color: #dc2626;
}

.empty-state {
  padding: 60rpx 0;
}

.empty-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.empty-illustration {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content.bottom-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
}

.emp-info-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #faf5ff, #f3e8ff);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.emp-avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c4b5fd, #a78bfa);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.emp-detail {
  flex: 1;
}

.emp-dept {
  font-size: 22rpx;
  color: #7c3aed;
  margin-top: 4rpx;
}

.form-section {
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.form-row:last-child {
  margin-bottom: 0;
}

.form-item {
  flex: 1;
}

.form-item-full {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.form-input {
  height: 80rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2937;
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: #8b5cf6;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(139, 92, 246, 0.1);
}

.amount-preview {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400e;
}

.preview-subtitle {
  font-size: 22rpx;
  color: #b45309;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
}

.preview-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.preview-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
}

.preview-label {
  font-size: 22rpx;
  color: #92400e;
}

.preview-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #78350f;
}

.preview-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(180, 83, 9, 0.2);
}

.total-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #78350f;
}

.total-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #78350f;
}

.batch-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #1d4ed8;
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.footer-btn:active {
  transform: scale(0.97);
}

.footer-btn.secondary {
  background: #f3f4f6;
  color: #4b5563;
}

.footer-btn.primary {
  background: linear-gradient(135deg, #7c3aed, #8b5cf6);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.35);
}
