<view class="page">
  <view class="header-section">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="page-header">
        <view class="page-title-row">
          <text class="page-title">社保公积金</text>
          <view class="lock-badge {{isLocked ? 'locked' : 'unlocked'}}" wx:if="{{isAdmin}}">
            <text class="lock-icon">{{isLocked ? '🔒' : '🔓'}}</text>
            <text>{{isLocked ? '已锁定' : '可编辑'}}</text>
          </view>
        </view>
      </view>

      <view class="search-bar">
        <view class="search-input">
          <text class="search-icon">🔍</text>
          <input 
            placeholder="搜索员工姓名/工号" 
            placeholder-class="search-placeholder"
            value="{{keyword}}"
            bindinput="onSearchInput"
          />
        </view>
        <picker 
          mode="selector" 
          range="{{departmentOptions}}" 
          range-key="label"
          bindchange="onDepartmentChange"
        >
          <view class="dept-filter">
            <text class="filter-icon">🏢</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="stats-section" wx:if="{{stats}}">
    <view class="stats-card">
      <view class="stats-grid">
        <view class="stat-item">
          <view class="stat-icon-wrap purple">
            <text class="stat-icon">👥</text>
          </view>
          <view class="stat-info">
            <view class="stat-value">{{stats.totalCount}}</view>
            <view class="stat-label">参保人数</view>
          </view>
        </view>
        <view class="stat-item">
          <view class="stat-icon-wrap blue">
            <text class="stat-icon">🏥</text>
          </view>
          <view class="stat-info">
            <view class="stat-value">¥{{stats.totalSocialStr}}</view>
            <view class="stat-label">社保总额</view>
          </view>
        </view>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-grid">
        <view class="stat-item">
          <view class="stat-icon-wrap green">
            <text class="stat-icon">🏠</text>
          </view>
          <view class="stat-info">
            <view class="stat-value">¥{{stats.totalHousingFundStr}}</view>
            <view class="stat-label">公积金总额</view>
          </view>
        </view>
        <view class="stat-item">
          <view class="stat-icon-wrap orange">
            <text class="stat-icon">💰</text>
          </view>
          <view class="stat-info">
            <view class="stat-value">¥{{stats.avgAmountStr}}</view>
            <view class="stat-label">人均缴纳</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="action-bar" wx:if="{{isAdmin}}">
    <view class="action-btn {{isBatchMode ? 'secondary' : 'primary'}}" bindtap="toggleBatchMode">
      <text class="btn-icon">{{isBatchMode ? '✕' : '📝'}}</text>
      <text class="btn-text">{{isBatchMode ? '取消批量' : '批量设置'}}</text>
    </view>
    <view 
      class="action-btn success" 
      wx:if="{{isBatchMode}}"
      bindtap="openBatchModal"
    >
      <text class="btn-icon">✅</text>
      <text class="btn-text">批量更新 ({{selectedIds.length}})</text>
    </view>
  </view>

  <view class="batch-select-bar" wx:if="{{isBatchMode && list.length > 0}}">
    <view class="select-all" bindtap="selectAll">
      <view class="checkbox {{selectedIds.length === list.length ? 'checked' : ''}}">
        <text wx:if="{{selectedIds.length === list.length}}">✓</text>
      </view>
      <text class="select-text">{{selectedIds.length === list.length ? '取消全选' : '全选'}}</text>
    </view>
    <text class="selected-count">已选 {{selectedIds.length}} 人</text>
  </view>

  <view class="list-section">
    <view class="section-header-row" wx:if="{{list.length > 0}}">
      <text class="section-title">缴纳明细</text>
      <text class="section-count">共 {{list.length}} 人</text>
    </view>

    <view class="ss-list" wx:if="{{list.length > 0}}">
      <view 
        wx:for="{{list}}" 
        wx:key="employeeId"
        class="ss-card"
      >
        <view wx:if="{{isBatchMode}}" class="select-box" catchtap="toggleSelect" data-id="{{item.employeeId}}">
          <view class="checkbox {{selectedIds.indexOf(item.employeeId) > -1 ? 'checked' : ''}}">
            <text wx:if="{{selectedIds.indexOf(item.employeeId) > -1}}">✓</text>
          </view>
        </view>
        
        <view class="card-content" data-employee-id="{{item.employeeId}}" bindtap="editItem">
          <view class="card-header">
            <view class="emp-avatar">{{item.initials}}</view>
            <view class="emp-info">
              <view class="emp-name">{{item.name}}</view>
              <view class="emp-meta">{{item.employeeNo}} · {{item.department}}</view>
            </view>
            <view class="total-badge">
              <text class="badge-label">个人缴纳</text>
              <text class="badge-value">¥{{item.total}}</text>
            </view>
          </view>

          <view class="detail-row">
            <view class="detail-col">
              <view class="col-label">社保基数</view>
              <view class="col-value">¥{{item.socialBase}}</view>
            </view>
            <view class="detail-col">
              <view class="col-label">公积金基数</view>
              <view class="col-value">¥{{item.housingFundBase}}</view>
            </view>
          </view>
          <view class="detail-row">
            <view class="detail-col">
              <view class="col-label">社保个人</view>
              <view class="col-value danger">¥{{item.socialPersonal}}</view>
            </view>
            <view class="detail-col">
              <view class="col-label">公积金个人</view>
              <view class="col-value danger">¥{{item.housingFundPersonal}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{list.length === 0}}">
      <view class="empty-card">
        <view class="empty-illustration">
          <text class="empty-emoji">🏦</text>
        </view>
        <view class="empty-title">暂无社保数据</view>
        <view class="empty-desc">请先添加员工信息</view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showEditModal}}" catchtap="closeEditModal">
    <view class="modal-content bottom-sheet" catchtap="">
      <view class="sheet-handle"></view>
      <view class="sheet-title">编辑社保公积金</view>
      
      <view class="emp-info-card">
        <view class="emp-avatar-sm">{{currentEmployee.name[0]}}</view>
        <view class="emp-detail">
          <view class="emp-name">{{currentEmployee.name}}</view>
          <view class="emp-dept">{{currentEmployee.department}} · {{currentEmployee.position}}</view>
        </view>
      </view>

      <view class="form-section">
        <view class="form-row">
          <view class="form-item">
            <view class="form-label">社保基数 (元)</view>
            <input 
              class="form-input"
              type="digit"
              value="{{editData.socialBase}}"
              data-field="socialBase"
              bindinput="onEditInput"
            />
          </view>
          <view class="form-item">
            <view class="form-label">公积金基数 (元)</view>
            <input 
              class="form-input"
              type="digit"
              value="{{editData.housingFundBase}}"
              data-field="housingFundBase"
              bindinput="onEditInput"
            />
          </view>
        </view>

        <view class="form-row">
          <view class="form-item">
            <view class="form-label">社保比例 (%)</view>
            <input 
              class="form-input"
              type="digit"
              value="{{editData.socialPersonalRate}}"
              data-field="socialPersonalRate"
              bindinput="onEditInput"
            />
          </view>
          <view class="form-item">
            <view class="form-label">公积金比例 (%)</view>
            <input 
              class="form-input"
              type="digit"
              value="{{editData.housingFundPersonalRate}}"
              data-field="housingFundPersonalRate"
              bindinput="onEditInput"
            />
          </view>
        </view>
      </view>

      <view class="amount-preview">
        <view class="preview-header">
          <text class="preview-title">💰 应缴金额</text>
          <text class="preview-subtitle">自动计算</text>
        </view>
        <view class="preview-grid">
          <view class="preview-item">
            <text class="preview-label">社保个人</text>
            <text class="preview-value">¥{{editData.socialPersonal}}</text>
          </view>
          <view class="preview-item">
            <text class="preview-label">公积金个人</text>
            <text class="preview-value">¥{{editData.housingFundPersonal}}</text>
          </view>
        </view>
        <view class="preview-total">
          <text class="total-label">合计</text>
          <text class="total-value">¥{{editData.total}}</text>
        </view>
      </view>

      <view class="modal-footer">
        <view class="footer-btn secondary" bindtap="closeEditModal">取消</view>
        <view class="footer-btn primary" bindtap="saveEdit">保存</view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showBatchModal}}" catchtap="closeBatchModal">
    <view class="modal-content bottom-sheet" catchtap="">
      <view class="sheet-handle"></view>
      <view class="sheet-title">批量设置</view>
      
      <view class="batch-tip">
        <text class="tip-icon">💡</text>
        <text class="tip-text">已选择 {{selectedIds.length}} 名员工，留空表示不修改该项</text>
      </view>

      <view class="form-section">
        <view class="form-item-full">
          <view class="form-label">社保基数 (元)</view>
          <input 
            class="form-input"
            type="digit"
            placeholder="请输入社保基数"
            value="{{batchData.socialBase}}"
            data-field="socialBase"
            bindinput="onBatchInput"
          />
        </view>

        <view class="form-item-full">
          <view class="form-label">公积金基数 (元)</view>
          <input 
            class="form-input"
            type="digit"
            placeholder="请输入公积金基数"
            value="{{batchData.housingFundBase}}"
            data-field="housingFundBase"
            bindinput="onBatchInput"
          />
        </view>

        <view class="form-row">
          <view class="form-item">
            <view class="form-label">社保比例 (%)</view>
            <input 
              class="form-input"
              type="digit"
              placeholder="10.5"
              value="{{batchData.socialPersonalRate}}"
              data-field="socialPersonalRate"
              bindinput="onBatchInput"
            />
          </view>
          <view class="form-item">
            <view class="form-label">公积金比例 (%)</view>
            <input 
              class="form-input"
              type="digit"
              placeholder="12"
              value="{{batchData.housingFundPersonalRate}}"
              data-field="housingFundPersonalRate"
              bindinput="onBatchInput"
            />
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <view class="footer-btn secondary" bindtap="closeBatchModal">取消</view>
        <view class="footer-btn primary" bindtap="confirmBatchUpdate">确认更新</view>
      </view>
    </view>
  </view>
</view>
