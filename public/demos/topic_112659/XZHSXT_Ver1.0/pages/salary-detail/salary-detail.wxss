.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdf4 0%, #f5f7fa 300rpx);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.salary-container {
  padding: 24rpx;
}

.salary-hero {
  position: relative;
  background: linear-gradient(135deg, #059669 0%, #10b981 50%, #34d399 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx 40rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(5, 150, 105, 0.3);
}

.hero-decoration {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.hero-decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.circle1 {
  width: 120rpx;
  height: 120rpx;
  top: 60rpx;
  right: 120rpx;
}

.circle2 {
  width: 80rpx;
  height: 80rpx;
  bottom: 80rpx;
  left: 40rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.company-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
}

.company-icon {
  font-size: 24rpx;
}

.company-name {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

.month-badge {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
}

.hero-emp {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.emp-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
}

.emp-detail {
  flex: 1;
  min-width: 0;
}

.emp-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.emp-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.meta-dot {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.hero-salary {
  text-align: center;
  position: relative;
  z-index: 1;
}

.salary-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 8rpx;
}

.salary-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 8rpx;
}

.currency {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 6rpx;
}

.amount {
  font-size: 64rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.salary-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.quick-stats {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  margin-top: -20rpx;
  margin-left: 12rpx;
  margin-right: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.stat-value.primary {
  color: #2563eb;
}

.stat-value.danger {
  color: #dc2626;
}

.stat-value.warning {
  color: #ea580c;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #f3f4f6;
}

.detail-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f9fafb;
}

.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.section-icon.income {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.section-icon.deduction {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
}

.section-icon.insurance {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.section-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-total {
  font-size: 28rpx;
  font-weight: 700;
  color: #059669;
}

.section-total.danger {
  color: #dc2626;
}

.section-total.warning {
  color: #ea580c;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  transition: background-color 0.15s;
}

.detail-item:active {
  background: #f9fafb;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-label {
  font-size: 26rpx;
  color: #4b5563;
}

.item-tag {
  font-size: 20rpx;
  color: #9ca3af;
  padding: 4rpx 12rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
}

.item-value {
  font-size: 28rpx;
  font-weight: 600;
}

.item-value.positive {
  color: #059669;
}

.item-value.negative {
  color: #dc2626;
}

.summary-card {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(251, 191, 36, 0.2);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.summary-label {
  font-size: 26rpx;
  color: #92400e;
  font-weight: 500;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
}

.summary-divider {
  height: 2rpx;
  background: rgba(180, 83, 9, 0.2);
  margin: 12rpx 0;
}

.summary-row.final {
  padding-top: 16rpx;
}

.summary-row.final .summary-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #78350f;
}

.final-value {
  font-size: 36rpx !important;
  font-weight: 800 !important;
  color: #78350f !important;
}

.card-footer {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 24rpx 0 8rpx;
  margin-top: 8rpx;
}

.footer-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.footer-icon {
  font-size: 24rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #9ca3af;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #059669 0%, #10b981 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(5, 150, 105, 0.35);
}

.action-btn.primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.3);
}

.action-btn.secondary {
  background: #f3f4f6;
  color: #374151;
}

.action-btn.secondary:active {
  transform: scale(0.97);
  background: #e5e7eb;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content.bottom-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 28rpx;
}

.export-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.export-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #f9fafb;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.export-item:active {
  background: #f3f4f6;
  transform: scale(0.98);
}

.export-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.export-icon-wrap.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.export-icon-wrap.red {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
}

.export-icon-wrap.green {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.export-icon {
  font-size: 36rpx;
}

.export-info {
  flex: 1;
  min-width: 0;
}

.export-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.export-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.export-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.sheet-cancel {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  transition: all 0.15s;
}

.sheet-cancel:active {
  background: #e5e7eb;
}
