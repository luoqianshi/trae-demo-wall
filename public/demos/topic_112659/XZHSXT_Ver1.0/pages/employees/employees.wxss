.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.header-section {
  position: relative;
  padding-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #818cf8 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  position: relative;
  z-index: 10;
  padding: 60rpx 32rpx 0;
}

.page-title {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.title-badge {
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 16rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #9ca3af;
}

.filter-btn {
  width: 84rpx;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.25s ease;
}

.filter-btn.active {
  background: linear-gradient(135deg, #10b981, #059669);
  box-shadow: 0 4rpx 20rpx rgba(16, 185, 129, 0.4);
}

.filter-icon {
  font-size: 36rpx;
}

.filter-panel {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.filter-chip {
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #374151;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.chip-arrow {
  font-size: 22rpx;
  color: #6b7280;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 20;
}

.stat-card {
  width: calc(25% - 12rpx);
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stat-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.stat-icon {
  font-size: 32rpx;
}

.stat-info {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
}

.content-area {
  padding: 28rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-tabs {
  display: flex;
  background-color: #e5e7eb;
  border-radius: 16rpx;
  padding: 6rpx;
}

.tab-item {
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 12rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.tab-item.active {
  background-color: #ffffff;
  color: #4f46e5;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.action-icon {
  font-size: 28rpx;
}

.action-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.employee-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.employee-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.employee-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 60%;
  background: linear-gradient(180deg, #6366f1, #4f46e5);
  border-radius: 0 6rpx 6rpx 0;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.employee-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.employee-card:active::before {
  opacity: 1;
}

.avatar-ring {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.avatar-active {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #2563eb;
}

.avatar-inactive {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
  color: #dc2626;
}

.emp-info {
  flex: 1;
  min-width: 0;
}

.emp-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.emp-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.status-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-tag.status-on {
  background-color: #dcfce7;
  color: #16a34a;
}

.status-tag.status-off {
  background-color: #fee2e2;
  color: #dc2626;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: currentColor;
}

.emp-meta {
  margin-bottom: 10rpx;
}

.emp-no {
  font-size: 24rpx;
  color: #6b7280;
}

.emp-dept-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dept-tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
  color: #4f46e5;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.position-text {
  font-size: 24rpx;
  color: #6b7280;
}

.emp-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.salary-box {
  display: flex;
  align-items: baseline;
}

.salary-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #4f46e5;
}

.salary-unit {
  font-size: 20rpx;
  color: #9ca3af;
  margin-left: 4rpx;
}

.arrow-icon {
  font-size: 40rpx;
  color: #d1d5db;
  line-height: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.35);
}

.empty-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  font-weight: 300;
}

.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.5);
  z-index: 100;
  transition: all 0.2s ease;
}

.fab-button:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.4);
}

.fab-icon {
  font-size: 64rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}
