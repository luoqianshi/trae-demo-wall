.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.profile-header {
  position: relative;
  padding-top: 40rpx;
  padding-bottom: 100rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%);
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.bg-decoration.circle1 {
  width: 240rpx;
  height: 240rpx;
  top: -80rpx;
  right: -60rpx;
}

.bg-decoration.circle2 {
  width: 160rpx;
  height: 160rpx;
  bottom: 40rpx;
  left: -40rpx;
}

.bg-decoration.circle3 {
  width: 100rpx;
  height: 100rpx;
  top: 120rpx;
  left: 120rpx;
  background: rgba(255, 255, 255, 0.08);
}

.header-top {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: flex-end;
  padding: 0 24rpx;
  margin-bottom: 8rpx;
}

.setting-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.setting-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.setting-icon {
  font-size: 32rpx;
}

.user-card {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 36rpx 28rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(99, 102, 241, 0.2);
}

.avatar-ring {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-inner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #c7d2fe, #a78bfa);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
}

.avatar-large {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  z-index: 2;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.role-badge.admin {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #b45309;
}

.role-badge.manager {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1d4ed8;
}

.role-badge.employee {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
  color: #15803d;
}

.role-icon {
  font-size: 20rpx;
}

.user-meta {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.dot {
  color: #d1d5db;
}

.meta-icon {
  font-size: 20rpx;
  opacity: 0.7;
}

.user-id {
  font-size: 22rpx;
  color: #9ca3af;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stats-section {
  padding: 0 24rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 20;
}

.stats-card {
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.stat-card-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 12rpx;
  transition: all 0.15s ease;
}

.stat-card-item:active {
  transform: scale(0.95);
}

.stat-divider {
  width: 2rpx;
  background: #f3f4f6;
  margin: 8rpx 0;
}

.stat-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.stat-ico.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.stat-ico.green {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.stat-ico.purple {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 2rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
}

.menu-section {
  padding: 24rpx 24rpx 0;
}

.section-title {
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.menu-grid-item {
  width: calc((100% - 48rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.menu-grid-item:active {
  transform: scale(0.95);
  background: #f9fafb;
}

.grid-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.grid-icon-wrap.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.grid-icon-wrap.green {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.grid-icon-wrap.purple {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
}

.grid-icon-wrap.orange {
  background: linear-gradient(135deg, #ffedd5, #fed7aa);
}

.grid-icon {
  font-size: 36rpx;
}

.grid-title {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.03);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  position: relative;
  transition: background-color 0.15s;
}

.menu-item:active {
  background-color: #f9fafb;
}

.menu-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 88rpx;
  right: 24rpx;
  height: 2rpx;
  background: #f3f4f6;
}

.menu-item:last-child::after {
  display: none;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.menu-icon-wrap.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.menu-icon-wrap.gray {
  background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
}

.menu-icon {
  font-size: 28rpx;
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.menu-arrow {
  margin-left: 12rpx;
}

.arrow-icon {
  font-size: 32rpx;
  color: #d1d5db;
  font-weight: 300;
}

.logout-section {
  padding: 24rpx;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  background: #ffffff;
  border-radius: 20rpx;
  transition: all 0.15s ease;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.03);
}

.logout-btn:active {
  background: #fef2f2;
  transform: scale(0.98);
}

.logout-icon {
  font-size: 32rpx;
}

.logout-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ef4444;
}

.footer {
  padding: 32rpx 0;
  text-align: center;
}

.footer-text {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}

.footer-sub {
  display: block;
  font-size: 20rpx;
  color: #d1d5db;
}
