.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #4f46e5 0%, #6366f1 40%, #f5f7fa 40%);
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  overflow: hidden;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -80rpx;
}

.circle-2 {
  width: 200rpx;
  height: 200rpx;
  top: 200rpx;
  left: -60rpx;
}

.circle-3 {
  width: 120rpx;
  height: 120rpx;
  top: 80rpx;
  right: 200rpx;
  background: rgba(255, 255, 255, 0.15);
}

.login-header {
  padding-top: 100rpx;
  padding-bottom: 60rpx;
  text-align: center;
  color: #ffffff;
  position: relative;
  z-index: 10;
}

.logo-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 32rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e0e7ff 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.logo-icon {
  font-size: 72rpx;
}

.logo-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  filter: blur(20rpx);
  z-index: 1;
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 26rpx;
  opacity: 0.85;
  font-weight: 400;
}

.login-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 10;
  animation: slideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-header {
  margin-bottom: 36rpx;
}

.welcome-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8rpx;
}

.sub-text {
  font-size: 26rpx;
  color: #6b7280;
}

.role-selector {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.role-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border: 3rpx solid #e5e7eb;
  border-radius: 20rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  background-color: #ffffff;
}

.role-card:active {
  transform: scale(0.98);
}

.role-card.active {
  border-color: #4f46e5;
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  box-shadow: 0 4rpx 20rpx rgba(79, 70, 229, 0.15);
}

.role-icon {
  width: 72rpx;
  height: 72rpx;
  background-color: #f3f4f6;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.role-card.active .role-icon {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.3);
}

.role-info {
  flex: 1;
  min-width: 0;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
  transition: color 0.25s ease;
}

.role-card.active .role-name {
  color: #4f46e5;
}

.role-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.role-check {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-circle {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: checkIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes checkIn {
  from {
    transform: scale(0);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.check-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.label-icon {
  font-size: 28rpx;
}

.input-wrapper {
  position: relative;
}

.form-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 30rpx;
  background-color: #f9fafb;
  color: #111827;
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: #4f46e5;
  background-color: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(79, 70, 229, 0.1);
}

.input-placeholder {
  color: #9ca3af;
}

.agree-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 36rpx;
  padding: 0 4rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #d1d5db;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  border-color: #4f46e5;
}

.checkbox .check-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.link {
  color: #4f46e5;
  font-weight: 500;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.35);
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.3);
}

.login-btn.disabled {
  opacity: 0.6;
}

.login-footer {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 48rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #9ca3af;
}
