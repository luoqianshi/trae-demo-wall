<!--pages/detail/detail.wxml-->
<view class="page" wx:if="{{plan}}">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="plan-title">{{plan.title}}</view>
      <view class="plan-tags">
        <text class="plan-tag" wx:for="{{plan.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="plan-stats">
        <view class="stat">
          <text class="stat-icon">💰</text>
          <text class="stat-value">¥{{plan.budget}}/人</text>
        </view>
        <view class="stat">
          <text class="stat-icon">⏱️</text>
          <text class="stat-value">{{plan.duration}}</text>
        </view>
        <view class="stat">
          <text class="stat-icon">⭐</text>
          <text class="stat-value">{{plan.rating}}分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 路线时间轴 -->
  <view class="section">
    <view class="section-title">
      <text class="title-icon">📅</text>
      <text>详细行程</text>
    </view>
    
    <view class="timeline">
      <view class="timeline-item" wx:for="{{plan.schedule}}" wx:key="time" wx:for-index="idx">
        <view class="timeline-left">
          <view class="timeline-dot {{idx === 0 ? 'first' : ''}} {{idx === plan.schedule.length - 1 ? 'last' : ''}}"></view>
          <view class="timeline-line" wx:if="{{idx < plan.schedule.length - 1}}"></view>
        </view>
        <view class="timeline-content">
          <view class="time-badge">{{item.time}}</view>
          <view class="place-card">
            <view class="place-name">{{item.place}}</view>
            <view class="place-activity">{{item.activity}}</view>
            <view class="place-info">
              <view class="info-item">
                <text class="info-icon">⏱️</text>
                <text>{{item.duration}}</text>
              </view>
              <view class="info-item">
                <text class="info-icon">💰</text>
                <text>¥{{item.cost}}</text>
              </view>
            </view>
            <view class="place-actions">
              <view class="action-chip" bindtap="navigateTo" data-index="{{idx}}">
                <text>🧭</text>
                <text>导航</text>
              </view>
              <view class="action-chip" bindtap="reserve" data-index="{{idx}}">
                <text>📞</text>
                <text>预约</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 预算汇总 -->
  <view class="section">
    <view class="section-title">
      <text class="title-icon">💰</text>
      <text>预算明细</text>
    </view>
    
    <view class="budget-card">
      <view class="budget-item" wx:for="{{plan.schedule}}" wx:key="time">
        <view class="budget-label">{{item.activity}}</view>
        <view class="budget-amount">¥{{item.cost}}</view>
      </view>
      <view class="budget-divider"></view>
      <view class="budget-total">
        <view class="total-label">人均总计</view>
        <view class="total-amount">¥{{plan.budget}}</view>
      </view>
      <view class="budget-hint">* 实际消费可能因个人选择有所浮动</view>
    </view>
  </view>

  <!-- 备选方案 -->
  <view class="section">
    <view class="section-title">
      <text class="title-icon">🔄</text>
      <text>备选方案</text>
    </view>
    
    <view class="alternative-card">
      <view class="alt-item">
        <view class="alt-icon">🍱</view>
        <view class="alt-content">
          <view class="alt-name">如果餐厅排队</view>
          <view class="alt-desc">推荐附近同评分的「绿茶餐厅」，步行5分钟可达</view>
        </view>
      </view>
      <view class="alt-divider"></view>
      <view class="alt-item">
        <view class="alt-icon">🌧️</view>
        <view class="alt-content">
          <view class="alt-name">如果下雨</view>
          <view class="alt-desc">户外项目可替换为「室内卡丁车」或「VR体验馆」</view>
        </view>
      </view>
      <view class="alt-divider"></view>
      <view class="alt-item">
        <view class="alt-icon">⏰</view>
        <view class="alt-content">
          <view class="alt-name">如果时间不够</view>
          <view class="alt-desc">可跳过最后一站，预计节省1小时和¥50</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-left">
      <view class="bottom-btn" bindtap="toggleLike">
        <text class="bottom-icon">{{plan.liked ? '❤️' : '🤍'}}</text>
        <text class="bottom-text">收藏</text>
      </view>
      <view class="bottom-btn" bindtap="sharePlan">
        <text class="bottom-icon">📤</text>
        <text class="bottom-text">分享</text>
      </view>
    </view>
    <view class="bottom-right">
      <button class="btn-vote" bindtap="goVote">发起投票</button>
      <button class="btn-budget" bindtap="goBudget">预算分摊</button>
    </view>
  </view>
</view>
