/* pages/detail/detail.wxss */
.page {
  padding-bottom: 180rpx;
  background: #F7F7F7;
  min-height: 100vh;
}

/* 头部 */
.header {
  position: relative;
  padding: 40rpx 30rpx 60rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  z-index: 0;
}

.header-content {
  position: relative;
  z-index: 1;
  color: #fff;
}

.plan-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.plan-tags {
  margin-bottom: 24rpx;
}

.plan-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.plan-stats {
  display: flex;
  gap: 32rpx;
}

.stat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
}

.stat-icon {
  font-size: 32rpx;
}

.stat-value {
  font-weight: 600;
}

/* 区块 */
.section {
  margin: 0 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 30rpx;
}

.title-icon {
  font-size: 36rpx;
}

/* 时间轴 */
.timeline {
  padding-left: 10rpx;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 30rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #DDD;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #FF6B6B;
  flex-shrink: 0;
}

.timeline-dot.first {
  background: #FF6B6B;
  width: 24rpx;
  height: 24rpx;
}

.timeline-dot.last {
  background: #FF6B6B;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background: #FFE0E0;
  margin: 8rpx 0;
  min-height: 100rpx;
}

.timeline-content {
  flex: 1;
  padding-bottom: 30rpx;
}

.time-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #FFF0F0;
  color: #FF6B6B;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.place-card {
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx;
}

.place-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.place-activity {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.place-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.info-icon {
  font-size: 26rpx;
}

.place-actions {
  display: flex;
  gap: 16rpx;
}

.action-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #EEE;
}

/* 预算卡 */
.budget-card {
  background: #FFF9F9;
  border-radius: 16rpx;
  padding: 24rpx;
}

.budget-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #666;
}

.budget-amount {
  font-weight: 500;
  color: #333;
}

.budget-divider {
  height: 1rpx;
  background: #FFE0E0;
  margin: 12rpx 0;
}

.budget-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 8rpx;
}

.total-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.total-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.budget-hint {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  margin-top: 8rpx;
}

/* 备选方案 */
.alternative-card {
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 10rpx 24rpx;
}

.alt-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
}

.alt-icon {
  font-size: 40rpx;
  width: 60rpx;
  text-align: center;
}

.alt-content {
  flex: 1;
}

.alt-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.alt-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.alt-divider {
  height: 1rpx;
  background: #EEE;
  margin-left: 80rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  gap: 24rpx;
}

.bottom-left {
  display: flex;
  gap: 32rpx;
}

.bottom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #666;
}

.bottom-icon {
  font-size: 40rpx;
}

.bottom-text {
  font-size: 22rpx;
}

.bottom-right {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.btn-vote {
  flex: 1;
  height: 80rpx;
  background: #FFF0F0;
  color: #FF6B6B;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-budget {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
