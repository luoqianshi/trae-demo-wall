/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: #F7F7F7;
  padding-bottom: 120rpx;
}

/* 用户头部 */
.user-header {
  position: relative;
  padding-bottom: 30rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
}

.user-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 60rpx 30rpx 30rpx;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.avatar-emoji {
  font-size: 64rpx;
}

.user-info {
  flex: 1;
  color: #fff;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.edit-btn {
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 30rpx;
  color: #fff;
  font-size: 26rpx;
}

/* 数据统计 */
.stats-row {
  position: relative;
  display: flex;
  background: #fff;
  margin: 0 20rpx;
  border-radius: 20rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stat-col {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #F0F0F0;
}

.stat-col:last-child {
  border-right: none;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B6B;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  margin: 30rpx 20rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #FFF0F0;
  color: #FF6B6B;
  font-weight: 600;
}

/* 列表容器 */
.list-container {
  padding: 0 20rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 方案列表 */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 16rpx;
}

.plan-content {
  flex: 1;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.plan-meta {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.plan-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  padding: 4rpx 12rpx;
  background: #FFF0F0;
  color: #FF6B6B;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.plan-arrow {
  font-size: 36rpx;
  color: #CCC;
}

.plan-like {
  padding: 10rpx;
  font-size: 36rpx;
}

/* 功能菜单 */
.menu-section {
  margin: 30rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.menu-item {
  text-align: center;
}

.menu-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #666;
}

/* 设置菜单 */
.settings-section {
  margin: 0 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  font-size: 32rpx;
}

.setting-text {
  font-size: 28rpx;
  color: #333;
}

.setting-arrow {
  font-size: 32rpx;
  color: #CCC;
}
