<!--pages/profile/profile.wxml-->
<view class="page">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="header-bg"></view>
    <view class="user-card">
      <view class="avatar">
        <text class="avatar-emoji">🎉</text>
      </view>
      <view class="user-info">
        <view class="user-name">派对规划达人</view>
        <view class="user-desc">已组织 {{historyCount}} 场派对</view>
      </view>
      <view class="edit-btn">
        <text>编辑</text>
      </view>
    </view>

    <!-- 数据统计 -->
    <view class="stats-row">
      <view class="stat-col">
        <view class="stat-num">{{historyCount}}</view>
        <view class="stat-label">历史方案</view>
      </view>
      <view class="stat-col">
        <view class="stat-num">{{favoritesCount}}</view>
        <view class="stat-label">我的收藏</view>
      </view>
      <view class="stat-col">
        <view class="stat-num">12</view>
        <view class="stat-label">参与投票</view>
      </view>
      <view class="stat-col">
        <view class="stat-num">5</view>
        <view class="stat-label">好友数</view>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 'history' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="history"
    >
      <text>📋 历史方案</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'favorites' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="favorites"
    >
      <text>❤️ 我的收藏</text>
    </view>
  </view>

  <!-- 列表内容 -->
  <view class="list-container">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{activeTab === 'history' && historyList.length === 0}}">
      <view class="empty-icon">📝</view>
      <view class="empty-text">还没有历史方案</view>
      <view class="empty-desc">去首页生成你的第一个派对方案吧~</view>
      <button class="empty-btn" bindtap="goHome">去生成方案</button>
    </view>

    <view class="empty-state" wx:if="{{activeTab === 'favorites' && favoritesList.length === 0}}">
      <view class="empty-icon">❤️</view>
      <view class="empty-text">还没有收藏的方案</view>
      <view class="empty-desc">看到喜欢的方案点个小心心收藏吧~</view>
    </view>

    <!-- 方案列表 -->
    <view class="plan-list" wx:if="{{activeTab === 'history' && historyList.length > 0}}">
      <view 
        class="plan-item" 
        wx:for="{{historyList}}" 
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <view class="plan-content">
          <view class="plan-title">{{item.title}}</view>
          <view class="plan-meta">
            <text>💰 ¥{{item.budget}}/人</text>
            <text>⏱️ {{item.duration}}</text>
            <text>📍 {{item.schedule.length}}站</text>
          </view>
          <view class="plan-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>
        <view class="plan-arrow">›</view>
      </view>
    </view>

    <view class="plan-list" wx:if="{{activeTab === 'favorites' && favoritesList.length > 0}}">
      <view 
        class="plan-item" 
        wx:for="{{favoritesList}}" 
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <view class="plan-content">
          <view class="plan-title">{{item.title}}</view>
          <view class="plan-meta">
            <text>💰 ¥{{item.budget}}/人</text>
            <text>⏱️ {{item.duration}}</text>
            <text>📍 {{item.schedule.length}}站</text>
          </view>
          <view class="plan-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>
        <view class="plan-like" catchtap="toggleFavorite" data-id="{{item.id}}">
          <text>❤️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">常用功能</view>
    <view class="menu-grid">
      <view class="menu-item" bindtap="goBudget">
        <view class="menu-icon">🧮</view>
        <text class="menu-text">记账本</text>
      </view>
      <view class="menu-item">
        <view class="menu-icon">⏰</view>
        <text class="menu-text">预约提醒</text>
      </view>
      <view class="menu-item">
        <view class="menu-icon">🎁</view>
        <text class="menu-text">优惠卷</text>
      </view>
      <view class="menu-item">
        <view class="menu-icon">👥</view>
        <text class="menu-text">好友管理</text>
      </view>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="settings-section">
    <view class="setting-item" bindtap="showAbout">
      <view class="setting-left">
        <text class="setting-icon">ℹ️</text>
        <text class="setting-text">关于我们</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">💬</text>
        <text class="setting-text">意见反馈</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-icon">⚙️</text>
        <text class="setting-text">设置</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>
</view>
