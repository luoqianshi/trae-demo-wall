/* pages/vote/vote.wxss */
.page {
  min-height: 100vh;
  background: #F7F7F7;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 50rpx 30rpx 80rpx;
  color: #fff;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 方案卡 */
.plan-card {
  margin: -40rpx 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.plan-badge {
  position: absolute;
  top: 0;
  right: 30rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.plan-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
  padding-right: 120rpx;
}

.plan-tags {
  margin-bottom: 16rpx;
}

.plan-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #FFF0F0;
  color: #FF6B6B;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.plan-info {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #666;
}

/* 区块 */
.section {
  margin: 0 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: #FFF0F0;
  border-radius: 20rpx;
}

/* 投票人列表 */
.voter-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.voter-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
}

.voter-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.voter-info {
  flex: 1;
}

.voter-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.voter-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6BCB77;
}

.voter-status.pending {
  color: #999;
}

.status-icon {
  font-size: 26rpx;
}

.voter-action {
  padding: 10rpx 20rpx;
  background: #FF6B6B;
  border-radius: 30rpx;
}

.action-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* 投票统计 */
.vote-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stats-item {
  text-align: center;
}

.stats-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B6B;
  margin-bottom: 6rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEE;
}

.vote-bar {
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.vote-progress {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

/* 选项列表 */
.option-list {
  margin-bottom: 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.option-item.selected {
  background: #FFF5F5;
  border-color: #FF6B6B;
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #CCC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-item.selected .option-radio {
  border-color: #FF6B6B;
}

.radio-inner {
  width: 24rpx;
  height: 24rpx;
  background: #FF6B6B;
  border-radius: 50%;
}

.option-content {
  flex: 1;
}

.option-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

.option-votes {
  text-align: right;
}

.votes-count {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.votes-text {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn[disabled] {
  background: #DDD;
  color: #999;
}

/* 分享区 */
.share-section {
  padding: 20rpx;
}

.share-card {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE8E8 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.share-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.share-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.share-btn {
  background: #FF6B6B;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 60rpx;
  display: inline-block;
}
