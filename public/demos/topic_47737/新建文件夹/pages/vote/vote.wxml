<!--pages/vote/vote.wxml-->
<view class="page">
  <view class="header">
    <view class="header-title">方案投票</view>
    <view class="header-subtitle">分享给朋友们，一起选出最喜欢的方案 🎉</view>
  </view>

  <!-- 当前方案 -->
  <view class="plan-card">
    <view class="plan-badge">当前方案</view>
    <view class="plan-title">{{plan.title}}</view>
    <view class="plan-tags">
      <text class="plan-tag" wx:for="{{plan.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="plan-info">
      <text>💰 ¥{{plan.budget}}/人</text>
      <text>⏱️ {{plan.duration}}</text>
      <text>⭐ {{plan.rating}}分</text>
    </view>
  </view>

  <!-- 投票参与人 -->
  <view class="section">
    <view class="section-title">
      <text>参与投票（{{voters.length}}人）</text>
      <view class="add-btn" bindtap="addVoter">
        <text>+ 添加</text>
      </view>
    </view>
    
    <view class="voter-list">
      <view class="voter-item" wx:for="{{voters}}" wx:key="id">
        <view class="voter-avatar" style="background: {{item.color}}">{{item.name.charAt(0)}}</view>
        <view class="voter-info">
          <view class="voter-name">{{item.name}}</view>
          <view class="voter-status" wx:if="{{item.voted}}">
            <text class="status-icon">✅</text>
            <text>已投票</text>
          </view>
          <view class="voter-status pending" wx:else>
            <text class="status-icon">⏳</text>
            <text>等待投票</text>
          </view>
        </view>
        <view class="voter-action" bindtap="simulateVote" data-id="{{item.id}}" wx:if="{{!item.voted}}">
          <text class="action-text">模拟投票</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 投票进度 -->
  <view class="section">
    <view class="section-title">
      <text>投票统计</text>
    </view>
    
    <view class="vote-stats">
      <view class="stats-item">
        <view class="stats-number">{{votedCount}}</view>
        <view class="stats-label">已投票</view>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <view class="stats-number">{{voters.length - votedCount}}</view>
        <view class="stats-label">未投票</view>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <view class="stats-number">{{votePercent}}%</view>
        <view class="stats-label">支持率</view>
      </view>
    </view>

    <view class="vote-bar">
      <view class="vote-progress" style="width: {{votePercent}}%"></view>
    </view>
  </view>

  <!-- 投票选项（多方案对比时显示） -->
  <view class="section">
    <view class="section-title">
      <text>方案选项</text>
    </view>
    
    <view class="option-list">
      <view 
        class="option-item {{selectedOption === item.id ? 'selected' : ''}}"
        wx:for="{{options}}"
        wx:key="id"
        bindtap="selectOption"
        data-id="{{item.id}}"
      >
        <view class="option-radio">
          <view class="radio-inner" wx:if="{{selectedOption === item.id}}"></view>
        </view>
        <view class="option-content">
          <view class="option-title">{{item.title}}</view>
          <view class="option-desc">人均¥{{item.budget}} · {{item.duration}} · {{item.schedule.length}}站</view>
        </view>
        <view class="option-votes">
          <text class="votes-count">{{item.votes}}</text>
          <text class="votes-text">票</text>
        </view>
      </view>
    </view>

    <button class="submit-btn" bindtap="submitVote" disabled="{{!selectedOption}}">
      提交投票
    </button>
  </view>

  <!-- 分享卡片 -->
  <view class="share-section">
    <view class="share-card">
      <view class="share-icon">📤</view>
      <view class="share-text">分享给朋友一起投票</view>
      <button class="share-btn" open-type="share">
        立即分享
      </button>
    </view>
  </view>
</view>
