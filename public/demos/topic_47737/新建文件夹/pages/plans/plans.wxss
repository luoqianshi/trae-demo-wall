/* pages/plans/plans.wxss */
.page {
  min-height: 100vh;
  background: #F7F7F7;
  padding-bottom: 40rpx;
}

/* 加载动画 */
.loading-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFFFFF 100%);
}

.loading-animation {
  text-align: center;
}

.loading-circle {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid #FFE0E0;
  border-top-color: #FF6B6B;
  border-radius: 50%;
  margin: 0 auto 40rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.loading-subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 条件栏 */
.condition-bar {
  background: #fff;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.condition-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.condition-icon {
  margin-right: 6rpx;
}

.condition-text {
  font-weight: 500;
}

.condition-divider {
  color: #DDD;
  font-size: 24rpx;
}

/* 方案头部 */
.plans-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
}

.plans-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.refresh-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #FF6B6B;
  gap: 6rpx;
}

/* 方案列表 */
.plan-list {
  padding: 0 20rpx;
}

.plan-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.plan-rank {
  position: absolute;
  top: 0;
  right: 30rpx;
}

.rank-badge {
  padding: 8rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

.rank-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
}

.rank-2 {
  background: linear-gradient(135deg, #C0C0C0 0%, #A8A8A8 100%);
}

.rank-3 {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
}

.plan-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-right: 20rpx;
}

.plan-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  flex: 1;
}

.plan-like {
  padding: 8rpx;
}

.like-icon {
  font-size: 40rpx;
}

.plan-tags {
  margin-bottom: 20rpx;
}

.plan-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #FFF0F0;
  color: #FF6B6B;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.plan-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #666;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-value {
  font-weight: 500;
}

.plan-preview {
  margin-bottom: 24rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}

.preview-time {
  color: #FF6B6B;
  font-weight: 600;
  width: 100rpx;
}

.preview-dot {
  margin: 0 12rpx;
  color: #DDD;
}

.preview-place {
  flex: 1;
  color: #333;
}

.preview-more {
  font-size: 24rpx;
  color: #999;
  padding-left: 112rpx;
  padding-top: 8rpx;
}

.plan-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #666;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
}

.bottom-tip {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}
