<!--pages/plans/plans.wxml-->
<view class="page">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-animation">
      <view class="loading-circle"></view>
      <view class="loading-text">AI 正在为你生成方案...</view>
      <view class="loading-subtitle">分析心情偏好 · 匹配周边商家 · 优化路线时间</view>
    </view>
  </view>

  <!-- 方案列表 -->
  <view class="plans-container" wx:else>
    <!-- 顶部条件回顾 -->
    <view class="condition-bar">
      <view class="condition-item">
        <text class="condition-icon">{{moodInfo.icon}}</text>
        <text class="condition-text">{{moodInfo.name}}</text>
      </view>
      <view class="condition-divider">·</view>
      <view class="condition-item">{{peopleCount}}人</view>
      <view class="condition-divider">·</view>
      <view class="condition-item">¥{{budget}}/人</view>
      <view class="condition-divider">·</view>
      <view class="condition-item">{{duration}}</view>
    </view>

    <view class="plans-header">
      <text class="plans-title">为你推荐 {{plans.length}} 套方案</text>
      <view class="refresh-btn" bindtap="refreshPlans">
        <text>🔄</text>
        <text>换一批</text>
      </view>
    </view>

    <!-- 方案卡片 -->
    <view class="plan-list">
      <view 
        class="plan-card" 
        wx:for="{{plans}}" 
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <view class="plan-rank" wx:if="{{index < 3}}">
          <text class="rank-badge rank-{{index + 1}}">TOP{{index + 1}}</text>
        </view>
        
        <view class="plan-header">
          <view class="plan-title">{{item.title}}</view>
          <view class="plan-like" catchtap="toggleLike" data-id="{{item.id}}">
            <text class="like-icon {{item.liked ? 'liked' : ''}}">{{item.liked ? '❤️' : '🤍'}}</text>
          </view>
        </view>

        <view class="plan-tags">
          <text class="plan-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>

        <view class="plan-stats">
          <view class="stat-item">
            <text class="stat-icon">💰</text>
            <text class="stat-value">¥{{item.budget}}/人</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">⏱️</text>
            <text class="stat-value">{{item.duration}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">⭐</text>
            <text class="stat-value">{{item.rating}}分</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">📍</text>
            <text class="stat-value">{{item.schedule.length}}站</text>
          </view>
        </view>

        <view class="plan-preview">
          <view class="preview-item" wx:for="{{item.schedule}}" wx:for-item="stop" wx:key="time" wx:if="{{index < 3}}">
            <text class="preview-time">{{stop.time}}</text>
            <text class="preview-dot">•</text>
            <text class="preview-place">{{stop.place}}</text>
          </view>
          <view class="preview-more" wx:if="{{item.schedule.length > 3}}">
            ...还有 {{item.schedule.length - 3}} 个站点
          </view>
        </view>

        <view class="plan-actions">
          <view class="action-btn secondary" catchtap="startVote" data-id="{{item.id}}">
            <text>📊</text>
            <text>发起投票</text>
          </view>
          <view class="action-btn primary" catchtap="viewDetail" data-id="{{item.id}}">
            <text>查看详情</text>
            <text>→</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="bottom-tip">
      <text>💡 点击方案卡片查看详细路线和预算分摊</text>
    </view>
  </view>
</view>
