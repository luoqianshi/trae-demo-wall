<!--pages/index/index.wxml-->
<view class="page">
  <!-- 顶部横幅 -->
  <view class="banner">
    <view class="banner-title">今天心情如何？</view>
    <view class="banner-subtitle">选个心情，AI帮你安排完美派对 🎉</view>
    <view class="banner-emoji">✨🎊🎈</view>
  </view>

  <!-- 心情选择 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">选择心情风格</text>
      <text class="section-tip">选一个最贴合今天的感觉</text>
    </view>
    <view class="mood-grid">
      <view 
        class="mood-card {{selectedMood === item.id ? 'selected' : ''}}"
        wx:for="{{moods}}"
        wx:key="id"
        bindtap="selectMood"
        data-id="{{item.id}}"
        style="--mood-color: {{item.color}}"
      >
        <view class="mood-icon">{{item.icon}}</view>
        <view class="mood-name">{{item.name}}</view>
        <view class="mood-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 条件设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">设置聚会条件</text>
    </view>
    
    <view class="setting-card">
      <view class="setting-item">
        <view class="setting-icon">👥</view>
        <view class="setting-content">
          <view class="setting-label">参与人数</view>
          <view class="setting-value">
            <view class="counter">
              <view class="counter-btn" bindtap="changePeople" data-type="-1">-</view>
              <view class="counter-num">{{peopleCount}}人</view>
              <view class="counter-btn" bindtap="changePeople" data-type="1">+</view>
            </view>
          </view>
        </view>
      </view>

      <view class="setting-divider"></view>

      <view class="setting-item">
        <view class="setting-icon">📍</view>
        <view class="setting-content">
          <view class="setting-label">所在区域</view>
          <picker mode="selector" range="{{areas}}" value="{{areaIndex}}" bindchange="onAreaChange">
            <view class="picker-value">
              {{areas[areaIndex]}}
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="setting-divider"></view>

      <view class="setting-item">
        <view class="setting-icon">💰</view>
        <view class="setting-content">
          <view class="setting-label">人均预算</view>
          <view class="budget-slider">
            <slider 
              min="50" 
              max="500" 
              step="10" 
              value="{{budget}}" 
              activeColor="#FF6B6B" 
              block-size="24"
              bindchange="onBudgetChange"
            />
            <view class="budget-value">¥{{budget}}/人</view>
          </view>
        </view>
      </view>

      <view class="setting-divider"></view>

      <view class="setting-item">
        <view class="setting-icon">⏰</view>
        <view class="setting-content">
          <view class="setting-label">预计时长</view>
          <view class="duration-options">
            <view 
              class="duration-option {{duration === item ? 'active' : ''}}"
              wx:for="{{durations}}"
              wx:key="*this"
              bindtap="selectDuration"
              data-duration="{{item}}"
            >{{item}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <view class="generate-section">
    <button class="generate-btn" bindtap="generatePlans" disabled="{{!selectedMood}}">
      <text class="btn-icon">🤖</text>
      <text>AI 生成派对方案</text>
    </button>
    <view class="generate-tip" wx:if="{{!selectedMood}}">请先选择心情风格哦~</view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-section">
    <view class="section-header">
      <text class="section-title">快捷场景</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="quickSelect" data-mood="fun" data-people="6">
        <view class="quick-icon">🎂</view>
        <text>生日派对</text>
      </view>
      <view class="quick-item" bindtap="quickSelect" data-mood="date" data-people="2">
        <view class="quick-icon">💑</view>
        <text>情侣约会</text>
      </view>
      <view class="quick-item" bindtap="quickSelect" data-mood="relax" data-people="4">
        <view class="quick-icon">☕</view>
        <text>闺蜜小聚</text>
      </view>
      <view class="quick-item" bindtap="quickSelect" data-mood="budget" data-people="8">
        <view class="quick-icon">🎓</view>
        <text>同学聚会</text>
      </view>
    </view>
  </view>
</view>
