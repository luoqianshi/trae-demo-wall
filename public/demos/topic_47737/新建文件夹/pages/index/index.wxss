/* pages/index/index.wxss */
.page {
  padding-bottom: 120rpx;
}

.banner {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 50%, #FFB4B4 100%);
  padding: 60rpx 40rpx 80rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.banner-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.banner-emoji {
  font-size: 48rpx;
  position: absolute;
  right: 40rpx;
  bottom: 40rpx;
}

.section {
  padding: 30rpx;
  margin-top: -40rpx;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.section + .section {
  margin-top: 0;
  padding-top: 10rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.section-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.mood-card {
  background: #FAFAFA;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.mood-card.selected {
  background: #FFF5F5;
  border-color: var(--mood-color);
  transform: scale(1.02);
}

.mood-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.mood-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.mood-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.3;
}

.setting-card {
  background: #FAFAFA;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.setting-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 60rpx;
  text-align: center;
}

.setting-content {
  flex: 1;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.setting-value {
  display: flex;
  align-items: center;
}

.counter {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 6rpx;
}

.counter-btn {
  width: 56rpx;
  height: 56rpx;
  background: #FF6B6B;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 300;
}

.counter-num {
  min-width: 100rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.setting-divider {
  height: 1rpx;
  background: #EEE;
  margin-left: 84rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #FF6B6B;
  font-weight: 500;
}

.picker-arrow {
  font-size: 36rpx;
  color: #CCC;
}

.budget-slider {
  padding-right: 20rpx;
}

.budget-slider slider {
  margin: 0;
}

.budget-value {
  text-align: right;
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
  margin-top: -10rpx;
}

.duration-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.duration-option {
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #EEE;
}

.duration-option.active {
  background: #FF6B6B;
  color: #fff;
  border-color: #FF6B6B;
}

.generate-section {
  padding: 30rpx;
  text-align: center;
}

.generate-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
}

.generate-btn[disabled] {
  background: #DDD;
  box-shadow: none;
  color: #999;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 38rpx;
}

.generate-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.quick-section {
  padding: 30rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  background: #FFF5F5;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
