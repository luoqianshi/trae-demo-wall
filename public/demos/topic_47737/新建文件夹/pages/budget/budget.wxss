/* pages/budget/budget.wxss */
.page {
  min-height: 100vh;
  background: #F7F7F7;
  padding-bottom: 160rpx;
}

.header {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 50rpx 30rpx 80rpx;
  color: #fff;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 总览卡 */
.overview-card {
  margin: -40rpx 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.overview-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.overview-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.stat-value.highlight {
  color: #FF6B6B;
  font-size: 40rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEE;
}

/* 区块 */
.section {
  margin: 0 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.add-btn {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: #FFF0F0;
  border-radius: 20rpx;
}

/* 成员列表 */
.person-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.person-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
}

.person-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.person-info {
  flex: 1;
}

.person-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.person-role {
  display: inline-block;
}

.payer-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #FFE4E4;
  color: #FF6B6B;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.person-amount {
  text-align: right;
  margin-right: 10rpx;
}

.amount-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 2rpx;
}

.amount-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.person-actions {
  display: flex;
  align-items: center;
}

.action-icon {
  font-size: 36rpx;
  padding: 8rpx;
}

/* 分摊方式 */
.split-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.split-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.split-option.active {
  background: #FFF5F5;
  border-color: #FF6B6B;
}

.option-icon {
  font-size: 40rpx;
  width: 60rpx;
  text-align: center;
}

.option-info {
  flex: 1;
}

.option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

.option-check {
  width: 40rpx;
  height: 40rpx;
  background: #FF6B6B;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

/* 费用明细 */
.expense-list {
  margin-bottom: 20rpx;
}

.expense-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.expense-item:last-child {
  border-bottom: none;
}

.expense-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.expense-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
}

.expense-info {
  flex: 1;
}

.expense-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.expense-place {
  font-size: 24rpx;
  color: #999;
}

.expense-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.per-person {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
  margin-left: 4rpx;
}

.expense-summary {
  background: #FFF9F9;
  border-radius: 16rpx;
  padding: 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.summary-label {
  font-size: 26rpx;
  color: #666;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.summary-row.total {
  padding-top: 16rpx;
  margin-top: 10rpx;
  border-top: 1rpx dashed #FFD0D0;
}

.summary-row.total .summary-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.summary-row.total .summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B6B;
}

/* 转账建议 */
.transfer-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.transfer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F0F9FF;
  border-radius: 16rpx;
}

.transfer-flow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.transfer-name {
  font-weight: 500;
}

.transfer-arrow {
  color: #4D96FF;
  font-weight: 700;
}

.transfer-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #4D96FF;
}

.transfer-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding-top: 10rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-share,
.btn-copy {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-share {
  background: #FFF0F0;
  color: #FF6B6B;
}

.btn-copy {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
}
