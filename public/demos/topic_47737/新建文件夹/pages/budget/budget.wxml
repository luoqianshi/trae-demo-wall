<!--pages/budget/budget.wxml-->
<view class="page">
  <view class="header">
    <view class="header-title">预算分摊</view>
    <view class="header-subtitle">轻松算清楚每个人该付多少钱 💰</view>
  </view>

  <!-- 方案总览 -->
  <view class="overview-card">
    <view class="overview-title">{{plan.title}}</view>
    <view class="overview-stats">
      <view class="stat-item">
        <view class="stat-label">总预算</view>
        <view class="stat-value">¥{{totalBudget}}</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">参与人数</view>
        <view class="stat-value">{{peopleCount}}人</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">人均</view>
        <view class="stat-value highlight">¥{{perPerson}}</view>
      </view>
    </view>
  </view>

  <!-- 参与者列表 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">参与成员</text>
      <view class="add-btn" bindtap="addPerson">
        <text>+ 添加</text>
      </view>
    </view>
    
    <view class="person-list">
      <view class="person-item" wx:for="{{people}}" wx:key="id">
        <view class="person-avatar" style="background: {{item.color}}">{{item.name.charAt(0)}}</view>
        <view class="person-info">
          <view class="person-name">{{item.name}}</view>
          <view class="person-role" wx:if="{{item.payer}}">
            <text class="payer-badge">付款人</text>
          </view>
        </view>
        <view class="person-amount">
          <view class="amount-label">应付</view>
          <view class="amount-value">¥{{item.amount}}</view>
        </view>
        <view class="person-actions">
          <view class="action-icon" bindtap="togglePayer" data-id="{{item.id}}">
            {{item.payer ? '💳' : '🤝'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 分摊方式 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">分摊方式</text>
    </view>
    
    <view class="split-options">
      <view 
        class="split-option {{splitType === 'equal' ? 'active' : ''}}"
        bindtap="selectSplitType"
        data-type="equal"
      >
        <view class="option-icon">⚖️</view>
        <view class="option-info">
          <view class="option-name">AA制</view>
          <view class="option-desc">所有人平均分摊</view>
        </view>
        <view class="option-check" wx:if="{{splitType === 'equal'}}">✓</view>
      </view>

      <view 
        class="split-option {{splitType === 'custom' ? 'active' : ''}}"
        bindtap="selectSplitType"
        data-type="custom"
      >
        <view class="option-icon">✏️</view>
        <view class="option-info">
          <view class="option-name">自定义分摊</view>
          <view class="option-desc">每人金额自己定</view>
        </view>
        <view class="option-check" wx:if="{{splitType === 'custom'}}">✓</view>
      </view>

      <view 
        class="split-option {{splitType === 'payer' ? 'active' : ''}}"
        bindtap="selectSplitType"
        data-type="payer"
      >
        <view class="option-icon">🎁</view>
        <view class="option-info">
          <view class="option-name">某个人请客</view>
          <view class="option-desc">选中的人付全部</view>
        </view>
        <view class="option-check" wx:if="{{splitType === 'payer'}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">费用明细</text>
    </view>
    
    <view class="expense-list">
      <view class="expense-item" wx:for="{{plan.schedule}}" wx:key="time">
        <view class="expense-left">
          <view class="expense-icon">📍</view>
          <view class="expense-info">
            <view class="expense-name">{{item.activity}}</view>
            <view class="expense-place">{{item.place}}</view>
          </view>
        </view>
        <view class="expense-amount">
          <text>¥{{item.cost}}</text>
          <text class="per-person">/人</text>
        </view>
      </view>
    </view>

    <view class="expense-summary">
      <view class="summary-row">
        <text class="summary-label">小计（人均）</text>
        <text class="summary-value">¥{{plan.budget}}</text>
      </view>
      <view class="summary-row total">
        <text class="summary-label">总计（{{peopleCount}}人）</text>
        <text class="summary-value">¥{{totalBudget}}</text>
      </view>
    </view>
  </view>

  <!-- 转账记录 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">转账建议</text>
    </view>
    
    <view class="transfer-list">
      <view class="transfer-item" wx:for="{{transfers}}" wx:key="id">
        <view class="transfer-flow">
          <text class="transfer-name">{{item.from}}</text>
          <text class="transfer-arrow">→</text>
          <text class="transfer-name">{{item.to}}</text>
        </view>
        <view class="transfer-amount">¥{{item.amount}}</view>
      </view>
    </view>

    <view class="transfer-tip">
      💡 以上为建议转账金额，实际可根据情况调整
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <button class="btn-share" bindtap="shareSettle">
      <text>📤</text>
      <text>分享账单</text>
    </button>
    <button class="btn-copy" bindtap="copyBill">
      <text>📋</text>
      <text>复制明细</text>
    </button>
  </view>
</view>
