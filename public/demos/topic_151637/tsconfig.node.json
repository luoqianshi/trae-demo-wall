{
  "compilerOptions": {
    "composite": true,
    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "types": ["electron-vite/node", "node"],
    "outDir": "./out/types/node"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/sandbox/**/*",
    "src/agents/**/*",
    "src/storage/**/*",
    "src/types/**/*"
  ]
}
