{
  "name": "微博热搜话题（模拟）",
  "description": "10 个话题 12 个时点的分时热度（模拟），并带 5 大分类标签。",
  "columns": {
    "timestamp": {
      "label": "时间",
      "type": "datetime",
      "role": "time"
    },
    "topic": {
      "label": "话题",
      "type": "string",
      "role": "dimension"
    },
    "category": {
      "label": "分类",
      "type": "string",
      "role": "dimension"
    },
    "heat": {
      "label": "热度",
      "type": "number",
      "role": "measure"
    }
  },
  "suggested_charts": [
    "line",
    "bar",
    "stacked_bar"
  ]
}