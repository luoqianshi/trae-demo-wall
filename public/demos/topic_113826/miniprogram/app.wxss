/* app.wxss - 全局样式（暖黄色调，温馨风格） */

page {
  --color-primary: #ffd699;
  --color-primary-dark: #f5a623;
  --color-primary-soft: #fff7e6;
  --color-pink: #ff6699;
  --color-pink-soft: #ffe4ec;
  --color-blue: #4a90d9;
  --color-blue-soft: #e8f4fc;
  --color-success: #9bc34a;
  --color-success-soft: #e8f5d9;
  --color-yellow: #ffd699;
  --color-yellow-soft: #fff7e6;
  --color-orange: #ffb366;
  --color-orange-soft: #fff0e0;
  --color-text-dark: #666666;
  --color-text: #8b8b8b;
  --color-text-light: #b5b5b5;
  --color-bg: #f6f0de;
  --color-card: #ffffff;
  --color-border: #e8e0d0;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family:
    -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 卡片 */
.card {
  background-color: var(--color-card);
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 214, 153, 0.12);
  border: 2rpx solid var(--color-border);
}

/* 标签 chip */
.chip {
  display: inline-block;
  padding: 18rpx 36rpx;
  border-radius: 100rpx;
  background-color: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font-size: 28rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}
.chip-success {
  background-color: #e9f4dc;
  color: #5a8a3e;
}
.chip-danger {
  background-color: #fbe4df;
  color: #b5513f;
}

/* 按钮 */
.btn-primary {
  background-color: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 100rpx;
  padding: 22rpx 0;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 214, 153, 0.28);
}
.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: var(--color-card);
  color: var(--color-text-dark);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 100rpx;
  padding: 20rpx 0;
  border: 2rpx solid var(--color-border);
}
.btn-secondary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary-dark);
  font-size: 28rpx;
  padding: 18rpx 0;
}

/* 文字样式 */
.text-dark {
  color: var(--color-text-dark);
}
.text-primary {
  color: var(--color-primary-dark);
}
.text-success {
  color: #5a8a3e;
}
.text-danger {
  color: #b5513f;
}
.text-light {
  color: var(--color-text-light);
}
.text-sm {
  font-size: 24rpx;
}
.text-lg {
  font-size: 32rpx;
  font-weight: 700;
}
.text-xl {
  font-size: 40rpx;
  font-weight: 700;
}

/* 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.flex-wrap {
  flex-wrap: wrap;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.mt-8 {
  margin-top: 16rpx;
}
.mt-16 {
  margin-top: 32rpx;
}
.mt-24 {
  margin-top: 48rpx;
}
.mb-8 {
  margin-bottom: 16rpx;
}
.mb-16 {
  margin-bottom: 32rpx;
}
.pad-24 {
  padding: 24rpx;
}
.text-center {
  text-align: center;
}
.text-right {
  text-align: right;
}

/* 表单 */
.form-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}
.form-input {
  background-color: #ffffff;
  border: 2rpx solid #e4d8b0;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  color: #3a352c;
  width: 100%;
  box-sizing: border-box;
  line-height: 2.5;
  margin-bottom: 8rpx;
}
.form-textarea {
  background-color: #ffffff;
  border: 2rpx solid #e4d8b0;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  font-size: 32rpx;
  color: #3a352c;
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
}

/* 统计数字 */
.stat-box {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  margin: 20rpx;
  border: 2rpx solid var(--color-border);
  box-shadow: 0 4rpx 14rpx rgba(200, 170, 90, 0.08);
}
.stat-item {
  text-align: center;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary-dark);
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 6rpx;
}

/* 列表条目（通用，用于我的 - 菜单列表） */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background-color: #fff;
  border-bottom: 2rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text-dark);
}
.list-item:last-child {
  border-bottom: none;
}
.list-item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background-color: var(--color-primary-soft);
  color: var(--color-primary-dark);
  text-align: center;
  line-height: 64rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.list-item-text {
  flex: 1;
}
.list-item-arrow {
  color: var(--color-text-light);
  font-size: 32rpx;
}
.list-item-badge {
  color: var(--color-primary-dark);
  font-size: 24rpx;
  margin-right: 12rpx;
}

/* 时间线 */
.timeline {
  padding-left: 10rpx;
}
.timeline-item {
  position: relative;
  padding: 0 0 32rpx 40rpx;
  border-left: 4rpx solid var(--color-primary-soft);
}
.timeline-item:last-child {
  border-left: 4rpx solid transparent;
}
.timeline-item::before {
  content: "";
  position: absolute;
  left: -12rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  background-color: var(--color-primary);
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 4rpx var(--color-primary-soft);
}
.timeline-item.danger::before {
  background-color: var(--color-danger);
  box-shadow: 0 0 0 4rpx #fbe4df;
}
.timeline-date {
  font-size: 24rpx;
  color: var(--color-text-light);
}
.timeline-content {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-dark);
  padding: 16rpx 20rpx;
  background-color: var(--color-primary-soft);
  border-radius: 14rpx;
}
.timeline-content.danger {
  background-color: #fbe4df;
  color: #7a3c35;
}

/* 图片上传九宫格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.photo-cell {
  aspect-ratio: 1;
  background-color: var(--color-primary-soft);
  border-radius: 16rpx;
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary-dark);
  font-size: 40rpx;
  border: 2rpx dashed #f2d88a;
}
.photo-cell.filled {
  border: 2rpx solid transparent;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: var(--color-text-light);
  font-size: 26rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-dark);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: var(--color-text-light);
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background-color: var(--color-border);
  margin: 20rpx 0;
}

/* 大图片展示 */
.hero-image {
  width: 100%;
  height: 560rpx;
  background-size: cover;
  background-position: center;
}

/* 操作栏（固定在底部的两个按钮） */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-shadow: 0 -4rpx 14rpx rgba(200, 170, 90, 0.1);
  z-index: 100;
}
.action-bar + .page-bottom-space {
  height: 260rpx;
}
.page-bottom-space {
  height: 200rpx;
}
