/* miniprogram/pages/index/index.wxss */

.page {
  padding-bottom: 180rpx;
  background-color: #f6f0de;
}

/* Banner区域 */
.banner {
  margin: 0;
  border-radius: 0;
  position: relative;
  overflow: hidden;
  height: 320rpx;
}
.banner-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}
.banner-content {
  position: relative;
  z-index: 2;
  padding: 40rpx 32rpx;
}
.banner-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #666666;
}
.banner-paw {
  font-size: 36rpx;
  margin-left: 12rpx;
}
.banner-subtitle {
  font-size: 26rpx;
  color: #8b8b8b;
  margin-top: 16rpx;
}
.banner-decoration {
  position: absolute;
  right: -20rpx;
  bottom: -20rpx;
  z-index: 2;
}
.banner-heart-bubble {
  position: absolute;
  right: 80rpx;
  top: 40rpx;
  font-size: 36rpx;
}
.banner-house {
  font-size: 100rpx;
  position: absolute;
  right: 20rpx;
  bottom: 60rpx;
}
.banner-dog {
  font-size: 80rpx;
  position: absolute;
  right: 40rpx;
  bottom: 20rpx;
}
.banner-grass {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding-bottom: 8rpx;
}
.grass-item {
  font-size: 32rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 48rpx;
  padding: 24rpx 36rpx;
  margin: 24rpx;
  border: 2rpx solid #ffd699;
}
.search-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 16rpx;
}
.search-box input {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
}

/* 位置信息栏 */
.location-bar {
  margin: 24rpx;
  padding: 32rpx 36rpx;
  background: #ffffff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #ffd699;
}
.location-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.location-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.location-city {
  font-size: 32rpx;
  font-weight: 700;
  color: #666666;
}
.location-hint {
  font-size: 24rpx;
  color: #ffb366;
  margin-top: 8rpx;
}
.location-cat {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

/* 筛选区域 */
.filter-section {
  padding: 20rpx 24rpx;
}
.filter-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}
.filter-row:first-child {
  margin-bottom: 16rpx;
}
.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
  color: #8b8b8b;
  font-size: 26rpx;
  border: 2rpx solid #e8e0d0;
  gap: 8rpx;
}
.filter-tab.active {
  background-color: #ffd699;
  color: #666666;
  border-color: #ffd699;
  font-weight: 600;
}
.filter-tab.tag {
  padding: 14rpx 12rpx;
}
.filter-tab-img {
  width: 32rpx;
  height: 32rpx;
}
.filter-tab-icon {
  width: 36rpx;
  height: 36rpx;
}
.filter-tab-text {
  font-size: 26rpx;
}

/* 动物卡片 */
.animal-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 214, 153, 0.15);
  border: 2rpx solid #e8e0d0;
  position: relative;
}
.card-left {
  position: relative;
  flex-shrink: 0;
}
.card-image {
  width: 280rpx;
  height: 280rpx;
}
.card-name-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}
.card-name-tag.pink {
  background-color: #ff6699;
}
.card-name-tag.blue {
  background-color: #4a90d9;
}
.card-pixel-decor {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 56rpx;
  height: 56rpx;
}
.card-right {
  flex: 1;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #666666;
}
.card-meta {
  font-size: 24rpx;
  color: #b5b5b5;
  margin-top: 8rpx;
}
.card-location {
  font-size: 24rpx;
  color: #8b8b8b;
  margin-top: 8rpx;
}
.location-dot {
  font-size: 22rpx;
}
.card-distance {
  color: #ffb366;
  font-size: 24rpx;
}
.card-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.card-tag {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background-color: #fff7e6;
  color: #f5a623;
}
.card-tag.success {
  background-color: #e8f5d9;
  color: #9bc34a;
}
.card-tag.pink {
  background-color: #ffe4ec;
  color: #ff6699;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.card-stats {
  font-size: 22rpx;
  color: #b5b5b5;
}
.card-detail-link {
  font-size: 26rpx;
  color: #ffb366;
  font-weight: 500;
}
.card-fav {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}
.fav-icon {
  font-size: 32rpx;
}
.card-bottom-heart {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  font-size: 40rpx;
}

/* 列表底部 */
.list-footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #b5b5b5;
}

/* 城市选择浮层 */
.city-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 99;
}
.city-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f6f0de;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  z-index: 100;
}
.city-picker-header {
  padding: 32rpx 40rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.city-picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #666666;
}
.city-picker-close {
  font-size: 44rpx;
  color: #b5b5b5;
  line-height: 1;
  padding: 0 12rpx;
}
.city-picker-search {
  padding: 12rpx 40rpx;
}
.city-picker-search input {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  border: 2rpx solid #e8e0d0;
}
.city-picker-relocate {
  margin: 8rpx 40rpx 16rpx;
  padding: 18rpx;
  background: #fff7e6;
  color: #f5a623;
  border-radius: 16rpx;
  font-size: 26rpx;
  text-align: center;
}
.city-picker-list {
  padding: 0 40rpx 40rpx;
  height: 60vh;
}
.city-picker-group-title {
  font-size: 24rpx;
  color: #b5b5b5;
  padding: 24rpx 0 12rpx;
}
.city-picker-city-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.city-picker-city {
  padding: 16rpx 32rpx;
  background: #ffffff;
  color: #666666;
  border-radius: 12rpx;
  font-size: 26rpx;
  min-width: 140rpx;
  text-align: center;
  border: 2rpx solid #e8e0d0;
}
.city-picker-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #b5b5b5;
}
