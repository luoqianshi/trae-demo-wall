<!-- miniprogram/pages/index/index.wxml -->
<view class="page">
  <view class="banner">
    <image class="banner-bg" src="/stylepic/image.png" mode="aspectFit"></image>
  </view>

  <view class="search-box" bindtap="focusSearch">
    <image class="search-icon" src="/stylepic/搜索框.png" mode="aspectFit"></image>
    <input placeholder-style="color:#a8a094" placeholder="搜搜 动物名、品种、关键字..." value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onConfirmSearch"/>
  </view>

  <view class="location-bar" bindtap="tapLocation">
    <image class="location-icon" src="/stylepic/定位.png" mode="aspectFit"></image>
    <view class="location-info">
      <text class="location-city">{{locationText}}</text>
      <text class="location-hint">{{locationHint || '点击切换城市'}}</text>
    </view>
    <image class="location-cat" src="/stylepic/ChatGPT-Image-2026年7月5日-20_31_59_03.png" mode="aspectFit"></image>
  </view>

  <view class="filter-section">
    <view class="filter-row">
      <view class="filter-tab {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onSpeciesTab" wx:for="{{speciesTabs}}" wx:key="key">
        <image class="filter-tab-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="filter-tab-text">{{item.label}}</text>
      </view>
    </view>
    <view class="filter-row">
      <view class="filter-tab tag {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTagTab" wx:for="{{tagTabs}}" wx:key="key">
        <image class="filter-tab-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="filter-tab-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="_id" class="animal-card" bindtap="goDetail" data-id="{{item._id}}">
      <view class="card-left">
        <image class="card-image" src="{{item.images[0]}}" mode="aspectFill"></image>
        <view class="card-name-tag {{item.tagStyle || 'pink'}}">{{item.name}}</view>
      </view>
      <view class="card-right">
        <view class="card-title">{{item.name}} · {{item.breed}}</view>
        <view class="card-meta">{{item.gender === 'female' ? '母' : '公'}} · {{item.ageMonth}}月 · {{item.weight}}kg</view>
        <view class="card-location">
          <text class="location-dot">📍</text>
          {{item.addressText}}
          <text class="card-distance">· {{item.distanceKm}} km</text>
        </view>
        <view class="card-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="card-tag">{{tag}}</text>
        </view>
        <view class="card-footer">
          <text class="card-stats">浏览 {{item.viewCount}} · 关注 {{item.favoriteCount}}</text>
          <text class="card-detail-link">查看详情 ></text>
        </view>
      </view>
      <view class="card-fav" bindtap="toggleFavorite" data-id="{{item._id}}">
        <text class="fav-icon">{{item.favorited ? '⭐' : '☆'}}</text>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-icon">🐾</view>
    <view class="empty-title">附近暂时没有符合条件的小家伙</view>
    <view class="empty-desc">试试更换筛选条件，或换一个位置看看</view>
  </view>

  <view class="list-footer">共 {{total}} 只待领养的小家伙</view>

  <view class="city-picker-mask" wx:if="{{showCityPicker}}" bindtap="closeCityPicker"></view>
  <view class="city-picker" wx:if="{{showCityPicker}}">
    <view class="city-picker-header">
      <text class="city-picker-title">选择城市</text>
      <text class="city-picker-close" bindtap="closeCityPicker">×</text>
    </view>
    <view class="city-picker-search">
      <input placeholder="搜索城市名" value="{{citySearchText}}" bindinput="onCitySearch" confirm-type="search"/>
    </view>
    <view class="city-picker-relocate" bindtap="onRelocate">
      <text>📍 重新获取定位</text>
    </view>
    <scroll-view class="city-picker-list" scroll-y>
      <block wx:if="{{filteredCityGroups.length > 0}}">
        <block wx:for="{{filteredCityGroups}}" wx:for-item="group" wx:key="province">
          <view class="city-picker-group-title">{{group.province}}</view>
          <view class="city-picker-city-grid">
            <text
              wx:for="{{group.cities}}"
              wx:for-item="city"
              wx:key="name"
              class="city-picker-city"
              data-name="{{city.name}}"
              data-lat="{{city.lat}}"
              data-lng="{{city.lng}}"
              bindtap="onSelectCity"
            >{{city.name}}</text>
          </view>
        </block>
      </block>
      <view wx:else class="city-picker-empty">没有找到相关城市</view>
    </scroll-view>
  </view>
</view>