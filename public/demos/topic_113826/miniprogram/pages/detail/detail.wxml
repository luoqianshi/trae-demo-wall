<!-- miniprogram/pages/detail/detail.wxml -->
<view class="page" wx:if="{{detail}}">
  <!-- 图集轮播 -->
  <swiper class="hero-image" indicator-dots autoplay circular indicator-color="rgba(255,255,255,0.6)" indicator-active-color="#d9a23e">
    <swiper-item wx:for="{{detail.images}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" style="width: 100%; height: 100%;" bindtap="previewImage" data-url="{{item}}"></image>
    </swiper-item>
  </swiper>

  <!-- 基本信息 -->
  <view class="card" style="margin-top:-40rpx; position: relative; z-index: 2;">
    <view class="flex-between">
      <view class="text-xl">{{detail.name}}</view>
      <view class="text-primary text-lg" bindtap="toggleFavorite">
        <text wx:if="{{isFavorite}}">关注</text>
        <text wx:else>未关注</text>
      </view>
    </view>
    <view class="text-light text-sm mt-8">{{detail.breed}}</view>
    <view class="text-dark mt-8">{{detail.gender === 'female' ? '母 女生' : '公 男生'}} · {{detail.ageMonth}}月 · {{detail.weight}}kg</view>
    <view style="margin-top: 16rpx;">
      <text wx:if="{{detail.sterilized}}" class="chip chip-success">已绝育</text>
      <text wx:if="{{detail.vaccinated}}" class="chip chip-success">已疫苗</text>
      <text wx:for="{{detail.tags}}" wx:for-item="tag" wx:key="*this" class="chip">{{tag}}</text>
    </view>
    <view class="divider"></view>
    <view class="flex-row">
      <view class="stat-item" style="flex:1;"><view class="stat-value">{{detail.viewCount}}</view><view class="stat-label">浏览</view></view>
      <view class="stat-item" style="flex:1;"><view class="stat-value">{{detail.favoriteCount}}</view><view class="stat-label">关注</view></view>
      <view class="stat-item" style="flex:1;"><view class="stat-value">{{detail.applyCount}}</view><view class="stat-label">申请</view></view>
    </view>
  </view>

  <view class="card">
    <view class="text-lg">地址 来自哪里</view>
    <view class="text-light text-sm mt-8">由 {{detail.publisherName}} 发布于 {{createDate}}</view>
    <view class="text-dark mt-8">{{detail.addressText}}</view>
  </view>

  <view class="card">
    <view class="text-lg">介绍 性格介绍</view>
    <view class="text-dark mt-8" style="line-height: 1.8;">{{detail.description}}</view>
  </view>

  <view class="card">
    <view class="text-lg">健康 健康与疫苗</view>
    <view class="text-dark mt-8">{{detail.healthNote || '暂无特殊说明'}}</view>
  </view>

  <view class="card">
    <view class="text-lg">须知 领养须知</view>
    <view class="text-dark mt-8" style="line-height: 1.8;">
      1. 需要通过结构化问卷了解家庭情况。
      2. 约定视频或上门沟通。
      3. 双方确认后签署电子领养协议。
      4. 领养后第 7 / 30 / 90 / 365 天回访，按时回访会获得信用分。
    </view>
  </view>

  <view class="page-bottom-space"></view>
  <view class="action-bar">
    <button class="btn-primary" bindtap="goApply">我要领养它 →</button>
    <button class="btn-secondary" bindtap="contactPublisher">联系发布者</button>
    <button class="btn-secondary" bindtap="toggleFavorite">{{isFavorite ? '取消关注' : '加关注'}}</button>
  </view>
</view>

<view wx:else class="empty-state">加载中…</view>
