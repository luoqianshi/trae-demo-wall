<!-- miniprogram/pages/mine/mine.wxml -->
<view class="page">
  <image class="bg-image" src="/stylepic/背景.png" mode="aspectFit"></image>
  
  <view class="hero-section">
    <image class="hero-decor-right" src="/stylepic/yellow_stand.gif" mode="aspectFit"></image>
    <view class="flex-row">
      <view class="avatar-wrap">
        <image class="avatar" src="{{user.avatarUrl}}"></image>
        <image class="avatar-badge" src="/stylepic/爱心.png" mode="aspectFit"></image>
      </view>
      <view class="user-info">
        <view class="user-name-row">
          <text class="text-lg">{{user.nickname}}</text>
          <image class="name-badge" src="/stylepic/爪子.png" mode="aspectFit"></image>
        </view>
        <view class="text-light text-sm">信用分 {{user.creditScore}} · {{user.residenceCity}}</view>
      </view>
    </view>
  </view>

  <view class="stat-card">
    <image class="stat-decor-left" src="/stylepic/brown_sit.jpg" mode="aspectFit"></image>
    <view class="stat-box">
      <view class="stat-item" bindtap="goApplications">
        <image class="stat-icon" src="/stylepic/爪子.png" mode="aspectFit"></image>
        <view class="stat-value">{{stats.applyCount}}</view>
        <view class="stat-label">我的申请</view>
      </view>
      <view class="stat-item" bindtap="goMyFav">
        <image class="stat-icon" src="/stylepic/爱心.png" mode="aspectFit"></image>
        <view class="stat-value">{{stats.favCount}}</view>
        <view class="stat-label">我的关注</view>
      </view>
      <view class="stat-item" bindtap="goReviews">
        <image class="stat-icon" src="/stylepic/保护.png" mode="aspectFit"></image>
        <view class="stat-value">{{stats.reviewCount}}</view>
        <view class="stat-label">回访记录</view>
      </view>
    </view>
  </view>

  <view class="card list-card">
    <view class="list-item" bindtap="goApplications">
      <view class="list-item-icon-wrap notes">
        <image class="list-item-icon-img" src="/stylepic/爪子.png" mode="aspectFit"></image>
      </view>
      <view class="list-item-text">我的领养申请</view>
      <image class="list-item-decor" src="/stylepic/grey_lay.gif" mode="aspectFit"></image>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-item" bindtap="goReviews">
      <view class="list-item-icon-wrap chat">
        <image class="list-item-icon-img" src="/stylepic/爱心.png" mode="aspectFit"></image>
      </view>
      <view class="list-item-text">我的回访记录</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-item" bindtap="goMyFav">
      <view class="list-item-icon-wrap fav">
        <image class="list-item-icon-img" src="/stylepic/[笑脸].png" mode="aspectFit"></image>
      </view>
      <view class="list-item-text">我关注的小家伙</view>
      <image class="list-item-decor" src="/stylepic/grey_sit.gif" mode="aspectFit"></image>
      <view class="list-item-arrow">›</view>
    </view>
  </view>

  <view class="card list-card">
    <view class="list-item" bindtap="editProfile">
      <view class="list-item-icon-wrap user">
        <image class="list-item-icon-img" src="/stylepic/猫猫.png" mode="aspectFit"></image>
      </view>
      <view class="list-item-text">修改资料</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-item" bindtap="showAbout">
      <view class="list-item-icon-wrap info">
        <image class="list-item-icon-img" src="/stylepic/狗狗.png" mode="aspectFit"></image>
      </view>
      <view class="list-item-text">关于暖爪归家</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-item reset-item" bindtap="resetAll">
      <view class="list-item-icon-wrap reset">
        <image class="list-item-icon-img" src="/stylepic/重置.png" mode="aspectFit"></image>
      </view>
      <view class="list-item-text">重置演示数据</view>
      <image class="list-item-decor reset" src="/stylepic/brown_sit.jpg" mode="aspectFit"></image>
      <view class="list-item-arrow">›</view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">暖爪归家 v1.0</text>
  </view>
</view>
