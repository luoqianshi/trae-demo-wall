/* miniprogram/pages/mine/mine.wxss */
page {
  min-height: 100vh;
  background-color: transparent;
}

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.bg-image {
  position: fixed;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 120%;
  height: 100%;
  z-index: -1;
}

.hero-section {
  position: relative;
  padding: 60rpx 32rpx 40rpx;
}

.hero-decor-right {
  position: absolute;
  right: 20rpx;
  top: 40rpx;
  width: 100rpx;
  height: 100rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 71, 0.3);
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
}

.user-info {
  margin-left: 24rpx;
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.name-badge {
  width: 32rpx;
  height: 32rpx;
}

.stat-card {
  position: relative;
  margin: 0 24rpx 24rpx;
}

.stat-decor-left {
  position: absolute;
  left: -20rpx;
  bottom: -10rpx;
  width: 60rpx;
  height: 60rpx;
  z-index: 1;
}

.stat-box {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 32rpx 20rpx;
  border: 3rpx solid rgba(255, 214, 153, 0.4);
  box-shadow: 0 8rpx 24rpx rgba(255, 179, 71, 0.12);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  transition: transform 0.2s ease;
}

.stat-item:active {
  transform: scale(0.95);
}

.stat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #f5a623;
}

.stat-label {
  font-size: 24rpx;
  color: #a8a094;
  margin-top: 4rpx;
}

.card.list-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 0;
  border: 3rpx solid rgba(255, 214, 153, 0.3);
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 71, 0.08);
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #666;
  border-bottom: 2rpx solid rgba(255, 214, 153, 0.2);
  position: relative;
  overflow: hidden;
  transition: background-color 0.2s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: rgba(255, 247, 230, 0.6);
}

.list-item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.list-item-icon-wrap.notes {
  background: linear-gradient(135deg, #fff3d6, #ffe4b3);
}

.list-item-icon-wrap.chat {
  background: linear-gradient(135deg, #ffe4ec, #ffc2d1);
}

.list-item-icon-wrap.fav {
  background: linear-gradient(135deg, #fff3d6, #ffe4b3);
}

.list-item-icon-wrap.user {
  background: linear-gradient(135deg, #e8f4fc, #c7e5f6);
}

.list-item-icon-wrap.info {
  background: linear-gradient(135deg, #e9f4dc, #d4e9c2);
}

.list-item-icon-wrap.reset {
  background: linear-gradient(135deg, #fbe4df, #f5c9bf);
}

.list-item-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.list-item-text {
  flex: 1;
  font-weight: 500;
}

.list-item-decor {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.list-item-decor.reset {
  width: 56rpx;
  height: 56rpx;
}

.list-item-arrow {
  color: #ccc;
  font-size: 36rpx;
  flex-shrink: 0;
}

.reset-item {
  background: rgba(245, 193, 191, 0.1);
}

.reset-item .list-item-text {
  color: #b5513f;
}

.reset-item .list-item-arrow {
  color: #b5513f;
}

.footer {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #a8a094;
}
