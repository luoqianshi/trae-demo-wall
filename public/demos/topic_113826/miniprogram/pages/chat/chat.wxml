<view class="chat-container">
  <scroll-view 
    class="chat-list" 
    scroll-y 
    scroll-top="{{scrollTop}}"
    bindscrolltolower="onScrollToLower"
  >
    <view class="chat-welcome">
      <text class="welcome-text">已为您连接到发布者</text>
      <text class="welcome-sub">请礼貌咨询领养相关事宜</text>
    </view>

    <view 
      wx:for="{{messages}}" 
      wx:key="id"
      class="message-item {{item.isSelf ? 'self' : 'other'}}"
    >
      <view class="avatar">
        <image wx:if="{{item.isSelf}}" src="https://picsum.photos/seed/user/100/60" mode="aspectFill"/>
        <image wx:else src="{{publisherAvatar}}" mode="aspectFill"/>
      </view>
      <view class="message-content">
        <view wx:if="{{!item.isSelf}}" class="sender-name">{{publisherName}}</view>
        <view class="bubble">{{item.content}}</view>
        <view class="message-time">{{item.time}}</view>
      </view>
    </view>

    <view wx:if="{{isLoading}}" class="loading-indicator">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </scroll-view>

  <view class="chat-input-bar">
    <input 
      class="input-box"
      placeholder="输入消息..."
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      confirm-type="send"
    />
    <button 
      class="send-btn" 
      bindtap="sendMessage"
      disabled="{{!inputText.trim() || isLoading}}"
    >
      发送
    </button>
  </view>
</view>