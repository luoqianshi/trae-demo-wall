.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f3ead0;
}

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat-welcome {
  text-align: center;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.welcome-text {
  display: block;
  font-size: 28rpx;
  color: #6b6458;
  margin-bottom: 8rpx;
}

.welcome-sub {
  font-size: 24rpx;
  color: #a8a094;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
}

.message-item.self {
  flex-direction: row-reverse;
}

.message-item.other {
  flex-direction: row;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.message-content {
  max-width: 75%;
  margin: 0 16rpx;
}

.sender-name {
  font-size: 22rpx;
  color: #a8a094;
  margin-bottom: 8rpx;
}

.message-item.self .sender-name {
  display: none;
}

.bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message-item.other .bubble {
  background-color: #ffffff;
  color: #3a352c;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  border: 1rpx solid #e8e2cc;
}

.message-item.self .bubble {
  background-color: #d9a23e;
  color: #fff;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
}

.message-time {
  font-size: 20rpx;
  color: #c8c2b4;
  margin-top: 8rpx;
}

.message-item.self .message-time {
  text-align: right;
}

.loading-indicator {
  display: flex;
  justify-content: flex-start;
  padding: 16rpx 0;
}

.loading-dots {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e8e2cc;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #d9a23e;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: dotPulse 1.4s infinite ease-in-out;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #fff;
  border-top: 1rpx solid #f3ead0;
  box-sizing: border-box;
}

.input-box {
  flex: 1;
  height: 80rpx;
  background-color: #f5f1e6;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #3a352c;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  margin-left: 20rpx;
  background-color: #d9a23e;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.send-btn[disabled] {
  background-color: #e8d9b0;
  color: #c8c2b4;
}