<!-- miniprogram/pages/reviews/reviews.wxml -->
<view class="page">
  <view class="hero-section">
    <view class="hero-title">我的回访</view>
    <view class="hero-subtitle">记录它的新生活，温暖一份责任</view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="_id" class="card">
      <view class="flex-between">
        <view class="text-lg">{{item.animalName}}</view>
        <text class="chip" style="background-color: {{item.statusColor}}; color: {{item.statusTextColor}};">{{item.statusText}}</text>
      </view>
      <view class="text-light text-sm mt-8">{{item.stageLabel}}</view>
      <view wx:if="{{item.status === 'pending'}}" class="text-dark mt-8" style="line-height: 1.8;">
        尚未提交。点击下方按钮上传近况照片与文字描述。
      </view>
      <view wx:else class="text-dark mt-8" style="line-height: 1.8;">{{item.content || '已提交回访内容'}}</view>
      <view wx:if="{{item.staffNote}}" class="note" style="margin-top: 16rpx; background-color: #fff4d6; border-radius: 12rpx; padding: 16rpx 20rpx;">
        <text class="text-primary text-sm">工作人员备注：</text>
        <text class="text-dark text-sm"> {{item.staffNote}}</text>
      </view>
      <button wx:if="{{item.status === 'pending'}}" class="btn-primary" style="margin-top: 24rpx;" bindtap="submitReview" data-id="{{item._id}}">提交本次回访</button>
    </view>
  </block>

  <view wx:else class="empty-state">暂无回访记录</view>
</view>
