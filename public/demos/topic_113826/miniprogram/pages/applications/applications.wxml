<!-- miniprogram/pages/applications/applications.wxml -->
<view class="page">
  <view class="hero-section">
    <view class="hero-title">我的申请</view>
    <view class="hero-subtitle">你的每一次善意都有回响</view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="_id" class="card">
      <view class="flex-between">
        <view class="text-lg">{{item.animalName}}</view>
        <text class="chip" style="background-color: {{item.statusColor}}; color: {{item.statusTextColor}};">{{item.statusText}}</text>
      </view>
      <view class="text-light text-sm mt-8">提交时间：{{item.createTimeText}}</view>
      <view wx:if="{{item.status === 'approved'}}" class="text-success text-sm mt-8" style="line-height: 1.8;">
        🎉 恭喜通过！工作人员会在 24 小时内联系您签署电子领养协议。
      </view>
      <view wx:if="{{item.status === 'pending'}}" class="text-light text-sm mt-8" style="line-height: 1.8;">
        ⏳ 审核中，请耐心等待工作人员联系。
      </view>
      <view wx:if="{{item.status === 'rejected'}}" class="text-danger text-sm mt-8" style="line-height: 1.8;">
        抱歉，本次申请未通过。您可继续申请其他小动物。
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    还没有申请记录\n去首页看看有哪些可爱的小伙伴吧
  </view>
</view>
