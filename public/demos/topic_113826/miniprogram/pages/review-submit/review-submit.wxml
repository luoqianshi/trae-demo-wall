<!-- miniprogram/pages/review-submit/review-submit.wxml -->
<view class="page">
  <view class="hero-section">
    <view class="hero-title">提交回访 照片</view>
    <view class="hero-subtitle">分享它最近的生活，让爱心延续</view>
  </view>

  <view class="card">
    <view class="form-label">近况照片（至少 1 张）</view>
    <view class="photo-grid" style="margin-top: 16rpx;">
      <view wx:for="{{form.images}}" wx:key="*this" class="photo-cell filled" style="background-image: url('{{item}}');" bindtap="removeImage" data-index="{{index}}"></view>
      <view wx:if="{{form.images.length < 9}}" bindtap="chooseImage">添加</view>
    </view>
  </view>

  <view class="card">
    <view class="form-label">健康状况</view>
    <view class="flex-row" style="margin-top: 12rpx;">
      <view wx:for="{{healthList}}" wx:key="key" class="chip {{form.healthStatus === item.key ? 'chip-success' : ''}}" style="padding: 16rpx 28rpx; font-size: 26rpx; margin-right: 12rpx;" data-key="{{item.key}}" bindtap="chooseHealth">{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <view class="form-label">文字描述</view>
    <textarea class="form-textarea" placeholder-style="color:#a8a094" placeholder="它最近吃得好吗？开心吗？和家人相处得怎么样？" value="{{form.content}}" data-field="content" bindinput="onInput"></textarea>
  </view>

  <view class="card">
    <view class="form-label">自我评分（1 ～ 5）</view>
    <view class="flex-row" style="margin-top: 12rpx; gap: 16rpx;">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="chip {{form.rating >= item ? 'chip-success' : ''}}" style="padding: 20rpx 32rpx; font-size: 32rpx;" data-rating="{{item}}" bindtap="chooseRating">{{item}}</view>
    </view>
  </view>

  <view class="page-bottom-space"></view>
  <view class="action-bar">
    <button class="btn-primary" bindtap="submit">提交回访记录</button>
  </view>
</view>
