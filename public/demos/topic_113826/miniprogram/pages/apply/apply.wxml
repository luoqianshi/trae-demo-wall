<!-- miniprogram/pages/apply/apply.wxml -->
<view class="page">
  <view class="hero-section">
    <view class="hero-title">我想给它一个家</view>
    <view class="hero-subtitle">请认真填写以下信息，这会影响申请结果</view>
  </view>

  <view class="card" wx:if="{{animalName}}">
    <view class="text-lg">申请领养的小家伙</view>
    <view class="text-primary text-xl mt-8">{{animalName}}</view>
  </view>

  <view class="card">
    <view class="text-lg">申请人信息</view>

    <view style="margin-top: 28rpx;">
      <view class="form-label">昵称</view>
      <input class="form-input" placeholder-style="color:#a8a094" placeholder="请填写您的昵称" value="{{form.nickname}}" data-field="nickname" bindinput="onInput" />
    </view>

    <view style="margin-top: 28rpx;">
      <view class="form-label">电话（仅联系用）</view>
      <input class="form-input" type="number" placeholder="便于工作人员联系回访" value="{{form.phone}}" data-field="phone" bindinput="onInput"/>
    </view>

    <view style="margin-top: 28rpx;">
      <view class="form-label">所在城市</view>
      <input class="form-input" placeholder-style="color:#a8a094" placeholder="例如：北京" value="{{form.city}}" data-field="city" bindinput="onInput"/>
    </view>
  </view>

  <view class="card">
    <view class="text-lg">家庭与居住</view>

    <view style="margin-top: 28rpx;">
      <view class="form-label">居住类型</view>
      <view class="flex-row">
        <view wx:for="{{housingList}}" wx:key="key" class="chip {{form.housingType === item.key ? 'chip-success' : ''}}" style="padding: 16rpx 28rpx; font-size: 26rpx; margin-right: 12rpx; margin-bottom: 12rpx;" data-key="{{item.key}}" bindtap="chooseHousing">{{item.label}}</view>
      </view>
    </view>

    <view style="margin-top: 28rpx;">
      <view class="form-label">居住面积(㎡)</view>
      <input class="form-input" type="digit" placeholder="例如：60" value="{{form.spaceSize}}" data-field="spaceSize" bindinput="onInput"/>
    </view>

    <view style="margin-top: 28rpx;">
      <view class="form-label">家庭成员人数</view>
      <input class="form-input" type="number" placeholder="例如：3" value="{{form.familyMembers}}" data-field="familyMembers" bindinput="onInput"/>
    </view>

    <view class="flex-row" style="margin-top: 16rpx; gap: 16rpx;">
      <view class="chip {{form.allAgree ? 'chip-success' : ''}}" style="padding: 16rpx 28rpx; font-size: 26rpx;" data-field="allAgree" bindtap="toggleBool">家人都同意</view>
      <view class="chip {{form.hasYard ? 'chip-success' : ''}}" style="padding: 16rpx 28rpx; font-size: 26rpx;" data-field="hasYard" bindtap="toggleBool">有庭院</view>
    </view>

    <view style="margin-top: 16rpx;">
      <view class="form-label">养宠经验</view>
      <textarea class="form-textarea" placeholder-style="color:#a8a094" placeholder="例：有养猫经验1年，目前家里有一只" value="{{form.petExperience}}" data-field="petExperience" bindinput="onInput"></textarea>
    </view>
  </view>

  <view class="card">
    <view class="text-lg">领养问卷</view>
    <view style="margin-top: 16rpx;">
      <view class="form-label">为什么想领养它？</view>
      <textarea class="form-textarea" placeholder-style="color:#a8a094" placeholder="请简单说明你的动机…" value="{{form.reason}}" data-field="reason" bindinput="onInput"></textarea>
    </view>
    <view style="margin-top: 16rpx;">
      <view class="form-label">每天能陪伴多长时间？</view>
      <input class="form-input" placeholder-style="color:#a8a094" placeholder="例如：每天2小时" value="{{form.timeCommitment}}" data-field="timeCommitment" bindinput="onInput"/>
    </view>
    <view style="margin-top: 16rpx;">
      <view class="form-label">经济能力</view>
      <input class="form-input" placeholder-style="color:#a8a094" placeholder="例如：可以承担每月 500 元" value="{{form.financialAbility}}" data-field="financialAbility" bindinput="onInput"/>
    </view>
    <view style="margin-top: 16rpx;">
      <view class="form-label">家里其他宠物（可空）</view>
      <input class="form-input" placeholder-style="color:#a8a094" placeholder="例如：家里有一只猫" value="{{form.otherPets}}" data-field="otherPets" bindinput="onInput"/>
    </view>
  </view>

  <view class="card">
    <view class="text-lg">承诺</view>
    <view class="flex-row" style="margin-top: 16rpx; align-items: flex-start;">
      <view class="chip {{form.agreeReturn ? 'chip-success' : ''}}" style="padding: 16rpx 28rpx; font-size: 26rpx;" data-field="agreeReturn" bindtap="toggleBool">我同意</view>
      <view class="text-dark" style="flex:1; margin-left: 16rpx; line-height: 1.8;">如因特殊原因无法继续饲养，我承诺会主动联系发布者并配合安排合适的新家庭，绝不随意遗弃。</view>
    </view>
  </view>

  <view class="page-bottom-space"></view>
  <view class="action-bar">
    <button class="btn-primary" bindtap="submit">提交申请</button>
  </view>
</view>