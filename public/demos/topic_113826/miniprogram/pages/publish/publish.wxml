<!-- miniprogram/pages/publish/publish.wxml -->
<view class="page">
  <image class="hero-banner" src="/stylepic/banner.png" mode="widthFix"></image>

  <view class="card photo-card">
    <view class="card-header">
      <image class="card-icon" src="/stylepic/爱心.png" mode="aspectFit"></image>
      <text class="card-title">照片（至少1张，最多9张）</text>
    </view>
    <view class="photo-grid">
      <view wx:for="{{form.images}}" wx:key="*this" class="photo-cell filled" style="background-image: url('{{item}}');" bindtap="removeImage" data-index="{{index}}"></view>
      <view wx:if="{{form.images.length < 9}}" class="photo-cell add-btn" bindtap="chooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加照片</text>
      </view>
    </view>
    <image class="card-decor-right" src="/stylepic/grey_sit.gif" mode="aspectFit"></image>
  </view>

  <view class="card">
    <view class="card-header">
      <image class="card-icon" src="/stylepic/爪子.png" mode="aspectFit"></image>
      <text class="card-title">基本信息</text>
    </view>

    <view class="form-item">
      <text class="form-label">名字</text>
      <view class="form-input-wrap">
        <input class="form-input" placeholder-style="color:#a8a094" placeholder="例如：小黄" value="{{form.name}}" data-field="name" bindinput="onInput"/>
        <image class="input-icon" src="/stylepic/yellow_lay.gif" mode="aspectFit"></image>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">物种</text>
      <view class="chip-group">
        <view wx:for="{{speciesList}}" wx:key="key" class="species-chip {{form.species === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="chooseSpecies">
          <image class="chip-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <text class="chip-text">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">品种</text>
      <picker bindchange="onPickBreed" range="{{breedList[form.species]}}">
        <view class="form-input-wrap picker-wrap">
          <text wx:if="{{form.breed}}" class="picker-text">{{form.breed}}</text>
          <text wx:else class="picker-placeholder">点击选择品种</text>
          <image class="input-icon" src="/stylepic/爪子.png" mode="aspectFit"></image>
        </view>
      </picker>
    </view>

    <view class="form-row">
      <view class="form-item half">
        <text class="form-label">月龄</text>
        <view class="form-input-wrap">
          <input class="form-input" type="digit" placeholder="例如：12月" value="{{form.ageMonth}}" data-field="ageMonth" bindinput="onInput"/>
          <image class="input-icon small" src="/stylepic/奶瓶.png" mode="aspectFit"></image>
        </view>
      </view>
      <view class="form-item half">
        <text class="form-label">体重(kg)</text>
        <view class="form-input-wrap">
          <input class="form-input" type="digit" placeholder="例如：5.2kg" value="{{form.weight}}" data-field="weight" bindinput="onInput"/>
          <image class="input-icon small" src="/stylepic/奶瓶.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <view class="chip-group">
        <view class="gender-chip male {{form.gender === 'male' ? 'active' : ''}}" data-key="male" bindtap="chooseGender">
          <text class="gender-icon">♂</text>
          <text class="chip-text">公 男生</text>
        </view>
        <view class="gender-chip female {{form.gender === 'female' ? 'active' : ''}}" data-key="female" bindtap="chooseGender">
          <text class="gender-icon">♀</text>
          <text class="chip-text">母 女生</text>
        </view>
      </view>
    </view>
    <image class="card-decor-right" src="/stylepic/yellow_stand.gif" mode="aspectFit"></image>
  </view>

  <view class="card">
    <view class="card-header">
      <image class="card-icon" src="/stylepic/保护.png" mode="aspectFit"></image>
      <text class="card-title">健康与救助</text>
    </view>
    <view class="chip-group">
      <view class="health-chip {{form.sterilized ? 'active' : ''}}" data-field="sterilized" bindtap="toggleBool">
        <image class="chip-icon" src="/stylepic/保护.png" mode="aspectFit"></image>
        <text class="chip-text">已绝育</text>
      </view>
      <view class="health-chip {{form.vaccinated ? 'active' : ''}}" data-field="vaccinated" bindtap="toggleBool">
        <image class="chip-icon" src="/stylepic/奶瓶.png" mode="aspectFit"></image>
        <text class="chip-text">已疫苗</text>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">健康备注</text>
      <textarea class="form-textarea" placeholder-style="color:#a8a094" placeholder="健康状况、驱虫情况、特殊注意事项..." value="{{form.healthNote}}" data-field="healthNote" bindinput="onInput"></textarea>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <image class="card-icon" src="/stylepic/定位.png" mode="aspectFit"></image>
      <text class="card-title">位置与介绍</text>
    </view>
    <view class="form-item">
      <text class="form-label">城市</text>
      <picker bindchange="onPickCity" range="{{cityList}}">
        <view class="form-input-wrap picker-wrap">
          <text wx:if="{{form.city}}" class="picker-text">{{form.city}}</text>
          <text wx:else class="picker-placeholder">正在获取当前城市…</text>
          <image class="input-icon" src="/stylepic/定位.png" mode="aspectFit"></image>
        </view>
      </picker>
      <view class="location-status">
        <text wx:if="{{locationStatus === 'loading'}}">正在定位…</text>
        <text wx:elif="{{locationStatus === 'ok'}}">已自动填入 · 点击可手动更改</text>
        <text wx:elif="{{locationStatus === 'denied'}}">未授权定位 · 点击手动选择城市</text>
        <text wx:else>正在获取…</text>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input class="form-input" placeholder-style="color:#a8a094" placeholder="输入手机号，方便领养人联系你" value="{{form.phone}}" data-field="phone" bindinput="onInput"/>
    </view>
    <view class="form-item">
      <text class="form-label">性格描述</text>
      <textarea class="form-textarea" placeholder-style="color:#a8a094" placeholder="介绍它的性格、习惯、与人相处方式..." value="{{form.description}}" data-field="description" bindinput="onInput"></textarea>
    </view>
    <view class="form-item">
      <text class="form-label">标签（空格分隔，可空）</text>
      <input class="form-input" placeholder-style="color:#a8a094" placeholder="亲人 乖巧 已绝育" value="{{form.tagsText}}" data-field="tagsText" bindinput="onInput"/>
    </view>
  </view>

  <view class="page-bottom-space"></view>
  <view class="action-bar">
    <button class="btn-primary" bindtap="submit">
      <image class="btn-icon" src="/stylepic/爱心.png" mode="aspectFit"></image>
      <text class="btn-text">发布救助信息</text>
    </button>
  </view>
</view>