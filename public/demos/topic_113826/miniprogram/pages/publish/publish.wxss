/* miniprogram/pages/publish/publish.wxss */
.page {
  min-height: 100vh;
  background: #fffbf5;
  padding-bottom: 180rpx;
}

.hero-banner {
  width: 100%;
  display: block;
}

.card {
  margin: 32rpx 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(217, 162, 62, 0.1);
  position: relative;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.card-icon {
  width: 40rpx;
  height: 40rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #d9a23e;
}

.card-decor-right {
  width: 100rpx;
  height: 100rpx;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
}

.photo-card {
  padding-bottom: 100rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-cell {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #ffd699;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-cell.filled {
  background-size: cover;
  background-position: center;
  border: none;
}

.add-btn {
  background: #fff8e8;
  border-style: solid;
}

.add-icon {
  font-size: 48rpx;
  color: #ffb366;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #ffb366;
  margin-top: 8rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #8a7d6d;
  margin-bottom: 12rpx;
  display: block;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  background: #fffbf5;
  border-radius: 24rpx;
  padding: 0 24rpx;
  border: 2rpx solid #ffe4b3;
}

.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #3a3a3a;
  padding: 0 10px;
}

.input-icon {
  width: 50rpx;
  height: 50rpx;
  margin-left: 12rpx;
}

.input-icon.small {
  width: 36rpx;
  height: 36rpx;
}

.picker-wrap {
  height: 88rpx;
  display: flex;
  align-items: center;
}

.picker-text {
  flex: 1;
  font-size: 28rpx;
  color: #3a3a3a;
}

.picker-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #a8a094;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.species-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff8e8;
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  border: 2rpx solid #ffe4b3;
}

.species-chip.active {
  background: #e8f5e9;
  border-color: #81c784;
}

.chip-icon {
  width: 40rpx;
  height: 40rpx;
}

.chip-text {
  font-size: 28rpx;
  color: #d9a23e;
}

.species-chip.active .chip-text {
  color: #4caf50;
}

.gender-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 24rpx;
  padding: 20rpx 40rpx;
  border: 2rpx solid;
}

.gender-chip.male {
  background: #e3f2fd;
  border-color: #90caf9;
}

.gender-chip.male.active {
  background: #90caf9;
  border-color: #2196f3;
}

.gender-chip.female {
  background: #fce4ec;
  border-color: #f48fb1;
}

.gender-chip.female.active {
  background: #f48fb1;
  border-color: #e91e63;
}

.gender-icon {
  font-size: 32rpx;
}

.gender-chip.male .chip-text,
.gender-chip.male .gender-icon {
  color: #2196f3;
}

.gender-chip.female .chip-text,
.gender-chip.female .gender-icon {
  color: #e91e63;
}

.health-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff8e8;
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  border: 2rpx solid #ffe4b3;
}

.health-chip.active {
  background: #e8f5e9;
  border-color: #81c784;
}

.health-chip.active .chip-text {
  color: #4caf50;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #fffbf5;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #3a3a3a;
  border: 2rpx solid #ffe4b3;
  box-sizing: border-box;
}

.location-status {
  font-size: 22rpx;
  color: #a8a094;
  margin-top: 12rpx;
  padding-left: 8rpx;
}

.page-bottom-space {
  height: 120rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 251, 245, 0.95);
  backdrop-filter: blur(10px);
  padding: 50rpx 48rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid #ffe4b3;
}

.btn-primary {
  width: 100%;
  max-width: 380rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #ffd57f 0%, #ffb347 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 179, 71, 0.3);
  
}

.btn-primary::after {
  border: none;
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}
