page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1a1a1a;
  line-height: 1.6;
}

.container {
  padding: 16rpx 0;
}

/* Cards */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-subtitle {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

/* Tags */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-orange { background: #FEF0EB; color: #E8734A; }
.tag-green { background: #EEF7F2; color: #5B9A7D; }
.tag-gray { background: #f3f4f6; color: #6B7280; }

/* Buttons */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  border-radius: 48rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  width: 100%;
}

.btn-primary {
  background: #E8734A;
  color: #fff;
}

.btn-primary:active { opacity: 0.9; }

.btn-secondary {
  background: #5B9A7D;
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #E8734A;
  border: 2rpx solid #E8734A;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.btn-group .btn { flex: 1; }

/* Section Title */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 24rpx 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #E8734A;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title .more {
  font-size: 26rpx;
  color: #E8734A;
  font-weight: normal;
}

/* Rating */
.rating-stars { color: #f59e0b; font-size: 24rpx; }
.rating-score { font-weight: 700; color: #E8734A; }

/* Progress Bar */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 12rpx 0;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* Alert */
.alert {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin: 0 24rpx 24rpx;
  font-size: 26rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.alert-success { background: #EEF7F2; color: #5B9A7D; }
.alert-info { background: #e0f2fe; color: #0369a1; }
.alert-warning { background: #FEF0EB; color: #E8734A; }

/* Empty State */
.empty-state {
  text-align: center;
  padding: 120rpx 48rpx;
  color: #6B7280;
}

.empty-state .icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-state .title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; color: #1a1a1a; }
.empty-state .desc { font-size: 26rpx; }

/* Safe area for bottom */
.safe-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }
