.timeline {
  position: relative;
  padding-left: 40rpx;
  margin-top: 24rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: #e5e7eb;
}

.timeline-item {
  position: relative;
  margin-bottom: 40rpx;
}

.timeline-dot {
  position: absolute;
  left: -36rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E8734A;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #E8734A;
}

.timeline-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.timeline-month {
  font-size: 30rpx;
  font-weight: 700;
}

.timeline-season {
  font-size: 24rpx;
  color: #6B7280;
  background: #f5f5f5;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.timeline-desc {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.timeline-img {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
  background: #ddd;
}
