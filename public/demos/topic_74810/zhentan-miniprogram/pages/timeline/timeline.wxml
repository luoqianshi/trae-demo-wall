<view class="container">
  <view class="alert alert-info">
    <text>📅</text>
    <text>同一个地点在不同季节、不同年份的真实面貌</text>
  </view>

  <block wx:for="{{places}}" wx:key="id">
    <view class="card">
      <view class="card-title">{{item.name}}</view>
      <view class="timeline">
        <block wx:for="{{item.timeline}}" wx:for-item="t" wx:key="month">
          <view class="timeline-item">
            <view class="timeline-dot"></view>
            <view class="timeline-content">
              <view class="timeline-header">
                <text class="timeline-month">{{t.month}}</text>
                <text class="timeline-season">{{t.season}}</text>
              </view>
              <view class="timeline-desc">{{t.desc}}</view>
              <image wx:if="{{t.img}}" class="timeline-img" src="{{t.img}}" mode="aspectFill" lazy-load/>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>
