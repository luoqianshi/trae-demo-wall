<view class="container">
  <!-- Search Box -->
  <view class="search-box">
    <view class="search-inner">
      <text class="search-icon">🔍</text>
      <input type="text" class="search-input" placeholder="搜索景点、遛娃地..." 
             value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search"/>
    </view>
  </view>

  <!-- Filter Tags -->
  <scroll-view scroll-x class="filter-bar" show-scrollbar="false">
    <view class="filter-list">
      <view class="filter-item {{activeFilter === 'all' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="all">全部</view>
      <view class="filter-item {{activeFilter === '亲子' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="亲子">亲子</view>
      <view class="filter-item {{activeFilter === '文化' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="文化">文化</view>
      <view class="filter-item {{activeFilter === '免费' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="免费">免费</view>
      <view class="filter-item {{activeFilter === '户外' ? 'active' : ''}}" bindtap="onFilterTap" data-filter="户外">户外</view>
    </view>
  </scroll-view>

  <!-- Place List -->
  <view class="place-list">
    <block wx:for="{{filteredPlaces}}" wx:key="id">
      <view class="place-card" bindtap="goToDetail" data-id="{{item.id}}">
        <image class="place-card-img" src="{{item.promoImg}}" mode="aspectFill" lazy-load/>
        <view class="place-card-body">
          <view class="place-card-title">
            <text>{{item.name}}</text>
            <view class="score-badge {{item.rating >= 4 ? 'high' : item.rating >= 3 ? 'medium' : 'low'}}">
              {{item.rating}}分
            </view>
          </view>
          <view class="place-card-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag tag-orange">{{tag}}</text>
            <text class="tag tag-gray">{{item.distance}}</text>
          </view>
          <view class="place-card-info">
            <view class="rating">
              <text class="rating-stars">{{item.starStr}}</text>
            </view>
            <text class="review-count">{{item.reviewCount}}条真实评价</text>
          </view>
          <view class="place-desc">{{item.description}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- Empty State -->
  <view wx:if="{{filteredPlaces.length === 0}}" class="empty-state">
    <view class="icon">🔍</view>
    <view class="title">未找到相关地点</view>
    <view class="desc">试试其他关键词</view>
  </view>
</view>
