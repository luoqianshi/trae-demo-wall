.search-box {
  padding: 20rpx 24rpx;
  background: #fff;
}

.search-inner {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 48rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #6B7280;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.filter-bar {
  background: #fff;
  padding: 0 24rpx 20rpx;
  white-space: nowrap;
}

.filter-list {
  display: flex;
  gap: 16rpx;
}

.filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7280;
  background: #f5f5f5;
  transition: all 0.2s;
}

.filter-item.active {
  background: #E8734A;
  color: #fff;
  font-weight: 600;
}

.place-list {
  padding: 8rpx 0;
}

.place-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.place-card-img {
  width: 100%;
  height: 360rpx;
  background: #eee;
}

.place-card-body {
  padding: 24rpx;
}

.place-card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.score-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.score-badge.high { background: #EEF7F2; color: #5B9A7D; }
.score-badge.medium { background: #fef3c7; color: #92400e; }
.score-badge.low { background: #FEF0EB; color: #E8734A; }

.place-card-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.place-card-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.review-count { color: #6B7280; font-size: 24rpx; }

.place-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
  margin-top: 8rpx;
}
