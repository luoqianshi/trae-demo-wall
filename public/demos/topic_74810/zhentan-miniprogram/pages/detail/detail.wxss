.detail-hero {
  width: 100%;
  height: 440rpx;
  background: #ddd;
}

.detail-body {
  padding: 24rpx;
}

.detail-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.detail-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.detail-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.detail-rating .score {
  font-size: 56rpx;
  font-weight: 700;
  color: #E8734A;
}

.detail-rating .stars {
  font-size: 28rpx;
  color: #f59e0b;
}

.detail-rating .count {
  font-size: 24rpx;
  color: #6B7280;
}

/* Compare */
.compare-container {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.compare-box {
  flex: 1;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #e5e7eb;
  position: relative;
  background: #fff;
}

.compare-box.promo { border-color: #E8734A; }
.compare-box.real { border-color: #5B9A7D; }

.compare-label {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  z-index: 2;
}

.compare-label.promo { background: #E8734A; color: #fff; }
.compare-label.real { background: #5B9A7D; color: #fff; }

.compare-img {
  width: 100%;
  height: 280rpx;
  background: #ddd;
}

.compare-score {
  padding: 12rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
}

/* Dimension Bar */
.dimension-bar {
  margin-bottom: 16rpx;
}

.dimension-bar:last-child {
  margin-bottom: 0;
}

.dimension-header {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

/* Timeline */
.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: #e5e7eb;
}

.timeline-item {
  position: relative;
  margin-bottom: 32rpx;
}

.timeline-dot {
  position: absolute;
  left: -36rpx;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E8734A;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #E8734A;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.timeline-desc {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.timeline-img {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #ddd;
}

/* Review Card */
.review-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.review-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FEF0EB;
}

.review-meta {
  flex: 1;
}

.review-name {
  font-size: 28rpx;
  font-weight: 600;
}

.review-time {
  font-size: 22rpx;
  color: #6B7280;
}

.review-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.review-badge.verified {
  background: #EEF7F2;
  color: #5B9A7D;
}

.review-rating {
  margin-bottom: 12rpx;
}

.review-content {
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.review-imgs {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.review-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #ddd;
  margin-right: 12rpx;
  display: inline-block;
}

.review-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
