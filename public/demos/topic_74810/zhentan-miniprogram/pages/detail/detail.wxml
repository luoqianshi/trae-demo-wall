<view class="container" wx:if="{{place}}">
  <!-- Hero Image -->
  <image class="detail-hero" src="{{place.promoImg}}" mode="aspectFill" lazy-load/>

  <!-- Basic Info -->
  <view class="detail-body">
    <view class="detail-title">{{place.name}}</view>
    <view class="detail-meta">
      <text>📍 {{place.location}}</text>
      <text>📏 {{place.distance}}</text>
    </view>
    <view class="detail-rating">
      <text class="score">{{place.rating}}</text>
      <view>
        <view class="stars">{{starStr}}</view>
        <view class="count">{{place.reviewCount}}条真实评价</view>
      </view>
    </view>

    <!-- Action Buttons -->
    <view class="btn-group">
      <view class="btn btn-primary" bindtap="goToCheckin">📍 到店打卡</view>
      <view class="btn btn-outline" bindtap="goToCompare">🔄 宣传对比</view>
    </view>

    <!-- Compare Preview -->
    <view class="section-title">宣传 vs 真实</view>
    <view class="compare-container">
      <view class="compare-box promo">
        <view class="compare-label promo">商家宣传</view>
        <image class="compare-img" src="{{place.promoImg}}" mode="aspectFill"/>
        <view class="compare-score" style="color:#E8734A">滤镜指数 {{place.compareScore.promo}}%</view>
      </view>
      <view class="compare-box real">
        <view class="compare-label real">真探实拍</view>
        <image class="compare-img" src="{{place.realImg}}" mode="aspectFill"/>
        <view class="compare-score" style="color:#5B9A7D">还原度 {{place.compareScore.real}}%</view>
      </view>
    </view>
    <view class="alert alert-warning">
      <text>⚠</text>
      <text>{{place.promoDesc}} | {{place.realDesc}}</text>
    </view>

    <!-- Dimensions -->
    <view class="section-title">多维度评分</view>
    <view class="card">
      <block wx:for="{{dimensionList}}" wx:key="key">
        <view class="dimension-bar">
          <view class="dimension-header">
            <text>{{item.label}}</text>
            <text style="font-weight:700;color:{{item.color}}">{{item.score.toFixed(1)}}</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view>
          </view>
        </view>
      </block>
    </view>

    <!-- Timeline Preview -->
    <view class="section-title">
      <text>往期时光线</text>
      <text class="more" bindtap="goToTimeline">查看全部 →</text>
    </view>
    <view class="card">
      <view class="timeline">
        <block wx:for="{{place.timeline}}" wx:key="month">
          <view class="timeline-item">
            <view class="timeline-dot"></view>
            <view class="timeline-content">
              <view class="timeline-title">{{item.month}} · {{item.season}}</view>
              <view class="timeline-desc">{{item.desc}}</view>
              <image wx:if="{{item.img}}" class="timeline-img" src="{{item.img}}" mode="aspectFill" lazy-load/>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- Reviews -->
    <view class="section-title">真实评价 ({{reviews.length}})</view>
    <block wx:for="{{reviews}}" wx:key="id">
      <view class="review-card">
        <view class="review-header">
          <image class="review-avatar" src="{{item.avatar}}" mode="aspectFill"/>
          <view class="review-meta">
            <view class="review-name">{{item.user}} <text style="color:#6B7280;font-size:22rpx;">Lv.{{item.level}}</text></view>
            <view class="review-time">{{item.time}}</view>
          </view>
          <view wx:if="{{item.verified}}" class="review-badge verified">✅ 真实打卡</view>
        </view>
        <view class="review-rating">
          <text class="rating-stars">{{item.starStr}}</text>
        </view>
        <view class="review-content">{{item.content}}</view>
        <scroll-view wx:if="{{item.imgs.length}}" scroll-x class="review-imgs" show-scrollbar="false">
          <image wx:for="{{item.imgs}}" wx:for-item="img" wx:key="*this" class="review-img" src="{{img}}" mode="aspectFill" lazy-load/>
        </scroll-view>
        <view wx:if="{{item.tags.length}}" class="review-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag tag-gray">{{tag}}</text>
        </view>
      </view>
    </block>
  </view>
</view>

<view wx:else class="empty-state">
  <view class="title">地点不存在</view>
</view>
