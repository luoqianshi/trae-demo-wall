<view class="container">
  <!-- Profile Header -->
  <view class="profile-header">
    <image class="profile-avatar" src="{{user.avatar}}" mode="aspectFill"/>
    <view class="profile-name">{{user.name}}</view>
    <view class="profile-level">{{user.level}}</view>
  </view>

  <!-- Stats -->
  <view class="profile-stats">
    <view class="stat-item">
      <view class="stat-num">{{user.contributions}}</view>
      <view class="stat-label">贡献值</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{user.reviews}}</view>
      <view class="stat-label">评价数</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{user.photos}}</view>
      <view class="stat-label">实拍图</view>
    </view>
  </view>

  <!-- Level Progress -->
  <view class="card">
    <view class="card-title">等级进度</view>
    <view class="level-info">
      <text>当前：{{user.level}}</text>
      <text class="level-next">{{nextLevelText}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width:{{progressPct}}%"></view>
    </view>
  </view>

  <!-- Menu Items -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToMyReviews">
      <view class="menu-icon">📝</view>
      <view class="menu-text">我的评价</view>
      <view class="menu-arrow">→</view>
    </view>
    <view class="menu-item">
      <view class="menu-icon">🏆</view>
      <view class="menu-text">等级权益</view>
      <view class="menu-arrow">→</view>
    </view>
    <view class="menu-item">
      <view class="menu-icon">💰</view>
      <view class="menu-text">贡献值规则</view>
      <view class="menu-arrow">→</view>
    </view>
  </view>

  <!-- Level Benefits -->
  <view class="card">
    <view class="card-title">等级权益说明</view>
    <view class="benefit-list">
      <view class="benefit-item {{user.reviews >= 1 ? 'unlocked' : ''}}">
        <view class="benefit-badge">探索者</view>
        <view class="benefit-desc">贡献1次 — 查看评价详情</view>
      </view>
      <view class="benefit-item {{user.reviews >= 3 ? 'unlocked' : ''}}">
        <view class="benefit-badge">鉴定师</view>
        <view class="benefit-desc">贡献3次 — 实拍图评价、标签筛选</view>
      </view>
      <view class="benefit-item {{user.reviews >= 10 ? 'unlocked' : ''}}">
        <view class="benefit-badge">真探</view>
        <view class="benefit-desc">贡献10次 — AI对比报告、社区投票权</view>
      </view>
    </view>
  </view>

  <!-- Contribution Rules -->
  <view class="card">
    <view class="card-title">贡献值获取规则</view>
    <view class="rule-list">
      <view class="rule-item">
        <text>GPS到店打卡</text>
        <text class="rule-points">+5</text>
      </view>
      <view class="rule-item">
        <text>上传实拍图</text>
        <text class="rule-points">+15</text>
      </view>
      <view class="rule-item">
        <text>写50字以上体验</text>
        <text class="rule-points">+20</text>
      </view>
      <view class="rule-item">
        <text>宣传vs实拍对比</text>
        <text class="rule-points">+25</text>
      </view>
      <view class="rule-item">
        <text>轻量评价</text>
        <text class="rule-points">+10</text>
      </view>
    </view>
  </view>
</view>
