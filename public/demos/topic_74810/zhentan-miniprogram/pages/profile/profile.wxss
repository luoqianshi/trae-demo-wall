.profile-header {
  background: linear-gradient(135deg, #E8734A, #ff9a76);
  color: #fff;
  padding: 60rpx 0;
  text-align: center;
  border-radius: 0 0 32rpx 32rpx;
}

.profile-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  margin-bottom: 20rpx;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.profile-level {
  display: inline-block;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.25);
  font-size: 26rpx;
  font-weight: 600;
}

.profile-stats {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #E8734A;
}

.stat-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 8rpx;
}

.level-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin: 20rpx 0 16rpx;
}

.level-next {
  color: #6B7280;
}

.menu-list {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
}

.menu-arrow {
  color: #6B7280;
  font-size: 28rpx;
}

.benefit-list {
  margin-top: 16rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  opacity: 0.5;
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-item.unlocked {
  opacity: 1;
}

.benefit-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #FEF0EB;
  color: #E8734A;
  flex-shrink: 0;
}

.benefit-desc {
  font-size: 26rpx;
  color: #6B7280;
}

.rule-list {
  margin-top: 16rpx;
}

.rule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-points {
  font-weight: 700;
  color: #E8734A;
}
