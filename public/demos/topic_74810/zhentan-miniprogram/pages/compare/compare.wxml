<view class="container" wx:if="{{place}}">
  <view class="card">
    <view class="card-title">{{place.name}}</view>
    <view class="card-subtitle">AI 差异度分析</view>
  </view>

  <!-- Compare Images -->
  <view class="compare-section">
    <view class="compare-box promo">
      <view class="compare-badge promo">商家宣传</view>
      <image class="compare-img" src="{{place.promoImg}}" mode="aspectFill" lazy-load/>
      <view class="compare-footer">
        <text class="compare-label">滤镜指数</text>
        <text class="compare-score promo">{{place.compareScore.promo}}%</text>
      </view>
    </view>

    <view class="vs-divider">VS</view>

    <view class="compare-box real">
      <view class="compare-badge real">真探实拍</view>
      <image class="compare-img" src="{{place.realImg}}" mode="aspectFill" lazy-load/>
      <view class="compare-footer">
        <text class="compare-label">还原度</text>
        <text class="compare-score real">{{place.compareScore.real}}%</text>
      </view>
    </view>
  </view>

  <!-- AI Analysis -->
  <view class="card">
    <view class="card-title">AI 分析结果</view>
    <view class="analysis-item">
      <text class="analysis-name">场景还原度</text>
      <view class="progress-bar">
        <view class="progress-fill" style="width:{{place.compareScore.real}}%;background:#5B9A7D"></view>
      </view>
      <text class="analysis-value">{{place.compareScore.real}}%</text>
    </view>
    <view class="analysis-item">
      <text class="analysis-name">滤镜程度</text>
      <view class="progress-bar">
        <view class="progress-fill" style="width:{{place.compareScore.promo}}%;background:#E8734A"></view>
      </view>
      <text class="analysis-value">{{place.compareScore.promo}}%</text>
    </view>
    <view class="alert {{diff > 30 ? 'alert-warning' : 'alert-success'}}">
      <text>{{diff > 30 ? '⚠' : '✅'}}</text>
      <text>{{diff > 30 ? '警告：宣传与实拍差异较大，可能存在"照骗"' : '宣传与实拍基本一致，可信度较高'}}</text>
    </view>
  </view>

  <!-- Community Photos -->
  <view class="section-title">社区实拍聚合</view>
  <scroll-view scroll-x class="community-photos" show-scrollbar="false">
    <block wx:if="{{realPhotos.length}}">
      <image wx:for="{{realPhotos}}" wx:key="*this" class="community-img" src="{{item}}" mode="aspectFill" lazy-load/>
    </block>
    <view wx:else class="empty-hint">暂无社区实拍，快来打卡吧！</view>
  </scroll-view>

  <!-- Reviews Summary -->
  <view class="section-title">评价摘要</view>
  <block wx:if="{{reviews.length}}">
    <view wx:for="{{reviews}}" wx:key="id" class="review-card">
      <view class="review-header">
        <image class="review-avatar" src="{{item.avatar}}" mode="aspectFill"/>
        <view class="review-meta">
          <view class="review-name">{{item.user}}</view>
          <view class="review-time">{{item.time}}</view>
        </view>
      </view>
      <view class="review-content">{{item.content}}</view>
    </view>
  </block>
  <view wx:else class="empty-state">
    <view class="desc">暂无评价</view>
  </view>
</view>
