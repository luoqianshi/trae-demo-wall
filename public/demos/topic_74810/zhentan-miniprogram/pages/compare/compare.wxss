.compare-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.compare-box {
  flex: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
}

.compare-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  z-index: 2;
}

.compare-badge.promo { background: #E8734A; color: #fff; }
.compare-badge.real { background: #5B9A7D; color: #fff; }

.compare-img {
  width: 100%;
  height: 280rpx;
  background: #ddd;
}

.compare-footer {
  padding: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.compare-label {
  font-size: 24rpx;
  color: #6B7280;
}

.compare-score {
  font-size: 28rpx;
  font-weight: 700;
}

.compare-score.promo { color: #E8734A; }
.compare-score.real { color: #5B9A7D; }

.vs-divider {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1a1a1a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.analysis-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.analysis-name {
  font-size: 26rpx;
  width: 140rpx;
  flex-shrink: 0;
}

.analysis-value {
  font-size: 26rpx;
  font-weight: 700;
  width: 80rpx;
  text-align: right;
  flex-shrink: 0;
}

.community-photos {
  white-space: nowrap;
  margin: 0 24rpx 24rpx;
}

.community-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #ddd;
  margin-right: 12rpx;
  display: inline-block;
}

.empty-hint {
  font-size: 26rpx;
  color: #6B7280;
  padding: 24rpx;
}
