.checkin-box {
  padding: 40rpx;
  border-radius: 16rpx;
  text-align: center;
  margin: 24rpx;
}

.checkin-box.pending {
  background: #fef3c7;
  color: #92400e;
}

.checkin-box.success {
  background: #EEF7F2;
  color: #5B9A7D;
}

.checkin-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.checkin-title { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.checkin-desc { font-size: 26rpx; }

/* Verification Steps */
.verify-steps {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.verify-step {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  opacity: 0.5;
}

.verify-step:last-child { border-bottom: none; }
.verify-step.done { opacity: 1; }

.verify-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e5e7eb;
  color: #6B7280;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.verify-step.done .verify-icon {
  background: #E8734A;
  color: #fff;
}

.verify-info {
  flex: 1;
}

.verify-name {
  font-size: 28rpx;
  font-weight: 600;
}

.verify-status {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

/* Verify Result */
.verify-result {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
  padding: 20rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  border: 1rpx solid #bae6fd;
}

.verify-result-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.verify-result-text {
  flex: 1;
}

.verify-result-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0369a1;
  margin-bottom: 4rpx;
}

.verify-result-desc {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.6;
}

.star-rating {
  display: flex;
  gap: 16rpx;
  margin: 24rpx;
  justify-content: center;
}

.star-rating .star {
  font-size: 48rpx;
  color: #ddd;
  transition: color 0.2s;
  padding: 8rpx;
  min-width: 64rpx;
  text-align: center;
}

.star-rating .star.active { color: #f59e0b; }

.dimension-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.dimension-row:last-child { border-bottom: none; }

.dimension-label { font-size: 28rpx; }

.dimension-stars {
  display: flex;
  gap: 8rpx;
}

.dimension-stars .star {
  font-size: 32rpx;
  color: #ddd;
  padding: 6rpx;
  min-width: 44rpx;
  text-align: center;
}

.dimension-stars .star.active { color: #f59e0b; }

.photo-upload {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin: 0 24rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #e5e7eb;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #6B7280;
  background: #f5f5f5;
}

.photo-preview {
  width: 160rpx;
  height: 160rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #ddd;
}

.upload-hint {
  font-size: 24rpx;
  color: #6B7280;
  margin: 12rpx 24rpx 24rpx;
}

.form-textarea {
  margin: 0 24rpx 24rpx;
  width: calc(100% - 48rpx);
  padding: 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  box-sizing: border-box;
}

.tag-select {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 0 24rpx 24rpx;
}

.tag-option {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6B7280;
  background: #f5f5f5;
  border: 2rpx solid transparent;
}

.tag-option.active {
  background: #FEF0EB;
  color: #E8734A;
  border-color: #E8734A;
  font-weight: 600;
}

.compare-check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
  font-size: 26rpx;
}

.delay-hint {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
  margin: 16rpx 24rpx 40rpx;
}
