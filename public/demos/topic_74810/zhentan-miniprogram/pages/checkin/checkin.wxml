<view class="container">
  <view class="card" wx:if="{{place}}">
    <view class="card-title">{{place.name}}</view>
    <view class="card-subtitle">{{place.location}}</view>
  </view>

  <!-- Checkin Status -->
  <view wx:if="{{!checkedIn}}">
    <view class="checkin-box pending">
      <view class="checkin-icon">📍</view>
      <view class="checkin-title">等待打卡验证</view>
      <view class="checkin-desc">请到达地点附近后点击验证</view>
    </view>

    <!-- Verification Steps Preview -->
    <view class="verify-steps">
      <view class="verify-step {{verifyStep >= 1 ? 'done' : ''}}">
        <view class="verify-icon">{{verifyStep > 1 ? '✓' : '1'}}</view>
        <view class="verify-info">
          <view class="verify-name">📍 GPS 定位</view>
          <view class="verify-status">{{verifyStep > 1 ? '已获取坐标' : (verifyStep == 1 ? '验证中...' : '待验证')}}</view>
        </view>
      </view>
      <view class="verify-step {{verifyStep >= 2 ? 'done' : ''}}">
        <view class="verify-icon">{{verifyStep > 2 ? '✓' : '2'}}</view>
        <view class="verify-info">
          <view class="verify-name">📡 基站辅助定位</view>
          <view class="verify-status">{{verifyStep > 2 ? '已匹配' : (verifyStep == 2 ? '验证中...' : '待验证')}}</view>
        </view>
      </view>
      <view class="verify-step {{verifyStep >= 3 ? 'done' : ''}}">
        <view class="verify-icon">{{verifyStep > 3 ? '✓' : '3'}}</view>
        <view class="verify-info">
          <view class="verify-name">📶 WiFi 环境匹配</view>
          <view class="verify-status">{{verifyStep > 3 ? '已匹配' : (verifyStep == 3 ? '验证中...' : '待验证')}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!verifying}}" class="btn btn-primary" bindtap="doCheckin">📍 开始打卡验证</view>
    <view wx:else class="btn btn-primary" style="opacity:0.7;">⏳ 验证中...</view>
  </view>

  <view wx:else>
    <view class="checkin-box success">
      <view class="checkin-icon">✅</view>
      <view class="checkin-title">打卡成功</view>
      <view class="checkin-desc">GPS + WiFi + 基站 三重验证通过</view>
    </view>

    <view class="verify-result">
      <view class="verify-result-icon">{{isRealLocation ? '📡' : '💻'}}</view>
      <view class="verify-result-text">
        <view class="verify-result-title">{{isRealLocation ? '真实GPS定位' : '模拟定位（演示模式）'}}</view>
        <view class="verify-result-desc">{{isRealLocation ? '已获取真实坐标并与地点数据库匹配' : '已尝试调用 wx.getLocation，授权失败时自动降级为模拟验证。正式版将使用真实GPS+基站+WiFi三重验证。'}}</view>
      </view>
    </view>

    <view class="alert alert-success">
      <text>✅</text>
      <text>打卡成功！请在离店后完成评价（评价将延迟24-72小时发布）</text>
    </view>

    <!-- Review Form -->
    <view class="section-title">总体评分</view>
    <view class="star-rating">
      <view wx:for="{{[1,2,3,4,5]}}" wx:for-item="starVal" wx:key="*this"
            class="star {{overallRating >= starVal ? 'active' : ''}}"
            bindtap="setOverallRating" data-val="{{starVal}}">★</view>
    </view>

    <view class="section-title">多维度评分</view>
    <view class="card">
      <block wx:for="{{dimensions}}" wx:key="key">
        <view class="dimension-row">
          <text class="dimension-label">{{item.label}}</text>
          <view class="dimension-stars">
            <view wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this"
                  class="star {{item.value >= s ? 'active' : ''}}"
                  bindtap="setDimension" data-key="{{item.key}}" data-val="{{s}}">★</view>
          </view>
        </view>
      </block>
    </view>

    <view class="section-title">实拍照片</view>
    <view class="photo-upload">
      <view class="upload-btn" bindtap="chooseImage">+</view>
      <view wx:for="{{photos}}" wx:key="*this" class="photo-preview">
        <image src="{{item}}" mode="aspectFill" class="preview-img"/>
      </view>
    </view>
    <view class="upload-hint">点击添加现场照片（应用内直拍，保留EXIF信息）</view>

    <view class="section-title">体验感受</view>
    <textarea class="form-textarea" placeholder="分享你的真实体验，帮助更多家庭避坑..." 
              bindinput="onContentInput" value="{{content}}"/>

    <view class="section-title">快捷标签</view>
    <view class="tag-select">
      <view wx:for="{{tagOptions}}" wx:key="*this" 
            class="tag-option {{selectedTags.includes(item) ? 'active' : ''}}"
            bindtap="toggleTag" data-tag="{{item}}">{{item}}</view>
    </view>

    <view class="compare-check">
      <switch checked="{{hasCompare}}" bindchange="toggleCompare" color="#E8734A"/>
      <text>上传了宣传 vs 实拍对比（额外+25贡献值）</text>
    </view>

    <view class="btn btn-primary" bindtap="submitReview">提交评价（延迟发布）</view>
    <view class="delay-hint">评价将在24-72小时后公开发布，商家无法提前查看</view>
  </view>
</view>
