page {
  min-height: 100%;
  background: #FFF8F0;
}

.chat-page {
  position: relative;
  min-height: 100vh;
  background: #FFF8F0;
  color: #1A1A1A;
  overflow: hidden;
}

/* ===== Header ===== */
.chat-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 144rpx;
  padding: 24rpx 28rpx 18rpx;
  background: rgba(255, 248, 240, 0.92);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border-bottom: 1rpx solid rgba(212, 168, 83, 0.22);
}

.assistant-avatar,
.message-avatar {
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
}

.assistant-avatar {
  width: 72rpx;
  height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(45, 95, 62, 0.2);
}

.header-copy {
  min-width: 0;
}

.header-title {
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 800;
  color: #2D5F3E;
}

.header-subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(26, 26, 26, 0.58);
}

/* ===== Message List ===== */
.message-list {
  height: 100vh;
  padding: 0 24rpx;
}

.message-spacer {
  height: 164rpx;
}

.bottom-spacer {
  height: 180rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  margin: 24rpx 0;
}

.message-row-ai {
  justify-content: flex-start;
}

.message-row-user {
  justify-content: flex-end;
}

.message-avatar {
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
}

.message-bubble {
  max-width: 596rpx;
  padding: 24rpx 26rpx;
  border-radius: 12rpx;
}

.ai-bubble {
  background: #FFFFFF;
  color: #1A1A1A;
  box-shadow: 0 8rpx 24rpx rgba(70, 42, 26, 0.08), 0 2rpx 6rpx rgba(70, 42, 26, 0.05);
}

.user-bubble {
  background: #2D5F3E;
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(45, 95, 62, 0.2);
}

.message-text {
  font-size: 30rpx;
  line-height: 46rpx;
  word-break: break-word;
}

/* ===== Dish List ===== */
.dish-list {
  margin-top: 20rpx;
}

.dish-card {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(45, 95, 62, 0.1);
}

.dish-card:first-child {
  border-top: 0;
  padding-top: 4rpx;
}

.dish-image {
  flex-shrink: 0;
  width: 136rpx;
  height: 136rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(45, 95, 62, 0.2);
  background: rgba(212, 168, 83, 0.12);
}

.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.dish-name {
  flex: 1;
  min-width: 0;
  color: #2D5F3E;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  word-break: break-word;
}

.dish-price {
  flex-shrink: 0;
  color: #C84B31;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
}

.dish-desc {
  margin-top: 8rpx;
  color: rgba(26, 26, 26, 0.58);
  font-size: 24rpx;
  line-height: 34rpx;
  word-break: break-word;
}

/* ===== Tags (unified style) ===== */
.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.dish-tag {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: rgba(45, 95, 62, 0.08);
  color: #2D5F3E;
  font-size: 22rpx;
  line-height: 36rpx;
  font-weight: 600;
}

/* ===== Total Line ===== */
.total-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(200, 75, 49, 0.3);
  color: rgba(26, 26, 26, 0.58);
  font-size: 26rpx;
  line-height: 36rpx;
}

.total-price {
  color: #C84B31;
  font-family: "Georgia", "Times New Roman", serif;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

/* ===== Order Button ===== */
.order-button {
  margin-top: 20rpx;
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 80rpx;
  font-weight: 700;
  text-align: center;
}

.order-button::after {
  border: 0;
}

.order-done {
  margin-top: 20rpx;
  text-align: center;
  color: #2D5F3E;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
}

/* ===== Thinking Indicator ===== */
.thinking-bubble {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 188rpx;
}

.thinking-label {
  color: rgba(26, 26, 26, 0.62);
  font-size: 28rpx;
  line-height: 36rpx;
}

.thinking-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D4A853;
  animation: dotBounce 1s infinite ease-in-out;
}

.dot-two {
  animation-delay: 0.15s;
}

.dot-three {
  animation-delay: 0.3s;
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: translateY(0);
    opacity: 0.45;
  }
  40% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* ===== Input Bar ===== */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 248, 240, 0.95);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
  border-top: 1rpx solid rgba(45, 95, 62, 0.12);
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 42rpx;
  background: #FFFFFF;
  color: #1A1A1A;
  font-size: 30rpx;
  box-shadow: inset 0 0 0 2rpx rgba(45, 95, 62, 0.12);
}

.input-placeholder {
  color: rgba(26, 26, 26, 0.36);
}

.send-button {
  flex-shrink: 0;
  width: 132rpx;
  height: 84rpx;
  padding: 0;
  border-radius: 42rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 84rpx;
  box-shadow: 0 8rpx 20rpx rgba(200, 75, 49, 0.28);
}

.send-button::after {
  border: 0;
}

.send-button[disabled] {
  background: rgba(200, 75, 49, 0.36);
  color: rgba(255, 255, 255, 0.78);
  box-shadow: none;
}
