<view class="chat-page">
  <view class="chat-header">
    <image class="assistant-avatar" src="../../assets/chat-avatar.png" mode="aspectFill"></image>
    <view class="header-copy">
      <view class="header-title">寻味岭南</view>
      <view class="header-subtitle">粤菜智能点餐助手</view>
    </view>
  </view>

  <scroll-view
    class="message-list"
    scroll-y
    scroll-with-animation
    scroll-into-view="{{scrollIntoView}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="message-spacer"></view>

    <block wx:for="{{messages}}" wx:key="id">
      <view id="message-{{item.id}}" class="message-row {{item.type === 'user' ? 'message-row-user' : 'message-row-ai'}}">
        <image class="message-avatar" wx:if="{{item.type === 'ai'}}" src="../../assets/chat-avatar.png" mode="aspectFill"></image>
        <view class="message-bubble {{item.type === 'user' ? 'user-bubble' : 'ai-bubble'}}">
          <view class="message-text">{{item.content}}</view>

          <view wx:if="{{item.dishes && item.dishes.length}}" class="dish-list">
            <block wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="name">
              <view class="dish-card">
                <image class="dish-image" src="{{dish.image_url}}" mode="aspectFill"></image>
                <view class="dish-info">
                  <view class="dish-title-row">
                    <view class="dish-name">{{dish.name}}</view>
                    <view class="dish-price">¥{{dish.price}}</view>
                  </view>
                  <view class="dish-desc">{{dish.description || dish.reason || '经典粤菜风味，适合当前需求。'}}</view>
                  <view class="dish-tags" wx:if="{{dish.tags && dish.tags.length}}">
                    <block wx:for="{{dish.tags}}" wx:for-item="tag" wx:key="*this">
                      <text class="dish-tag">{{tag}}</text>
                    </block>
                  </view>
                </view>
              </view>
            </block>

            <view class="total-line">
              <text>预计合计</text>
              <text class="total-price">¥{{item.totalPrice}}</text>
            </view>

            <button wx:if="{{!item.ordered}}" class="order-button" catchtap="onOrder" data-msg-id="{{item.id}}">确认下单</button>
            <view wx:else class="order-done">✅ 已完成下单</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{thinking}}" id="thinking-indicator" class="message-row message-row-ai">
      <image class="message-avatar" src="../../assets/chat-avatar.png" mode="aspectFill"></image>
      <view class="message-bubble ai-bubble thinking-bubble">
        <text class="thinking-label">{{thinkingText}}</text>
        <view class="thinking-dots">
          <view class="dot dot-one"></view>
          <view class="dot dot-two"></view>
          <view class="dot dot-three"></view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <view class="input-bar">
    <input
      class="chat-input"
      value="{{inputValue}}"
      placeholder="说说人数、口味、预算..."
      placeholder-class="input-placeholder"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
      disabled="{{thinking}}"
    />
    <button class="send-button" bindtap="onSend" disabled="{{thinking || !inputValue}}">
      发送
    </button>
  </view>
</view>
