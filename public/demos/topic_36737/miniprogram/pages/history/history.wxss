page {
  min-height: 100%;
  background: #FFF8F0;
}

.history-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 0;
  background:
    linear-gradient(90deg, rgba(212, 168, 83, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgba(212, 168, 83, 0.05) 1rpx, transparent 1rpx),
    #FFF8F0;
  background-size: 34rpx 34rpx;
  color: #1A1A1A;
}

/* ===== Hero ===== */
.history-hero {
  padding: 18rpx 4rpx 28rpx;
}

.hero-kicker {
  color: #C84B31;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 28rpx;
  line-height: 36rpx;
}

.hero-title {
  margin-top: 8rpx;
  color: #2D5F3E;
  font-family: "Songti SC", "SimSun", serif;
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 800;
}

.hero-copy {
  margin-top: 10rpx;
  max-width: 660rpx;
  color: rgba(26, 26, 26, 0.72);
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 500;
}

/* ===== List ===== */
.record-list {
  opacity: 0;
  transform: translateY(18rpx);
  transition: opacity 260ms ease, transform 260ms ease;
}

.record-list-ready {
  opacity: 1;
  transform: translateY(0);
}

/* ===== Card ===== */
.record-card {
  position: relative;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(45, 95, 62, 0.18);
  border-radius: 16rpx;
  background:
    radial-gradient(circle at 14rpx 18rpx, rgba(212, 168, 83, 0.12) 0 1rpx, transparent 2rpx),
    linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(255, 244, 225, 0.96));
  box-shadow: 0 8rpx 24rpx rgba(70, 42, 26, 0.08), 0 2rpx 8rpx rgba(70, 42, 26, 0.06);
  overflow: hidden;
  animation: cardFadeIn 280ms ease both;
  transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
}

.record-card-expanded {
  border-color: rgba(45, 95, 62, 0.42);
  box-shadow: 0 16rpx 40rpx rgba(45, 95, 62, 0.16), 0 4rpx 12rpx rgba(45, 95, 62, 0.1);
  transform: translateY(-2rpx);
}

/* ===== Summary ===== */
.record-summary {
  min-height: 88rpx;
  padding: 28rpx 28rpx 24rpx;
}

.record-topline,
.record-total,
.detail-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.record-time {
  color: rgba(26, 26, 26, 0.48);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ===== Action Button ===== */
.record-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background: rgba(45, 95, 62, 0.1);
  color: #2D5F3E;
  font-size: 24rpx;
  line-height: 52rpx;
  font-weight: 600;
  transition: background 200ms ease, color 200ms ease;
}

.action-expanded {
  background: rgba(45, 95, 62, 0.18);
}

.action-arrow {
  font-size: 18rpx;
  transition: transform 280ms ease;
}

.arrow-up {
  transform: rotate(180deg);
}

/* ===== Request Text ===== */
.record-request {
  margin-top: 16rpx;
  color: #1A1A1A;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 800;
  word-break: break-word;
}

/* ===== Dish Preview ===== */
.dish-preview-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 24rpx;
  min-height: 148rpx;
}

.preview-dish {
  width: 132rpx;
}

.stamp-frame {
  width: 132rpx;
  height: 104rpx;
  padding: 4rpx;
  border: 2rpx solid rgba(45, 95, 62, 0.32);
  border-radius: 10rpx;
  background: #FFF8F0;
}

.preview-image,
.image-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.preview-image,
.detail-image {
  background: rgba(212, 168, 83, 0.16);
}

.image-placeholder,
.detail-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(45, 95, 62, 0.12);
  color: #2D5F3E;
  font-weight: 800;
}

.preview-name {
  margin-top: 8rpx;
  color: #2D5F3E;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 700;
  text-align: center;
  word-break: break-word;
}

.more-dishes {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 104rpx;
  border-radius: 10rpx;
  background: rgba(200, 75, 49, 0.1);
  color: #C84B31;
}

.more-count {
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 800;
}

.more-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 28rpx;
}

/* ===== Total ===== */
.record-total {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(212, 168, 83, 0.62);
}

.total-label {
  color: rgba(26, 26, 26, 0.58);
  font-size: 26rpx;
  line-height: 36rpx;
}

.total-value {
  color: #C84B31;
  font-family: "Georgia", "Times New Roman", serif;
  font-size: 44rpx;
  line-height: 50rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

/* ===== Detail Expand ===== */
.record-detail {
  max-height: 0;
  opacity: 0;
  transform: translateY(-12rpx);
  overflow: hidden;
  transition: max-height 320ms ease, opacity 240ms ease, transform 240ms ease;
}

.detail-open {
  max-height: 2400rpx;
  opacity: 1;
  transform: translateY(0);
}

.detail-inner {
  padding: 0 28rpx 28rpx;
}

.detail-title {
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(45, 95, 62, 0.2);
  color: #2D5F3E;
  font-family: "Songti SC", "SimSun", serif;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.detail-dish {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(45, 95, 62, 0.12);
}

.detail-dish:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.detail-image-wrap {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  padding: 4rpx;
  border: 2rpx solid rgba(45, 95, 62, 0.32);
  border-radius: 10rpx;
  background: #FFF8F0;
}

.detail-image,
.detail-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.detail-info {
  flex: 1;
  min-width: 0;
}

.detail-name {
  flex: 1;
  min-width: 0;
  color: #2D5F3E;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 800;
  word-break: break-word;
}

.detail-price {
  flex-shrink: 0;
  color: #C84B31;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.detail-reason {
  margin-top: 8rpx;
  color: rgba(26, 26, 26, 0.66);
  font-size: 24rpx;
  line-height: 34rpx;
  word-break: break-word;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.detail-tag {
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 19rpx;
  background: rgba(45, 95, 62, 0.1);
  color: #2D5F3E;
  font-size: 22rpx;
  line-height: 38rpx;
  font-weight: 600;
}

/* ===== Reorder Button ===== */
.reorder-bar {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(45, 95, 62, 0.12);
}

.reorder-button {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #C84B31;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 88rpx;
  font-weight: 700;
  text-align: center;
}

.reorder-button::after {
  border: 0;
}

.order-done-text {
  text-align: center;
  color: #2D5F3E;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

/* ===== States ===== */
.state-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  padding: 48rpx 32rpx;
  border: 1rpx solid rgba(45, 95, 62, 0.18);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 8rpx 24rpx rgba(70, 42, 26, 0.06);
}

.loading-panel {
  min-height: 360rpx;
  justify-content: center;
}

.loading-mark {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid rgba(212, 168, 83, 0.32);
  border-top-color: #2D5F3E;
  border-radius: 50%;
  animation: loadingSpin 900ms linear infinite;
}

.empty-illustration {
  position: relative;
  width: 176rpx;
  height: 220rpx;
  padding: 58rpx 28rpx 0;
  border: 2rpx solid rgba(45, 95, 62, 0.24);
  border-radius: 8rpx;
  background: linear-gradient(135deg, #FFFDF7, #FFF0D8);
}

.empty-seal {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 46rpx;
  height: 46rpx;
  border: 2rpx solid #C84B31;
  border-radius: 50%;
  color: #C84B31;
  font-size: 24rpx;
  line-height: 42rpx;
  text-align: center;
  font-weight: 800;
}

.empty-line {
  height: 8rpx;
  margin-top: 20rpx;
  border-radius: 4rpx;
  background: rgba(45, 95, 62, 0.22);
}

.line-short {
  width: 72rpx;
}

.error-illustration {
  opacity: 0.78;
}

.state-title {
  margin-top: 28rpx;
  color: #2D5F3E;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 800;
  text-align: center;
}

.state-copy {
  margin-top: 8rpx;
  color: rgba(26, 26, 26, 0.62);
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}

.state-button {
  min-width: 184rpx;
  min-height: 88rpx;
  margin-top: 28rpx;
  padding: 0 30rpx;
  border-radius: 12rpx;
  background: #2D5F3E;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.state-button::after {
  border: 0;
}

.page-bottom-space {
  height: calc(128rpx + env(safe-area-inset-bottom));
}

@keyframes loadingSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes cardFadeIn {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
