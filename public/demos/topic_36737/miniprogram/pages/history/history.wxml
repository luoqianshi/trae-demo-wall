<view class="history-page">
  <view class="history-hero">
    <view class="hero-kicker">茶楼菜单</view>
    <view class="hero-title">点餐历史</view>
    <view class="hero-copy">最近 20 次点餐记录，点击「查看详情」回顾完整菜品搭配，可一键再次下单。</view>
  </view>

  <view wx:if="{{loading}}" class="state-panel loading-panel">
    <view class="loading-mark"></view>
    <view class="state-title">正在翻阅菜单...</view>
    <view class="state-copy">稍等片刻，马上取回历史点餐记录。</view>
  </view>

  <view wx:elif="{{errorText}}" class="state-panel">
    <view class="empty-illustration error-illustration">
      <view class="empty-line line-short"></view>
      <view class="empty-line"></view>
      <view class="empty-line"></view>
    </view>
    <view class="state-title">加载失败</view>
    <view class="state-copy">{{errorText}}</view>
    <button class="state-button" bindtap="loadHistory">重新加载</button>
  </view>

  <view wx:elif="{{!records.length}}" class="state-panel">
    <view class="empty-illustration">
      <view class="empty-seal">粤</view>
      <view class="empty-line line-short"></view>
      <view class="empty-line"></view>
      <view class="empty-line"></view>
    </view>
    <view class="state-title">还没有点餐记录哦，去聊天页试试吧</view>
    <button class="state-button" bindtap="goChat">去聊天页</button>
  </view>

  <view wx:else class="record-list {{pageReady ? 'record-list-ready' : ''}}">
    <block wx:for="{{records}}" wx:key="id">
      <view class="record-card {{item.expanded ? 'record-card-expanded' : ''}}">
        <view
          class="record-summary"
          bindtap="toggleRecord"
          data-id="{{item.id}}"
          aria-role="button"
          aria-label="{{item.expanded ? '收起点餐详情' : '查看点餐详情'}}"
        >
          <view class="record-topline">
            <view class="record-time">{{item.createdAtText}}</view>
            <view class="record-action {{item.expanded ? 'action-expanded' : ''}}">
              <text>{{item.expanded ? '收起' : '查看详情'}}</text>
              <text class="action-arrow {{item.expanded ? 'arrow-up' : ''}}">▼</text>
            </view>
          </view>

          <view class="record-request">{{item.summary}}</view>

          <view class="dish-preview-row">
            <block wx:for="{{item.visibleDishes}}" wx:for-item="dish" wx:for-index="dishIndex" wx:key="name">
              <view class="preview-dish">
                <view class="stamp-frame">
                  <image wx:if="{{dish.image_url}}" class="preview-image" src="{{dish.image_url}}" mode="aspectFill"></image>
                  <view wx:else class="image-placeholder">粤</view>
                </view>
                <view class="preview-name">{{dish.name}}</view>
              </view>
            </block>

            <view wx:if="{{item.hiddenDishCount > 0}}" class="more-dishes">
              <view class="more-count">+{{item.hiddenDishCount}}</view>
              <view class="more-label">道菜</view>
            </view>
          </view>

          <view class="record-total">
            <text class="total-label">预计合计</text>
            <text class="total-value">¥{{item.totalPriceText}}元</text>
          </view>
        </view>

        <view class="record-detail {{item.expanded ? 'detail-open' : ''}}">
          <view class="detail-inner">
            <view class="detail-title">完整菜品</view>
            <block wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="name">
              <view class="detail-dish">
                <view class="detail-image-wrap">
                  <image wx:if="{{dish.image_url}}" class="detail-image" src="{{dish.image_url}}" mode="aspectFill"></image>
                  <view wx:else class="detail-placeholder">粤</view>
                </view>
                <view class="detail-info">
                  <view class="detail-title-row">
                    <view class="detail-name">{{dish.name}}</view>
                    <view class="detail-price">¥{{dish.priceText}}</view>
                  </view>
                  <view class="detail-reason">{{dish.reason}}</view>
                  <view wx:if="{{dish.tags && dish.tags.length}}" class="detail-tags">
                    <block wx:for="{{dish.tags}}" wx:for-item="tag" wx:key="*this">
                      <text class="detail-tag">{{tag}}</text>
                    </block>
                  </view>
                </view>
              </view>
            </block>

            <view class="reorder-bar">
              <button wx:if="{{!item.ordered}}" class="reorder-button" catchtap="onHistoryOrder" data-id="{{item.id}}">确认下单</button>
              <view wx:else class="order-done-text">✅ 已完成下单</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="page-bottom-space"></view>
</view>
