<view class="page">
  <view class="form-section">
    <view class="section-title">档案信息</view>
    
    <view class="form-item">
      <view class="form-label">工号</view>
      <input 
        class="form-input {{isView ? 'disabled' : ''}}"
        placeholder="请输入工号"
        value="{{form.employeeNo}}"
        data-field="employeeNo"
        bindinput="onInput"
        disabled="{{isView}}"
      />
    </view>

    <view class="form-item">
      <view class="form-label">姓名</view>
      <input 
        class="form-input {{isView ? 'disabled' : ''}}"
        placeholder="请输入姓名"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
        disabled="{{isView}}"
      />
    </view>

    <view class="form-row">
      <view class="form-item">
        <view class="form-label">部门</view>
        <picker 
          mode="selector" 
          range="{{departmentOptions}}"
          value="{{departmentIndex}}"
          bindchange="onDepartmentChange"
          disabled="{{isView}}"
        >
          <view class="picker-input {{isView ? 'disabled' : ''}}">
            <text class="{{form.department ? '' : 'placeholder'}}">{{form.department || '请选择部门'}}</text>
            <text class="arrow" wx:if="{{!isView}}">▾</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <view class="form-label">岗位</view>
        <input 
          class="form-input {{isView ? 'disabled' : ''}}"
          placeholder="请输入岗位"
          value="{{form.position}}"
          data-field="position"
          bindinput="onInput"
          disabled="{{isView}}"
        />
      </view>
    </view>

    <view class="form-row">
      <view class="form-item">
        <view class="form-label">入职日期</view>
        <picker 
          mode="date" 
          value="{{form.hireDate}}"
          bindchange="onHireDateChange"
          disabled="{{isView}}"
        >
          <view class="picker-input {{isView ? 'disabled' : ''}}">
            <text class="{{form.hireDate ? '' : 'placeholder'}}">{{form.hireDate || '请选择日期'}}</text>
            <text class="arrow" wx:if="{{!isView}}">▾</text>
          </view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{mode !== 'add'}}">
        <view class="form-label">状态</view>
        <picker 
          mode="selector" 
          range="{{statusOptions}}"
          range-key="label"
          value="{{statusIndex}}"
          bindchange="onStatusChange"
          disabled="{{isView}}"
        >
          <view class="picker-input {{isView ? 'disabled' : ''}}">
            <text>{{statusOptions[statusIndex].label}}</text>
            <text class="arrow" wx:if="{{!isView}}">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">联系电话</view>
      <input 
        class="form-input {{isView ? 'disabled' : ''}}"
        placeholder="请输入联系电话"
        type="number"
        value="{{form.phone}}"
        data-field="phone"
        bindinput="onInput"
        disabled="{{isView}}"
      />
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">薪资信息</view>
    
    <view class="form-row">
      <view class="form-item">
        <view class="form-label">基本工资 (元)</view>
        <input 
          class="form-input {{isView ? 'disabled' : ''}}"
          placeholder="0.00"
          type="digit"
          value="{{form.baseSalary}}"
          data-field="baseSalary"
          bindinput="onInput"
          disabled="{{isView}}"
        />
      </view>

      <view class="form-item">
        <view class="form-label">岗位工资 (元)</view>
        <input 
          class="form-input {{isView ? 'disabled' : ''}}"
          placeholder="0.00"
          type="digit"
          value="{{form.postSalary}}"
          data-field="postSalary"
          bindinput="onInput"
          disabled="{{isView}}"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">固定补贴 (元)</view>
      <input 
        class="form-input {{isView ? 'disabled' : ''}}"
        placeholder="0.00"
        type="digit"
        value="{{form.fixedAllowance}}"
        data-field="fixedAllowance"
        bindinput="onInput"
        disabled="{{isView}}"
      />
    </view>

    <view class="salary-summary">
      <view class="summary-label">月薪合计</view>
      <view class="summary-value">¥ {{totalSalary}}</view>
    </view>
  </view>

  <view class="bottom-bar">
    <block wx:if="{{isView}}">
      <button class="btn btn-primary btn-block" bindtap="goEdit">
        编辑
      </button>
    </block>
    <block wx:else>
      <button class="btn btn-primary btn-block" bindtap="handleSave">
        保存
      </button>
    </block>
  </view>
</view>
