<view class="page">
  <view class="profile-header">
    <view class="header-bg">
      <view class="bg-decoration circle1"></view>
      <view class="bg-decoration circle2"></view>
      <view class="bg-decoration circle3"></view>
    </view>
    
    <view class="header-top">
      <view class="setting-btn" bindtap="handleMenuTap" data-key="settings">
        <text class="setting-icon">⚙️</text>
      </view>
    </view>

    <view class="user-card">
      <view class="avatar-ring">
        <view class="avatar-inner"></view>
        <view class="avatar-large">
          {{userInfo.name[0]}}
        </view>
      </view>
      
      <view class="user-info">
        <view class="name-row">
          <view class="user-name">{{userInfo.name}}</view>
          <view class="role-badge {{role}}">
            <text class="role-icon">{{role === 'admin' ? '👑' : role === 'manager' ? '📋' : '👤'}}</text>
            <text>{{roleLabel}}</text>
          </view>
        </view>
        <view class="user-meta">
          <text class="meta-icon">🏢</text>
          <text>{{userInfo.department}}</text>
          <text class="dot">·</text>
          <text class="meta-icon">💼</text>
          <text>{{userInfo.position}}</text>
        </view>
        <view class="user-id">
          <text class="meta-icon">🆔</text>
          <text>工号：{{userInfo.employeeNo}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="stats-section">
    <view class="stats-card">
      <view class="stat-card-item" bindtap="handleMenuTap" data-key="salary">
        <view class="stat-ico blue">💰</view>
        <view class="stat-num">{{stats.salaryMonths}}</view>
        <view class="stat-label">薪资记录</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-card-item" bindtap="handleMenuTap" data-key="attendance">
        <view class="stat-ico green">📅</view>
        <view class="stat-num">{{stats.attendanceDays}}</view>
        <view class="stat-label">本月出勤</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-card-item" bindtap="handleMenuTap" data-key="social">
        <view class="stat-ico purple">🏦</view>
        <view class="stat-num">{{stats.socialMonths}}</view>
        <view class="stat-label">社保月数</view>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title">
      <text class="title-text">常用功能</text>
    </view>
    
    <view class="menu-grid">
      <view 
        class="menu-grid-item"
        wx:for="{{quickMenu}}" 
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="handleMenuTap"
      >
        <view class="grid-icon-wrap {{item.color}}">
          <text class="grid-icon">{{item.icon}}</text>
        </view>
        <text class="grid-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title">
      <text class="title-text">更多设置</text>
    </view>
    
    <view class="menu-card">
      <view 
        wx:for="{{menuList}}" 
        wx:key="key"
        class="menu-item"
        data-key="{{item.key}}"
        bindtap="handleMenuTap"
      >
        <view class="menu-icon-wrap {{item.color}}">
          <text class="menu-icon">{{item.icon}}</text>
        </view>
        <view class="menu-content">
          <view class="menu-title">{{item.title}}</view>
        </view>
        <view class="menu-arrow">
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="logout-section">
    <view class="logout-btn" bindtap="handleLogout">
      <text class="logout-icon">🚪</text>
      <text class="logout-text">退出登录</text>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">薪资核算系统 v1.0.0</text>
    <text class="footer-sub">智能 · 高效 · 精准</text>
  </view>
</view>
