<view class="page" wx:if="{{salary}}">
  <view class="salary-container" id="salaryCard">
    <view class="salary-hero">
      <view class="hero-decoration"></view>
      <view class="hero-decoration-circle circle1"></view>
      <view class="hero-decoration-circle circle2"></view>
      
      <view class="hero-top">
        <view class="company-badge">
          <text class="company-icon">🏢</text>
          <text class="company-name">薪资核算系统</text>
        </view>
        <view class="month-badge">{{month}}</view>
      </view>

      <view class="hero-emp">
        <view class="emp-avatar">{{salary.name[0]}}</view>
        <view class="emp-detail">
          <view class="emp-name">{{salary.name}}</view>
          <view class="emp-meta">
            <text class="meta-item">{{salary.employeeNo}}</text>
            <text class="meta-dot">·</text>
            <text class="meta-item">{{salary.department}}</text>
            <text class="meta-dot">·</text>
            <text class="meta-item">{{salary.position}}</text>
          </view>
        </view>
      </view>

      <view class="hero-salary">
        <view class="salary-label">实发工资</view>
        <view class="salary-amount">
          <text class="currency">¥</text>
          <text class="amount">{{salary.netSalaryStr}}</text>
        </view>
        <view class="salary-tip">将于 {{month}}-28 发放</view>
      </view>
    </view>

    <view class="quick-stats">
      <view class="stat-item">
        <view class="stat-value primary">¥{{salary.grossSalaryStr}}</view>
        <view class="stat-label">应发工资</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value danger">¥{{salary.totalAttendanceDeductionStr}}</view>
        <view class="stat-label">考勤扣款</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value warning">¥{{salary.personalIncomeTaxStr}}</view>
        <view class="stat-label">个人所得税</view>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-header">
        <view class="section-icon income">💰</view>
        <view class="section-title">收入明细</view>
        <view class="section-total">+¥{{salary.grossSalaryStr}}</view>
      </view>
      
      <view class="detail-list">
        <view class="detail-item">
          <text class="item-label">基本工资</text>
          <text class="item-value positive">+¥{{salary.baseSalaryStr}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">岗位工资</text>
          <text class="item-value positive">+¥{{salary.postSalaryStr}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">固定补贴</text>
          <text class="item-value positive">+¥{{salary.fixedAllowanceStr}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">交通补贴</text>
          <text class="item-value positive">+¥{{salary.trafficAllowanceStr}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">通讯补贴</text>
          <text class="item-value positive">+¥{{salary.communicationAllowanceStr}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">绩效工资</text>
          <text class="item-value positive">+¥{{salary.performanceBonusStr}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-header">
        <view class="section-icon deduction">📋</view>
        <view class="section-title">考勤扣款</view>
        <view class="section-total danger">-¥{{salary.totalAttendanceDeductionStr}}</view>
      </view>
      
      <view class="detail-list">
        <view class="detail-item">
          <view class="item-left">
            <text class="item-label">事假扣款</text>
            <text class="item-tag">{{salary.personalLeaveDays}}天</text>
          </view>
          <text class="item-value negative">-¥{{salary.personalLeaveDeductionStr}}</text>
        </view>
        <view class="detail-item">
          <view class="item-left">
            <text class="item-label">病假扣款</text>
            <text class="item-tag">{{salary.sickLeaveDays}}天</text>
          </view>
          <text class="item-value negative">-¥{{salary.sickLeaveDeductionStr}}</text>
        </view>
        <view class="detail-item">
          <view class="item-left">
            <text class="item-label">迟到早退扣款</text>
            <text class="item-tag">{{salary.lateTimes}}次</text>
          </view>
          <text class="item-value negative">-¥{{salary.lateDeductionStr}}</text>
        </view>
        <view class="detail-item" wx:if="{{salary.otherDeduction > 0}}">
          <text class="item-label">其他扣款</text>
          <text class="item-value negative">-¥{{salary.otherDeductionStr}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-header">
        <view class="section-icon insurance">🏥</view>
        <view class="section-title">法定扣除</view>
        <view class="section-total warning">-¥{{salary.socialSecurityPersonalStr}}</view>
      </view>
      
      <view class="detail-list">
        <view class="detail-item">
          <text class="item-label">社保个人部分</text>
          <text class="item-value negative">-¥{{salary.socialSecurityPersonalStr}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">公积金个人部分</text>
          <text class="item-value negative">-¥{{salary.housingFundPersonalStr}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">个人所得税</text>
          <text class="item-value negative">-¥{{salary.personalIncomeTaxStr}}</text>
        </view>
      </view>
    </view>

    <view class="summary-card">
      <view class="summary-row">
        <text class="summary-label">应发工资</text>
        <text class="summary-value">¥{{salary.grossSalaryStr}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">税前工资</text>
        <text class="summary-value">¥{{salary.preTaxSalaryStr}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-row final">
        <text class="summary-label">实发工资</text>
        <text class="summary-value final-value">¥{{salary.netSalaryStr}}</text>
      </view>
    </view>

    <view class="card-footer">
      <view class="footer-item">
        <text class="footer-icon">📅</text>
        <text class="footer-text">出勤 {{salary.workDays}} 天</text>
      </view>
      <view class="footer-item">
        <text class="footer-icon">💳</text>
        <text class="footer-text">工资卡尾号 8888</text>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="action-btn secondary" bindtap="openExportModal">
      <text class="btn-icon">📤</text>
      <text class="btn-text">导出</text>
    </view>
    <button class="action-btn primary" open-type="share">
      <text class="btn-icon">📲</text>
      <text class="btn-text">分享</text>
    </button>
  </view>
</view>

<view class="modal-mask" wx:if="{{showExportModal}}" catchtap="closeExportModal">
  <view class="modal-content bottom-sheet" catchtap="">
    <view class="sheet-handle"></view>
    <view class="sheet-title">导出薪资条</view>
    
    <view class="export-list">
      <view class="export-item" bindtap="exportAs" data-type="pdf">
        <view class="export-icon-wrap red">
          <text class="export-icon">📄</text>
        </view>
        <view class="export-info">
          <view class="export-name">导出 PDF 文档</view>
          <view class="export-desc">格式规范，适合打印存档</view>
        </view>
        <text class="export-arrow">›</text>
      </view>
      <view class="export-item" bindtap="exportAs" data-type="excel">
        <view class="export-icon-wrap blue">
          <text class="export-icon">📊</text>
        </view>
        <view class="export-info">
          <view class="export-name">导出 Excel 表格</view>
          <view class="export-desc">数据完整，方便二次编辑</view>
        </view>
        <text class="export-arrow">›</text>
      </view>
      <view class="export-item" bindtap="saveImage">
        <view class="export-icon-wrap green">
          <text class="export-icon">🖼️</text>
        </view>
        <view class="export-info">
          <view class="export-name">保存为图片</view>
          <view class="export-desc">保存到相册，随时查看</view>
        </view>
        <text class="export-arrow">›</text>
      </view>
    </view>

    <view class="sheet-cancel" bindtap="closeExportModal">取消</view>
  </view>
</view>
