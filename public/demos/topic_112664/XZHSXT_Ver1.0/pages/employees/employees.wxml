<view class="page">
  <view class="header-section">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="page-title">
        <text class="title-text">员工管理</text>
        <view class="title-badge">{{stats.active}}人在职</view>
      </view>

      <view class="search-bar">
        <view class="search-input">
          <text class="search-icon">🔍</text>
          <input 
            placeholder="搜索工号/姓名" 
            placeholder-class="search-placeholder"
            value="{{keyword}}"
            bindinput="onSearchInput"
          />
        </view>
        <view class="filter-btn {{showFilter ? 'active' : ''}}" bindtap="toggleFilter">
          <text class="filter-icon">⚙️</text>
        </view>
      </view>

      <view class="filter-panel" wx:if="{{showFilter}}">
        <picker 
          mode="selector" 
          range="{{departmentOptions}}" 
          range-key="label"
          bindchange="onDepartmentChange"
        >
          <view class="filter-chip">
            <text>部门筛选</text>
            <text class="chip-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-card">
      <view class="stat-icon-wrap" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
        <text class="stat-icon">👥</text>
      </view>
      <view class="stat-info">
        <text class="stat-value">{{stats.total}}</text>
        <text class="stat-label">员工总数</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon-wrap" style="background: linear-gradient(135deg, #10b981, #059669);">
        <text class="stat-icon">✅</text>
      </view>
      <view class="stat-info">
        <text class="stat-value">{{stats.active}}</text>
        <text class="stat-label">在职人数</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon-wrap" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
        <text class="stat-icon">🏢</text>
      </view>
      <view class="stat-info">
        <text class="stat-value">{{stats.departments}}</text>
        <text class="stat-label">部门数</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon-wrap" style="background: linear-gradient(135deg, #ec4899, #db2777);">
        <text class="stat-icon">💰</text>
      </view>
      <view class="stat-info">
        <text class="stat-value">¥{{stats.avgSalary}}</text>
        <text class="stat-label">平均月薪</text>
      </view>
    </view>
  </view>

  <view class="content-area">
    <view class="section-header">
      <view class="section-tabs">
        <view 
          wx:for="{{statusOptions}}" 
          wx:key="value"
          class="tab-item {{status === item.value ? 'active' : ''}}"
          data-status="{{item.value}}"
          bindtap="onStatusChange"
        >
          {{item.label}}
        </view>
      </view>
      <view class="section-action" wx:if="{{isAdmin}}" bindtap="exportEmployees">
        <text class="action-icon">📊</text>
        <text class="action-text">导出</text>
      </view>
    </view>

    <view class="employee-list" wx:if="{{employees.length > 0}}">
      <view 
        wx:for="{{employees}}" 
        wx:key="id"
        class="employee-card"
        data-id="{{item.id}}"
        bindtap="viewEmployee"
      >
        <view class="avatar-ring">
          <view class="avatar {{item.status === 'active' ? 'avatar-active' : 'avatar-inactive'}}">
            {{item.initials}}
          </view>
        </view>
        <view class="emp-info">
          <view class="emp-header">
            <text class="emp-name">{{item.name}}</text>
            <view class="status-tag {{item.status === 'active' ? 'status-on' : 'status-off'}}">
              <view class="status-dot"></view>
              <text>{{item.status === 'active' ? '在职' : '离职'}}</text>
            </view>
          </view>
          <view class="emp-meta">
            <text class="emp-no">工号：{{item.employeeNo}}</text>
          </view>
          <view class="emp-dept-row">
            <text class="dept-tag">{{item.department}}</text>
            <text class="position-text">{{item.position}}</text>
          </view>
        </view>
        <view class="emp-right">
          <view class="salary-box">
            <text class="salary-num">¥{{item.totalSalary}}</text>
            <text class="salary-unit">/月</text>
          </view>
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{employees.length === 0}}">
      <view class="empty-illustration">
        <text class="empty-emoji">👥</text>
      </view>
      <view class="empty-title">暂无员工数据</view>
      <view class="empty-desc">点击下方按钮添加第一位员工</view>
      <button class="empty-btn" wx:if="{{isAdmin}}" bindtap="addEmployee">
        <text class="btn-icon">+</text>
        添加员工
      </button>
    </view>
  </view>

  <view class="fab-button" wx:if="{{isAdmin}}" bindtap="addEmployee">
    <text class="fab-icon">+</text>
  </view>
</view>
