.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 24rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.section-header.income {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
}

.section-header.deduction {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
}

.section-header.statutory {
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.item-list {
  background-color: #ffffff;
  border-radius: 0 0 16rpx 16rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f9fafb;
}

.item-card:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.item-tag {
  padding: 6rpx 16rpx;
  background-color: #dcfce7;
  color: #16a34a;
  font-size: 22rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.item-tag.variable {
  background-color: #fef3c7;
  color: #d97706;
}

.item-type {
  font-size: 24rpx;
  color: #6b7280;
}

.item-card.deduction .item-name {
  color: #dc2626;
}

.item-card.statutory .item-name {
  color: #2563eb;
}

.tip-card {
  background-color: #fffbeb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 12rpx;
}

.tip-content {
  font-size: 26rpx;
  color: #92400e;
  line-height: 1.6;
}
