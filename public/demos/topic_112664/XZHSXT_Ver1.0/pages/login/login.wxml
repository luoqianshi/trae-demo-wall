<view class="login-page">
  <view class="bg-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <view class="login-header">
    <view class="logo-wrap">
      <view class="logo">
        <text class="logo-icon">💰</text>
      </view>
      <view class="logo-glow"></view>
    </view>
    <view class="app-name">薪资核算系统</view>
    <view class="app-desc">企业人事轻量化薪资管理工具</view>
  </view>

  <view class="login-card">
    <view class="card-header">
      <view class="welcome-text">欢迎回来 👋</view>
      <view class="sub-text">请选择您的身份登录</view>
    </view>

    <view class="role-selector">
      <view 
        wx:for="{{roleOptions}}" 
        wx:key="value"
        class="role-card {{selectedRole === item.value ? 'active' : ''}}"
        data-role="{{item.value}}"
        bindtap="selectRole"
      >
        <view class="role-icon">{{item.icon}}</view>
        <view class="role-info">
          <view class="role-name">{{item.label}}</view>
          <view class="role-desc">{{item.desc}}</view>
        </view>
        <view class="role-check">
          <view class="check-circle" wx:if="{{selectedRole === item.value}}">
            <text class="check-icon">✓</text>
          </view>
        </view>
      </view>
    </view>

    <view class="form-group" wx:if="{{selectedRole === 'employee'}}">
      <view class="form-label">
        <text class="label-icon">🆔</text>
        <text>工号</text>
      </view>
      <view class="input-wrapper">
        <input 
          class="form-input" 
          placeholder="请输入您的工号"
          placeholder-class="input-placeholder"
          value="{{employeeNo}}"
          bindinput="onInputEmployeeNo"
        />
      </view>
    </view>

    <view class="agree-section">
      <view class="checkbox {{agree ? 'checked' : ''}}" bindtap="toggleAgree">
        <text wx:if="{{agree}}" class="check-icon">✓</text>
      </view>
      <view class="agree-text">
        我已阅读并同意<text class="link">《用户协议》</text>和<text class="link">《隐私政策》</text>
      </view>
    </view>

    <button 
      class="login-btn {{agree ? '' : 'disabled'}}" 
      bindtap="handleLogin"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
    >
      <text wx:if="{{!isLoading}}">立即登录</text>
      <text wx:else>登录中...</text>
    </button>
  </view>

  <view class="login-footer">
    <text class="footer-text">© 2024 薪资核算系统 · 安全可靠</text>
  </view>
</view>
