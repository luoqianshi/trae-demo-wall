.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.header-section {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(135deg, #059669 0%, #10b981 40%, #34d399 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  position: relative;
  z-index: 10;
  padding: 60rpx 32rpx 0;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.lock-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.lock-badge.locked {
  background: rgba(239, 68, 68, 0.25);
  color: #fecaca;
}

.lock-badge.unlocked {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.lock-icon {
  font-size: 24rpx;
}

.month-picker {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  backdrop-filter: blur(10rpx);
}

.calendar-icon {
  font-size: 28rpx;
}

.month-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.month-arrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 16rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #9ca3af;
}

.dept-filter {
  width: 84rpx;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.filter-icon {
  font-size: 36rpx;
}

.summary-section {
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 20;
}

.summary-card {
  background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(5, 150, 105, 0.15);
  position: relative;
  overflow: hidden;
}

.summary-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(52, 211, 153, 0.05));
  border-radius: 50%;
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.summary-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #065f46;
}

.title-icon {
  font-size: 32rpx;
}

.summary-count {
  font-size: 24rpx;
  color: #059669;
  font-weight: 500;
  padding: 6rpx 16rpx;
  background: rgba(16, 185, 129, 0.15);
  border-radius: 20rpx;
}

.summary-main {
  text-align: center;
  padding: 20rpx 0 28rpx;
  border-bottom: 2rpx solid rgba(16, 185, 129, 0.1);
  margin-bottom: 24rpx;
}

.main-label {
  font-size: 26rpx;
  color: #047857;
  margin-bottom: 12rpx;
}

.main-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.currency {
  font-size: 32rpx;
  font-weight: 600;
  color: #059669;
  margin-right: 8rpx;
}

.amount {
  font-size: 56rpx;
  font-weight: 700;
  color: #047857;
  letter-spacing: 1rpx;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.summary-item {
  width: calc(50% - 8rpx);
  text-align: center;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
}

.item-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.item-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.item-value.blue {
  color: #2563eb;
}

.item-value.orange {
  color: #ea580c;
}

.item-value.green {
  color: #059669;
}

.dept-section {
  padding: 28rpx 0 0;
}

.section-title {
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.dept-scroll {
  white-space: nowrap;
  padding-left: 24rpx;
}

.dept-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 24rpx;
}

.dept-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.dept-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.dept-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dept-count {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.dept-salary {
  font-size: 28rpx;
  font-weight: 700;
  color: #059669;
  margin-bottom: 2rpx;
}

.dept-salary-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.action-section {
  padding: 28rpx 24rpx 8rpx;
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  transition: transform 0.2s ease;
}

.action-card:active {
  transform: scale(0.98);
}

.action-card.primary {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 0 8rpx 28rpx rgba(5, 150, 105, 0.35);
}

.action-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 36rpx;
}

.action-info {
  color: #ffffff;
}

.action-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 24rpx;
  opacity: 0.85;
}

.action-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-mini {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.action-mini:active {
  transform: scale(0.96);
}

.action-mini.warning {
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
}

.action-mini.success {
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
}

.mini-icon {
  font-size: 36rpx;
}

.mini-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #374151;
}

.list-section {
  padding: 24rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.section-count {
  font-size: 24rpx;
  color: #6b7280;
}

.salary-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.salary-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-main {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}

.avatar-wrap {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.salary-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #047857;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.15);
}

.emp-info {
  flex: 1;
  min-width: 0;
}

.emp-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.emp-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.dept-badge {
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  color: #059669;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.emp-position {
  font-size: 24rpx;
  color: #4b5563;
  margin-bottom: 4rpx;
}

.emp-no {
  font-size: 22rpx;
  color: #9ca3af;
}

.salary-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.net-salary-box {
  text-align: right;
}

.net-label {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
  margin-bottom: 4rpx;
}

.net-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #059669;
}

.expand-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
  transition: transform 0.25s ease;
}

.expand-btn.expanded {
  transform: rotate(90deg);
  background: #d1fae5;
}

.expand-icon {
  font-size: 32rpx;
  color: #6b7280;
  font-weight: 300;
  line-height: 1;
}

.card-detail {
  padding: 0 24rpx 24rpx;
  border-top: 2rpx solid #f3f4f6;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.detail-row {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
}

.detail-col {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: #f9fafb;
  border-radius: 14rpx;
}

.col-label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.col-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.col-value.danger {
  color: #dc2626;
}

.detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.3);
}

.action-arrow-icon {
  font-size: 32rpx;
  font-weight: 300;
}

.empty-state {
  padding: 40rpx 0;
}

.empty-state.small {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.empty-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 28rpx;
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
}

.empty-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 0.2s ease;
}

.empty-btn:active {
  transform: scale(0.97);
}

.empty-btn.primary {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(5, 150, 105, 0.3);
}

.empty-btn.secondary {
  background: #f3f4f6;
  color: #4b5563;
}

.btn-icon {
  font-size: 32rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content.bottom-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 28rpx;
}

.export-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.export-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #f9fafb;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.export-item:active {
  background: #f3f4f6;
  transform: scale(0.98);
}

.export-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.export-icon-wrap.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.export-icon-wrap.red {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
}

.export-icon {
  font-size: 36rpx;
}

.export-info {
  flex: 1;
  min-width: 0;
}

.export-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.export-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.export-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.sheet-cancel {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
}
