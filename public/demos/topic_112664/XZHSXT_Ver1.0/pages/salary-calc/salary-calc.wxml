<view class="page">
  <view class="header-section">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="page-header">
        <view class="page-title-row">
          <text class="page-title">薪资核算</text>
          <view class="lock-badge {{isLocked ? 'locked' : 'unlocked'}}" wx:if="{{isAdmin}}">
            <text class="lock-icon">{{isLocked ? '🔒' : '🔓'}}</text>
            <text>{{isLocked ? '已锁定' : '可编辑'}}</text>
          </view>
        </view>
        <picker 
          mode="selector" 
          range="{{monthList}}"
          value="{{monthIndex}}"
          bindchange="onMonthChange"
        >
          <view class="month-picker">
            <text class="calendar-icon">📅</text>
            <text class="month-text">{{currentMonth}}</text>
            <text class="month-arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="search-bar">
        <view class="search-input">
          <text class="search-icon">🔍</text>
          <input 
            placeholder="搜索员工姓名/工号" 
            placeholder-class="search-placeholder"
            value="{{keyword}}"
            bindinput="onSearchInput"
          />
        </view>
        <picker 
          mode="selector" 
          range="{{departmentOptions}}" 
          range-key="label"
          bindchange="onDepartmentChange"
        >
          <view class="dept-filter">
            <text class="filter-icon">🏢</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="summary-section" wx:if="{{hasCalculated && statistics}}">
    <view class="summary-card">
      <view class="summary-header">
        <view class="summary-title">
          <text class="title-icon">📊</text>
          <text>本月薪资概览</text>
        </view>
        <view class="summary-count">{{statistics.totalCount}} 人</view>
      </view>
      
      <view class="summary-main">
        <view class="main-label">实发总额</view>
        <view class="main-value">
          <text class="currency">¥</text>
          <text class="amount">{{statistics.totalNetStr}}</text>
        </view>
      </view>

      <view class="summary-grid">
        <view class="summary-item">
          <view class="item-label">应发总额</view>
          <view class="item-value blue">¥{{statistics.totalGrossStr}}</view>
        </view>
        <view class="summary-item">
          <view class="item-label">个税总额</view>
          <view class="item-value orange">¥{{statistics.totalTaxStr}}</view>
        </view>
        <view class="summary-item">
          <view class="item-label">人均应发</view>
          <view class="item-value">¥{{statistics.avgGrossStr}}</view>
        </view>
        <view class="summary-item">
          <view class="item-label">人均实发</view>
          <view class="item-value green">¥{{statistics.avgNetStr}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="dept-section" wx:if="{{deptStats.length > 0}}">
    <view class="section-title">
      <text class="title-text">部门薪资</text>
    </view>
    <scroll-view scroll-x class="dept-scroll" enhanced show-scrollbar="{{false}}">
      <view class="dept-list">
        <view 
          wx:for="{{deptStats}}" 
          wx:key="department"
          class="dept-card"
        >
          <view class="dept-icon">🏢</view>
          <view class="dept-name">{{item.department}}</view>
          <view class="dept-count">{{item.count}}人</view>
          <view class="dept-salary">¥{{item.avgNet}}</view>
          <view class="dept-salary-label">人均月薪</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="action-section" wx:if="{{isAdmin}}">
    <view class="action-card primary" bindtap="calculateSalary">
      <view class="action-left">
        <view class="action-icon-wrap">
          <text class="action-icon">⚡</text>
        </view>
        <view class="action-info">
          <view class="action-title">{{hasCalculated ? '重新核算' : '一键核算'}}</view>
          <view class="action-desc">{{hasCalculated ? '更新本月薪资数据' : '立即生成本月薪资'}}</view>
        </view>
      </view>
      <view class="action-arrow">›</view>
    </view>

    <view class="action-row">
      <view class="action-mini {{isLocked ? 'warning' : 'success'}}" bindtap="toggleLock" wx:if="{{hasCalculated}}">
        <text class="mini-icon">{{isLocked ? '🔓' : '🔒'}}</text>
        <text class="mini-text">{{isLocked ? '解锁' : '锁定'}}</text>
      </view>
      <view class="action-mini" bindtap="openExportModal" wx:if="{{hasCalculated}}">
        <text class="mini-icon">📤</text>
        <text class="mini-text">导出</text>
      </view>
      <view class="action-mini" bindtap="gotoAttendance">
        <text class="mini-icon">📋</text>
        <text class="mini-text">考勤</text>
      </view>
    </view>
  </view>

  <view class="list-section">
    <view class="section-header">
      <text class="section-title-text">薪资明细</text>
      <text class="section-count">共 {{salaryList.length}} 人</text>
    </view>

    <view class="salary-list" wx:if="{{hasCalculated && salaryList.length > 0}}">
      <view 
        wx:for="{{salaryList}}" 
        wx:key="id"
        class="salary-card"
      >
        <view class="card-main" data-id="{{item.id}}" bindtap="toggleExpand">
          <view class="avatar-wrap">
            <view class="salary-avatar">{{item.initials}}</view>
          </view>
          <view class="emp-info">
            <view class="emp-top">
              <text class="emp-name">{{item.name}}</text>
              <view class="dept-badge">{{item.department}}</view>
            </view>
            <view class="emp-position">{{item.position}}</view>
            <view class="emp-no">{{item.employeeNo}}</view>
          </view>
          <view class="salary-right">
            <view class="net-salary-box">
              <text class="net-label">实发</text>
              <text class="net-value">¥{{item.netSalaryStr}}</text>
            </view>
            <view class="expand-btn {{expandedId === item.id ? 'expanded' : ''}}">
              <text class="expand-icon">›</text>
            </view>
          </view>
        </view>

        <view class="card-detail" wx:if="{{expandedId === item.id}}">
          <view class="detail-row">
            <view class="detail-col">
              <text class="col-label">应发工资</text>
              <text class="col-value">¥{{item.grossSalaryStr}}</text>
            </view>
            <view class="detail-col">
              <text class="col-label">税前工资</text>
              <text class="col-value">¥{{item.preTaxSalaryStr}}</text>
            </view>
          </view>
          <view class="detail-row">
            <view class="detail-col">
              <text class="col-label">个人所得税</text>
              <text class="col-value danger">¥{{item.personalIncomeTaxStr}}</text>
            </view>
            <view class="detail-col">
              <text class="col-label">扣款合计</text>
              <text class="col-value danger">¥{{item.deductionTotal}}</text>
            </view>
          </view>
          <view class="detail-action" data-id="{{item.id}}" catchtap="viewDetail">
            <text>查看完整薪资条</text>
            <text class="action-arrow-icon">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!hasCalculated}}">
      <view class="empty-card">
        <view class="empty-illustration">
          <text class="empty-emoji">🧮</text>
        </view>
        <view class="empty-title">本月尚未核算薪资</view>
        <view class="empty-desc">点击一键核算，快速生成本月薪资</view>
        <view class="empty-actions" wx:if="{{isAdmin}}">
          <view class="empty-btn primary" bindtap="calculateSalary">
            <text class="btn-icon">⚡</text>
            <text>一键核算</text>
          </view>
          <view class="empty-btn secondary" bindtap="gotoAttendance">
            <text class="btn-icon">📋</text>
            <text>录入考勤</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state small" wx:if="{{hasCalculated && salaryList.length === 0}}">
      <text class="empty-text">暂无匹配的薪资数据</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showExportModal}}" catchtap="closeExportModal">
    <view class="modal-content bottom-sheet" catchtap="">
      <view class="sheet-handle"></view>
      <view class="sheet-title">导出薪资报表</view>
      
      <view class="export-list">
        <view class="export-item" bindtap="exportSalary" data-type="salary">
          <view class="export-icon-wrap blue">
            <text class="export-icon">📊</text>
          </view>
          <view class="export-info">
            <view class="export-name">导出 Excel 表格</view>
            <view class="export-desc">全量月度薪资明细报表</view>
          </view>
          <text class="export-arrow">›</text>
        </view>
        <view class="export-item" bindtap="exportSalary" data-type="salary-pdf">
          <view class="export-icon-wrap red">
            <text class="export-icon">📄</text>
          </view>
          <view class="export-info">
            <view class="export-name">导出 PDF 文档</view>
            <view class="export-desc">格式规范的薪资汇总表</view>
          </view>
          <text class="export-arrow">›</text>
        </view>
      </view>

      <view class="sheet-cancel" bindtap="closeExportModal">取消</view>
    </view>
  </view>
</view>
