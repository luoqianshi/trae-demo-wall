<view class="page">
  <view class="header-section">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="page-header">
        <view class="page-title-row">
          <text class="page-title">考勤管理</text>
          <view class="lock-badge {{isLocked ? 'locked' : 'unlocked'}}" wx:if="{{isAdmin}}">
            <text class="lock-icon">{{isLocked ? '🔒' : '🔓'}}</text>
            <text>{{isLocked ? '已锁定' : '可编辑'}}</text>
          </view>
        </view>
        <picker 
          mode="selector" 
          range="{{monthList}}"
          value="{{monthIndex}}"
          bindchange="onMonthChange"
        >
          <view class="month-picker">
            <text class="calendar-icon">📅</text>
            <text class="month-text">{{currentMonth}}</text>
            <text class="month-arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="search-bar">
        <view class="search-input">
          <text class="search-icon">🔍</text>
          <input 
            placeholder="搜索员工姓名/工号" 
            placeholder-class="search-placeholder"
            value="{{keyword}}"
            bindinput="onSearchInput"
          />
        </view>
        <picker 
          mode="selector" 
          range="{{departmentOptions}}" 
          range-key="label"
          bindchange="onDepartmentChange"
        >
          <view class="dept-filter">
            <text class="filter-icon">🏢</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="stats-section">
    <view class="stats-card">
      <view class="stat-item stat-main">
        <view class="stat-icon-wrap" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">
          <text class="stat-icon">👥</text>
        </view>
        <view class="stat-content">
          <text class="stat-value">{{stats.totalEmployees}}</text>
          <text class="stat-label">员工总数</text>
        </view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-icon-wrap small" style="background: linear-gradient(135deg, #10b981, #059669);">
          <text class="stat-icon-sm">✅</text>
        </view>
        <view class="stat-content">
          <text class="stat-value-sm">{{stats.normalCount}}</text>
          <text class="stat-label-sm">全勤</text>
        </view>
      </view>
      <view class="stat-item">
        <view class="stat-icon-wrap small" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
          <text class="stat-icon-sm">⚠️</text>
        </view>
        <view class="stat-content">
          <text class="stat-value-sm">{{stats.hasDeduction}}</text>
          <text class="stat-label-sm">有扣款</text>
        </view>
      </view>
      <view class="stat-item">
        <view class="stat-icon-wrap small" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
          <text class="stat-icon-sm">💰</text>
        </view>
        <view class="stat-content">
          <text class="stat-value-sm">¥{{stats.totalDeduction}}</text>
          <text class="stat-label-sm">扣款总额</text>
        </view>
      </view>
    </view>
  </view>

  <view class="action-bar" wx:if="{{isAdmin}}">
    <view class="action-card" bindtap="handleImport">
      <view class="action-icon-wrap blue">
        <text class="action-icon">📥</text>
      </view>
      <view class="action-text">
        <text class="action-title">导入考勤</text>
        <text class="action-desc">Excel批量导入</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
    <view class="action-card" bindtap="recalcAllDeduction">
      <view class="action-icon-wrap orange">
        <text class="action-icon">🔄</text>
      </view>
      <view class="action-text">
        <text class="action-title">重算扣款</text>
        <text class="action-desc">一键重新计算</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <view class="list-section">
    <view class="section-title">
      <text class="title-text">考勤明细</text>
      <text class="title-count">共 {{attendanceList.length}} 人</text>
    </view>

    <view class="attendance-list" wx:if="{{attendanceList.length > 0}}">
      <view 
        wx:for="{{attendanceList}}" 
        wx:key="employeeId"
        class="attendance-card"
      >
        <view class="card-main" data-id="{{item.employeeId}}" bindtap="toggleExpand">
          <view class="avatar-wrap">
            <view class="avatar status-{{item.statusLevel}}">{{item.initials}}</view>
            <view class="status-dot status-{{item.statusLevel}}"></view>
          </view>
          <view class="emp-info">
            <view class="emp-top">
              <text class="emp-name">{{item.name}}</text>
              <view class="new-tag" wx:if="{{item.isNew}}">新增</view>
            </view>
            <view class="emp-meta">
              <text class="emp-no">{{item.employeeNo}}</text>
              <text class="dot">·</text>
              <text class="emp-dept">{{item.department}}</text>
            </view>
            <view class="emp-stats">
              <view class="mini-stat">
                <text class="mini-num">{{item.workDays}}</text>
                <text class="mini-label">出勤</text>
              </view>
              <view class="mini-stat">
                <text class="mini-num">{{item.personalLeaveDays}}</text>
                <text class="mini-label">事假</text>
              </view>
              <view class="mini-stat">
                <text class="mini-num">{{item.lateTimes}}</text>
                <text class="mini-label">迟到</text>
              </view>
            </view>
          </view>
          <view class="card-right">
            <view class="deduction-box {{item.hasDeduction ? 'has-ded' : 'no-ded'}}">
              <text class="ded-label">扣款</text>
              <text class="ded-value">¥{{item.totalDeduction}}</text>
            </view>
            <view class="expand-btn {{expandedId === item.employeeId ? 'expanded' : ''}}">
              <text class="expand-icon">›</text>
            </view>
          </view>
        </view>

        <view class="card-detail" wx:if="{{expandedId === item.employeeId}}">
          <view class="detail-section">
            <view class="detail-title">考勤数据</view>
            <view class="detail-grid">
              <view class="detail-item">
                <text class="detail-value">{{item.workDays}}天</text>
                <text class="detail-label">出勤天数</text>
              </view>
              <view class="detail-item">
                <text class="detail-value">{{item.personalLeaveDays}}天</text>
                <text class="detail-label">事假</text>
              </view>
              <view class="detail-item">
                <text class="detail-value">{{item.sickLeaveDays}}天</text>
                <text class="detail-label">病假</text>
              </view>
              <view class="detail-item">
                <text class="detail-value">{{item.absentDays}}天</text>
                <text class="detail-label">旷工</text>
              </view>
              <view class="detail-item">
                <text class="detail-value">{{item.lateTimes}}次</text>
                <text class="detail-label">迟到次数</text>
              </view>
              <view class="detail-item">
                <text class="detail-value">{{item.lateMinutes}}分</text>
                <text class="detail-label">迟到时长</text>
              </view>
            </view>
          </view>

          <view class="detail-section">
            <view class="detail-title">扣款明细</view>
            <view class="ded-list">
              <view class="ded-item">
                <text class="ded-name">事假扣款</text>
                <text class="ded-amount">¥{{item.personalLeaveDeduction}}</text>
              </view>
              <view class="ded-item">
                <text class="ded-name">病假扣款</text>
                <text class="ded-amount">¥{{item.sickLeaveDeduction}}</text>
              </view>
              <view class="ded-item">
                <text class="ded-name">迟到扣款</text>
                <text class="ded-amount">¥{{item.lateDeduction}}</text>
              </view>
              <view class="ded-item">
                <text class="ded-name">其他扣款</text>
                <text class="ded-amount">¥{{item.otherDeduction || '0.00'}}</text>
              </view>
              <view class="ded-item total">
                <text class="ded-name">扣款合计</text>
                <text class="ded-amount total-amount">¥{{item.totalDeduction}}</text>
              </view>
            </view>
          </view>

          <view class="detail-actions" wx:if="{{isAdmin}}">
            <view class="btn-edit" data-employee-id="{{item.employeeId}}" catchtap="editAttendance">
              <text class="btn-icon">✏️</text>
              <text>编辑考勤</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{attendanceList.length === 0}}">
      <view class="empty-illustration">
        <text class="empty-emoji">📋</text>
      </view>
      <view class="empty-title">暂无考勤数据</view>
      <view class="empty-desc">导入或录入本月考勤数据</view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showEditModal}}" catchtap="closeEditModal">
    <view class="modal-content modal-sheet" catchtap="">
      <view class="modal-header">
        <view class="modal-title">编辑考勤</view>
        <view class="modal-close" bindtap="closeEditModal">✕</view>
      </view>
      
      <scroll-view scroll-y class="modal-body">
        <view class="edit-emp-card">
          <view class="edit-avatar">{{currentEmployee.name[0]}}</view>
          <view class="edit-emp-info">
            <view class="edit-emp-name">{{currentEmployee.name}}</view>
            <view class="edit-emp-dept">{{currentEmployee.department}} · {{currentEmployee.position}}</view>
          </view>
        </view>

        <view class="form-section">
          <view class="form-section-title">基本考勤</view>
          <view class="form-grid">
            <view class="form-field">
              <text class="field-label">出勤天数</text>
              <input 
                class="field-input"
                type="digit"
                value="{{editData.workDays}}"
                data-field="workDays"
                bindinput="onEditInput"
              />
            </view>
            <view class="form-field">
              <text class="field-label">事假(天)</text>
              <input 
                class="field-input"
                type="digit"
                value="{{editData.personalLeaveDays}}"
                data-field="personalLeaveDays"
                bindinput="onEditInput"
              />
            </view>
            <view class="form-field">
              <text class="field-label">病假(天)</text>
              <input 
                class="field-input"
                type="digit"
                value="{{editData.sickLeaveDays}}"
                data-field="sickLeaveDays"
                bindinput="onEditInput"
              />
            </view>
            <view class="form-field">
              <text class="field-label">旷工(天)</text>
              <input 
                class="field-input"
                type="digit"
                value="{{editData.absentDays}}"
                data-field="absentDays"
                bindinput="onEditInput"
              />
            </view>
          </view>
        </view>

        <view class="form-section">
          <view class="form-section-title">迟到早退</view>
          <view class="form-grid">
            <view class="form-field">
              <text class="field-label">迟到次数</text>
              <input 
                class="field-input"
                type="number"
                value="{{editData.lateTimes}}"
                data-field="lateTimes"
                bindinput="onEditInput"
              />
            </view>
            <view class="form-field">
              <text class="field-label">迟到(分钟)</text>
              <input 
                class="field-input"
                type="number"
                value="{{editData.lateMinutes}}"
                data-field="lateMinutes"
                bindinput="onEditInput"
              />
            </view>
            <view class="form-field full-width">
              <text class="field-label">其他扣款(元)</text>
              <input 
                class="field-input"
                type="digit"
                value="{{editData.otherDeduction}}"
                data-field="otherDeduction"
                bindinput="onEditInput"
              />
            </view>
          </view>
        </view>

        <view class="deduction-card">
          <view class="ded-card-title">
            <text class="title-icon">💡</text>
            <text>实时计算扣款</text>
          </view>
          <view class="ded-card-body">
            <view class="ded-row">
              <text class="ded-row-label">事假扣款</text>
              <text class="ded-row-value">¥{{editData.personalLeaveDeduction}}</text>
            </view>
            <view class="ded-row">
              <text class="ded-row-label">病假扣款</text>
              <text class="ded-row-value">¥{{editData.sickLeaveDeduction}}</text>
            </view>
            <view class="ded-row">
              <text class="ded-row-label">迟到扣款</text>
              <text class="ded-row-value">¥{{editData.lateDeduction}}</text>
            </view>
            <view class="ded-row total">
              <text class="ded-row-label">合计扣款</text>
              <text class="ded-row-value total-value">¥{{editData.totalDeduction}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="modal-footer">
        <view class="btn-cancel" bindtap="closeEditModal">取消</view>
        <view class="btn-confirm" bindtap="saveEdit">保存</view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showImportModal}}" catchtap="closeImportModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <view class="modal-title">导入结果</view>
        <view class="modal-close" bindtap="closeImportModal">✕</view>
      </view>
      
      <view class="import-result-card">
        <view class="result-icon">🎉</view>
        <view class="result-title">导入完成</view>
        <view class="result-stats">
          <view class="result-stat">
            <text class="result-num">{{importResult.total}}</text>
            <text class="result-label">总记录</text>
          </view>
          <view class="result-stat success">
            <text class="result-num">{{importResult.successCount}}</text>
            <text class="result-label">成功</text>
          </view>
          <view class="result-stat fail">
            <text class="result-num">{{importResult.failCount}}</text>
            <text class="result-label">失败</text>
          </view>
        </view>
      </view>

      <view class="error-section" wx:if="{{importResult.errors && importResult.errors.length > 0}}">
        <view class="error-title">
          <text class="error-icon">⚠️</text>
          <text>错误明细</text>
        </view>
        <scroll-view scroll-y class="error-list">
          <view wx:for="{{importResult.errors}}" wx:key="employeeNo" class="error-item">
            <text class="error-emp">{{item.employeeNo}} {{item.name}}</text>
            <text class="error-reason">{{item.reason}}</text>
          </view>
        </scroll-view>
      </view>

      <view class="modal-footer">
        <view class="btn-confirm full-width" bindtap="closeImportModal">知道了</view>
      </view>
    </view>
  </view>
</view>
