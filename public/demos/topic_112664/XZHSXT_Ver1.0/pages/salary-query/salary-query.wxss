.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.header-section {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 40%, #8b5cf6 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  position: relative;
  z-index: 10;
  padding: 60rpx 32rpx 32rpx;
}

.header-top {
  margin-bottom: 28rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.month-picker {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
}

.calendar-icon {
  font-size: 26rpx;
}

.month-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.month-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-badge {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: inline-block;
}

.user-name {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 30rpx;
  opacity: 0.5;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 16rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #9ca3af;
}

.dept-filter {
  width: 84rpx;
  height: 84rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.filter-icon {
  font-size: 36rpx;
}

.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 6rpx;
  backdrop-filter: blur(10rpx);
}

.tab-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  transition: all 0.25s ease;
}

.tab-item.active {
  background-color: #ffffff;
  color: #4f46e5;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.tab-icon {
  font-size: 28rpx;
}

.summary-card-section {
  padding: 0 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 20;
}

.summary-card {
  background: linear-gradient(135deg, #ffffff 0%, #f5f3ff 100%);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(79, 70, 229, 0.15);
  position: relative;
  overflow: hidden;
}

.summary-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(99, 102, 241, 0.05));
  border-radius: 50%;
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4c1d95;
}

.summary-count {
  font-size: 22rpx;
  color: #7c3aed;
  font-weight: 500;
  padding: 6rpx 16rpx;
  background: rgba(139, 92, 246, 0.15);
  border-radius: 16rpx;
}

.summary-main {
  text-align: center;
  padding: 16rpx 0 24rpx;
  border-bottom: 2rpx solid rgba(139, 92, 246, 0.1);
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.main-label {
  font-size: 26rpx;
  color: #6d28d9;
  margin-bottom: 10rpx;
}

.main-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.currency {
  font-size: 30rpx;
  font-weight: 600;
  color: #7c3aed;
  margin-right: 8rpx;
}

.amount {
  font-size: 52rpx;
  font-weight: 700;
  color: #5b21b6;
  letter-spacing: 1rpx;
}

.summary-grid {
  display: flex;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.summary-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
}

.item-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.item-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.item-value.success {
  color: #059669;
}

.item-value.primary {
  color: #4f46e5;
}

.trend-section {
  padding: 28rpx 24rpx 0;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.trend-chart {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 240rpx;
  padding: 0 8rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-wrapper {
  width: 36rpx;
  height: 180rpx;
  background: #f3f4f6;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #8b5cf6 0%, #6366f1 100%);
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  transition: height 0.5s ease;
}

.bar-label {
  font-size: 20rpx;
  color: #6b7280;
}

.history-section {
  padding: 28rpx 24rpx 0;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.history-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.04);
}

.history-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.month-badge-custom {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.month-main {
  font-size: 22rpx;
  font-weight: 700;
  color: #4f46e5;
  text-align: center;
  line-height: 1.3;
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-salary {
  margin-bottom: 6rpx;
}

.salary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #059669;
}

.history-detail {
  font-size: 22rpx;
  color: #9ca3af;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  color: #d1d5db;
}

.history-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.arrow-icon {
  font-size: 36rpx;
  color: #d1d5db;
}

.list-section {
  padding: 24rpx;
  margin-top: -16rpx;
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-count {
  font-size: 24rpx;
  color: #6b7280;
}

.salary-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.salary-card-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.15s ease;
}

.salary-card-item:active {
  background: #f9fafb;
  transform: scale(0.98);
}

.avatar-wrap {
  margin-right: 18rpx;
  flex-shrink: 0;
}

.salary-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
  color: #4f46e5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.emp-info {
  flex: 1;
  min-width: 0;
}

.emp-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.emp-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.dept-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
  color: #4f46e5;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.emp-position {
  font-size: 24rpx;
  color: #6b7280;
}

.salary-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.net-salary {
  font-size: 30rpx;
  font-weight: 700;
  color: #059669;
  margin-bottom: 4rpx;
}

.gross-hint {
  font-size: 20rpx;
  color: #9ca3af;
}

.card-arrow {
  font-size: 32rpx;
  color: #d1d5db;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.stats-section {
  padding: 24rpx;
  margin-top: -16rpx;
}

.stats-overview-card {
  background: linear-gradient(135deg, #ffffff 0%, #f5f3ff 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.1);
}

.overview-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4c1d95;
  margin-bottom: 20rpx;
}

.overview-grid {
  display: flex;
  gap: 16rpx;
}

.overview-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
}

.overview-value {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.overview-value.primary {
  color: #4f46e5;
}

.overview-value.success {
  color: #059669;
}

.overview-value.warning {
  color: #ea580c;
}

.overview-value.info {
  color: #2563eb;
}

.overview-label {
  font-size: 20rpx;
  color: #6b7280;
}

.dept-stats-section {
  margin-bottom: 24rpx;
}

.export-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.export-icon {
  font-size: 22rpx;
}

.dept-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dept-stat-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dept-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dept-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dept-info {
  flex: 1;
  min-width: 0;
}

.dept-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 2rpx;
}

.dept-count {
  font-size: 22rpx;
  color: #6b7280;
}

.dept-salary {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.dept-avg {
  font-size: 28rpx;
  font-weight: 700;
  color: #059669;
  display: block;
  margin-bottom: 2rpx;
}

.dept-salary-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.dept-progress {
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f3f4f6;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4f46e5, #8b5cf6);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.dept-detail-row {
  display: flex;
  gap: 12rpx;
}

.dept-detail-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.detail-label {
  font-size: 22rpx;
  color: #6b7280;
}

.detail-value {
  font-size: 22rpx;
  font-weight: 600;
  color: #1f2937;
}

.detail-value.success {
  color: #059669;
}

.empty-state {
  padding: 40rpx 0;
}

.empty-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.empty-illustration {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 28rpx;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.action-text {
  color: #ffffff;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content.bottom-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 28rpx;
}

.export-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.export-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #f9fafb;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.export-item:active {
  background: #f3f4f6;
  transform: scale(0.98);
}

.export-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.export-icon-wrap.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.export-icon-wrap.red {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
}

.export-icon {
  font-size: 36rpx;
}

.export-info {
  flex: 1;
  min-width: 0;
}

.export-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.export-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.export-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.sheet-cancel {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  transition: all 0.15s;
}

.sheet-cancel:active {
  background: #e5e7eb;
}
