<view class="tab-bar">
  <view class="tab-bg">
    <view 
      class="tab-indicator" 
      style="transform: translateX({{indicatorOffset}}); width: {{indicatorWidth}};"
    ></view>
  </view>
  <view 
    wx:for="{{visibleTabs}}" 
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <view class="tab-icon-bg" wx:if="{{selected === index}}"></view>
      <text class="tab-icon">{{item.icon}}</text>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
