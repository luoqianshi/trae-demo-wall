page {
  --primary-50: #eff6ff;
  --primary-100: #dbeafe;
  --primary-200: #bfdbfe;
  --primary-300: #93c5fd;
  --primary-400: #60a5fa;
  --primary-500: #3b82f6;
  --primary-600: #2563eb;
  --primary-700: #1d4ed8;
  --primary-800: #1e40af;
  --primary-900: #1e3a8a;

  --success-50: #f0fdf4;
  --success-100: #dcfce7;
  --success-500: #22c55e;
  --success-600: #16a34a;
  --success-700: #15803d;

  --danger-50: #fef2f2;
  --danger-100: #fee2e2;
  --danger-500: #ef4444;
  --danger-600: #dc2626;
  --danger-700: #b91c1c;

  --warning-50: #fffbeb;
  --warning-100: #fef3c7;
  --warning-500: #f59e0b;
  --warning-600: #d97706;

  --gray-50: #f9fafb;
  --gray-100: #f3f4f6;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-600: #4b5563;
  --gray-700: #374151;
  --gray-800: #1f2937;
  --gray-900: #111827;

  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-2xl: 24rpx;
  --radius-3xl: 32rpx;
  --radius-full: 9999rpx;

  --shadow-sm: 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4rpx 12rpx -2rpx rgba(0, 0, 0, 0.06), 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.04);
  --shadow-lg: 0 10rpx 24rpx -4rpx rgba(0, 0, 0, 0.08), 0 4rpx 8rpx -4rpx rgba(0, 0, 0, 0.04);
  --shadow-xl: 0 20rpx 40rpx -8rpx rgba(0, 0, 0, 0.1), 0 8rpx 16rpx -8rpx rgba(0, 0, 0, 0.05);

  background-color: var(--gray-50);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--gray-800);
  box-sizing: border-box;
  line-height: 1.5;
}

view, text, button, input, textarea, image, scroll-view {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  background-color: var(--gray-50);
}

.card {
  background-color: #ffffff;
  border-radius: var(--radius-xl);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900);
  margin-bottom: 20rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  border: none;
  position: relative;
  overflow: hidden;
}

.btn::after {
  border: none;
}

.btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

.btn-secondary {
  background-color: var(--gray-100);
  color: var(--gray-700);
}

.btn-danger {
  background-color: var(--danger-50);
  color: var(--danger-600);
}

.btn-success {
  background-color: var(--success-50);
  color: var(--success-600);
}

.btn-warning {
  background-color: var(--warning-50);
  color: var(--warning-600);
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid var(--gray-200);
  color: var(--gray-700);
}

.btn-block {
  width: 100%;
}

.btn-small {
  height: 60rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  border-radius: var(--radius-md);
}

.btn-large {
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 100;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.fab:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--gray-700);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  background-color: #ffffff;
  color: var(--gray-900);
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: var(--primary-500);
  background-color: var(--primary-50);
}

.form-input::placeholder {
  color: var(--gray-400);
}

.form-input.disabled {
  background-color: var(--gray-50);
  color: var(--gray-500);
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  background-color: #ffffff;
  color: var(--gray-900);
  line-height: 1.6;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .form-item {
  flex: 1;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  background-color: #ffffff;
  color: var(--gray-900);
  transition: all 0.2s ease;
}

.picker-input:active {
  background-color: var(--gray-50);
}

.picker-input .placeholder {
  color: var(--gray-400);
}

.picker-input .arrow {
  color: var(--gray-400);
  font-size: 24rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 2rpx solid var(--gray-100);
  transition: background-color 0.15s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: var(--gray-50);
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-primary {
  background: linear-gradient(135deg, var(--primary-400) 0%, var(--primary-600) 100%);
  color: #ffffff;
}

.avatar-success {
  background: linear-gradient(135deg, #4ade80 0%, var(--success-600) 100%);
  color: #ffffff;
}

.avatar-warning {
  background: linear-gradient(135deg, #fbbf24 0%, var(--warning-600) 100%);
  color: #ffffff;
}

.avatar-danger {
  background: linear-gradient(135deg, #f87171 0%, var(--danger-600) 100%);
  color: #ffffff;
}

.avatar-purple {
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
  color: #ffffff;
}

.avatar-cyan {
  background: linear-gradient(135deg, #22d3ee 0%, #0891b2 100%);
  color: #ffffff;
}

.list-content {
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-900);
  margin-bottom: 6rpx;
}

.list-desc {
  font-size: 24rpx;
  color: var(--gray-500);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
}

.badge-success {
  background-color: var(--success-100);
  color: var(--success-700);
}

.badge-danger {
  background-color: var(--danger-100);
  color: var(--danger-700);
}

.badge-warning {
  background-color: var(--warning-100);
  color: var(--warning-700);
}

.badge-info {
  background-color: var(--primary-100);
  color: var(--primary-700);
}

.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  background-color: var(--gray-100);
  color: var(--gray-600);
  font-size: 22rpx;
  border-radius: var(--radius-sm);
  margin-right: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--gray-400);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  background-color: #ffffff;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.search-input input {
  flex: 1;
  font-size: 26rpx;
  margin-left: 12rpx;
  color: var(--gray-700);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.6;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.filter-bar::-webkit-scrollbar {
  display: none;
}

.filter-item {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  background-color: #ffffff;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--gray-600);
  display: flex;
  align-items: center;
  border: 2rpx solid var(--gray-200);
  gap: 6rpx;
  transition: all 0.2s ease;
}

.filter-item.active {
  background-color: var(--primary-500);
  color: #ffffff;
  border-color: var(--primary-500);
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.3);
}

.divider {
  height: 2rpx;
  background-color: var(--gray-100);
  margin: 20rpx 0;
}

.text-primary { color: var(--primary-600); }
.text-success { color: var(--success-600); }
.text-danger { color: var(--danger-600); }
.text-warning { color: var(--warning-600); }
.text-muted { color: var(--gray-500); }
.text-light { color: var(--gray-400); }

.text-bold { font-weight: 600; }
.text-semibold { font-weight: 500; }

.text-large { font-size: 36rpx; }
.text-xlarge { font-size: 44rpx; }
.text-2xlarge { font-size: 56rpx; }
.text-small { font-size: 24rpx; }
.text-xs { font-size: 22rpx; }

.flex { display: flex; }
.flex-1 { flex: 1; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-column { display: flex; flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }

.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.gap-24 { gap: 24rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }

.mb-8 { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-24 { margin-bottom: 24rpx; }

.p-16 { padding: 16rpx; }
.p-20 { padding: 20rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.modal-content {
  width: 620rpx;
  background-color: #ffffff;
  border-radius: var(--radius-2xl);
  padding: 40rpx 32rpx 32rpx;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: var(--shadow-xl);
  animation: modalIn 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gray-900);
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-footer .btn {
  flex: 1;
}

.salary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
}

.salary-row:last-child {
  border-bottom: none;
}

.salary-row .label {
  color: var(--gray-600);
  font-size: 26rpx;
}

.salary-row .value {
  color: var(--gray-800);
  font-size: 26rpx;
  font-weight: 500;
}

.salary-row .value.positive {
  color: var(--success-600);
}

.salary-row .value.negative {
  color: var(--danger-600);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900);
}

.section-more {
  font-size: 24rpx;
  color: var(--gray-500);
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.header-card {
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 var(--radius-3xl) var(--radius-3xl);
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.header-card::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-card::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  min-width: calc(50% - 8rpx);
  background-color: #ffffff;
  border-radius: var(--radius-xl);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gray-900);
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--gray-500);
}

.tab-bar-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.skeleton {
  background: linear-gradient(90deg, var(--gray-100) 25%, var(--gray-200) 50%, var(--gray-100) 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: var(--radius-md);
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.divider-v {
  width: 2rpx;
  height: 24rpx;
  background-color: var(--gray-200);
  margin: 0 16rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  transition: all 0.15s ease;
}

.icon-btn:active {
  transform: scale(0.9);
}

.icon-btn-primary {
  background-color: var(--primary-50);
  color: var(--primary-600);
}

.icon-btn-gray {
  background-color: var(--gray-100);
  color: var(--gray-600);
}
