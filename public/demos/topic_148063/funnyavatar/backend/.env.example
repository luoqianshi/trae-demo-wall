# ===== 图像生成 Provider 配置 =====
# local: 前端 SVG 兜底生成（无需任何依赖）
# external: 调用外部图像生成 API（需要配置 IMAGE_API_KEY）
# dcgan-celeba-local: 本地 DCGAN-CelebA 生成（需要 torch + 权重文件）
IMAGE_PROVIDER=local

# 外部图像生成 API 配置（仅 IMAGE_PROVIDER=external 时生效）
# 不配置 Key 时会自动回退到 local
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=

# ===== DCGAN-CelebA 本地生成配置 =====
# 权重文件路径（默认相对项目根目录）
DCGAN_WEIGHTS_PATH=backend/models/dcgan_celeba/dcgan_generator.pth
DCGAN_NZ=100
DCGAN_NGF=64
DCGAN_NC=3
# 运行设备：cpu 或 cuda（配置 cuda 但不可用时会自动回退 cpu）
DCGAN_DEVICE=cpu

# ===== 头像搜索配置 =====
# 是否启用外部开源头像源（关闭时走本地程序化生成降级）
ENABLE_EXTERNAL_SEARCH=true
# 外部源请求超时（秒）
SEARCH_TIMEOUT=8
# 各开源头像源开关（可单独关闭）
SEARCH_ENABLE_DICEBEAR=true
SEARCH_ENABLE_ROBOHASH=true
SEARCH_ENABLE_MULTIAVATAR=true
SEARCH_ENABLE_BORING=true

# ===== 输出与缓存 =====
OUTPUT_DIR=backend/outputs
CACHE_DIR=backend/.cache

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000

# ===== 安全限制 =====
MAX_INPUT_LENGTH=500
GENERATE_TIMEOUT=60
