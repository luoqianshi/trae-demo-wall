{
  "version": "0.3",
  "sheets": {
    "greet": {
      "file": "greet-sheet-6f.png",
      "frames": 6,
      "frame_w": 256,
      "frame_h": 256,
      "fps": 8,
      "loop": false
    },
    "idle": {
      "file": "idle-sheet-4f.png",
      "frames": 4,
      "frame_w": 256,
      "frame_h": 256,
      "fps": 4,
      "loop": true
    },
    "happy": {
      "file": "happy-sheet-6f.png",
      "frames": 6,
      "frame_w": 256,
      "frame_h": 256,
      "fps": 8,
      "loop": false
    },
    "thirsty": {
      "file": "thirsty-sheet-4f.png",
      "frames": 4,
      "frame_w": 256,
      "frame_h": 256,
      "fps": 4,
      "loop": true
    },
    "particles": {
      "file": "particles-sheet-8f.png",
      "frames": 8,
      "frame_w": 256,
      "frame_h": 256,
      "fps": 8,
      "loop": false,
      "consumer_hint": "v0.4: doubles as happy/satisfied variant sprite. See sheets.satisfied alias below."
    },
    "satisfied": {
      "alias_of": "particles",
      "file": "particles-sheet-8f.png",
      "frames": 8,
      "frame_w": 256,
      "frame_h": 256,
      "fps": 4,
      "loop": true,
      "consumer_hint": "happy/satisfied substate reuses particles sheet as full-frame sprite. Play at lower fps (4) to make celebration feel majestic. Loop for the entire >=5s dwell period."
    }
  },
  "environment": {
    "water_cup_bg": {
      "type": "state_driven_background_swap",
      "size": [1280, 720],
      "levels": [
        { "percent": 0,   "file": "bg-desktop-water-000.png" },
        { "percent": 25,  "file": "bg-desktop-water-025.png" },
        { "percent": 50,  "file": "bg-desktop-water-050.png" },
        { "percent": 75,  "file": "bg-desktop-water-075.png" },
        { "percent": 100, "file": "bg-desktop-water-100.png" }
      ],
      "consumer_map_formula": "level_index = min(4, floor(today_total / 1500 * 4))",
      "consumer_hint": "APP subscribes today_total change events, swaps body background-image based on level_index."
    }
  }
}
