# 应用配置
APP_NAME=玉鉴 API
DEBUG=true

# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jade_distinguish

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 存储配置
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# AI 配置
AI_PROVIDER=mock
