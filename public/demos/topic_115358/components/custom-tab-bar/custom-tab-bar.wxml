<view class="tab-bar">
  <!-- 首页 -->
  <view
    class="tab-item {{selected === 0 ? 'active' : 'inactive'}}"
    data-index="0"
    data-path="{{list[0].pagePath}}"
    bindtap="switchTab"
  >
    <icon name="{{list[0].icon}}" color="{{selected === 0 ? selectedColor : color}}" size="22" />
    <text class="tab-text">{{list[0].text}}</text>
  </view>

  <!-- 饭局 -->
  <view
    class="tab-item {{selected === 1 ? 'active' : 'inactive'}}"
    data-index="1"
    data-path="{{list[1].pagePath}}"
    bindtap="switchTab"
  >
    <icon name="{{list[1].icon}}" color="{{selected === 1 ? selectedColor : color}}" size="22" />
    <text class="tab-text">{{list[1].text}}</text>
  </view>

  <!-- 发起 (中心凸起按钮) -->
  <view class="tab-item tab-center" data-index="2" data-is-center="{{true}}" bindtap="switchTab">
    <view class="tab-center-btn">
      <icon name="plus" color="#FFFDF9" size="24" strokeWidth="2.5" />
    </view>
    <text class="tab-text tab-text-center">{{list[2].text}}</text>
  </view>

  <!-- 消息 -->
  <view
    class="tab-item {{selected === 3 ? 'active' : 'inactive'}}"
    data-index="3"
    data-path="{{list[3].pagePath}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <icon name="{{list[3].icon}}" color="{{selected === 3 ? selectedColor : color}}" size="22" />
      <view wx:if="{{list[3].hasBadge}}" class="tab-badge"></view>
    </view>
    <text class="tab-text">{{list[3].text}}</text>
  </view>

  <!-- 我的 -->
  <view
    class="tab-item {{selected === 4 ? 'active' : 'inactive'}}"
    data-index="4"
    data-path="{{list[4].pagePath}}"
    bindtap="switchTab"
  >
    <icon name="{{list[4].icon}}" color="{{selected === 4 ? selectedColor : color}}" size="22" />
    <text class="tab-text">{{list[4].text}}</text>
  </view>
</view>
