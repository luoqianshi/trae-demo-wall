/* ============================================
   app.wxss — 饭合全局样式
   设计令牌 + 通用工具类
   ============================================ */

/* ── CSS 变量 (设计令牌) ── */
page {
  /* Brand Colors */
  --color-primary: #D4845A;
  --color-primary-hover: #C07548;
  --color-primary-active: #A8643E;
  --color-primary-light: #F5EDE3;
  --color-primary-50: #FBF7F2;
  --color-primary-100: #F0E5D5;

  --color-secondary: #7B9E6B;
  --color-secondary-light: #EEF5EB;
  --color-secondary-hover: #6B8C5C;

  --color-accent: #E8C87A;
  --color-accent-light: #FDF6E8;
  --color-accent-hover: #D4B56A;

  /* Background & Surface */
  --color-background: #F5EDE3;
  --color-surface: #FFFDF9;
  --color-surface-elevated: #FFFFFF;
  --color-surface-dim: #F0E8DF;

  /* Text */
  --color-text-primary: #2C2420;
  --color-text-secondary: #6B5D52;
  --color-text-tertiary: #A09589;
  --color-text-inverse: #FFFDF9;
  --color-text-link: #D4845A;

  /* Border */
  --color-border: #EDE5DB;
  --color-border-light: #F5EDE3;

  /* Semantic */
  --state-success: #5A9E6B;
  --state-success-light: #EEF5EB;
  --state-warning: #D4A05A;
  --state-warning-light: #FDF6E8;
  --state-error: #D45A5A;
  --state-error-light: #FBEDED;
  --state-info: #5A8E9E;

  /* Credit */
  --credit-positive: #5A9E6B;
  --credit-positive-bg: #EEF5EB;
  --credit-warning: #D4A05A;
  --credit-warning-bg: #FDF6E8;
  --credit-negative: #D45A5A;
  --credit-negative-bg: #FBEDED;

  /* Radius */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-full: 9999rpx;

  /* Shadows */
  --shadow-xs: 0 1rpx 2rpx rgba(44, 36, 32, 0.04);
  --shadow-sm: 0 1rpx 3rpx rgba(44, 36, 32, 0.06);
  --shadow-md: 0 2rpx 8rpx rgba(44, 36, 32, 0.07);
  --shadow-card: 0 2rpx 12rpx rgba(44, 36, 32, 0.06);
  --shadow-elevated: 0 8rpx 24rpx rgba(44, 36, 32, 0.12);
  --shadow-primary: 0 2rpx 8rpx rgba(212, 132, 90, 0.25);

  /* Transitions */
  --transition-fast: 150ms ease;
  --transition-normal: 250ms ease;
  --transition-slow: 350ms ease;
  --transition-spring: 350ms cubic-bezier(0.34, 1.56, 0.64, 1);

  background: var(--color-background);
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
  color: var(--color-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

/* ── 字体工具类 ── */
.font-serif { font-family: 'Songti SC', 'STSong', 'SimSun', Georgia, serif; }
.font-sans { font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif; }

/* ── 文字颜色 ── */
.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-tertiary { color: var(--color-text-tertiary); }
.text-inverse { color: var(--color-text-inverse); }
.text-brand { color: var(--color-primary); }
.text-olive { color: var(--color-secondary); }
.text-golden { color: var(--color-accent); }
.text-success { color: var(--state-success); }
.text-warning { color: var(--state-warning); }
.text-error { color: var(--state-error); }

/* ── 背景色 ── */
.bg-brand { background: var(--color-primary); }
.bg-brand-light { background: var(--color-primary-light); }
.bg-surface { background: var(--color-surface); }
.bg-surface-dim { background: var(--color-surface-dim); }
.bg-background { background: var(--color-background); }
.bg-olive-light { background: var(--color-secondary-light); }
.bg-golden-light { background: var(--color-accent-light); }

/* ── 阴影 ── */
.shadow-card { box-shadow: var(--shadow-card); }
.shadow-elevated { box-shadow: var(--shadow-elevated); }
.shadow-primary { box-shadow: var(--shadow-primary); }

/* ── 圆角 ── */
.radius-sm { border-radius: var(--radius-sm); }
.radius-md { border-radius: var(--radius-md); }
.radius-lg { border-radius: var(--radius-lg); }
.radius-xl { border-radius: var(--radius-xl); }
.radius-full { border-radius: var(--radius-full); }

/* ── 卡片基础 ── */
.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

/* ── 交互态 ── */
.card-lift {
  transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}
.card-lift:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-elevated);
}

.btn-press {
  transition: transform var(--transition-fast);
}
.btn-press:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.meal-card {
  transition: transform 200ms ease, opacity 200ms ease;
}
.meal-card:active {
  transform: scale(0.98);
  opacity: 0.95;
}

/* ── 按钮样式 ── */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 32rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 32rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--color-accent);
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid var(--color-accent);
}

.btn-card-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
}

.btn-card-disabled {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface-dim);
  color: var(--color-text-tertiary);
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}

/* ── 标签/Pill ── */
.cuisine-pill {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.dish-pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  background: var(--color-surface-dim);
  color: var(--color-text-secondary);
}

.credit-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.credit-tag.positive {
  background: var(--credit-positive-bg);
  color: var(--credit-positive);
}

.credit-tag.warning {
  background: var(--credit-warning-bg);
  color: var(--credit-warning);
}

/* ── 食人格徽章 ── */
.personality-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  border: 3rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
  letter-spacing: 0.04em;
}

.personality-mini {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: 'Songti SC', Georgia, serif;
  font-size: 14rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
}

/* ── 滤镜Pill ── */
.filter-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  border: 3rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  transition: all 200ms ease;
}

.filter-pill.active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border-color: var(--color-primary);
}

/* ── 进度条 ── */
.progress-mini {
  width: 120rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-surface-dim);
  overflow: hidden;
}

.progress-mini-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--color-secondary);
}

/* ── 通知红点 ── */
.notif-dot {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--state-error);
  border: 4rpx solid var(--color-background);
}

/* ── 金色分隔线 ── */
.golden-divider {
  width: 80rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  margin: 0 auto;
}

/* ── 横向滚动隐藏滚动条 ── */
.scroll-x {
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}
.scroll-x::-webkit-scrollbar {
  display: none;
  height: 0;
}

/* ── 页面动画 ── */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideInRight {
  from { opacity: 0; transform: translateX(60rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes goldenBreath {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(232, 200, 122, 0.15); }
  50% { box-shadow: 0 0 0 12rpx rgba(232, 200, 122, 0.08); }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes creditPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.85; }
}

.fade-in { animation: fadeIn 250ms ease forwards; }
.fade-slide-up { animation: fadeSlideUp 350ms ease forwards; }

/* ── 自定义导航栏容器 ── */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 20;
}

.nav-bar .nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 状态徽章 ── */
.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* ── 安全区域 ── */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 底部CTA固定栏 ── */
.bottom-cta {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.bottom-cta .cta-button {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary);
}
