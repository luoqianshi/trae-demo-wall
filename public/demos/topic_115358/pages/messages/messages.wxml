<!-- pages/messages/messages.wxml -->
<view class="page">

  <!-- ════════════════════════════════════════════ -->
  <!-- 顶部栏 (sticky) -->
  <!-- ════════════════════════════════════════════ -->
  <view class="header-sticky">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="top-bar">
      <view class="top-bar-left"></view>
      <text class="top-title font-serif">消息</text>
      <text class="read-all-btn" bindtap="onMarkAllRead">全部已读</text>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 筛选标签栏 -->
  <!-- ════════════════════════════════════════════ -->
  <scroll-view scroll-x class="scroll-x filter-bar">
    <text
      class="msg-filter-pill {{activeFilter === index ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onTapFilter"
    >{{item}}</text>
  </scroll-view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 消息列表 (按 section 分组) -->
  <!-- ════════════════════════════════════════════ -->
  <view class="msg-list">

    <block wx:for="{{groupedNotifications}}" wx:key="section" wx:for-item="group">
      <!-- section 标题 -->
      <text class="section-label">{{group.section}}</text>

      <!-- 通知卡片 -->
      <view class="section-px">
        <view class="notif-gap">
          <view
            class="notif-card card-lift {{item.muted ? 'notif-muted' : ''}}"
            wx:for="{{group.items}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapNotification"
          >
            <!-- 左侧图标 -->
            <view class="notif-icon" style="background:{{item.iconBg}};">
              <icon name="{{item.icon}}" color="{{item.iconColor}}" size="20" />
            </view>

            <!-- 右侧内容 -->
            <view class="notif-content">
              <view class="notif-title-row">
                <text class="notif-title">{{item.title}}</text>
                <view wx:if="{{item.unread}}" class="unread-dot"></view>
              </view>
              <text class="notif-body">{{item.body}}</text>
              <text class="notif-time">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:if="{{groupedNotifications.length === 0}}" class="empty-state">
      <text class="empty-text">暂无消息</text>
    </view>
  </view>

  <!-- 底部占位（给tabBar留空间） -->
  <view style="height:120rpx;"></view>
</view>
