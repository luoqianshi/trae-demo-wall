/* pages/meal-create/meal-create.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ════════════════════════════════════════ */
/* 顶部导航栏 + 步骤指示器                    */
/* ════════════════════════════════════════ */
.nav-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border-light);
}

.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

/* 步骤指示器 */
.step-indicator {
  padding: 0 40rpx 24rpx;
}

.step-track {
  height: 4rpx;
  background: var(--color-border);
  border-radius: 2rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.step-progress {
  height: 100%;
  background: var(--color-primary);
  border-radius: 2rpx;
  transition: width 300ms ease;
}

.step-dots {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-surface-dim);
  color: var(--color-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  border: 2rpx solid var(--color-border);
  transition: all 200ms ease;
}

.step-dot.active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(212, 132, 90, 0.3);
}

.step-dot.done {
  background: var(--color-secondary);
  color: var(--color-text-inverse);
  border-color: var(--color-secondary);
}

.step-check {
  font-size: 22rpx;
  font-weight: 700;
}

.step-labels {
  display: flex;
  justify-content: space-between;
}

.step-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  text-align: center;
  flex: 1;
}

.step-label.active {
  color: var(--color-primary);
  font-weight: 600;
}

/* ════════════════════════════════════════ */
/* 内容区域                                   */
/* ════════════════════════════════════════ */
.content-wrap {
  padding: 32rpx 40rpx 0;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.section {
  margin-top: 36rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 24rpx;
}

/* ════════════════════════════════════════ */
/* Step 1: 选餐厅                             */
/* ════════════════════════════════════════ */

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: var(--color-surface-dim);
  border-radius: var(--radius-full);
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.search-placeholder {
  color: var(--color-text-tertiary);
}

/* 快捷标签 */
.quick-tags {
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.quick-tags-inner {
  display: inline-flex;
  gap: 16rpx;
}

.quick-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.quick-tag-active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

/* 餐厅列表 */
.restaurant-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.restaurant-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  position: relative;
  transition: all 200ms ease;
}

.restaurant-card.selected {
  border: 2rpx solid var(--color-primary);
  background: var(--color-primary-50);
}

.restaurant-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.restaurant-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.restaurant-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.restaurant-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.restaurant-meta-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.restaurant-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.meta-dot {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin: 0 4rpx;
}

.restaurant-price {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.restaurant-rating-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.rating-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.rating-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.selected-check {
  flex-shrink: 0;
}

/* ════════════════════════════════════════ */
/* Step 2: 时间人数                           */
/* ════════════════════════════════════════ */
.form-card {
  padding: 8rpx 32rpx;
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.form-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.form-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.form-divider {
  height: 1rpx;
  background: var(--color-border-light);
}

/* 人数选择 */
.people-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.people-card {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 32rpx 16rpx;
  border-radius: var(--radius-lg);
  gap: 4rpx;
  transition: all 200ms ease;
}

.people-card.selected {
  background: var(--color-primary-50);
  border: 2rpx solid var(--color-primary);
}

.people-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.people-card.selected .people-num {
  color: var(--color-primary);
}

.people-unit {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ════════════════════════════════════════ */
/* Step 3: 预算菜单                           */
/* ════════════════════════════════════════ */
.budget-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 24rpx;
}

.budget-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.budget-slider {
  margin: 0 0 12rpx;
}

.budget-range {
  display: flex;
  justify-content: space-between;
}

.range-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 菜品标签 */
.dish-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dish-tag {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 32rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  transition: all 200ms ease;
}

.dish-tag.selected {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

.dish-count {
  margin-top: 20rpx;
  text-align: right;
}

.dish-count-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ════════════════════════════════════════ */
/* Step 4: 氛围偏好                           */
/* ════════════════════════════════════════ */
.vibe-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vibe-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-lg);
  position: relative;
  transition: all 200ms ease;
}

.vibe-card.selected {
  background: var(--color-primary-50);
  border: 2rpx solid var(--color-primary);
}

.vibe-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.vibe-body {
  flex: 1;
  min-width: 0;
}

.vibe-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.vibe-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.vibe-check {
  flex-shrink: 0;
}

/* ════════════════════════════════════════ */
/* Step 5: 确认发布                           */
/* ════════════════════════════════════════ */
.preview-card {
  padding: 8rpx 32rpx;
}

.preview-section {
  padding: 28rpx 0;
}

.preview-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.preview-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.preview-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.preview-divider {
  height: 1rpx;
  background: var(--color-border-light);
}

.preview-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preview-dish {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  background: var(--color-accent-light);
  color: var(--color-accent-hover);
  font-size: 24rpx;
  font-weight: 500;
}

/* 备注输入 */
.note-input {
  width: 100%;
  height: 180rpx;
  padding: 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  line-height: 1.6;
}

.note-placeholder {
  color: var(--color-text-tertiary);
}

.note-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

/* 协议 */
.agreement {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 36rpx;
  padding: 20rpx 24rpx;
  background: var(--color-surface-dim);
  border-radius: var(--radius-md);
}

.agreement-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ════════════════════════════════════════ */
/* 底部操作栏                                 */
/* ════════════════════════════════════════ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border-light);
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 20;
}

.bottom-prev {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 28rpx;
  height: 88rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface-dim);
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
  flex-shrink: 0;
}

.bottom-prev-placeholder {
  width: 160rpx;
  flex-shrink: 0;
}

.bottom-next {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: var(--shadow-primary);
  line-height: 88rpx;
  padding: 0;
}

.bottom-next::after {
  border: none;
}

.bottom-next.disabled {
  background: var(--color-surface-dim);
  color: var(--color-text-tertiary);
  box-shadow: none;
}
