<!-- pages/meal-create/meal-create.wxml -->
<view class="page">

  <!-- ════════════════════════════════════════════ -->
  <!-- 顶部导航栏 (sticky)                           -->
  <!-- ════════════════════════════════════════════ -->
  <view class="nav-sticky">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="nav-bar">
      <view class="nav-btn btn-press" bindtap="onTapBack">
        <icon name="arrow-left" color="#2C2420" size="22" />
      </view>
      <text class="nav-title font-serif">发起饭局</text>
      <view class="nav-btn btn-press" bindtap="onTapClose">
        <icon name="x" color="#6B5D52" size="20" />
      </view>
    </view>

    <!-- 步骤指示器 -->
    <view class="step-indicator">
      <view class="step-track">
        <view class="step-progress" style="width:{{progress}}%;"></view>
      </view>
      <view class="step-dots">
        <view
          class="step-dot {{index < currentStep ? 'done' : index === currentStep ? 'active' : ''}}"
          wx:for="{{steps}}"
          wx:key="key"
        >
          <text wx:if="{{index < currentStep}}" class="step-check">✓</text>
          <text wx:else class="step-num">{{item.num}}</text>
        </view>
      </view>
      <view class="step-labels">
        <text
          class="step-label {{index <= currentStep ? 'active' : ''}}"
          wx:for="{{steps}}"
          wx:key="key"
        >{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- Step 1: 选餐厅                                -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:if="{{currentStep === 0}}">
    <view class="content-wrap">
      <view class="page-header">
        <text class="page-title font-serif">选一家餐厅</text>
        <text class="page-subtitle">从收藏或推荐中选择，也可以手动搜索</text>
      </view>

      <!-- 搜索框 -->
      <view class="search-bar">
        <icon name="search" color="#A09589" size="18" />
        <input class="search-input" placeholder="搜索餐厅、菜系" placeholder-class="search-placeholder" />
      </view>

      <!-- 快捷标签 -->
      <scroll-view scroll-x class="scroll-x quick-tags">
        <view class="quick-tags-inner">
          <text class="quick-tag quick-tag-active">全部</text>
          <text class="quick-tag">火锅</text>
          <text class="quick-tag">川菜</text>
          <text class="quick-tag">日料</text>
          <text class="quick-tag">烧烤</text>
          <text class="quick-tag">粤菜</text>
        </view>
      </scroll-view>

      <!-- 餐厅列表 -->
      <view class="restaurant-list">
        <view
          class="restaurant-card card card-lift {{restaurantId === item.id ? 'selected' : ''}}"
          wx:for="{{restaurants}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapRestaurant"
        >
          <view class="restaurant-thumb" style="background:{{item.image}};"></view>
          <view class="restaurant-body">
            <view class="restaurant-name-row">
              <text class="restaurant-name">{{item.name}}</text>
              <text class="cuisine-pill">{{item.cuisine}}</text>
            </view>
            <view class="restaurant-meta-row">
              <icon name="map-pin" color="#A09589" size="12" />
              <text class="restaurant-meta">{{item.district}}</text>
              <text class="meta-dot">·</text>
              <text class="restaurant-price">{{item.price}}</text>
            </view>
            <view class="restaurant-rating-row">
              <icon name="star" color="#E8C87A" size="14" />
              <text class="rating-num">{{item.rating}}</text>
              <text class="rating-label">分</text>
            </view>
          </view>
          <view wx:if="{{restaurantId === item.id}}" class="selected-check">
            <icon name="check-circle" color="#D4845A" size="28" />
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ════════════════════════════════════════════ -->
  <!-- Step 2: 时间人数                              -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:elif="{{currentStep === 1}}">
    <view class="content-wrap">
      <view class="page-header">
        <text class="page-title font-serif">什么时候吃？</text>
        <text class="page-subtitle">选择时间和人数，找到合适的同桌</text>
      </view>

      <!-- 日期选择 -->
      <view class="form-card card">
        <view class="form-row">
          <view class="form-label-row">
            <icon name="calendar" color="#D4845A" size="18" />
            <text class="form-label">日期</text>
          </view>
          <picker mode="date" value="{{date}}" bindchange="onDateChange">
            <view class="form-picker">
              <text class="picker-value">{{date}}</text>
              <icon name="chevron-right" color="#A09589" size="16" />
            </view>
          </picker>
        </view>

        <view class="form-divider"></view>

        <!-- 时间选择 -->
        <view class="form-row">
          <view class="form-label-row">
            <icon name="clock" color="#D4845A" size="18" />
            <text class="form-label">时间</text>
          </view>
          <picker mode="time" value="{{time}}" bindchange="onTimeChange">
            <view class="form-picker">
              <text class="picker-value">{{time}}</text>
              <icon name="chevron-right" color="#A09589" size="16" />
            </view>
          </picker>
        </view>
      </view>

      <!-- 人数选择 -->
      <view class="section">
        <text class="section-title font-serif">总人数</text>
        <text class="section-hint">包括你在内，建议 4-6 人最佳</text>

        <view class="people-grid">
          <view
            class="people-card card card-lift {{peopleCount === item ? 'selected' : ''}}"
            wx:for="{{[2, 3, 4, 5, 6, 8]}}"
            wx:key="*this"
            data-count="{{item}}"
            bindtap="onTapPeople"
          >
            <text class="people-num">{{item}}</text>
            <text class="people-unit">人</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ════════════════════════════════════════════ -->
  <!-- Step 3: 预算菜单                              -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:elif="{{currentStep === 2}}">
    <view class="content-wrap">
      <view class="page-header">
        <text class="page-title font-serif">预算 & 菜单</text>
        <text class="page-subtitle">设定人均预算和必点菜品</text>
      </view>

      <!-- 预算滑块 -->
      <view class="form-card card">
        <view class="budget-header">
          <text class="form-label">人均预算</text>
          <text class="budget-value">¥{{budget}}</text>
        </view>
        <slider
          class="budget-slider"
          min="50"
          max="500"
          step="10"
          value="{{budget}}"
          activeColor="#D4845A"
          backgroundColor="#E8DFD5"
          block-size="24"
          bindchange="onBudgetChange"
        />
        <view class="budget-range">
          <text class="range-label">¥50</text>
          <text class="range-label">¥500+</text>
        </view>
      </view>

      <!-- 必点菜品 -->
      <view class="section">
        <text class="section-title font-serif">必点菜品</text>
        <text class="section-hint">选几道你想点的菜，吸引志同道合的人</text>

        <view class="dish-grid">
          <view
            class="dish-tag {{selectedDishes.indexOf(item) >= 0 ? 'selected' : ''}}"
            wx:for="{{dishes}}"
            wx:key="*this"
            data-dish="{{item}}"
            bindtap="onTapDish"
          >{{item}}</view>
        </view>

        <view class="dish-count">
          <text class="dish-count-text">已选 {{selectedDishes.length}} 道</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ════════════════════════════════════════════ -->
  <!-- Step 4: 氛围偏好                              -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:elif="{{currentStep === 3}}">
    <view class="content-wrap">
      <view class="page-header">
        <text class="page-title font-serif">想要什么氛围？</text>
        <text class="page-subtitle">选择你期待的饭局氛围和同桌类型</text>
      </view>

      <!-- 氛围偏好 -->
      <view class="section">
        <text class="section-title font-serif">饭局氛围</text>
        <view class="vibe-list">
          <view
            class="vibe-card card card-lift {{selectedVibe === item.id ? 'selected' : ''}}"
            wx:for="{{vibeOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapVibe"
          >
            <view class="vibe-icon">
              <icon name="{{item.icon}}" color="#D4845A" size="24" />
            </view>
            <view class="vibe-body">
              <text class="vibe-label">{{item.label}}</text>
              <text class="vibe-desc">{{item.desc}}</text>
            </view>
            <view wx:if="{{selectedVibe === item.id}}" class="vibe-check">
              <icon name="check-circle" color="#D4845A" size="24" />
            </view>
          </view>
        </view>
      </view>

      <!-- 同桌偏好 -->
      <view class="section">
        <text class="section-title font-serif">同桌偏好</text>
        <view class="vibe-list">
          <view
            class="vibe-card card card-lift {{selectedDinerType === item.id ? 'selected' : ''}}"
            wx:for="{{dinerOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapDinerType"
          >
            <view class="vibe-icon">
              <icon name="{{item.icon}}" color="#7B9E6B" size="24" />
            </view>
            <view class="vibe-body">
              <text class="vibe-label">{{item.label}}</text>
              <text class="vibe-desc">{{item.desc}}</text>
            </view>
            <view wx:if="{{selectedDinerType === item.id}}" class="vibe-check">
              <icon name="check-circle" color="#D4845A" size="24" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ════════════════════════════════════════════ -->
  <!-- Step 5: 确认发布                              -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:else>
    <view class="content-wrap">
      <view class="page-header">
        <text class="page-title font-serif">确认发布</text>
        <text class="page-subtitle">检查一下信息，没问题就发布吧</text>
      </view>

      <!-- 预览卡片 -->
      <view class="preview-card card">
        <!-- 餐厅信息 -->
        <view class="preview-section">
          <view class="preview-label-row">
            <icon name="map-pin" color="#D4845A" size="16" />
            <text class="preview-label">餐厅</text>
          </view>
          <text class="preview-value">{{restaurantName || '未选择'}}</text>
        </view>

        <view class="preview-divider"></view>

        <!-- 时间 -->
        <view class="preview-section">
          <view class="preview-label-row">
            <icon name="calendar" color="#D4845A" size="16" />
            <text class="preview-label">时间</text>
          </view>
          <text class="preview-value">{{date}} {{time}}</text>
        </view>

        <view class="preview-divider"></view>

        <!-- 人数 -->
        <view class="preview-section">
          <view class="preview-label-row">
            <icon name="users" color="#D4845A" size="16" />
            <text class="preview-label">人数</text>
          </view>
          <text class="preview-value">{{peopleCount}} 人（含你）</text>
        </view>

        <view class="preview-divider"></view>

        <!-- 预算 -->
        <view class="preview-section">
          <view class="preview-label-row">
            <icon name="ticket" color="#D4845A" size="16" />
            <text class="preview-label">预算</text>
          </view>
          <text class="preview-value">人均 ¥{{budget}}</text>
        </view>

        <view class="preview-divider"></view>

        <!-- 必点菜品 -->
        <view class="preview-section">
          <view class="preview-label-row">
            <icon name="utensils" color="#D4845A" size="16" />
            <text class="preview-label">必点菜品</text>
          </view>
          <view class="preview-dishes">
            <text class="preview-dish" wx:for="{{selectedDishes}}" wx:key="*this">{{item}}</text>
          </view>
        </view>

        <view class="preview-divider"></view>

        <!-- 氛围 -->
        <view class="preview-section">
          <view class="preview-label-row">
            <icon name="star" color="#E8C87A" size="16" />
            <text class="preview-label">氛围</text>
          </view>
          <text class="preview-value">
            {{selectedVibe === 'chat' ? '轻松聊天' : selectedVibe === 'foodie' ? '美食专注' : selectedVibe === 'quiet' ? '安静氛围' : '热闹氛围'}}
            ·
            {{selectedDinerType === 'same' ? '相似食人格' : selectedDinerType === 'complement' ? '互补食人格' : '随缘'}}
          </text>
        </view>
      </view>

      <!-- 备注 -->
      <view class="section">
        <text class="section-title font-serif">给同桌的话（选填）</text>
        <textarea
          class="note-input"
          placeholder="想说的话，比如今天心情、忌口等等..."
          placeholder-class="note-placeholder"
          value="{{note}}"
          bindinput="onNoteInput"
          maxlength="200"
        />
        <text class="note-count">{{note.length}}/200</text>
      </view>

      <!-- 协议提示 -->
      <view class="agreement">
        <icon name="info" color="#A09589" size="14" />
        <text class="agreement-text">发布即表示同意《饭合饭局公约》，请认真对待每一次同桌</text>
      </view>
    </view>
  </block>

  <!-- 底部占位 -->
  <view style="height:200rpx;"></view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 底部操作栏                                    -->
  <!-- ════════════════════════════════════════════ -->
  <view class="bottom-bar">
    <view wx:if="{{currentStep > 0}}" class="bottom-prev btn-press" bindtap="onTapPrev">
      <icon name="arrow-left" color="#6B5D52" size="18" />
      <text>上一步</text>
    </view>
    <view wx:else class="bottom-prev-placeholder"></view>

    <button
      class="bottom-next btn-press {{canNext ? '' : 'disabled'}}"
      bindtap="onTapNext"
      disabled="{{!canNext}}"
    >
      <text>{{currentStep === 4 ? '确认发布' : '下一步'}}</text>
      <icon wx:if="{{currentStep < 4}}" name="arrow-right" color="#FFFDF9" size="18" />
    </button>
  </view>

</view>
