/* pages/home/home.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
}

/* ── 顶部栏 ── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx 16rpx;
}

.city-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.city-name {
  font-weight: 700;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.bell-wrap {
  position: relative;
}

/* ── 通用Section间距 ── */
.section-px { padding-left: 40rpx; padding-right: 40rpx; }
.section-mb { margin-bottom: 40rpx; }
.section-mb-lg { margin-bottom: 64rpx; }

.section-header-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.section-more {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* ════════════════════════════════════════ */
/* 状态A: 游客                               */
/* ════════════════════════════════════════ */

/* 英雄区 */
.hero-section {
  padding: 48rpx 40rpx 64rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
}
.deco-1 {
  top: 20rpx; left: 40rpx;
  width: 80rpx; height: 80rpx;
  background: var(--color-accent);
  opacity: 0.08;
}
.deco-2 {
  top: 60rpx; right: 60rpx;
  width: 120rpx; height: 120rpx;
  background: var(--color-secondary);
  opacity: 0.06;
}
.deco-3 {
  bottom: 40rpx; left: 50%;
  width: 60rpx; height: 60rpx;
  background: var(--color-primary);
  opacity: 0.05;
}

.mascot-circle {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.mascot-inner {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  box-shadow: 0 8rpx 40rpx rgba(232, 200, 122, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  font-style: italic;
  font-size: 32rpx;
  color: var(--color-text-secondary);
  margin-bottom: 40rpx;
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

/* 产品概念卡片 */
.concept-card {
  padding: 40rpx;
}

.concept-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.concept-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.concept-body {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.75;
  margin-bottom: 32rpx;
}

.feature-pills {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.feature-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 600;
}

.feature-pill-golden {
  background: var(--color-accent-light);
  color: var(--color-accent-hover);
}

.feature-pill-olive {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.feature-pill-terracotta {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* CTA卡片 */
.cta-card {
  border-radius: var(--radius-xl);
  padding: 56rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(44, 36, 32, 0.08);
  position: relative;
  overflow: hidden;
}

.cta-deco-1 {
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: var(--color-accent);
  opacity: 0.08;
}

.cta-deco-2 {
  position: absolute;
  bottom: -40rpx; left: -40rpx;
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.06;
}

.cta-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.cta-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-accent);
  background: var(--color-accent-light);
  opacity: 0.5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.cta-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 48rpx;
  position: relative;
  z-index: 1;
}

.cta-btn {
  width: 480rpx;
  height: 96rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(212, 132, 90, 0.35);
  position: relative;
  z-index: 1;
}

.cta-helper {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

/* 模糊饭局预览 */
.preview-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 16rpx;
}

.preview-subtitle {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 32rpx;
}

.blurred-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  filter: blur(6rpx);
  opacity: 0.5;
}

.blurred-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  height: 200rpx;
  align-items: center;
}

.blurred-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  background: var(--color-border);
  flex-shrink: 0;
}

.blurred-content {
  flex: 1;
}

.blurred-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--color-border);
  margin-bottom: 16rpx;
}
.blurred-line-w70 { width: 70%; }
.blurred-line-w50 { width: 50%; }
.blurred-line-w60 { width: 60%; }

.lock-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
}

.lock-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: var(--shadow-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 社交证明 */
.social-proof {
  text-align: center;
  padding: 48rpx 40rpx;
}

.avatar-stack {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}

.avatar-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-background);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  margin-left: -16rpx;
}

.avatar-circle:first-child {
  margin-left: 0;
}

.avatar-more {
  background: var(--color-surface-dim);
  color: var(--color-text-tertiary);
  font-size: 18rpx;
  font-weight: 600;
}

.social-proof-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ════════════════════════════════════════ */
/* 状态B: 已测未入席                          */
/* ════════════════════════════════════════ */

.personality-card {
  padding: 24rpx 32rpx;
}

.personality-card-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.personality-info {
  flex: 1;
  min-width: 0;
}

.personality-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.personality-dims {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.browse-mode-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--color-surface-dim);
  color: var(--color-text-tertiary);
  white-space: nowrap;
}

/* 入席码CTA卡片 */
.invite-code-card {
  border-radius: var(--radius-xl);
  padding: 56rpx 48rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--color-accent-light), var(--color-primary-50));
  border: 3rpx solid var(--color-accent);
  position: relative;
  overflow: hidden;
  animation: goldenBreath 3s ease-in-out infinite;
}

.invite-card-deco-1 {
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: var(--color-accent);
  opacity: 0.1;
}

.invite-card-deco-2 {
  position: absolute;
  bottom: -40rpx; left: -40rpx;
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.06;
}

.invite-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.invite-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-accent);
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.invite-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.invite-btn {
  width: 320rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
  position: relative;
  z-index: 1;
}

/* 餐厅图鉴 */
.restaurant-guide-card {
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  margin-right: 24rpx;
}

.guide-thumb {
  width: 240rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
}

.guide-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.guide-tag {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ════════════════════════════════════════ */
/* 状态C: 已入席                              */
/* ════════════════════════════════════════ */

.personality-mini-card {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 24rpx;
}

.quick-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* 今日推荐 */
.rec-scroll {
  padding: 0 40rpx;
  white-space: nowrap;
}

.rec-card {
  display: inline-block;
  width: 560rpx;
  margin-right: 32rpx;
  vertical-align: top;
  overflow: hidden;
}

.rec-card-img {
  width: 100%;
  height: 350rpx;
}

.rec-card-body {
  padding: 24rpx;
}

.rec-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.rec-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.rec-meta-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.rec-meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.rec-meta-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.rec-info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meal-remaining {
  font-size: 26rpx;
  font-weight: 700;
}

.meal-budget {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.dish-pills {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.rec-initiator-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.rec-initiator-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

/* 我的饭局 */
.upcoming-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border-light);
  align-items: center;
}

.upcoming-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.upcoming-content {
  flex: 1;
  min-width: 0;
}

.upcoming-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.upcoming-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.upcoming-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.upcoming-seats {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 饭局列表 */
.meal-list-gap {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.meal-list-item {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border-light);
}

.meal-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}

.meal-list-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.meal-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.meal-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.meal-info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
