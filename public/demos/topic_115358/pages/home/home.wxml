<!-- pages/home/home.wxml -->
<view class="page">

  <!-- ── 状态栏占位 ── -->
  <view style="height:{{statusBarHeight}}px;"></view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 1. 顶部栏：城市选择 + 通知铃铛                  -->
  <!-- ════════════════════════════════════════════ -->
  <view class="top-bar">
    <view class="city-selector" bindtap="onTapCity">
      <icon name="map-pin" color="#D4845A" size="16" />
      <text class="city-name">{{city}}</text>
      <icon name="chevron-down" color="#6B5D52" size="14" />
    </view>
    <view class="bell-wrap" bindtap="onTapNotification">
      <icon name="bell" color="#6B5D52" size="22" />
      <view class="notif-dot" style="top:0;right:0;"></view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 状态 A: 游客 (未测试食人格)                    -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:if="{{userState === 'guest'}}">

    <!-- 欢迎英雄区 -->
    <view class="hero-section">
      <!-- 装饰SVG元素 -->
      <view class="deco deco-1"></view>
      <view class="deco deco-2"></view>
      <view class="deco deco-3"></view>

      <!-- 吉祥物 -->
      <view class="mascot-circle">
        <view class="mascot-inner">
          <icon name="bowl" color="#D4845A" size="48" />
        </view>
      </view>

      <text class="hero-title font-serif">欢迎来到饭合</text>
      <text class="hero-subtitle font-serif">认真吃饭的人，终会找到同桌</text>
      <view class="golden-divider"></view>
    </view>

    <!-- 产品概念卡片 -->
    <view class="section-px">
      <view class="card card-lift concept-card">
        <view class="concept-header">
          <icon name="info" color="#D4845A" size="16" />
          <text class="concept-title">饭合是什么？</text>
        </view>
        <text class="concept-body">为独自出差、旅行、探店的人，匹配高质量拼桌对象。一起点更多的菜，吃到一桌好饭。</text>
        <view class="feature-pills">
          <text class="feature-pill feature-pill-golden">食人格匹配</text>
          <text class="feature-pill feature-pill-olive">入席码筛选</text>
          <text class="feature-pill feature-pill-terracotta">信用保障</text>
        </view>
      </view>
    </view>

    <!-- 食人格测试CTA卡片 -->
    <view class="section-px section-mb-lg">
      <view class="cta-card card-lift">
        <!-- 装饰圆 -->
        <view class="cta-deco-1"></view>
        <view class="cta-deco-2"></view>

        <!-- 装饰图标 -->
        <view class="cta-icon-wrap">
          <view class="cta-icon-circle">
            <icon name="flame" color="#D4845A" size="24" />
          </view>
        </view>

        <text class="cta-title font-serif">测测你的食人格</text>
        <text class="cta-desc">12 道美食场景题，60 秒完成，获取你的专属吃饭人格</text>

        <button class="cta-btn btn-press" bindtap="onStartTest">开始测试</button>

        <text class="cta-helper">完成测试后即可浏览饭局</text>
      </view>
    </view>

    <!-- 模糊饭局预览 -->
    <view class="section-px section-mb-lg">
      <text class="preview-title font-serif">发现身边的饭局</text>
      <text class="preview-subtitle">完成食人格测试后解锁</text>

      <view class="blurred-cards">
        <view class="blurred-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="blurred-thumb"></view>
          <view class="blurred-content">
            <view class="blurred-line blurred-line-w70"></view>
            <view class="blurred-line blurred-line-w50"></view>
            <view class="blurred-line blurred-line-w60"></view>
          </view>
        </view>
      </view>

      <!-- 锁定遮罩 -->
      <view class="lock-overlay">
        <view class="lock-circle">
          <icon name="lock" color="#D4845A" size="28" />
        </view>
      </view>
    </view>

    <!-- 社交证明 -->
    <view class="social-proof">
      <view class="avatar-stack">
        <view class="avatar-circle" style="background:#D4845A;">食</view>
        <view class="avatar-circle" style="background:#7B9E6B;">合</view>
        <view class="avatar-circle" style="background:#E8C87A;">饭</view>
        <view class="avatar-circle avatar-more">+99</view>
      </view>
      <text class="social-proof-text">已有 1,200+ 认真吃饭的人完成测试</text>
    </view>
  </block>

  <!-- ════════════════════════════════════════════ -->
  <!-- 状态 B: 已测食人格，未入席                     -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:elif="{{userState === 'tested'}}">

    <!-- 食人格卡片（浏览模式） -->
    <view class="section-px section-mb">
      <view class="card card-lift personality-card" bindtap="onTapPersonality">
        <view class="personality-card-row">
          <view class="personality-badge">{{userInfo.personality}}</view>
          <view class="personality-info">
            <text class="personality-name font-serif">{{userInfo.personalityName}}</text>
            <text class="personality-dims">{{personalityInfo.dims[0]}} · {{personalityInfo.dims[1]}} · {{personalityInfo.dims[2]}} · {{personalityInfo.dims[3]}}</text>
          </view>
          <view class="browse-mode-badge">浏览模式</view>
        </view>
      </view>
    </view>

    <!-- 入席码CTA卡片（金色呼吸动画） -->
    <view class="section-px section-mb-lg">
      <view class="invite-code-card" bindtap="onTapInviteCode">
        <view class="invite-card-deco-1"></view>
        <view class="invite-card-deco-2"></view>

        <view class="invite-icon-wrap">
          <view class="invite-icon-circle">
            <icon name="ticket" color="#E8C87A" size="28" />
          </view>
        </view>

        <text class="invite-title font-serif">输入入席码</text>
        <text class="invite-desc">向已入席的好友索取入席码，解锁完整饭合体验</text>

        <button class="invite-btn btn-press" bindtap="onTapInviteCode">去输入</button>
      </view>
    </view>

    <!-- 附近饭局（按钮禁用） -->
    <view class="section-px section-mb-lg">
      <view class="section-header-row">
        <text class="section-title font-serif">附近饭局</text>
        <text class="section-more" bindtap="onTapSeeAllRecommend">更多 ></text>
      </view>

      <view class="meal-list-gap">
        <view class="meal-list-item meal-card" wx:for="{{recommendations}}" wx:key="id" data-id="{{item.id}}">
          <view class="meal-thumb" style="background:{{item.image}};"></view>
          <view class="meal-list-content">
            <view class="meal-name-row">
              <text class="meal-name">{{item.name}}</text>
              <text class="cuisine-pill">{{item.cuisine}}</text>
            </view>
            <text class="meal-meta">{{item.date}} · {{item.district}}</text>
            <view class="meal-info-row">
              <text class="meal-remaining text-brand">还差 {{item.seats.remaining}} 人</text>
              <text class="meal-budget">人均 ¥{{item.budget}}</text>
            </view>
            <view class="btn-card-disabled">输入入席码后可申请</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 餐厅图鉴 -->
    <view class="section-mb-lg">
      <view class="section-px">
        <text class="section-title font-serif">餐厅图鉴</text>
      </view>
      <scroll-view scroll-x class="scroll-x section-px" style="padding-top:24rpx;">
        <view class="restaurant-guide-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="guide-thumb" style="background:linear-gradient(135deg, #F0E8DF, #EDE5DB);"></view>
          <text class="guide-name">餐厅{{item}}</text>
          <text class="guide-tag">{{item === 1 ? '川菜' : item === 2 ? '粤菜' : item === 3 ? '日料' : '烧烤'}}</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- ════════════════════════════════════════════ -->
  <!-- 状态 C: 已入席                                -->
  <!-- ════════════════════════════════════════════ -->
  <block wx:else>

    <!-- 食人格迷你卡片 -->
    <view class="section-px section-mb">
      <view class="card card-lift personality-mini-card" bindtap="onTapPersonality">
        <view class="personality-badge">{{userInfo.personality}}</view>
        <view class="personality-info">
          <text class="personality-name font-serif">{{userInfo.personalityName}}</text>
          <text class="personality-dims">{{personalityInfo.dims[0]}} / {{personalityInfo.dims[1]}} / {{personalityInfo.dims[2]}} / {{personalityInfo.dims[3]}}</text>
        </view>
        <icon name="chevron-right" color="#A09589" size="16" />
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="section-px section-mb">
      <view class="quick-actions">
        <button class="btn-primary btn-press quick-btn" bindtap="onTapCreateMeal">
          <icon name="plus" color="#FFFDF9" size="16" strokeWidth="2.5" />
          <text>发起饭局</text>
        </button>
        <button class="btn-secondary btn-press quick-btn" bindtap="onTapInviteCode">
          <icon name="lock" color="#E8C87A" size="15" />
          <text>输入入席码</text>
        </button>
      </view>
    </view>

    <!-- 今日推荐 -->
    <view class="section-mb">
      <view class="section-header-row section-px">
        <view class="section-title-wrap">
          <text class="section-title font-serif">今日推荐</text>
          <text class="section-subtitle">为你匹配</text>
        </view>
        <text class="section-more" bindtap="onTapSeeAllRecommend">更多 ></text>
      </view>

      <scroll-view scroll-x class="scroll-x rec-scroll">
        <view class="rec-card card-lift" wx:for="{{recommendations}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapMealCard">
          <view class="rec-card-img" style="background:{{item.image}};"></view>
          <view class="rec-card-body">
            <view class="rec-name-row">
              <text class="rec-name">{{item.name}}</text>
              <text class="cuisine-pill">{{item.cuisine}}</text>
            </view>
            <view class="rec-meta-row">
              <view class="rec-meta-item">
                <icon name="clock" color="#6B5D52" size="12" />
                <text class="rec-meta-text">{{item.date}}</text>
              </view>
              <view class="rec-meta-item">
                <icon name="map-pin" color="#6B5D52" size="12" />
                <text class="rec-meta-text">{{item.district}}</text>
              </view>
            </view>
            <view class="rec-info-row">
              <text class="meal-remaining text-brand">还差 {{item.seats.remaining}} 人</text>
              <text class="meal-budget">人均 ¥{{item.budget}}</text>
            </view>
            <view class="dish-pills">
              <text class="dish-pill" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="*this">{{dish}}</text>
            </view>
            <view class="rec-initiator-row">
              <view class="personality-mini">{{item.initiator.personality}}</view>
              <text class="rec-initiator-name font-serif">{{item.initiator.personalityName}}</text>
              <text class="credit-tag positive" style="margin-left:auto;">{{item.initiator.creditTags[0].text}}</text>
            </view>
            <button class="btn-card-primary btn-press" catchtap="onTapApply" data-id="{{item.id}}">申请入席</button>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 我的饭局 -->
    <view class="section-px section-mb" wx:if="{{myMeal}}">
      <view class="section-header-row">
        <text class="section-title font-serif">我的饭局</text>
        <text class="section-more" bindtap="onTapSeeAllMeals">查看全部 ></text>
      </view>

      <view class="upcoming-card card-lift" bindtap="onTapUpcomingMeal">
        <view class="upcoming-thumb" style="background:{{myMeal.image}};"></view>
        <view class="upcoming-content">
          <text class="upcoming-name">{{myMeal.name}}</text>
          <text class="upcoming-meta">{{myMeal.date}} · {{myMeal.location}}</text>
          <view class="upcoming-progress-row">
            <text class="upcoming-seats">{{myMeal.seats.filled}}/{{myMeal.seats.total}}人已入席</text>
            <view class="progress-mini">
              <view class="progress-mini-fill" style="width:{{myMeal.seats.filled / myMeal.seats.total * 100}}%;"></view>
            </view>
          </view>
        </view>
        <view class="status-badge" style="background:#EEF5EB;color:#5A9E6B;">即将开始</view>
      </view>
    </view>

    <!-- 城市热门 -->
    <view class="section-mb-lg">
      <view class="section-px">
        <text class="section-title font-serif">{{city}}热门</text>
      </view>

      <!-- 筛选pills -->
      <scroll-view scroll-x class="scroll-x" style="padding:24rpx 40rpx;">
        <text
          class="filter-pill {{activeFilter === index ? 'active' : ''}}"
          wx:for="{{filterPills}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onTapFilter"
        >{{item}}</text>
      </scroll-view>

      <!-- 饭局列表 -->
      <view class="section-px meal-list-gap">
        <view
          class="meal-list-item meal-card"
          wx:for="{{hotMeals}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapMealCard"
        >
          <view class="meal-thumb" style="background:{{item.image}};"></view>
          <view class="meal-list-content">
            <view class="meal-name-row">
              <text class="meal-name">{{item.name}}</text>
              <text class="cuisine-pill">{{item.cuisine}}</text>
            </view>
            <text class="meal-meta">{{item.date}} · {{item.district}}</text>
            <view class="meal-info-row">
              <text class="meal-remaining text-brand">还差 {{item.seats.remaining}} 人</text>
              <text class="meal-budget">人均 ¥{{item.budget}}</text>
              <text class="credit-tag positive" style="margin-left:auto;">{{item.initiator.creditTags[0].text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部占位（给tabBar留空间） -->
  <view style="height:120rpx;"></view>
</view>
