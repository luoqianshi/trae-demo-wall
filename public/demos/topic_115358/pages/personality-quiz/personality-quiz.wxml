<!-- pages/personality-quiz/personality-quiz.wxml -->
<view class="page">

  <!-- ════════════════════════════════════════════ -->
  <!-- 顶部进度条区域 (sticky)                         -->
  <!-- ════════════════════════════════════════════ -->
  <view class="quiz-sticky">
    <!-- 状态栏占位 -->
    <view style="height:{{statusBarHeight}}px;"></view>

    <!-- 跳过 / 题号 -->
    <view class="header-row">
      <text class="skip-btn" bindtap="onSkip">跳过</text>
      <text class="q-counter">Q{{currentNumber}} / {{totalQuestions}}</text>
    </view>

    <!-- 进度条 -->
    <view class="progress-track">
      <view class="progress-fill" style="width:{{progress}}%;"></view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 问题卡区域                                     -->
  <!-- ════════════════════════════════════════════ -->
  <view class="question-card">
    <!-- 装饰食物图标 (碗+筷子+蒸汽) -->
    <view class="deco-icons">
      <icon name="bowl" color="#D4845A" size="64" />
      <icon name="chopsticks" color="#D4845A" size="48" />
      <icon name="flame" color="#E8C87A" size="40" />
    </view>

    <text class="question-label">Question {{currentNumber}}</text>
    <text class="question-text font-serif">{{currentQuestion.question}}</text>

    <!-- 答案选项 -->
    <view class="options-wrap">
      <view
        class="option-card {{selectedOption === 'A' ? 'selected' : ''}}"
        bindtap="onSelectOption"
        data-label="A">
        <view class="option-badge">{{currentQuestion.options[0].label}}</view>
        <text class="option-text">{{currentQuestion.options[0].text}}</text>
      </view>

      <view class="or-divider">
        <text class="or-text">或者</text>
      </view>

      <view
        class="option-card {{selectedOption === 'B' ? 'selected' : ''}}"
        bindtap="onSelectOption"
        data-label="B">
        <view class="option-badge">{{currentQuestion.options[1].label}}</view>
        <text class="option-text">{{currentQuestion.options[1].text}}</text>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 维度指示器                                     -->
  <!-- ════════════════════════════════════════════ -->
  <view class="dim-indicator">
    <text class="dim-label">正在测试：{{currentQuestion.dimensionLabel}}</text>
    <view class="dim-groups">
      <view class="dim-group" wx:for="{{dimensionGroups}}" wx:key="dimension" wx:for-item="group">
        <view
          class="dim-dot {{dot.lit ? 'lit' : ''}}"
          wx:for="{{group.dots}}"
          wx:for-item="dot"
          wx:key="key"></view>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 生成中预览区域                                 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="gen-preview">
    <text class="gen-label">完成后</text>
    <view class="gen-card">
      <view class="spinner"></view>
      <text class="gen-text">正在识别你的吃饭人格...</text>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 上一题预览                                     -->
  <!-- ════════════════════════════════════════════ -->
  <view class="prev-preview" wx:if="{{prevQuestionText}}">
    <view class="prev-divider"></view>
    <text class="prev-text">上一题：{{prevQuestionText}}</text>
  </view>

  <view style="height:80rpx;"></view>
</view>
