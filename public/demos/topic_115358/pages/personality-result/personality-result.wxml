<!-- pages/personality-result/personality-result.wxml -->
<view class="page" wx:if="{{detail}}">

  <!-- ════════════════════════════════════════════ -->
  <!-- 导航栏 (sticky)                                -->
  <!-- ════════════════════════════════════════════ -->
  <view class="nav-sticky">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="result-nav">
      <view class="nav-btn" bindtap="onBack">
        <icon name="arrow-left" color="#2C2420" size="22" />
      </view>
      <text class="nav-title font-serif">我的食人格</text>
      <view class="nav-btn" bindtap="onShare">
        <icon name="share" color="#D4845A" size="20" />
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 食人格英雄卡片                                  -->
  <!-- ════════════════════════════════════════════ -->
  <view class="hero-card">
    <view class="hero-deco-1"></view>
    <view class="hero-deco-2"></view>

    <!-- 吉祥物图标 -->
    <view class="mascot-circle">
      <icon name="flame" color="#D4845A" size="40" />
    </view>

    <text class="personality-code">{{detail.code}}</text>
    <text class="personality-name font-serif">{{detail.name}}</text>

    <view class="golden-divider"></view>

    <text class="tagline font-serif">{{detail.tagline}}</text>

    <!-- 2x2 维度徽章 -->
    <view class="dim-grid">
      <view class="dim-badge {{item.color}}" wx:for="{{detail.dims}}" wx:key="letter">
        <text class="dim-letter">{{item.letter}}</text>
        <text class="dim-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 人格解读                                        -->
  <!-- ════════════════════════════════════════════ -->
  <view class="card section-card">
    <text class="card-title font-serif">人格解读</text>
    <text class="desc-text">
      <text wx:for="{{descSegments}}" wx:key="idx" class="{{item.highlight ? 'kw' : ''}}">{{item.text}}</text>
    </text>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 点菜风格                                        -->
  <!-- ════════════════════════════════════════════ -->
  <view class="card section-card">
    <text class="card-title font-serif">点菜风格</text>
    <text class="desc-text">{{detail.diningStyle}}</text>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 适合的餐厅                                      -->
  <!-- ════════════════════════════════════════════ -->
  <view class="card section-card">
    <text class="card-title font-serif">适合的餐厅</text>
    <view class="restaurant-pills">
      <text class="restaurant-pill" wx:for="{{detail.suitableRestaurants}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 推荐拼桌食人格                                  -->
  <!-- ════════════════════════════════════════════ -->
  <view class="card section-card">
    <text class="card-title font-serif">推荐拼桌食人格</text>
    <view class="match-list">
      <view class="match-card {{item.color}}" wx:for="{{detail.matches}}" wx:key="code">
        <view class="match-badge">{{item.code}}</view>
        <view class="match-info">
          <text class="match-name font-serif">{{item.name}}</text>
          <text class="match-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 雷区提醒                                        -->
  <!-- ════════════════════════════════════════════ -->
  <view class="card section-card">
    <view class="card-title-row">
      <icon name="alert-triangle" color="#D4A05A" size="18" />
      <text class="card-title font-serif">雷区提醒</text>
    </view>
    <view class="warning-list">
      <view class="warning-item" wx:for="{{detail.warnings}}" wx:key="*this">
        <view class="warning-dot"></view>
        <text class="warning-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 经典引用                                        -->
  <!-- ════════════════════════════════════════════ -->
  <view class="quote-section">
    <text class="quote-mark">"</text>
    <text class="quote-text font-serif">{{detail.quote}}</text>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 分享卡片预览                                    -->
  <!-- ════════════════════════════════════════════ -->
  <view class="share-preview-wrap">
    <text class="preview-label">分享卡片预览</text>
    <view class="share-preview-card">
      <view class="sp-mascot">
        <icon name="flame" color="#D4845A" size="24" />
      </view>
      <text class="sp-code">{{detail.code}}</text>
      <text class="sp-name font-serif">{{detail.name}}</text>
      <text class="sp-tagline font-serif">{{detail.tagline}}</text>
      <view class="sp-brand">
        <icon name="bowl" color="#D4845A" size="14" />
        <text class="sp-brand-text">饭合 · 认真吃饭的人，终会找到同桌</text>
      </view>
    </view>
  </view>

  <!-- 底部固定栏占位 -->
  <view style="height:180rpx;"></view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 底部固定操作栏                                  -->
  <!-- ════════════════════════════════════════════ -->
  <view class="bottom-bar">
    <view class="bottom-bar-inner">
      <view class="action-btn action-primary btn-press" bindtap="onShare">
        <icon name="share" color="#FFFDF9" size="16" />
        <text>分享给好友</text>
      </view>
      <view class="action-btn action-outline btn-press" bindtap="onGoHome">
        <text>返回首页</text>
      </view>
    </view>
  </view>
</view>
