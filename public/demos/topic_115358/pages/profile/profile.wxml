<!-- pages/profile/profile.wxml -->
<view class="page">

  <!-- ════════════════════════════════════════════ -->
  <!-- 个人信息头部（渐变背景） -->
  <!-- ════════════════════════════════════════════ -->
  <view class="header-section">
    <!-- 状态栏占位 -->
    <view style="height:{{statusBarHeight}}px;"></view>

    <view class="header-content">
      <!-- 头像 -->
      <view class="avatar-wrap">
        <view class="avatar-inner">
          <icon name="user" color="#D4845A" size="48" />
        </view>
      </view>

      <!-- 姓名 + 食人格 badge -->
      <view class="name-row">
        <text class="user-name font-serif">{{user.name}}</text>
        <view class="personality-pill font-serif">{{user.personality}} {{user.personalityName}}</view>
      </view>

      <!-- 用户ID -->
      <text class="user-handle">{{user.handle}}</text>

      <!-- 编辑资料按钮 -->
      <view class="edit-btn btn-press" bindtap="onEditProfile">
        <icon name="edit" color="#D4B56A" size="14" />
        <text>编辑资料</text>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 数据统计行 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section-px section-mb">
    <view class="stats-card card">
      <view class="stats-row">
        <block wx:for="{{statsList}}" wx:key="label">
          <view class="stat-col">
            <text class="stat-num">{{item.value}}</text>
            <text class="stat-label">{{item.label}}</text>
          </view>
          <view wx:if="{{index < statsList.length - 1}}" class="stat-divider"></view>
        </block>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 信用评分卡片 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section-px section-mb">
    <view class="credit-card card">
      <!-- 标题行 -->
      <view class="credit-header">
        <text class="credit-title font-serif">我的信用</text>
        <view class="credit-level-pill">{{user.credit.level}}</view>
      </view>

      <!-- 4列指标网格 -->
      <view class="metrics-grid">
        <view class="metric-item" wx:for="{{creditMetrics}}" wx:key="label">
          <view class="progress-ring {{item.isScore ? 'ring-score' : ''}}" style="{{item.style}}">
            <text class="ring-value {{item.isScore ? 'ring-value-score' : ''}}">{{item.value}}</text>
          </view>
          <text class="metric-label">{{item.label}}</text>
        </view>
      </view>

      <!-- 信用标签行 -->
      <view class="credit-tags-row">
        <text class="credit-tag positive" wx:for="{{creditTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 入席名额卡片 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section-px section-mb">
    <view class="quota-card card">
      <text class="quota-title font-serif">入席名额</text>

      <!-- 圆点指示器 -->
      <view class="quota-dots">
        <view class="quota-dot {{item.filled ? 'dot-filled' : 'dot-empty'}}" wx:for="{{quotaDots}}" wx:key="*this"></view>
      </view>

      <text class="quota-text">本月剩余 {{user.inviteQuota.remaining}} / {{user.inviteQuota.total}} 个</text>

      <button class="invite-friend-btn btn-press" bindtap="onInviteFriend">邀请好友</button>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 菜单列表 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section-px section-mb">
    <view class="menu-card card">
      <view
        class="menu-item"
        wx:for="{{menuList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTapMenu"
      >
        <view class="menu-icon-circle" style="background:{{item.iconBg}};">
          <icon name="{{item.icon}}" color="{{item.iconColor}}" size="18" />
        </view>
        <text class="menu-label">{{item.label}}</text>
        <icon name="chevron-right" color="#A09589" size="16" />
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-wrap" bindtap="onLogout">
    <text class="logout-text">退出登录</text>
  </view>

  <!-- 底部占位（给tabBar留空间） -->
  <view style="height:120rpx;"></view>
</view>
