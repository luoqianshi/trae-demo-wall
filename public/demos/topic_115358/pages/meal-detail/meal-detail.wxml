<!-- pages/meal-detail/meal-detail.wxml -->
<view class="page" wx:if="{{meal}}">

  <!-- ════════════════════════════════════════════ -->
  <!-- 1. 自定义导航栏                                  -->
  <!-- ════════════════════════════════════════════ -->
  <view class="nav-bar-wrap">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="nav-bar">
      <view class="nav-btn btn-press" bindtap="onTapBack">
        <icon name="arrow-left" color="#2C2420" size="22" />
      </view>
      <text class="nav-title font-serif">饭局详情</text>
      <view class="nav-btn btn-press" bindtap="onTapShare">
        <icon name="share" color="#2C2420" size="20" />
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 2. Hero 图区域                                   -->
  <!-- ════════════════════════════════════════════ -->
  <view class="hero" style="background:{{meal.image}};">
    <view class="hero-mask"></view>
    <view class="hero-bottom">
      <text class="hero-name font-serif">{{meal.name}}</text>
      <view class="hero-cuisine-badge">{{meal.cuisine}}</view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 3. 信息栏：4列                                   -->
  <!-- ════════════════════════════════════════════ -->
  <view class="info-bar card">
    <view class="info-item">
      <view class="info-icon-wrap">
        <icon name="star" color="#E8C87A" size="16" />
      </view>
      <text class="info-value">{{meal.rating}}</text>
      <text class="info-label">评分</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-item">
      <view class="info-icon-wrap">
        <icon name="map-pin" color="#D4845A" size="16" />
      </view>
      <text class="info-value">{{meal.distance}}</text>
      <text class="info-label">距离</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-item">
      <view class="info-icon-wrap">
        <icon name="utensils" color="#7B9E6B" size="16" />
      </view>
      <text class="info-value">¥{{meal.budget}}</text>
      <text class="info-label">人均</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-item">
      <view class="info-icon-wrap">
        <icon name="flame" color="#D4A05A" size="16" />
      </view>
      <text class="info-value">{{meal.historyCount}}</text>
      <text class="info-label">历史</text>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 4. 本桌菜单                                      -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section">
    <view class="section-header">
      <text class="section-title font-serif">本桌菜单</text>
      <view class="golden-divider" style="margin:12rpx 0 0;"></view>
    </view>
    <view class="dish-list">
      <text class="dish-pill dish-pill-lg" wx:for="{{meal.dishes}}" wx:for-item="dish" wx:key="*this">{{dish}}</text>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 5. 入席信息卡片                                   -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section">
    <view class="card seat-card">
      <view class="seat-grid">
        <view class="seat-cell">
          <view class="seat-cell-icon">
            <icon name="clock" color="#D4845A" size="18" />
          </view>
          <view class="seat-cell-body">
            <text class="seat-cell-label">时间</text>
            <text class="seat-cell-value">{{meal.dateLabel}}</text>
          </view>
        </view>
        <view class="seat-cell">
          <view class="seat-cell-icon">
            <icon name="map-pin" color="#D4845A" size="18" />
          </view>
          <view class="seat-cell-body">
            <text class="seat-cell-label">地点</text>
            <text class="seat-cell-value">{{meal.location}}</text>
          </view>
        </view>
        <view class="seat-cell">
          <view class="seat-cell-icon">
            <icon name="user" color="#D4845A" size="18" />
          </view>
          <view class="seat-cell-body">
            <text class="seat-cell-label">人数</text>
            <view class="seat-progress-row">
              <text class="seat-cell-value">{{meal.seats.filled}}/{{meal.seats.total}}人</text>
              <view class="progress-mini" style="width:80rpx;">
                <view class="progress-mini-fill" style="width:{{seatPercent}}%;"></view>
              </view>
            </view>
          </view>
        </view>
        <view class="seat-cell">
          <view class="seat-cell-icon">
            <icon name="ticket" color="#D4845A" size="18" />
          </view>
          <view class="seat-cell-body">
            <text class="seat-cell-label">预算</text>
            <text class="seat-cell-value">人均 ¥{{meal.budget}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 6. 发起人卡片                                     -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section">
    <view class="card initiator-card">
      <view class="initiator-header">
        <view class="initiator-avatar">
          <icon name="user" color="#D4845A" size="24" />
        </view>
        <view class="initiator-info">
          <text class="initiator-name font-serif">{{meal.initiator.name}}</text>
          <view class="initiator-personality">
            <view class="personality-mini">{{meal.initiator.personality}}</view>
            <text class="initiator-personality-name">{{meal.initiator.personalityName}}</text>
          </view>
        </view>
        <view class="initiator-match">
          <text class="match-score">{{meal.matchScore}}%</text>
          <text class="match-label">匹配</text>
        </view>
      </view>

      <!-- 信用标签 -->
      <view class="initiator-tags">
        <text class="credit-tag positive" wx:for="{{meal.initiator.creditTags}}" wx:for-item="tag" wx:key="text">{{tag.text}}</text>
      </view>

      <!-- 食人格描述 mini 卡 -->
      <view class="personality-desc-card" wx:if="{{personalityInfo}}">
        <view class="desc-header">
          <icon name="info" color="#E8C87A" size="14" />
          <text class="desc-title">食人格 · {{personalityInfo.name}}</text>
        </view>
        <text class="desc-body">{{personalityInfo.tagline}}</text>
      </view>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 底部占位（给CTA栏留空间）                          -->
  <!-- ════════════════════════════════════════════ -->
  <view style="height:200rpx;"></view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 7. 底部固定CTA栏                                  -->
  <!-- ════════════════════════════════════════════ -->
  <view class="bottom-cta">
    <button class="cta-button btn-press" bindtap="onTapApply">申请入席</button>
    <text class="cta-hint">发起人确认后即可入席</text>
  </view>
</view>
