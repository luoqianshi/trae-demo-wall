/* pages/invite-code/invite-code.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
}

/* ── 导航栏 ── */
.nav-bar-custom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border-light);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-right {
  width: 64rpx;
  height: 64rpx;
}

/* ── Hero 区域 ── */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx 48rpx;
  text-align: center;
}

.hero-ring {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-accent-light), var(--color-primary-50));
  box-shadow: 0 8rpx 32rpx rgba(232, 200, 122, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.hero-tagline {
  font-size: 28rpx;
  font-style: italic;
  color: var(--color-text-tertiary);
}

/* ── 输入区域 ── */
.input-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx 48rpx;
}

.code-input {
  width: 560rpx;
  height: 112rpx;
  background: var(--color-surface-dim);
  border-radius: var(--radius-lg);
  border: 3rpx solid transparent;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 8rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.code-input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 8rpx rgba(232, 200, 122, 0.15);
  background: var(--color-surface);
}

.code-placeholder {
  color: var(--color-text-tertiary);
  font-weight: 600;
  letter-spacing: 8rpx;
}

/* 验证按钮 */
.verify-btn {
  width: 400rpx;
  height: 88rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  box-shadow: var(--shadow-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 88rpx;
  padding: 0;
}

.verify-btn::after {
  border: none;
}

.verify-btn-disabled {
  background: var(--color-surface-dim);
  color: var(--color-text-tertiary);
  box-shadow: none;
}

/* 帮助文字 */
.help-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-top: 32rpx;
}

.help-main {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.help-link {
  font-size: 26rpx;
  color: var(--color-primary);
  text-decoration: underline;
  font-weight: 600;
}

/* ── 通用间距 ── */
.section-px { padding-left: 40rpx; padding-right: 40rpx; }
.section-mb { margin-bottom: 48rpx; }

/* ── 信息卡片 ── */
.info-card {
  padding: 36rpx 32rpx;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.info-body {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.keyword {
  color: var(--color-primary);
  font-weight: 700;
}

/* ── 成功状态预览 ── */
.success-preview {
  opacity: 0.7;
}

.success-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.success-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 3rpx dashed var(--color-border);
  text-align: center;
}

.success-check {
  margin-bottom: 20rpx;
}

.success-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--state-success);
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}
