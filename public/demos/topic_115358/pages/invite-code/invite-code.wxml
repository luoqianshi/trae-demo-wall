<!-- pages/invite-code/invite-code.wxml -->
<view class="page">

  <!-- ── 状态栏占位 ── -->
  <view style="height:{{statusBarHeight}}px;"></view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 导航栏 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="nav-bar-custom" style="height:{{navBarHeight}}px;">
    <view class="nav-back btn-press" bindtap="onBack">
      <icon name="arrow-left" color="#2C2420" size="22" />
    </view>
    <text class="nav-title font-serif">入席</text>
    <view class="nav-right"></view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- Hero 区域 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="hero-section">
    <view class="hero-ring">
      <icon name="ticket" color="#E8C87A" size="32" />
    </view>
    <text class="hero-title font-serif">输入入席码</text>
    <text class="hero-subtitle font-serif">输入好友分享的入席码</text>
    <text class="hero-tagline font-serif">解锁完整饭合体验</text>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 入席码输入框 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="input-section">
    <input
      class="code-input"
      type="text"
      value="{{code}}"
      placeholder="XXXX-XXXX"
      placeholder-class="code-placeholder"
      bindinput="onInputCode"
      maxlength="9"
      confirm-type="done"
    />

    <!-- 验证按钮 -->
    <button
      class="verify-btn btn-press {{canVerify ? '' : 'verify-btn-disabled'}}"
      bindtap="onVerify"
      disabled="{{!canVerify}}"
    >验证入席</button>

    <!-- 帮助文字 -->
    <view class="help-text">
      <text class="help-main">还没有入席码？向已入席的好友索取</text>
      <text class="help-link" bindtap="onLearnMore">了解入席码</text>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 信息卡片 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section-px">
    <view class="info-card card">
      <view class="info-header">
        <icon name="info" color="#7B9E6B" size="18" />
        <text class="info-title font-serif">什么是入席码？</text>
      </view>
      <text class="info-body">入席码是饭合的邀请机制，每位已入席的用户每月拥有<text class="keyword">每月 3 个名额</text>。入席码与你的<text class="keyword">信用关联</text>，确保平台聚集的都是<text class="keyword">认真的吃饭人</text>。</text>
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 成功状态预览 -->
  <!-- ════════════════════════════════════════════ -->
  <view class="section-px section-mb">
    <view class="success-preview">
      <view class="success-label">验证成功后</view>
      <view class="success-card">
        <view class="success-check">
          <icon name="check-circle" color="#5A9E6B" size="40" />
        </view>
        <text class="success-title font-serif">验证成功</text>
        <text class="success-desc">你已正式入席，可以申请加入饭局了</text>
      </view>
    </view>
  </view>

</view>
