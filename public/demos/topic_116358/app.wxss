page {
  background-color: #fbf9f5;
  color: #1b1c1a;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 0 24rpx;
  padding-bottom: 120rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-top: 40rpx;
  margin-bottom: 16rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #727970;
  margin-bottom: 32rpx;
  font-style: italic;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 24rpx;
  margin-top: 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
}

.card-soft {
  background: #f5f3ef;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: #416743;
  color: #ffffff;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary {
  background: #ffffff;
  color: #416743;
  border: 2rpx solid #416743;
  border-radius: 40rpx;
  padding: 22rpx 46rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-outline {
  background: transparent;
  color: #6b4e3d;
  border: 2rpx solid rgba(107, 78, 61, 0.2);
  border-radius: 40rpx;
  padding: 22rpx 46rpx;
  text-align: center;
  font-size: 28rpx;
}

.fab {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #416743;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(65, 103, 67, 0.25);
  z-index: 100;
}

.fab-identify {
  position: fixed;
  bottom: 140rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #416743;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 8rpx 32rpx rgba(65, 103, 67, 0.3);
  z-index: 100;
}

.text-primary {
  color: #416743;
}

.text-secondary {
  color: #727970;
}

.text-success {
  color: #416743;
}

.text-warning {
  color: #7d562d;
}

.text-danger {
  color: #9a442d;
}

.text-muted {
  color: #727970;
  font-size: 24rpx;
}

.bg-primary {
  background: #416743;
}

.bg-secondary {
  background: #f5f3ef;
}

.bg-card {
  background: #ffffff;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.align-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.text-center {
  text-align: center;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mt-48 {
  margin-top: 48rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mb-32 {
  margin-bottom: 32rpx;
}

.mb-48 {
  margin-bottom: 48rpx;
}

.p-24 {
  padding: 24rpx;
}

.p-32 {
  padding: 32rpx;
}

.font-bold {
  font-weight: 600;
}

.font-light {
  font-weight: 300;
}

.rounded-sm {
  border-radius: 8rpx;
}

.rounded-md {
  border-radius: 16rpx;
}

.rounded-lg {
  border-radius: 24rpx;
}

.rounded-full {
  border-radius: 9999rpx;
}

.divider {
  height: 1rpx;
  background: rgba(107, 78, 61, 0.1);
  margin: 24rpx 0;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.tag-success {
  background: rgba(65, 103, 67, 0.1);
  color: #416743;
}

.tag-warning {
  background: rgba(125, 86, 45, 0.1);
  color: #7d562d;
}

.tag-danger {
  background: rgba(154, 68, 45, 0.1);
  color: #9a442d;
}

.tag-info {
  background: rgba(107, 78, 61, 0.08);
  color: #6b4e3d;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(107, 78, 61, 0.08);
}

.list-item:last-child {
  border-bottom: none;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f3ef;
}

.plant-img {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  background: #f5f3ef;
}

.quote {
  font-style: italic;
  color: #6b4e3d;
  font-size: 26rpx;
  line-height: 1.8;
  padding: 24rpx;
  background: rgba(107, 78, 61, 0.05);
  border-left: 4rpx solid #7da67d;
  border-radius: 0 8rpx 8rpx 0;
  margin: 24rpx 0;
}
