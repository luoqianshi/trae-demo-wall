.header {
  padding-top: 20rpx;
}

.greeting {
  font-size: 26rpx;
  color: #727970;
  margin-bottom: 8rpx;
}

.care-cards {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
}

.care-card {
  flex: 1;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.water-card {
  background: rgba(125, 166, 125, 0.1);
}

.sun-card {
  background: rgba(255, 224, 189, 0.5);
}

.care-icon {
  font-size: 40rpx;
}

.care-content {
  display: flex;
  flex-direction: column;
}

.care-label {
  font-size: 24rpx;
  color: #727970;
  margin-bottom: 4rpx;
}

.care-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #416743;
}

.sun-card .care-value {
  color: #7d562d;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin: 0;
}

.section-more {
  font-size: 26rpx;
  color: #727970;
}

.plant-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plant-row-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
}

.plant-row-img {
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.plant-img {
  width: 100%;
  height: 100%;
  background: #f5f3ef;
}

.plant-row-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.plant-row-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.plant-row-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1a;
}

.plant-row-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-healthy {
  background: rgba(65, 103, 67, 0.1);
  color: #416743;
}

.status-thirsty {
  background: rgba(154, 68, 45, 0.1);
  color: #9a442d;
}

.plant-row-desc {
  font-size: 24rpx;
  color: #727970;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.plant-row-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.plant-row-days {
  font-size: 22rpx;
  color: #727970;
}

.water-btn {
  background: #416743;
  color: #ffffff;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
}

.view-growth-btn {
  color: #416743;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}

.growth-banner {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  height: 320rpx;
  margin-top: 48rpx;
  margin-bottom: 48rpx;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #416743 0%, #7da67d 100%);
  opacity: 0.9;
}

.banner-content {
  position: relative;
  z-index: 1;
  padding: 40rpx 36rpx;
  color: #ffffff;
}

.banner-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.banner-desc {
  font-size: 24rpx;
  opacity: 0.8;
  line-height: 1.6;
}

.banner-camera {
  position: absolute;
  right: 36rpx;
  bottom: 36rpx;
  z-index: 1;
  font-size: 40rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}