<view class="container">
  <view class="header">
    <view class="menu-icon"><text>☰</text></view>
    <view class="header-title">植物百科</view>
    <view class="search-icon"><text>🔍</text></view>
  </view>

  <view class="quote-section">
    <text class="quote-text">"草木有本心，何求美人折。"</text>
  </view>

  <view class="search-bar" bindtap="searchPlant">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索你好奇的植物...</text>
  </view>

  <view class="section-title">分类浏览</view>

  <view class="category-row">
    <view
      class="category-item"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="selectCategory"
    >
      <view class="category-icon"><text>{{item.icon}}</text></view>
      <view class="category-name">{{item.name}}</view>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">今日荐植</text>
  </view>

  <view class="featured-card" bindtap="goToPlantDetail" data-id="featured">
    <view class="featured-image-wrap">
      <image src="{{featuredPlant.image}}" mode="aspectFill" class="featured-image"></image>
    </view>
    <view class="featured-info">
      <view class="featured-name">{{featuredPlant.name}}</view>
      <view class="featured-subtitle">{{featuredPlant.subtitle}}</view>
    </view>
    <view class="featured-arrow">→</view>
  </view>

  <view class="section-header">
    <text class="section-title">热门词条</text>
    <text class="section-more" bindtap="viewMore">全部 ›</text>
  </view>

  <view class="plant-grid">
    <view
      class="plant-card"
      wx:for="{{popularPlants}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goToPlantDetail"
    >
      <view class="plant-image-wrap">
        <image src="{{item.image}}" mode="aspectFill" class="plant-image"></image>
      </view>
      <view class="plant-info">
        <view class="plant-name">{{item.name}}</view>
        <view class="plant-name-en">{{item.nameEn}}</view>
      </view>
    </view>
  </view>
</view>
