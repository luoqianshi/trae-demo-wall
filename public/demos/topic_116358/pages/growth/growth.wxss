.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  margin-bottom: 16rpx;
}

.menu-icon,
.search-icon {
  font-size: 36rpx;
  color: #1b1c1a;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #416743;
}

.quote-section {
  margin-bottom: 16rpx;
}

.quote-text {
  font-size: 24rpx;
  color: #727970;
  font-style: italic;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 32rpx;
  line-height: 1.4;
}

.plant-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  margin-bottom: 48rpx;
}

.plant-avatar {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.plant-avatar .avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f5f3ef;
}

.growth-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #7da67d;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.plant-info {
  flex: 1;
}

.plant-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b1c1a;
  margin-bottom: 8rpx;
}

.plant-days {
  font-size: 24rpx;
  color: #727970;
}

.plant-add {
  font-size: 36rpx;
  color: #727970;
  width: 60rpx;
  text-align: center;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
  margin-bottom: 48rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 48rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -32rpx;
  top: 16rpx;
  bottom: -32rpx;
  width: 2rpx;
  background: rgba(125, 166, 125, 0.3);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #7da67d;
  border: 4rpx solid #fbf9f5;
}

.timeline-dot.type-repot {
  background: #9a442d;
}

.timeline-dot.type-water {
  background: #7d562d;
}

.timeline-content {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.timeline-date {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b1c1a;
}

.timeline-weather {
  font-size: 24rpx;
  color: #727970;
}

.timeline-image-wrap {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.timeline-image {
  width: 100%;
  height: 100%;
  background: #f5f3ef;
}

.timeline-text {
  font-size: 26rpx;
  color: #424941;
  line-height: 1.8;
}

.generate-btn {
  background: #416743;
  color: #ffffff;
  border-radius: 40rpx;
  padding: 28rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.generate-tip {
  text-align: center;
  font-size: 24rpx;
  color: #727970;
  margin-bottom: 48rpx;
}
