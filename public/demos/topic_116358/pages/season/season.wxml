<view class="container">
  <view class="header">
    <view class="page-title">时节</view>
    <view class="page-subtitle">"草木知春不久归，百般红紫斗芳菲。"</view>
  </view>

  <view class="solar-tip">
    <view class="tip-icon"><text>🌱</text></view>
    <view class="tip-text">{{todayTip}}</view>
  </view>

  <view class="calendar-card">
    <view class="calendar-header">
      <view class="month-nav" bindtap="prevMonth">
        <text>‹</text>
      </view>
      <view class="month-title">{{currentMonth}}</view>
      <view class="month-nav" bindtap="nextMonth">
        <text>›</text>
      </view>
    </view>

    <view class="week-header">
      <view class="week-day" wx:for="{{weekHeader}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="calendar-body">
      <view class="week-row" wx:for="{{weeks}}" wx:for-item="week" wx:key="index">
        <view
          class="day-cell {{item.isToday ? 'today' : ''}} {{item.isWater ? 'has-water' : ''}} {{item.isSolarTerm ? 'solar-term' : ''}} {{item.isEmpty ? 'empty' : ''}}"
          wx:for="{{week}}"
          wx:for-item="item"
          wx:key="day"
        >
          <text class="day-text">{{item.day}}</text>
          <view class="day-dot" wx:if="{{item.isWater && !item.isEmpty}}"></view>
          <view class="solar-term-label" wx:if="{{item.isSolarTerm && !item.isEmpty}}">
            <text>{{item.solarTermName}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="calendar-legend">
      <view class="legend-item">
        <view class="legend-dot legend-water"></view>
        <text class="legend-text">灌溉</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot legend-solar"></view>
        <text class="legend-text">节气</text>
      </view>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">今日侍弄</text>
    <text class="section-count">{{todayTasks.length}}项待办</text>
  </view>

  <view class="task-list">
    <view class="task-item" wx:for="{{todayTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleTask">
      <view class="task-icon icon-{{item.type}}">
        <text wx:if="{{item.type === 'water'}}">💧</text>
        <text wx:elif="{{item.type === 'sun'}}">☀️</text>
        <text wx:elif="{{item.type === 'fertilize'}}">🌱</text>
      </view>
      <view class="task-info">
        <view class="task-title {{item.completed ? 'completed' : ''}}">{{item.title}}</view>
        <view class="task-desc">{{item.desc}}</view>
      </view>
      <view class="task-checkbox {{item.completed ? 'checked' : ''}}">
        <text wx:if="{{item.completed}}">✓</text>
      </view>
    </view>
  </view>

  <view class="growth-entry" bindtap="goToGrowth">
    <view class="entry-bg"></view>
    <view class="entry-content">
      <view class="entry-label">本周成长</view>
      <view class="entry-title">新芽悄然萌发</view>
    </view>
    <view class="entry-camera"><text>📷</text></view>
  </view>
</view>

<view class="fab" bindtap="addRecord">
  <text>➕</text>
</view>
