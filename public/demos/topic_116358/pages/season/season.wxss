.header {
  padding-top: 20rpx;
  margin-bottom: 24rpx;
}

.solar-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(125, 166, 125, 0.1);
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  margin-bottom: 32rpx;
  align-self: flex-start;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #294f2d;
}

.calendar-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  margin-bottom: 24rpx;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f3ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #6b4e3d;
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1a;
}

.week-header {
  display: flex;
  margin-bottom: 16rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #727970;
  padding: 12rpx 0;
}

.calendar-body {
  margin-bottom: 24rpx;
}

.week-row {
  display: flex;
  margin-bottom: 8rpx;
}

.day-cell {
  flex: 1;
  height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-cell.empty {
  opacity: 0;
}

.day-text {
  font-size: 26rpx;
  color: #1b1c1a;
}

.day-cell.today .day-text {
  color: #ffffff;
  font-weight: 600;
}

.day-cell.today {
  background: #416743;
  border-radius: 50%;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #7da67d;
  margin-top: 4rpx;
}

.day-cell.today .day-dot {
  background: #ffffff;
}

.day-cell.solar-term {
  position: relative;
}

.solar-term-label {
  position: absolute;
  bottom: 2rpx;
  font-size: 18rpx;
  color: #9a442d;
  white-space: nowrap;
}

.calendar-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(107, 78, 61, 0.08);
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.legend-water {
  background: #7da67d;
}

.legend-solar {
  background: #9a442d;
}

.legend-text {
  font-size: 22rpx;
  color: #727970;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 48rpx;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin: 0;
}

.section-count {
  font-size: 24rpx;
  color: #727970;
}

.task-list {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  overflow: hidden;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(107, 78, 61, 0.06);
}

.task-item:last-child {
  border-bottom: none;
}

.task-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-water {
  background: rgba(33, 150, 243, 0.1);
}

.icon-sun {
  background: rgba(255, 193, 7, 0.15);
}

.icon-fertilize {
  background: rgba(154, 68, 45, 0.1);
}

.task-info {
  flex: 1;
}

.task-title {
  font-size: 28rpx;
  color: #1b1c1a;
  margin-bottom: 6rpx;
}

.task-title.completed {
  text-decoration: line-through;
  color: #727970;
}

.task-desc {
  font-size: 24rpx;
  color: #727970;
}

.task-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #c2c8be;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.task-checkbox.checked {
  background: #416743;
  border-color: #416743;
  color: #ffffff;
  font-size: 24rpx;
}

.growth-entry {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  height: 200rpx;
  margin-top: 48rpx;
  margin-bottom: 48rpx;
}

.entry-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #416743 0%, #7da67d 100%);
  opacity: 0.9;
}

.entry-content {
  position: relative;
  z-index: 1;
  padding: 36rpx 32rpx;
  color: #ffffff;
}

.entry-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
}

.entry-camera {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  z-index: 1;
  font-size: 36rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}
