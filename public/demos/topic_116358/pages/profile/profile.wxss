.profile-header {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
  padding-bottom: 40rpx;
}

.settings-icon {
  position: absolute;
  top: 24rpx;
  right: 0;
  font-size: 40rpx;
}

.avatar-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

.avatar-btn {
  position: relative;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 180rpx;
  height: 180rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  background: #f5f3ef;
}

.avatar-edit-hint {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #416743;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border: 4rpx solid #ffffff;
}

.nickname-wrap {
  margin-bottom: 12rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 600;
  color: #1b1c1a;
  text-align: center;
  width: 360rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.nickname-input.placeholder {
  color: #727970;
  font-weight: 400;
}

.signature {
  font-size: 26rpx;
  color: #6b4e3d;
  font-style: italic;
}

.stats-card {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #727970;
}

.menu-list {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(107, 78, 61, 0.06);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #1b1c1a;
}

.menu-badge {
  background: #9a442d;
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.menu-link {
  font-size: 24rpx;
  color: #416743;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #727970;
}

.badges-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  margin-bottom: 48rpx;
}

.badges-row {
  display: flex;
  gap: 24rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(107, 78, 61, 0.06);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  flex-shrink: 0;
}

.badge-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.badge-name {
  font-size: 22rpx;
  color: #6b4e3d;
  white-space: nowrap;
}

.switch-account {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  color: #727970;
  margin-bottom: 48rpx;
}

.switch-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.switch-text {
  font-size: 26rpx;
}
