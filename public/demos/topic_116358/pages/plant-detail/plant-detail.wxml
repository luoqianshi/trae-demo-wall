<view class="container" wx:if="{{plant}}">
  <view class="plant-image-section">
    <image src="{{plant.image}}" mode="aspectFill" class="plant-image"></image>
    <view class="collect-btn" bindtap="collectPlant">
      <text>☆</text>
    </view>
  </view>

  <view class="plant-info">
    <view class="plant-header">
      <view class="plant-name">{{plant.name}}</view>
      <view class="plant-name-en">{{plant.nameEn}}</view>
    </view>

    <view class="plant-tags">
      <view class="tag" wx:for="{{plant.tags}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="info-row">
      <view class="info-label">科属</view>
      <view class="info-value">{{plant.family}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">原产地</view>
      <view class="info-value">{{plant.origin}}</view>
    </view>

    <view class="section">
      <view class="section-title">植物简介</view>
      <view class="section-text">{{plant.description}}</view>
    </view>

    <view class="section">
      <view class="section-title">养护指南</view>
      <view class="care-list">
        <view class="care-item">
          <view class="care-icon"><text>💧</text></view>
          <view class="care-content">
            <view class="care-label">浇水</view>
            <view class="care-text">{{plant.care.water}}</view>
          </view>
        </view>
        <view class="care-item">
          <view class="care-icon"><text>☀️</text></view>
          <view class="care-content">
            <view class="care-label">光照</view>
            <view class="care-text">{{plant.care.light}}</view>
          </view>
        </view>
        <view class="care-item">
          <view class="care-icon"><text>🌱</text></view>
          <view class="care-content">
            <view class="care-label">土壤</view>
            <view class="care-text">{{plant.care.soil}}</view>
          </view>
        </view>
        <view class="care-item">
          <view class="care-icon"><text>🌡️</text></view>
          <view class="care-content">
            <view class="care-label">温度</view>
            <view class="care-text">{{plant.care.temperature}}</view>
          </view>
        </view>
        <view class="care-item">
          <view class="care-icon"><text>💨</text></view>
          <view class="care-content">
            <view class="care-label">湿度</view>
            <view class="care-text">{{plant.care.humidity}}</view>
          </view>
        </view>
        <view class="care-item">
          <view class="care-icon"><text>🧪</text></view>
          <view class="care-content">
            <view class="care-label">施肥</view>
            <view class="care-text">{{plant.care.fertilizer}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">繁殖方式</view>
      <view class="section-text">{{plant.propagation}}</view>
    </view>

    <view class="section warning-section">
      <view class="section-title">⚠️ 注意事项</view>
      <view class="section-text">{{plant.warning}}</view>
    </view>

    <view class="action-buttons">
      <view class="btn-primary" bindtap="collectPlant">
        <text>☆ 收藏词条</text>
      </view>
      <view class="btn-secondary" bindtap="sharePlant">
        <text>分享</text>
      </view>
    </view>
  </view>
</view>