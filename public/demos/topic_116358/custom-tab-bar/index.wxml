<view class="tab-bar">
  <view 
    class="tab-bar-item" 
    wx:for="{{list}}" 
    wx:key="index"
    data-path="{{item.pagePath}}" 
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap {{selected === index ? 'tab-icon-wrap-active' : ''}}">
      <text 
        class="tab-icon {{selected === index ? 'tab-icon-active' : ''}}"
      >{{item.icon}}</text>
    </view>
    <text class="tab-text {{selected === index ? 'tab-text-active' : ''}}">{{item.text}}</text>
  </view>
</view>
