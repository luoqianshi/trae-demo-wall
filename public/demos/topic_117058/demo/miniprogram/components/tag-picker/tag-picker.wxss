.tag-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-choice {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #FFF0F5;
  border: 2rpx solid #F8BBD0;
  box-shadow: 0 4rpx 14rpx rgba(244, 143, 177, 0.12);
  box-sizing: border-box;
}

.tag-choice-text {
  color: #E91E63;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 500;
}

.tag-choice-active {
  background: linear-gradient(135deg, #F48FB1, #E91E63);
  border-color: transparent;
  box-shadow: 0 8rpx 22rpx rgba(233, 30, 99, 0.24);
}

.tag-choice-active .tag-choice-text {
  color: #fff;
}

.tag-choice-danger {
  background: #FFEBEE;
  border-color: #EF9A9A;
}

.tag-choice-danger .tag-choice-text {
  color: #C62828;
}

.tag-choice-danger.tag-choice-active {
  background: linear-gradient(135deg, #FF8A80, #FF5252);
  border-color: transparent;
}

.tag-choice-danger.tag-choice-active .tag-choice-text {
  color: #fff;
}
