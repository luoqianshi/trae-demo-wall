<view class="chat-container">
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">
      <text>{{matchUser.nickname}}</text>
      <view class="nav-online">在线</view>
    </view>
    <view class="nav-more" bindtap="showMore">⋯</view>
  </view>

  <view class="safety-bar" wx:if="{{!safetyCodeSet}}">
    <text>🔐 建议先设置安全暗号，保障见面安全</text>
    <text class="safety-btn" bindtap="setSafetyCode">去设置</text>
  </view>

  <view class="expire-bar {{isExpired ? 'expired' : ''}}">
    <text>{{isExpired ? '⏳ 一日限定已结束，聊天已关闭' : '⏳ ' + expireText}}</text>
  </view>

  <view class="date-order-bar" wx:if="{{dateOrder}}">
    <view class="date-order-main">
      <text class="date-order-title">{{dateOrder.packageName}} · ¥{{dateOrder.price}}</text>
      <text class="date-order-status">{{dateOrder.status}}</text>
    </view>
    <text class="date-order-sub">对方到账 ¥{{dateOrder.providerAmount}} · 平台推广费 20% ¥{{dateOrder.platformFee}}</text>
  </view>

  <view class="date-start-bar" wx:else>
    <view>
      <text class="date-start-title">至少先互相匹配后，才可以发起 date 邀请</text>
      <text class="date-start-sub">一日 date ¥69 起 · 对方到账80% · 平台推广费20%</text>
    </view>
    <button class="date-start-btn" bindtap="openDateInviteModal">发起 date</button>
  </view>

  <view class="boundary-bar" wx:if="{{matchUser.cannotDo.length}}">
    <text class="boundary-icon">🚫</text>
    <scroll-view scroll-x class="boundary-tags">
      <text wx:for="{{matchUser.cannotDo}}" wx:key="*this">{{item}}</text>
    </scroll-view>
  </view>

  <scroll-view class="message-list" scroll-y scroll-into-view="{{scrollToView}}">
    <view class="message-item {{item.isSelf ? 'self' : 'other'}}" wx:for="{{messages}}" wx:key="messageId" id="msg-{{index}}">
      <view class="message-bubble"><text>{{item.content}}</text></view>
      <text class="message-time">{{item.timeText}}</text>
    </view>
  </scroll-view>

  <view class="expired-chat-tip" wx:if="{{isExpired}}">一日限定已结束，无法继续发送消息</view>
  <view class="chat-footer" wx:else>
    <view class="input-area">
      <input class="chat-input" placeholder="输入消息..." placeholder-class="input-placeholder" value="{{inputValue}}" bindinput="onInput" confirm-type="send" bindconfirm="sendMessage" />
      <button class="send-btn" bindtap="sendMessage">发送</button>
    </view>
  </view>

  <view class="date-invite-overlay" wx:if="{{showDateInviteModal}}">
    <view class="date-invite-card">
      <text class="date-invite-title">发起 date 邀请</text>
      <text class="date-invite-sub">一日租赁陪伴，费用由平台托管。服务完成后对方到账 80%，平台收取 20% 推广服务费。</text>
      <view class="date-package-list">
        <view
          class="date-package {{selectedDatePackage.days === item.days ? 'active' : ''}}"
          wx:for="{{datePackages}}"
          wx:key="days"
          bindtap="selectDatePackage"
          data-index="{{index}}"
        >
          <text>{{item.name}}</text>
          <text>¥{{item.price}}</text>
        </view>
      </view>
      <view class="date-fee-box" wx:if="{{selectedDatePackage.price}}">
        <text>用户支付：¥{{selectedDatePackage.price}}（含平台服务费）</text>
        <text>对方预计到账：¥{{selectedDatePackage.providerAmount}}（80%）</text>
        <text>平台推广费 20%：¥{{selectedDatePackage.platformFee}}</text>
      </view>
      <text class="date-boundary-copy">发起即确认遵守双方不可做边界，不涉及身体接触、不去私人住所。</text>
      <view class="date-invite-actions">
        <button class="date-cancel" bindtap="closeDateInviteModal">取消</button>
        <button class="date-confirm" bindtap="confirmDateInvite">确认并发起邀请</button>
      </view>
    </view>
  </view>
</view>
