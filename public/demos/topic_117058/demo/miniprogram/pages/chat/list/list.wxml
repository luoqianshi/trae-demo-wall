<view class="container chat-list-container">
  <view class="sprout-card" wx:if="{{sproutPotatoes.length}}">
    <view class="sprout-header">
      <view>
        <text class="sprout-title">🌱 萌芽土豆</text>
        <text class="sprout-sub">最近给你投土豆的人</text>
      </view>
    </view>
    <scroll-view scroll-x class="sprout-scroll">
      <view class="sprout-item" wx:for="{{sproutPotatoes}}" wx:key="userId">
        <view class="sprout-avatar avatar-placeholder" style="background: {{item.avatar}};">
          <text>{{item.identity === 'princess' ? '👸' : '🤴'}}</text>
        </view>
        <text class="sprout-name">{{item.nickname}}</text>
        <text class="sprout-time">{{item.timeText}}</text>
        <button class="sprout-match-btn" bindtap="matchSproutPotato" data-userid="{{item.userId}}">匹配</button>
      </view>
    </scroll-view>
  </view>

  <view class="empty-state" wx:if="{{matches.length === 0}}">
    <text class="empty-icon">💬</text>
    <text class="empty-title">还没有匹配</text>
    <text class="empty-sub">去发现页滑动，找到互投土豆的人吧～</text>
    <button class="btn-primary" bindtap="goToDiscover">去发现</button>
  </view>

  <view class="match-list" wx:else>
    <view class="match-item" wx:for="{{matches}}" wx:key="matchId" bindtap="goToChat" data-matchid="{{item.matchId}}">
      <view class="match-avatar avatar-placeholder" style="background: {{item.avatar}};">
        <text>{{item.identity === 'princess' ? '👸' : '🤴'}}</text>
      </view>
      <view class="match-info">
        <view class="match-header">
          <text class="match-name">{{item.nickname}}</text>
          <text class="match-time">{{item.timeText}}</text>
        </view>
        <text class="match-preview">{{item.lastMessage}}</text>
        <text class="match-expire {{item.isExpired ? 'expired' : ''}}">⏳ {{item.expireText}}</text>
      </view>
      <view class="match-badge" wx:if="{{!item.read}}"><text>1</text></view>
    </view>
  </view>
</view>
