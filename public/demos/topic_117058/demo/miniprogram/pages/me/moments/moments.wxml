<view class="container moments-container">
  <view class="card composer-card">
    <view class="section-title">📝 今日动态</view>
    <textarea
      class="moment-textarea"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="160"
      placeholder="今天想介绍什么？可以写见面偏好、今日心情、想做的 one day 计划..."
    />
    <view class="photo-grid">
      <view class="moment-photo" wx:for="{{photos}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="photo-remove" catchtap="removePhoto" data-index="{{index}}">×</view>
      </view>
      <view class="photo-add" wx:if="{{photos.length < 3}}" bindtap="addPhoto">+</view>
    </view>
    <view class="composer-footer">
      <text class="text-sub">每日最多发布1条，最多3张图</text>
      <button class="publish-btn" bindtap="publishMoment">发布动态</button>
    </view>
  </view>

  <view class="card" wx:if="{{moments.length}}">
    <view class="section-title">我的动态</view>
    <view class="moment-item" wx:for="{{moments}}" wx:key="momentId">
      <text class="moment-date">{{item.dateText}}</text>
      <text class="moment-content">{{item.content}}</text>
      <view class="moment-photo-list" wx:if="{{item.photos.length}}">
        <image wx:for="{{item.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📝</text>
    <text class="empty-title">还没有动态</text>
    <text class="empty-sub">每天发一条图文，让别人更了解你</text>
  </view>
</view>
