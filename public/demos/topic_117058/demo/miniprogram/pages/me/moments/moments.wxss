.moments-container {
  padding-bottom: 60rpx;
}

.composer-card {
  border: 2rpx solid rgba(248, 187, 208, 0.5);
}

.moment-textarea {
  width: 100%;
  height: 180rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.moment-photo,
.photo-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  position: relative;
}

.moment-photo image {
  width: 100%;
  height: 100%;
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border: 4rpx dashed var(--primary-light);
  color: var(--primary);
  font-size: 56rpx;
  box-sizing: border-box;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  line-height: 38rpx;
  text-align: center;
}

.composer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.publish-btn {
  margin: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  font-size: 26rpx;
}

.publish-btn::after {
  border: none;
}

.moment-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.moment-item:last-child {
  border-bottom: none;
}

.moment-date {
  display: block;
  color: var(--text-sub);
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.moment-content {
  display: block;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.7;
}

.moment-photo-list {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.moment-photo-list image {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
}
