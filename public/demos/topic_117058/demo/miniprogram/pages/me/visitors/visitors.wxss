.visitors-container {
  padding-bottom: 60rpx;
}

.locked-card {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.locked-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.locked-title {
  color: var(--text-main);
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.locked-sub {
  width: 80%;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 36rpx;
}

.unlock-btn {
  width: 70%;
}

.visitors-summary {
  display: flex;
  align-items: baseline;
  justify-content: center;
  background: linear-gradient(135deg, var(--gold), #FFECB3);
}

.summary-num {
  color: #5d4037;
  font-size: 64rpx;
  font-weight: 700;
  margin-right: 12rpx;
}

.summary-text {
  color: #8d6e63;
  font-size: 28rpx;
}

.visitor-list {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-pink);
}

.visitor-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.visitor-item:last-child {
  border-bottom: none;
}

.visitor-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  font-size: 48rpx;
}

.visitor-info {
  flex: 1;
  margin-left: 24rpx;
}

.visitor-name {
  display: block;
  color: var(--text-main);
  font-size: 32rpx;
  font-weight: 500;
}

.visitor-meta {
  display: block;
  color: var(--text-sub);
  font-size: 24rpx;
  margin-top: 6rpx;
}
