.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  border-radius: var(--radius-md);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-pink);
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  font-size: 72rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
}

.user-info {
  flex: 1;
  margin-left: 28rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  display: block;
}

.user-wechat {
  display: inline-block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
}


.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.edit-btn,
.preview-btn {
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-sm);
  text-align: center;
  white-space: nowrap;
}

.preview-btn {
  background: rgba(255, 255, 255, 0.34);
}

.vip-card {
  background: linear-gradient(135deg, var(--gold), #FFECB3);
}

.vip-header,
.menu-item,
.stats-card {
  display: flex;
  align-items: center;
}

.vip-header {
  justify-content: space-between;
}

.vip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5d4037;
}

.vip-features {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8d6e63;
}

.menu-list {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-pink);
  margin-bottom: 24rpx;
}

.menu-item {
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
}

.menu-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-main .menu-text {
  flex: none;
}

.menu-sub {
  margin-top: 4rpx;
  color: var(--text-sub);
  font-size: 22rpx;
}

.menu-badge {
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-sub);
}

.stats-card {
  justify-content: space-around;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-pink);
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent);
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
}
