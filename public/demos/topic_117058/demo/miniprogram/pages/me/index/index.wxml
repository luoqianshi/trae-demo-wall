<view class="container me-container">
  <view class="user-card">
    <view class="user-avatar avatar-placeholder" style="background: {{user.avatarUrls[0] || '#F48FB1'}};">
      <text>{{user.identity === 'princess' ? '👸' : '🤴'}}</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{user.nickname}}</text>
      <text class="user-wechat" bindtap="quickFillWechat">微信号：{{user.wechatId || '点击快速填写'}}</text>

    </view>
    <view class="profile-actions">
      <view class="edit-btn" bindtap="goToEdit"><text>编辑资料</text></view>
      <view class="preview-btn" bindtap="goToPreview"><text>预览资料</text></view>
    </view>
  </view>

  <view class="card vip-card" bindtap="goToVip">
    <view class="vip-header">
      <text class="vip-title">{{isMember ? '👑 会员特权中' : '✨ 升级会员'}}</text>
      <text class="vip-arrow">›</text>
    </view>
    <view class="vip-features"><text>{{vipText}}</text></view>
  </view>

  <view class="menu-list">
    <view class="menu-item">
      <text class="menu-icon">💌</text>
      <view class="menu-main">
        <text class="menu-text">我的 date</text>
        <text class="menu-sub">查看发起和收到的 date 邀请</text>
      </view>
      <text class="menu-badge">待确认</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">💰</text>
      <view class="menu-main">
        <text class="menu-text">我的收益</text>
        <text class="menu-sub">服务者到账80%，平台推广费20%</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToMoments">
      <text class="menu-icon">📝</text>
      <view class="menu-main">
        <text class="menu-text">动态</text>
        <text class="menu-sub">每日可发图文介绍</text>
      </view>
      <text class="menu-badge">每日</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToVisitors">
      <text class="menu-icon">👀</text>
      <view class="menu-main">
        <text class="menu-text">访客</text>
        <text class="menu-sub">会员可解锁查看</text>
      </view>
      <text class="menu-badge">{{isMember ? visitorCount : '会员'}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToLikes">
      <text class="menu-icon">🥔</text>
      <text class="menu-text">谁给我投了土豆</text>
      <text class="menu-badge" wx:if="{{likedMeCount}}">{{likedMeCount}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item"><text class="stat-num">{{stats.potatoes}}</text><text class="stat-label">收到土豆</text></view>
    <view class="stat-item"><text class="stat-num">{{stats.matches}}</text><text class="stat-label">匹配成功</text></view>
    <view class="stat-item"><text class="stat-num">{{stats.chats}}</text><text class="stat-label">聊天次数</text></view>
  </view>
</view>
