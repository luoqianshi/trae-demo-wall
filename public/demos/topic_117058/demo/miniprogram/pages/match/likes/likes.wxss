.likes-list {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-pink);
}

.like-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.like-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  font-size: 48rpx;
}

.like-info {
  flex: 1;
  margin-left: 24rpx;
}

.like-name {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
}

.like-meta {
  font-size: 24rpx;
  color: var(--text-sub);
}

.like-btn {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  margin: 0;
}
