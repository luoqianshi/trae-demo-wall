.vip-banner {
  background: linear-gradient(135deg, var(--gold), #FFA000);
  border-radius: var(--radius-md);
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.vip-banner-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.vip-banner-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5d4037;
  display: block;
}

.vip-banner-sub {
  font-size: 26rpx;
  color: #8d6e63;
}

.privilege-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.privilege-item {
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  text-align: center;
}

.privilege-icon {
  font-size: 48rpx;
  display: block;
}

.privilege-title {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
}

.privilege-desc {
  font-size: 22rpx;
  color: var(--text-sub);
}

.plan-list {
  display: flex;
  gap: 20rpx;
}

.plan-card {
  flex: 1;
  background: var(--bg);
  border: 4rpx solid transparent;
  border-radius: var(--radius-md);
  padding: 32rpx 20rpx;
  text-align: center;
  position: relative;
}

.plan-card.selected {
  border-color: var(--accent);
  background: linear-gradient(135deg, var(--primary-light), var(--bg));
}

.plan-badge {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  background: var(--accent);
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.plan-name {
  font-size: 28rpx;
  color: var(--text-sub);
  display: block;
}

.plan-price {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--accent);
  display: block;
}

.trial-card {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  border-radius: var(--radius-md);
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.trial-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.trial-text {
  color: #2e7d32;
  font-size: 28rpx;
  font-weight: 600;
}

.trial-desc {
  margin-top: 8rpx;
  color: #4e7d52;
  font-size: 23rpx;
  line-height: 1.5;
}

.trial-btn {
  background: #4CAF50;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  margin: 0;
}

.trial-btn::after {
  border: none;
}
