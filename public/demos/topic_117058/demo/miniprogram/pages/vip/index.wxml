<view class="container vip-container">
  <view class="vip-banner">
    <text class="vip-banner-icon">👑</text>
    <text class="vip-banner-title">Potato U 会员</text>
    <text class="vip-banner-sub">解锁无限可能，发现更多美好</text>
  </view>

  <view class="card">
    <view class="section-title">✨ 会员特权</view>
    <view class="privilege-list">
      <view class="privilege-item"><text class="privilege-icon">∞</text><text class="privilege-title">无限滑动</text><text class="privilege-desc">不再受每日次数限制</text></view>
      <view class="privilege-item"><text class="privilege-icon">⭐</text><text class="privilege-title">Super Like x5</text><text class="privilege-desc">每天5次超级喜欢</text></view>
      <view class="privilege-item"><text class="privilege-icon">🥔</text><text class="privilege-title">谁给我投了土豆</text><text class="privilege-desc">查看所有给你投土豆的人</text></view>
      <view class="privilege-item"><text class="privilege-icon">↩️</text><text class="privilege-title">撤回滑动</text><text class="privilege-desc">每天3次反悔机会</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">💎 选择套餐</view>
    <view class="plan-list">
      <view class="plan-card {{selectedPlan === 'monthly' ? 'selected' : ''}}" bindtap="selectPlan" data-plan="monthly"><text class="plan-name">月卡</text><text class="plan-price">¥38</text><text class="plan-unit">/月</text></view>
      <view class="plan-card {{selectedPlan === 'quarterly' ? 'selected' : ''}}" bindtap="selectPlan" data-plan="quarterly"><view class="plan-badge">最受欢迎</view><text class="plan-name">季卡</text><text class="plan-price">¥98</text><text class="plan-unit">¥32/月</text></view>
      <view class="plan-card {{selectedPlan === 'yearly' ? 'selected' : ''}}" bindtap="selectPlan" data-plan="yearly"><text class="plan-name">年卡</text><text class="plan-price">¥298</text><text class="plan-unit">¥24/月</text></view>
    </view>
  </view>

  <view class="trial-card" wx:if="{{!trialUsed}}">
    <view class="trial-copy">
      <text class="trial-text">🎁 新用户专享：3天免费体验</text>
      <text class="trial-desc">体验期可查看谁给我投了土豆</text>
    </view>
    <button class="trial-btn" bindtap="startTrial">立即领取</button>
  </view>

  <button class="btn-primary pay-btn" bindtap="pay">立即支付 ¥{{selectedPrice}}</button>
</view>
