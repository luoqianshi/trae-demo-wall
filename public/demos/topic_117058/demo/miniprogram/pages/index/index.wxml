<view class="index-container">
  <view class="header-bar">
    <view class="location-picker">
      <text class="location-icon">📍</text>
      <text class="location-text">{{currentCity}}</text>
    </view>
    <view class="filter-btn" bindtap="toggleFilter">
      <text>筛选</text>
      <text class="filter-summary">{{minAge}}-{{maxAge}}岁 · 距离{{maxDistance}}km</text>
    </view>
    <view class="swipe-count" wx:if="{{!isMember}}">
      <text>今日剩余 {{remainingSwipes}} 次</text>
    </view>
    <view class="member-badge" wx:if="{{isMember}}">
      <text>👑 会员</text>
    </view>
  </view>

  <view class="filter-panel" wx:if="{{showFilter}}">
    <view class="filter-row">
      <text class="filter-label">最小年龄 {{minAge}}岁</text>
      <slider min="18" max="60" step="1" value="{{minAge}}" activeColor="#E91E63" bindchange="onMinAgeChange" />
    </view>
    <view class="filter-row">
      <text class="filter-label">最大年龄 {{maxAge}}岁</text>
      <slider min="18" max="60" step="1" value="{{maxAge}}" activeColor="#E91E63" bindchange="onMaxAgeChange" />
    </view>
    <view class="filter-row">
      <text class="filter-label">最大距离 {{maxDistance}}km</text>
      <slider min="1" max="100" step="1" value="{{maxDistance}}" activeColor="#E91E63" bindchange="onDistanceChange" />
    </view>
    <view class="filter-actions">
      <button class="filter-reset" bindtap="resetFilter">重置</button>
      <button class="filter-apply" bindtap="applyFilter">应用筛选</button>
    </view>
  </view>

  <view class="location-auth-overlay" wx:if="{{showLocationAuthModal}}">
    <view class="location-auth-card">
      <text class="location-auth-copy">您需要启用位置分享，这样我们才能向你显示附近的会员</text>
      <button class="location-auth-btn" bindtap="requestDiscoverLocation">授权位置</button>
    </view>
  </view>

  <swipe-card
    id="discoverCards"
    cards="{{recommendUsers}}"
    bind:swipe="onSwipe"
    bind:reload="onReload"
    bind:openDetail="openDetail"
    bind:superLikeTap="showSuperLikeModal"
  />

  <view class="vip-banner" wx:if="{{!isMember && remainingSwipes <= 0}}" bindtap="goToVip">
    <text class="vip-text">✨ 升级会员，无限滑动 + 查看谁给我投了土豆</text>
    <text class="vip-arrow">›</text>
  </view>

  <view class="match-overlay" wx:if="{{showMatchModal}}">
    <view class="sakura-field">
      <text class="sakura-core">✦</text>
      <text class="sakura sakura-1">🌸</text>
      <text class="sakura sakura-2">🌸</text>
      <text class="sakura sakura-3">🌸</text>
      <text class="sakura sakura-4">🌸</text>
      <text class="sakura sakura-5">🌸</text>
      <text class="sakura sakura-6">🌸</text>
      <text class="sakura sakura-7">🌸</text>
      <text class="sakura sakura-8">🌸</text>
      <text class="sakura sakura-9">🌸</text>
      <text class="sakura sakura-10">🌸</text>
      <text class="sakura sakura-11">🌸</text>
      <text class="sakura sakura-12">🌸</text>
      <text class="sakura sakura-13">🌸</text>
      <text class="sakura sakura-14">🌸</text>
      <text class="sakura sakura-15">🌸</text>
      <text class="sakura sakura-16">🌸</text>
      <text class="sakura sakura-17">🌸</text>
      <text class="sakura sakura-18">🌸</text>
      <text class="sakura sakura-19">🌸</text>
      <text class="sakura sakura-20">🌸</text>
    </view>
    <view class="match-card">
      <view class="match-glow"></view>
      <text class="match-potato">🥔</text>
      <text class="match-title">MATCH</text>
      <text class="match-subtitle">双向匹配成功！</text>
      <text class="match-copy">你和 {{matchedUser.nickname}} 互投了土豆，一日限定 24 小时已开启。</text>
      <view class="match-quick-title">快捷回复</view>
      <view class="match-quick-replies">
        <button class="match-quick-emoji" bindtap="sendMatchQuickEmoji" data-emoji="🥰">🥰<text>可爱</text></button>
        <button class="match-quick-emoji" bindtap="sendMatchQuickEmoji" data-emoji="💗">💗<text>粉色爱心</text></button>
        <button class="match-quick-emoji" bindtap="sendMatchQuickEmoji" data-emoji="😍">😍<text>满眼爱心</text></button>
      </view>
      <view class="match-actions">
        <button class="match-secondary" bindtap="closeMatchModal">继续浏览</button>
        <button class="match-primary" bindtap="goToChatFromMatch">去聊天</button>
      </view>
    </view>
  </view>

  <view class="super-overlay" wx:if="{{showSuperLikeModal}}">
    <view class="super-card">
      <text class="super-star">⭐</text>
      <text class="super-title">Super Like</text>
      <text class="super-copy">优先出现在对方面前，让你的土豆更显眼。</text>
      <view class="super-plans">
        <view class="super-plan"><text>单次体验</text><text>¥6</text></view>
        <view class="super-plan hot"><text>5次包</text><text>¥18</text></view>
        <view class="super-plan"><text>会员每日赠送</text><text>1次</text></view>
      </view>
      <view class="super-actions">
        <button class="super-secondary" bindtap="closeSuperLikeModal">先不用</button>
        <button class="super-primary" bindtap="confirmSuperLike">使用 Super Like</button>
      </view>
    </view>
  </view>

</view>
