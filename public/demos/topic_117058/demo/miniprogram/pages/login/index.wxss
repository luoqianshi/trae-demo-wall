.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 48rpx;
  background: linear-gradient(180deg, var(--bg) 0%, #fff 50%, var(--bg) 100%);
}

.login-step-2 {
  justify-content: flex-start;
  min-height: 100vh;
  max-height: 100vh;
  overflow-y: auto;
  padding: 34rpx 38rpx 110rpx;
}

.login-step-2 .logo-section {
  margin-bottom: 22rpx;
}

.login-step-2 .logo-icon {
  font-size: 70rpx;
  margin-bottom: 6rpx;
}

.login-step-2 .logo-title {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.login-step-2 .logo-subtitle {
  font-size: 23rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.logo-title {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--accent);
  display: block;
  margin-bottom: 12rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
}

.identity-section,
.nickname-section {
  width: 100%;
}

.register-card {
  box-sizing: border-box;
  padding: 34rpx 30rpx 32rpx;
  border-radius: 42rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 248, 251, 0.96)),
    radial-gradient(circle at 0% 0%, rgba(248, 187, 208, 0.38), transparent 48%);
  box-shadow: 0 22rpx 58rpx rgba(233, 30, 99, 0.12);
  border: 2rpx solid rgba(248, 187, 208, 0.48);
}

.register-card-head {
  text-align: left;
  margin-bottom: 22rpx;
}

.register-eyebrow {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: #FFF0F5;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.register-title {
  display: block;
  text-align: left;
  font-size: 40rpx;
  line-height: 1.25;
}

.register-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.suggestion-pill {
  margin-bottom: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 26rpx;
  color: #8D4A60;
  background: #FFF0F5;
  font-size: 25rpx;
}

.register-field {
  margin-bottom: 20rpx;
}

.identity-options {
  display: flex;
  gap: 32rpx;
  margin-top: 40rpx;
}

.identity-card {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 48rpx 24rpx;
  text-align: center;
  box-shadow: var(--shadow-pink);
  border: 4rpx solid transparent;
}

.identity-card:active {
  border-color: var(--accent);
  transform: scale(0.98);
}

.identity-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.identity-name {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.identity-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

.register-input {
  margin: 16rpx 0;
  border-width: 3rpx;
  border-radius: 28rpx;
  text-align: center;
  background: #fff;
}

.form-label-inline {
  display: block;
  margin: 0 0 4rpx;
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: 600;
  text-align: left;
}

.nickname-tip {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 0;
  color: var(--accent);
  font-size: 22rpx;
  text-align: left;
}

.picker-input {
  width: 100%;
  box-sizing: border-box;
  margin: 16rpx 0;
  padding: 22rpx 28rpx;
  border-radius: var(--radius-lg);
  border: 4rpx solid var(--primary-light);
  background: #fff;
  color: var(--text-main);
  font-size: 30rpx;
  text-align: center;
}

.register-submit {
  margin-top: 22rpx;
  border-radius: 999rpx;
}

.location-btn {
  margin-bottom: 20rpx;
}

.privacy-promise {
  position: fixed;
  bottom: 60rpx;
  left: 48rpx;
  right: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
}

.login-step-2 .privacy-promise {
  position: static;
  margin-top: 24rpx;
}
