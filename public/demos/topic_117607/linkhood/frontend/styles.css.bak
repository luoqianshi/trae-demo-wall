/* ============================================================
   邻聚 LinkHood - WeUI Design System
   微信小程序风格设计规范
   ============================================================ */

:root {
  /* === WeUI 色彩体系 === */
  --weui-green: #07C160;
  --weui-green-hover: #06AD56;
  --weui-red: #FA5151;
  --weui-yellow: #FFC300;

  --bg: #F7F7F7;
  --surface: #FFFFFF;
  --surface-hover: #FAFAFA;

  --text: #000000;
  --text-body: #353535;
  --text-secondary: #888888;
  --text-tertiary: #B2B2B2;
  --text-link: #576B95;

  --border: #E5E5E5;
  --border-light: #F0F0F0;
  --border-input: #E5E5E5;

  /* === 规整圆角 === */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-pill: 9999px;
  --radius-circle: 50%;

  /* === 字体 === */
  --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans SC', sans-serif;

  /* === 尺寸 === */
  --topbar-h: 48px;
  --bottom-nav-h: 56px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html {
  font-family: var(--font);
  font-size: 16px;
  line-height: 1.5;
  color: var(--text-body);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  min-height: 100vh;
  background: var(--bg);
}

#app {
  width: 100%;
  min-height: 100vh;
  position: relative;
  background: var(--bg);
  overflow-x: hidden;
}

a { color: var(--text-link); text-decoration: none; }
a:hover { opacity: 0.85; }

/* ========== APP SHELL ========== */
.app-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== TOPBAR ========== */
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 0 16px;
  height: var(--topbar-h);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  justify-content: center;
}

.topbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  border: none;
  background: none;
  flex-shrink: 0;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-md);
  background: var(--weui-green);
  color: white;
  font-weight: 600;
  font-size: 14px;
}

.brand-title {
  font-size: 17px;
  font-weight: 500;
  color: var(--text);
}

.search-box {
  flex: 1;
  max-width: none;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  height: 36px;
  background: #F5F5F5;
  border: none;
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
}
.search-box:focus-within {
  background: #EEEEEE;
}
.search-box span { color: var(--text-secondary); font-size: 15px; }
.search-box input {
  flex: 1;
  border: none;
  outline: none;
  background: none;
  font-size: 14px;
  color: var(--text);
  font-family: var(--font);
}
.search-box input::placeholder { color: var(--text-secondary); }

.top-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: auto;
}

/* ========== BUTTONS ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 24px;
  height: 46px;
  border-radius: var(--radius-md);
  font-size: 16px;
  font-weight: 400;
  cursor: pointer;
  transition: opacity 0.2s ease;
  border: none;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
}
.btn:hover { opacity: 0.85; }
.btn:active { opacity: 0.7; }

.btn-primary {
  background: var(--weui-green);
  color: white;
}

.btn-default,
.btn-secondary {
  background: var(--surface);
  color: var(--weui-green);
  border: 1px solid var(--weui-green);
}

.btn-warn {
  background: var(--weui-red);
  color: white;
}

.btn-plain,
.btn-ghost {
  background: var(--surface);
  color: var(--text-link);
  border: none;
  padding: 0 16px;
  font-weight: 400;
}

.btn-sm { height: 36px; padding: 0 16px; font-size: 14px; }

.btn-icon {
  width: 42px;
  height: 42px;
  padding: 0;
  border-radius: var(--radius-circle);
  background: var(--surface);
  border: 1px solid var(--border);
  cursor: pointer;
  color: var(--text-secondary);
  font-size: 17px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s ease;
}
.btn-icon:hover { opacity: 0.85; }
.btn-icon:active { opacity: 0.7; }

/* ========== CELLS (WeUI List) ========== */
.cell {
  display: flex;
  align-items: center;
  padding: 16px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  transition: background 0.2s ease;
  cursor: pointer;
}
.cell:last-child { border-bottom: none; }
.cell:hover { background: var(--surface-hover); }

.cell-hd {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  margin-right: 12px;
}

.cell-bd {
  flex: 1;
  min-width: 0;
}

.cell-ft {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  color: var(--text-secondary);
  font-size: 14px;
}
.cell-ft::after {
  content: '\203A';
  font-size: 18px;
  color: var(--text-tertiary);
  margin-left: 4px;
}

/* ========== LAYOUT ========== */
.container { max-width: none; margin: 0 auto; padding: 0 16px; }

.page { display: none; padding: 16px 0; }
.page.active { display: block; }

.page-header { margin-bottom: 24px; }
.page-header h1 {
  font-size: 20px;
  font-weight: 400;
  line-height: 1.4;
  color: var(--text);
}
.page-header p {
  margin-top: 8px;
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
}

.section { margin-bottom: 24px; }
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16px;
  gap: 12px;
}
.section-title {
  font-size: 16px;
  font-weight: 400;
  color: var(--text);
}
.section-desc {
  margin-top: 4px;
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.5;
}

.grid-2 { display: flex; flex-direction: column; gap: 12px; }
.grid-3 { display: flex; flex-direction: column; gap: 12px; }
.grid-4 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }

/* ========== CARDS ========== */
.card {
  background: var(--surface);
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
  padding: 16px;
  transition: background 0.2s ease;
  position: relative;
}
.card:hover { background: var(--surface-hover); }

.card-clickable { cursor: pointer; }

.need-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.need-card h3 {
  font-size: 16px;
  font-weight: 400;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.need-card p {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

.card-author {
  display: flex;
  align-items: center;
  gap: 10px;
}
.card-avatar {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-circle);
  background: var(--weui-green);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  flex-shrink: 0;
}
.card-author-info strong {
  display: block;
  font-size: 13px;
  font-weight: 400;
  color: var(--text);
}
.card-author-info span {
  font-size: 12px;
  color: var(--text-secondary);
}

.card-price {
  font-size: 18px;
  font-weight: 500;
  color: var(--weui-red);
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

/* ========== TAGS ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 400;
  white-space: nowrap;
}
.tag-primary { background: rgba(7, 193, 96, 0.1); color: var(--weui-green); }
.tag-green { background: rgba(7, 193, 96, 0.1); color: var(--weui-green); }
.tag-orange { background: rgba(255, 195, 0, 0.1); color: #E6A700; }
.tag-purple { background: rgba(87, 107, 149, 0.1); color: var(--text-link); }
.tag-gray { background: #F2F2F2; color: var(--text-secondary); }
.tag-list { display: flex; flex-wrap: wrap; gap: 6px; }

/* ========== CHIPS / FILTERS ========== */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 20px;
}
.chip {
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 400;
  cursor: pointer;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text-body);
  transition: all 0.2s ease;
}
.chip:hover {
  border-color: var(--weui-green);
  color: var(--weui-green);
}
.chip.active {
  background: var(--weui-green);
  color: white;
  border-color: var(--weui-green);
}

/* ========== HERO ========== */
.hero {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 20px 0 24px;
}

.hero-main h1 {
  font-size: 20px;
  font-weight: 400;
  line-height: 1.4;
  margin-bottom: 8px;
  color: var(--text);
}
.hero-main h1 em {
  font-style: normal;
  color: var(--weui-green);
}

.hero-main p {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 16px;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}
.hero-actions .btn-primary,
.hero-actions .btn-default,
.hero-actions .btn-secondary {
  width: 100%;
}

.hero-side {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.metric-card {
  background: var(--surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 14px 10px;
  text-align: center;
  transition: background 0.2s ease;
}
.metric-card:hover { background: var(--surface-hover); }
.metric-card strong {
  display: block;
  font-size: 20px;
  font-weight: 500;
  color: var(--weui-green);
}
.metric-card span {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 4px;
  display: block;
}

.notice-card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 16px;
  border-left: 3px solid var(--weui-yellow);
}
.notice-card h3 {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 8px;
  color: var(--text-body);
}
.notice-card p {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ========== CIRCLE CARDS ========== */
.circle-card { display: flex; flex-direction: column; gap: 12px; }
.circle-card h3 { font-size: 16px; font-weight: 400; }
.circle-card > p { font-size: 14px; color: var(--text-secondary); line-height: 1.5; }

.circle-hero {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.circle-map {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120px;
  background: #F5F5F5;
  border-radius: var(--radius-md);
  padding: 24px;
  gap: 16px;
  flex-wrap: wrap;
}

/* ========== FEATURE ROW ========== */
.feature-list { display: flex; flex-direction: column; gap: 0; }
.feature-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
}
.feature-row:last-child { border-bottom: none; }
.feature-row > div:first-child { flex: 1; min-width: 0; }
.feature-row strong { display: block; font-size: 14px; font-weight: 400; color: var(--text); }
.feature-row span { font-size: 13px; color: var(--text-secondary); }

/* ========== FORM ========== */
.form-grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.form-grid .full { width: 100%; }
.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.field > span {
  font-size: 14px;
  font-weight: 400;
  color: var(--text-body);
}
.field input,
.field select,
.field textarea {
  padding: 10px 12px;
  border: 1px solid var(--border-input);
  border-radius: var(--radius-sm);
  font-size: 16px;
  font-family: var(--font);
  color: var(--text);
  background: var(--surface);
  transition: border-color 0.2s ease;
  outline: none;
  -webkit-appearance: none;
}
.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: var(--weui-green);
}
.field textarea { resize: vertical; min-height: 90px; }

/* ========== MODAL ========== */
.modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
  align-items: center;
  justify-content: center;
  padding: 28px;
}
.modal.active { display: flex; }
.modal-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 24px;
  width: 100%;
  max-width: 520px;
  max-height: 85vh;
  overflow-y: auto;
  animation: modalIn 0.2s ease;
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}
.modal-head h2 { font-size: 18px; font-weight: 500; }
.modal-head .muted { font-size: 13px; color: var(--text-secondary); }

/* ========== TOAST ========== */
.toast {
  position: fixed;
  bottom: calc(var(--bottom-nav-h) + 16px);
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  padding: 12px 24px;
  background: rgba(0, 0, 0, 0.75);
  color: white;
  border-radius: var(--radius-md);
  font-size: 14px;
  font-weight: 400;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
  z-index: 300;
  white-space: nowrap;
}
.toast.active {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ========== BOTTOM NAV ========== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  gap: 0;
  padding: 4px 0 8px;
  height: var(--bottom-nav-h);
  background: var(--surface);
  border-top: 1px solid var(--border);
  z-index: 150;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 4px;
  font-size: 10px;
  font-weight: 400;
  color: var(--text-secondary);
  cursor: pointer;
  border: none;
  background: none;
  transition: color 0.2s ease;
  position: relative;
  max-width: 90px;
}
.nav-item span:first-child {
  font-size: 22px;
  line-height: 1;
}
.nav-item:hover { color: var(--text-body); }
.nav-item.active {
  color: var(--weui-green);
}

/* ========== STATUS BADGES ========== */
.status {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 400;
}
.status-ok { background: rgba(7, 193, 96, 0.1); color: var(--weui-green); }
.status-waiting { background: rgba(255, 195, 0, 0.1); color: #E6A700; }
.status-fail { background: rgba(250, 81, 81, 0.1); color: var(--weui-red); }

/* ========== PROFILE ========== */
.profile-layout {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.profile-card {
  background: var(--surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 24px;
  text-align: center;
}
.big-avatar {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-circle);
  background: var(--weui-green);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 500;
  margin: 0 auto 16px;
}
.menu-list { display: flex; flex-direction: column; gap: 0; margin-top: 16px; }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  font-size: 14px;
  cursor: pointer;
  border: none;
  background: none;
  color: var(--text);
  width: 100%;
  text-align: left;
  font-family: var(--font);
  transition: background 0.2s ease;
  border-bottom: 1px solid var(--border);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:hover { background: var(--surface-hover); }
.menu-item strong { font-size: 14px; font-weight: 400; }

/* ========== SERVICE GRID ========== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 14px 8px;
  border-radius: var(--radius-md);
  background: var(--surface);
  text-align: center;
  transition: background 0.2s ease;
  border: 1px solid var(--border-light);
}
.service-item:hover {
  background: var(--surface-hover);
}
.service-item strong { font-size: 13px; font-weight: 400; color: var(--text); }
.service-item span { font-size: 11px; color: var(--text-secondary); }

/* ========== TIMELINE ========== */
.timeline { display: flex; flex-direction: column; gap: 0; }
.timeline-item {
  display: flex;
  gap: 12px;
  padding: 12px 0;
  position: relative;
}
.timeline-item::before {
  content: '';
  position: absolute;
  left: 11px;
  top: 30px;
  bottom: -12px;
  width: 1px;
  background: var(--border);
}
.timeline-item:last-child::before { display: none; }
.timeline-item time {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  border-radius: var(--radius-circle);
  background: var(--weui-green);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 500;
  flex-shrink: 0;
}
.timeline-item strong { font-size: 14px; font-weight: 400; color: var(--text); }
.timeline-item p { font-size: 13px; color: var(--text-secondary); margin-top: 2px; }

/* ========== EMPTY STATE ========== */
.empty-state {
  text-align: center;
  padding: 56px 24px;
  color: var(--text-secondary);
}
.empty-state h3 {
  font-size: 16px;
  font-weight: 400;
  color: var(--text-body);
  margin-bottom: 8px;
}
.empty-state p { font-size: 14px; }

/* ========== ORDER / AUTH / ACTIVITY CARDS ========== */
.order-card, .auth-card, .activity-card {
  background: var(--surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.order-card h3, .auth-card h3, .activity-card h3 { font-size: 15px; font-weight: 400; color: var(--text); }
.order-card p, .auth-card p, .activity-card p { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

/* ========== MUTED TEXT ========== */
.muted { color: var(--text-secondary); font-size: 13px; }

/* ========== RESPONSIVE ========== */
@media (max-width: 360px) {
  .metrics { grid-template-columns: repeat(2, 1fr); }
  .top-actions .btn-plain,
  .top-actions .btn-ghost { display: none; }
}
