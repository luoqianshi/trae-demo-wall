<view class="tab-bar">
  <view class="tab-bar-inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon">
        <view wx:if="{{index === 0}}" class="icon-home">
          <view class="roof"></view>
          <view class="chimney"></view>
          <view class="body">
            <view class="door"></view>
          </view>
        </view>
        <view wx:elif="{{index === 1}}" class="icon-trends">
          <view class="trend-bar trend-bar-1"></view>
          <view class="trend-bar trend-bar-2"></view>
          <view class="trend-bar trend-bar-3"></view>
          <view class="trend-dot trend-dot-1"></view>
          <view class="trend-dot trend-dot-2"></view>
          <view class="trend-dot trend-dot-3"></view>
        </view>
        <view wx:elif="{{index === 2}}" class="icon-profile">
          <view class="head"></view>
          <view class="body"></view>
        </view>
      </view>
      <view class="tab-label">{{item.text}}</view>
    </view>
  </view>
</view>
