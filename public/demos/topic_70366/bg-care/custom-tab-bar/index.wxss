.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: rgba(252, 249, 242, 0.94);
  border-top: 1rpx solid rgba(60, 50, 30, 0.05);
  display: flex;
  flex-direction: column;
}

.tab-bar-inner {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: flex-start;
  height: 96rpx;
  padding-top: 12rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  padding: 0;
  position: relative;
  color: #BFB8AD;
  transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.active {
  color: var(--c-accent);
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

/* Active indicator pill behind icon */
.tab-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--c-accent-bg);
  z-index: -1;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item.active .tab-icon::before {
  transform: translate(-50%, -50%) scale(1);
}

.tab-label {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 3rpx;
  transition: all 0.3s ease;
  color: #BFB8AD;
}

.tab-item.active .tab-label {
  font-weight: 600;
  color: var(--c-accent);
  letter-spacing: 4rpx;
}

/* ========== HOME ICON ========== */
.icon-home {
  position: relative;
  width: 38rpx;
  height: 32rpx;
}

.icon-home .roof {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 13rpx solid currentColor;
  transition: border-bottom-color 0.3s ease;
}

.icon-home .chimney {
  position: absolute;
  top: -2rpx;
  right: 4rpx;
  width: 7rpx;
  height: 10rpx;
  background: currentColor;
  border-radius: 2rpx 2rpx 0 0;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.tab-item.active .icon-home .chimney {
  opacity: 1;
}

.icon-home .body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 20rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 3rpx 3rpx 4rpx 4rpx;
  background: transparent;
  transition: all 0.3s ease;
}

.tab-item.active .icon-home .body {
  background: currentColor;
}

.icon-home .door {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 12rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  background: #FCF9F2;
  transition: all 0.3s ease;
}

.tab-item.active .icon-home .door {
  background: var(--c-accent-bg);
  border-color: var(--c-accent);
}

/* ========== TRENDS ICON ========== */
.icon-trends {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
  width: 40rpx;
  height: 32rpx;
  position: relative;
}

.trend-bar {
  border-radius: 4rpx;
  background: currentColor;
  transition: all 0.3s ease;
  opacity: 0.45;
  position: relative;
}

.tab-item.active .trend-bar {
  opacity: 1;
}

.trend-bar::after {
  content: '';
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
  transition: background 0.3s ease;
}

.tab-item.active .trend-bar::after {
  background: var(--c-accent);
}

.trend-bar-1 { width: 9rpx; height: 16rpx; }
.trend-bar-2 { width: 9rpx; height: 30rpx; }
.trend-bar-3 { width: 9rpx; height: 10rpx; }

.trend-dot {
  position: absolute;
  border-radius: 50%;
  background: transparent;
  transition: all 0.3s ease;
  width: 6rpx;
  height: 6rpx;
}

.trend-dot-1 { bottom: -8rpx; left: 12rpx; }
.trend-dot-2 { bottom: -8rpx; left: 50%; transform: translateX(-50%); }
.trend-dot-3 { bottom: -8rpx; right: 11rpx; }

.tab-item.active .trend-dot {
  background: var(--c-accent);
}

/* ========== PROFILE ICON ========== */
.icon-profile {
  position: relative;
  width: 38rpx;
  height: 32rpx;
}

.icon-profile .head {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2.5rpx solid currentColor;
  background: transparent;
  transition: all 0.3s ease;
}

.tab-item.active .icon-profile .head {
  background: currentColor;
}

.icon-profile .body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 14rpx;
  border-radius: 18rpx 18rpx 0 0;
  border: 2.5rpx solid currentColor;
  border-bottom: none;
  background: transparent;
  transition: all 0.3s ease;
}

.tab-item.active .icon-profile .body {
  background: currentColor;
}
