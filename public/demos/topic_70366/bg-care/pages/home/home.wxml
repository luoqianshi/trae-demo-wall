<scroll-view scroll-y class="home-page {{elderlyMode ? 'elderly' : ''}}">
  <view class="home-header">
    <view class="header-logo-area">
      <image class="header-logo" src="/images/logo.svg" mode="aspectFit"></image>
    </view>
    <view class="header-top">
      <text class="header-greeting">{{greeting}}，{{nickName}}</text>
    </view>
    <view class="header-title-row">
      <text class="header-app-name">血压管家</text>
    </view>
  </view>

  <view class="bp-card" wx:if="{{hasRecords}}">
    <view class="bp-card-header">
      <text class="bp-card-label" catchtap="onTapSpeak" data-text="最近一次测量">最近一次测量</text>
      <view class="bp-card-header-row">
        <text class="bp-card-date">{{latestDate}}</text>
        <view class="health-badge {{bpStatus.className}}">
          <text>{{bpStatus.text}}</text>
        </view>
      </view>
    </view>
    <view class="bp-metrics">
      <view class="bp-metric" catchtap="onTapSpeak" data-text="收缩压 {{latestRecord.systolic}} 毫米汞柱">
        <text class="bp-metric-value" style="color: {{systolicColor}}">{{latestRecord.systolic}}</text>
        <text class="bp-metric-unit">mmHg</text>
        <text class="bp-metric-label">收缩压</text>
      </view>
      <view class="bp-metric" catchtap="onTapSpeak" data-text="舒张压 {{latestRecord.diastolic}} 毫米汞柱">
        <text class="bp-metric-value" style="color: {{diastolicColor}}">{{latestRecord.diastolic}}</text>
        <text class="bp-metric-unit">mmHg</text>
        <text class="bp-metric-label">舒张压</text>
      </view>
      <view class="bp-metric bp-metric-last" catchtap="onTapSpeak" data-text="心率 {{latestRecord.heartRate || '暂无'}} 次每分钟">
        <text class="bp-metric-value">{{latestRecord.heartRate || '--'}}</text>
        <text class="bp-metric-unit">bpm</text>
        <text class="bp-metric-label">心率</text>
      </view>
    </view>
    <view class="bp-card-tip" catchtap="onTapSpeak" data-text="保持平稳情绪，测量前静坐五分钟效果更准确">
      <view class="css-info-icon"></view>
      <text class="tip-text">保持平稳情绪，测量前静坐 5 分钟效果更准确</text>
    </view>
  </view>

  <view class="bp-card bp-card-empty" wx:else>
    <view class="bp-card-header">
      <text class="bp-card-label">最近一次测量</text>
      <text class="bp-card-date">暂无记录</text>
    </view>
    <view class="bp-metrics">
      <view class="bp-metric">
        <text class="bp-metric-value bp-metric-placeholder">--</text>
        <text class="bp-metric-unit">mmHg</text>
        <text class="bp-metric-label">收缩压</text>
      </view>
      <view class="bp-metric">
        <text class="bp-metric-value bp-metric-placeholder">--</text>
        <text class="bp-metric-unit">mmHg</text>
        <text class="bp-metric-label">舒张压</text>
      </view>
      <view class="bp-metric bp-metric-last">
        <text class="bp-metric-value bp-metric-placeholder">--</text>
        <text class="bp-metric-unit">bpm</text>
        <text class="bp-metric-label">心率</text>
      </view>
    </view>
    <view class="bp-card-tip" catchtap="onTapSpeak" data-text="开始记录您的血压数据，守护健康每一天">
      <view class="css-info-icon"></view>
      <text class="tip-text">开始记录您的血压数据，守护健康每一天</text>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-btn primary" bindtap="goToManualInput" hover-class="action-btn-active">
      <view class="action-icon edit-icon"></view>
      <text>手动录入</text>
    </view>
    <view class="action-btn outline" bindtap="goToCamera" hover-class="action-btn-active">
      <view class="action-icon camera-icon"></view>
      <text>拍照识别</text>
    </view>
  </view>

  <view class="records-section">
    <view class="section-header">
      <text class="section-title">今日记录</text>
      <text class="section-link" bindtap="goToTrends">查看更多</text>
    </view>

    <block wx:if="{{todayRecords.length > 0}}">
      <view class="record-card" wx:for="{{todayRecords}}" wx:key="id" bindtap="goToTrends" catchtap="onTapSpeak" data-text="{{item.timeStr}} {{item.periodLabel}} 收缩压{{item.systolic}} 舒张压{{item.diastolic}} 心率{{item.heartRate || '暂无'}}">
        <view class="record-left">
          <view class="record-time">
            <text class="time-value">{{item.timeStr}}</text>
            <text class="time-label">{{item.periodLabel}}</text>
          </view>
          <view class="record-divider"></view>
          <view class="record-values">
            <text class="record-sys">{{item.systolic}}</text>
            <text class="record-sep">/</text>
            <text class="record-dia">{{item.diastolic}}</text>
            <text class="record-unit">mmHg</text>
          </view>
        </view>
        <view class="record-right">
          <text class="record-hr">{{item.heartRate || '--'}}</text>
          <text class="record-hr-unit">bpm</text>
          <view class="health-badge health-badge-sm {{item.statusClass}}">
            <text>{{item.statusText}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="empty-state" wx:else>
      <view class="css-clipboard-icon"></view>
      <text class="empty-text">今日暂无记录</text>
      <text class="empty-hint">点击上方按钮开始记录血压</text>
    </view>
  </view>

  <assist-panel elderlyMode="{{elderlyMode}}" ttsEnabled="{{ttsEnabled}}" />
  <custom-tab-bar selected="{{0}}" />
</scroll-view>
