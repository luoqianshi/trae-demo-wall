.home-page {
  min-height: 100vh;
  background: var(--c-paper);
  padding-bottom: 160rpx;
}

.home-page.elderly {
  padding-bottom: 220rpx;
}

/* ===== HEADER ===== */
.home-header {
  background: var(--c-slate);
  padding: 48rpx 48rpx 52rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-logo-area {
  margin-bottom: 24rpx;
  z-index: 1;
}

.header-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.2);
}

.home-header::before {
  content: '';
  position: absolute;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.06);
  top: -200rpx;
  right: -140rpx;
}

.home-header::after {
  content: '';
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.04);
  bottom: -120rpx;
  left: -80rpx;
}

.header-top {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.header-greeting {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  font-family: -apple-system, "PingFang SC", sans-serif;
  letter-spacing: 2rpx;
}

.header-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.css-heart {
  width: 32rpx;
  height: 28rpx;
  position: relative;
}

.css-heart::before,
.css-heart::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 18rpx;
  height: 26rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: rgba(255,255,255,0.72);
}

.css-heart::before {
  left: 0;
  transform-origin: bottom center;
  transform: rotate(-45deg);
}

.css-heart::after {
  right: 0;
  transform-origin: bottom center;
  transform: rotate(45deg);
}

.header-app-name {
  font-size: 42rpx;
  font-weight: 300;
  color: rgba(255,255,255,0.95);
  letter-spacing: 8rpx;
}

/* ===== BP CARD ===== */
.bp-card {
  margin: -28rpx 32rpx 0;
  background: var(--c-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--sh-card);
  overflow: hidden;
  position: relative;
}

.bp-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--c-accent), var(--c-warm));
}

.bp-card-empty .bp-card-header {
  padding-bottom: 24rpx;
}

.bp-card-header {
  padding: 48rpx 44rpx 24rpx;
}

.bp-card-label {
  font-size: 22rpx;
  color: var(--c-ink-light);
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
}

.bp-card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bp-card-date {
  font-size: 26rpx;
  color: var(--c-ink-soft);
  font-weight: 500;
}

.health-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 28rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.health-badge.normal {
  background: var(--c-green-bg);
  color: var(--c-green);
}

.health-badge.elevated {
  background: var(--c-gold-bg);
  color: var(--c-gold);
}

.health-badge.high {
  background: #FFF0E8;
  color: #CC6B3A;
}

.health-badge.critical {
  background: var(--c-russet-bg);
  color: var(--c-russet);
}

.bp-metrics {
  display: flex;
  flex-direction: row;
  padding: 16rpx 44rpx 48rpx;
}

.bp-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.bp-metric + .bp-metric::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8%;
  height: 84%;
  width: 1rpx;
  background: var(--c-border);
}

.bp-metric-value {
  font-size: 66rpx;
  font-weight: 400;
  color: var(--c-ink);
  line-height: 1.05;
  font-family: "PingFang SC", "Noto Serif SC", serif;
}

.bp-metric-placeholder {
  color: var(--c-ink-faint);
}

.bp-metric-unit {
  font-size: 20rpx;
  color: var(--c-ink-light);
  margin-top: 2rpx;
}

.bp-metric-label {
  font-size: 22rpx;
  color: var(--c-ink-light);
  margin-top: 18rpx;
  letter-spacing: 2rpx;
}

.bp-card-tip {
  background: var(--c-paper);
  padding: 32rpx 44rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-top: var(--hairline);
}

.css-info-icon {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--c-ink-faint);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.css-info-icon::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: var(--c-ink-faint);
}

.css-info-icon::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 10rpx;
  border-radius: 1rpx;
  background: var(--c-ink-faint);
}

.tip-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--c-ink-light);
  line-height: 1.7;
}

/* ===== QUICK ACTIONS ===== */
.quick-actions {
  display: flex;
  gap: 20rpx;
  padding: 40rpx 32rpx 0;
}

.action-btn {
  flex: 1;
  height: 124rpx;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  letter-spacing: 3rpx;
  transition: transform 0.15s;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.action-btn.primary {
  background: var(--c-accent);
  color: #fff;
  box-shadow: var(--sh-btn);
}

.action-btn.outline {
  background: var(--c-surface);
  color: var(--c-accent);
  border: 2rpx solid var(--c-accent);
}

.action-btn-active {
  transform: scale(0.97);
}

.action-icon {
  flex-shrink: 0;
  position: relative;
}

.edit-icon {
  width: 28rpx;
  height: 28rpx;
}

.edit-icon::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 6rpx;
  height: 26rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.edit-icon::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 8rpx solid currentColor;
}

.camera-icon {
  width: 32rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  position: relative;
}

.camera-icon::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 7rpx;
  background: currentColor;
  border-radius: 3rpx 3rpx 0 0;
}

.camera-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

/* ===== RECORDS SECTION ===== */
.records-section {
  padding: 56rpx 32rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--c-ink);
  letter-spacing: 2rpx;
}

.section-link {
  font-size: 24rpx;
  color: var(--c-accent);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.record-card {
  background: var(--c-surface);
  border-radius: var(--radius-md);
  padding: 32rpx 36rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--sh-soft);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.record-time {
  min-width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.time-value {
  font-size: 38rpx;
  font-weight: 400;
  color: var(--c-ink);
}

.time-label {
  font-size: 20rpx;
  color: var(--c-ink-light);
  margin-top: 4rpx;
}

.record-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--c-border);
}

.record-values {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.record-sys {
  font-size: 38rpx;
  font-weight: 400;
  color: var(--c-ink);
}

.record-sep {
  font-size: 24rpx;
  color: var(--c-ink-faint);
}

.record-dia {
  font-size: 38rpx;
  font-weight: 400;
  color: var(--c-ink-soft);
}

.record-unit {
  font-size: 20rpx;
  color: var(--c-ink-faint);
  margin-left: 4rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.record-hr {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--c-ink-soft);
}

.record-hr-unit {
  font-size: 18rpx;
  color: var(--c-ink-faint);
}

.health-badge-sm {
  padding: 4rpx 22rpx;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: var(--radius-full);
  letter-spacing: 1rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 88rpx 32rpx;
}

.css-clipboard-icon {
  width: 64rpx;
  height: 76rpx;
  border: 2rpx solid var(--c-border);
  border-radius: 8rpx;
  position: relative;
  margin-bottom: 28rpx;
}

.css-clipboard-icon::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 14rpx;
  background: var(--c-paper-warm);
  border-radius: 4rpx;
  border: 2rpx solid var(--c-border);
  border-bottom: none;
}

.css-clipboard-icon::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 2rpx;
  background: var(--c-border);
  border-radius: 1rpx;
  box-shadow: 0 14rpx 0 var(--c-border), 0 28rpx 0 var(--c-border);
}

.empty-text {
  font-size: 32rpx;
  color: var(--c-ink-soft);
  font-weight: 500;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--c-ink-faint);
}

/* ===================================================
   ELDERLY MODE — 大字模式（字号统一放大 35%）
   =================================================== */
.home-page.elderly .header-greeting { font-size: 36rpx; }
.home-page.elderly .header-app-name { font-size: 56rpx; }
.home-page.elderly .header-logo { width: 128rpx; height: 128rpx; }
.home-page.elderly .bp-card { margin: -40rpx 24rpx 0; }
.home-page.elderly .bp-card-header { padding: 56rpx 48rpx 32rpx; }
.home-page.elderly .bp-card-label { font-size: 30rpx; margin-bottom: 28rpx; }
.home-page.elderly .bp-card-date { font-size: 36rpx; }
.home-page.elderly .health-badge { font-size: 30rpx; padding: 10rpx 32rpx; }
.home-page.elderly .bp-metrics { padding: 20rpx 36rpx 52rpx; }
.home-page.elderly .bp-metric-value { font-size: 88rpx; }
.home-page.elderly .bp-metric-unit { font-size: 28rpx; }
.home-page.elderly .bp-metric-label { font-size: 30rpx; }
.home-page.elderly .bp-card-tip { padding: 36rpx 48rpx; }
.home-page.elderly .tip-text { font-size: 30rpx; }
.home-page.elderly .quick-actions { padding: 44rpx 24rpx 0; gap: 24rpx; }
.home-page.elderly .action-btn { font-size: 44rpx; height: 160rpx; }
.home-page.elderly .records-section { padding: 60rpx 24rpx 0; }
.home-page.elderly .section-title { font-size: 48rpx; }
.home-page.elderly .section-link { font-size: 34rpx; }
.home-page.elderly .record-card { padding: 36rpx 36rpx; margin-bottom: 20rpx; }
.home-page.elderly .time-value { font-size: 52rpx; }
.home-page.elderly .time-label { font-size: 28rpx; }
.home-page.elderly .record-sys { font-size: 52rpx; }
.home-page.elderly .record-dia { font-size: 52rpx; }
.home-page.elderly .record-sep { font-size: 34rpx; }
.home-page.elderly .record-unit { font-size: 28rpx; }
.home-page.elderly .record-hr { font-size: 44rpx; }
.home-page.elderly .record-hr-unit { font-size: 26rpx; }
.home-page.elderly .health-badge-sm { font-size: 28rpx; padding: 6rpx 26rpx; }
.home-page.elderly .empty-text { font-size: 44rpx; }
.home-page.elderly .empty-hint { font-size: 34rpx; }
