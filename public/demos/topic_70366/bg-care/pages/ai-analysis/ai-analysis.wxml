<view class="page-container">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <view class="nav-title">AI健康分析</view>
  </view>

  <scroll-view class="chat-area" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <block wx:for="{{messages}}" wx:key="id">
      <view id="msg-{{index}}" class="chat-row {{item.role === 'user' ? 'user' : ''}}">
        <view class="avatar {{item.role === 'user' ? 'avatar-user' : 'avatar-ai'}}">
          <block wx:if="{{item.role === 'ai'}}">
            <view class="ai-icon-heart"></view>
          </block>
          <block wx:else>{{userNameFirst}}</block>
        </view>

        <block wx:if="{{item.type === 'analysis_card' && item.report}}">
          <view class="bubble-card">
            <view class="card-header">
              <view class="card-header-chart-icon">
                <view class="chart-bar chart-bar-1"></view>
                <view class="chart-bar chart-bar-2"></view>
                <view class="chart-bar chart-bar-3"></view>
              </view>
              <text class="card-header-title">近7天血压分析报告</text>
            </view>
            <view class="card-body">
              <view class="assessment-section">
                <text class="section-label">整体评价</text>
                <text class="assessment-text">{{item.report.overallAssessment}}</text>
                <view class="score-bar-container">
                  <view class="score-bar-header">
                    <text class="score-label">健康指数</text>
                    <text class="score-value">{{item.report.healthScore}} / 100</text>
                  </view>
                  <view class="score-bar-track">
                    <view class="score-bar-fill" style="width: {{item.report.healthScore}}%;"></view>
                  </view>
                </view>
              </view>

              <view class="section-divider"></view>

              <view class="findings-section">
                <text class="section-label">温馨提示</text>
                <view class="finding-item" wx:for="{{item.report.findings}}" wx:key="index" wx:for-item="finding">
                  <view class="finding-icon {{finding.type}}">
                    <view wx:if="{{finding.type === 'warning'}}" class="icon-triangle"></view>
                    <view wx:elif="{{finding.type === 'success'}}" class="icon-check"></view>
                    <view wx:else class="icon-bulb"></view>
                  </view>
                  <text class="finding-text">{{finding.text}}</text>
                </view>
              </view>

              <view class="section-divider"></view>

              <view class="recommendations-section">
                <text class="section-label">健康建议</text>
                <view class="recommendation-item" wx:for="{{item.report.recommendations}}" wx:key="index" wx:for-item="rec">
                  <text class="recommendation-label">{{rec.label}}</text>
                  <text class="recommendation-text">{{rec.text}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>

        <block wx:elif="{{item.role === 'ai'}}">
          <view class="bubble bubble-ai {{item.large ? 'bubble-ai-large' : ''}} {{item.closing ? 'bubble-closing' : ''}}">
            <block wx:if="{{item.closing}}">
              <view class="heart-icon-small"></view>
              <text>{{item.content}}</text>
            </block>
            <block wx:else>{{item.content}}</block>
          </view>
        </block>

        <block wx:elif="{{item.role === 'user'}}">
          <view class="bubble bubble-user">{{item.content}}</view>
        </block>
      </view>
    </block>

    <view wx:if="{{loading}}" class="chat-row">
      <view class="avatar avatar-ai">
        <view class="ai-icon-heart"></view>
      </view>
      <view class="bubble bubble-ai">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="input-area">
    <input class="input-field" type="text" value="{{inputValue}}" placeholder="输入您的问题..." bindinput="onInput" confirm-type="send" bindconfirm="sendMessage" maxlength="200" adjust-position="{{true}}" />
    <view class="send-btn" bindtap="sendMessage">
      <view class="send-icon"></view>
    </view>
  </view>
</view>
