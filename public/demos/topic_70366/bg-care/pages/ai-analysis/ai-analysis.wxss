.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--c-paper);
  position: relative;
}

.nav-bar {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--c-surface);
  border-bottom: var(--hairline);
  position: relative;
  flex-shrink: 0;
  z-index: 10;
}

.nav-back {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid var(--c-ink);
  border-bottom: 4rpx solid var(--c-ink);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-ink);
  line-height: 1.3;
}

.chat-area {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  padding-bottom: 160rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.chat-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  max-width: 100%;
}

.chat-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.avatar-ai {
  background: var(--c-accent);
  color: #fff;
}

.avatar-user {
  background: var(--c-ink-faint);
  color: var(--c-ink-soft);
}

.ai-icon-heart {
  position: relative;
  width: 36rpx;
  height: 32rpx;
}

.ai-icon-heart::before,
.ai-icon-heart::after {
  content: '';
  position: absolute;
  top: 0;
  width: 20rpx;
  height: 28rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: #fff;
}

.ai-icon-heart::before {
  left: 0;
  transform: rotate(-45deg);
  transform-origin: bottom right;
}

.ai-icon-heart::after {
  right: 0;
  transform: rotate(45deg);
  transform-origin: bottom left;
}

.bubble {
  max-width: calc(100% - 112rpx);
  padding: 28rpx 36rpx;
  font-size: var(--fs-base);
  line-height: 1.7;
  word-break: break-word;
}

.bubble-user {
  background: var(--c-accent);
  color: #fff;
  border-radius: var(--radius-xl) var(--radius-sm) var(--radius-xl) var(--radius-xl);
}

.bubble-ai {
  background: var(--c-paper);
  color: var(--c-ink);
  border-radius: var(--radius-sm) var(--radius-xl) var(--radius-xl) var(--radius-xl);
}

.bubble-ai-large {
  font-size: var(--fs-md);
  font-weight: 500;
}

.bubble-closing {
  font-size: var(--fs-base);
  color: var(--c-ink-soft);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.heart-icon-small {
  display: inline-block;
  flex-shrink: 0;
  width: 32rpx;
  height: 28rpx;
  position: relative;
  margin-top: 8rpx;
}

.heart-icon-small::before,
.heart-icon-small::after {
  content: '';
  position: absolute;
  top: 0;
  width: 18rpx;
  height: 24rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: var(--c-accent);
}

.heart-icon-small::before {
  left: 0;
  transform: rotate(-45deg);
  transform-origin: bottom right;
}

.heart-icon-small::after {
  right: 0;
  transform: rotate(45deg);
  transform-origin: bottom left;
}

.bubble-card {
  background: var(--c-surface);
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--sh-card);
  max-width: calc(100% - 112rpx);
}

.card-header {
  background: var(--c-accent-bg);
  padding: 32rpx 40rpx;
  border-bottom: var(--hairline);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-header-chart-icon {
  width: 44rpx;
  height: 36rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.chart-bar {
  width: 10rpx;
  border-radius: 3rpx;
  background: var(--c-accent);
}

.chart-bar-1 {
  height: 20rpx;
}

.chart-bar-2 {
  height: 30rpx;
}

.chart-bar-3 {
  height: 14rpx;
}

.card-header-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-ink);
}

.card-body {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.assessment-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-label {
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--c-accent);
  letter-spacing: 2rpx;
}

.assessment-text {
  font-size: var(--fs-md);
  font-weight: 500;
  color: var(--c-ink);
  line-height: 1.7;
}

.score-bar-container {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.score-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.score-label {
  font-size: var(--fs-xs);
  color: var(--c-ink-soft);
}

.score-value {
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--c-gold);
}

.score-bar-track {
  width: 100%;
  height: 20rpx;
  background: var(--c-ink-faint);
  border-radius: 9999rpx;
  overflow: hidden;
}

.score-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--c-accent), var(--c-green));
  border-radius: 9999rpx;
  transition: width 0.6s ease;
}

.findings-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.finding-item {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: flex-start;
}

.finding-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finding-icon.warning {
  background: var(--c-gold-bg);
}

.finding-icon.success {
  background: var(--c-green-bg);
}

.finding-icon.info {
  background: #F0EDF6;
}

.icon-triangle {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 24rpx solid var(--c-gold);
}

.icon-check {
  width: 24rpx;
  height: 18rpx;
  border-left: 5rpx solid var(--c-green);
  border-bottom: 5rpx solid var(--c-green);
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.icon-bulb {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  border: 4rpx solid #7B8AB8;
  position: relative;
}

.icon-bulb::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 6rpx;
  background: #7B8AB8;
  border-radius: 0 0 4rpx 4rpx;
}

.finding-text {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--c-ink);
  line-height: 1.7;
  padding-top: 6rpx;
}

.recommendations-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommendation-item {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--c-paper);
  border-radius: var(--radius-md);
  align-items: flex-start;
}

.recommendation-label {
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--c-accent);
  white-space: nowrap;
  min-width: 112rpx;
  padding-top: 2rpx;
}

.recommendation-text {
  font-size: var(--fs-base);
  color: var(--c-ink);
  line-height: 1.7;
}

.section-divider {
  height: 2rpx;
  background: var(--c-border);
  width: 100%;
}

.input-area {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--c-surface);
  border-top: var(--hairline);
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  z-index: 10;
}

.input-field {
  flex: 1;
  height: 88rpx;
  background: var(--c-paper);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius-lg);
  padding: 0 36rpx;
  font-size: var(--fs-base);
  color: var(--c-ink);
}

.send-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  background: var(--c-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.send-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 22rpx;
  height: 22rpx;
  border-right: 5rpx solid #fff;
  border-top: 5rpx solid #fff;
  transform: translate(-30%, -50%) rotate(45deg);
}

.send-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 46%;
  width: 28rpx;
  height: 0;
  border-top: 5rpx solid #fff;
  transform: translateY(-50%);
}

.loading-dots {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 9999rpx;
  background: var(--c-ink-faint);
  animation: bounce 1.2s ease-in-out infinite;
}

.dot:nth-child(1) {
  animation-delay: 0s;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}
