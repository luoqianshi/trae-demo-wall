.page-wrapper {
  min-height: 100vh;
  background-color: var(--c-paper);
  padding-bottom: 120rpx;
}

.page-header {
  padding: 32rpx 40rpx 24rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--c-ink);
}

.period-badge {
  background-color: var(--c-russet-bg);
  color: var(--c-russet);
  font-size: var(--fs-xs);
  font-weight: 500;
  padding: 12rpx 28rpx;
  border-radius: 80rpx;
}

.chart-card {
  background-color: var(--c-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--sh-card);
  padding: 40rpx 32rpx;
  margin: 0 32rpx;
}

.legend {
  display: flex;
  flex-direction: row;
  gap: 40rpx;
  margin-bottom: 24rpx;
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.legend-line {
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
}

.legend-sys {
  background-color: var(--c-russet);
}

.legend-dia {
  background-color: #7B8AB8;
}

.legend-text {
  font-size: var(--fs-xs);
  color: var(--c-ink-soft);
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
  display: block;
}

.chart-unit {
  text-align: right;
  font-size: 22rpx;
  color: var(--c-ink-light);
  margin-top: 8rpx;
}

.chart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
}

.chart-empty .empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.chart-empty .empty-text {
  font-size: 28rpx;
  color: var(--c-ink-soft);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.chart-empty .empty-hint {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
}

.stats-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  padding: 24rpx 32rpx;
}

.stat-card {
  flex: 1;
  background-color: var(--c-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--sh-card);
  padding: 32rpx;
}

.stat-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stat-label {
  font-size: var(--fs-xs);
  color: var(--c-ink-soft);
}

.stat-badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 20rpx;
  border-radius: 80rpx;
}

.stat-badge-normal {
  background-color: var(--c-green-bg);
  color: var(--c-green);
}

.stat-badge-elevated {
  background-color: var(--c-gold-bg);
  color: var(--c-gold);
}

.stat-values {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
}

.stat-val-group {
  display: flex;
  flex-direction: column;
}

.stat-val {
  font-size: 56rpx;
  font-weight: 500;
  line-height: 1.1;
}

.stat-val-sys {
  color: var(--c-russet);
}

.stat-val-dia {
  color: #7B8AB8;
}

.stat-val-unit {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
  margin-top: 4rpx;
}

.stat-hr-wrapper {
  display: flex;
  flex-direction: column;
}

.stat-hr-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 6rpx;
}

.stat-hr-val {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--c-ink);
  line-height: 1.1;
}

.stat-hr-unit {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
}

.stat-hr-range {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
  margin-top: 8rpx;
}

.records-section {
  padding: 24rpx 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--fs-md);
  font-weight: 500;
  color: var(--c-ink);
}

.record-row {
  background-color: var(--c-surface);
  border-radius: var(--radius-sm);
  box-shadow: var(--sh-soft);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.record-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.record-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-normal {
  background-color: var(--c-green);
}

.dot-elevated {
  background-color: var(--c-gold);
}

.record-date-info {
  display: flex;
  flex-direction: column;
}

.record-date {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-ink);
}

.record-time {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
  margin-top: 4rpx;
}

.record-right {
  text-align: right;
}

.record-bp-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
  justify-content: flex-end;
}

.record-bp-sys {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-russet);
}

.record-bp-sep {
  font-size: 28rpx;
  color: var(--c-ink-light);
}

.record-bp-dia {
  font-size: var(--fs-base);
  font-weight: 500;
  color: #7B8AB8;
}

.record-hr {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
  margin-top: 4rpx;
}

.view-all-btn {
  width: 100%;
  padding: 24rpx;
  background-color: var(--c-surface);
  border: 2rpx solid var(--c-accent);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--c-accent);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-state .empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.empty-state .empty-text {
  font-size: var(--fs-base);
  color: var(--c-ink-soft);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-state .empty-hint {
  font-size: var(--fs-sm);
  color: var(--c-ink-light);
}
