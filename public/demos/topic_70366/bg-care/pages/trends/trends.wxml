<scroll-view scroll-y class="page-wrapper">
  <view class="page-header">
    <text class="page-title">健康趋势</text>
    <view class="period-badge">
      <text>最近7天</text>
    </view>
  </view>

  <view class="chart-card">
    <view class="legend">
      <view class="legend-item">
        <view class="legend-line legend-sys"></view>
        <text class="legend-text">高压</text>
      </view>
      <view class="legend-item">
        <view class="legend-line legend-dia"></view>
        <text class="legend-text">低压</text>
      </view>
    </view>

    <view wx:if="{{hasData}}">
      <canvas canvas-id="bpChart" class="chart-canvas"></canvas>
      <view class="chart-unit">
        <text>单位：mmHg</text>
      </view>
    </view>

    <view class="chart-empty" wx:else>
      <view class="empty-icon">📊</view>
      <text class="empty-text">暂无趋势数据</text>
      <text class="empty-hint">记录血压后将自动生成趋势图表</text>
    </view>
  </view>

  <view class="stats-row" wx:if="{{hasData}}">
    <view class="stat-card">
      <view class="stat-header">
        <text class="stat-label">平均血压</text>
        <view class="stat-badge stat-badge-{{stats.sysStatus === 'normal' ? 'normal' : 'elevated'}}">
          <text>{{stats.sysStatusText}}</text>
        </view>
      </view>
      <view class="stat-values">
        <view class="stat-val-group">
          <text class="stat-val stat-val-sys">{{stats.avgSystolic}}</text>
          <text class="stat-val-unit">mmHg</text>
        </view>
        <view class="stat-val-group">
          <text class="stat-val stat-val-dia">{{stats.avgDiastolic}}</text>
          <text class="stat-val-unit">mmHg</text>
        </view>
      </view>
    </view>

    <view class="stat-card">
      <view class="stat-header">
        <text class="stat-label">心率统计</text>
        <view class="stat-badge stat-badge-normal">
          <text>正常</text>
        </view>
      </view>
      <view class="stat-hr-wrapper">
        <view class="stat-hr-row">
          <text class="stat-hr-val">{{stats.avgHeartRate}}</text>
          <text class="stat-hr-unit">bpm</text>
        </view>
        <text class="stat-hr-range">{{stats.minHeartRate}}-{{stats.maxHeartRate}} bpm</text>
      </view>
    </view>
  </view>

  <view class="records-section" wx:if="{{hasData}}">
    <view class="section-header">
      <text class="section-title">每日详情</text>
    </view>

    <view class="record-row" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <view class="record-dot {{item.status === 'normal' ? 'dot-normal' : 'dot-elevated'}}"></view>
        <view class="record-date-info">
          <text class="record-date">{{item.dateLabel}}</text>
          <text class="record-time">{{item.timeLabel}}</text>
        </view>
      </view>
      <view class="record-right">
        <view class="record-bp-row">
          <text class="record-bp-sys">{{item.systolic}}</text>
          <text class="record-bp-sep">/</text>
          <text class="record-bp-dia">{{item.diastolic}}</text>
        </view>
        <text class="record-hr">{{item.heartRate || '--'}} bpm</text>
      </view>
    </view>

    <view class="view-all-btn" bindtap="viewAll">
      <text>查看全部</text>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <view class="empty-icon">📋</view>
    <text class="empty-text">暂无记录</text>
    <text class="empty-hint">开始记录血压，关注健康趋势</text>
  </view>
  <custom-tab-bar selected="{{1}}" />
</scroll-view>
