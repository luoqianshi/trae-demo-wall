.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #1A1210;
  overflow: hidden;
}

.camera-nav {
  z-index: 10;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 18, 16, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.back-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  left: 0;
  z-index: 10;
}

.back-arrow {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(45deg);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.viewfinder {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #0F0B09 0%, #1A1210 30%, #1E1612 100%);
  min-height: 0;
}

.viewfinder-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.viewfinder-vignette::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(10, 6, 4, 0.6) 100%);
}

.focus-frame {
  position: relative;
  z-index: 2;
  width: 480rpx;
  height: 320rpx;
  border: 4rpx dashed rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.corner-bracket {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: #FFFFFF;
  border-style: solid;
  border-width: 0;
  z-index: 3;
}

.corner-tl {
  top: -4rpx;
  left: -4rpx;
  border-top-width: 6rpx;
  border-left-width: 6rpx;
  border-top-left-radius: 8rpx;
}

.corner-tr {
  top: -4rpx;
  right: -4rpx;
  border-top-width: 6rpx;
  border-right-width: 6rpx;
  border-top-right-radius: 8rpx;
}

.corner-bl {
  bottom: -4rpx;
  left: -4rpx;
  border-bottom-width: 6rpx;
  border-left-width: 6rpx;
  border-bottom-left-radius: 8rpx;
}

.corner-br {
  bottom: -4rpx;
  right: -4rpx;
  border-bottom-width: 6rpx;
  border-right-width: 6rpx;
  border-bottom-right-radius: 8rpx;
}

.scan-line {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(107, 142, 107, 0.7), transparent);
  z-index: 4;
  border-radius: 2rpx;
  box-shadow: 0 0 16rpx rgba(107, 142, 107, 0.4);
  animation: scanMove 2.5s ease-in-out infinite;
}

@keyframes scanMove {
  0%, 100% {
    top: 8rpx;
    opacity: 0.3;
  }
  50% {
    top: calc(100% - 20rpx);
    opacity: 0.9;
  }
}

.bp-display {
  text-align: center;
}

.bp-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 4rpx;
  display: block;
}

.bp-readings {
  font-size: 84rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  letter-spacing: 2rpx;
  font-family: "SF Mono", "Menlo", "Courier New", monospace;
  text-shadow: 0 0 40rpx rgba(107, 142, 107, 0.3);
}

.bp-unit {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 2rpx;
  display: block;
  margin-top: 4rpx;
}

.guide-area {
  z-index: 5;
  text-align: center;
  padding: 40rpx 48rpx 24rpx;
  flex-shrink: 0;
}

.guide-main {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.guide-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 12rpx;
  display: block;
}

.controls-area {
  z-index: 5;
  padding-bottom: 72rpx;
  background: linear-gradient(180deg, rgba(26, 18, 16, 0.95) 0%, #1A1210 20%);
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.capture-btn {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--c-accent);
  border: 8rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(107, 142, 107, 0.4), 0 0 0 4rpx rgba(107, 142, 107, 0.2);
  margin-bottom: 28rpx;
  transition: transform 0.15s ease;
}

.capture-btn:active {
  transform: scale(0.95);
}

.capture-icon {
  width: 56rpx;
  height: 42rpx;
  position: relative;
}

.camera-body {
  width: 56rpx;
  height: 42rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 8rpx;
  box-sizing: border-box;
  position: relative;
}

.camera-lens {
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.capture-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
}
