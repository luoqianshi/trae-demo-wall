<view class="page-wrapper" style="padding-top: {{statusBarHeight}}px;">
  <view class="camera-nav">
    <view class="back-btn" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">拍照识别</text>
  </view>

  <view class="viewfinder">
    <view class="viewfinder-vignette"></view>

    <view class="focus-frame">
      <view class="corner-bracket corner-tl"></view>
      <view class="corner-bracket corner-tr"></view>
      <view class="corner-bracket corner-bl"></view>
      <view class="corner-bracket corner-br"></view>

      <view class="scan-line"></view>

      <view class="bp-display">
        <text class="bp-label">血压读数</text>
        <text class="bp-readings">128/82</text>
        <text class="bp-unit">mmHg</text>
      </view>
    </view>
  </view>

  <view class="guide-area">
    <text class="guide-main">请将血压计屏幕对准框内</text>
    <text class="guide-sub">保持手机平稳，确保屏幕文字清晰可见</text>
  </view>

  <view class="controls-area">
    <view class="capture-btn" bindtap="takePhoto">
      <view class="camera-icon">
        <view class="camera-body"></view>
        <view class="camera-lens"></view>
      </view>
    </view>
    <text class="capture-hint">点击拍照，AI自动识别血压数据</text>
  </view>
</view>
