.page-wrapper {
  min-height: 100vh;
  background-color: var(--c-paper);
}

.nav-bar {
  height: 112rpx;
  background: var(--c-surface);
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: var(--hairline);
  backdrop-filter: blur(12px);
}

.back-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  left: 0;
  z-index: 10;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--c-ink);
  border-bottom: 4rpx solid var(--c-ink);
  transform: rotate(45deg);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--fs-md);
  font-weight: 500;
  color: var(--c-ink);
  letter-spacing: 3rpx;
}

.content-scroll {
  flex: 1;
  height: calc(100vh - 112rpx);
}

.form-card {
  background: var(--c-surface);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  margin: 32rpx;
  box-shadow: var(--sh-card);
}

.datetime-display {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 48rpx;
  margin-bottom: 48rpx;
  border-bottom: var(--hairline);
  color: var(--c-ink-soft);
  font-size: var(--fs-sm);
}

.clock-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--c-ink-faint);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.clock-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 2rpx;
  height: 10rpx;
  background: var(--c-ink-faint);
  transform-origin: bottom center;
  transform: translate(-50%, -100%);
}

.clock-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 2rpx;
  height: 14rpx;
  background: var(--c-ink-faint);
  transform-origin: bottom center;
  transform: translate(-50%, -100%) rotate(90deg);
}

.input-card {
  background: var(--c-paper);
  border-radius: var(--radius-md);
  padding: 40rpx;
  margin-bottom: 32rpx;
  border-left: 10rpx solid var(--c-border);
}

.input-card.accent-coral {
  border-left-color: var(--c-russet);
}

.input-card.accent-green {
  border-left-color: var(--c-accent);
}

.input-card.accent-blue {
  border-left-color: var(--c-warm);
}

.input-label {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-ink);
}

.label-unit {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
}

.input-field {
  width: 100%;
  height: 124rpx;
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-sm);
  background: var(--c-surface);
  font-size: var(--fs-xl);
  font-weight: 400;
  color: var(--c-ink);
  padding: 0 32rpx;
  box-sizing: border-box;
  font-family: serif;
}

.input-field:focus {
  border-color: var(--c-accent);
}

.input-field::placeholder {
  color: var(--c-ink-faint);
  font-weight: 400;
}

.save-btn {
  width: 100%;
  height: 120rpx;
  background: var(--c-accent);
  color: #fff;
  font-size: var(--fs-md);
  font-weight: 500;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  letter-spacing: 6rpx;
  box-shadow: var(--sh-btn);
  transition: transform 0.1s, background 0.2s;
}

.save-btn:active {
  background: var(--c-accent-light);
  transform: scale(0.98);
}

.reference-card {
  background: var(--c-surface);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  margin: 0 32rpx 64rpx;
  box-shadow: var(--sh-card);
}

.ref-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-ink);
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.ref-title-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--c-ink-faint);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.ref-title-icon::before {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 12rpx;
  background: var(--c-ink-faint);
  border-radius: 2rpx;
}

.ref-title-icon::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 4rpx;
  background: var(--c-ink-faint);
  border-radius: 50%;
}

.ref-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.ref-row + .ref-row {
  border-top: var(--hairline);
}

.ref-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ref-dot.normal {
  background: var(--c-green);
}

.ref-dot.elevated {
  background: var(--c-gold);
}

.ref-dot.high {
  background: var(--c-russet);
}

.ref-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 20rpx;
  border-radius: 9999rpx;
  font-size: var(--fs-xs);
  font-weight: 500;
  flex-shrink: 0;
  min-width: 80rpx;
}

.ref-badge.normal {
  background: var(--c-green-bg);
  color: var(--c-green);
}

.ref-badge.elevated {
  background: var(--c-gold-bg);
  color: var(--c-gold);
}

.ref-badge.high {
  background: var(--c-russet-bg);
  color: var(--c-russet);
}

.ref-desc {
  font-size: var(--fs-xs);
  color: var(--c-ink-soft);
  line-height: 1.5;
}
