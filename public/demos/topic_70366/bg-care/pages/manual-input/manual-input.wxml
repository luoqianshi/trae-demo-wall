<view class="page-wrapper">
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="back-btn" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">手动录入</text>
  </view>

  <scroll-view class="content-scroll" scroll-y="{{true}}" enhanced show-scrollbar="{{false}}">
    <view class="form-card">
      <view class="datetime-display">
        <view class="clock-icon"></view>
        <text>{{currentTime}}</text>
      </view>

      <view class="input-card accent-coral">
        <view class="input-label">
          <text class="label-text">收缩压（高压）</text>
          <text class="label-unit">mmHg</text>
        </view>
        <input
          class="input-field"
          type="number"
          placeholder="请输入"
          value="{{systolic}}"
          bindinput="onSystolicInput"
          maxlength="3"
          confirm-type="next"
          cursor-spacing="120"
        />
      </view>

      <view class="input-card accent-green">
        <view class="input-label">
          <text class="label-text">舒张压（低压）</text>
          <text class="label-unit">mmHg</text>
        </view>
        <input
          class="input-field"
          type="number"
          placeholder="请输入"
          value="{{diastolic}}"
          bindinput="onDiastolicInput"
          maxlength="3"
          confirm-type="next"
          cursor-spacing="120"
        />
      </view>

      <view class="input-card accent-blue">
        <view class="input-label">
          <text class="label-text">心率</text>
          <text class="label-unit">次/分</text>
        </view>
        <input
          class="input-field"
          type="number"
          placeholder="请输入"
          value="{{heartRate}}"
          bindinput="onHeartRateInput"
          maxlength="3"
          confirm-type="done"
          cursor-spacing="120"
        />
      </view>

      <view class="save-btn" bindtap="saveRecord">
        <text>保存记录</text>
      </view>
    </view>

    <view class="reference-card">
      <view class="ref-title">
        <view class="ref-title-icon"></view>
        <text>血压参考范围</text>
      </view>

      <view class="ref-row">
        <view class="ref-dot normal"></view>
        <view class="ref-badge normal">正常</view>
        <text class="ref-desc">高压 &lt; 120 且 低压 &lt; 80</text>
      </view>

      <view class="ref-row">
        <view class="ref-dot elevated"></view>
        <view class="ref-badge elevated">偏高</view>
        <text class="ref-desc">高压 120-139 或 低压 80-89</text>
      </view>

      <view class="ref-row">
        <view class="ref-dot high"></view>
        <view class="ref-badge high">高血压</view>
        <text class="ref-desc">高压 ≥ 140 或 低压 ≥ 90</text>
      </view>
    </view>
  </scroll-view>
</view>
