<scroll-view scroll-y class="profile-page">
  <view class="header-card">
    <view class="header-accent"></view>

    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}"></image>
        <view class="avatar-placeholder" wx:else>
          <view class="avatar-head-css"></view>
          <view class="avatar-body-css"></view>
        </view>
        <view class="avatar-camera-badge">
          <view class="camera-mini"></view>
        </view>
      </button>
    </view>

    <view class="nickname-area">
      <input class="nickname-input" type="nickname" placeholder="点击设置昵称" value="{{nickName}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" maxlength="20" />
    </view>

    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{recordDays}}</text>
        <text class="stat-label">记录天数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{totalRecords}}</text>
        <text class="stat-label">测量次数</text>
      </view>
    </view>
  </view>

  <view class="card ai-entry-card" bindtap="goToAiAnalysis" hover-class="card-hover">
    <view class="card-left">
      <view class="icon-circle icon-circle-red">
        <view class="icon-sparkle-css">
          <view class="sparkle-h"></view>
          <view class="sparkle-v"></view>
        </view>
      </view>
      <view class="card-text">
        <text class="card-title">AI 健康分析</text>
        <text class="card-desc">查看智能健康评估报告</text>
      </view>
    </view>
    <view class="arrow-right"></view>
  </view>

  <view class="section-label">
    <text>数据管理</text>
  </view>

  <view class="card menu-card">
    <view class="menu-row" bindtap="viewHistory" hover-class="menu-row-hover">
      <view class="icon-circle icon-circle-blue">
        <view class="icon-calendar-css">
          <view class="cal-top"></view>
          <view class="cal-body"></view>
        </view>
      </view>
      <text class="menu-label">历史记录</text>
      <view class="arrow-right"></view>
    </view>
    <view class="menu-row" bindtap="exportData" hover-class="menu-row-hover">
      <view class="icon-circle icon-circle-green">
        <view class="icon-download-css">
          <view class="dl-arrow"></view>
          <view class="dl-tray"></view>
        </view>
      </view>
      <text class="menu-label">数据导出</text>
      <view class="arrow-right"></view>
    </view>
    <view class="menu-row menu-row-last" bindtap="clearData" hover-class="menu-row-hover">
      <view class="icon-circle icon-circle-red-bg">
        <view class="icon-trash-css">
          <view class="trash-lid"></view>
          <view class="trash-body"></view>
        </view>
      </view>
      <text class="menu-label menu-label-danger">清空本地数据</text>
      <view class="arrow-right"></view>
    </view>
  </view>

  <view class="card privacy-card">
    <view class="shield-icon-area">
      <view class="shield-css">
        <view class="shield-check"></view>
      </view>
    </view>
    <text class="privacy-title">你的隐私，我们守护</text>
    <text class="privacy-body">所有血压数据仅存储在本地手机中，绝不上传云端，请放心使用。</text>
  </view>

  <view class="about-area">
    <text class="about-label">血压管家</text>
    <text class="about-version">v1.0.0</text>
  </view>

  <custom-tab-bar selected="{{2}}" />
</scroll-view>
