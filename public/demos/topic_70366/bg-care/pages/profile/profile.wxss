.profile-page {
  min-height: 100vh;
  background: var(--c-paper);
  padding-bottom: calc(var(--tab-h) + 32rpx);
}

.header-card {
  background: var(--c-surface);
  margin: 28rpx 32rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--sh-card);
  overflow: hidden;
  position: relative;
}
.header-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--c-accent);
}

.avatar-section {
  display: flex;
  justify-content: center;
  padding: 56rpx 0 0;
}
.avatar-btn {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  position: relative;
  overflow: visible;
  padding: 0;
  background: transparent;
  border: none;
}
.avatar-btn::after { border: none; }

.avatar-img {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  display: block;
  border: 3rpx solid var(--c-border);
}
.avatar-placeholder {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: var(--c-paper);
  border: 2rpx dashed var(--c-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.avatar-head-css {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--c-ink-faint);
}
.avatar-body-css {
  width: 72rpx;
  height: 40rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: var(--c-ink-faint);
  margin-top: 2rpx;
}
.avatar-camera-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--c-accent);
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  box-shadow: var(--sh-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--c-surface);
}
.camera-mini {
  width: 22rpx;
  height: 18rpx;
  border: 2rpx solid #fff;
  border-radius: 3rpx;
  position: relative;
}
.camera-mini::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
}

.nickname-area {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 40rpx;
}
.nickname-input {
  font-size: var(--fs-md);
  font-weight: 500;
  text-align: center;
  color: var(--c-ink);
  width: 440rpx;
  letter-spacing: 2rpx;
}
.nickname-input::placeholder { color: var(--c-ink-faint); }

.stats-row {
  display: flex;
  align-items: center;
  padding: 20rpx 48rpx 40rpx;
  border-top: var(--hairline);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-value {
  font-size: 48rpx;
  font-weight: 400;
  color: var(--c-ink);
}
.stat-label {
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}
.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: var(--c-border);
}

.card {
  background: var(--c-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--sh-soft);
  margin: 0 32rpx 20rpx;
}
.card-hover { transform: scale(0.98); opacity: 0.92; }

.card-left { display: flex; align-items: center; }

.ai-entry-card {
  padding: 28rpx 36rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 28rpx;
  position: relative;
}
.icon-circle-sage { background: var(--c-accent-bg); }
.icon-circle-warm { background: #F0EDF6; }
.icon-circle-amber { background: var(--c-warm-bg); }
.icon-circle-russet { background: var(--c-russet-bg); }

.icon-sparkle-css {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}
.sparkle-h {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 22rpx; height: 4rpx;
  background: var(--c-accent);
  border-radius: 2rpx;
}
.sparkle-v {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx; height: 22rpx;
  background: var(--c-accent);
  border-radius: 2rpx;
}

.card-text { flex: 1; }
.card-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-ink);
  letter-spacing: 1rpx;
}
.card-desc {
  font-size: 22rpx;
  color: var(--c-ink-light);
  margin-top: 4rpx;
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--c-ink-faint);
  border-top: 2rpx solid var(--c-ink-faint);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.section-label {
  padding: 20rpx 48rpx 16rpx;
  font-size: var(--fs-xs);
  color: var(--c-ink-light);
  letter-spacing: 3rpx;
}

.menu-card { padding: 0; overflow: hidden; }
.menu-row {
  display: flex;
  align-items: center;
  padding: 26rpx 40rpx;
  border-bottom: var(--hairline);
}
.menu-row-last { border-bottom: none; }
.menu-row-hover { background: var(--c-paper); }

.menu-label {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--c-ink);
  margin-left: 28rpx;
  letter-spacing: 1rpx;
}
.menu-label-danger { color: var(--c-russet); }

.icon-calendar-css {
  width: 36rpx; height: 30rpx;
  position: relative;
}
.cal-top {
  width: 26rpx; height: 7rpx;
  border-radius: 3rpx;
  background: #7B8AB8;
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
}
.cal-body {
  width: 26rpx; height: 22rpx;
  border-radius: 0 0 5rpx 5rpx;
  background: #7B8AB8;
  position: absolute;
  top: 7rpx; left: 50%;
  transform: translateX(-50%);
}

.icon-download-css {
  width: 30rpx; height: 34rpx;
  position: relative;
}
.dl-arrow {
  width: 0; height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-bottom: 13rpx solid var(--c-accent);
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
}
.dl-tray {
  width: 22rpx; height: 7rpx;
  border-radius: 2rpx;
  background: var(--c-accent);
  position: absolute;
  bottom: 0; left: 50%;
  transform: translateX(-50%);
}

.icon-trash-css {
  width: 28rpx; height: 34rpx;
  position: relative;
}
.trash-lid {
  width: 32rpx; height: 5rpx;
  border-radius: 2rpx;
  background: var(--c-russet);
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
}
.trash-body {
  width: 24rpx; height: 26rpx;
  border-radius: 0 0 5rpx 5rpx;
  background: var(--c-russet);
  position: absolute;
  top: 5rpx; left: 50%;
  transform: translateX(-50%);
}

.privacy-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 44rpx;
  text-align: center;
}
.shield-icon-area { margin-bottom: 28rpx; }
.shield-css {
  width: 42rpx; height: 50rpx;
  background: var(--c-accent);
  position: relative;
  border-radius: 0 0 6rpx 6rpx;
}
.shield-css::before {
  content: '';
  position: absolute;
  top: -16rpx; left: 50%;
  transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 21rpx solid transparent;
  border-right: 21rpx solid transparent;
  border-bottom: 18rpx solid var(--c-accent);
}
.shield-check {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
  width: 8rpx; height: 14rpx;
  border-bottom: 2rpx solid #fff;
  border-right: 2rpx solid #fff;
}

.privacy-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-ink);
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}
.privacy-body {
  font-size: 24rpx;
  color: var(--c-ink-light);
  line-height: 1.8;
}

.about-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 56rpx;
}
.about-label {
  font-size: 22rpx;
  color: var(--c-ink-faint);
  letter-spacing: 3rpx;
}
.about-version {
  font-size: 20rpx;
  color: var(--c-ink-faint);
  margin-top: 8rpx;
}
