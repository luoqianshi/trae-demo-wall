page {
  --c-ink: #2A241A;
  --c-ink-soft: #4F4635;
  --c-ink-light: #8C8270;
  --c-ink-faint: #B5AFA3;
  --c-paper: #F7F2E8;
  --c-paper-light: #FDFAF3;
  --c-paper-warm: #F2ECE0;
  --c-surface: #FFFFFF;
  --c-accent: #6B8E6B;
  --c-accent-light: #8FAB8F;
  --c-accent-bg: #EDF3EC;
  --c-warm: #B8956A;
  --c-warm-light: #E5C8A3;
  --c-warm-bg: #FBF5EC;
  --c-green: #5B8C5A;
  --c-green-bg: #EAF4E7;
  --c-gold: #C49B3F;
  --c-gold-bg: #FDF5E1;
  --c-russet: #B8453C;
  --c-russet-bg: #FBEDEC;
  --c-slate: #3D352A;
  --c-border: #E5DDD0;

  --scale: 1;

  --fs-xs: calc(24rpx * var(--scale));
  --fs-sm: calc(28rpx * var(--scale));
  --fs-base: calc(32rpx * var(--scale));
  --fs-md: calc(38rpx * var(--scale));
  --fs-lg: calc(46rpx * var(--scale));
  --fs-xl: calc(56rpx * var(--scale));
  --fs-2xl: calc(68rpx * var(--scale));
  --fs-3xl: calc(82rpx * var(--scale));

  --radius-xs: 8rpx;
  --radius-sm: 14rpx;
  --radius-md: 22rpx;
  --radius-lg: 30rpx;
  --radius-xl: 40rpx;
  --radius-full: 9999rpx;

  --sh-soft: 0 4rpx 20rpx rgba(42, 36, 26, 0.05);
  --sh-card: 0 12rpx 40rpx rgba(42, 36, 26, 0.08);
  --sh-raised: 0 20rpx 56rpx rgba(42, 36, 26, 0.12);
  --sh-btn: 0 14rpx 36rpx rgba(107, 142, 107, 0.25);

  --hairline: 1rpx solid rgba(60, 50, 30, 0.08);
  --tab-h: 120rpx;

  font-family: -apple-system, "PingFang SC", "Noto Serif SC", "Source Han Serif SC", "STSong", "SimSun", serif;
  font-size: var(--fs-base);
  color: var(--c-ink);
  background-color: var(--c-paper);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "palt";
}

page.elderly-mode {
  --scale: 1.35;
}

view, text, scroll-view, input, button, textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: 0;
}

input {
  min-height: 0;
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
