<view class="assist-panel">
  <view class="panel-toggle" bindtap="onToggle">
    <view class="toggle-icon">
      <view class="toggle-dot"></view>
    </view>
    <text class="toggle-label">辅助</text>
  </view>

  <view class="panel-buttons {{expanded ? 'expanded' : ''}}">
    <view class="assist-btn elderly-btn {{elderlyMode ? 'active' : ''}}" bindtap="onElderly">
      <view class="btn-icon">
        <view class="icon-text-lg">A</view>
        <view class="icon-text-sm">A</view>
      </view>
      <text class="btn-label">大字</text>
    </view>

    <view class="assist-btn tts-btn {{ttsEnabled ? 'active' : ''}}" bindtap="onTts">
      <view class="btn-icon">
        <view class="icon-speaker">
          <view class="speaker-body"></view>
          <view class="speaker-wave wave-1"></view>
          <view class="speaker-wave wave-2"></view>
        </view>
      </view>
      <text class="btn-label">{{ttsEnabled ? '静音' : '朗读'}}</text>
    </view>
  </view>
</view>
