.assist-panel {
  position: fixed;
  right: 28rpx;
  top: 200rpx;
  z-index: 9998;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
}

.panel-toggle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--c-surface);
  box-shadow: var(--sh-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border: 2rpx solid var(--c-border);
  transition: all 0.3s ease;
}

.panel-toggle:active {
  transform: scale(0.94);
}

.toggle-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--c-accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}

.toggle-label {
  font-size: 18rpx;
  color: var(--c-ink-light);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.panel-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  opacity: 0;
  transform: translateX(20rpx);
  pointer-events: none;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.panel-buttons.expanded {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.assist-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--c-surface);
  box-shadow: var(--sh-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 2rpx solid var(--c-border);
  transition: all 0.25s ease;
}

.assist-btn.active {
  background: var(--c-accent);
  border-color: var(--c-accent);
  box-shadow: var(--sh-btn);
}

.assist-btn.active .btn-label {
  color: #fff;
}

.assist-btn:active {
  transform: scale(0.93);
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-text-lg {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1;
}

.icon-text-sm {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--c-ink-light);
  line-height: 1;
  position: absolute;
  right: 0;
  bottom: 0;
}

.assist-btn.active .icon-text-lg,
.assist-btn.active .icon-text-sm {
  color: #fff;
}

.icon-speaker {
  width: 34rpx;
  height: 30rpx;
  position: relative;
}

.speaker-body {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 14rpx;
  height: 22rpx;
  border: 3rpx solid var(--c-ink);
  border-radius: 3rpx;
  border-left-width: 6rpx;
}

.assist-btn.active .speaker-body {
  border-color: #fff;
}

.speaker-wave {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 50%;
  border: 3rpx solid var(--c-ink-light);
}

.assist-btn.active .speaker-wave {
  border-color: rgba(255, 255, 255, 0.7);
}

.wave-1 {
  width: 24rpx;
  height: 14rpx;
  right: -2rpx;
}

.wave-2 {
  width: 34rpx;
  height: 22rpx;
  right: -8rpx;
}

.btn-label {
  font-size: 18rpx;
  color: var(--c-ink-light);
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: color 0.25s ease;
}
