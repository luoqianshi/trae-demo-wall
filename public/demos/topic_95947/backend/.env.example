APP_NAME=Business Automation API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./business_automation.db
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=replace-with-a-long-random-secret
