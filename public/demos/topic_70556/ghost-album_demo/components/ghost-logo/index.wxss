.ghost-logo {
  position: relative;
  display: inline-block;
}

.ghost-logo.is-glow {
  filter: drop-shadow(0 0 14rpx rgba(124, 111, 255, 0.95)) drop-shadow(0 0 38rpx rgba(0, 212, 255, 0.55));
}

.ghost-body {
  position: absolute;
  left: 5%;
  right: 5%;
  top: 3%;
  height: 77%;
  border-radius: 999rpx 999rpx 0 0;
  background: linear-gradient(135deg, #c4b5fd 0%, #7c6fff 56%, #4c1d95 100%);
}

.ghost-tail-row {
  position: absolute;
  left: 5%;
  right: 5%;
  top: 79%;
  height: 13%;
}

.ghost-tail {
  position: absolute;
  top: 0;
  width: 25%;
  height: 100%;
  clip-path: polygon(0 0, 50% 100%, 100% 0);
  background: linear-gradient(135deg, #8d7cff 0%, #6b5cf6 58%, #4c1d95 100%);
}

.tail-a {
  left: 0;
}

.tail-b {
  left: 25%;
}

.tail-c {
  left: 50%;
}

.tail-d {
  left: 75%;
}

.ghost-highlight {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 10%;
  height: 65%;
  border-radius: 999rpx 999rpx 0 0;
  background: rgba(255, 255, 255, 0.07);
}

.ghost-highlight-tail-row {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 75%;
  display: flex;
  height: 10%;
}

.ghost-highlight-tail {
  flex: 1;
  height: 100%;
  clip-path: polygon(0 0, 50% 100%, 100% 0);
  background: rgba(255, 255, 255, 0.07);
}

.ghost-eye {
  position: absolute;
  top: 43%;
  width: 22%;
  height: 22%;
  border-radius: 50%;
  background: #060612;
  transform: translateY(-50%);
}

.ghost-eye.left {
  left: 25%;
}

.ghost-eye.right {
  right: 25%;
}

.eye-glow {
  position: absolute;
  left: 32%;
  top: 22%;
  width: 48%;
  height: 54%;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 35%, #00d4ff 0%, rgba(124, 111, 255, 0.55) 100%);
}

.mini-lock {
  position: absolute;
  left: 50%;
  top: 61%;
  width: 18%;
  height: 16%;
  transform: translateX(-50%);
}

.mini-lock-arch {
  position: absolute;
  left: 21%;
  top: -24%;
  width: 58%;
  height: 58%;
  border: 3rpx solid rgba(0, 212, 255, 0.78);
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
}

.mini-lock-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 66%;
  border-radius: 20%;
  background: rgba(0, 212, 255, 0.78);
}

.mini-keyhole {
  position: absolute;
  left: 50%;
  top: 36%;
  width: 18%;
  height: 18%;
  border-radius: 50%;
  background: #060612;
  transform: translateX(-50%);
}

.mini-keyhole::after {
  position: absolute;
  left: 28%;
  top: 60%;
  width: 44%;
  height: 80%;
  border-radius: 999rpx;
  background: #060612;
  content: "";
}
