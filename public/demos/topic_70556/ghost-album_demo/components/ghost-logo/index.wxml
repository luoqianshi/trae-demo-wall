<view class="ghost-logo {{glow ? 'is-glow' : ''}}" style="width: {{size}}rpx; height: {{height}}rpx;">
  <view class="ghost-body"></view>
  <view class="ghost-tail-row">
    <view class="ghost-tail tail-a"></view>
    <view class="ghost-tail tail-b"></view>
    <view class="ghost-tail tail-c"></view>
    <view class="ghost-tail tail-d"></view>
  </view>
  <view class="ghost-highlight"></view>
  <view class="ghost-highlight-tail-row">
    <view class="ghost-highlight-tail"></view>
    <view class="ghost-highlight-tail"></view>
    <view class="ghost-highlight-tail"></view>
    <view class="ghost-highlight-tail"></view>
  </view>
  <view class="ghost-eye left">
    <view class="eye-glow"></view>
  </view>
  <view class="ghost-eye right">
    <view class="eye-glow"></view>
  </view>
  <view class="mini-lock">
    <view class="mini-lock-arch"></view>
    <view class="mini-lock-body">
      <view class="mini-keyhole"></view>
    </view>
  </view>
</view>
