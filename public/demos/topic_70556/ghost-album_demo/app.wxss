page {
  min-height: 100%;
  background: #070714;
  color: #e8eaf6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

input {
  color: #e8eaf6;
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 18% 22%, rgba(124, 111, 255, 0.12) 0%, transparent 44%),
    radial-gradient(ellipse at 84% 72%, rgba(0, 212, 255, 0.08) 0%, transparent 42%),
    #070714;
}

.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 28rpx);
}

.content {
  position: relative;
  z-index: 1;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.mono {
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.brand-title {
  letter-spacing: 0.22em;
  font-weight: 700;
}

.muted {
  color: #6b7280;
}

.card {
  border: 1rpx solid rgba(124, 111, 255, 0.15);
  background: rgba(13, 14, 30, 0.82);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.28);
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.22);
  background: rgba(17, 18, 36, 0.76);
  color: #a78bfa;
  font-size: 20rpx;
}

.primary-button {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7c6fff 0%, #5b4cff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  box-shadow: 0 0 34rpx rgba(124, 111, 255, 0.42);
}

.secondary-button {
  height: 84rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.22);
  background: rgba(17, 18, 36, 0.78);
  color: #c4c6d8;
  font-size: 28rpx;
}

.danger-button {
  color: #f87171;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(100, 116, 139, 0.32);
  background: rgba(30, 41, 59, 0.68);
}

.icon-button.primary {
  border-color: rgba(124, 111, 255, 0.5);
  background: rgba(124, 111, 255, 0.9);
  box-shadow: 0 0 28rpx rgba(124, 111, 255, 0.45);
}

.icon-plus,
.icon-search,
.icon-back,
.icon-lock,
.icon-more,
.icon-play,
.icon-close {
  position: relative;
  display: block;
}

.icon-plus {
  width: 26rpx;
  height: 26rpx;
}

.icon-plus::before,
.icon-plus::after,
.icon-search::after,
.icon-close::before,
.icon-close::after {
  position: absolute;
  content: "";
  background: currentColor;
}

.icon-plus::before {
  left: 11rpx;
  top: 2rpx;
  width: 4rpx;
  height: 22rpx;
  border-radius: 4rpx;
}

.icon-plus::after {
  left: 2rpx;
  top: 11rpx;
  width: 22rpx;
  height: 4rpx;
  border-radius: 4rpx;
}

.icon-search {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 999rpx;
}

.icon-search::after {
  right: -8rpx;
  bottom: -5rpx;
  width: 13rpx;
  height: 4rpx;
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.icon-back {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.icon-more {
  width: 32rpx;
  height: 8rpx;
}

.icon-more::before {
  display: block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 12rpx 0 0 currentColor, 24rpx 0 0 currentColor;
  content: "";
}

.icon-lock {
  width: 22rpx;
  height: 20rpx;
  border-radius: 5rpx;
  background: currentColor;
}

.icon-lock::before {
  position: absolute;
  left: 4rpx;
  top: -13rpx;
  width: 14rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 14rpx 14rpx 0 0;
  content: "";
}

.icon-play {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid currentColor;
}

.icon-close {
  width: 28rpx;
  height: 28rpx;
}

.icon-close::before,
.icon-close::after {
  left: 12rpx;
  top: 2rpx;
  width: 4rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

.icon-close::before {
  transform: rotate(45deg);
}

.icon-close::after {
  transform: rotate(-45deg);
}

.modal-mask,
.sheet-mask {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.64);
}

.modal-card,
.sheet-card {
  width: 100%;
  border-radius: 34rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.2);
  background: #0d0e1e;
  box-shadow: 0 -24rpx 80rpx rgba(0, 0, 0, 0.55), 0 0 52rpx rgba(124, 111, 255, 0.12);
}

.modal-card {
  padding: 34rpx;
}

.sheet-card {
  padding: 20rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

.field {
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(100, 116, 139, 0.28);
  background: rgba(17, 18, 36, 0.95);
  color: #e8eaf6;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  color: #64748b;
  text-align: center;
}
