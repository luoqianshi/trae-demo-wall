.unlock-page {
  min-height: 100vh;
}

.unlock-content {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - env(safe-area-inset-top) - 28rpx);
}

.unlock-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #4b5563;
  font-size: 18rpx;
  letter-spacing: 0.16em;
}

.status-secure {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(124, 111, 255, 0.58);
}

.status-dot,
.privacy-light {
  display: block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #34d399;
  box-shadow: 0 0 18rpx rgba(52, 211, 153, 0.8);
}

.unlock-center {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.logo-orbit {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 290rpx;
}

.orbit {
  position: absolute;
  border-radius: 999rpx;
}

.orbit-a {
  width: 232rpx;
  height: 232rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.22);
}

.orbit-b {
  width: 292rpx;
  height: 292rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.1);
  box-shadow: inset 0 0 60rpx rgba(0, 212, 255, 0.04);
}

.unlock-title {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.96);
  font-size: 42rpx;
  text-shadow: 0 0 42rpx rgba(124, 111, 255, 0.5);
}

.unlock-name {
  margin-top: 18rpx;
  color: #7c6fff;
  font-size: 22rpx;
  letter-spacing: 0.42em;
}

.unlock-copy {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.unlock-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 400rpx);
}

.password-field {
  width: 368rpx;
  text-align: center;
  border-radius: 44rpx;
  margin-bottom: 20rpx;
}

.placeholder {
  color: #475569;
}

.error-text {
  color: #f87171;
  font-size: 23rpx;
  text-align: center;
}

.privacy-chip {
  display: flex;
  align-items: center;
  align-self: center;
  gap: 12rpx;
  min-height: 48rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(100, 116, 139, 0.28);
  background: rgba(15, 23, 42, 0.64);
  color: #64748b;
  font-size: 20rpx;
  letter-spacing: 0.06em;
  /* margin-top: 10rpx; */
}
