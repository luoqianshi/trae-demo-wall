<view class="page unlock-page safe-top">
  <view class="content unlock-content">
    <view class="unlock-center">
      <view class="logo-orbit">
        <view class="orbit orbit-a"></view>
        <view class="orbit orbit-b"></view>
        <ghost-logo size="{{176}}" glow="{{true}}" />
      </view>
      <text class="unlock-title brand-title">GHOST ALBUM</text>
      <text class="unlock-name">幽灵相册</text>
      <text class="unlock-copy">输入密码，打开你的本地私密相册</text>
    </view>

    <view class="unlock-form">
      <input class="field password-field" password="{{true}}" maxlength="32" placeholder="输入本地密码" placeholder-class="placeholder" bindinput="onPasswordInput" bindconfirm="unlock" value="{{password}}" />
      <text wx:if="{{errorText}}" class="error-text">{{errorText}}</text>
      <button class="primary-button" bindtap="unlock">{{verifying ? "正在验证" : "解锁进入"}}</button>
      <view class="privacy-chip">
        <text class="privacy-light"></text>
        <text class="mono">本地保存 · 不上传云端</text>
      </view>
    </view>
  </view>
</view>
