<view class="page detail-page safe-top">
  <view class="content detail-content">
    <view class="detail-header">
      <button class="icon-button" bindtap="goBack">
        <text class="icon-back"></text>
      </button>
      <view class="album-title-wrap">
        <text class="album-title">{{album.name}}</text>
        <text class="album-subtitle mono">{{album.photoCount}} 图 · {{album.videoCount}} 视频 · 本地保存</text>
      </view>
      <button class="icon-button" bindtap="openImportSheet">
        <text class="icon-plus"></text>
      </button>
      <button class="icon-button" bindtap="openAlbumMenu">
        <text class="icon-more"></text>
      </button>
    </view>

    <view class="privacy-badge">
      <text class="icon-lock"></text>
      <text class="mono">隐私模式已开启</text>
    </view>

    <scroll-view class="media-scroll" scroll-y="{{true}}">
      <view wx:if="{{mediaList.length === 0}}" class="empty-state media-empty">
        <ghost-logo size="{{112}}" glow="{{true}}" />
        <text class="empty-title">这个相册还是空的</text>
        <text class="empty-copy">从系统相册或微信聊天导入照片、视频。</text>
        <button class="secondary-button empty-button" bindtap="openImportSheet">导入内容</button>
      </view>

      <view wx:else class="media-grid">
        <button wx:for="{{mediaList}}" wx:key="id" class="media-cell" data-id="{{item.id}}" bindtap="openMedia">
          <image wx:if="{{item.hasCover}}" class="media-thumb" src="{{item.coverPath}}" mode="aspectFill"></image>
          <view wx:elif="{{item.isVideo}}" class="video-fallback">
            <view class="video-fallback-icon">
              <text class="icon-play"></text>
            </view>
            <text class="video-fallback-label mono">VIDEO</text>
          </view>
          <view wx:else class="video-fallback photo-fallback">
            <ghost-logo size="{{62}}" />
          </view>
          <view wx:if="{{item.isVideo}}" class="video-badge">
            <text class="icon-play"></text>
          </view>
        </button>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{showImportSheet}}" class="sheet-mask" bindtap="closeImportSheet">
    <view class="sheet-card import-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <text class="sheet-title">添加照片或视频</text>
      <button class="sheet-option" bindtap="chooseFromSystemAlbum">
        <view class="option-icon album-icon"></view>
        <view>
          <text class="option-title">从系统相册选择</text>
          <text class="option-desc">选择本机照片、视频并复制到小程序沙盒。</text>
        </view>
      </button>
      <button class="sheet-option" bindtap="chooseFromChat">
        <view class="option-icon chat-icon"></view>
        <view>
          <text class="option-title">从微信聊天选择</text>
          <text class="option-desc">从聊天文件中选择图片或视频导入。</text>
        </view>
      </button>
      <button class="primary-button" bindtap="closeImportSheet">取消</button>
    </view>
  </view>

  <view wx:if="{{showAlbumMenu}}" class="sheet-mask" bindtap="closeAlbumMenu">
    <view class="sheet-card menu-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <text class="sheet-title">相册管理</text>
      <button class="sheet-option danger" bindtap="confirmDeleteAlbum">
        <view class="option-icon danger-icon"></view>
        <view>
          <text class="option-title">删除相册集</text>
          <text class="option-desc">删除该相册内的小程序本地文件。</text>
        </view>
      </button>
      <button class="sheet-cancel" bindtap="closeAlbumMenu">取消</button>
    </view>
  </view>
</view>
