.detail-content {
  display: flex;
  flex-direction: column;
  height: calc(100vh - env(safe-area-inset-top) - 28rpx);
  padding-bottom: 126rpx;
}

.detail-status {
  display: flex;
  justify-content: space-between;
  color: #4b5563;
  font-size: 18rpx;
  letter-spacing: 0.16em;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 0 18rpx;
  margin-top: 20rpx;
}

.icon-button {
  flex: 0 0 auto;
  color: #cbd5e1;
  width: 88rpx !important;
  height: 88rpx !important;
}

.album-title-wrap {
  flex: 1;
  min-width: 0;
}

.album-title,
.album-subtitle {
  display: block;
}

.album-title {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.94);
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-subtitle {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 19rpx;
}

.secondary-button {
  line-height: 78rpx !important;
}

.sheet-card {
  margin-bottom: env(safe-area-inset-bottom) !important;
  padding-bottom: 20rpx !important;
}

.privacy-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 12rpx;
  min-height: 48rpx;
  margin-bottom: 24rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.22);
  background: rgba(76, 29, 149, 0.25);
  color: #a78bfa;
  font-size: 19rpx;
  transform-origin: left center;
}

.privacy-badge .icon-lock {
  transform: scale(0.58);
}

.media-scroll {
  flex: 1;
  min-height: 0;
}

.media-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-content: flex-start;
  align-items: flex-start;
  padding-bottom: 32rpx;
}

.media-cell {
  position: relative;
  display: block;
  flex: 0 0 228.66rpx;
  width: 228.66rpx;
  height: 228.66rpx;
  padding-bottom: 0;
  overflow: hidden;
  border: 2rpx solid #070714;
  background: #111224;
  box-sizing: border-box;
  font-size: 0;
  line-height: 0;
  margin: 0 !important;
}

.media-thumb,
.video-fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.video-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background:
    radial-gradient(circle at 30% 20%, rgba(124, 111, 255, 0.36), transparent 38%),
    radial-gradient(circle at 78% 78%, rgba(0, 212, 255, 0.18), transparent 36%),
    linear-gradient(135deg, #111224 0%, #0d0e1e 100%);
}

.video-fallback-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.34);
  color: #ffffff;
  box-shadow: 0 0 24rpx rgba(124, 111, 255, 0.24);
}

.video-fallback-label {
  color: rgba(167, 139, 250, 0.82);
  font-size: 20rpx;
  letter-spacing: 0.18em;
  line-height: 1;
}

.photo-fallback {
  gap: 0;
}

.video-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  background: rgba(0, 0, 0, 0.48);
  color: #ffffff;
  transform: translate(-50%, -50%);
}

.media-empty {
  min-height: 540rpx;
}

.empty-title {
  margin-top: 28rpx;
  color: #c4c6d8;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-copy {
  width: 450rpx;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-button {
  width: 260rpx;
  margin-top: 28rpx;
}

.import-fab .icon-plus {
  width: 36rpx;
  height: 36rpx;
}

.import-fab .icon-plus::before {
  left: 16rpx;
  top: 2rpx;
  width: 5rpx;
  height: 32rpx;
}

.import-fab .icon-plus::after {
  left: 2rpx;
  top: 16rpx;
  width: 32rpx;
  height: 5rpx;
}

.import-fab.is-disabled {
  opacity: 0.55;
}

.import-sheet,
.menu-sheet {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sheet-handle {
  align-self: center;
  width: 70rpx;
  height: 8rpx;
  margin: 8rpx 0 10rpx;
  border-radius: 999rpx;
  background: rgba(100, 116, 139, 0.46);
}

.sheet-title {
  padding: 0 12rpx 10rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 118rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(100, 116, 139, 0.24);
  background: rgba(17, 18, 36, 0.95);
  text-align: left;
  width: 100% !important;
}

.sheet-option.danger {
  border-color: rgba(239, 68, 68, 0.24);
}

.option-icon {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(124, 111, 255, 0.86), rgba(0, 212, 255, 0.58));
  box-shadow: 0 0 28rpx rgba(124, 111, 255, 0.24);
}

.chat-icon {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.75), rgba(16, 185, 129, 0.6));
}

.danger-icon {
  background: linear-gradient(135deg, #ef4444, #991b1b);
}

.option-title,
.option-desc {
  display: block;
}

.option-title {
  color: #e8eaf6;
  font-size: 28rpx;
  font-weight: 700;
}

.option-desc {
  margin-top: 7rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.4;
}

.sheet-option.danger .option-title {
  color: #f87171;
}

.primary-button {
  width: 100% !important;
  margin-top: 20rpx;
}

.sheet-cancel {
  font-size: 28rpx !important;
  padding: 20rpx 0rpx !important;
}
