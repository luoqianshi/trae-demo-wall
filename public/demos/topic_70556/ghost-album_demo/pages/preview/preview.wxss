.preview-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #000000;
  color: #ffffff;
}

.video-stage {
  position: fixed;
  z-index: 1;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #000000;
}

.media-stage,
.preview-swiper,
.preview-swiper-item,
.preview-image,
.stage-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.preview-video {
  position: absolute;
  left: 0;
  top: 0;
  background: #000000;
}

.video-diagnostic {
  position: absolute;
  z-index: 2;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 52rpx);
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.34);
  background: rgba(24, 18, 8, 0.82);
  color: #fbbf24;
  font-size: 24rpx;
  line-height: 1.45;
}

.video-diagnostic text {
  display: block;
}

.preview-image,
.preview-video,
.preview-swiper {
  width: 100vw;
  height: 100vh;
}

.preview-swiper-item {
  width: 100%;
  height: 100%;
}

.preview-image.is-hidden {
  filter: blur(36rpx);
  transform: scale(1.04);
}

.stage-shade {
  pointer-events: none;
  background: linear-gradient(180deg, rgba(7, 7, 20, 0.72) 0%, rgba(7, 7, 20, 0.08) 36%, rgba(7, 7, 20, 0.92) 100%);
}

.watermark {
  position: absolute;
  left: 50%;
  top: 50%;
  opacity: 0.05;
  pointer-events: none;
  transform: translate(-50%, -50%);
}

.preview-top {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 32rpx;
  padding-right: 32rpx;
  margin-top: 20rpx;
}

.top-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx !important;
  height: 88rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.42);
  color: #ffffff;
  backdrop-filter: blur(16rpx);
  margin-left: 0rpx !important;
  margin-right: 0rpx !important;
}

.delete-top-button {
  color: #f87171;
}

.top-delete-icon {
  position: relative;
  display: block;
  width: 32rpx;
  height: 34rpx;
}

.top-delete-icon::before,
.top-delete-icon::after {
  position: absolute;
  content: "";
  background: currentColor;
}

.top-delete-icon::before {
  left: 7rpx;
  top: 11rpx;
  width: 18rpx;
  height: 20rpx;
  border-radius: 3rpx;
}

.top-delete-icon::after {
  left: 3rpx;
  top: 6rpx;
  width: 26rpx;
  height: 4rpx;
  border-radius: 4rpx;
}

.locked-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 50rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.38);
  background: rgba(0, 0, 0, 0.42);
  color: #a78bfa;
  font-size: 19rpx;
  backdrop-filter: blur(16rpx);
}

.locked-pill .icon-lock {
  transform: scale(0.54);
}

.preview-bottom {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 36rpx calc(env(safe-area-inset-bottom) + 38rpx);
}

.media-meta {
  margin-bottom: 34rpx;
}

.media-album,
.media-time {
  display: block;
}

.media-album {
  color: rgba(255, 255, 255, 0.84);
  font-size: 28rpx;
  font-weight: 700;
}

.media-time {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 19rpx;
}

.action-row {
  display: flex;
  justify-content: space-around;
}

.action-row button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 112rpx;
  color: #cbd5e1;
  font-size: 20rpx;
}

.action-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(16rpx);
}

.view-icon::before {
  width: 32rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  content: "";
}

.view-icon::after {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.hide-icon::before,
.hide-icon::after,
.share-icon::before,
.delete-icon::before,
.delete-icon::after {
  position: absolute;
  content: "";
  background: currentColor;
}

.hide-icon::before {
  width: 34rpx;
  height: 4rpx;
  border-radius: 4rpx;
  transform: rotate(-35deg);
}

.hide-icon::after {
  width: 30rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  background: transparent;
}

.share-icon::before {
  width: 28rpx;
  height: 28rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  background: transparent;
  transform: rotate(-45deg);
}

.delete-icon {
  color: #f87171;
}

.delete-icon::before {
  top: 24rpx;
  width: 28rpx;
  height: 30rpx;
  border-radius: 4rpx;
}

.delete-icon::after {
  top: 18rpx;
  width: 36rpx;
  height: 4rpx;
  border-radius: 4rpx;
}
