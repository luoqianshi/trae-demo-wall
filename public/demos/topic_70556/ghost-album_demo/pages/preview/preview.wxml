<view class="preview-page">
  <view wx:if="{{isVideo}}" class="video-stage">
    <video
      id="previewVideo"
      class="preview-video"
      src="{{videoSrc}}"
      poster="{{media.thumbPath}}"
      controls="{{true}}"
      autoplay="{{true}}"
      show-center-play-btn="{{true}}"
      show-fullscreen-btn="{{true}}"
      show-play-btn="{{true}}"
      show-mute-btn="{{true}}"
      enable-progress-gesture="{{true}}"
      enable-play-gesture="{{true}}"
      vslide-gesture="{{true}}"
      object-fit="contain"
      play-btn-position="center"
      bindloadedmetadata="onVideoLoadedMetadata"
      bindplay="onVideoPlay"
      bindpause="onVideoPause"
      bindwaiting="onVideoWaiting"
      bindended="onVideoEnded"
      bindtimeupdate="onVideoTimeUpdate"
      binderror="onVideoError"
    ></video>
    <view wx:if="{{videoDiagnosticText}}" class="video-diagnostic">
      <text>{{videoDiagnosticText}}</text>
    </view>
  </view>

  <view wx:else class="media-stage">
    <swiper
      class="preview-swiper"
      current="{{currentIndex}}"
      circular="{{photoList.length > 1}}"
      duration="{{260}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{photoList}}" wx:key="id" class="preview-swiper-item">
        <image class="preview-image {{hidden ? 'is-hidden' : ''}}" src="{{item.path}}" mode="aspectFit" bindtap="previewOriginal"></image>
      </swiper-item>
    </swiper>
    <view class="stage-shade"></view>
    <view class="watermark">
      <ghost-logo size="{{260}}" />
    </view>
  </view>

  <view class="preview-top safe-top">
    <button class="top-button" bindtap="goBack">
      <text class="icon-back"></text>
    </button>
    <view class="locked-pill">
      <text class="icon-lock"></text>
      <text wx:if="{{positionText}}" class="mono">{{positionText}}</text>
      <text wx:else class="mono">已保护</text>
    </view>
    <button wx:if="{{isVideo}}" class="top-button delete-top-button" bindtap="confirmDelete">
      <text class="top-delete-icon"></text>
    </button>
    <!-- <button class="top-button" bindtap="showShareTip">
      <text class="icon-more"></text>
    </button> -->
  </view>

  <view wx:if="{{isImage}}" class="preview-bottom">
    <view class="media-meta">
      <text class="media-album">{{album.name}}</text>
      <text class="media-time mono">
        <text wx:if="{{positionText}}">{{positionText}} · </text>{{media.createdLabel}} · {{isVideo ? "视频" : "照片"}}
      </text>
    </view>
    <view class="action-row">
      <button wx:if="{{isImage}}" bindtap="previewOriginal">
        <view class="action-icon view-icon"></view>
        <text>原图</text>
      </button>
      <button wx:if="{{isImage}}" bindtap="toggleHidden">
        <view class="action-icon hide-icon"></view>
        <text>{{hidden ? "显示" : "隐藏"}}</text>
      </button>
      <!-- <button bindtap="showShareTip">
        <view class="action-icon share-icon"></view>
        <text>分享</text>
      </button> -->
      <button bindtap="confirmDelete">
        <view class="action-icon delete-icon"></view>
        <text>删除</text>
      </button>
    </view>
  </view>
</view>
