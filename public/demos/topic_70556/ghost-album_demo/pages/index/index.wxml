<view class="page home-page safe-top">
  <view class="content home-content">

    <view class="home-header">
      <view class="brand-row">
        <ghost-logo size="{{54}}" />
        <text class="home-title brand-title">幽灵相册</text>
      </view>
      <view class="header-actions">
        <button class="icon-button primary" bindtap="openAlbumModal">
          <text class="icon-plus"></text>
        </button>
      </view>
    </view>

    <view class="search-box">
      <text class="icon-search"></text>
      <input class="search-input" placeholder="搜索私密相册..." placeholder-class="search-placeholder" value="{{query}}" bindinput="onSearchInput" />
    </view>

    <view class="section-row">
      <text class="section-label mono">PRIVATE ALBUMS</text>
      <text class="section-count">{{visibleAlbums.length}} 个</text>
    </view>

    <scroll-view class="album-scroll" scroll-y="{{true}}">
      <view wx:if="{{visibleAlbums.length === 0}}" class="empty-state">
        <ghost-logo size="{{104}}" glow="{{true}}" />
        <text class="empty-title">{{query ? "没有匹配相册" : "还没有相册集"}}</text>
        <text class="empty-copy">{{query ? "换个关键词试试" : "创建一个相册集，开始导入私密照片和视频"}}</text>
        <button wx:if="{{!query}}" class="secondary-button empty-button" style="line-height: 80rpx;" bindtap="openAlbumModal">添加相册集</button>
      </view>

      <view wx:else class="album-grid">
        <button wx:for="{{visibleAlbums}}" wx:key="id" class="album-card" data-id="{{item.id}}" bindtap="openAlbum">
          <image wx:if="{{item.coverPath}}" class="album-cover" src="{{item.coverPath}}" mode="aspectFill"></image>
          <view wx:else class="album-placeholder">
            <ghost-logo size="{{84}}" glow="{{true}}" />
          </view>
          <view class="album-shade"></view>
          <view class="album-lock">
            <image class="album-lock-img" src="/assets/album-lock.png" mode="aspectFit"></image>
          </view>
          <view class="album-meta">
            <text class="album-name">{{item.name}}</text>
            <text class="album-count mono">{{item.photoCount}} 图 · {{item.videoCount}} 视频</text>
          </view>
        </button>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{showAlbumModal}}" class="modal-mask">
    <view class="modal-card album-modal">
      <view class="modal-header">
        <view>
          <text class="modal-kicker mono">NEW ALBUM</text>
          <text class="modal-title">添加相册集</text>
        </view>
        <button class="icon-button pop-close" bindtap="closeAlbumModal">
          <text class="icon-close"></text>
        </button>
      </view>
      <input class="field" maxlength="24" placeholder="例如：私密日记" placeholder-class="placeholder" value="{{albumName}}" bindinput="onAlbumNameInput" bindconfirm="submitAlbum" />
      <text wx:if="{{errorText}}" class="error-text">{{errorText}}</text>
      <button class="primary-button modal-submit" bindtap="submitAlbum">创建相册集</button>
    </view>
  </view>
</view>
