.home-page {
  min-height: 100vh;
}

.home-content {
  display: flex;
  flex-direction: column;
  height: calc(100vh - env(safe-area-inset-top) - 28rpx);
  padding-bottom: 128rpx;
}

.home-status {
  display: flex;
  justify-content: space-between;
  color: #4b5563;
  font-size: 18rpx;
  letter-spacing: 0.16em;
}

.status-mark {
  color: rgba(124, 111, 255, 0.52);
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 20rpx;
  margin-top: 20rpx;
}

.brand-row,
.header-actions {
  display: flex;
  align-items: center;
}

.brand-row {
  gap: 14rpx;
}

.header-actions {
  gap: 16rpx;
}

.home-title {
  color: rgba(255, 255, 255, 0.92);
  font-size: 30rpx;
}

.icon-button {
  color: #94a3b8;
  width: 80rpx !important;
  height: 80rpx;
}

.icon-button.primary {
  color: #ffffff;
}

.pop-close {
  margin-right: 0rpx !important;
  width: 60rpx !important;
  height: 60rpx !important;
  line-height: 60rpx !important;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(100, 116, 139, 0.25);
  background: rgba(30, 41, 59, 0.42);
  color: #475569;
}

.search-input {
  flex: 1;
  height: 78rpx;
  color: #e8eaf6;
  font-size: 25rpx;
}

.search-placeholder {
  color: #475569;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 18rpx;
}

/* .secondary-button {
  line-height: 84rpx !important;
} */

.section-label {
  color: #4b5563;
  font-size: 18rpx;
  letter-spacing: 0.22em;
}

.section-count {
  color: rgba(124, 111, 255, 0.72);
  font-size: 23rpx;
}

.album-scroll {
  flex: 1;
  min-height: 0;
}

.album-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: flex-start;
  align-items: flex-start;
  padding-bottom: 32rpx;
}

.album-card {
  position: relative;
  flex: 0 0 333rpx;
  width: 333rpx;
  height: 330rpx;
  margin: 0 0 20rpx 0 !important;
  overflow: hidden;
  border-radius: 28rpx;
  background: #111224;
  box-sizing: border-box;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.26);
}

.album-cover,
.album-placeholder,
.album-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.album-cover {
  width: 100%;
  height: 100%;
}

.album-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 30% 22%, rgba(124, 111, 255, 0.35), transparent 34%),
    radial-gradient(circle at 75% 78%, rgba(0, 212, 255, 0.16), transparent 36%),
    #111224;
}

.album-shade {
  background: linear-gradient(180deg, rgba(7, 7, 20, 0) 0%, rgba(7, 7, 20, 0.22) 45%, rgba(7, 7, 20, 0.94) 100%);
}

.album-lock {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.42);
  background: rgba(7, 7, 20, 0.74);
  color: #a78bfa;
  transform: scale(0.72);
}

.album-lock-img {
  display: block;
  width: 26rpx;
  height: 26rpx;
}

.album-meta {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.album-name {
  max-width: 100%;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-count {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 19rpx;
}

.empty-title {
  margin-top: 28rpx;
  color: #c4c6d8;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-copy {
  width: 440rpx;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-button {
  width: 300rpx;
  margin-top: 28rpx;
}

.bottom-nav {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  padding: 16rpx 64rpx calc(env(safe-area-inset-bottom) + 16rpx);
  border-top: 1rpx solid rgba(30, 41, 59, 0.82);
  background: rgba(7, 7, 20, 0.96);
  backdrop-filter: blur(16rpx);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  width: 108rpx;
  color: #475569;
  font-size: 20rpx;
}

.nav-item.active {
  color: #a78bfa;
}

.nav-item.active view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #a78bfa;
}

.nav-grid,
.nav-clock,
.nav-gear {
  position: relative;
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.nav-grid {
  background:
    linear-gradient(currentColor, currentColor) left top / 12rpx 12rpx no-repeat,
    linear-gradient(currentColor, currentColor) right top / 12rpx 12rpx no-repeat,
    linear-gradient(currentColor, currentColor) left bottom / 12rpx 12rpx no-repeat,
    linear-gradient(currentColor, currentColor) right bottom / 12rpx 12rpx no-repeat;
}

.nav-clock {
  border: 3rpx solid currentColor;
  border-radius: 999rpx;
}

.nav-clock::after {
  position: absolute;
  left: 13rpx;
  top: 6rpx;
  width: 3rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: currentColor;
  box-shadow: 5rpx 8rpx 0 currentColor;
  content: "";
}

.nav-gear {
  border: 4rpx solid currentColor;
  border-radius: 999rpx;
}

.nav-gear::after {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.album-modal {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-kicker,
.modal-title,
.error-text {
  display: block;
}

.modal-kicker {
  color: rgba(124, 111, 255, 0.62);
  font-size: 18rpx;
  letter-spacing: 0.22em;
}

.modal-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.placeholder {
  color: #475569;
}

.error-text {
  color: #f87171;
  font-size: 23rpx;
}

.modal-card {
  margin-bottom: 64rpx;
}

.field {
  border-radius: 44rpx !important;
}

.modal-submit {
  height: 88rpx !important;
  line-height: 88rpx !important;
  width: 100% !important;
}
