.intro-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 36rpx);
}

.intro-content {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - env(safe-area-inset-top) - 28rpx);
}

.intro-status {
  display: flex;
  justify-content: space-between;
  color: rgba(124, 111, 255, 0.48);
  font-size: 18rpx;
  letter-spacing: 0.2em;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 0 34rpx;
  text-align: center;
  margin-top: 100rpx;
}

.hero-rings {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 250rpx;
}

.ring {
  position: absolute;
  border-radius: 999rpx;
}

.ring-a {
  width: 214rpx;
  height: 214rpx;
  border: 1rpx solid rgba(124, 111, 255, 0.22);
  box-shadow: 0 0 80rpx rgba(124, 111, 255, 0.14);
}

.ring-b {
  width: 260rpx;
  height: 260rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.12);
}

.hero-title {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.96);
  font-size: 42rpx;
  text-shadow: 0 0 42rpx rgba(124, 111, 255, 0.55);
}

.hero-subtitle {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 18rpx;
}

.hero-subtitle view {
  width: 72rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(124, 111, 255, 0.6));
}

.hero-subtitle view:last-child {
  background: linear-gradient(90deg, rgba(124, 111, 255, 0.6), transparent);
}

.hero-subtitle text {
  color: #7c6fff;
  font-size: 22rpx;
  letter-spacing: 0.38em;
}

.hero-copy {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.intro-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-kicker {
  color: rgba(124, 111, 255, 0.6);
  font-size: 18rpx;
  letter-spacing: 0.22em;
}

.section-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.feature-item {
  display: flex;
  gap: 18rpx;
}

.feature-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #7c6fff;
  box-shadow: 0 0 18rpx rgba(124, 111, 255, 0.72);
}

.feature-dot.cyan {
  background: #00d4ff;
  box-shadow: 0 0 18rpx rgba(0, 212, 255, 0.55);
}

.feature-title,
.feature-desc {
  display: block;
}

.feature-title {
  color: #e8eaf6;
  font-size: 27rpx;
  font-weight: 700;
}

.feature-desc {
  margin-top: 6rpx;
  color: #7b8496;
  font-size: 23rpx;
  line-height: 1.5;
}

.risk-card {
  border: 1rpx solid rgba(245, 158, 11, 0.24);
  background: rgba(49, 37, 18, 0.34);
}

.risk-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  color: #c4a76a;
  font-size: 23rpx;
  line-height: 1.55;
}

.start-button {
  margin-top: 28rpx;
  margin-bottom: 12rpx;
}

.password-modal {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-bottom: env(safe-area-inset-bottom);
}

.icon-button {
  width: 80rpx !important;
  height: 80rpx !important;
  margin-right: 0rpx !important;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-kicker,
.modal-title,
.modal-copy,
.error-text {
  display: block;
}

.modal-kicker {
  color: rgba(124, 111, 255, 0.62);
  font-size: 18rpx;
  letter-spacing: 0.22em;
}

.modal-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.modal-copy {
  color: #7b8496;
  font-size: 24rpx;
  line-height: 1.5;
}

.modal-submit {
  height: 88rpx;
  line-height: 88rpx;
}

.placeholder {
  color: #475569;
}

.error-text {
  color: #f87171;
  font-size: 23rpx;
}

.ghost-button {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 24rpx;
  background: transparent;
  color: #7b8496;
  font-size: 26rpx;
}

.modal-link {
  margin-top: -8rpx;
}
