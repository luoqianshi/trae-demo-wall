/* app.wxss - 比邻全局样式与设计系统 */

/* ============ 设计令牌 Design Tokens ============ */
page {
  /* 主色调 - 天空蓝渐变系 */
  --color-primary: #1890FF;
  --color-primary-light: #4FACFE;
  --color-primary-dark: #096DD9;
  --color-primary-bg: #E6F4FF;

  /* 暖色辅助 - 社区温度 */
  --color-coral: #FF6B6B;
  --color-coral-light: #FF9A8B;
  --color-coral-bg: #FFF1F0;
  --color-amber: #FAAD14;
  --color-amber-bg: #FFF7E6;

  /* 功能色 */
  --color-success: #52C41A;
  --color-success-bg: #F6FFED;
  --color-warning: #FAAD14;
  --color-danger: #FF4D4F;
  --color-info: #1890FF;

  /* 中性色 */
  --color-bg: #F5F7FA;
  --color-card: #FFFFFF;
  --color-border: #EBEEF5;
  --color-divider: #F0F2F5;

  /* 文字色 */
  --text-primary: #1A1A2E;
  --text-regular: #4A5568;
  --text-secondary: #718096;
  --text-placeholder: #A0AEC0;
  --text-disabled: #CBD5E0;
  --text-inverse: #FFFFFF;

  /* 渐变 */
  --gradient-sky: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  --gradient-coral: linear-gradient(135deg, #FF9A8B 0%, #FF6A88 100%);
  --gradient-mint: linear-gradient(135deg, #43E97B 0%, #38F9D7 100%);
  --gradient-sunset: linear-gradient(135deg, #FA709A 0%, #FEE140 100%);
  --gradient-purple: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 999rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  --shadow-primary: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
  --shadow-coral: 0 8rpx 24rpx rgba(255, 107, 107, 0.25);

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ============ 通用工具类 ============ */

/* 卡片 */
.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: var(--space-md);
}

.card-flat {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
}

/* 渐变背景 */
.bg-sky { background: var(--gradient-sky); }
.bg-coral { background: var(--gradient-coral); }
.bg-mint { background: var(--gradient-mint); }

/* 文字 */
.text-primary { color: var(--text-primary); }
.text-regular { color: var(--text-regular); }
.text-secondary { color: var(--text-secondary); }
.text-placeholder { color: var(--text-placeholder); }
.text-brand { color: var(--color-primary); }
.text-coral { color: var(--color-coral); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger { color: var(--color-danger); }
.text-inverse { color: var(--text-inverse); }

.text-xs { font-size: 20rpx; }
.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 44rpx; }
.text-bold { font-weight: 600; }
.text-bold-7 { font-weight: 700; }

/* 布局 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-start { display: flex; align-items: center; justify-content: flex-start; }
.flex-end { display: flex; align-items: center; justify-content: flex-end; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }

/* 间距 */
.mt-xs { margin-top: var(--space-xs); }
.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mb-xs { margin-bottom: var(--space-xs); }
.mb-sm { margin-bottom: var(--space-sm); }
.mb-md { margin-bottom: var(--space-md); }
.mb-lg { margin-bottom: var(--space-lg); }
.ml-xs { margin-left: var(--space-xs); }
.ml-sm { margin-left: var(--space-sm); }
.ml-md { margin-left: var(--space-md); }
.mr-xs { margin-right: var(--space-xs); }
.mr-sm { margin-right: var(--space-sm); }
.mr-md { margin-right: var(--space-md); }
.p-sm { padding: var(--space-sm); }
.p-md { padding: var(--space-md); }
.p-lg { padding: var(--space-lg); }
.px-md { padding-left: var(--space-md); padding-right: var(--space-md); }
.py-sm { padding-top: var(--space-sm); padding-bottom: var(--space-sm); }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  border: none;
}

.btn::after { border: none; }

.btn-primary {
  background: var(--gradient-sky);
  color: var(--text-inverse);
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-coral {
  background: var(--gradient-coral);
  color: var(--text-inverse);
  box-shadow: var(--shadow-coral);
}

.btn-coral:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-outline {
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-outline:active {
  background: var(--color-primary-bg);
}

.btn-disabled {
  background: var(--color-divider);
  color: var(--text-placeholder);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary { background: var(--color-primary-bg); color: var(--color-primary); }
.tag-success { background: var(--color-success-bg); color: var(--color-success); }
.tag-warning { background: var(--color-amber-bg); color: var(--color-warning); }
.tag-coral { background: var(--color-coral-bg); color: var(--color-coral); }
.tag-default { background: var(--color-divider); color: var(--text-secondary); }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: var(--space-md) 0;
}

/* 安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面容器 */
.page-container {
  min-height: 100vh;
  padding: var(--space-md);
  box-sizing: border-box;
}

/* 滚动隐藏 */
::-webkit-scrollbar { display: none; }

/* 动画 */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideInRight {
  from { opacity: 0; transform: translateX(40rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.animate-fade-in-up { animation: fadeInUp 0.5s ease both; }
.animate-fade-in { animation: fadeIn 0.4s ease both; }
.animate-slide-in { animation: slideInRight 0.4s ease both; }
