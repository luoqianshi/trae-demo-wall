<!-- components/empty-state/empty-state.wxml -->
<view class="empty-state">
  <view class="empty-state__icon-wrap">
    <text class="empty-state__icon">{{icon}}</text>
  </view>
  <text class="empty-state__text">{{text}}</text>
  <text class="empty-state__sub-text" wx:if="{{subText}}">{{subText}}</text>
  <button wx:if="{{actionText}}" class="empty-state__btn" bindtap="onAction">{{actionText}}</button>
</view>
