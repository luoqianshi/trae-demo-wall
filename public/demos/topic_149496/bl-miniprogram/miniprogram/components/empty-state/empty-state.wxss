/* components/empty-state/empty-state.wxss */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state__icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F0F4FF 0%, #FFF0F3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-state__icon {
  font-size: 72rpx;
}

.empty-state__text {
  font-size: 30rpx;
  color: #718096;
  font-weight: 500;
}

.empty-state__sub-text {
  font-size: 24rpx;
  color: #A0AEC0;
  margin-top: 12rpx;
}

.empty-state__btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

.empty-state__btn::after { border: none; }
