/* components/idle-card/idle-card.wxss */
.idle-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  margin-bottom: 20rpx;
}

.idle-card:active {
  transform: scale(0.98);
}

.idle-card__image-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: #F0F2F5;
}

.idle-card__image {
  width: 100%;
  height: 100%;
}

.idle-card__image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F0F4FF 0%, #FFF0F3 100%);
}

.idle-card__image-placeholder-icon {
  font-size: 64rpx;
  opacity: 0.4;
}

.idle-card__content {
  padding: 20rpx 24rpx 24rpx;
}

.idle-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.idle-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.idle-card__price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.idle-card__price-symbol {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.idle-card__price {
  font-size: 38rpx;
  color: #FF6B6B;
  font-weight: 700;
  line-height: 1;
}

.idle-card__original-price {
  font-size: 22rpx;
  color: #A0AEC0;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.idle-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.idle-card__user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.idle-card__category {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.idle-card__nickname {
  font-size: 22rpx;
  color: #A0AEC0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.idle-card__time {
  font-size: 22rpx;
  color: #A0AEC0;
  flex-shrink: 0;
}

.idle-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0F2F5;
}

.idle-card__distance {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #E6F7FF 0%, #BAE7FF 100%);
  border-radius: 999rpx;
}

.idle-card__distance-icon {
  font-size: 20rpx;
}

.idle-card__distance-text {
  font-size: 22rpx;
  color: #1890FF;
  font-weight: 600;
}

.idle-card__community {
  font-size: 22rpx;
  color: #718096;
}
