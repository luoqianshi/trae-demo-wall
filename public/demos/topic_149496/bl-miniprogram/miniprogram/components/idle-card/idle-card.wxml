<!-- components/idle-card/idle-card.wxml -->
<view class="idle-card" bindtap="onTap">
  <view class="idle-card__image-wrap">
    <image wx:if="{{coverImage}}" class="idle-card__image" src="{{coverImage}}" mode="aspectFill" lazy-load></image>
    <view wx:else class="idle-card__image-placeholder">
      <text class="idle-card__image-placeholder-icon">📷</text>
    </view>
  </view>
  <view class="idle-card__content">
    <view class="idle-card__header">
      <text class="idle-card__name">{{item.name}}</text>
      <view class="tag {{item.status === '已出售' ? 'tag-default' : 'tag-primary'}}">{{item.status}}</view>
    </view>
    <view class="idle-card__price-row">
      <text class="idle-card__price-symbol">¥</text>
      <text class="idle-card__price">{{item.price}}</text>
      <text class="idle-card__original-price" wx:if="{{item.original_price}}">¥{{item.original_price}}</text>
    </view>
    <view class="idle-card__footer">
      <view class="idle-card__user">
        <text class="idle-card__category" style="color: {{categoryConfig.color}}; background: {{categoryConfig.bg}};">{{item.category}}</text>
        <text class="idle-card__nickname">{{item.userInfo.nickname || '匿名邻居'}}</text>
        <credit-badge wx:if="{{item.userInfo}}" level="{{item.userInfo.credit_level}}" score="{{item.userInfo.credit_score}}" size="sm"></credit-badge>
      </view>
      <text class="idle-card__time">{{timeText}}</text>
    </view>
    <view class="idle-card__meta">
      <view class="idle-card__distance" wx:if="{{distanceText}}">
        <text class="idle-card__distance-icon">📍</text>
        <text class="idle-card__distance-text">{{distanceText}}</text>
      </view>
      <text class="idle-card__community" wx:if="{{item.community}}">🏘️ {{item.community}}</text>
    </view>
  </view>
</view>
