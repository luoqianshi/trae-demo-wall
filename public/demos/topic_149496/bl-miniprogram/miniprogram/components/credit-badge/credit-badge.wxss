/* components/credit-badge/credit-badge.wxss */
.credit-badge {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  color: #fff;
  font-weight: 600;
  white-space: nowrap;
}

.credit-badge__icon {
  line-height: 1;
}

.credit-badge__text {
  line-height: 1;
}

/* 尺寸 */
.credit-badge--sm {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  gap: 4rpx;
}
.credit-badge--sm .credit-badge__icon { font-size: 20rpx; }

.credit-badge--md {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  gap: 6rpx;
}
.credit-badge--md .credit-badge__icon { font-size: 24rpx; }

.credit-badge--lg {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  gap: 8rpx;
}
.credit-badge--lg .credit-badge__icon { font-size: 30rpx; }
