/* components/help-card/help-card.wxss */
.help-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.help-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.help-card__body {
  display: flex;
  gap: 20rpx;
}

.help-card__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.help-card__icon-emoji {
  font-size: 44rpx;
}

.help-card__content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.help-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.help-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.help-card__status {
  flex-shrink: 0;
}

.help-card__desc {
  font-size: 26rpx;
  color: #718096;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

.help-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.help-card__user {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.help-card__type-label {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.help-card__nickname {
  font-size: 24rpx;
  color: #718096;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}

.help-card__time {
  font-size: 22rpx;
  color: #A0AEC0;
  flex-shrink: 0;
}

.help-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F2F5;
}

.help-card__distance {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #E6F7FF 0%, #BAE7FF 100%);
  border-radius: 999rpx;
}

.help-card__distance-icon {
  font-size: 20rpx;
}

.help-card__distance-text {
  font-size: 22rpx;
  color: #1890FF;
  font-weight: 600;
}

.help-card__community {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.help-card__community-text {
  font-size: 22rpx;
  color: #718096;
}
