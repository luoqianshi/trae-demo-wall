<!-- components/help-card/help-card.wxml -->
<view class="help-card" bindtap="onTap">
  <view class="help-card__body">
    <view class="help-card__icon" style="background: {{typeConfig.bg}};">
      <text class="help-card__icon-emoji">{{typeConfig.icon}}</text>
    </view>
    <view class="help-card__content">
      <view class="help-card__header">
        <text class="help-card__title">{{item.title}}</text>
        <view class="help-card__status tag {{item.status === '已完成' ? 'tag-success' : 'tag-warning'}}">{{item.status}}</view>
      </view>
      <text class="help-card__desc" wx:if="{{item.description}}">{{item.description}}</text>
      <view class="help-card__footer">
        <view class="help-card__user">
          <text class="help-card__type-label" style="color: {{typeConfig.color}}; background: {{typeConfig.bg}};">{{item.type}}</text>
          <text class="help-card__nickname">{{item.userInfo.nickname || '匿名邻居'}}</text>
          <credit-badge wx:if="{{item.userInfo}}" level="{{item.userInfo.credit_level}}" score="{{item.userInfo.credit_score}}" size="sm"></credit-badge>
        </view>
        <text class="help-card__time">{{timeText}}</text>
      </view>
    </view>
  </view>
  <view class="help-card__meta">
    <view class="help-card__distance" wx:if="{{distanceText}}">
      <text class="help-card__distance-icon">📍</text>
      <text class="help-card__distance-text">{{distanceText}}</text>
    </view>
    <view class="help-card__community" wx:if="{{showCommunity && item.community}}">
      <text class="help-card__community-text">{{item.community}}</text>
    </view>
  </view>
</view>
