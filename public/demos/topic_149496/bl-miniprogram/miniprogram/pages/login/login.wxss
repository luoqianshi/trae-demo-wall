/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #4FACFE 0%, #00C6FB 35%, #5B86E5 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  padding-top: 160rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰气泡 */
.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.login-bg__bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.login-bg__bubble--1 { width: 300rpx; height: 300rpx; top: -80rpx; right: -60rpx; }
.login-bg__bubble--2 { width: 200rpx; height: 200rpx; top: 200rpx; left: -80rpx; background: rgba(255, 255, 255, 0.06); }
.login-bg__bubble--3 { width: 160rpx; height: 160rpx; bottom: 200rpx; right: -40rpx; background: rgba(255, 154, 139, 0.15); }
.login-bg__bubble--4 { width: 120rpx; height: 120rpx; bottom: 400rpx; left: 60rpx; background: rgba(255, 255, 255, 0.05); }

/* Logo区 */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  position: relative;
  z-index: 1;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);
}

.login-logo__emoji { font-size: 80rpx; }
.login-title { font-size: 56rpx; font-weight: 700; color: #fff; letter-spacing: 4rpx; margin-bottom: 12rpx; }
.login-subtitle { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); letter-spacing: 2rpx; }

/* 登录卡片 */
.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 36rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.12);
  position: relative;
  z-index: 1;
}

.login-card__header { margin-bottom: 40rpx; }
.login-card__title { display: block; font-size: 40rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 8rpx; }
.login-card__desc { font-size: 26rpx; color: #718096; }

/* 表单字段 */
.login-field { margin-bottom: 24rpx; }
.login-field__label { display: block; font-size: 26rpx; font-weight: 600; color: #4A5568; margin-bottom: 16rpx; }

.login-field__optional { font-size: 22rpx; font-weight: 400; color: #A0AEC0; margin-left: 4rpx; }

/* 头像选择按钮 */
.login-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
  border: 2rpx dashed #CBD5E0;
  overflow: hidden;
}

.login-avatar-btn::after { border: none; }

.login-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.login-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.login-avatar-placeholder__icon { font-size: 40rpx; }
.login-avatar-placeholder__text { font-size: 20rpx; color: #A0AEC0; }

/* 输入框 */
.login-input {
  height: 96rpx;
  padding: 0 32rpx;
  background: #F5F7FA;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  font-size: 30rpx;
  color: #1A1A2E;
  transition: all 0.2s ease;
}

.login-input--filled {
  background: #E6F4FF;
  border-color: #1890FF;
}

.login-input__placeholder { color: #A0AEC0; }

/* 定位样式 */
.login-location {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 32rpx;
  background: #F5F7FA;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.login-location--filled { background: linear-gradient(135deg, #E6F4FF 0%, #F0F9FF 100%); border-color: #1890FF; }
.login-location--denied { background: #FFF5F5; border-color: #FF6B6B; }

.login-location__loading,
.login-location__filled,
.login-location__empty {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}

.login-location__icon { font-size: 32rpx; color: #1890FF; font-weight: 700; }

.login-location--filled .login-location__icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #1890FF;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.login-location__text {
  font-size: 26rpx;
  color: #4A5568;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-location__spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #1890FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #43E97B 0%, #38F9D7 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(67, 233, 123, 0.35);
  transition: all 0.2s ease;
  margin-bottom: 40rpx;
  margin-top: 16rpx;
}

.login-btn::after { border: none; }
.login-btn:active { transform: scale(0.97); }

.login-btn--disabled {
  background: #E0E0E0;
  box-shadow: none;
  color: #A0AEC0;
}

.login-btn__content { display: flex; align-items: center; gap: 12rpx; }
.login-btn__icon { font-size: 36rpx; }
.login-btn__loading { font-size: 30rpx; }

/* 功能亮点 */
.login-features {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0 8rpx;
}

.login-feature { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.login-feature__icon { font-size: 40rpx; }
.login-feature__text { font-size: 22rpx; color: #718096; font-weight: 500; }
.login-feature__divider { width: 1rpx; height: 48rpx; background: #E0E0E0; }

/* 底部 */
.login-footer {
  margin-top: auto;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
  position: relative;
  z-index: 1;
}

.login-footer__text { font-size: 22rpx; color: rgba(255, 255, 255, 0.7); }
