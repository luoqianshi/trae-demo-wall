<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- 装饰背景 -->
  <view class="login-bg">
    <view class="login-bg__bubble login-bg__bubble--1"></view>
    <view class="login-bg__bubble login-bg__bubble--2"></view>
    <view class="login-bg__bubble login-bg__bubble--3"></view>
    <view class="login-bg__bubble login-bg__bubble--4"></view>
  </view>

  <!-- 顶部Logo区 -->
  <view class="login-header">
    <view class="login-logo">
      <text class="login-logo__emoji">🏘️</text>
    </view>
    <text class="login-title">比邻</text>
    <text class="login-subtitle">基于附近位置的邻里互助 · 闲置交易</text>
  </view>

  <!-- 第一步：微信登录 -->
  <view wx:if="{{step === 'init'}}" class="login-card">
    <view class="login-card__header">
      <text class="login-card__title">欢迎加入</text>
      <text class="login-card__desc">使用微信登录，查看附近邻居的互助和闲置信息</text>
    </view>

    <!-- 微信登录按钮 -->
    <button
      class="login-btn {{checking ? 'login-btn--disabled' : ''}}"
      bindtap="onWeChatLogin"
      disabled="{{checking}}"
    >
      <text wx:if="{{checking}}" class="login-btn__loading">登录中...</text>
      <view wx:else class="login-btn__content">
        <text class="login-btn__icon">💚</text>
        <text>微信一键登录</text>
      </view>
    </button>

    <!-- 功能亮点 -->
    <view class="login-features">
      <view class="login-feature">
        <text class="login-feature__icon">📍</text>
        <text class="login-feature__text">附近互助</text>
      </view>
      <view class="login-feature__divider"></view>
      <view class="login-feature">
        <text class="login-feature__icon">🛍️</text>
        <text class="login-feature__text">闲置交易</text>
      </view>
      <view class="login-feature__divider"></view>
      <view class="login-feature">
        <text class="login-feature__icon">💬</text>
        <text class="login-feature__text">即时聊天</text>
      </view>
    </view>
  </view>

  <!-- 第二步：新用户完善信息 -->
  <view wx:if="{{step === 'register'}}" class="login-card">
    <view class="login-card__header">
      <text class="login-card__title">完善信息</text>
      <text class="login-card__desc">设置你的头像、昵称和社区即可完成注册</text>
    </view>

    <!-- 头像选择 -->
    <view class="login-field">
      <text class="login-field__label">头像<text class="login-field__optional">（可选）</text></text>
      <button class="login-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatar}}" class="login-avatar-img" src="{{avatar}}" mode="aspectFill"></image>
        <view wx:else class="login-avatar-placeholder">
          <text class="login-avatar-placeholder__icon">📷</text>
          <text class="login-avatar-placeholder__text">点击使用微信头像</text>
        </view>
      </button>
    </view>

    <!-- 昵称输入 -->
    <view class="login-field">
      <text class="login-field__label">昵称</text>
      <input
        class="login-input {{nickname ? 'login-input--filled' : ''}}"
        type="nickname"
        placeholder="请输入昵称"
        placeholder-class="login-input__placeholder"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <!-- 社区输入 -->
    <view class="login-field">
      <text class="login-field__label">所属社区</text>
      <input
        class="login-input {{community ? 'login-input--filled' : ''}}"
        placeholder="如：阳光小区"
        placeholder-class="login-input__placeholder"
        value="{{community}}"
        bindinput="onCommunityInput"
        maxlength="20"
      />
    </view>

    <!-- 定位获取（演示用：暂不显示，正式使用时恢复）
    <view class="login-field">
      <text class="login-field__label">📍 当前位置</text>
      <view
        class="login-location {{location ? 'login-location--filled' : ''}} {{locationDenied ? 'login-location--denied' : ''}}"
        bindtap="getLocation"
      >
        <view wx:if="{{locationLoading}}" class="login-location__loading">
          <text class="login-location__spinner"></text>
          <text class="login-location__text">正在定位...</text>
        </view>
        <view wx:elif="{{location}}" class="login-location__filled">
          <text class="login-location__icon">✓</text>
          <text class="login-location__text">{{locationText}}</text>
        </view>
        <view wx:else class="login-location__empty">
          <text class="login-location__icon">📡</text>
          <text class="login-location__text">{{locationDenied ? '定位失败，点击重试' : '点击获取当前位置'}}</text>
        </view>
      </view>
    </view>
    -->

    <!-- 注册按钮 -->
    <button
      class="login-btn {{loading ? 'login-btn--disabled' : ''}}"
      bindtap="onRegister"
      disabled="{{loading}}"
    >
      <text wx:if="{{loading}}" class="login-btn__loading">注册中...</text>
      <view wx:else class="login-btn__content">
        <text class="login-btn__icon">✨</text>
        <text>完成注册</text>
      </view>
    </button>
  </view>

  <!-- 底部协议 -->
  <view class="login-footer">
    <text class="login-footer__text">登录即代表同意《用户协议》和《隐私政策》</text>
  </view>
</view>
