<!-- pages/chat/detail/detail.wxml -->
<view class="chat-detail-page">
  <!-- 信息标题提示 -->
  <view wx:if="{{itemTitle}}" class="chat-item-tip">
    <text class="chat-item-tip__icon">📌</text>
    <text class="chat-item-tip__text">关于：{{itemTitle}}</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="chat-messages"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="chat-messages__inner">
      <view
        wx:for="{{messages}}"
        wx:key="_id"
        id="msg-{{index}}"
        class="chat-msg-wrapper"
      >
        <!-- 时间分隔符 -->
        <view wx:if="{{item.showTime}}" class="chat-time">
          <text class="chat-time__text">{{item.timeText}}</text>
        </view>

        <!-- 消息气泡 -->
        <view class="chat-msg {{item.isMine ? 'chat-msg--mine' : ''}}">
          <view class="chat-msg__avatar-wrap">
            <image wx:if="{{item.isMine && myAvatar}}" class="chat-msg__avatar" src="{{myAvatar}}" mode="aspectFill"></image>
            <view wx:elif="{{item.isMine}}" class="chat-msg__avatar chat-msg__avatar--mine">
              <text>{{myNickname ? myNickname[0] : '我'}}</text>
            </view>
            <image wx:elif="{{otherUser.avatar}}" class="chat-msg__avatar" src="{{otherUser.avatar}}" mode="aspectFill"></image>
            <view wx:else class="chat-msg__avatar chat-msg__avatar--other">
              <text>{{otherUser.nickname ? otherUser.nickname[0] : '邻'}}</text>
            </view>
          </view>
          <view class="chat-msg__bubble {{item.isMine ? 'chat-msg__bubble--mine' : 'chat-msg__bubble--other'}}">
            <text class="chat-msg__content">{{item.content}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{messages.length === 0 && !loading}}" class="chat-empty">
        <text class="chat-empty__icon">💬</text>
        <text class="chat-empty__text">开始你们的对话吧</text>
      </view>

      <view wx:if="{{loading}}" class="chat-loading">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="chat-input-bar safe-bottom">
    <input
      class="chat-input"
      placeholder="说点什么..."
      value="{{inputContent}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
      maxlength="500"
      adjust-position
    />
    <view
      class="chat-send-btn {{(!inputContent || sending) ? 'chat-send-btn--disabled' : ''}}"
      bindtap="onSend"
    >
      <text>{{sending ? '...' : '发送'}}</text>
    </view>
  </view>
</view>
