/* pages/chat/detail/detail.wxss */
.chat-detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F0F2F5;
}

/* 信息标题提示 */
.chat-item-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #E6F4FF 0%, #F0F9FF 100%);
  border-bottom: 1rpx solid #D6E4FF;
}

.chat-item-tip__icon {
  font-size: 24rpx;
}

.chat-item-tip__text {
  font-size: 24rpx;
  color: #1890FF;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 消息列表 */
.chat-messages {
  flex: 1;
  padding: 24rpx 24rpx 16rpx;
}

.chat-messages__inner {
  padding-bottom: 24rpx;
}

/* 消息包裹 */
.chat-msg-wrapper {
  margin-bottom: 8rpx;
}

/* 时间分隔符 */
.chat-time {
  display: flex;
  justify-content: center;
  margin: 16rpx 0;
}

.chat-time__text {
  font-size: 22rpx;
  color: #A0AEC0;
  background: rgba(0, 0, 0, 0.05);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.chat-msg {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.chat-msg--mine {
  flex-direction: row-reverse;
}

.chat-msg__avatar-wrap {
  flex-shrink: 0;
}

.chat-msg__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.chat-msg__avatar--mine {
  background: linear-gradient(135deg, #43E97B 0%, #38F9D7 100%);
}

.chat-msg__avatar--other {
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
}

.chat-msg__bubble {
  max-width: 60%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  position: relative;
}

.chat-msg__bubble--other {
  background: #fff;
  color: #1A1A2E;
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.chat-msg__bubble--mine {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  color: #fff;
  border-top-right-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.25);
}

.chat-msg__content {
  display: block;
}

/* 空状态 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.chat-empty__icon {
  font-size: 80rpx;
  opacity: 0.4;
}

.chat-empty__text {
  font-size: 26rpx;
  color: #A0AEC0;
}

/* 加载 */
.chat-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E6F4FF;
  border-top-color: #1890FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #A0AEC0;
}

/* 输入栏 */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #E0E0E0;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F5F7FA;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #1A1A2E;
}

.chat-send-btn {
  padding: 0 32rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  color: #fff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.25);
  transition: all 0.2s ease;
}

.chat-send-btn:active {
  transform: scale(0.96);
}

.chat-send-btn--disabled {
  background: #E0E0E0;
  color: #A0AEC0;
  box-shadow: none;
}
