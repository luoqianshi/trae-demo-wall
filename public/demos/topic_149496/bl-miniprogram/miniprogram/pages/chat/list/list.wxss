/* pages/chat/list/list.wxss */
.chat-list-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: #F5F7FA;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  background: #fff;
}

.chat-header__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.chat-header__unread {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A5A 100%);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.chat-list {
  padding: 16rpx 0;
}

.chat-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F2F5;
  transition: all 0.2s ease;
}

.chat-item:active {
  background: #F5F7FA;
}

.chat-item__avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.chat-item__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.chat-item__avatar--default {
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
}

.chat-item__badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A5A 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
}

.chat-item__content {
  flex: 1;
  min-width: 0;
}

.chat-item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.chat-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-item__time {
  font-size: 22rpx;
  color: #A0AEC0;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.chat-item__item-title {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
  padding: 4rpx 12rpx;
  background: #E6F4FF;
  border-radius: 8rpx;
  width: fit-content;
  max-width: 100%;
}

.chat-item__item-icon {
  font-size: 20rpx;
  flex-shrink: 0;
}

.chat-item__item-text {
  font-size: 22rpx;
  color: #1890FF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-item__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.chat-item__msg {
  font-size: 26rpx;
  color: #718096;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.chat-item__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B6B;
  flex-shrink: 0;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E6F4FF;
  border-top-color: #1890FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #A0AEC0;
}
