<!-- pages/chat/list/list.wxml -->
<view class="chat-list-page">
  <!-- 顶部标题 -->
  <view class="chat-header">
    <text class="chat-header__title">消息</text>
    <view wx:if="{{unreadCount > 0}}" class="chat-header__unread">
      <text>{{unreadCount}}条未读</text>
    </view>
  </view>

  <!-- 会话列表 -->
  <view class="chat-list">
    <block wx:if="{{list.length > 0}}">
      <view
        wx:for="{{list}}"
        wx:key="sessionId"
        class="chat-item"
        data-item="{{item}}"
        bindtap="onItemTap"
        bindlongpress="onItemLongPress"
      >
        <view class="chat-item__avatar-wrap">
          <image wx:if="{{item.otherUser.avatar}}" class="chat-item__avatar" src="{{item.otherUser.avatar}}" mode="aspectFill"></image>
          <view wx:else class="chat-item__avatar chat-item__avatar--default">
            <text>{{item.otherUser.nickname ? item.otherUser.nickname[0] : '邻'}}</text>
          </view>
          <view wx:if="{{item.unread > 0}}" class="chat-item__badge">{{item.unread > 99 ? '99+' : item.unread}}</view>
        </view>
        <view class="chat-item__content">
          <view class="chat-item__top">
            <text class="chat-item__name">{{item.otherUser.nickname || '匿名邻居'}}</text>
            <text class="chat-item__time">{{item.timeText}}</text>
          </view>
          <view wx:if="{{item.itemTitle}}" class="chat-item__item-title">
            <text class="chat-item__item-icon">📌</text>
            <text class="chat-item__item-text">{{item.itemTitle}}</text>
          </view>
          <view class="chat-item__bottom">
            <text class="chat-item__msg">{{item.lastMessage || '开始对话吧'}}</text>
            <view wx:if="{{item.unread > 0}}" class="chat-item__dot"></view>
          </view>
        </view>
      </view>
    </block>

    <!-- 加载中 -->
    <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <empty-state 
      wx:if="{{!loading && list.length === 0}}" 
      icon="💬" 
      text="暂无消息" 
      subText="在互助或闲置详情页点击「平台对话」即可发起聊天"
    />
  </view>
</view>
