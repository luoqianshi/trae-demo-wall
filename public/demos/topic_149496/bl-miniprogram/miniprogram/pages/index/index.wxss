/* pages/index/index.wxss */
.home {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 顶部头部 */
.home-header {
  position: relative;
  overflow: hidden;
}

.home-header__bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 380rpx;
  background: linear-gradient(150deg, #4FACFE 0%, #00C6FB 50%, #5B86E5 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.home-header__content {
  position: relative;
  z-index: 1;
  padding: 100rpx 32rpx 32rpx;
}

.home-header__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.home-header__greeting {
  flex: 1;
}

.home-header__hello {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.home-header__community {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.home-header__community-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #fff;
  backdrop-filter: blur(4px);
}

.home-header__community-icon {
  font-size: 24rpx;
}

.home-header__community-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.home-header__avatar-wrap {
  flex-shrink: 0;
}

.home-header__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.home-header__avatar--default {
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

/* 信用卡片 */
.home-credit {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.home-credit__info {
  flex: 1;
}

.home-credit__level-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.home-credit__icon {
  font-size: 32rpx;
}

.home-credit__level {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.home-credit__score {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.home-credit__stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.home-credit__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.home-credit__stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.home-credit__stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.home-credit__stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 未登录提示 */
.home-login-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFF1F0 100%);
  border-radius: 20rpx;
}

.home-login-tip__icon {
  font-size: 32rpx;
}

.home-login-tip__text {
  flex: 1;
  font-size: 26rpx;
  color: #4A5568;
  font-weight: 500;
}

.home-login-tip__arrow {
  font-size: 36rpx;
  color: #FAAD14;
}

/* 两大板块 */
.home-sections {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.home-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.home-section:active {
  transform: scale(0.98);
}

.home-section--help {
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  box-shadow: 0 12rpx 32rpx rgba(79, 172, 254, 0.3);
}

.home-section--idle {
  background: linear-gradient(135deg, #FF9A8B 0%, #FF6A88 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 106, 136, 0.3);
}

.home-section__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.home-section__icon {
  font-size: 48rpx;
}

.home-section__content {
  flex: 1;
}

.home-section__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 6rpx;
}

.home-section__desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.home-section__arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

/* 快捷发布 */
.home-publish {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.home-publish__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.home-publish__btn:active {
  transform: scale(0.97);
}

.home-publish__btn--help {
  background: #E6F4FF;
  color: #1890FF;
  border: 2rpx solid #91D5FF;
}

.home-publish__btn--idle {
  background: #FFF1F0;
  color: #FF6B6B;
  border: 2rpx solid #FFCCC7;
}

.home-publish__icon {
  font-size: 32rpx;
}

/* 内容区块 */
.home-block {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.home-block__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.home-block__title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-block__title-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #4FACFE 0%, #00C6FB 100%);
}

.home-block__title-bar--coral {
  background: linear-gradient(180deg, #FF9A8B 0%, #FF6A88 100%);
}

.home-block__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.home-block__more {
  font-size: 24rpx;
  color: #1890FF;
}

/* 互助列表项 */
.home-block__list {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.home-help-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.home-help-item:last-child {
  border-bottom: none;
}

.home-help-item__left {
  flex-shrink: 0;
  margin-right: 20rpx;
}

.home-help-item__type {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #E6F4FF;
  color: #1890FF;
}

.home-help-item__content {
  flex: 1;
  min-width: 0;
}

.home-help-item__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.home-help-item__user {
  font-size: 22rpx;
  color: #A0AEC0;
}

.home-help-item__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-help-item__distance {
  font-size: 20rpx;
  color: #1890FF;
  background: #E6F4FF;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 闲置网格 */
.home-idle-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.home-idle-card {
  width: calc(50% - 12rpx);
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.home-idle-card:active {
  transform: scale(0.97);
}

.home-idle-card__image-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
  background: #F0F2F5;
}

.home-idle-card__distance {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(24, 144, 255, 0.9);
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 600;
  backdrop-filter: blur(4px);
}

.home-idle-card__image {
  width: 100%;
  height: 100%;
}

.home-idle-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: linear-gradient(135deg, #F0F4FF 0%, #FFF0F3 100%);
}

.home-idle-card__info {
  padding: 16rpx 20rpx 20rpx;
}

.home-idle-card__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.home-idle-card__price-row {
  display: flex;
  align-items: baseline;
}

.home-idle-card__price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.home-bottom-space {
  height: 40rpx;
}
