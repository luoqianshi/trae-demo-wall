<!-- pages/index/index.wxml -->
<view class="home">
  <!-- 顶部渐变头部 -->
  <view class="home-header">
    <view class="home-header__bg"></view>
    <view class="home-header__content">
      <view class="home-header__top">
        <view class="home-header__greeting">
          <text class="home-header__hello">你好，邻居 👋</text>
          <view class="home-header__community">
            <text class="home-header__community-icon">📍</text>
            <text class="home-header__community-text">{{locationText}}</text>
          </view>
          <view wx:if="{{community}}" class="home-header__community-tag">
            <text>{{community}}</text>
          </view>
        </view>
        <view wx:if="{{userInfo}}" class="home-header__avatar-wrap">
          <image wx:if="{{userInfo.avatar}}" class="home-header__avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
          <view wx:else class="home-header__avatar home-header__avatar--default">
            <text>{{userInfo.nickname ? userInfo.nickname[0] : '邻'}}</text>
          </view>
        </view>
      </view>

      <!-- 信用卡片 -->
      <view wx:if="{{userInfo}}" class="home-credit">
        <view class="home-credit__info">
          <view class="home-credit__level-wrap">
            <text class="home-credit__icon">{{creditConfig.icon}}</text>
            <text class="home-credit__level">{{creditConfig.level}}</text>
          </view>
          <text class="home-credit__score">信用积分 {{userInfo.credit_score || 0}}</text>
        </view>
        <view class="home-credit__stats">
          <view class="home-credit__stat">
            <text class="home-credit__stat-num">{{userInfo.help_count || 0}}</text>
            <text class="home-credit__stat-label">互助</text>
          </view>
          <view class="home-credit__stat-divider"></view>
          <view class="home-credit__stat">
            <text class="home-credit__stat-num">{{userInfo.trade_count || 0}}</text>
            <text class="home-credit__stat-label">交易</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view wx:if="{{!userInfo}}" class="home-login-tip" bindtap="goLogin">
    <text class="home-login-tip__icon">🔐</text>
    <text class="home-login-tip__text">请先登录以使用完整功能</text>
    <text class="home-login-tip__arrow">›</text>
  </view>

  <!-- 两大板块入口 -->
  <view class="home-sections">
    <view class="home-section home-section--help" bindtap="goHelp">
      <view class="home-section__icon-wrap">
        <text class="home-section__icon">🤝</text>
      </view>
      <view class="home-section__content">
        <text class="home-section__title">互助信息</text>
        <text class="home-section__desc">附近邻居·借物·帮忙·拼车</text>
      </view>
      <view class="home-section__arrow">›</view>
    </view>

    <view class="home-section home-section--idle" bindtap="goIdle">
      <view class="home-section__icon-wrap">
        <text class="home-section__icon">🛍️</text>
      </view>
      <view class="home-section__content">
        <text class="home-section__title">闲置物品</text>
        <text class="home-section__desc">附近邻居·省快递·面对面</text>
      </view>
      <view class="home-section__arrow">›</view>
    </view>
  </view>

  <!-- 快捷发布 -->
  <view class="home-publish">
    <view class="home-publish__btn home-publish__btn--help" bindtap="goPublishHelp">
      <text class="home-publish__icon">✏️</text>
      <text class="home-publish__text">发布互助</text>
    </view>
    <view class="home-publish__btn home-publish__btn--idle" bindtap="goPublishIdle">
      <text class="home-publish__icon">📷</text>
      <text class="home-publish__text">发布闲置</text>
    </view>
  </view>

  <!-- 最新互助 -->
  <view class="home-block">
    <view class="home-block__header">
      <view class="home-block__title-wrap">
        <view class="home-block__title-bar"></view>
        <text class="home-block__title">最新互助</text>
      </view>
      <text class="home-block__more" bindtap="goHelp">查看全部 ›</text>
    </view>

    <view wx:if="{{helpList.length > 0}}" class="home-block__list">
      <view 
        wx:for="{{helpList}}" 
        wx:key="_id"
        class="home-help-item"
        data-id="{{item._id}}"
        bindtap="goHelpDetail"
      >
        <view class="home-help-item__left">
          <text class="home-help-item__type" style="color: {{item.typeConfig.color}}; background: {{item.typeConfig.bg}};">{{item.type}}</text>
        </view>
        <view class="home-help-item__content">
          <text class="home-help-item__title">{{item.title}}</text>
          <view class="home-help-item__meta">
            <text class="home-help-item__user">{{item.userInfo.nickname || '匿名邻居'}}</text>
            <text wx:if="{{item.distanceText}}" class="home-help-item__distance">📍 {{item.distanceText}}</text>
          </view>
        </view>
        <view class="home-help-item__status tag {{item.status === '已完成' ? 'tag-success' : 'tag-warning'}}">{{item.status}}</view>
      </view>
    </view>

    <empty-state wx:else icon="🤝" text="暂无互助信息" subText="成为第一个发布互助的邻居" />
  </view>

  <!-- 最新闲置 -->
  <view class="home-block">
    <view class="home-block__header">
      <view class="home-block__title-wrap">
        <view class="home-block__title-bar home-block__title-bar--coral"></view>
        <text class="home-block__title">最新闲置</text>
      </view>
      <text class="home-block__more" bindtap="goIdle">查看全部 ›</text>
    </view>

    <view wx:if="{{idleList.length > 0}}" class="home-idle-grid">
      <view 
        wx:for="{{idleList}}" 
        wx:key="_id"
        class="home-idle-card"
        data-id="{{item._id}}"
        bindtap="goIdleDetail"
      >
        <view class="home-idle-card__image-wrap">
          <image wx:if="{{item.photos[0]}}" class="home-idle-card__image" src="{{item.photos[0]}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="home-idle-card__placeholder">
            <text>📷</text>
          </view>
          <view wx:if="{{item.distanceText}}" class="home-idle-card__distance">📍 {{item.distanceText}}</view>
        </view>
        <view class="home-idle-card__info">
          <text class="home-idle-card__name">{{item.name}}</text>
          <view class="home-idle-card__price-row">
            <text class="home-idle-card__price">¥{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>

    <empty-state wx:else icon="🛍️" text="暂无闲置物品" subText="发布你的闲置物品吧" />
  </view>

  <view class="home-bottom-space"></view>
</view>
