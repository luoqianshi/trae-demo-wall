<!-- pages/profile/profile/profile.wxml -->
<view class="profile-page">
  <!-- 顶部头部 -->
  <view class="profile-header">
    <view class="profile-header__bg"></view>
    <view class="profile-header__content">
      <!-- 未登录 -->
      <view wx:if="{{!userInfo}}" class="profile-header__login" bindtap="goLogin">
        <view class="profile-header__avatar profile-header__avatar--default">
          <text>👤</text>
        </view>
        <view class="profile-header__login-info">
          <text class="profile-header__login-text">点击登录</text>
          <text class="profile-header__login-desc">登录后享受更多功能</text>
        </view>
        <text class="profile-header__arrow">›</text>
      </view>

      <!-- 已登录 -->
      <view wx:else class="profile-header__user">
        <image wx:if="{{userInfo.avatar}}" class="profile-header__avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
        <view wx:else class="profile-header__avatar profile-header__avatar--default">
          <text>{{userInfo.nickname ? userInfo.nickname[0] : '邻'}}</text>
        </view>
        <view class="profile-header__user-info">
          <view class="profile-header__name-row">
            <text class="profile-header__name">{{userInfo.nickname || '邻居'}}</text>
            <credit-badge level="{{creditConfig.level}}" score="{{userInfo.credit_score}}" size="sm"></credit-badge>
          </view>
          <view class="profile-header__community" bindtap="updateLocation">
            <text class="profile-header__community-icon">📍</text>
            <text class="profile-header__community-text">{{userInfo.location ? '更新定位' : '获取定位'}}</text>
            <text class="profile-header__community-update">🔄</text>
          </view>
          <view wx:if="{{userInfo.community}}" class="profile-header__community-tag">
            <text>{{userInfo.community}}</text>
          </view>
        </view>
        <!-- <text class="profile-header__arrow" bindtap="goEdit">编辑 ›</text> -->
      </view>
    </view>
  </view>

  <block wx:if="{{userInfo}}">
    <!-- 统计卡片 -->
    <view class="profile-stats">
      <view class="profile-stat">
        <text class="profile-stat__num">{{userInfo.help_count || 0}}</text>
        <text class="profile-stat__label">互助次数</text>
      </view>
      <view class="profile-stat__divider"></view>
      <view class="profile-stat">
        <text class="profile-stat__num">{{userInfo.trade_count || 0}}</text>
        <text class="profile-stat__label">交易次数</text>
      </view>
      <view class="profile-stat__divider"></view>
      <view class="profile-stat">
        <text class="profile-stat__num">{{userInfo.help_publish_count || 0}}</text>
        <text class="profile-stat__label">发布互助</text>
      </view>
      <view class="profile-stat__divider"></view>
      <view class="profile-stat">
        <text class="profile-stat__num">{{userInfo.trade_publish_count || 0}}</text>
        <text class="profile-stat__label">发布闲置</text>
      </view>
    </view>

    <!-- 信用卡片 -->
    <view class="profile-credit-card">
      <view class="profile-credit-card__header">
        <view class="profile-credit-card__level-wrap">
          <text class="profile-credit-card__icon">{{creditConfig.icon}}</text>
          <view class="profile-credit-card__level-info">
            <text class="profile-credit-card__level">{{creditConfig.level}}</text>
            <text class="profile-credit-card__score">信用积分 {{userInfo.credit_score || 0}}</text>
          </view>
        </view>
        <view wx:if="{{nextLevel}}" class="profile-credit-card__next">
          <text class="profile-credit-card__next-text">距{{nextLevel.level}}还需 {{nextLevel.min - userInfo.credit_score}} 分</text>
        </view>
        <view wx:else class="profile-credit-card__next">
          <text class="profile-credit-card__next-text">已达最高等级 🎉</text>
        </view>
      </view>
      <view class="profile-credit-card__progress">
        <view class="profile-credit-card__progress-bar" style="width: {{progress}}%; background: {{creditConfig.gradient}};"></view>
      </view>
    </view>

    <!-- 菜单列表 -->
    <view class="profile-menu">
      <view class="profile-menu__item" bindtap="goRecords">
        <view class="profile-menu__icon-wrap profile-menu__icon-wrap--blue">
          <text class="profile-menu__icon">📋</text>
        </view>
        <text class="profile-menu__text">我的发布</text>
        <text class="profile-menu__arrow">›</text>
      </view>
      <view class="profile-menu__item" bindtap="goEdit">
        <view class="profile-menu__icon-wrap profile-menu__icon-wrap--green">
          <text class="profile-menu__icon">✏️</text>
        </view>
        <text class="profile-menu__text">编辑信息</text>
        <text class="profile-menu__arrow">›</text>
      </view>
    </view>
  </block>

  <view class="profile-bottom-space"></view>

  <!-- 底部说明 -->
  <view class="profile-footer">
    <text class="profile-footer__text">本小程序使用 Trae AI 独立开发</text>
  </view>
</view>
