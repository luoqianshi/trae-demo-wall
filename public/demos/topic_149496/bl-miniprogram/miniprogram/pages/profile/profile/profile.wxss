/* pages/profile/profile/profile.wxss */
.profile-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 头部 */
.profile-header {
  position: relative;
  overflow: hidden;
}

.profile-header__bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(150deg, #4FACFE 0%, #00C6FB 50%, #5B86E5 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.profile-header__content {
  position: relative;
  z-index: 1;
  padding: 120rpx 32rpx 40rpx;
}

/* 未登录 */
.profile-header__login {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-header__login-info {
  flex: 1;
}

.profile-header__login-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.profile-header__login-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 已登录 */
.profile-header__user {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-header__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

.profile-header__avatar--default {
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
}

.profile-header__user-info {
  flex: 1;
}

.profile-header__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.profile-header__name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.profile-header__community {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  margin-top: 8rpx;
  width: fit-content;
}

.profile-header__community-icon { font-size: 22rpx; }
.profile-header__community-text { font-size: 22rpx; color: rgba(255, 255, 255, 0.95); font-weight: 500; }
.profile-header__community-update { font-size: 22rpx; }

.profile-header__community-tag {
  display: inline-block;
  margin-top: 6rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.profile-header__arrow {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  flex-shrink: 0;
}

/* 统计卡片 */
.profile-stats {
  display: flex;
  align-items: center;
  margin: -20rpx 32rpx 24rpx;
  padding: 32rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.profile-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.profile-stat__num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1;
}

.profile-stat__label {
  font-size: 22rpx;
  color: #718096;
}

.profile-stat__divider {
  width: 1rpx;
  height: 56rpx;
  background: #F0F2F5;
}

/* 信用卡片 */
.profile-credit-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.profile-credit-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.profile-credit-card__level-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-credit-card__icon { font-size: 48rpx; }

.profile-credit-card__level-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.profile-credit-card__level {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.profile-credit-card__score { font-size: 24rpx; color: #718096; }

.profile-credit-card__next { text-align: right; }

.profile-credit-card__next-text { font-size: 22rpx; color: #A0AEC0; }

.profile-credit-card__progress {
  height: 16rpx;
  background: #F0F2F5;
  border-radius: 999rpx;
  overflow: hidden;
}

.profile-credit-card__progress-bar {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

/* 菜单 */
.profile-menu {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.profile-menu__item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0F2F5;
  transition: background 0.2s ease;
}

.profile-menu__item:last-child { border-bottom: none; }
.profile-menu__item:active { background: #F5F7FA; }

.profile-menu__icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.profile-menu__icon-wrap--blue { background: #E6F4FF; }
.profile-menu__icon-wrap--green { background: #F6FFED; }

.profile-menu__icon { font-size: 32rpx; }

.profile-menu__text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A2E;
}

.profile-menu__arrow {
  font-size: 36rpx;
  color: #CBD5E0;
  font-weight: 300;
}

.profile-bottom-space { height: 40rpx; }

/* 底部说明 */
.profile-footer {
  text-align: center;
  padding: 24rpx 32rpx 48rpx;
  /* margin-top: 220px; */
}

.profile-footer__text {
  font-size: 22rpx;
  color: #A0AEC0;
  letter-spacing: 1rpx;
}
