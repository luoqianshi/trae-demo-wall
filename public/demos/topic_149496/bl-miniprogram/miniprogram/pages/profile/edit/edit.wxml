<!-- pages/profile/edit/edit.wxml -->
<view class="edit-page">
  <!-- 头像展示 -->
  <view class="edit-avatar-section">
    <image wx:if="{{avatar}}" class="edit-avatar" src="{{avatar}}" mode="aspectFill"></image>
    <view wx:else class="edit-avatar edit-avatar--default">
      <text>{{nickname ? nickname[0] : '邻'}}</text>
    </view>
    <text class="edit-avatar__tip">头像使用微信头像，暂不支持修改</text>
  </view>

  <!-- 表单 -->
  <view class="edit-form">
    <view class="edit-form__item">
      <text class="edit-form__label">昵称</text>
      <input 
        class="edit-form__input" 
        placeholder="请输入昵称" 
        placeholder-class="edit-form__placeholder"
        maxlength="20"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <view class="edit-form__item">
      <text class="edit-form__label">所属社区</text>
      <input
        class="edit-form__input"
        placeholder="请输入所属社区"
        placeholder-class="edit-form__placeholder"
        maxlength="30"
        value="{{community}}"
        bindinput="onCommunityInput"
      />
    </view>
  </view>

  <!-- 不可修改信息提示 -->
  <view class="edit-readonly">
    <text class="edit-readonly__title">以下信息由系统自动统计，不可修改</text>
    <view class="edit-readonly__list">
      <view class="edit-readonly__item">
        <text>互助次数</text>
        <text class="edit-readonly__value">{{userInfo.help_count || 0}}</text>
      </view>
      <view class="edit-readonly__item">
        <text>交易次数</text>
        <text class="edit-readonly__value">{{userInfo.trade_count || 0}}</text>
      </view>
      <view class="edit-readonly__item">
        <text>信用积分</text>
        <text class="edit-readonly__value">{{userInfo.credit_score || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="edit-action safe-bottom">
    <button class="btn btn-primary edit-action__btn" bindtap="onSubmit" disabled="{{submitting}}">
      <text>{{submitting ? '保存中...' : '保存修改'}}</text>
    </button>
  </view>

  <view class="edit-bottom-space"></view>
</view>
