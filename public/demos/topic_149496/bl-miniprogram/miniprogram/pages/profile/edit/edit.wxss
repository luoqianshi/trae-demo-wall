/* pages/profile/edit/edit.wxss */
.edit-page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
}

/* 头像 */
.edit-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.edit-avatar--default {
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 56rpx;
  font-weight: 600;
}

.edit-avatar__tip {
  font-size: 22rpx;
  color: #A0AEC0;
}

/* 表单 */
.edit-form {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.edit-form__item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.edit-form__item:last-child { border-bottom: none; }

.edit-form__label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  width: 160rpx;
  flex-shrink: 0;
}

.edit-form__input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #1A1A2E;
}

.edit-form__placeholder { color: #A0AEC0; }

.edit-form__picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.edit-form__picker-text { font-size: 28rpx; color: #1A1A2E; }

.edit-form__picker-arrow {
  font-size: 36rpx;
  color: #CBD5E0;
  transform: rotate(90deg);
}

/* 不可修改信息 */
.edit-readonly {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.edit-readonly__title {
  font-size: 24rpx;
  color: #A0AEC0;
  display: block;
  margin-bottom: 20rpx;
}

.edit-readonly__list {
  display: flex;
  justify-content: space-around;
}

.edit-readonly__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #718096;
}

.edit-readonly__value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1890FF;
}

/* 保存按钮 */
.edit-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 20rpx 32rpx;
}

.edit-action__btn { width: 100%; }
.edit-bottom-space { height: 160rpx; }
