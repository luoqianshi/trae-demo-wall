/* pages/profile/records/records.wxss */
.records-page {
  min-height: 100vh;
}

/* Tab */
.records-tabs {
  display: flex;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}

.records-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 24rpx;
  font-size: 30rpx;
  color: #718096;
  font-weight: 500;
  position: relative;
}

.records-tab--active {
  color: #1A1A2E;
  font-weight: 700;
}

.records-tab__bar {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #4FACFE 0%, #00C6FB 100%);
}

.records-tab__bar--coral {
  background: linear-gradient(90deg, #FF9A8B 0%, #FF6A88 100%);
}

/* 列表 */
.records-list {
  padding: 24rpx 32rpx;
}

.record-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.record-card:active { transform: scale(0.98); }

.record-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F2F5;
}

.record-card__no { font-size: 22rpx; color: #A0AEC0; }

.record-card__actions {
  display: flex;
  align-items: center;
  gap: 60rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.record-card__edit {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #E6F4FF;
  font-size: 24rpx;
  color: #1890FF;
  font-weight: 500;
}

.record-card__edit:active { background: #BAE0FF; }

.record-card__toggle {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #FFF7E6;
  font-size: 24rpx;
  color: #FAAD14;
  font-weight: 500;
}

.record-card__toggle:active { background: #FFE58F; }

.record-card__complete {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #F6FFED;
  font-size: 24rpx;
  color: #52C41A;
  font-weight: 500;
}

.record-card__complete:active { background: #D9F7BE; }

.record-card__delete {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #FFF1F0;
  font-size: 24rpx;
  color: #FF4D4F;
  font-weight: 500;
}

.record-card__delete:active { background: #FFCCC7; }

/* 闲置记录卡片 */
.record-card__idle-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.record-card__image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #F0F2F5;
}

.record-card__image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #F0F4FF 0%, #FFF0F3 100%);
}

.record-card__idle-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-card__idle-info .record-card__header { margin-bottom: 8rpx; }
.record-card__idle-info .record-card__title { margin-bottom: auto; }

.record-card__price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.records-bottom-space { height: 40rpx; }
