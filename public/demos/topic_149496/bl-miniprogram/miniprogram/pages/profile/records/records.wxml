<!-- pages/profile/records/records.wxml -->
<view class="records-page">
  <!-- Tab切换 -->
  <view class="records-tabs">
    <view 
      class="records-tab {{activeTab === 'help' ? 'records-tab--active' : ''}}"
      data-tab="help"
      bindtap="onTabChange"
    >
      <text>互助信息</text>
      <view wx:if="{{activeTab === 'help'}}" class="records-tab__bar"></view>
    </view>
    <view 
      class="records-tab {{activeTab === 'idle' ? 'records-tab--active' : ''}}"
      data-tab="idle"
      bindtap="onTabChange"
    >
      <text>闲置物品</text>
      <view wx:if="{{activeTab === 'idle'}}" class="records-tab__bar records-tab__bar--coral"></view>
    </view>
  </view>

  <!-- 互助记录 -->
  <view wx:if="{{activeTab === 'help'}}" class="records-list">
    <block wx:if="{{helpRecords.length > 0}}">
      <view 
        wx:for="{{helpRecords}}" 
        wx:key="_id"
        class="record-card"
        data-id="{{item._id}}"
        bindtap="goHelpDetail"
      >
        <view class="record-card__header">
          <view class="record-card__type tag tag-primary">{{item.type}}</view>
          <view wx:if="{{item.hidden}}" class="tag tag-default">已隐藏</view>
          <view wx:elif="{{item.status === '已完成'}}" class="tag tag-success">{{item.status}}</view>
          <view wx:else class="tag tag-warning">{{item.status}}</view>
        </view>
        <text class="record-card__title">{{item.title}}</text>
        <view class="record-card__footer">
          <text class="record-card__no">{{item.help_no}}</text>
          <view class="record-card__actions">
            <view wx:if="{{item.status === '待帮助'}}" class="record-card__edit" data-id="{{item._id}}" catchtap="onEditHelp">
              <text>编辑</text>
            </view>
            <view wx:if="{{item.status === '待帮助'}}" class="record-card__toggle" data-id="{{item._id}}" catchtap="onToggleHelp">
              <text>{{item.hidden ? '显示' : '隐藏'}}</text>
            </view>
            <!-- <view wx:if="{{item.status === '待帮助'}}" class="record-card__complete" data-id="{{item._id}}" catchtap="onCompleteHelp">
              <text>标记完成</text>
            </view> -->
            <view class="record-card__delete" data-id="{{item._id}}" data-type="help" catchtap="onDelete">
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <empty-state wx:if="{{!loading && helpRecords.length === 0}}" icon="📋" text="暂无互助发布记录" />
  </view>

  <!-- 闲置记录 -->
  <view wx:if="{{activeTab === 'idle'}}" class="records-list">
    <block wx:if="{{idleRecords.length > 0}}">
      <view 
        wx:for="{{idleRecords}}" 
        wx:key="_id"
        class="record-card record-card--idle"
        data-id="{{item._id}}"
        bindtap="goIdleDetail"
      >
        <view class="record-card__idle-row">
          <image wx:if="{{item.photos[0]}}" class="record-card__image" src="{{item.photos[0]}}" mode="aspectFill"></image>
          <view wx:else class="record-card__image record-card__image--placeholder">
            <text>📷</text>
          </view>
          <view class="record-card__idle-info">
            <view class="record-card__header">
              <view class="tag tag-coral">{{item.category}}</view>
              <view wx:if="{{item.hidden}}" class="tag tag-default">已下架</view>
              <view wx:elif="{{item.status === '已出售'}}" class="tag tag-default">{{item.status}}</view>
              <view wx:else class="tag tag-primary">{{item.status}}</view>
            </view>
            <text class="record-card__title">{{item.name}}</text>
            <text class="record-card__price">¥{{item.price}}</text>
          </view>
        </view>
        <view class="record-card__footer">
          <text class="record-card__no">{{item.item_no}}</text>
          <view class="record-card__actions">
            <view wx:if="{{item.status === '在售'}}" class="record-card__edit" data-id="{{item._id}}" catchtap="onEditIdle">
              <text>编辑</text>
            </view>
            <view wx:if="{{item.status === '在售'}}" class="record-card__toggle" data-id="{{item._id}}" catchtap="onToggleIdle">
              <text>{{item.hidden ? '上架' : '下架'}}</text>
            </view>
            <!-- <view wx:if="{{item.status === '在售'}}" class="record-card__complete" data-id="{{item._id}}" catchtap="onCompleteIdle">
              <text>标记已售</text>
            </view> -->
            <view class="record-card__delete" data-id="{{item._id}}" data-type="idle" catchtap="onDelete">
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <empty-state wx:if="{{!loading && idleRecords.length === 0}}" icon="📦" text="暂无闲置发布记录" />
  </view>

  <view class="records-bottom-space"></view>
</view>
