<!-- pages/help/list/list.wxml -->
<view class="help-list-page">
  <!-- 定位信息条 -->
  <view class="location-bar">
    <view class="location-bar__left">
      <text class="location-bar__icon">📍</text>
      <text class="location-bar__text">{{locationText}}</text>
    </view>
    <picker 
      mode="selector" 
      range="{{distanceOptions}}" 
      range-key="label"
      value="{{selectedDistanceIndex}}"
      bindchange="onDistanceChange"
    >
      <view class="location-bar__distance">
        <text>{{distanceOptions[selectedDistanceIndex].label}}</text>
        <text class="location-bar__arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 筛选区 -->
  <view class="filter-bar">
    <!-- 类型筛选 -->
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filter-chips">
        <view 
          wx:for="{{helpTypes}}" 
          wx:key="value"
          class="filter-chip {{selectedType === item.value ? 'filter-chip--active' : ''}}"
          style="{{selectedType === item.value ? 'background:' + item.color + ';color:#fff' : 'color:' + item.color + ';background:' + item.bg}}"
          data-type="{{item.value}}"
          bindtap="onTypeTap"
        >
          <text class="filter-chip__icon">{{item.icon}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 状态筛选 -->
    <view class="filter-status">
      <view 
        wx:for="{{statusOptions}}" 
        wx:key="value"
        class="filter-status__item {{selectedStatus === item.value ? 'filter-status__item--active' : ''}}"
        data-status="{{item.value}}"
        bindtap="onStatusTap"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 列表 -->
  <view class="help-list">
    <block wx:if="{{list.length > 0}}">
      <help-card 
        wx:for="{{list}}" 
        wx:key="_id"
        item="{{item}}"
        showCommunity="{{true}}"
        bind:tap="onItemTap"
      />
    </block>

    <!-- 加载中 -->
    <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <empty-state 
      wx:if="{{!loading && list.length === 0}}" 
      icon="🤝" 
      text="附近暂无互助信息" 
      subText="扩大搜索范围或成为第一个发布互助的邻居"
      actionText="去发布"
      bind:action="goPublish"
    />

    <!-- 加载更多 -->
    <view wx:if="{{loadingMore}}" class="loading-more">
      <text>加载中...</text>
    </view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">
      <text>— 没有更多了 —</text>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="fab-btn" bindtap="goPublish">
    <text class="fab-btn__icon">+</text>
    <text class="fab-btn__text">发布</text>
  </view>
</view>
