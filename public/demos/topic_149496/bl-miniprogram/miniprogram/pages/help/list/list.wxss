/* pages/help/list/list.wxss */
.help-list-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 定位信息条 */
.location-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #E6F4FF 0%, #F0F9FF 100%);
  border-bottom: 1rpx solid #BAE0FF;
}

.location-bar__left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.location-bar__icon {
  font-size: 24rpx;
}

.location-bar__text {
  font-size: 24rpx;
  color: #1890FF;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-bar__distance {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1890FF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.15);
}

.location-bar__arrow {
  font-size: 20rpx;
}

/* 筛选区 */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  padding: 16rpx 0 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.filter-chips {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.filter-chip:active {
  transform: scale(0.95);
}

.filter-chip--active {
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.filter-chip__icon {
  font-size: 24rpx;
}

/* 状态筛选 */
.filter-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx 0;
}

.filter-status__item {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #718096;
  background: #F5F7FA;
  transition: all 0.2s ease;
}

.filter-status__item--active {
  color: #fff;
  background: #1A1A2E;
  font-weight: 600;
}

/* 列表 */
.help-list {
  padding: 24rpx 32rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E6F4FF;
  border-top-color: #1890FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #A0AEC0;
}

.loading-more, .no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #A0AEC0;
}

/* 发布按钮 */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 32rpx rgba(79, 172, 254, 0.4);
  z-index: 50;
  transition: all 0.2s ease;
}

.fab-btn:active {
  transform: scale(0.93);
}

.fab-btn__icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.fab-btn__text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
