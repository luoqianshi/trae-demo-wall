/* pages/help/publish/publish.wxss */
.publish-page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
}

.publish-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.publish-section__header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.publish-section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.publish-section__required {
  font-size: 30rpx;
  color: #FF4D4F;
}

.publish-section__count {
  margin-left: auto;
  font-size: 24rpx;
  color: #A0AEC0;
}

.publish-section__tip {
  display: block;
  font-size: 22rpx;
  color: #A0AEC0;
  margin-top: 12rpx;
}

/* 类型选择 */
.publish-types {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.publish-type {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: calc(20% - 16rpx);
  padding: 20rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  background: #F5F7FA;
  transition: all 0.2s ease;
}

.publish-type:active {
  transform: scale(0.95);
}

.publish-type--active {
  border-width: 2rpx;
  border-style: solid;
}

.publish-type__icon {
  font-size: 40rpx;
}

.publish-type__label {
  font-size: 22rpx;
  color: #718096;
  font-weight: 500;
}

/* 输入框 */
.publish-input {
  width: 100%;
  height: 88rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A2E;
  box-sizing: border-box;
}

.publish-input__placeholder {
  color: #A0AEC0;
}

.publish-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1A1A2E;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 社区展示 */
.publish-community {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 88rpx;
  background: #E6F4FF;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.publish-community__icon {
  font-size: 28rpx;
}

.publish-community__text {
  font-size: 28rpx;
  color: #1890FF;
  font-weight: 600;
}

/* 联系方式提示 */
.publish-contact-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.publish-contact-tip__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.publish-contact-tip__icon {
  font-size: 24rpx;
  color: #1890FF;
  font-weight: 700;
}

.publish-contact-tip__text {
  font-size: 22rpx;
  color: #718096;
}

/* 定位提示 */
.publish-location-tip {
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #E6F4FF 0%, #F0F9FF 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #1890FF;
}

.publish-location-tip__text {
  font-size: 24rpx;
  color: #4A5568;
  line-height: 1.6;
}

/* 积分提示卡片 */
.publish-tip-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFF1F0 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.publish-tip-card__icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.publish-tip-card__content {
  flex: 1;
}

.publish-tip-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #FAAD14;
  display: block;
  margin-bottom: 4rpx;
}

.publish-tip-card__desc {
  font-size: 22rpx;
  color: #718096;
}

/* 提交按钮 */
.publish-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.publish-action__btn {
  width: 100%;
}

.publish-bottom-space {
  height: 260rpx;
}
