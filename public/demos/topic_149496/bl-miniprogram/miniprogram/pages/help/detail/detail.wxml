<!-- pages/help/detail/detail.wxml -->
<view class="detail-page" wx:if="{{detail}}">
  <!-- 顶部类型卡片 -->
  <view class="detail-hero" style="background: {{typeConfig.bg}};">
    <button class="detail-share-btn" open-type="share">
      <text class="detail-share-btn__icon">⬆️</text>
    </button>
    <view class="detail-hero__icon" style="background: {{typeConfig.color}};">
      <text>{{typeConfig.icon}}</text>
    </view>
    <view class="detail-hero__info">
      <view class="detail-hero__type-row">
        <text class="detail-hero__type" style="color: {{typeConfig.color}};">{{detail.type}}</text>
        <view wx:if="{{detail.hidden}}" class="tag tag-default">已隐藏</view>
        <view wx:elif="{{detail.status === '已完成'}}" class="tag tag-success">{{detail.status}}</view>
        <view wx:else class="tag tag-warning">{{detail.status}}</view>
      </view>
      <text class="detail-hero__no">编号：{{detail.help_no}}</text>
      <view wx:if="{{distanceText}}" class="detail-hero__distance">
        <text>📍 {{distanceText}}</text>
      </view>
    </view>
  </view>

  <!-- 标题与描述 -->
  <view class="detail-card">
    <text class="detail-card__title">{{detail.title}}</text>
    <view class="detail-card__divider"></view>
    <view class="detail-card__desc-wrap">
      <text class="detail-card__desc-label">详细描述</text>
      <text class="detail-card__desc">{{detail.description || '暂无描述'}}</text>
    </view>
  </view>

  <!-- 发布者信息 -->
  <view class="detail-card" wx:if="{{detail.userInfo}}">
    <view class="detail-card__section-title">发布者信息</view>
    <view class="detail-user">
      <image wx:if="{{detail.userInfo.avatar}}" class="detail-user__avatar" src="{{detail.userInfo.avatar}}" mode="aspectFill"></image>
      <view wx:else class="detail-user__avatar detail-user__avatar--default">
        <text>{{detail.userInfo.nickname ? detail.userInfo.nickname[0] : '邻'}}</text>
      </view>
      <view class="detail-user__info">
        <view class="detail-user__name-row">
          <text class="detail-user__name">{{detail.userInfo.nickname || '匿名邻居'}}</text>
          <credit-badge level="{{detail.userInfo.credit_level}}" score="{{detail.userInfo.credit_score}}" size="sm"></credit-badge>
        </view>
        <view class="detail-user__stats">
          <text class="detail-user__stat">互助 {{detail.userInfo.help_count || 0}} 次</text>
          <text class="detail-user__stat-dot">·</text>
          <text class="detail-user__stat">积分 {{detail.userInfo.credit_score || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 信息列表 -->
  <view class="detail-card">
    <view class="detail-info-row" wx:if="{{detail.community}}">
      <text class="detail-info-row__label">所属社区</text>
      <text class="detail-info-row__value">🏘️ {{detail.community}}</text>
    </view>
    <view class="detail-info-row">
      <text class="detail-info-row__label">发布时间</text>
      <text class="detail-info-row__value">{{timeText}}</text>
    </view>
    <view class="detail-info-row" wx:if="{{completeTimeText}}">
      <text class="detail-info-row__label">完成时间</text>
      <text class="detail-info-row__value">{{completeTimeText}}</text>
    </view>
    <view class="detail-info-row">
      <text class="detail-info-row__label">联系方式</text>
      <text class="detail-info-row__value">
        {{hasPhone ? '📱 电话/平台对话' : '💬 仅平台对话'}}
      </text>
    </view>
  </view>

<!-- 底部操作栏 -->
<view class="detail-action safe-bottom">
  <!-- 已完成 -->
  <view wx:if="{{detail.status === '已完成'}}" class="detail-action__inner">
    <view class="detail-action__done">
      <text class="detail-action__done-icon">✓</text>
      <text class="detail-action__done-text">该互助已完成</text>
    </view>
  </view>
  <!-- 已隐藏（仅发布者可见） -->
  <!-- <view wx:elif="{{detail.hidden && isOwner}}" class="detail-action__inner">
    <button class="btn btn-primary detail-action__btn" bindtap="onToggleVisibility" loading="{{toggling}}">
      <text>👁 显示互助</text>
    </button>
  </view> -->
  <!-- 待帮助 -->
  <view wx:else class="detail-action__inner">
    <view wx:if="{{isOwner}}" class="detail-action__owner-btns">
      <!-- <button class="btn btn-outline detail-action__btn detail-action__btn--half" bindtap="onToggleVisibility" loading="{{toggling}}">
        <text>🙈 隐藏</text>
      </button> -->
      <button class="btn btn-primary detail-action__btn" bindtap="onComplete" loading="{{completing}}">
        <text>✓ 标记完成</text>
      </button>
    </view>
    <view wx:else class="detail-action__contact">
      <button wx:if="{{hasPhone}}" class="btn btn-outline detail-action__btn detail-action__btn--half" bindtap="onCallPhone">
        <text>📱 电话</text>
      </button>
      <button wx:if="{{hasPhone}}" class="btn btn-outline detail-action__btn detail-action__btn--half" bindtap="onCopyPhone">
        <text>📋 复制</text>
      </button>
      <button class="btn btn-coral detail-action__btn {{hasPhone ? '' : 'detail-action__btn--full'}}" bindtap="onChat">
        <text>💬 平台对话</text>
      </button>
    </view>
  </view>
</view>

  <view class="detail-bottom-space"></view>
</view>

<!-- 加载中 -->
<view wx:elif="{{loading}}" class="detail-loading">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>
