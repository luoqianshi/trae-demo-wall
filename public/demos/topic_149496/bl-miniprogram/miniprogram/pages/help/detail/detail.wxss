/* pages/help/detail/detail.wxss */
.detail-page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
}

/* 顶部类型卡片 */
.detail-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.detail-hero__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.detail-hero__info {
  flex: 1;
}

.detail-hero__type-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.detail-hero__type {
  font-size: 36rpx;
  font-weight: 700;
}

.detail-hero__no {
  font-size: 22rpx;
  color: #718096;
}

/* 信息卡片 */
.detail-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-card__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.5;
  display: block;
}

.detail-card__divider {
  height: 1rpx;
  background: #F0F2F5;
  margin: 24rpx 0;
}

.detail-card__desc-wrap {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-card__desc-label {
  font-size: 24rpx;
  color: #A0AEC0;
  font-weight: 500;
}

.detail-card__desc {
  font-size: 28rpx;
  color: #4A5568;
  line-height: 1.7;
}

.detail-card__section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 20rpx;
}

/* 发布者信息 */
.detail-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.detail-user__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.detail-user__avatar--default {
  background: linear-gradient(135deg, #4FACFE 0%, #00C6FB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.detail-user__info {
  flex: 1;
}

.detail-user__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.detail-user__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.detail-user__stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-user__stat {
  font-size: 24rpx;
  color: #718096;
}

.detail-user__stat-dot {
  font-size: 24rpx;
  color: #CBD5E0;
}

/* 信息行 */
.detail-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.detail-info-row:last-child {
  border-bottom: none;
}

.detail-info-row__label {
  font-size: 28rpx;
  color: #718096;
}

.detail-info-row__value {
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: 500;
}

.detail-info-row__value--contact {
  color: #1890FF;
  font-weight: 600;
}

/* 底部操作栏 */
.detail-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.detail-action__inner {
  padding: 20rpx 32rpx;
}

.detail-action__btn {
  width: 100%;
  white-space: nowrap; /* 确保文字横向展示，不换行 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-action__contact {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
}

.detail-action__owner-btns {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.detail-action__owner-btns .btn {
  flex: none;
  min-width: 320rpx;
}

.detail-action__btn--half {
  flex: 0 0 160rpx; /* 固定宽度，不拉伸 */
  min-width: 160rpx;
}

.detail-action__btn--full {
  flex: 1; /* 自动填充剩余空间 */
}

.detail-hero__distance {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(24, 144, 255, 0.15);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #1890FF;
  font-weight: 600;
}

.detail-action__done {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
}

.detail-action__done-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #52C41A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-action__done-text {
  font-size: 30rpx;
  color: #52C41A;
  font-weight: 600;
}

/* 卡片内正方形分享按钮 */
.detail-share-btn {
  position: absolute !important;
  top: 20rpx !important;
  right: 20rpx !important;
  width: 55rpx !important;
  height: 55rpx !important;
  min-width: auto !important;
  padding: 0 !important;
  margin: 0 !important;
  background: rgba(255, 255, 255, 0.85) !important;
  border-radius: 10rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08) !important;
  z-index: 10;
  border: none !important;
  line-height: 1 !important;
  font-size: 0 !important;
}

.detail-share-btn::after { border: none !important; }

.detail-share-btn__icon {
  font-size: 45rpx;
  color: #4A5568;
  font-weight: bold;
  line-height: 1;
}

.detail-bottom-space {
  height: 160rpx;
}

/* 加载 */
.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 20rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E6F4FF;
  border-top-color: #1890FF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #A0AEC0;
}
