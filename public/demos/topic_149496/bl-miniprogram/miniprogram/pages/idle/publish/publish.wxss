/* pages/idle/publish/publish.wxss */
.publish-page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
}

.publish-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.publish-section__header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.publish-section__title { font-size: 30rpx; font-weight: 600; color: #1A1A2E; }
.publish-section__required { font-size: 30rpx; color: #FF4D4F; }
.publish-section__count { margin-left: auto; font-size: 24rpx; color: #A0AEC0; }
.publish-section__tip { display: block; font-size: 22rpx; color: #A0AEC0; margin-top: 12rpx; }

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-item__image {
  width: 100%;
  height: 100%;
}

.photo-item__delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #FFF1F0;
  border: 2rpx dashed #FFCCC7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.photo-add:active { transform: scale(0.95); background: #FFE0E0; }

.photo-add__icon { font-size: 48rpx; color: #FF6B6B; font-weight: 300; line-height: 1; }
.photo-add__text { font-size: 22rpx; color: #FF6B6B; }

/* 输入框 */
.publish-input {
  width: 100%;
  height: 88rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A2E;
  box-sizing: border-box;
}

.publish-input__placeholder { color: #A0AEC0; }

.publish-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1A1A2E;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 价格输入 */
.price-input-wrap {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #FFF1F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.price-input-wrap__symbol { font-size: 36rpx; color: #FF6B6B; font-weight: 700; margin-right: 8rpx; }

.price-input { flex: 1; background: transparent; height: 88rpx; }

/* 类型选择 */
.publish-types {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.publish-type {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: calc(33.33% - 20rpx);
  padding: 20rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  background: #F5F7FA;
  transition: all 0.2s ease;
}

.publish-type:active { transform: scale(0.95); }
.publish-type--active { border-width: 2rpx; border-style: solid; }
.publish-type__icon { font-size: 40rpx; }
.publish-type__label { font-size: 22rpx; color: #718096; font-weight: 500; }

/* 社区展示 */
.publish-community {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 88rpx;
  background: #FFF1F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.publish-community__icon { font-size: 28rpx; }
.publish-community__text { font-size: 28rpx; color: #FF6B6B; font-weight: 600; }

/* 联系方式提示 */
.publish-contact-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFF5F5;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.publish-contact-tip__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.publish-contact-tip__icon {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.publish-contact-tip__text {
  font-size: 22rpx;
  color: #718096;
}

/* 定位提示 */
.publish-location-tip {
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF1F0 0%, #FFF5F5 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #FF6B6B;
}

.publish-location-tip__text {
  font-size: 24rpx;
  color: #4A5568;
  line-height: 1.6;
}

/* 积分提示卡片 */
.publish-tip-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFF1F0 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.publish-tip-card__icon { font-size: 40rpx; flex-shrink: 0; }
.publish-tip-card__content { flex: 1; }
.publish-tip-card__title { font-size: 26rpx; font-weight: 600; color: #FAAD14; display: block; margin-bottom: 4rpx; }
.publish-tip-card__desc { font-size: 22rpx; color: #718096; }

/* 提交按钮 */
.publish-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.publish-action__btn { width: 100%; }
.publish-bottom-space { height: 260rpx; }
