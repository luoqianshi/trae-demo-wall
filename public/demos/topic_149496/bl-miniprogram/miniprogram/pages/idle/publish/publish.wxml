<!-- pages/idle/publish/publish.wxml -->
<view class="publish-page">
  <!-- 照片上传 -->
  <view class="publish-section">
    <view class="publish-section__header">
      <text class="publish-section__title">物品照片</text>
      <text class="publish-section__required">*</text>
      <text class="publish-section__count">{{photos.length}}/3</text>
    </view>
    <view class="photo-grid">
      <!-- 已选照片 -->
      <view 
        wx:for="{{photos}}" 
        wx:key="*this"
        class="photo-item"
      >
        <image class="photo-item__image" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewPhoto"></image>
        <view class="photo-item__delete" data-index="{{index}}" catchtap="onDeletePhoto">
          <text>✕</text>
        </view>
      </view>
      <!-- 添加按钮 -->
      <view wx:if="{{photos.length < 3}}" class="photo-add" bindtap="onChoosePhoto">
        <text class="photo-add__icon">+</text>
        <text class="photo-add__text">添加照片</text>
      </view>
    </view>
    <text class="publish-section__tip">💡 最多3张，第一张为封面图</text>
  </view>

  <!-- 物品名称 -->
  <view class="publish-section">
    <view class="publish-section__header">
      <text class="publish-section__title">物品名称</text>
      <text class="publish-section__required">*</text>
      <text class="publish-section__count">{{name.length}}/20</text>
    </view>
    <input 
      class="publish-input" 
      placeholder="如：九成新咖啡机" 
      placeholder-class="publish-input__placeholder"
      maxlength="20"
      value="{{name}}"
      bindinput="onNameInput"
    />
  </view>

  <!-- 价格 -->
  <view class="publish-section">
    <view class="publish-section__header">
      <text class="publish-section__title">售价</text>
      <text class="publish-section__required">*</text>
    </view>
    <view class="price-input-wrap">
      <text class="price-input-wrap__symbol">¥</text>
      <input 
        class="publish-input price-input" 
        type="digit"
        placeholder="0.00" 
        placeholder-class="publish-input__placeholder"
        value="{{price}}"
        bindinput="onPriceInput"
      />
    </view>
  </view>

  <!-- 分类 -->
  <view class="publish-section">
    <view class="publish-section__header">
      <text class="publish-section__title">物品分类</text>
      <text class="publish-section__required">*</text>
    </view>
    <view class="publish-types">
      <view 
        wx:for="{{categories}}" 
        wx:key="value"
        class="publish-type {{selectedCategory === item.value ? 'publish-type--active' : ''}}"
        style="{{selectedCategory === item.value ? 'border-color:' + item.color + ';background:' + item.bg : ''}}"
        data-category="{{item.value}}"
        bindtap="onCategoryTap"
      >
        <text class="publish-type__icon">{{item.icon}}</text>
        <text class="publish-type__label" style="{{selectedCategory === item.value ? 'color:' + item.color : ''}}">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 描述 -->
  <view class="publish-section">
    <view class="publish-section__header">
      <text class="publish-section__title">物品描述</text>
      <text class="publish-section__count">{{description.length}}/200</text>
    </view>
    <textarea 
      class="publish-textarea" 
      placeholder="描述物品的新旧程度、规格、使用情况等" 
      placeholder-class="publish-input__placeholder"
      maxlength="200"
      value="{{description}}"
      bindinput="onDescInput"
      auto-height
      cursor-spacing="160"
    />
  </view>

  <!-- 联系方式（手机号可选） -->
  <view class="publish-section">
    <view class="publish-section__header">
      <text class="publish-section__title">手机号（可选）</text>
    </view>
    <input 
      class="publish-input" 
      type="number"
      placeholder="不填写则只能通过平台对话联系"
      placeholder-class="publish-input__placeholder"
      maxlength="11"
      value="{{phone}}"
      bindinput="onPhoneInput"
    />
    <!-- <view class="publish-contact-tip">
      <view class="publish-contact-tip__item">
        <text class="publish-contact-tip__icon">{{hasPhone ? '✓' : '○'}}</text>
        <text class="publish-contact-tip__text">填写手机号：可电话联系 + 平台对话</text>
      </view>
      <view class="publish-contact-tip__item">
        <text class="publish-contact-tip__icon">{{hasPhone ? '○' : '✓'}}</text>
        <text class="publish-contact-tip__text">不填手机号：仅平台对话联系</text>
      </view>
    </view> -->
  </view>

  <!-- 社区展示 -->
  <!-- <view class="publish-section" wx:if="{{community}}">
    <view class="publish-section__header">
      <text class="publish-section__title">所属社区（仅展示）</text>
    </view>
    <view class="publish-community">
      <text class="publish-community__icon">🏘️</text>
      <text class="publish-community__text">{{community}}</text>
    </view>
  </view> -->

  <!-- 定位说明 -->
  <view class="publish-section">
    <view class="publish-section__header">
      <text class="publish-section__title">📍 位置信息</text>
    </view>
    <view class="publish-location-tip">
      <text class="publish-location-tip__text">系统将自动使用你的历史位置发布信息，如需使用当前位置可在「我的」页面更新定位。</text>
    </view>
  </view>

  <!-- 积分提示 -->
  <view class="publish-tip-card">
    <text class="publish-tip-card__icon">🎁</text>
    <view class="publish-tip-card__content">
      <text class="publish-tip-card__title">发布闲置可获得 2 积分</text>
      <text class="publish-tip-card__desc">完成交易后，卖家+10积分，买家+5积分</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="publish-action safe-bottom">
    <button class="btn btn-coral publish-action__btn" bindtap="onSubmit" disabled="{{submitting}}">
      <text>{{submitting ? '发布中...' : '发布闲置'}}</text>
    </button>
  </view>

  <view class="publish-bottom-space"></view>
</view>
