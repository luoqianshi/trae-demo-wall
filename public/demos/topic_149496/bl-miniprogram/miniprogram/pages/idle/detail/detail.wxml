<!-- pages/idle/detail/detail.wxml -->
<view class="detail-page" wx:if="{{detail}}">
  <!-- 图片轮播 -->
  <view class="idle-photos">
    <swiper class="idle-photos__swiper" current="{{currentPhoto}}" bindchange="onPhotoChange" circular>
      <swiper-item wx:for="{{detail.photos}}" wx:key="*this">
        <image class="idle-photos__image" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewPhoto"></image>
      </swiper-item>
    </swiper>
    <view class="idle-photos__indicator">
      <text>{{currentPhoto + 1}}/{{detail.photos.length}}</text>
    </view>
  </view>

  <!-- 价格与名称 -->
  <view class="idle-price-card">
    <button class="detail-share-btn detail-share-btn--idle" open-type="share">
      <text class="detail-share-btn__icon">⬆️</text>
    </button>
    <view class="idle-price-card__price-row">
      <text class="idle-price-card__symbol">¥</text>
      <text class="idle-price-card__price">{{detail.price}}</text>
      <text wx:if="{{detail.original_price}}" class="idle-price-card__original">¥{{detail.original_price}}</text>
      <view wx:if="{{detail.hidden}}" class="tag tag-default idle-price-card__status-tag">已下架</view>
      <view wx:elif="{{detail.status === '已出售'}}" class="tag tag-default idle-price-card__status-tag">{{detail.status}}</view>
      <view wx:else class="tag tag-primary idle-price-card__status-tag">{{detail.status}}</view>
    </view>
    <text class="idle-price-card__name">{{detail.name}}</text>
    <view class="idle-price-card__tags">
      <view class="tag tag-coral">{{detail.category}}</view>
      <view class="tag tag-default">{{detail.item_no}}</view>
      <view wx:if="{{distanceText}}" class="tag idle-price-card__distance-tag">
        <text>📍 {{distanceText}}</text>
      </view>
    </view>
  </view>

  <!-- 描述 -->
  <view class="detail-card" wx:if="{{detail.description}}">
    <view class="detail-card__section-title">物品描述</view>
    <text class="detail-card__desc">{{detail.description}}</text>
  </view>

  <!-- 卖家信息 -->
  <view class="detail-card" wx:if="{{detail.userInfo}}">
    <view class="detail-card__section-title">卖家信息</view>
    <view class="detail-user">
      <image wx:if="{{detail.userInfo.avatar}}" class="detail-user__avatar" src="{{detail.userInfo.avatar}}" mode="aspectFill"></image>
      <view wx:else class="detail-user__avatar detail-user__avatar--default">
        <text>{{detail.userInfo.nickname ? detail.userInfo.nickname[0] : '邻'}}</text>
      </view>
      <view class="detail-user__info">
        <view class="detail-user__name-row">
          <text class="detail-user__name">{{detail.userInfo.nickname || '匿名邻居'}}</text>
          <credit-badge level="{{detail.userInfo.credit_level}}" score="{{detail.userInfo.credit_score}}" size="sm"></credit-badge>
        </view>
        <view class="detail-user__stats">
          <text class="detail-user__stat">交易 {{detail.userInfo.trade_count || 0}} 次</text>
          <text class="detail-user__stat-dot">·</text>
          <text class="detail-user__stat">积分 {{detail.userInfo.credit_score || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 信息列表 -->
  <view class="detail-card">
    <view class="detail-info-row" wx:if="{{detail.community}}">
      <text class="detail-info-row__label">所属社区</text>
      <text class="detail-info-row__value">🏘️ {{detail.community}}</text>
    </view>
    <view class="detail-info-row">
      <text class="detail-info-row__label">发布时间</text>
      <text class="detail-info-row__value">{{timeText}}</text>
    </view>
    <view class="detail-info-row" wx:if="{{completeTimeText}}">
      <text class="detail-info-row__label">成交时间</text>
      <text class="detail-info-row__value">{{completeTimeText}}</text>
    </view>
    <view class="detail-info-row">
      <text class="detail-info-row__label">联系方式</text>
      <text class="detail-info-row__value">
        {{hasPhone ? '📱 电话/平台对话' : '💬 仅平台对话'}}
      </text>
    </view>
  </view>

<!-- 底部操作栏 -->
<view class="detail-action safe-bottom">
  <!-- 已出售 -->
  <view wx:if="{{detail.status === '已出售'}}" class="detail-action__inner">
    <view class="detail-action__done">
      <text class="detail-action__done-icon">✓</text>
      <text class="detail-action__done-text">该物品已出售</text>
    </view>
  </view>
  <!-- 已下架（仅发布者可见） -->
  <!-- <view wx:elif="{{detail.hidden && isOwner}}" class="detail-action__inner">
    <button class="btn btn-coral detail-action__btn" bindtap="onToggleVisibility" loading="{{toggling}}">
      <text>📦 重新上架</text>
    </button>
  </view> -->
  <!-- 在售 -->
  <view wx:else class="detail-action__inner">
    <view wx:if="{{isOwner}}" class="detail-action__owner-btns">
      <!-- <button class="btn btn-outline detail-action__btn detail-action__btn--half" bindtap="onToggleVisibility" loading="{{toggling}}">
        <text>📥 下架</text>
      </button> -->
      <button class="btn btn-coral detail-action__btn" bindtap="onComplete" loading="{{completing}}">
        <text>✓ 标记已售</text>
      </button>
    </view>
    <view wx:else class="detail-action__contact">
      <button wx:if="{{hasPhone}}" class="btn btn-outline detail-action__btn detail-action__btn--half" bindtap="onCallPhone">
        <text>📱 电话</text>
      </button>
      <button wx:if="{{hasPhone}}" class="btn btn-outline detail-action__btn detail-action__btn--half" bindtap="onCopyPhone">
        <text>📋 复制</text>
      </button>
      <button class="btn btn-coral detail-action__btn detail-action__btn--full" bindtap="onChat">
        <text>💬 平台对话</text>
      </button>
    </view>
  </view>
</view>

  <view class="detail-bottom-space"></view>
</view>

<!-- 加载中 -->
<view wx:elif="{{loading}}" class="detail-loading">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>
