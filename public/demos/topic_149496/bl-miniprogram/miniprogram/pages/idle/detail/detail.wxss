/* pages/idle/detail/detail.wxss */
.detail-page {
  min-height: 100vh;
  padding-bottom: 0;
}

/* 图片轮播 */
.idle-photos {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #F0F2F5;
}

.idle-photos__swiper {
  width: 100%;
  height: 100%;
}

.idle-photos__image {
  width: 100%;
  height: 100%;
}

.idle-photos__indicator {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  padding: 6rpx 20rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
}

/* 价格卡片内的状态标签 */
.idle-price-card__status-tag {
  margin-left: 16rpx;
  align-self: center;
}

/* 价格卡片内的距离标签 */
.idle-price-card__distance-tag {
  background: #E6F4FF;
  color: #1890FF;
}

.idle-price-card__original {
  font-size: 24rpx;
  color: #A0AEC0;
  text-decoration: line-through;
  margin-left: 12rpx;
  align-self: center;
}

/* 价格卡片 */
.idle-price-card {
  position: relative;
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.idle-price-card__price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.idle-price-card__symbol {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.idle-price-card__price {
  font-size: 60rpx;
  color: #FF6B6B;
  font-weight: 700;
  line-height: 1;
}

.idle-price-card__name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.idle-price-card__tags {
  display: flex;
  gap: 12rpx;
}

/* 信息卡片 */
.detail-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-card__section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 20rpx;
}

.detail-card__desc {
  font-size: 28rpx;
  color: #4A5568;
  line-height: 1.7;
}

/* 卖家信息 */
.detail-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.detail-user__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.detail-user__avatar--default {
  background: linear-gradient(135deg, #FF9A8B 0%, #FF6A88 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.detail-user__info { flex: 1; }

.detail-user__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.detail-user__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.detail-user__stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-user__stat { font-size: 24rpx; color: #718096; }
.detail-user__stat-dot { font-size: 24rpx; color: #CBD5E0; }

/* 信息行 */
.detail-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.detail-info-row:last-child { border-bottom: none; }

.detail-info-row__label { font-size: 28rpx; color: #718096; }

.detail-info-row__value { font-size: 28rpx; color: #1A1A2E; font-weight: 500; }

.detail-info-row__value--contact { color: #FF6B6B; font-weight: 600; }

/* 底部操作栏 */
.detail-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.detail-action__inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 32rpx;
}

.detail-action__price {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.detail-action__price-label { font-size: 22rpx; color: #A0AEC0; }

.detail-action__price-value { font-size: 36rpx; font-weight: 700; color: #FF6B6B; }

.detail-action__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap; /* 保证文字横向不换行 */
}

.detail-action__contact {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  flex: 1;
  max-width: 100%;
}

.detail-action__owner-btns {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.detail-action__owner-btns .btn {
  flex: none;
  min-width: 320rpx;
}

.detail-action__btn--half {
  flex: 0 0 160rpx; /* 固定宽度，不拉伸 */
  min-width: 160rpx;
}

.detail-action__btn--full {
  flex: 1; /* 自动填充剩余空间 */
}

.detail-action__done {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  flex: 1;
}

.detail-action__done-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #52C41A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-action__done-text { font-size: 30rpx; color: #52C41A; font-weight: 600; }

/* 卡片内正方形分享按钮 */
.detail-share-btn {
  position: absolute !important;
  top: 30rpx !important;
  right: 30rpx !important;
  width: 60rpx !important;
  height: 60rpx !important;
  min-width: auto !important;
  padding: 0 !important;
  margin: 0 !important;
  background: #F7FAFC !important;
  border-radius: 10rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08) !important;
  z-index: 10;
  border: none !important;
  line-height: 1 !important;
  font-size: 0 !important;
}

.detail-share-btn::after { border: none !important; }

.detail-share-btn__icon {
  font-size: 45rpx;
  color: #4A5568;
  font-weight: bold;
  line-height: 1;
}

.detail-bottom-space { height: 160rpx; }

/* 加载 */
.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 20rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #FFF1F0;
  border-top-color: #FF6B6B;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text { font-size: 26rpx; color: #A0AEC0; }
