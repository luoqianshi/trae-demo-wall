    {
      "id": "leg_001",
      "name": "前蹲",
      "nameEn": "Front Squat",
      "primaryTag": "legs",
      "secondaryTag": "functional",
      "muscles": [
        "股四头肌",
        "核心"
      ],
      "movementPattern": "深蹲",
      "difficulty": "中级",
      "description": "首先将杠铃放在略低于肩膀高度的架上。将杠铃放在三角肌顶部，用力顶住锁骨，并轻轻接触喉部。双手采用抓握姿势，仅用手指接触杠铃以帮助保持位置。通过先用腿部推动并同时挺直躯干来将杠铃从架上抬起。离开架子，用与肩同宽的中等姿势定位双腿，脚趾略微向外。始终保持头部和肘部抬起。这将是你的起始位置。",
      "images": {
        "start": "assets/images/exercises/leg_001_start.jpg",
        "end": "assets/images/exercises/leg_001_end.jpg"
      }
    },
    {
      "id": "leg_002",
      "name": "杠铃深蹲",
      "nameEn": "Barbell Squat",
      "primaryTag": "legs",
      "secondaryTag": "hypertrophy",
      "muscles": [
        "股四头肌",
        "臀大肌"
