{
  "manifest_version": 3,
  "name": "橙猫一键填写表单",
  "version": "1.0.0",
  "description": "橙猫求职官：智能识别表单并一键自动填充，支持自定义字段与通用模板",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "橙猫一键填写表单",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js", "content-script-boss-fix.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.worker.min.js",
        "node_modules/pdfjs-dist/cmaps/*",
        "assets/icons/float-icon.png",
        "assets/icons/header-icon.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}