# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zhiyou
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zhiyou

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI 服务配置（OpenAI 兼容接口）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key
AI_MODEL=gpt-4o-mini

# 服务配置
APP_NAME=智友服务
APP_VERSION=1.0.0
DEBUG=true
