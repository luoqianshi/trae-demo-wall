page {
  min-height: 100%;
  color: #F5F0E6;
  background: #0D1817;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx 56rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 10% 0%, rgba(201, 169, 106, 0.12), transparent 460rpx),
    linear-gradient(180deg, #0D1817, #0B1211 70%);
}

.eyebrow {
  display: block;
  color: #C9A96A;
  font-size: 20rpx;
  letter-spacing: 5rpx;
  font-weight: 800;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #FFF8E8;
  font-size: 50rpx;
  font-weight: 900;
}

.muted {
  color: #8D9A95;
}

.gold {
  color: #C9A96A;
}

.panel {
  border: 1rpx solid rgba(201, 169, 106, 0.22);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.055);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.18);
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 44rpx 0 22rpx;
}

.section-title {
  color: #FFF8E8;
  font-size: 36rpx;
  font-weight: 900;
}

.section-link {
  color: #C9A96A;
  font-size: 24rpx;
}

.btn-gold {
  height: 76rpx;
  border-radius: 20rpx;
  color: #101715;
  background: linear-gradient(135deg, #E2C47E, #B88C43);
  font-size: 28rpx;
  font-weight: 800;
}

.btn-ghost {
  height: 64rpx;
  border: 1rpx solid rgba(201, 169, 106, 0.45);
  border-radius: 18rpx;
  color: #C9A96A;
  font-size: 25rpx;
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #DCC68D;
  background: rgba(201, 169, 106, 0.12);
  font-size: 22rpx;
}

.safe-bottom {
  height: 30rpx;
}
