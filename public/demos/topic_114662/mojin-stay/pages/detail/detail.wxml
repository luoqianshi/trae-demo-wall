<view class="page" wx:if="{{room}}">
  <image class="cover" src="{{room.cover}}" mode="aspectFill"></image>
  <view class="panel main">
    <view class="row">
      <view>
        <text class="eyebrow">{{room.city}}</text>
        <text class="title">{{room.name}}</text>
      </view>
      <text class="tag">{{room.status}}</text>
    </view>
    <view class="tags">
      <text wx:for="{{room.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
  </view>

  <view class="section-head"><text class="section-title">租住信息</text></view>
  <view class="panel info">
    <view class="line"><text>房客</text><text>{{room.tenant || '暂无'}}</text></view>
    <view class="line"><text>手机号</text><text>{{room.phone || '暂无'}}</text></view>
    <view class="line"><text>租期</text><text>{{room.startDate || '-'}} 至 {{room.endDate || '-'}}</text></view>
    <view class="line"><text>收租日</text><text>每月 {{room.dueDay}} 日</text></view>
  </view>

  <view class="section-head"><text class="section-title">费用标准</text></view>
  <view class="fee-grid">
    <view wx:for="{{feeItems}}" wx:key="label" class="fee panel">
      <text>{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-gold" bindtap="goRent">生成收租单</button>
    <button class="btn-ghost" bindtap="goMeter">录入水电表</button>
  </view>
</view>
