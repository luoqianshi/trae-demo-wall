.cover { width:100%; height:390rpx; border-radius:0 0 38rpx 38rpx; background:#182522; }
.main { margin-top:-40rpx; padding:30rpx; position:relative; }
.tags { display:flex; gap:12rpx; flex-wrap:wrap; margin-top:24rpx; }
.info { padding:10rpx 28rpx; }
.line { display:flex; justify-content:space-between; padding:24rpx 0; border-bottom:1rpx solid rgba(255,255,255,.08); color:#F5F0E6; font-size:27rpx; }
.line text:first-child { color:#8D9A95; }
.fee-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16rpx; }
.fee { padding:24rpx; }
.fee text:first-child { display:block; color:#8D9A95; font-size:23rpx; }
.fee text:last-child { display:block; margin-top:12rpx; color:#C9A96A; font-size:31rpx; font-weight:900; }
.actions { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-top:46rpx; }
