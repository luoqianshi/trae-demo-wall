<view class="page">
  <view class="hero">
    <text class="eyebrow">MOJIN STAY</text>
    <text class="title">墨金旅居</text>
    <text class="hero-desc">旅居房租、押金、水电和退租结算，一部手机看清楚。</text>
  </view>

  <view class="kpis">
    <view class="kpi panel">
      <text>本月实收</text>
      <text class="num">¥{{stats.monthIncome}}</text>
    </view>
    <view class="kpi panel">
      <text>待收金额</text>
      <text class="num danger">¥{{stats.pendingAmount}}</text>
    </view>
    <view class="kpi panel">
      <text>入住率</text>
      <text class="num">{{stats.occupancyRate}}%</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">常用功能</text>
  </view>
  <view class="quick-grid">
    <view wx:for="{{quicks}}" wx:key="title" class="quick panel" bindtap="go" data-url="{{item.url}}">
      <text class="quick-title">{{item.title}}</text>
      <text class="quick-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">房源概览</text>
    <text class="section-link" bindtap="go" data-url="/pages/rooms/rooms">全部房源</text>
  </view>
  <view wx:for="{{rooms}}" wx:key="id" class="room panel" bindtap="goDetail" data-id="{{item.id}}">
    <image class="room-img" src="{{item.cover}}" mode="aspectFill"></image>
    <view class="room-info">
      <view class="row">
        <text class="room-name">{{item.name}}</text>
        <text class="tag">{{item.status}}</text>
      </view>
      <text class="muted">{{item.city}} · {{item.cycle}} · 每月 {{item.dueDay}} 日收租</text>
      <text class="rent">¥{{item.rent}} / 月</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">待处理账单</text>
    <text class="section-link" bindtap="go" data-url="/pages/orders/orders">查看账单</text>
  </view>
  <view wx:for="{{pendingBills}}" wx:key="id" class="bill panel">
    <view>
      <text class="bill-title">{{item.roomName}}</text>
      <text class="muted">{{item.tenant}} · {{item.month}}</text>
    </view>
    <view class="right">
      <text class="amount">¥{{item.total}}</text>
      <text class="status">{{item.status}}</text>
    </view>
  </view>
</view>
