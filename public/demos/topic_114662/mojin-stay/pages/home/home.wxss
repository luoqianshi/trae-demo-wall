.hero { padding: 52rpx 0 20rpx; }
.hero-desc { display:block; margin-top:18rpx; color:#9EABA6; font-size:27rpx; line-height:1.6; }
.kpis { display:grid; grid-template-columns: repeat(3, 1fr); gap:16rpx; margin-top:26rpx; }
.kpi { padding:20rpx 16rpx; }
.kpi text:first-child { display:block; color:#8D9A95; font-size:22rpx; }
.num { display:block; margin-top:10rpx; color:#FFF5D8; font-size:31rpx; font-weight:900; }
.danger { color:#FFB29B; }
.quick-grid { display:grid; grid-template-columns: repeat(2, 1fr); gap:18rpx; }
.quick { padding:26rpx; }
.quick-title { display:block; color:#FFF8E8; font-size:30rpx; font-weight:900; }
.quick-desc { display:block; margin-top:12rpx; color:#8D9A95; font-size:23rpx; }
.room { display:flex; gap:20rpx; padding:18rpx; margin-bottom:18rpx; }
.room-img { width:190rpx; height:150rpx; border-radius:22rpx; background:#182522; }
.room-info { flex:1; min-width:0; }
.room-name { color:#FFF8E8; font-size:30rpx; font-weight:900; }
.rent { display:block; margin-top:18rpx; color:#C9A96A; font-size:31rpx; font-weight:900; }
.bill { display:flex; align-items:center; justify-content:space-between; padding:24rpx; margin-bottom:16rpx; }
.bill-title { display:block; color:#FFF8E8; font-size:29rpx; font-weight:800; }
.right { text-align:right; }
.amount { display:block; color:#FFF5D8; font-size:30rpx; font-weight:900; }
.status { display:block; margin-top:6rpx; color:#FFB29B; font-size:22rpx; }
