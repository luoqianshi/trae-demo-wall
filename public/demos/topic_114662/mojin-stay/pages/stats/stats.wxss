.top { padding:52rpx 0 24rpx; }
.kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:16rpx; }
.kpi { padding:22rpx 12rpx; }
.kpi text:first-child { display:block; color:#8D9A95; font-size:22rpx; }
.kpi text:last-child { display:block; margin-top:10rpx; color:#C9A96A; font-size:29rpx; font-weight:900; }
.chart { padding:28rpx; }
.bar-row { display:grid; grid-template-columns:72rpx 1fr 150rpx; align-items:center; gap:16rpx; margin-bottom:24rpx; color:#C9A96A; font-size:24rpx; }
.bar-bg { height:20rpx; border-radius:999rpx; background:rgba(255,255,255,.08); overflow:hidden; }
.bar { height:100%; border-radius:999rpx; background:linear-gradient(90deg,#80622D,#E2C47E); }
