<view class="page">
  <view class="top">
    <text class="eyebrow">STATS</text>
    <text class="title">经营统计</text>
  </view>
  <view class="kpis">
    <view class="panel kpi"><text>年度实收</text><text>¥{{stats.yearIncome}}</text></view>
    <view class="panel kpi"><text>年度费用</text><text>¥{{stats.cost}}</text></view>
    <view class="panel kpi"><text>逾期账单</text><text>{{stats.overdueCount}} 笔</text></view>
  </view>
  <view class="section-head"><text class="section-title">近 6 月收入</text></view>
  <view class="panel chart">
    <view wx:for="{{stats.months}}" wx:key="name" class="bar-row">
      <text>{{item.name}}</text>
      <view class="bar-bg"><view class="bar" style="width: {{item.percent}}%;"></view></view>
      <text>¥{{item.income}}</text>
    </view>
  </view>
</view>
