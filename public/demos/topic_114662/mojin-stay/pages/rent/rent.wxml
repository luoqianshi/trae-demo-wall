<view class="page">
  <view class="top">
    <text class="eyebrow">COLLECT RENT</text>
    <text class="title">生成收租单</text>
  </view>

  <view class="panel form">
    <text class="label">选择房源</text>
    <picker range="{{rooms}}" range-key="name" value="{{roomIndex}}" bindchange="pickRoom">
      <view class="picker">{{selectedRoom.name}} · {{selectedRoom.tenant || '空置'}}</view>
    </picker>

    <text class="label">水费</text>
    <input type="number" placeholder="输入本月水费" data-key="waterFee" bindinput="input"></input>
    <text class="label">电费</text>
    <input type="number" placeholder="输入本月电费" data-key="electricFee" bindinput="input"></input>
    <text class="label">服务费</text>
    <input type="number" value="{{form.serviceFee}}" data-key="serviceFee" bindinput="input"></input>
    <text class="label">优惠减免</text>
    <input type="number" placeholder="无优惠可不填" data-key="discount" bindinput="input"></input>
  </view>

  <view class="summary panel">
    <text class="muted">房租 ¥{{selectedRoom.rent}}</text>
    <text class="sum">本期应收 ¥{{total}}</text>
  </view>

  <button class="btn-gold submit" bindtap="createBill">生成并发送给房客</button>
</view>
