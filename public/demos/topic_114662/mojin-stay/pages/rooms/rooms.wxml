<view class="page">
  <view class="top row">
    <view>
      <text class="eyebrow">ROOMS</text>
      <text class="title">房源管理</text>
    </view>
    <button class="btn-ghost add" bindtap="addRoom">新增</button>
  </view>
  <view wx:for="{{rooms}}" wx:key="id" class="room panel" bindtap="goDetail" data-id="{{item.id}}">
    <image class="cover" src="{{item.cover}}" mode="aspectFill"></image>
    <view class="content">
      <view class="row">
        <text class="room-name">{{item.name}}</text>
        <text class="tag">{{item.status}}</text>
      </view>
      <text class="muted">{{item.city}} · {{item.tenant || '暂无房客'}}</text>
      <view class="row meta">
        <text>租金 ¥{{item.rent}}</text>
        <text>押金 ¥{{item.deposit}}</text>
      </view>
    </view>
  </view>
</view>
