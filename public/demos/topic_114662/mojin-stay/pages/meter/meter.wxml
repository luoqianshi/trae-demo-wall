<view class="page">
  <view class="top">
    <text class="eyebrow">METER</text>
    <text class="title">水电抄表</text>
  </view>
  <view class="panel form">
    <text class="label">本月水表读数</text>
    <input type="digit" placeholder="例如 142.5" data-key="waterEnd" bindinput="input"></input>
    <text class="label">本月电表读数</text>
    <input type="digit" placeholder="例如 1088" data-key="electricEnd" bindinput="input"></input>
    <view class="actions">
      <button class="btn-ghost" bindtap="scan">拍照识别</button>
      <button class="btn-gold" bindtap="save">保存读数</button>
    </view>
  </view>

  <view class="section-head"><text class="section-title">近期记录</text></view>
  <view wx:for="{{meters}}" wx:key="id" class="record panel">
    <view>
      <text class="room">{{item.roomName}}</text>
      <text class="muted">{{item.month}} · {{item.status}}</text>
    </view>
    <text class="gold">水 {{item.waterEnd}} / 电 {{item.electricEnd}}</text>
  </view>
</view>
