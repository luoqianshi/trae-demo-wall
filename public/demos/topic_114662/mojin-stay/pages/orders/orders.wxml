<view class="page">
  <view class="top">
    <text class="eyebrow">BILLS</text>
    <text class="title">租金账单</text>
  </view>
  <view class="tabs">
    <text wx:for="{{tabs}}" wx:key="*this" class="tab {{active===item?'on':''}}" data-tab="{{item}}" bindtap="setTab">{{item}}</text>
  </view>
  <view wx:for="{{list}}" wx:key="id" class="bill panel">
    <view class="row">
      <view>
        <text class="room">{{item.roomName}}</text>
        <text class="muted">{{item.tenant}} · {{item.month}} · 应收 {{item.dueDate}}</text>
      </view>
      <text class="tag {{item.status==='逾期'?'overdue':''}}">{{item.status}}</text>
    </view>
    <view class="calc">
      <text>房租 ¥{{item.rent}}</text>
      <text>水费 ¥{{item.waterFee}}</text>
      <text>电费 ¥{{item.electricFee}}</text>
      <text>服务费 ¥{{item.serviceFee}}</text>
    </view>
    <view class="row bottom">
      <text class="total">合计 ¥{{item.total}}</text>
      <button wx:if="{{item.status !== '已收'}}" class="btn-gold mini" data-id="{{item.id}}" bindtap="markPaid">确认收款</button>
    </view>
  </view>
</view>
