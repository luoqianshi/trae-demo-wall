.top { padding:52rpx 0 24rpx; }
.tabs { display:flex; gap:16rpx; margin-bottom:22rpx; }
.tab { padding:14rpx 26rpx; border-radius:999rpx; color:#8D9A95; background:rgba(255,255,255,.06); font-size:24rpx; }
.tab.on { color:#101715; background:#C9A96A; font-weight:800; }
.bill { padding:26rpx; margin-bottom:20rpx; }
.room { display:block; color:#FFF8E8; font-size:30rpx; font-weight:900; }
.overdue { color:#FFB29B; background:rgba(255,130,100,.12); }
.calc { display:grid; grid-template-columns:repeat(2,1fr); gap:14rpx; margin:28rpx 0; color:#AEB8B4; font-size:24rpx; }
.bottom { border-top:1rpx solid rgba(255,255,255,.08); padding-top:22rpx; }
.total { color:#C9A96A; font-size:34rpx; font-weight:900; }
.mini { width:180rpx; height:62rpx; font-size:24rpx; }
