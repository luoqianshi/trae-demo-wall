<view class="page">
  <view class="card panel">
    <view class="avatar">墨</view>
    <view>
      <text class="name">{{user.name}}</text>
      <text class="muted">{{user.role}}</text>
    </view>
  </view>
  <button class="btn-gold login" bindtap="login">授权微信资料</button>

  <view class="section-head"><text class="section-title">运营设置</text></view>
  <view wx:for="{{menus}}" wx:key="title" class="menu panel">
    <view>
      <text class="menu-title">{{item.title}}</text>
      <text class="muted">{{item.desc}}</text>
    </view>
    <text class="gold">›</text>
  </view>
</view>
