<view class="page">
  <view class="top">
    <text class="eyebrow">SETTLEMENT</text>
    <text class="title">退租结算</text>
  </view>
  <view class="panel form">
    <text class="label">选择房客</text>
    <picker range="{{rooms}}" range-key="tenant" value="{{roomIndex}}" bindchange="pickRoom">
      <view class="picker">{{selectedRoom.tenant}} · {{selectedRoom.name}}</view>
    </picker>
    <text class="label">维修扣款</text>
    <input type="number" data-key="damageFee" bindinput="input" placeholder="0"></input>
    <text class="label">保洁费用</text>
    <input type="number" data-key="cleaningFee" value="{{cleaningFee}}" bindinput="input"></input>
    <text class="label">未结费用</text>
    <input type="number" data-key="unpaidFee" bindinput="input" placeholder="0"></input>
  </view>
  <view class="summary panel">
    <text>押金 ¥{{selectedRoom.deposit}}</text>
    <text class="refund">应退 ¥{{refund}}</text>
  </view>
  <button class="btn-gold submit" bindtap="createReceipt">生成退租收据</button>
</view>
