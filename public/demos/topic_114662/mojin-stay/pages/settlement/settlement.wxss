.top { padding:52rpx 0 24rpx; }
.form { padding:30rpx; }
.label { display:block; margin:24rpx 0 12rpx; color:#8D9A95; font-size:24rpx; }
.picker, input { height:78rpx; padding:0 22rpx; border-radius:18rpx; color:#FFF8E8; background:rgba(255,255,255,.08); font-size:28rpx; box-sizing:border-box; }
