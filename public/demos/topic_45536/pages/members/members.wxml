<view class="container">
  <!-- Member Load -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">成员负载</view>
    </view>
    <view wx:if="{{memberLoad.length === 0}}" class="empty-state">
      <text>暂无待处理任务</text>
    </view>
    <view wx:for="{{memberLoad}}" wx:key="userId" class="member-item">
      <view class="member-avatar">{{item.nickname.charAt(0)}}</view>
      <view class="member-info">
        <view class="member-name">{{item.nickname}}</view>
        <view class="member-role">{{item.roleText}}</view>
      </view>
      <view class="member-load-bar">
        <view class="member-load-fill" style="width:{{item.percent}}%;background:{{item.color}}"></view>
      </view>
      <view class="member-load-count" style="color:{{item.color}}">{{item.count}}</view>
    </view>
  </view>

  <!-- All Members -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">群成员</view>
    </view>
    <view wx:for="{{members}}" wx:key="id" class="member-item">
      <view class="member-avatar">{{item.user.nickname.charAt(0)}}</view>
      <view class="member-info">
        <view class="member-name">{{item.user.nickname}}</view>
        <view class="member-role">{{item.role === 'owner' ? '群主' : '成员'}}</view>
      </view>
    </view>
  </view>
</view>
