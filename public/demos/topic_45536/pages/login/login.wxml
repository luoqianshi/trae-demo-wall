<view class="login-container">
  <view class="login-header">
    <view class="login-icon">任务</view>
    <view class="login-title">任务小本</view>
    <view class="login-subtitle">高效协作，轻松管理任务</view>
  </view>

  <view class="login-form">
    <view class="form-group">
      <text class="form-label">用户名</text>
      <input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
    </view>

    <view class="form-group">
      <text class="form-label">密码</text>
      <input class="form-input" placeholder="请输入密码" password value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <button class="login-btn {{loading ? 'disabled' : ''}}" bindtap="login">{{loading ? '登录中...' : '登录'}}</button>

    <view class="login-tips">
      <text>测试账号：张三(user_001) / 李四(user_002)</text>
      <text>密码：任意输入即可</text>
    </view>
  </view>
</view>
