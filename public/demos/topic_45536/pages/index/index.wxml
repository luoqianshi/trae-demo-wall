<view class="container">
  <!-- User & Group Header -->
  <view class="user-bar" wx:if="{{userInfo}}">
    <view class="user-info">
      <view class="user-avatar">{{userInfo.nickname.charAt(0)}}</view>
      <view class="user-name">{{userInfo.nickname}}</view>
    </view>
    <view class="group-selector" bindtap="switchGroup">
      <text class="group-name">{{currentGroup ? currentGroup.name : '选择群组'}}</text>
      <text class="group-arrow">&#9660;</text>
    </view>
    <view class="logout-btn" bindtap="logout">退出</view>
  </view>

  <!-- Stats -->
  <view class="stats-row">
    <view class="stat-item stat-total">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">全部任务</view>
    </view>
    <view class="stat-item stat-pending">
      <view class="stat-num">{{stats.pending}}</view>
      <view class="stat-label">待处理</view>
    </view>
    <view class="stat-item stat-progress">
      <view class="stat-num">{{stats.inProgress}}</view>
      <view class="stat-label">进行中</view>
    </view>
    <view class="stat-item stat-completed">
      <view class="stat-num">{{stats.completed}}</view>
      <view class="stat-label">已完成</view>
    </view>
    <view class="stat-item stat-overdue">
      <view class="stat-num">{{stats.overdue}}</view>
      <view class="stat-label">已逾期</view>
    </view>
  </view>

  <!-- Task List -->
  <view class="card">
    <view class="filter-tabs">
      <view class="filter-tab {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部</view>
      <view class="filter-tab {{filter === 'pending' ? 'active' : ''}}" bindtap="setFilter" data-filter="pending">待处理</view>
      <view class="filter-tab {{filter === 'in_progress' ? 'active' : ''}}" bindtap="setFilter" data-filter="in_progress">进行中</view>
      <view class="filter-tab {{filter === 'completed' ? 'active' : ''}}" bindtap="setFilter" data-filter="completed">已完成</view>
      <view class="filter-tab {{filter === 'overdue' ? 'active' : ''}}" bindtap="setFilter" data-filter="overdue">已逾期</view>
    </view>

    <view wx:if="{{filteredTasks.length === 0}}" class="empty-state">
      <text>暂无任务</text>
    </view>

    <view wx:for="{{filteredTasks}}" wx:key="id" class="task-item">
      <view class="priority-dot {{item.priority}}"></view>
      <view class="task-info">
        <view class="task-title {{item.status === 'completed' ? 'completed' : ''}}">{{item.title}}</view>
        <view class="task-desc">{{item.description}}</view>
        <view class="task-meta">
          <text>{{item.assigneeName}}</text>
          <text>{{item.dueText}}</text>
        </view>
      </view>
      <view class="task-right">
        <view class="status-badge status-{{item.status}}">{{item.statusText}}</view>
        <view class="priority-badge priority-{{item.priority}}">{{item.priorityText}}</view>
        <view wx:if="{{item.status !== 'completed'}}" class="complete-btn" bindtap="completeTask" data-id="{{item.id}}">完成</view>
      </view>
    </view>
  </view>
</view>
