page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 0 24rpx 40rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-header {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
}

/* User Bar */
.user-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e6f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
}

.user-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.group-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: #f0f0f0;
  border-radius: 24rpx;
}

.group-name {
  font-size: 26rpx;
  color: #666;
}

.group-arrow {
  font-size: 20rpx;
  color: #999;
}

.logout-btn {
  font-size: 26rpx;
  color: #ff4d4f;
  padding: 8rpx 16rpx;
}

/* Stats */
.stats-row {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
}

.stat-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

.stat-total .stat-num { color: #1890ff; }
.stat-pending .stat-num { color: #faad14; }
.stat-progress .stat-num { color: #13c2c2; }
.stat-completed .stat-num { color: #52c41a; }
.stat-overdue .stat-num { color: #ff4d4f; }

/* Filter tabs */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  white-space: nowrap;
}

.filter-tab {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.2s;
}

.filter-tab.active {
  background: #1890ff;
  color: #fff;
}

/* Task item */
.task-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.task-item:last-child {
  border-bottom: none;
}

.priority-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.priority-dot.high { background: #ff4d4f; }
.priority-dot.medium { background: #faad14; }
.priority-dot.low { background: #52c41a; }

.task-info {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.task-title.completed {
  text-decoration: line-through;
  color: #bbb;
}

.task-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.task-meta {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #bbb;
}

.task-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-pending { background: #fff7e6; color: #d48806; }
.status-in_progress { background: #e6fffb; color: #08979c; }
.status-completed { background: #f6ffed; color: #389e0d; }
.status-overdue { background: #fff2f0; color: #cf1322; }

.priority-badge {
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.priority-high { background: #fff1f0; color: #cf1322; }
.priority-medium { background: #fffbe6; color: #d48806; }
.priority-low { background: #f6ffed; color: #389e0d; }

.complete-btn {
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #1890ff;
  border: 1rpx solid #1890ff;
  background: #fff;
  margin-top: 8rpx;
}

.complete-btn:active {
  background: #1890ff;
  color: #fff;
}

/* Member */
.member-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e6f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.member-role {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.member-load-bar {
  width: 120rpx;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.member-load-fill {
  height: 100%;
  border-radius: 6rpx;
}

.member-load-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890ff;
  min-width: 40rpx;
  text-align: right;
}

/* Form */
.form-group {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1890ff;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  color: #333;
}

.submit-btn {
  margin: 40rpx 32rpx;
  height: 88rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  background: #096dd9;
}

.submit-btn.disabled {
  background: #d9d9d9;
  color: #999;
}

/* Login */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.login-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.login-form {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.login-btn.disabled {
  background: #d9d9d9;
  color: #999;
}

.login-tips {
  margin-top: 40rpx;
  text-align: center;
}

.login-tips text {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
