/* app.wxss - 全局样式 */

/* CSS 变量 - 颜色主题 */
page {
  --bg: #fdf8f6;
  --bg2: #fff5f8;
  --bg3: #ffd6e0;
  --ink: #2d2320;
  --muted: #6b5d57;
  --rule: #f0d8e0;
  --accent: #e8788a;
  --accent2: #88c4d8;
  --accent3: #2a9d8f;
  --gold: #c9a227;

  background: linear-gradient(135deg, #faf7f5 0%, #fff5f8 100%);
  min-height: 100vh;
  color: #2d2320;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: normal;
}

button::after {
  border: none;
}
