<!-- pages/index/index.wxml -->

<!-- WXS 模块：提供数组 includes 判断（WXML 数据绑定不支持原生 indexOf 方法调用） -->
<wxs module="arr">
  function includes(list, value) {
    if (!list) return false;
    for (var i = 0; i < list.length; i++) {
      if (list[i] === value) return true;
    }
    return false;
  }
  module.exports = { includes: includes };
</wxs>

<view class="app">

  <!-- 头部：渐变氛围 banner -->
  <view class="app-header">
    <view class="header-banner">
      <view class="header-banner-content">
        <view class="header-emoji-row">
          <text class="header-emoji">🎁</text>
          <text class="header-emoji">💝</text>
          <text class="header-emoji">✨</text>
        </view>
        <view class="title">礼遇 LuckyGift</view>
        <view class="subtitle">为你最特别的TA，找到最用心的礼物</view>
      </view>
      <view class="header-banner-deco"></view>
    </view>
  </view>

  <!-- 进度条 -->
  <view class="progress-bar" wx:if="{{currentSection < 5}}">
    <view
      class="progress-step {{currentSection > item.num ? 'completed' : (currentSection === item.num ? 'active' : '')}}"
      wx:for="{{progressSteps}}"
      wx:key="num"
      data-step="{{item.num}}">
      <view class="num">{{item.num}}</view>
      <view class="step-text">{{item.text}}</view>
    </view>
  </view>

  <!-- ============ 表单部分 ============ -->

  <!-- 步骤1: 基本信息 -->
  <view class="card form-section {{currentSection === 1 ? 'active' : ''}}" wx:if="{{currentSection === 1}}">
    <view class="question">
      <view class="question-label">
        <view class="q-num">1</view>
        <text>TA的性别是？</text>
      </view>
      <view class="option-group">
        <view 
          class="option-chip {{formData.gender === item.value ? 'selected' : ''}}"
          wx:for="{{genderOptions}}" 
          wx:key="value"
          data-field="gender"
          data-value="{{item.value}}"
          bindtap="selectSingle">
          <text class="emoji">{{item.emoji}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="question">
      <view class="question-label">
        <view class="q-num">2</view>
        <text>TA的年龄段是？</text>
      </view>
      <view class="option-group">
        <view 
          class="option-chip {{formData.age === item.value ? 'selected' : ''}}"
          wx:for="{{ageOptions}}" 
          wx:key="value"
          data-field="age"
          data-value="{{item.value}}"
          bindtap="selectSingle">
          <text class="emoji">{{item.emoji}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="question">
      <view class="question-label">
        <view class="q-num">3</view>
        <text>TA的职业类型是？</text>
      </view>
      <view class="option-group">
        <view 
          class="option-chip {{formData.career === item.value ? 'selected' : ''}}"
          wx:for="{{careerOptions}}" 
          wx:key="value"
          data-field="career"
          data-value="{{item.value}}"
          bindtap="selectSingle">
          <text class="emoji">{{item.emoji}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="btn-row">
      <view></view>
      <button class="btn btn-primary" bindtap="nextSection">下一步 →</button>
    </view>
  </view>

  <!-- 步骤2: 兴趣爱好 -->
  <view class="card form-section {{currentSection === 2 ? 'active' : ''}}" wx:if="{{currentSection === 2}}">
    <view class="question">
      <view class="question-label">
        <view class="q-num">4</view>
        <text>TA的兴趣爱好有哪些？（可多选）</text>
      </view>
      <view class="question-desc">选择TA平时喜欢做的事情，帮助我们更精准地推荐</view>
      <view class="hobby-grid">
        <view 
          class="hobby-chip {{arr.includes(formData.hobbies, item.value) ? 'selected' : ''}}"
          wx:for="{{hobbyOptions}}" 
          wx:key="value"
          data-field="hobbies"
          data-value="{{item.value}}"
          bindtap="toggleMulti">
          <text>{{item.emoji}} {{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="question">
      <view class="question-label">
        <view class="q-num">5</view>
        <text>TA的日常习惯更偏向？</text>
      </view>
      <view class="option-group">
        <view 
          class="option-chip {{formData.lifestyle === item.value ? 'selected' : ''}}"
          wx:for="{{lifestyleOptions}}" 
          wx:key="value"
          data-field="lifestyle"
          data-value="{{item.value}}"
          bindtap="selectSingle">
          <text class="emoji">{{item.emoji}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="btn-row">
      <button class="btn btn-secondary" bindtap="prevSection">← 上一步</button>
      <button class="btn btn-primary" bindtap="nextSection">下一步 →</button>
    </view>
  </view>

  <!-- 步骤3: 心愿 & 历史 -->
  <view class="card form-section {{currentSection === 3 ? 'active' : ''}}" wx:if="{{currentSection === 3}}">
    <view class="question">
      <view class="question-label">
        <view class="q-num">6</view>
        <text>TA最近提过想要什么或有什么需求？</text>
      </view>
      <view class="question-desc">回忆一下TA最近说过的话，哪怕是随口一提的小事</view>
      <textarea 
        class="input-field textarea" 
        placeholder="例如：说过想换个新耳机、想去看某场演唱会、一直想买个香薰机..."
        value="{{formData.wish}}"
        data-field="wish"
        bindinput="inputWish"
        maxlength="-1"
        auto-height></textarea>
    </view>

    <view class="question">
      <view class="question-label">
        <view class="q-num">7</view>
        <text>你之前送过TA什么类型的礼物？（可多选，避免重复）</text>
      </view>
      <view class="hobby-grid">
        <view 
          class="hobby-chip {{arr.includes(formData.history, item.value) ? 'selected' : ''}}"
          wx:for="{{historyOptions}}" 
          wx:key="value"
          data-field="history"
          data-value="{{item.value}}"
          bindtap="toggleMulti">
          <text>{{item.emoji}} {{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="btn-row">
      <button class="btn btn-secondary" bindtap="prevSection">← 上一步</button>
      <button class="btn btn-primary" bindtap="nextSection">下一步 →</button>
    </view>
  </view>

  <!-- 步骤4: 预算 -->
  <view class="card form-section {{currentSection === 4 ? 'active' : ''}}" wx:if="{{currentSection === 4}}">
    <view class="question">
      <view class="question-label">
        <view class="q-num">8</view>
        <text>这次礼物的预算范围是？</text>
      </view>
      <view class="range-container">
        <view class="range-value">¥{{formData.budgetMin}} ~ ¥{{formData.budgetMax}}</view>

        <!-- 双滑块区间选择器 -->
        <view class="range-track-wrapper" id="rangeTrack">
          <view class="range-track-bg"></view>
          <view class="range-track-selected" style="left: {{minPercent}}%; width: {{maxPercent - minPercent}}%"></view>
          <view class="range-handle range-handle-min {{activeHandle === 'min' ? 'active' : ''}}"
                style="left: {{minPercent}}%"
                catchtouchstart="onMinHandleTouchStart"
                catchtouchmove="onTrackTouchMove"
                catchtouchend="onTrackTouchEnd"
                catchtouchcancel="onTrackTouchEnd">
            <view class="range-handle-inner"></view>
          </view>
          <view class="range-handle range-handle-max {{activeHandle === 'max' ? 'active' : ''}}"
                style="left: {{maxPercent}}%"
                catchtouchstart="onMaxHandleTouchStart"
                catchtouchmove="onTrackTouchMove"
                catchtouchend="onTrackTouchEnd"
                catchtouchcancel="onTrackTouchEnd">
            <view class="range-handle-inner"></view>
          </view>
        </view>

        <view class="range-labels">
          <text>¥100</text>
          <text>¥1000</text>
          <text>¥2500</text>
          <text>¥5000</text>
        </view>
      </view>
    </view>

    <view class="question">
      <view class="question-label">
        <view class="q-num">9</view>
        <text>这次送礼的场合是？</text>
      </view>
      <view class="option-group">
        <view 
          class="option-chip {{formData.occasion === item.value ? 'selected' : ''}}"
          wx:for="{{occasionOptions}}" 
          wx:key="value"
          data-field="occasion"
          data-value="{{item.value}}"
          bindtap="selectSingle">
          <text class="emoji">{{item.emoji}}</text>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="btn-row">
      <button class="btn btn-secondary" bindtap="prevSection">← 上一步</button>
      <button class="btn btn-primary" bindtap="generateRecommendations">✨ 生成推荐</button>
    </view>
  </view>

  <!-- ============ 结果部分 ============ -->
  <view class="results-section {{currentSection === 5 ? 'active' : ''}}" wx:if="{{currentSection === 5}}">
    
    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">{{loadingText}}</view>
    </view>

    <block wx:else>
      <!-- 用户画像 -->
      <view class="card">
        <view class="user-summary">
          <view class="summary-item">
            <text class="label">性别：</text>
            <text class="value">{{summaryText.gender}}</text>
          </view>
          <view class="summary-item">
            <text class="label">年龄：</text>
            <text class="value">{{summaryText.age}}</text>
          </view>
          <view class="summary-item">
            <text class="label">职业：</text>
            <text class="value">{{summaryText.career}}</text>
          </view>
          <view class="summary-item">
            <text class="label">预算：</text>
            <text class="value">¥{{formData.budgetMin}}~¥{{formData.budgetMax}}</text>
          </view>
          <view class="summary-item">
            <text class="label">场合：</text>
            <text class="value">{{summaryText.occasion}}</text>
          </view>
          <view class="summary-item">
            <text class="label">爱好数：</text>
            <text class="value">{{formData.hobbies.length}}个</text>
          </view>
        </view>

        <view class="results-header">
          <view class="results-title">为TA精选的礼物推荐</view>
          <view class="results-desc">基于你提供的信息，我们从实用性、情感价值、独特性和预算匹配度四个维度为你精选了以下礼物</view>
        </view>

        <!-- 档次标签 -->
        <view class="tier-tabs">
          <view 
            class="tier-tab tier-surprise {{currentTier === 'surprise' ? 'active' : ''}}"
            data-tier="surprise"
            bindtap="switchTier">
            👑 惊喜优选
          </view>
          <view 
            class="tier-tab tier-practical {{currentTier === 'practical' ? 'active' : ''}}"
            data-tier="practical"
            bindtap="switchTier">
            ⭐ 实用精选
          </view>
          <view 
            class="tier-tab tier-heartfelt {{currentTier === 'heartfelt' ? 'active' : ''}}"
            data-tier="heartfelt"
            bindtap="switchTier">
            💝 心意之选
          </view>
          <view class="tier-tab refresh-btn" bindtap="refreshRecommendations">
            🔄 换一批
          </view>
        </view>

        <!-- 兜底提示横幅：当候选池不足已自动放宽过滤条件时展示 -->
        <view class="fallback-banner" wx:if="{{recommendMeta.fallbackLevel > 0}}">
          <view class="fallback-banner-icon">💡</view>
          <view class="fallback-banner-body">
            <view class="fallback-banner-title">{{recommendMeta.fallbackLevel === 1 ? '已自动恢复部分你不感兴趣的礼物' : (recommendMeta.fallbackLevel === 2 ? '已包含部分已送过的类型' : '已展示全部可用礼物')}}</view>
            <view class="fallback-banner-desc">{{recommendMeta.emptyReason}}</view>
          </view>
          <view class="fallback-banner-action" bindtap="clearFeedback" wx:if="{{recommendMeta.fallbackLevel === 1}}">
            清除反馈
          </view>
        </view>

        <!-- 礼物列表 -->
        <view class="gift-list" wx:if="{{displayGifts.length > 0}}">
          <view class="gift-card" wx:for="{{displayGifts}}" wx:key="id" wx:for-item="gift" wx:for-index="idx">
            <!-- 礼物主图区域：品类图标 + 渐变色背景（含广告角标 + 浮层反馈按钮） -->
            <view class="gift-card-image" style="background: {{gift.categoryGradient}}">
              <text class="gift-category-icon">{{gift.categoryIcon}}</text>
              <view class="gift-ad-corner" wx:if="{{gift.isAd}}">广告</view>
              <!-- 浮层反馈按钮：上浮到主图右下角，浏览态快捷反馈 -->
              <view class="gift-feedback-float">
                <view class="feedback-float-btn like-float {{gift.isLiked ? 'active' : ''}}"
                      hover-class="feedback-float-hover"
                      data-gift-id="{{gift.id}}"
                      bindtap="toggleLike">
                  <text>{{gift.isLiked ? '❤' : '♡'}}</text>
                </view>
                <view class="feedback-float-btn dislike-float {{gift.isDisliked ? 'active' : ''}}"
                      hover-class="feedback-float-hover"
                      data-gift-id="{{gift.id}}"
                      bindtap="toggleDislike">
                  <text>✕</text>
                </view>
              </view>
            </view>
            <!-- 标题行：名称 + 推荐指数 + 价格 -->
            <view class="gift-card-header">
              <view class="gift-card-info">
                <view class="gift-name">
                  {{gift.name}}
                  <text class="ad-tag" wx:if="{{gift.isAd}}">广告</text>
                </view>
                <view class="gift-score">
                  <view class="score-badge">推荐指数 {{gift.scoreDetails.total}}</view>
                  <view class="merchant-badge" wx:if="{{gift.isAd}}">{{gift.merchantName}}</view>
                </view>
              </view>
              <view class="gift-price">¥{{gift.basePrice}}</view>
            </view>
            <view class="gift-card-body">
              <!-- 浏览态：一句话理由（单行省略） -->
              <view class="gift-reason gift-reason-ellipsis">{{gift.reason}}</view>

              <!-- 浏览态：购买渠道横滑 chip（快捷查看/跳转） -->
              <scroll-view scroll-x class="platform-chips" wx:if="{{!gift.isExpanded && gift.platformsShow.length > 0}}">
                <view class="platform-chip {{p.url ? 'clickable' : ''}}"
                      wx:for="{{gift.platformsShow}}"
                      wx:key="name"
                      wx:for-item="p"
                      data-url="{{p.url}}"
                      data-name="{{p.name}}"
                      data-gift-name="{{gift.name}}"
                      bindtap="onPlatformTap">
                  <text class="platform-chip-name">{{p.name}}</text>
                  <text class="platform-chip-price">{{p.priceText}}</text>
                  <text class="platform-chip-go">›</text>
                </view>
              </scroll-view>

              <!-- 浏览态：底部操作行（喜欢 / 不感兴趣 / 展开详情） -->
              <view class="gift-action-row" wx:if="{{!gift.isExpanded}}">
                <view class="feedback-btn like-btn {{gift.isLiked ? 'active' : ''}}"
                      hover-class="feedback-btn-hover"
                      hover-stay-time="100"
                      data-gift-id="{{gift.id}}"
                      bindtap="toggleLike">
                  <text class="feedback-icon">{{gift.isLiked ? '❤' : '♡'}}</text>
                  <text class="feedback-text">{{gift.isLiked ? '已喜欢' : '喜欢'}}</text>
                </view>
                <view class="feedback-btn dislike-btn {{gift.isDisliked ? 'active' : ''}}"
                      hover-class="feedback-btn-hover"
                      hover-stay-time="100"
                      data-gift-id="{{gift.id}}"
                      bindtap="toggleDislike">
                  <text class="feedback-icon">✕</text>
                  <text class="feedback-text">{{gift.isDisliked ? '已不感兴趣' : '不感兴趣'}}</text>
                </view>
                <view class="gift-expand-trigger"
                      hover-class="feedback-btn-hover"
                      data-gift-id="{{gift.id}}"
                      bindtap="toggleGiftExpand">
                  <text class="feedback-text">展开详情</text>
                  <text class="feedback-icon">↓</text>
                </view>
              </view>

              <!-- 展开态：完整详情（四维评分 + 场景 + 包装 + 祝福语 + 完整渠道对比 + 反馈文字） -->
              <view class="gift-expanded-body" wx:if="{{gift.isExpanded}}">
                <!-- 四维评分 -->
                <view class="score-breakdown">
                  <view class="breakdown-title">四维评分</view>
                  <view class="score-bars">
                    <view class="score-bar-row">
                      <text class="score-bar-label">实用性</text>
                      <view class="score-bar-track">
                        <view class="score-bar-fill practical" style="width: {{gift.scoreDetails.practical}}%"></view>
                      </view>
                      <text class="score-bar-value">{{gift.scoreDetails.practical}}</text>
                    </view>
                    <view class="score-bar-row">
                      <text class="score-bar-label">情感价值</text>
                      <view class="score-bar-track">
                        <view class="score-bar-fill emotional" style="width: {{gift.scoreDetails.emotional}}%"></view>
                      </view>
                      <text class="score-bar-value">{{gift.scoreDetails.emotional}}</text>
                    </view>
                    <view class="score-bar-row">
                      <text class="score-bar-label">独特性</text>
                      <view class="score-bar-track">
                        <view class="score-bar-fill unique" style="width: {{gift.scoreDetails.unique}}%"></view>
                      </view>
                      <text class="score-bar-value">{{gift.scoreDetails.unique}}</text>
                    </view>
                    <view class="score-bar-row">
                      <text class="score-bar-label">预算匹配</text>
                      <view class="score-bar-track">
                        <view class="score-bar-fill budget" style="width: {{gift.scoreDetails.budgetMatch}}%"></view>
                      </view>
                      <text class="score-bar-value">{{gift.scoreDetails.budgetMatch}}</text>
                    </view>
                  </view>
                </view>

                <!-- 详情网格 -->
                <view class="gift-details">
                  <view class="detail-block">
                    <view class="detail-title">🎯 适用场景</view>
                    <view class="detail-list">
                      <view class="detail-item" wx:for="{{gift.scenariosShow}}" wx:key="*this" wx:for-item="s">• {{s}}</view>
                    </view>
                  </view>
                  <view class="detail-block">
                    <view class="detail-title">🎁 包装建议</view>
                    <view class="detail-list">
                      <view class="detail-item" wx:for="{{gift.packagingIdeasShow}}" wx:key="*this" wx:for-item="idea">• {{idea}}</view>
                    </view>
                  </view>
                  <view class="detail-block">
                    <view class="detail-title">💌 祝福语</view>
                    <view class="wish-text">"{{gift.wishShow}}"</view>
                  </view>
                </view>

                <!-- 完整购买渠道对比表（竖排） -->
                <view class="platform-section">
                  <view class="platform-title">🛒 购买渠道对比（点击跳转购买）</view>
                  <view class="platform-list">
                    <view class="platform-item {{p.url ? 'clickable' : ''}}"
                          wx:for="{{gift.platformsShow}}"
                          wx:key="name"
                          wx:for-item="p"
                          hover-class="{{p.url ? 'platform-item-hover' : ''}}"
                          hover-stay-time="100"
                          data-url="{{p.url}}"
                          data-name="{{p.name}}"
                          data-gift-name="{{gift.name}}"
                          bindtap="onPlatformTap">
                      <view class="platform-name-row">
                        <text class="platform-name">{{p.name}}</text>
                        <text class="platform-badge" wx:if="{{p.badge}}">{{p.badge}}</text>
                      </view>
                      <view class="platform-price-row">
                        <text class="platform-price">{{p.priceText}}</text>
                        <text class="platform-go" wx:if="{{p.url}}">前往 ›</text>
                      </view>
                    </view>
                  </view>
                </view>

                <!-- 反馈文字提示（展开态保留已喜欢/已不感兴趣状态文字） -->
                <view class="feedback-section">
                  <view class="feedback-btn like-btn {{gift.isLiked ? 'active' : ''}}"
                        hover-class="feedback-btn-hover"
                        hover-stay-time="100"
                        data-gift-id="{{gift.id}}"
                        bindtap="toggleLike">
                    <text class="feedback-icon">{{gift.isLiked ? '❤' : '♡'}}</text>
                    <text class="feedback-text">{{gift.isLiked ? '已喜欢' : '喜欢'}}</text>
                  </view>
                  <view class="feedback-btn dislike-btn {{gift.isDisliked ? 'active' : ''}}"
                        hover-class="feedback-btn-hover"
                        hover-stay-time="100"
                        data-gift-id="{{gift.id}}"
                        bindtap="toggleDislike">
                    <text class="feedback-icon">✕</text>
                    <text class="feedback-text">{{gift.isDisliked ? '已不感兴趣' : '不感兴趣'}}</text>
                  </view>
                  <view class="gift-expand-trigger gift-collapse-trigger"
                        hover-class="feedback-btn-hover"
                        data-gift-id="{{gift.id}}"
                        bindtap="toggleGiftExpand">
                    <text class="feedback-text">收起</text>
                    <text class="feedback-icon">↑</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 空状态：本档或全局无推荐时的分级引导 -->
        <view class="empty-state" wx:else>
          <view class="empty-state-icon">{{recommendMeta.isEmpty ? '🗂️' : '🔍'}}</view>
          <view class="empty-state-title">{{recommendMeta.isEmpty ? '当前条件下暂无匹配礼物' : '该档次暂无匹配礼物'}}</view>
          <view class="empty-state-desc" wx:if="{{recommendMeta.emptyReason}}">{{recommendMeta.emptyReason}}</view>
          <view class="empty-state-desc" wx:else>可以尝试下面的方法，扩大匹配范围：</view>

          <view class="empty-state-actions">
            <!-- 切换到其他档次 -->
            <view class="empty-action-btn" wx:if="{{!recommendMeta.isEmpty}}"
              data-tier="{{currentTier === 'surprise' ? 'practical' : 'surprise'}}"
              bindtap="switchTier">
              切换其他档次
            </view>
            <!-- 清除反馈（仅当存在反馈数据时） -->
            <view class="empty-action-btn" bindtap="clearFeedback"
              wx:if="{{formData.feedback.dislikedGiftIds.length > 0 || formData.feedback.likedGiftIds.length > 0}}">
              清除反馈数据
            </view>
            <!-- 调整预算/送过类型：回到表单 -->
            <view class="empty-action-btn empty-action-primary" bindtap="goBackToAdjust">
              调整预算 / 送过类型
            </view>
          </view>
        </view>
      </view>

      <!-- 生命周期建议 -->
      <view class="card lifecycle-section">
        <view class="lifecycle-title">🌟 礼物生命周期建议</view>
        <view class="lifecycle-grid">
          <view class="lifecycle-card" wx:for="{{lifecycleData}}" wx:key="title">
            <view class="lifecycle-icon">{{item.icon}}</view>
            <view class="lifecycle-card-title">{{item.title}}</view>
            <view class="lifecycle-desc">{{item.desc}}</view>
            <view class="lifecycle-tips">
              <view class="lifecycle-tip" wx:for="{{item.tips}}" wx:key="*this" wx:for-item="tip">♥ {{tip}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 操作栏 -->
      <view class="action-bar">
        <button class="btn btn-secondary" bindtap="prevSection">← 上一步</button>
        <button class="btn btn-secondary" bindtap="restartForm">重新填写</button>
        <button class="btn btn-accent2" bindtap="exportReportImage">📷 导出报告图片</button>
        <button class="btn btn-primary" bindtap="saveRecommendations">💾 保存方案</button>
      </view>
    </block>
  </view>

</view>

<!-- 导出图片用的隐藏 canvas -->
<canvas type="2d" id="reportCanvas" class="hidden-canvas"></canvas>
