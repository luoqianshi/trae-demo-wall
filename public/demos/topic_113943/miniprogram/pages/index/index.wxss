/* pages/index/index.wxss */

.app {
  padding: 30rpx 24rpx 80rpx;
  min-height: 100vh;
}

/* ============ 头部（渐变氛围 banner） ============ */
.app-header {
  text-align: center;
  padding: 30rpx 0 20rpx;
  margin-bottom: 24rpx;
}

.header-banner {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #ffd6e0 0%, #fff5f8 50%, #d4e8f5 100%);
  box-shadow: 0 8rpx 32rpx rgba(232, 120, 138, 0.12);
}

.header-banner-content {
  position: relative;
  z-index: 2;
  text-align: center;
}

.header-emoji-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.header-emoji {
  font-size: 56rpx;
  animation: float 2s ease-in-out infinite;
}

.header-emoji:nth-child(2) {
  animation-delay: 0.3s;
}

.header-emoji:nth-child(3) {
  animation-delay: 0.6s;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* 右上角装饰圆 */
.header-banner-deco {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.app-header .title {
  font-size: 48rpx;
  color: #e8788a;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.app-header .subtitle {
  color: #6b5d57;
  font-size: 26rpx;
}

/* ============ 进度条 ============ */
.progress-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.progress-step {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx;
  background: white;
  border: 1px solid #f0d8e0;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #6b5d57;
  transition: all 0.3s;
}

.progress-step.active {
  background: #e8788a;
  color: white;
  border-color: #e8788a;
}

.progress-step.completed {
  background: #2a9d8f;
  color: white;
  border-color: #2a9d8f;
}

.progress-step .num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

/* ============ 卡片 ============ */
.card {
  background: white;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(232, 120, 138, 0.12);
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.form-section {
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============ 问题 ============ */
.question {
  margin-bottom: 40rpx;
}

.question-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d2320;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.q-num {
  width: 50rpx;
  height: 50rpx;
  background: #e8788a;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

.question-desc {
  color: #6b5d57;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

/* ============ 选项芯片 ============ */
.option-group {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220rpx, 1fr));
  gap: 16rpx;
}

.option-chip {
  padding: 26rpx 24rpx;
  border: 2rpx solid #f0d8e0;
  border-radius: 20rpx;
  background: white;
  text-align: center;
  font-size: 28rpx;
  transition: all 0.25s;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.option-chip.selected {
  border-color: #e8788a;
  background: #ffd6e0;
  color: #e8788a;
  font-weight: 600;
}

.option-chip .emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* ============ 多选 ============ */
.hobby-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200rpx, 1fr));
  gap: 14rpx;
}

.hobby-chip {
  padding: 24rpx 20rpx;
  border: 2rpx solid #f0d8e0;
  border-radius: 14rpx;
  background: white;
  text-align: center;
  font-size: 26rpx;
  transition: all 0.2s;
}

.hobby-chip.selected {
  border-color: #e8788a;
  background: #ffd6e0;
  color: #e8788a;
  font-weight: 600;
}

/* ============ 输入框 ============ */
.input-field {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #f0d8e0;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: white;
  color: #2d2320;
}

.textarea {
  min-height: 160rpx;
  line-height: 1.6;
}

/* ============ 滑块 ============ */
.range-container {
  padding: 16rpx 0;
}

.range-value {
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #e8788a;
  margin-bottom: 50rpx;
  letter-spacing: 1rpx;
}

.range-labels {
  display: flex;
  justify-content: space-between;
  color: #6b5d57;
  font-size: 24rpx;
  margin-top: 24rpx;
}

/* ============ 双滑块区间选择器 ============ */
.range-track-wrapper {
  position: relative;
  height: 60rpx;
  padding: 0 30rpx;
  margin: 0 8rpx;
}

.range-track-bg {
  position: absolute;
  top: 50%;
  left: 30rpx;
  right: 30rpx;
  height: 8rpx;
  background: #f0d8e0;
  border-radius: 4rpx;
  transform: translateY(-50%);
}

.range-track-selected {
  position: absolute;
  top: 50%;
  height: 8rpx;
  background: linear-gradient(90deg, #e8788a, #88c4d8);
  border-radius: 4rpx;
  transform: translateY(-50%);
}

.range-handle {
  position: absolute;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  margin-left: -44rpx;
  margin-top: -44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.range-handle-inner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: white;
  border: 6rpx solid #e8788a;
  box-shadow: 0 4rpx 12rpx rgba(232, 120, 138, 0.35);
  transition: transform 0.15s ease;
}

.range-handle.active .range-handle-inner {
  transform: scale(1.2);
  border-color: #d4687a;
  box-shadow: 0 6rpx 18rpx rgba(232, 120, 138, 0.5);
}

/* ============ 按钮 ============ */
.btn-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 40rpx;
  flex-wrap: wrap;
}

.btn {
  padding: 22rpx 50rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  line-height: 1.4;
}

.btn-primary {
  background: linear-gradient(135deg, #e8788a, #d4687a);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(232, 120, 138, 0.3);
}

.btn-secondary {
  background: white;
  color: #6b5d57;
  border: 2rpx solid #f0d8e0;
}

.btn-accent2 {
  background: linear-gradient(135deg, #88c4d8, #78b4c8);
  color: white;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

/* ============ 结果部分 ============ */
.results-section {
  animation: fadeIn 0.5s ease;
}

/* 用户摘要 */
.user-summary {
  background: linear-gradient(135deg, #ffd6e0, #fff5f8);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 30rpx;
  font-size: 26rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.summary-item .label {
  color: #6b5d57;
}

.summary-item .value {
  font-weight: 600;
  color: #2d2320;
}

/* 结果标题 */
.results-header {
  text-align: center;
  margin-bottom: 36rpx;
  padding: 20rpx 0;
}

.results-title {
  font-size: 40rpx;
  color: #e8788a;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.results-desc {
  color: #6b5d57;
  font-size: 26rpx;
  line-height: 1.6;
  padding: 0 20rpx;
}

/* 档次标签 */
.tier-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.tier-tab {
  padding: 18rpx 32rpx;
  border: 2rpx solid #f0d8e0;
  border-radius: 16rpx;
  background: white;
  font-weight: 600;
  font-size: 28rpx;
  transition: all 0.25s;
  text-align: center;
}

.tier-tab.active {
  color: white;
  border-color: transparent;
}

.tier-tab.tier-surprise.active {
  background: linear-gradient(135deg, #e8788a, #c4586a);
}

.tier-tab.tier-practical.active {
  background: linear-gradient(135deg, #88c4d8, #78b4c8);
}

.tier-tab.tier-heartfelt.active {
  background: linear-gradient(135deg, #f4b8d4, #e4a4c4);
}

.tier-tab.refresh-btn {
  background: white;
  color: #6b5d57;
}

/* ============ 礼物卡片 ============ */
.gift-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.gift-card {
  background: white;
  border-radius: 28rpx;
  border: 1rpx solid #f0d8e0;
  overflow: hidden;
}

/* 礼物主图区域：品类图标 + 渐变色背景 */
.gift-card-image {
  position: relative;
  width: 100%;
  height: 340rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gift-category-icon {
  font-size: 120rpx;
  line-height: 1;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.gift-ad-corner {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 14rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.gift-card-header {
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #fff5f8, white);
  border-bottom: 1rpx solid #f0d8e0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.gift-card-info {
  flex: 1;
}

.gift-name {
  font-size: 32rpx;
  color: #2d2320;
  font-weight: 700;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.gift-score {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-badge {
  background: #2a9d8f;
  color: white;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.gift-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8788a;
  white-space: nowrap;
}

.gift-card-body {
  padding: 28rpx 32rpx;
}

.gift-reason {
  color: #6b5d57;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

/* 四维评分 */
.score-breakdown {
  background: #fff5f8;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.breakdown-title {
  font-size: 22rpx;
  color: #6b5d57;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.score-bars {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.score-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.score-bar-label {
  width: 140rpx;
  color: #6b5d57;
  flex-shrink: 0;
}

.score-bar-track {
  flex: 1;
  height: 14rpx;
  background: #f0d8e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.score-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

.score-bar-fill.practical { background: #2a9d8f; }
.score-bar-fill.emotional { background: #e8788a; }
.score-bar-fill.unique { background: #f4b8d4; }
.score-bar-fill.budget { background: #c9a227; }

.score-bar-value {
  width: 60rpx;
  text-align: right;
  font-weight: 600;
  color: #2d2320;
  flex-shrink: 0;
}

/* 详情网格 */
.gift-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.detail-block {
  background: #fff5f8;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
}

.detail-title {
  font-size: 24rpx;
  color: #e8788a;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-item {
  font-size: 24rpx;
  color: #2d2320;
  line-height: 1.6;
}

.wish-text {
  font-size: 24rpx;
  font-style: italic;
  color: #e8788a;
  line-height: 1.6;
}

/* 购买渠道 */
.platform-section {
  margin-top: 12rpx;
}

.platform-title {
  font-size: 24rpx;
  color: #6b5d57;
  margin-bottom: 14rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.platform-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.platform-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  background: white;
  border: 1rpx solid #f0d8e0;
  border-radius: 12rpx;
  font-size: 26rpx;
  transition: background 0.15s;
}

.platform-item.clickable {
  cursor: pointer;
}

.platform-item-hover {
  background: #fff5f8;
  border-color: #88c4d8;
}

.platform-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.platform-name {
  font-weight: 600;
  color: #2d2320;
}

.platform-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: #2a9d8f;
  color: white;
}

.platform-price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.platform-price {
  color: #e8788a;
  font-weight: 700;
}

.platform-go {
  font-size: 22rpx;
  color: #88c4d8;
  font-weight: 500;
}

/* ============ 广告标识 ============ */
.ad-tag {
  display: inline-block;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  border-radius: 6rpx;
  background: #88c4d8;
  color: white;
  vertical-align: middle;
  font-weight: normal;
}

.merchant-badge {
  font-size: 20rpx;
  color: #6b5d57;
  background: #fff5f8;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  border: 1rpx solid #88c4d8;
}

/* ============ 用户反馈按钮 ============ */
.feedback-section {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #f0d8e0;
}

.feedback-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 24rpx;
  border: 1rpx solid #e0c8d0;
  background: white;
  color: #6b5d57;
  transition: all 0.2s;
}

.feedback-btn-hover {
  background: #fff5f8;
}

.feedback-icon {
  font-size: 28rpx;
}

/* 喜欢按钮选中态 */
.like-btn.active {
  background: #e8f4f8;
  border-color: #e8788a;
  color: #e8788a;
  font-weight: 600;
}

/* 不感兴趣按钮选中态 */
.dislike-btn.active {
  background: #f5f5f5;
  border-color: #999;
  color: #666;
  text-decoration: line-through;
}

/* ============ 生命周期 ============ */
.lifecycle-section {
  margin-top: 24rpx;
}

.lifecycle-title {
  font-size: 36rpx;
  color: #e8788a;
  margin-bottom: 24rpx;
  text-align: center;
  font-weight: 700;
}

.lifecycle-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.lifecycle-card {
  background: white;
  border-radius: 18rpx;
  padding: 28rpx;
  border: 1rpx solid #f0d8e0;
}

.lifecycle-icon {
  font-size: 56rpx;
  margin-bottom: 14rpx;
}

.lifecycle-card-title {
  font-size: 30rpx;
  color: #2d2320;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.lifecycle-desc {
  font-size: 26rpx;
  color: #6b5d57;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.lifecycle-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lifecycle-tip {
  font-size: 24rpx;
  color: #6b5d57;
  line-height: 1.6;
  padding-left: 8rpx;
}

/* ============ 操作栏 ============ */
.action-bar {
  background: white;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 60rpx rgba(232, 120, 138, 0.15);
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 30rpx;
}

/* ============ 加载中 ============ */
.loading {
  text-align: center;
  padding: 100rpx 30rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f0d8e0;
  border-top-color: #e8788a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #6b5d57;
  font-size: 28rpx;
}

/* ============ 兜底提示横幅 ============ */
.fallback-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff5f8 0%, #e8f4f8 100%);
  border: 1rpx solid #f0c8d4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 20rpx 0 8rpx;
}
.fallback-banner-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.fallback-banner-body {
  flex: 1;
  min-width: 0;
}
.fallback-banner-title {
  font-size: 26rpx;
  color: #b8762a;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.fallback-banner-desc {
  font-size: 24rpx;
  color: #6b5d57;
  line-height: 1.4;
}
.fallback-banner-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 22rpx;
  background: #e8788a;
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  line-height: 1;
}

/* ============ 空状态引导卡片 ============ */
.empty-state {
  text-align: center;
  padding: 70rpx 40rpx 60rpx;
}
.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.empty-state-title {
  font-size: 32rpx;
  color: #5a4a44;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.empty-state-desc {
  font-size: 26rpx;
  color: #6b5d57;
  line-height: 1.5;
  margin-bottom: 36rpx;
  padding: 0 20rpx;
}
.empty-state-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.empty-action-btn {
  padding: 18rpx 48rpx;
  font-size: 28rpx;
  color: #e8788a;
  background: #fff5f8;
  border: 1rpx solid #f0c8d4;
  border-radius: 40rpx;
  line-height: 1.2;
}
.empty-action-btn.empty-action-primary {
  color: #fff;
  background: linear-gradient(135deg, #e8788a 0%, #78b4c8 100%);
  border: none;
}

/* ============ 改进1：礼物卡片分层（浏览态 / 展开态） ============ */
/* 浏览态一句话理由：单行省略 */
.gift-reason-ellipsis {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 浏览态底部操作行：喜欢 / 不感兴趣 / 展开详情 */
.gift-action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #f0d8e0;
}

/* 展开详情触发按钮（带 ↓ 箭头） */
.gift-expand-trigger {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 24rpx;
  border: 1rpx solid #88c4d8;
  background: #fff5f8;
  color: #88c4d8;
  transition: all 0.2s;
}

/* 展开态内容区：顶部分割线 + 淡入动画（复用 fadeIn） */
.gift-expanded-body {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0d8e0;
  animation: fadeIn 0.4s ease;
}

/* 展开态尾部"收起"按钮 */
.gift-collapse-trigger {
  border-color: #e0c8d0;
  background: white;
  color: #6b5d57;
}

/* ============ 改进3：购买渠道横滑 chip ============ */
.platform-chips {
  white-space: nowrap;
  padding: 8rpx 0;
  margin-bottom: 8rpx;
}

.platform-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  margin-right: 12rpx;
  background: #fff5f8;
  border: 1rpx solid #f0d8e0;
  border-radius: 30rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.platform-chip.clickable {
  border-color: #88c4d8;
  background: #fff5f8;
}

.platform-chip-name {
  color: #2d2320;
  font-weight: 500;
}

.platform-chip-price {
  color: #e8788a;
  font-weight: 600;
}

.platform-chip-go {
  color: #88c4d8;
  font-size: 28rpx;
}

/* ============ 改进4：浮层反馈按钮（上浮到主图） ============ */
.gift-feedback-float {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  gap: 10rpx;
  z-index: 5;
}

.feedback-float-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #6b5d57;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.15s ease;
}

.feedback-float-btn.like-float.active {
  color: #e8788a;
  background: #fff;
}

.feedback-float-btn.dislike-float.active {
  color: #fff;
  background: #999;
}

.feedback-float-hover {
  transform: scale(0.92);
}

/* ============ 隐藏的 canvas ============ */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  width: 750rpx;
  height: 1200rpx;
}
