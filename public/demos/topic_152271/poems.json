{
  "meta": {
    "project": "诗轴画布·唐诗流转",
    "description": "按意象组组织的 30 首古诗数据，用于 3D 诗轴交互展示与相似度计算。"
  },
  "groups": [
    {
      "id": "moon",
      "name": "明月组",
      "imagery": "明月",
      "poems": [
        {
          "id": "p01",
          "title": "静夜思",
          "author": "李白",
          "content": "床前明月光，疑是地上霜。\n举头望明月，低头思故乡。",
          "lines": ["床前明月光", "疑是地上霜", "举头望明月", "低头思故乡"],
          "keywords": ["明月", "夜色", "故乡", "床前", "霜华"],
          "themes": ["思乡", "月夜", "乡愁"],
          "style": "婉约",
          "imagery": "明月"
        },
        {
          "id": "p02",
          "title": "望月怀远",
          "author": "张九龄",
          "content": "海上生明月，天涯共此时。\n情人怨遥夜，竟夕起相思。",
          "lines": ["海上生明月", "天涯共此时", "情人怨遥夜", "竟夕起相思"],
          "keywords": ["明月", "天涯", "相思", "遥夜", "海上"],
          "themes": ["怀远", "相思", "明月"],
          "style": "婉约",
          "imagery": "明月"
        },
        {
          "id": "p03",
          "title": "月夜忆舍弟",
          "author": "杜甫",
          "content": "戍鼓断人行，边秋一雁声。\n露从今夜白，月是故乡明。\n有弟皆分散，无家问死生。\n寄书长不达，况乃未休兵。",
          "lines": ["戍鼓断人行", "边秋一雁声", "露从今夜白", "月是故乡明", "有弟皆分散", "无家问死生", "寄书长不达", "况乃未休兵"],
          "keywords": ["故乡", "月夜", "兄弟", "边秋", "战乱", "雁声"],
          "themes": ["思亲", "战乱", "思乡"],
          "style": "沉郁",
          "imagery": "明月"
        },
        {
          "id": "p04",
          "title": "枫桥夜泊",
          "author": "张继",
          "content": "月落乌啼霜满天，江枫渔火对愁眠。\n姑苏城外寒山寺，夜半钟声到客船。",
          "lines": ["月落乌啼霜满天", "江枫渔火对愁眠", "姑苏城外寒山寺", "夜半钟声到客船"],
          "keywords": ["月落", "霜天", "江枫", "渔火", "客船", "钟声"],
          "themes": ["羁旅", "愁思", "夜泊"],
          "style": "沉郁",
          "imagery": "明月"
        }
      ]
    },
    {
      "id": "farewell",
      "name": "送别组",
      "imagery": "离别",
      "poems": [
        {
          "id": "p05",
          "title": "送杜少府之任蜀州",
          "author": "王勃",
          "content": "城阙辅三秦，风烟望五津。\n与君离别意，同是宦游人。\n海内存知己，天涯若比邻。\n无为在歧路，儿女共沾巾。",
          "lines": ["城阙辅三秦", "风烟望五津", "与君离别意", "同是宦游人", "海内存知己", "天涯若比邻", "无为在歧路", "儿女共沾巾"],
          "keywords": ["离别", "知己", "天涯", "蜀州", "歧路"],
          "themes": ["送别", "友情", "勉励"],
          "style": "豪放",
          "imagery": "离别"
        },
        {
          "id": "p06",
          "title": "送元二使安西",
          "author": "王维",
          "content": "渭城朝雨浥轻尘，客舍青青柳色新。\n劝君更尽一杯酒，西出阳关无故人。",
          "lines": ["渭城朝雨浥轻尘", "客舍青青柳色新", "劝君更尽一杯酒", "西出阳关无故人"],
          "keywords": ["朝雨", "柳色", "杯酒", "阳关", "故人"],
          "themes": ["送别", "友情", "边关"],
          "style": "婉约",
          "imagery": "离别"
        },
        {
          "id": "p07",
          "title": "别董大",
          "author": "高适",
          "content": "千里黄云白日曛，北风吹雁雪纷纷。\n莫愁前路无知己，天下谁人不识君。",
          "lines": ["千里黄云白日曛", "北风吹雁雪纷纷", "莫愁前路无知己", "天下谁人不识君"],
          "keywords": ["黄云", "北风", "飞雁", "知己", "前路"],
          "themes": ["送别", "勉励", "友情"],
          "style": "豪放",
          "imagery": "离别"
        }
      ]
    },
    {
      "id": "landscape",
      "name": "山水组",
      "imagery": "山水",
      "poems": [
        {
          "id": "p08",
          "title": "望庐山瀑布",
          "author": "李白",
          "content": "日照香炉生紫烟，遥看瀑布挂前川。\n飞流直下三千尺，疑是银河落九天。",
          "lines": ["日照香炉生紫烟", "遥看瀑布挂前川", "飞流直下三千尺", "疑是银河落九天"],
          "keywords": ["庐山", "瀑布", "紫烟", "银河", "九天"],
          "themes": ["山水", "奇景", "想象"],
          "style": "豪放",
          "imagery": "山水"
        },
        {
          "id": "p09",
          "title": "登鹳雀楼",
          "author": "王之涣",
          "content": "白日依山尽，黄河入海流。\n欲穷千里目，更上一层楼。",
          "lines": ["白日依山尽", "黄河入海流", "欲穷千里目", "更上一层楼"],
          "keywords": ["白日", "黄河", "高楼", "千里", "登临"],
          "themes": ["山河", "志向", "哲理"],
          "style": "豪放",
          "imagery": "黄河"
        },
        {
          "id": "p10",
          "title": "春晓",
          "author": "孟浩然",
          "content": "春眠不觉晓，处处闻啼鸟。\n夜来风雨声，花落知多少。",
          "lines": ["春眠不觉晓", "处处闻啼鸟", "夜来风雨声", "花落知多少"],
          "keywords": ["春晓", "啼鸟", "风雨", "花落", "晨晓"],
          "themes": ["春景", "惜春", "自然"],
          "style": "朴实",
          "imagery": "山水"
        },
        {
          "id": "p11",
          "title": "鹿柴",
          "author": "王维",
          "content": "空山不见人，但闻人语响。\n返景入深林，复照青苔上。",
          "lines": ["空山不见人", "但闻人语响", "返景入深林", "复照青苔上"],
          "keywords": ["空山", "人语", "返景", "深林", "青苔"],
          "themes": ["山林", "空寂", "禅意"],
          "style": "婉约",
          "imagery": "山水"
        },
        {
          "id": "p12",
          "title": "鸟鸣涧",
          "author": "王维",
          "content": "人闲桂花落，夜静春山空。\n月出惊山鸟，时鸣春涧中。",
          "lines": ["人闲桂花落", "夜静春山空", "月出惊山鸟", "时鸣春涧中"],
          "keywords": ["桂花", "春山", "月出", "山鸟", "春涧"],
          "themes": ["山水", "幽静", "月夜"],
          "style": "婉约",
          "imagery": "山水"
        }
      ]
    },
    {
      "id": "frontier",
      "name": "边塞组",
      "imagery": "边塞",
      "poems": [
        {
          "id": "p13",
          "title": "出塞",
          "author": "王昌龄",
          "content": "秦时明月汉时关，万里长征人未还。\n但使龙城飞将在，不教胡马度阴山。",
          "lines": ["秦时明月汉时关", "万里长征人未还", "但使龙城飞将在", "不教胡马度阴山"],
          "keywords": ["明月", "边关", "长征", "飞将", "阴山"],
          "themes": ["边塞", "征战", "家国"],
          "style": "豪放",
          "imagery": "边塞"
        },
        {
          "id": "p14",
          "title": "凉州词",
          "author": "王之涣",
          "content": "黄河远上白云间，一片孤城万仞山。\n羌笛何须怨杨柳，春风不度玉门关。",
          "lines": ["黄河远上白云间", "一片孤城万仞山", "羌笛何须怨杨柳", "春风不度玉门关"],
          "keywords": ["黄河", "孤城", "羌笛", "杨柳", "玉门关"],
          "themes": ["边塞", "苍凉", "离愁"],
          "style": "豪放",
          "imagery": "黄河"
        },
        {
          "id": "p15",
          "title": "从军行",
          "author": "王昌龄",
          "content": "青海长云暗雪山，孤城遥望玉门关。\n黄沙百战穿金甲，不破楼兰终不还。",
          "lines": ["青海长云暗雪山", "孤城遥望玉门关", "黄沙百战穿金甲", "不破楼兰终不还"],
          "keywords": ["青海", "雪山", "孤城", "黄沙", "楼兰"],
          "themes": ["边塞", "报国", "战争"],
          "style": "豪放",
          "imagery": "边塞"
        },
        {
          "id": "p16",
          "title": "塞下曲",
          "author": "卢纶",
          "content": "月黑雁飞高，单于夜遁逃。\n欲将轻骑逐，大雪满弓刀。",
          "lines": ["月黑雁飞高", "单于夜遁逃", "欲将轻骑逐", "大雪满弓刀"],
          "keywords": ["月黑", "雁飞", "单于", "轻骑", "弓刀", "大雪"],
          "themes": ["边塞", "夜战", "豪情"],
          "style": "豪放",
          "imagery": "边塞"
        }
      ]
    },
    {
      "id": "homesick",
      "name": "思乡组",
      "imagery": "思乡",
      "poems": [
        {
          "id": "p17",
          "title": "回乡偶书",
          "author": "贺知章",
          "content": "少小离家老大回，乡音无改鬓毛衰。\n儿童相见不相识，笑问客从何处来。",
          "lines": ["少小离家老大回", "乡音无改鬓毛衰", "儿童相见不相识", "笑问客从何处来"],
          "keywords": ["离家", "乡音", "归乡", "儿童", "鬓毛"],
          "themes": ["思乡", "回乡", "世事"],
          "style": "朴实",
          "imagery": "思乡"
        },
        {
          "id": "p18",
          "title": "九月九日忆山东兄弟",
          "author": "王维",
          "content": "独在异乡为异客，每逢佳节倍思亲。\n遥知兄弟登高处，遍插茱萸少一人。",
          "lines": ["独在异乡为异客", "每逢佳节倍思亲", "遥知兄弟登高处", "遍插茱萸少一人"],
          "keywords": ["异乡", "佳节", "思亲", "兄弟", "茱萸", "登高"],
          "themes": ["思乡", "亲情", "重阳"],
          "style": "婉约",
          "imagery": "思乡"
        },
        {
          "id": "p19",
          "title": "宿建德江",
          "author": "孟浩然",
          "content": "移舟泊烟渚，日暮客愁新。\n野旷天低树，江清月近人。",
          "lines": ["移舟泊烟渚", "日暮客愁新", "野旷天低树", "江清月近人"],
          "keywords": ["烟渚", "日暮", "客愁", "野旷", "江清", "月近"],
          "themes": ["羁旅", "思乡", "江景"],
          "style": "婉约",
          "imagery": "思乡"
        }
      ]
    },
    {
      "id": "objects",
      "name": "咏物组",
      "imagery": "咏物",
      "poems": [
        {
          "id": "p20",
          "title": "咏柳",
          "author": "贺知章",
          "content": "碧玉妆成一树高，万条垂下绿丝绦。\n不知细叶谁裁出，二月春风似剪刀。",
          "lines": ["碧玉妆成一树高", "万条垂下绿丝绦", "不知细叶谁裁出", "二月春风似剪刀"],
          "keywords": ["碧玉", "柳树", "丝绦", "细叶", "春风"],
          "themes": ["咏物", "春景", "生机"],
          "style": "婉约",
          "imagery": "咏物"
        },
        {
          "id": "p21",
          "title": "蜂",
          "author": "罗隐",
          "content": "不论平地与山尖，无限风光尽被占。\n采得百花成蜜后，为谁辛苦为谁甜。",
          "lines": ["不论平地与山尖", "无限风光尽被占", "采得百花成蜜后", "为谁辛苦为谁甜"],
          "keywords": ["平地", "山尖", "百花", "成蜜", "辛苦", "蜂"],
          "themes": ["咏物", "讽喻", "劳动"],
          "style": "朴实",
          "imagery": "咏物"
        },
        {
          "id": "p22",
          "title": "墨梅",
          "author": "王冕",
          "content": "吾家洗砚池头树，朵朵花开淡墨痕。\n不要人夸好颜色，只留清气满乾坤。",
          "lines": ["吾家洗砚池头树", "朵朵花开淡墨痕", "不要人夸好颜色", "只留清气满乾坤"],
          "keywords": ["洗砚池", "墨痕", "颜色", "清气", "乾坤", "梅花"],
          "themes": ["咏物", "品格", "自守"],
          "style": "哲理",
          "imagery": "咏物"
        },
        {
          "id": "p23",
          "title": "石灰吟",
          "author": "于谦",
          "content": "千锤万凿出深山，烈火焚烧若等闲。\n粉骨碎身浑不怕，要留清白在人间。",
          "lines": ["千锤万凿出深山", "烈火焚烧若等闲", "粉骨碎身浑不怕", "要留清白在人间"],
          "keywords": ["千锤万凿", "烈火", "粉骨碎身", "清白", "人间", "石灰"],
          "themes": ["咏物", "气节", "品格"],
          "style": "豪放",
          "imagery": "咏物"
        }
      ]
    },
    {
      "id": "philosophy",
      "name": "哲理民生组",
      "imagery": "民生",
      "poems": [
        {
          "id": "p24",
          "title": "题西林壁",
          "author": "苏轼",
          "content": "横看成岭侧成峰，远近高低各不同。\n不识庐山真面目，只缘身在此山中。",
          "lines": ["横看成岭侧成峰", "远近高低各不同", "不识庐山真面目", "只缘身在此山中"],
          "keywords": ["庐山", "峰岭", "远近", "真面目", "此山"],
          "themes": ["哲理", "观察", "山水"],
          "style": "哲理",
          "imagery": "山水"
        },
        {
          "id": "p25",
          "title": "游子吟",
          "author": "孟郊",
          "content": "慈母手中线，游子身上衣。\n临行密密缝，意恐迟迟归。\n谁言寸草心，报得三春晖。",
          "lines": ["慈母手中线", "游子身上衣", "临行密密缝", "意恐迟迟归", "谁言寸草心", "报得三春晖"],
          "keywords": ["慈母", "手中线", "身上衣", "临行", "寸草心", "春晖"],
          "themes": ["亲情", "母爱", "感恩"],
          "style": "朴实",
          "imagery": "民生"
        },
        {
          "id": "p26",
          "title": "悯农",
          "author": "李绅",
          "content": "锄禾日当午，汗滴禾下土。\n谁知盘中餐，粒粒皆辛苦。",
          "lines": ["锄禾日当午", "汗滴禾下土", "谁知盘中餐", "粒粒皆辛苦"],
          "keywords": ["锄禾", "日当午", "汗滴", "盘中餐", "辛苦", "农人"],
          "themes": ["民生", "劳动", "珍惜粮食"],
          "style": "朴实",
          "imagery": "民生"
        },
        {
          "id": "p27",
          "title": "登高",
          "author": "杜甫",
          "content": "风急天高猿啸哀，渚清沙白鸟飞回。\n无边落木萧萧下，不尽长江滚滚来。\n万里悲秋常作客，百年多病独登台。\n艰难苦恨繁霜鬓，潦倒新停浊酒杯。",
          "lines": ["风急天高猿啸哀", "渚清沙白鸟飞回", "无边落木萧萧下", "不尽长江滚滚来", "万里悲秋常作客", "百年多病独登台", "艰难苦恨繁霜鬓", "潦倒新停浊酒杯"],
          "keywords": ["悲秋", "长江", "作客", "登台", "艰难", "霜鬓"],
          "themes": ["忧国", "身世", "秋愁"],
          "style": "沉郁",
          "imagery": "民生"
        }
      ]
    },
    {
      "id": "history",
      "name": "历史组",
      "imagery": "历史",
      "poems": [
        {
          "id": "p28",
          "title": "赤壁",
          "author": "杜牧",
          "content": "折戟沉沙铁未销，自将磨洗认前朝。\n东风不与周郎便，铜雀春深锁二乔。",
          "lines": ["折戟沉沙铁未销", "自将磨洗认前朝", "东风不与周郎便", "铜雀春深锁二乔"],
          "keywords": ["折戟", "沉沙", "前朝", "东风", "周郎", "铜雀"],
          "themes": ["历史", "怀古", "兴亡"],
          "style": "哲理",
          "imagery": "历史"
        },
        {
          "id": "p29",
          "title": "春望",
          "author": "杜甫",
          "content": "国破山河在，城春草木深。\n感时花溅泪，恨别鸟惊心。\n烽火连三月，家书抵万金。\n白头搔更短，浑欲不胜簪。",
          "lines": ["国破山河在", "城春草木深", "感时花溅泪", "恨别鸟惊心", "烽火连三月", "家书抵万金", "白头搔更短", "浑欲不胜簪"],
          "keywords": ["国破", "草木深", "花泪", "烽火", "家书", "白头"],
          "themes": ["忧国", "离乱", "思家"],
          "style": "沉郁",
          "imagery": "历史"
        },
        {
          "id": "p30",
          "title": "过零丁洋",
