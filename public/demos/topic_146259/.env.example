# OpenAI API Key（用于 GraphRAG 与 OpenAI Embedding）
# 未配置时，自动推荐将降级为本地 ChromaDB 向量相似度
OPENAI_API_KEY=

# OCR 后端选择：easyocr（本地，默认） / mineru（MinerU 官方 API）
OCR_BACKEND=mineru

# MinerU 官方 API 认证
# 方式 1：直接填写 API Token（推荐）
MINERU_TOKEN=
# 方式 2：若官网只提供了 Access Key / Secret Key，则填写以下两项
# 系统会优先使用 MINERU_TOKEN；未设置 TOKEN 时，将尝试用 MINERU_ACCESS_KEY 作为 TOKEN
MINERU_ACCESS_KEY=
MINERU_SECRET_KEY=
# MinerU API 基础地址，一般无需修改
MINERU_BASE_URL=https://mineru.net
