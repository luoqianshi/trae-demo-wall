{
  "format": "animation-preset-v1",
  "id": "exit",
  "name": "出场动画",
  "description": "出场动画预设",
  "author": "字漫画内置",
  "version": "1.0.0",
  "category": "out",
  "categoryName": "出场动画",
  "icon": "↑",
  "animations": [
    {
      "name": "淡出",
      "value": "fadeOut",
      "description": "出场动画 - 淡出",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)",
        "100%": "opacity:0;transform:translate(0,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "左移出",
      "value": "slideLeftOut",
      "description": "出场动画 - 左移出",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)",
        "100%": "opacity:0;transform:translate(-100px,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "右移出",
      "value": "slideRightOut",
      "description": "出场动画 - 右移出",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)",
        "100%": "opacity:0;transform:translate(100px,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "上移出",
      "value": "slideUpOut",
      "description": "出场动画 - 上移出",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)",
        "100%": "opacity:0;transform:translate(0,-100px) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "下移出",
      "value": "slideDownOut",
      "description": "出场动画 - 下移出",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)",
        "100%": "opacity:0;transform:translate(0,100px) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "缩放",
      "value": "scaleOut",
      "description": "出场动画 - 缩放",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:scale(1)",
        "100%": "opacity:0;transform:scale(0)"
      }
    },
    {
      "name": "旋转",
      "value": "rotateOut",
      "description": "出场动画 - 旋转",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:rotate(0deg) scale(1)",
        "100%": "opacity:0;transform:rotate(180deg) scale(0)"
      }
    },
    {
      "name": "弹跳",
      "value": "bounceOut",
      "description": "出场动画 - 弹跳",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:1;transform:scale(1)",
        "30%": "transform:scale(1.2)",
        "50%": "opacity:0.5;transform:scale(0.9)",
        "100%": "opacity:0;transform:scale(0)"
      }
    }
  ]
}