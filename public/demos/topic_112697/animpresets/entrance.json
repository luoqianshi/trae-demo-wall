{
  "format": "animation-preset-v1",
  "id": "entrance",
  "name": "入场动画",
  "description": "入场动画预设",
  "author": "字漫画内置",
  "version": "1.0.0",
  "category": "in",
  "categoryName": "入场动画",
  "icon": "↓",
  "animations": [
    {
      "name": "淡入",
      "value": "fadeIn",
      "description": "入场动画 - 淡入",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:translate(0,0) scale(1) rotate(0deg)",
        "100%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "左移入",
      "value": "slideLeft",
      "description": "入场动画 - 左移入",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:translate(-100px,0) scale(1) rotate(0deg)",
        "100%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "右移入",
      "value": "slideRight",
      "description": "入场动画 - 右移入",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:translate(100px,0) scale(1) rotate(0deg)",
        "100%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "上移入",
      "value": "slideUp",
      "description": "入场动画 - 上移入",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:translate(0,100px) scale(1) rotate(0deg)",
        "100%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "下移入",
      "value": "slideDown",
      "description": "入场动画 - 下移入",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:translate(0,-100px) scale(1) rotate(0deg)",
        "100%": "opacity:1;transform:translate(0,0) scale(1) rotate(0deg)"
      }
    },
    {
      "name": "缩放",
      "value": "scaleIn",
      "description": "入场动画 - 缩放",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:scale(0)",
        "100%": "opacity:1;transform:scale(1)"
      }
    },
    {
      "name": "旋转",
      "value": "rotateIn",
      "description": "入场动画 - 旋转",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:rotate(-180deg) scale(0)",
        "100%": "opacity:1;transform:rotate(0deg) scale(1)"
      }
    },
    {
      "name": "弹跳",
      "value": "bounceIn",
      "description": "入场动画 - 弹跳",
      "defaultDuration": "1s",
      "timingFunction": "ease-out",
      "iterationCount": "infinite",
      "fillMode": "forwards",
      "transformOrigin": "center center",
      "keyframes": {
        "0%": "opacity:0;transform:scale(0)",
        "50%": "transform:scale(1.2)",
        "70%": "transform:scale(0.9)",
        "100%": "opacity:1;transform:scale(1)"
      }
    }
  ]
}