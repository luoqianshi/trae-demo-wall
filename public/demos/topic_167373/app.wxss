/* app.wxss - 全局样式 */

page {
  background-color: #f8f9fa;
  color: #202124;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
  min-height: 100vh;
}

/* ==================== 颜色变量（CSS 自定义属性） ==================== */
page {
  --color-primary: #4285F4;
  --color-primary-dark: #1a73e8;
  --color-primary-light: #e8f0fe;
  --color-secondary: #34A853;
  --color-warning: #FBBC04;
  --color-error: #EA4335;
  --color-text-primary: #202124;
  --color-text-secondary: #5f6368;
  --color-text-hint: #80868b;
  --color-text-disabled: #bdc1c6;
  --color-divider: #e8eaed;
  --color-background: #f8f9fa;
  --color-surface: #ffffff;
}

/* ==================== 通用类 ==================== */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.title-large {
  font-size: 36rpx;
  font-weight: 600;
  color: #202124;
}

.title-medium {
  font-size: 32rpx;
  font-weight: 600;
  color: #202124;
}

.title-small {
  font-size: 28rpx;
  font-weight: 500;
  color: #202124;
}

.text-secondary {
  color: #5f6368;
}

.text-hint {
  color: #80868b;
  font-size: 24rpx;
}

.text-disabled {
  color: #bdc1c6;
}

.text-primary {
  color: #4285F4;
}

.text-error {
  color: #EA4335;
}

.text-success {
  color: #34A853;
}

.text-warning {
  color: #FBBC04;
}

/* ==================== 按钮样式 ==================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  outline: none;
  cursor: pointer;
  transition: opacity 0.2s;
}

.btn-primary {
  background-color: #4285F4;
  color: #ffffff;
}

.btn-primary:active {
  background-color: #1a73e8;
}

.btn-secondary {
  background-color: #ffffff;
  color: #4285F4;
  border: 2rpx solid #4285F4;
}

.btn-text {
  background-color: transparent;
  color: #4285F4;
}

.btn-block {
  display: block;
  width: 100%;
}

.btn:disabled {
  opacity: 0.5;
}

/* ==================== Flex 工具 ==================== */
.flex {
  display: flex;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* ==================== 间距工具 ==================== */
.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-24 { margin-top: 48rpx; }
.mt-32 { margin-top: 64rpx; }

.mb-8 { margin-bottom: 16rpx; }
.mb-16 { margin-bottom: 32rpx; }
.mb-24 { margin-bottom: 48rpx; }
.mb-32 { margin-bottom: 64rpx; }

.p-16 { padding: 32rpx; }
.p-24 { padding: 48rpx; }

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-state-title {
  font-size: 32rpx;
  color: #5f6368;
  margin-bottom: 16rpx;
}

.empty-state-desc {
  font-size: 26rpx;
  color: #80868b;
  line-height: 1.6;
}
