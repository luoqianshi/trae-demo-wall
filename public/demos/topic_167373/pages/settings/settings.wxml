<view class="container">
  <!-- 用户档案 -->
  <view class="card">
    <view class="section-title">用户档案</view>
    <view wx:if="{{userProfile}}" class="profile-info" bindtap="onEditProfile">
      <view class="info-row">
        <text class="info-label">性别</text>
        <text class="info-value">{{userProfile.gender === 'male' ? '男' : userProfile.gender === 'female' ? '女' : '不愿透露'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">年龄</text>
        <text class="info-value">{{userProfile.ageRange}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">便秘程度</text>
        <text class="info-value">{{userProfile.concernLevel === 'none' ? '无' : userProfile.concernLevel === 'mild' ? '轻度' : userProfile.concernLevel === 'moderate' ? '中度' : '重度'}}</text>
      </view>
    </view>
    <view wx:else class="empty-mini" bindtap="onEditProfile">点击设置档案 ›</view>
  </view>

  <!-- 提醒设置 -->
  <view class="card">
    <!-- V0.2.0 波波角色开关 -->
    <view class="setting-row">
      <view class="setting-label">🐻 启用波波角色</view>
      <view class="setting-value">
        <switch checked="{{boboEnabled}}" bindchange="onBoboToggle" color="#FF9800"/>
      </view>
    </view>
    <view class="setting-row" bindtap="onReminderSettings">
      <view class="setting-label">每日提醒</view>
      <view class="setting-value">
        <text class="setting-text">{{reminderEnabled ? reminderTime : '未开启'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="card">
    <view class="section-title">数据管理</view>
    <view class="setting-row" bindtap="onExportData">
      <view class="setting-label">导出数据</view>
      <view class="setting-value">
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="setting-row" bindtap="onClearData">
      <view class="setting-label setting-label-danger">清除所有数据</view>
      <view class="setting-value">
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="setting-row" bindtap="onShowDisclaimer">
      <view class="setting-label">医疗免责声明</view>
      <view class="setting-value"><text class="arrow">›</text></view>
    </view>
    <view class="setting-row" bindtap="onShowPrivacy">
      <view class="setting-label">隐私政策</view>
      <view class="setting-value"><text class="arrow">›</text></view>
    </view>
    <view class="setting-row">
      <view class="setting-label">版本</view>
      <view class="setting-value"><text class="setting-text">v{{appVersion}}</text></view>
    </view>
  </view>
</view>
