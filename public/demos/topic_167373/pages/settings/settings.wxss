.container {
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 24rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #5f6368;
}

.info-value {
  font-size: 28rpx;
  color: #202124;
}

.empty-mini {
  text-align: center;
  padding: 32rpx 0;
  color: #4285F4;
  font-size: 28rpx;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-row:active {
  background-color: #f8f9fa;
}

.setting-label {
  font-size: 30rpx;
  color: #202124;
}

.setting-label-danger {
  color: #EA4335;
}

.setting-value {
  display: flex;
  align-items: center;
}

.setting-text {
  font-size: 28rpx;
  color: #5f6368;
  margin-right: 16rpx;
}

.arrow {
  font-size: 32rpx;
  color: #bdc1c6;
}
