.container {
  padding: 24rpx;
}

.analysis-card {
  padding: 32rpx 24rpx;
  color: #ffffff;
  text-align: center;
}

.analysis-status {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.analysis-advice {
  font-size: 28rpx;
  line-height: 1.5;
  opacity: 0.95;
}

.stat-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #202124;
}

.stat-label {
  font-size: 24rpx;
  color: #5f6368;
  margin-top: 8rpx;
}

.stat-hint {
  font-size: 20rpx;
  color: #FBBC04;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background-color: #e8eaed;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 24rpx;
}

.dist-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dist-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dist-label {
  font-size: 24rpx;
  color: #5f6368;
  width: 96rpx;
}

.dist-bar-container {
  flex: 1;
  height: 24rpx;
  background-color: #f1f3f4;
  border-radius: 12rpx;
  overflow: hidden;
}

.dist-bar {
  height: 100%;
  border-radius: 12rpx;
  min-width: 4rpx;
  transition: width 0.3s;
}

.dist-count {
  font-size: 24rpx;
  color: #202124;
  font-weight: 500;
  width: 48rpx;
  text-align: right;
}

.recent-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8eaed;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-item:active {
  background-color: #f8f9fa;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.recent-date {
  font-size: 26rpx;
  color: #5f6368;
}

.recent-status {
  font-size: 26rpx;
  font-weight: 500;
}

.recent-content {
  font-size: 28rpx;
  color: #202124;
}

.recent-note {
  font-size: 24rpx;
  color: #5f6368;
  margin-top: 8rpx;
  font-style: italic;
}

.empty-mini {
  text-align: center;
  padding: 48rpx 0;
  color: #80868b;
  font-size: 26rpx;
}

/* ===== V0.2.0 身体感受趋势 ===== */
.feel-summary {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}
.feel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}
.feel-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}
.feel-num-label {
  font-size: 22rpx;
  color: #80868b;
}

.feel-trend {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.trend-title {
  font-size: 24rpx;
  color: #5f6368;
  margin-bottom: 12rpx;
}
.trend-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 140rpx;
  padding: 0 4rpx;
}
.trend-bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}
.trend-bar {
  width: 18rpx;
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  margin-bottom: 6rpx;
}
.trend-bar.lv-0 { background: #C8E6C9; height: 8rpx; }
.trend-bar.lv-1 { background: #FFF59D; height: 36rpx; }
.trend-bar.lv-2 { background: #FFB74D; height: 72rpx; }
.trend-bar.lv-3 { background: #E57373; height: 110rpx; }
.trend-date {
  font-size: 20rpx;
  color: #80868b;
}

/* 最近记录（V0.2.0 新结构） */
.record-list {
  margin-top: 8rpx;
}
.record-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.record-item:last-child { border-bottom: none; }
.record-item:active { background-color: #f8f9fa; }
.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.record-type {
  font-size: 30rpx;
  font-weight: 600;
}
.record-time {
  font-size: 22rpx;
  color: #80868b;
}
.record-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #5f6368;
}
.record-color-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  display: inline-block;
}
.record-color-name {
  font-size: 24rpx;
  color: #5f6368;
}
.record-pain {
  font-size: 22rpx;
  color: #E65100;
  background: #FFF3E0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 6rpx;
}
.empty-tip {
  text-align: center;
  padding: 48rpx 0;
  color: #80868b;
  font-size: 26rpx;
}
