<view class="container">
  <!-- 健康分析卡片 -->
  <view wx:if="{{healthAnalysis}}" class="card analysis-card" style="background-color: {{healthAnalysis.color}};">
    <view class="analysis-status">{{healthAnalysis.status}}</view>
    <view class="analysis-advice">{{healthAnalysis.advice}}</view>
  </view>

  <!-- 关键指标 -->
  <view class="card">
    <view class="stat-row">
      <view class="stat-item">
        <view class="stat-value">{{totalRecords}}</view>
        <view class="stat-label">总记录数</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{weekFrequency}}</view>
        <view class="stat-label">本周次数</view>
        <view wx:if="{{weekFrequency === totalRecords && totalRecords > 0}}" class="stat-hint">含全部数据</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{avgBristol}}</view>
        <view class="stat-label">平均类型</view>
      </view>
    </view>
  </view>

  <!-- Bristol 分布 -->
  <view class="card">
    <view class="section-title">Bristol 类型分布</view>
    <view class="dist-list">
      <view wx:for="{{bristolDistribution}}" wx:key="type" class="dist-row">
        <view class="dist-label">类型 {{item.type}}</view>
        <view class="dist-bar-container">
          <view class="dist-bar" style="width: {{item.count > 0 ? (item.count * 100 / totalRecords) : 0}}%; background-color: {{item.color}};"></view>
        </view>
        <view class="dist-count">{{item.count}}</view>
      </view>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="card">
    <view class="card-title">最近记录</view>
    <view wx:if="{{recentRecords.length === 0}}" class="empty-tip">暂无最近记录</view>
    <view wx:else class="record-list">
      <view wx:for="{{recentRecords}}" wx:key="id" class="record-item" data-id="{{item.id}}" bindtap="onRecordTap">
        <view class="record-main">
          <view class="record-type" style="color: {{item.bristolColor}};">{{item.typeName}}</view>
          <view class="record-time">{{item.timeText}}</view>
        </view>
        <view class="record-sub">
          <text class="record-color-dot" style="background: {{item.colorHex}}"></text>
          <text class="record-color-name">{{item.colorName}}</text>
          <text wx:if="{{item.painLevel > 0}}" class="record-pain">疼痛 {{item.painLevel}}/3</text>
        </view>
      </view>
    </view>
  </view>

  <!-- V0.2.0 身体感受趋势 -->
  <view class="card" wx:if="{{hasEnoughData}}">
    <view class="card-title">身体感受趋势</view>
    <view class="feel-summary">
      <view class="feel-item">
        <view class="feel-num" style="color:{{avgPainColor}};">{{avgPainLevelText}}</view>
        <view class="feel-num-label">平均疼痛</view>
      </view>
      <view class="feel-item">
        <view class="feel-num" style="color:{{swellingRateColor}};">{{swellingRateText}}</view>
        <view class="feel-num-label">腹胀率</view>
      </view>
      <view class="feel-item">
        <view class="feel-num" style="color:{{residueRateColor}};">{{residueRateText}}</view>
        <view class="feel-num-label">残留率</view>
      </view>
      <view class="feel-item">
        <view class="feel-num" style="color:{{unfinishedRateColor}};">{{unfinishedRateText}}</view>
        <view class="feel-num-label">排不尽率</view>
      </view>
    </view>
    <view class="feel-trend" wx:if="{{painTrendBars.length > 0}}">
      <view class="trend-title">近 7 天疼痛强度</view>
      <view class="trend-bars">
        <view wx:for="{{painTrendBars}}" wx:key="date" class="trend-bar-col">
          <view class="trend-bar {{item.levelClass}}"></view>
          <view class="trend-date">{{item.dateLabel}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
