<view class="container">
  <view class="header">
    <view class="title">设置您的档案</view>
    <view class="subtitle">帮助我们提供更精准的健康建议</view>
  </view>

  <!-- 性别 -->
  <view class="card">
    <view class="section-title">性别</view>
    <view class="option-row">
      <view
        wx:for="{{genders}}"
        wx:key="value"
        class="option-item {{gender === item.value ? 'selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="onGenderSelect"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 年龄段 -->
  <view class="card">
    <view class="section-title">年龄段</view>
    <view class="option-row">
      <view
        wx:for="{{ageRanges}}"
        wx:key="value"
        class="option-item {{ageRange === item.value ? 'selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="onAgeSelect"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 便秘困扰程度 -->
  <view class="card">
    <view class="section-title">便秘困扰程度</view>
    <view class="option-row">
      <view
        wx:for="{{concernLevels}}"
        wx:key="value"
        class="option-item {{concernLevel === item.value ? 'selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="onConcernSelect"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn btn-primary btn-block" bindtap="onComplete">完成</button>
  </view>
</view>
