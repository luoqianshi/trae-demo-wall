.container {
  min-height: 100vh;
  padding: 32rpx 32rpx 200rpx 32rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 32rpx 0;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #202124;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #5f6368;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 24rpx;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  flex: 1;
  min-width: 30%;
  padding: 20rpx 0;
  background-color: #f8f9fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5f6368;
}

.option-item.selected {
  background-color: #e8f0fe;
  border-color: #4285F4;
  color: #1a73e8;
  font-weight: 500;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e8eaed;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn {
  font-size: 30rpx;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background-color: #4285F4;
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.btn-primary::after {
  border: none;
}
