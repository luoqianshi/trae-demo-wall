<view class="container">
  <view class="card">
    <view class="setting-row">
      <view class="setting-label">启用提醒</view>
      <switch checked="{{reminderEnabled}}" bindchange="onToggleEnabled" color="#4285F4" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">提醒时间</view>
    <picker mode="time" value="{{reminderTime}}" bindchange="onTimeChange" class="time-picker">
      <view class="time-display">{{reminderTime}}</view>
    </picker>
  </view>

  <view class="card">
    <view class="section-title">重复日期</view>
    <view class="day-row">
      <view
        wx:for="{{repeatDays}}"
        wx:key="calendarDay"
        class="day-item {{item.value ? 'day-active' : ''}}"
        data-index="{{index}}"
        bindtap="onDayToggle"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn btn-primary btn-block" bindtap="onSave">保存设置</button>
  </view>
</view>
