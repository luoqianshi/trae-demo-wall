.container {
  padding: 24rpx 24rpx 200rpx 24rpx;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-label {
  font-size: 30rpx;
  color: #202124;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 24rpx;
}

.time-picker {
  display: block;
  text-align: center;
  padding: 32rpx 0;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.time-display {
  font-size: 56rpx;
  font-weight: 600;
  color: #4285F4;
}

.day-row {
  display: flex;
  gap: 16rpx;
}

.day-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #5f6368;
}

.day-item.day-active {
  background-color: #4285F4;
  color: #ffffff;
  font-weight: 500;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e8eaed;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn {
  font-size: 30rpx;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background-color: #4285F4;
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.btn-primary::after {
  border: none;
}
