.container {
  padding: 24rpx 24rpx 240rpx 24rpx;
}

.stat-card {
  background: linear-gradient(135deg, #4285F4 0%, #1a73e8 100%);
  color: #ffffff;
  text-align: center;
  padding: 32rpx;
}

.stat-title {
  font-size: 26rpx;
  opacity: 0.9;
}

.stat-content {
  margin: 16rpx 0;
}

.stat-number {
  font-size: 72rpx;
  font-weight: 700;
}

.stat-unit {
  font-size: 28rpx;
  margin-left: 8rpx;
  opacity: 0.9;
}

.stat-subtitle {
  font-size: 24rpx;
  opacity: 0.85;
}

.calendar-card {
  padding: 24rpx;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 24rpx 16rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #5f6368;
  border-radius: 32rpx;
}

.nav-btn:active {
  background-color: #f1f3f4;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #202124;
}

.week-header {
  display: flex;
  border-bottom: 1rpx solid #e8eaed;
  padding-bottom: 16rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #80868b;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 16rpx;
}

.day-cell {
  width: 14.28%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-cell:active {
  background-color: #f1f3f4;
  border-radius: 8rpx;
}

.day-other {
  opacity: 0.3;
}

.day-today {
  position: relative;
}

.day-number {
  font-size: 28rpx;
  color: #202124;
}

.day-number-today {
  color: #ffffff;
  background-color: #4285F4;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin-top: 6rpx;
}

.day-count {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: #5f6368;
  background-color: #e8f0fe;
  border-radius: 16rpx;
  padding: 0 8rpx;
  min-width: 24rpx;
  text-align: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 24rpx;
}

.empty-mini {
  text-align: center;
  padding: 48rpx 0;
  color: #80868b;
  font-size: 26rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8eaed;
}

.record-item:last-child {
  border-bottom: none;
}

.record-time {
  font-size: 32rpx;
  font-weight: 500;
  color: #202124;
  width: 120rpx;
}

.record-info {
  flex: 1;
  padding: 0 16rpx;
}

.record-bristol {
  font-size: 28rpx;
  color: #202124;
}

.record-color {
  font-size: 24rpx;
  color: #5f6368;
  margin-top: 4rpx;
}

.record-arrow {
  font-size: 32rpx;
  color: #bdc1c6;
}

/* FAB 修复 PT-mp-dev-005：放在 tabBar 上方居中，不挡日历 */
.fab-dock {
  position: fixed;
  left: 0;
  right: 0;
  /* tabBar 默认约 100rpx，dock 在 tabBar 上方 12rpx */
  bottom: 124rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
  z-index: 99;
}

/* fab 相对定位容器，承载气泡与 fab 本体 */
.fab-wrapper {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.fab {
  pointer-events: auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: #4285F4;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(66, 133, 244, 0.4);
}

.fab-icon {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

/* FAB 气泡提示（首次用户）
   修复 PT-mp-welcome-004：气泡水平居中对齐 fab 中心（fab 已改至屏幕水平中间） */
.fab-hint {
  position: absolute;
  /* 气泡水平居中：左 50% 再 -50% 自身宽度 */
  left: 50%;
  transform: translateX(-50%);
  /* 气泡位于 fab 正上方 */
  bottom: 110rpx;
  background-color: #4285F4;
  color: #ffffff;
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  white-space: nowrap;
  box-shadow: 0 4rpx 16rpx rgba(66, 133, 244, 0.4);
  pointer-events: auto;
  z-index: 1;
}

.fab-hint-text {
  color: #ffffff;
  line-height: 1.4;
}

/* 气泡下方小三角，对齐 fab 中心 */
.fab-hint-arrow {
  position: absolute;
  bottom: -10rpx;
  /* 让箭头水平居中（fab 中心 = fab-hint 中心） */
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #4285F4;
}

/* ===== V0.2.0-fix 波波立绘（Lottie + 可拖动） ===== */
.bobo-draggable {
  position: fixed;
  z-index: 90;
  /* 重要：left/top 由内联 style 设置，初始值由 boboStyle 提供 */
  /* 大小由内联 style 设置 = 192rpx = 2 * 96rpx FAB */
  pointer-events: auto;
  transition: transform 0.15s ease-out, box-shadow 0.2s;
  will-change: left, top, transform;
}
.bobo-draggable.is-dragging {
  /* 拖动中：放大 + 阴影 + 不响应 transition */
  transform: scale(1.12);
  transition: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  opacity: 0.92;
}
.bobo-draggable:not(.is-dragging):active {
  transform: scale(1.04);
}
.bobo-image {
  width: 100%;
  height: 100%;
  display: block;
  background: transparent;
}
/* 呼吸摆动动画（仅非拖动时） */
.bobo-draggable.is-bobbing {
  animation: bobo-bob 2.4s ease-in-out infinite;
  transform-origin: 50% 90%;
}
.bobo-draggable.is-bobbing.is-dragging {
  animation: none;
}
@keyframes bobo-bob {
  0%, 100% { transform: rotate(-2deg) scale(1); }
  50% { transform: rotate(2deg) scale(1.03); }
}
.bobo-drag-hint {
  position: absolute;
  left: 50%;
  bottom: -52rpx;
  transform: translateX(-50%);
  background: rgba(66, 133, 244, 0.92);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(66, 133, 244, 0.4);
  pointer-events: none;
}
