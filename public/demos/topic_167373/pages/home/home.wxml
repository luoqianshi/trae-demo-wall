<view class="container">
  <!-- 顶部统计卡片 -->
  <view class="card stat-card">
    <view class="stat-title">本月记录</view>
    <view class="stat-content">
      <text class="stat-number">{{monthRecordCount}}</text>
      <text class="stat-unit">次</text>
    </view>
    <view class="stat-subtitle">{{currentMonthLabel}}</view>
  </view>

  <!-- 日历 -->
  <view class="card calendar-card">
    <view class="calendar-header">
      <view class="nav-btn" bindtap="prevMonth">‹</view>
      <view class="calendar-title">{{currentMonthLabel}}</view>
      <view class="nav-btn" bindtap="nextMonth">›</view>
    </view>

    <view class="week-header">
      <view class="week-day" wx:for="{{weekHeaders}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="calendar-grid">
      <view
        wx:for="{{calendarDays}}"
        wx:key="key"
        class="day-cell {{!item.isCurrentMonth ? 'day-other' : ''}} {{item.isToday ? 'day-today' : ''}}"
        data-year="{{item.year}}"
        data-month="{{item.month}}"
        data-day="{{item.day}}"
        data-hasrecord="{{item.hasRecord}}"
        bindtap="onDayTap"
      >
        <view class="day-number {{item.isToday ? 'day-number-today' : ''}}">{{item.day}}</view>
        <view wx:if="{{item.hasRecord}}" class="day-dot" style="background-color: {{bristolColors[index % 7]}}"></view>
        <view wx:if="{{item.recordCount > 1}}" class="day-count">{{item.recordCount}}</view>
      </view>
    </view>
  </view>

  <!-- 当日记录列表 -->
  <view wx:if="{{selectedDay}}" class="card">
    <view class="section-title">
      {{selectedDay.month + 1}} 月 {{selectedDay.day}} 日记录
    </view>
    <view wx:if="{{selectedDayRecords.length === 0}}" class="empty-mini">
      当日无记录
    </view>
    <view
      wx:for="{{selectedDayRecords}}"
      wx:key="id"
      class="record-item"
      data-id="{{item.id}}"
      bindtap="onRecordItemTap"
    >
      <view class="record-time">{{item.timeStr}}</view>
      <view class="record-info">
        <view class="record-bristol">{{item.bristolName}}</view>
        <view class="record-color">{{item.colorName}}</view>
      </view>
      <view class="record-arrow">›</view>
    </view>
  </view>

  <!-- 浮动添加按钮（修复 PT-mp-006：固定大小 96rpx，位置动态居中于空白段中央） -->
  <view class="fab-dock" style="bottom: {{fabBottomRpx}}rpx;">
    <view class="fab-wrapper">
      <view wx:if="{{showFabHint}}" class="fab-hint" catchtap="onFabHintDismiss">
        <text class="fab-hint-text">点击这里记录你的第一次 ↓</text>
        <view class="fab-hint-arrow"></view>
      </view>
      <view class="fab" bindtap="onAddRecord">
        <text class="fab-icon">+</text>
      </view>
    </view>
  </view>

  <!-- V0.2.0-fix：波波立绘 - SVG 资源 + CSS 动画，2 倍 FAB 大小（192rpx），可长按拖动 -->
  <view
    wx:if="{{boboEnabled}}"
    class="bobo-draggable {{isDragging ? 'is-dragging' : ''}} {{boboExpressive ? 'is-bobbing' : ''}}"
    style="left: {{boboStyle.left}}; top: {{boboStyle.top}}; width: {{BOBO_SIZE_RPX}}rpx; height: {{BOBO_SIZE_RPX}}rpx;"
    bindtouchstart="onBoboTouchStart"
    bindtouchmove="onBoboTouchMove"
    bindtouchend="onBoboTouchEnd"
    bindlongpress="onBoboLongPress"
    bindtap="onBoboTap"
  >
    <image
      class="bobo-image"
      src="{{boboImageSrc}}"
      mode="aspectFit"
    ></image>
    <view wx:if="{{isDragging}}" class="bobo-drag-hint">松开放置到此处</view>
  </view>
</view>
