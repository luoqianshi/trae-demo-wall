<view class="container" wx:if="{{record}}">
  <view class="card">
    <view class="time-display">{{record.dateTimeText}}</view>
  </view>

  <view class="card type-card">
    <view class="bristol-display">
      <view class="bristol-info">
        <view class="bristol-name">{{bristolName}}</view>
        <view class="bristol-desc">{{bristolDesc}}</view>
      </view>
    </view>
    <view wx:if="{{healthStatus}}" class="health-tag" style="background-color: {{healthStatus.color}};">
      {{healthStatus.status}}
    </view>
  </view>

  <view class="card">
    <view class="info-row">
      <text class="info-label">颜色</text>
      <text class="info-value">{{colorName}}</text>
    </view>
    <view wx:if="{{record.note}}" class="note-section">
      <view class="info-label">备注</view>
      <view class="note-content">{{record.note}}</view>
    </view>
  </view>

  <!-- V0.2.0 身体感受 -->
  <view wx:if="{{hasFeelings}}" class="card">
    <view class="info-label">身体感受</view>
    <view class="feel-grid">
      <view class="feel-chip {{painLevel > 0 ? 'active' : ''}}">疼痛 {{painLevel}}/3</view>
      <view class="feel-chip {{swelling ? 'active' : ''}}">腹胀</view>
      <view class="feel-chip {{residue ? 'active' : ''}}">残留感</view>
      <view class="feel-chip {{unfinished ? 'active' : ''}}">排不尽</view>
    </view>
  </view>

  <!-- V0.2.0 波波点评 -->
  <view wx:if="{{boboComment}}" class="card bobo-section">
    <view class="info-label">波波点评</view>
    <view class="bobo-card">
      <view class="bobo-avatar-large">
        <text class="bobo-emoji-large">🐻</text>
      </view>
      <view class="bobo-content">
        <view class="bobo-comment">{{boboComment}}</view>
        <view class="bobo-meta">表情: {{boboExpression}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{healthStatus}}" class="card advice-card">
    <view class="advice-title">健康建议</view>
    <view class="advice-content">{{healthStatus.advice}}</view>
  </view>

  <view class="bottom-bar">
    <button class="btn btn-secondary" bindtap="onEdit">编辑</button>
    <button class="btn btn-danger" bindtap="onDelete">删除</button>
  </view>
</view>
