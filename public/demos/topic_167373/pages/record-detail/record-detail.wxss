.container {
  padding: 24rpx 24rpx 200rpx 24rpx;
}

.time-display {
  font-size: 32rpx;
  color: #5f6368;
  text-align: center;
}

.type-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.bristol-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
  width: 100%;
  text-align: center;
}

.bristol-info {
  flex: 1;
}

.bristol-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 8rpx;
  text-align: center;
}

.bristol-desc {
  font-size: 26rpx;
  color: #5f6368;
  line-height: 1.5;
  text-align: center;
}

.health-tag {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #5f6368;
}

.info-value {
  font-size: 28rpx;
  color: #202124;
  font-weight: 500;
}

.note-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8eaed;
}

.note-content {
  font-size: 28rpx;
  color: #202124;
  margin-top: 12rpx;
  line-height: 1.6;
}

.advice-card {
  background-color: #e8f0fe;
}

.advice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a73e8;
  margin-bottom: 16rpx;
}

.advice-content {
  font-size: 28rpx;
  color: #202124;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e8eaed;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-bar .btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-secondary {
  background-color: #ffffff;
  color: #4285F4;
  border: 2rpx solid #4285F4;
}

.btn-danger {
  background-color: #ffffff;
  color: #EA4335;
  border: 2rpx solid #EA4335;
}

/* ===== V0.2.0 身体感受 + 波波点评 ===== */
.feel-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.feel-chip {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: #f1f3f4;
  color: #80868b;
  font-size: 24rpx;
}
.feel-chip.active {
  background: #FFF3E0;
  color: #E65100;
  font-weight: 600;
}

.bobo-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFE0B2 100%);
  border-radius: 16rpx;
}
.bobo-avatar-large {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  flex-shrink: 0;
}
.bobo-emoji-large { font-size: 64rpx; line-height: 1; }
.bobo-content { flex: 1; min-width: 0; }
.bobo-comment {
  font-size: 28rpx;
  color: #5D4037;
  line-height: 1.6;
  font-weight: 500;
}
.bobo-meta {
  font-size: 22rpx;
  color: #8D6E63;
  margin-top: 6rpx;
  opacity: 0.6;
}
.bobo-section .info-label {
  margin-bottom: 12rpx;
}
