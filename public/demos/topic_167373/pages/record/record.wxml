<view class="container">
  <!-- V0.2.0 波波角色 -->
  <view class="bobo-bar" wx:if="{{boboComment}}">
    <view class="bobo-avatar">
      <text class="bobo-emoji">🐻</text>
    </view>
    <view class="bobo-bubble">
      <view class="bobo-bubble-text">{{boboComment}}</view>
      <view class="bobo-bubble-state">当前表情: {{boboExpression}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-label">时间</view>
    <picker mode="multiSelector" value="{{timePickerIndex}}" range="{{timePickerRange}}" bindchange="onTimeChange" bindcolumnchange="onTimeColumnChange">
      <view class="time-picker">
        <text class="time-icon">⏰</text>
        <text class="time-value">{{timeText}}</text>
        <text class="time-arrow">›</text>
      </view>
    </picker>
  </view>

  <view class="section">
    <view class="section-label">Bristol 粪便分类</view>
    <view class="bristol-grid">
      <view
        wx:for="{{bristolTypes}}"
        wx:key="type"
        class="bristol-item {{selectedBristol === item.type ? 'selected' : ''}}"
        data-type="{{item.type}}"
        bindtap="onBristolSelect"
      >
        <view class="bristol-shape" style="background: {{item.color}};">
          <text class="bristol-shape-icon">{{item.shapeIcon}}</text>
        </view>
        <view class="bristol-name">{{item.name}}</view>
        <view class="bristol-short">{{item.shortDesc}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-label">颜色</view>
    <view class="color-grid">
      <!-- 上排 3 个：棕色/黄色/绿色 -->
      <view class="color-row color-row-top">
        <view
          wx:for="{{colorsTop}}"
          wx:key="key"
          class="color-item {{selectedColor === item.key ? 'selected' : ''}}"
          data-color="{{item.key}}"
          bindtap="onColorSelect"
        >
          <view class="color-circle" style="background: {{item.value}};"></view>
          <view class="color-name">{{item.name}}</view>
        </view>
      </view>
      <!-- 下排 4 个：黑色/红色/灰色/灰白，相对上排交叉错开 -->
      <view class="color-row color-row-bottom">
        <view
          wx:for="{{colorsBottom}}"
          wx:key="key"
          class="color-item {{selectedColor === item.key ? 'selected' : ''}}"
          data-color="{{item.key}}"
          bindtap="onColorSelect"
        >
          <view class="color-circle" style="background: {{item.value}};"></view>
          <view class="color-name">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-label">身体感受（V0.2.0 新增）</view>

    <!-- 疼痛 0-3 段位选择 -->
    <view class="feel-row">
      <view class="feel-label">疼痛</view>
      <view class="pain-levels">
        <view
          wx:for="{{[0,1,2,3]}}"
          wx:key="*this"
          wx:for-item="lv"
          class="pain-level {{painLevel === lv ? 'selected' : ''}}"
          data-level="{{lv}}"
          bindtap="onPainLevelSelect"
        >
          <view class="pain-level-bar pain-lv-{{lv}}"></view>
          <view class="pain-level-text">
            <text wx:if="{{lv === 0}}">无痛</text>
            <text wx:elif="{{lv === 1}}">轻微</text>
            <text wx:elif="{{lv === 2}}">中等</text>
            <text wx:elif="{{lv === 3}}">严重</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 腹胀/残留/排不尽 三个 toggle -->
    <view class="feel-row">
      <view class="feel-label">腹胀</view>
      <view class="toggle {{swelling ? 'on' : ''}}" bindtap="onSwellingToggle">
        <view class="toggle-knob"></view>
      </view>
    </view>
    <view class="feel-row">
      <view class="feel-label">残留感</view>
      <view class="toggle {{residue ? 'on' : ''}}" bindtap="onResidueToggle">
        <view class="toggle-knob"></view>
      </view>
    </view>
    <view class="feel-row">
      <view class="feel-label">排不尽</view>
      <view class="toggle {{unfinished ? 'on' : ''}}" bindtap="onUnfinishedToggle">
        <view class="toggle-knob"></view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-label">备注（可选）</view>
    <textarea
      class="note-input"
      placeholder="点击此处输入备注..."
      placeholder-class="note-placeholder"
      maxlength="200"
      auto-height="{{true}}"
      show-confirm-bar="{{true}}"
      hold-keyboard="{{false}}"
      cursor-spacing="20"
      adjust-position="{{true}}"
      value="{{note}}"
      bindinput="onNoteInput"
      bindblur="onNoteBlur"
      bindconfirm="onNoteConfirm"
    ></textarea>
    <view class="note-counter">{{note.length}}/200</view>
  </view>

  <view class="bottom-bar">
    <button class="btn-cancel" bindtap="onCancel">取消</button>
    <button class="btn-save" bindtap="onSave">完成</button>
  </view>
</view>
