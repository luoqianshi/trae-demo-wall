/* record.wxss */

page {
  background: #f8f9fa;
  padding-bottom: 160rpx;
}

.container {
  padding: 24rpx 32rpx;
  background: #f8f9fa;
}

/* ===== V0.2.0 波波条 ===== */
.bobo-bar {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFE0B2 100%);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.12);
}
.bobo-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.bobo-emoji { font-size: 56rpx; line-height: 1; }
.bobo-bubble {
  flex: 1;
  min-width: 0;
}
.bobo-bubble-text {
  font-size: 28rpx;
  color: #5D4037;
  line-height: 1.5;
  font-weight: 500;
}
.bobo-bubble-state {
  font-size: 20rpx;
  color: #8D6E63;
  margin-top: 6rpx;
  opacity: 0.6;
}

/* ===== V0.2.0 身体感受 ===== */
.feel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.feel-row:last-child { border-bottom: none; }
.feel-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}
.pain-levels {
  display: flex;
  gap: 12rpx;
}
.pain-level {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 6rpx 6rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  background: #fafafa;
  min-width: 70rpx;
  transition: all 0.2s;
}
.pain-level.selected {
  border-color: #FF9800;
  background: #FFF3E0;
}
.pain-level-bar {
  width: 40rpx;
  height: 8rpx;
  border-radius: 4rpx;
}
.pain-lv-0 { background: #C8E6C9; }
.pain-lv-1 { background: #FFF59D; }
.pain-lv-2 { background: #FFB74D; }
.pain-lv-3 { background: #E57373; }
.pain-level-text {
  font-size: 22rpx;
  color: #666;
}
.pain-level.selected .pain-level-text {
  color: #E65100;
  font-weight: 600;
}

/* 开关（腹胀/残留/排不尽） */
.toggle {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #E0E0E0;
  position: relative;
  transition: background 0.25s;
}
.toggle.on { background: #66BB6A; }
.toggle-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
  transition: left 0.25s;
}
.toggle.on .toggle-knob { left: 40rpx; }

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-label {
  font-size: 28rpx;
  color: #5f6368;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.time-picker {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.time-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.time-value {
  flex: 1;
  font-size: 32rpx;
  color: #202124;
  font-weight: 500;
}

.time-arrow {
  color: #9aa0a6;
  font-size: 36rpx;
}

/* Bristol 网格 */
.bristol-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.bristol-item {
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  background: #f8f9fa;
  position: relative;
}

.bristol-item.selected {
  border-color: #4285F4;
  background: #e8f0fe;
}

.bristol-shape {
  width: 80rpx;
  height: 56rpx;
  border-radius: 8rpx;
  margin: 0 auto 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bristol-shape-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
}

.bristol-name {
  font-size: 24rpx;
  color: #202124;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.bristol-short {
  font-size: 20rpx;
  color: #5f6368;
  line-height: 1.3;
}

/* 颜色网格 - 上排 3 + 下排 4，交叉错开
   关键：让上排每个 icon 的中心精准对齐下排两个相邻 icon 中心的中点
   几何关系：下排 4 个 icon（width 25%）中心位于 12.5%, 37.5%, 62.5%, 87.5%
            上排 3 个 icon 中心应对齐 25%, 50%, 75%
            即上排首个 icon 左边缘 = 12.5%，width = 25% */
.color-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.color-row {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}

/* 上排 3 个：margin-left 12.5% + 子元素 width 25%，中心精准位于 25%/50%/75% */
.color-row-top {
  margin-left: 12.5%;
}

.color-row-top .color-item {
  width: 25%;
  flex-shrink: 0;
}

/* 下排 4 个：margin-left 0 + width 25%，中心位于 12.5%/37.5%/62.5%/87.5% */
.color-row-bottom {
  margin-left: 0;
}

.color-row-bottom .color-item {
  width: 25%;
  flex-shrink: 0;
}

.color-item {
  text-align: center;
  padding: 8rpx 0;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.color-item.selected {
  border-color: #4285F4;
  background: #e8f0fe;
}

.color-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
}

.color-name {
  font-size: 22rpx;
  color: #202124;
}

/* 备注 */
.note-input {
  width: 100%;
  min-height: 120rpx;
  max-height: 320rpx;
  padding: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #202124;
  background: #f8f9fa;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.note-placeholder {
  color: #9aa0a6;
  font-size: 28rpx;
}

.note-counter {
  text-align: right;
  color: #9aa0a6;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #e8eaed;
  z-index: 999;
}

.btn-cancel,
.btn-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 12rpx;
  font-weight: 500;
  margin: 0;
  padding: 0;
  border: none;
}

.btn-cancel {
  background: #f1f3f4;
  color: #5f6368;
}

.btn-save {
  background: #4285F4;
  color: #ffffff;
}

button::after {
  border: none;
}
