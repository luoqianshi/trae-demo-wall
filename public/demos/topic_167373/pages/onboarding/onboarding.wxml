<view class="container">
  <view class="skip-bar">
    <view class="skip-btn" bindtap="onSkip">跳过</view>
  </view>

  <view class="content">
    <view class="icon">{{iconText}}</view>
    <view class="title">{{titleText}}</view>
    <view class="description">{{descText}}</view>
  </view>

  <view class="indicators">
    <view class="dot {{currentStep == 0 ? 'active' : ''}}"></view>
    <view class="dot {{currentStep == 1 ? 'active' : ''}}"></view>
    <view class="dot {{currentStep == 2 ? 'active' : ''}}"></view>
  </view>

  <view class="bottom-area">
    <button class="btn-primary" bindtap="onNext">{{buttonText}}</button>
  </view>
</view>
