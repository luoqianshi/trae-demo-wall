/* onboarding.wxss */

page {
  background: #f8f9fa;
}

.container {
  padding: 40rpx;
  background: #f8f9fa;
  width: 100%;
}

.skip-bar {
  text-align: right;
  margin-bottom: 40rpx;
}

.skip-btn {
  color: #5f6368;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  display: inline-block;
}

.content {
  text-align: center;
  margin-top: 200rpx;
  margin-bottom: 100rpx;
}

.icon {
  font-size: 96rpx;
  font-weight: bold;
  color: #4285F4;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #202124;
  margin-bottom: 30rpx;
}

.description {
  font-size: 30rpx;
  color: #5f6368;
  line-height: 1.6;
  padding: 0 40rpx;
}

.indicators {
  text-align: center;
  margin: 60rpx 0;
}

.dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #dadce0;
  margin: 0 12rpx;
  vertical-align: middle;
}

.dot.active {
  width: 48rpx;
  border-radius: 8rpx;
  background: #4285F4;
}

.bottom-area {
  padding: 0 0 40rpx 0;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4285F4;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

button.btn-primary {
  margin: 0;
  padding: 0;
}

button.btn-primary[disabled] {
  background: #4285F4;
  color: #ffffff;
  opacity: 1;
}
