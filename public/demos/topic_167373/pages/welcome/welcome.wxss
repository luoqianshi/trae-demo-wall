/* pages/welcome/welcome.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #ffffff 60%);
  padding: 40rpx 32rpx 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 进度条 */
.progress {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background-color: #dadce0;
  transition: background-color 0.2s;
}

.dot.active {
  background-color: #4285F4;
}

.line {
  width: 80rpx;
  height: 4rpx;
  background-color: #dadce0;
  margin: 0 12rpx;
  transition: background-color 0.2s;
}

.line.active {
  background-color: #4285F4;
}

.progress-label {
  text-align: center;
  font-size: 24rpx;
  color: #5f6368;
  margin-bottom: 40rpx;
}

/* 步骤卡 */
.step-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(66, 133, 244, 0.08);
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 步骤 1：产品介绍 */
.hero {
  text-align: center;
  padding: 40rpx 0 32rpx 0;
}

.hero-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #202124;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #5f6368;
}

.feature-list {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.feature {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.feature:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  line-height: 1.2;
}

.feature-content {
  flex: 1;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #5f6368;
  line-height: 1.5;
}

/* 步骤 2/3：须知与免责 */
.card-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #5f6368;
}

.terms-scroll {
  flex: 1;
  max-height: 600rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.terms-item {
  font-size: 26rpx;
  line-height: 1.7;
  color: #202124;
  margin-bottom: 16rpx;
}

.terms-item:last-child {
  margin-bottom: 0;
}

.agree-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx 0;
  border-top: 1rpx solid #f1f3f4;
}

.agree-text {
  font-size: 26rpx;
  color: #202124;
  margin-left: 12rpx;
  flex: 1;
}

/* 按钮 */
.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: auto;
}

.btn-row-single {
  display: block;
}

.btn-row-single .btn {
  width: 100%;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 88rpx;
}

.btn-primary {
  background-color: #4285F4;
  color: #ffffff;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: #f1f3f4;
  color: #5f6368;
}

.btn-secondary::after {
  border: none;
}
