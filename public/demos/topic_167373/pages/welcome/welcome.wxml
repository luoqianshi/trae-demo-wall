<view class="container">
  <!-- 顶部进度条 -->
  <view class="progress">
    <view class="dot {{step >= 1 ? 'active' : ''}}"></view>
    <view class="line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="dot {{step >= 2 ? 'active' : ''}}"></view>
    <view class="line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="dot {{step >= 3 ? 'active' : ''}}"></view>
  </view>
  <view class="progress-label">第 {{step}} / {{totalSteps}} 步</view>

  <!-- 步骤 1：产品介绍 -->
  <view wx:if="{{step === 1}}" class="step-card">
    <view class="hero">
      <view class="hero-icon">📋</view>
      <view class="hero-title">欢迎使用 排便健康记录</view>
      <view class="hero-subtitle">一个简单、私密、专业的健康记录工具</view>
    </view>

    <view class="feature-list">
      <view class="feature">
        <view class="feature-icon">🔒</view>
        <view class="feature-content">
          <view class="feature-title">数据本地保存</view>
          <view class="feature-desc">所有记录仅保存在您的手机本地，不上传任何服务器</view>
        </view>
      </view>
      <view class="feature">
        <view class="feature-icon">📊</view>
        <view class="feature-content">
          <view class="feature-title">直观统计与洞察</view>
          <view class="feature-desc">自动按周/月统计，帮助您了解自己的健康规律</view>
        </view>
      </view>
      <view class="feature">
        <view class="feature-icon">⏰</view>
        <view class="feature-content">
          <view class="feature-title">智能提醒</view>
          <view class="feature-desc">可设置每日记录提醒，帮助您养成健康习惯</view>
        </view>
      </view>
    </view>

    <view class="btn-row btn-row-single">
      <button class="btn btn-primary" bindtap="onNext">下一步</button>
    </view>
  </view>

  <!-- 步骤 2：用户须知 -->
  <view wx:if="{{step === 2}}" class="step-card">
    <view class="card-header">
      <view class="card-title">用户须知</view>
      <view class="card-subtitle">请仔细阅读后勾选同意</view>
    </view>

    <scroll-view class="terms-scroll" scroll-y="true">
      <view wx:for="{{termsText}}" wx:key="*this" class="terms-item">{{item}}</view>
    </scroll-view>

    <view class="agree-row">
      <checkbox value="terms" checked="{{acceptedTerms}}" bindchange="onToggleTerms" color="#4285F4"/>
      <text class="agree-text" bindtap="onToggleTerms">我已阅读并同意以上条款</text>
    </view>

    <view class="btn-row">
      <button class="btn btn-secondary" bindtap="onPrev">上一步</button>
      <button class="btn btn-primary" bindtap="onNext">下一步</button>
    </view>
  </view>

  <!-- 步骤 3：免责声明 -->
  <view wx:if="{{step === 3}}" class="step-card">
    <view class="card-header">
      <view class="card-title">医疗免责声明</view>
      <view class="card-subtitle">请仔细阅读后勾选接受</view>
    </view>

    <scroll-view class="terms-scroll" scroll-y="true">
      <view wx:for="{{disclaimerText}}" wx:key="*this" class="terms-item">{{item}}</view>
    </scroll-view>

    <view class="agree-row">
      <checkbox value="disclaimer" checked="{{acceptedDisclaimer}}" bindchange="onToggleDisclaimer" color="#4285F4"/>
      <text class="agree-text" bindtap="onToggleDisclaimer">我已知晓并接受以上声明</text>
    </view>

    <view class="btn-row">
      <button class="btn btn-secondary" bindtap="onPrev">上一步</button>
      <button class="btn btn-primary" bindtap="onFinish">开始使用</button>
    </view>
  </view>
</view>
