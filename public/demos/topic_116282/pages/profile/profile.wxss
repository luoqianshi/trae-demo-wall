/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
}

/* ── 通用间距 ── */
.section-px { padding-left: 40rpx; padding-right: 40rpx; }
.section-mb { margin-bottom: 32rpx; }

/* ════════════════════════════════════════ */
/* 个人信息头部                               */
/* ════════════════════════════════════════ */
.header-section {
  background: linear-gradient(180deg, #FBF7F2, #F5EDE3);
  padding-bottom: 48rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 40rpx 0;
}

/* 头像 */
.avatar-wrap {
  margin-bottom: 24rpx;
}

.avatar-inner {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  box-shadow: 0 8rpx 32rpx rgba(232, 200, 122, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 姓名 + badge */
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.personality-pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 20rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-accent);
  background: var(--color-accent-light);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  white-space: nowrap;
}

/* 用户ID */
.user-handle {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 24rpx;
}

/* 编辑资料按钮 */
.edit-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-accent);
  background: transparent;
}

.edit-btn text {
  font-size: 24rpx;
  color: var(--color-accent-hover);
  font-weight: 600;
}

/* ════════════════════════════════════════ */
/* 数据统计行                                 */
/* ════════════════════════════════════════ */
.stats-card {
  padding: 32rpx 0;
}

.stats-row {
  display: flex;
  align-items: center;
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--color-border);
  flex-shrink: 0;
  align-self: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ════════════════════════════════════════ */
/* 信用评分卡片                               */
/* ════════════════════════════════════════ */
.credit-card {
  padding: 36rpx 32rpx;
}

.credit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.credit-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.credit-level-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 600;
  background: var(--credit-positive-bg);
  color: var(--credit-positive);
}

/* 指标网格 */
.metrics-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.metric-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* 进度环 */
.progress-ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 6rpx solid var(--state-success);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(90, 158, 107, 0.1);
}

.ring-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--state-success);
}

/* 综合评分环（金色渐变 + 赤陶色边框） */
.ring-score {
  border: 6rpx solid var(--color-primary);
  background: linear-gradient(135deg, var(--color-accent-light), var(--color-primary-50));
}

.ring-value-score {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.metric-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 信用标签行 */
.credit-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border-light);
}

/* ════════════════════════════════════════ */
/* 入席名额卡片                               */
/* ════════════════════════════════════════ */
.quota-card {
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quota-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

.quota-dots {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.quota-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.dot-filled {
  background: var(--color-secondary);
}

.dot-empty {
  background: transparent;
  border: 3rpx solid var(--color-border);
}

.quota-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 28rpx;
}

.invite-friend-btn {
  width: 100%;
  height: 84rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: var(--shadow-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 84rpx;
  padding: 0;
}

.invite-friend-btn::after {
  border: none;
}

/* ════════════════════════════════════════ */
/* 菜单列表                                   */
/* ════════════════════════════════════════ */
.menu-card {
  padding: 8rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* ════════════════════════════════════════ */
/* 退出登录                                   */
/* ════════════════════════════════════════ */
.logout-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 24rpx;
}

.logout-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}
