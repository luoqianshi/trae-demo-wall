/* pages/personality-quiz/personality-quiz.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
}

/* ════════════════════════════════════════ */
/* 顶部进度条 (sticky)                       */
/* ════════════════════════════════════════ */
.quiz-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--color-surface);
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 12rpx;
}

.skip-btn {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 0;
}

.q-counter {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-weight: 600;
}

.progress-track {
  height: 3rpx;
  background: var(--color-border);
  margin: 0 40rpx 20rpx;
  border-radius: 2rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 2rpx;
  transition: width 350ms ease;
}

/* ════════════════════════════════════════ */
/* 问题卡                                    */
/* ════════════════════════════════════════ */
.question-card {
  position: relative;
  margin: 32rpx 40rpx;
  padding: 56rpx 48rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(180deg, #FFFDF9 0%, #F5EDE3 100%);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.deco-icons {
  position: absolute;
  top: 28rpx;
  right: 36rpx;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  opacity: 0.4;
  z-index: 0;
}

.question-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 4rpx;
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.question-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.5;
  margin-bottom: 48rpx;
  position: relative;
  z-index: 1;
}

/* 答案选项 */
.options-wrap {
  position: relative;
  z-index: 1;
}

.option-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  transition: all 200ms ease;
}

.option-card.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-50);
}

.option-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface-dim);
  color: var(--color-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  transition: all 200ms ease;
}

.option-card.selected .option-badge {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.or-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.or-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-style: italic;
}

/* ════════════════════════════════════════ */
/* 维度指示器                                */
/* ════════════════════════════════════════ */
.dim-indicator {
  margin: 0 40rpx 32rpx;
  padding: 28rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.dim-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  text-align: center;
}

.dim-groups {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.dim-group {
  display: flex;
  gap: 10rpx;
}

.dim-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.dim-dot.lit {
  background: var(--color-primary);
}

/* ════════════════════════════════════════ */
/* 生成中预览                                */
/* ════════════════════════════════════════ */
.gen-preview {
  margin: 0 40rpx 32rpx;
}

.gen-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.gen-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 800ms linear infinite;
  flex-shrink: 0;
}

.gen-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ════════════════════════════════════════ */
/* 上一题预览                                */
/* ════════════════════════════════════════ */
.prev-preview {
  margin: 0 40rpx 40rpx;
}

.prev-divider {
  height: 1rpx;
  background: var(--color-border);
  margin-bottom: 24rpx;
}

.prev-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
