/* pages/meal-detail/meal-detail.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
}

/* ── 导航栏 ── */
.nav-bar-wrap {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--color-surface);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  position: relative;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* ── Hero 图区域 ── */
.hero {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.05) 40%, rgba(0,0,0,0.55) 100%);
}

.hero-bottom {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
  flex: 1;
}

.hero-cuisine-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 253, 249, 0.25);
  color: var(--color-text-inverse);
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(255, 253, 249, 0.3);
  flex-shrink: 0;
}

/* ── 信息栏 ── */
.info-bar {
  display: flex;
  align-items: center;
  margin: -40rpx 40rpx 0;
  padding: 32rpx 16rpx;
  border-radius: var(--radius-lg);
  position: relative;
  z-index: 10;
}

.info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.info-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.info-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.info-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--color-border);
}

/* ── 通用 Section ── */
.section {
  padding: 40rpx 40rpx 0;
}

.section-header {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
}

/* ── 本桌菜单 ── */
.dish-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.dish-pill-lg {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
}

/* ── 入席信息卡片 ── */
.seat-card {
  padding: 8rpx 32rpx;
}

.seat-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.seat-cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.seat-cell:last-child {
  border-bottom: none;
}

.seat-cell-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.seat-cell-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.seat-cell-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.seat-cell-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.seat-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* ── 发起人卡片 ── */
.initiator-card {
  padding: 32rpx;
}

.initiator-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.initiator-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  border: 3rpx solid var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.initiator-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.initiator-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.initiator-personality {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.initiator-personality-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.initiator-match {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.match-score {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.match-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* 信用标签 */
.initiator-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

/* 食人格描述 mini 卡 */
.personality-desc-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-accent-light);
  border: 1rpx solid rgba(232, 200, 122, 0.3);
}

.desc-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.desc-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.desc-body {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  font-style: italic;
}

/* ── 底部CTA栏 ── */
.cta-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
}
