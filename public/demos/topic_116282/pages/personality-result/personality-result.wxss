/* pages/personality-result/personality-result.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ════════════════════════════════════════ */
/* 导航栏 (sticky)                           */
/* ════════════════════════════════════════ */
.nav-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--color-surface);
}

.result-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 88rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.result-nav .nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ════════════════════════════════════════ */
/* 食人格英雄卡片                            */
/* ════════════════════════════════════════ */
.hero-card {
  position: relative;
  margin: 32rpx 40rpx;
  padding: 56rpx 40rpx 48rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(180deg, #FFFDF9 0%, #FBF7F2 100%);
  border: 3rpx solid var(--color-accent);
  box-shadow: 0 8rpx 40rpx rgba(232, 200, 122, 0.18);
  text-align: center;
  overflow: hidden;
}

.hero-deco-1 {
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: var(--color-accent);
  opacity: 0.08;
}

.hero-deco-2 {
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.06;
}

.mascot-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 20rpx rgba(232, 200, 122, 0.25);
}

.personality-code {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.personality-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.hero-card .golden-divider {
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.tagline {
  display: block;
  font-size: 28rpx;
  font-style: italic;
  color: var(--color-secondary);
  line-height: 1.6;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

/* 2x2 维度徽章 */
.dim-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.dim-badge {
  width: calc(50% - 8rpx);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
}

.dim-badge.terracotta { background: #FBF0E8; color: #C07548; }
.dim-badge.olive { background: #EEF5EB; color: #5E8450; }
.dim-badge.amber { background: #FDF6E8; color: #B8923A; }
.dim-badge.slate { background: #E5EDEB; color: #5A7E76; }

.dim-letter {
  font-size: 32rpx;
  font-weight: 800;
}

.dim-label {
  font-size: 24rpx;
  font-weight: 600;
}

/* ════════════════════════════════════════ */
/* 通用内容卡片                              */
/* ════════════════════════════════════════ */
.section-card {
  margin: 0 40rpx 24rpx;
  padding: 36rpx 32rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-title-row .card-title {
  margin-bottom: 0;
}

.desc-text {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.kw {
  color: var(--color-primary);
  font-weight: 700;
}

/* 适合的餐厅 pill */
.restaurant-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.restaurant-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
  background: var(--color-accent-light);
  color: var(--color-accent-hover);
  font-size: 26rpx;
  font-weight: 600;
}

/* 推荐拼桌食人格 */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
  border-left: 8rpx solid var(--color-border);
}

.match-card.terracotta { border-left-color: #D4845A; }
.match-card.olive { border-left-color: #7B9E6B; }
.match-card.amber { border-left-color: #E8C87A; }
.match-card.slate { border-left-color: #5A7E76; }

.match-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
}

.match-info {
  flex: 1;
  min-width: 0;
}

.match-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.match-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 雷区提醒 */
.warning-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.warning-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.warning-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--state-warning);
  margin-top: 12rpx;
  flex-shrink: 0;
}

.warning-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ════════════════════════════════════════ */
/* 经典引用                                  */
/* ════════════════════════════════════════ */
.quote-section {
  position: relative;
  margin: 16rpx 40rpx 32rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.quote-mark {
  display: block;
  font-size: 80rpx;
  font-family: Georgia, serif;
  color: var(--color-accent);
  line-height: 1;
  margin-bottom: 8rpx;
  opacity: 0.5;
}

.quote-text {
  display: block;
  font-size: 30rpx;
  font-style: italic;
  color: var(--color-primary);
  line-height: 1.7;
}

/* ════════════════════════════════════════ */
/* 分享卡片预览                              */
/* ════════════════════════════════════════ */
.share-preview-wrap {
  margin: 0 40rpx 32rpx;
}

.preview-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 16rpx;
}

.share-preview-card {
  padding: 40rpx 32rpx 28rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, #FFFDF9 0%, #FBF7F2 100%);
  border: 2rpx solid var(--color-accent);
  text-align: center;
}

.sp-mascot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-accent);
  background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.sp-code {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
}

.sp-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.sp-tagline {
  display: block;
  font-size: 22rpx;
  font-style: italic;
  color: var(--color-secondary);
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.sp-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.sp-brand-text {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* ════════════════════════════════════════ */
/* 底部固定操作栏                            */
/* ════════════════════════════════════════ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.bottom-bar-inner {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.action-primary {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-primary);
}

.action-outline {
  background: transparent;
  color: var(--color-primary);
  border: 3rpx solid var(--color-primary);
}
