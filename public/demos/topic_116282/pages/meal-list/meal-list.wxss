/* pages/meal-list/meal-list.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
}

/* ── 顶部固定栏 ── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 16rpx;
  background: var(--color-surface);
  position: sticky;
  top: 0;
  z-index: 20;
}

.city-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.city-name {
  font-weight: 700;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.search-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-surface-dim);
}

/* ── 时间筛选栏 ── */
.time-filter-bar {
  background: var(--color-surface);
  padding: 0 40rpx 20rpx;
  position: sticky;
  top: 96rpx;
  z-index: 19;
  white-space: nowrap;
}

.time-filter-inner {
  display: inline-flex;
  gap: 20rpx;
  align-items: center;
}

/* ── 子筛选栏 ── */
.sub-filter-bar {
  background: var(--color-background);
  padding: 20rpx 40rpx;
  white-space: nowrap;
}

.sub-filter-inner {
  display: inline-flex;
  gap: 16rpx;
  align-items: center;
}

.sub-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  transition: all 200ms ease;
}

.sub-pill.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.sub-pill-icon {
  color: var(--color-text-tertiary);
}

.sub-divider {
  width: 2rpx;
  height: 28rpx;
  background: var(--color-border);
  margin: 0 8rpx;
}

/* ── 饭局卡片列表 ── */
.meal-cards {
  padding: 8rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.meal-card-detail {
  padding: 24rpx;
  border-radius: var(--radius-lg);
}

/* 顶部：缩略图 + 内容 */
.card-top {
  display: flex;
  gap: 24rpx;
}

.card-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}

.card-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.card-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.card-meta-dot {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin: 0 8rpx;
}

.card-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.card-remaining {
  font-size: 26rpx;
  font-weight: 700;
}

.card-budget {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.card-credit {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
}

/* 分隔线 */
.card-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 底部：必点菜 + 发起人 + 申请入席 */
.card-bottom {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-dishes {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.card-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-initiator {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-initiator-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.card-apply-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-primary);
  line-height: 1;
}

.card-apply-btn::after {
  border: none;
}
