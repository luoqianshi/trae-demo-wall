<!-- pages/meal-list/meal-list.wxml -->
<view class="page">

  <!-- ── 状态栏占位 ── -->
  <view style="height:{{statusBarHeight}}px;"></view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 1. 顶部固定栏：城市选择 + 搜索                    -->
  <!-- ════════════════════════════════════════════ -->
  <view class="top-bar">
    <view class="city-selector btn-press" bindtap="onTapCity">
      <icon name="map-pin" color="#D4845A" size="16" />
      <text class="city-name">{{city}}</text>
      <icon name="chevron-down" color="#6B5D52" size="14" />
    </view>
    <view class="search-btn btn-press" bindtap="onTapSearch">
      <icon name="search" color="#6B5D52" size="22" />
    </view>
  </view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 2. 时间筛选栏                                   -->
  <!-- ════════════════════════════════════════════ -->
  <scroll-view scroll-x class="scroll-x time-filter-bar">
    <view class="time-filter-inner">
      <text
        class="filter-pill {{activeTime === index ? 'active' : ''}}"
        wx:for="{{timeFilters}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTapTimeFilter"
      >{{item}}</text>
    </view>
  </scroll-view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 3. 子筛选栏：菜系 + 预算/人数                    -->
  <!-- ════════════════════════════════════════════ -->
  <scroll-view scroll-x class="scroll-x sub-filter-bar">
    <view class="sub-filter-inner">
      <text
        class="sub-pill {{activeCuisine === index ? 'active' : ''}}"
        wx:for="{{cuisineFilters}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTapCuisineFilter"
      >{{item}}</text>
      <view class="sub-divider"></view>
      <view
        class="sub-pill sub-pill-icon"
        wx:for="{{extraFilters}}"
        wx:key="*this"
        data-label="{{item}}"
        bindtap="onTapExtraFilter"
      >
        <text>{{item}}</text>
        <icon name="chevron-down" color="#A09589" size="12" />
      </view>
    </view>
  </scroll-view>

  <!-- ════════════════════════════════════════════ -->
  <!-- 4. 饭局卡片列表                                  -->
  <!-- ════════════════════════════════════════════ -->
  <view class="meal-cards">
    <view
      class="meal-card-detail card card-lift"
      wx:for="{{meals}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapMealCard"
    >
      <!-- 顶部：缩略图 + 内容 -->
      <view class="card-top">
        <view class="card-thumb" style="background:{{item.image}};"></view>
        <view class="card-content">
          <view class="card-name-row">
            <text class="card-name">{{item.name}}</text>
            <text class="cuisine-pill">{{item.cuisine}}</text>
          </view>
          <view class="card-meta-row">
            <icon name="clock" color="#6B5D52" size="12" />
            <text class="card-meta">{{item.date}}</text>
            <text class="card-meta-dot">·</text>
            <icon name="map-pin" color="#6B5D52" size="12" />
            <text class="card-meta">{{item.district}}</text>
          </view>
          <view class="card-info-row">
            <text class="card-remaining text-brand">还差 {{item.seats.remaining}} 人</text>
            <text class="card-budget">人均 ¥{{item.budget}}</text>
            <text class="credit-tag positive card-credit" wx:if="{{item.initiator.creditTags[0]}}">{{item.initiator.creditTags[0].text}}</text>
          </view>
        </view>
      </view>

      <!-- 分隔线 -->
      <view class="card-divider"></view>

      <!-- 底部：必点菜 + 发起人 + 申请入席 -->
      <view class="card-bottom">
        <view class="card-dishes">
          <text class="dish-pill" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="*this">{{dish}}</text>
        </view>
        <view class="card-action-row">
          <view class="card-initiator">
            <view class="personality-mini">{{item.initiator.personality}}</view>
            <text class="card-initiator-name font-serif">{{item.initiator.personalityName}}</text>
          </view>
          <button class="card-apply-btn btn-press" catchtap="onTapApply" data-id="{{item.id}}">申请入席</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位（给tabBar留空间） -->
  <view style="height:120rpx;"></view>
</view>
