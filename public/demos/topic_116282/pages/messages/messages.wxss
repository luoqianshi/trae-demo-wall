/* pages/messages/messages.wxss */
.page {
  min-height: 100vh;
  background: var(--color-background);
}

/* ── 顶部栏 (sticky) ── */
.header-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--color-background);
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx 20rpx;
  position: relative;
}

.top-bar-left {
  width: 120rpx;
}

.top-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.read-all-btn {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  width: 120rpx;
  text-align: right;
}

/* ── 筛选标签栏 ── */
.filter-bar {
  padding: 0 40rpx 24rpx;
  white-space: nowrap;
}

.msg-filter-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 36rpx;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  margin-right: 20rpx;
  background: var(--color-surface-dim);
  color: var(--color-text-secondary);
  transition: all 200ms ease;
}

.msg-filter-pill.active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

/* ── 消息列表 ── */
.msg-list {
  padding-top: 8rpx;
}

.section-px { padding-left: 40rpx; padding-right: 40rpx; }

.section-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 600;
  padding: 24rpx 40rpx 16rpx;
}

.notif-gap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 通知卡片 */
.notif-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.notif-muted {
  opacity: 0.65;
}

/* 左侧图标 */
.notif-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 右侧内容 */
.notif-content {
  flex: 1;
  min-width: 0;
}

.notif-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.notif-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.notif-body {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.notif-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}
