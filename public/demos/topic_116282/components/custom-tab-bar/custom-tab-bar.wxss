.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFDF9;
  border-top: 1rpx solid #EDE5DB;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  flex: 1;
  padding-bottom: 16rpx;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #D4845A;
}

.tab-item.inactive .tab-text {
  color: #A09589;
}

.tab-icon-wrap {
  position: relative;
}

.tab-badge {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D45A5A;
  border: 3rpx solid #FFFDF9;
}

/* 中心凸起按钮 */
.tab-center {
  margin-top: -32rpx;
  padding-bottom: 16rpx;
}

.tab-center-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #D4845A;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(212, 132, 90, 0.35);
}

.tab-text-center {
  margin-top: 8rpx;
  color: #A09589;
}
