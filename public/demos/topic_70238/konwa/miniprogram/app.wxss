page {
  --primary: #1A5BD8;
  --primary-light: #3D7BFF;
  --secondary: #2CC8B8;
  --secondary-deep: #1AB5A5;
  --warning: #FF8A33;
  --danger: #F55555;
  --text-deep: #0A2463;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --bg-cream: #FFF9EF;
  --bg-cream-2: #FFF5E6;
  --bg-card-cream: #FFFBF2;
  --bg-white: #FFFFFF;
  --border-color: #F0E6D2;
  --radius-card: 56rpx;
  --radius-card-sm: 40rpx;
  --radius-btn: 56rpx;
  --radius-tag: 28rpx;
  --shadow-card: 0 8rpx 32rpx rgba(26, 91, 216, 0.06);
  --shadow-btn: 0 8rpx 0 #179E90, 0 16rpx 40rpx rgba(44, 200, 184, 0.3);
  --shadow-card-cream: 0 6rpx 24rpx rgba(26, 91, 216, 0.05);
}

page {
  background: linear-gradient(180deg, #FFF9EF 0%, #FFF5E6 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 100vh;
}

view, text, button, image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  outline: none;
}

button::after {
  border: none;
}

.container {
  padding: 0 40rpx;
}

.card {
  background: var(--bg-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.card-cream {
  background: var(--bg-card-cream);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card-cream);
}

.btn-primary {
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  color: #FFFFFF;
  border-radius: var(--radius-btn);
  font-size: 36rpx;
  font-weight: 700;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-btn);
  letter-spacing: 4rpx;
}

.btn-primary:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #179E90, 0 8rpx 20rpx rgba(44, 200, 184, 0.3);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-deep);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 36rpx;
  background: var(--secondary);
  border-radius: 4rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  font-weight: 500;
  display: inline-block;
}

.tag-kp {
  background: #F0FBFA;
  color: var(--secondary-deep);
}

.tag-reason {
  background: #FFF1E6;
  color: var(--warning);
}

.tag-warning {
  background: #FFF1E6;
  color: var(--warning);
}

.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

.text-deep { color: var(--text-deep); }
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-light { color: var(--text-light); }
.text-secondary-color { color: var(--secondary); }
.text-warning { color: var(--warning); }
.text-danger { color: var(--danger); }
.font-bold { font-weight: 700; }
.font-medium { font-weight: 500; }

.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.status-bar {
  width: 100%;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
}

.nav-bar.with-logo {
  padding: 8rpx 40rpx 24rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 64rpx;
  color: var(--text-deep);
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-deep);
  flex: 1;
  text-align: center;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.nav-logo {
  width: 64rpx;
  height: 64rpx;
  background: var(--secondary);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 800;
  font-size: 32rpx;
  flex-shrink: 0;
}

.nav-title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-deep);
}

.nav-en {
  color: var(--secondary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-left: 8rpx;
}

.nav-right {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon {
  font-size: 40rpx;
  color: var(--text-deep);
}

.content-scroll {
  flex: 1;
  height: 0;
}

.bottom-btn-wrap {
  padding: 24rpx 40rpx 32rpx;
  flex-shrink: 0;
}

.bottom-space {
  height: 200rpx;
}
