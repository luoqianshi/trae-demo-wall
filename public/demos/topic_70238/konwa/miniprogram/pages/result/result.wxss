.result-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  flex: 1;
  height: 0;
}

.score-header {
  background: var(--bg-card-cream);
  margin: 16rpx 40rpx;
  border-radius: var(--radius-card);
  padding: 48rpx;
  box-shadow: var(--shadow-card-cream);
}

.result-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.paper-name {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.score-row {
  margin-bottom: 16rpx;
}

.score-main {
  font-size: 120rpx;
  font-weight: 900;
  color: var(--text-deep);
  line-height: 1;
}

.score-full {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.score-detail {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.score-dot.green {
  background: var(--secondary);
}

.score-dot.red {
  background: var(--danger);
}

.score-detail text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.result-tag {
  padding: 12rpx 28rpx;
  background: var(--bg-white);
  border-radius: var(--radius-btn);
  font-size: 26rpx;
  color: var(--text-deep);
}

.wrong-section {
  padding: 32rpx 40rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-deep);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 36rpx;
  background: var(--secondary);
  border-radius: 4rpx;
}

.section-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.wrong-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wrong-item {
  background: var(--bg-white);
  border-radius: var(--radius-card);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.wrong-item-top {
  display: flex;
  gap: 20rpx;
}

.wrong-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wrong-q {
  flex: 1;
}

.wrong-q-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.wrong-answer {
  display: flex;
  gap: 24rpx;
}

.my-answer {
  font-size: 24rpx;
  color: var(--danger);
}

.right-answer {
  font-size: 24rpx;
  color: var(--secondary-deep);
}

.wrong-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}

.kp-tag {
  padding: 8rpx 20rpx;
  background: #F0FBFA;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  color: var(--secondary-deep);
}

.reason-tag {
  padding: 8rpx 20rpx;
  background: #FFF1E6;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  color: var(--warning);
}

.wrong-analysis {
  padding: 20rpx;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card-sm);
  margin-bottom: 16rpx;
}

.analysis-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-deep);
  margin-bottom: 12rpx;
}

.analysis-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.expand-hint {
  font-size: 26rpx;
  color: var(--secondary-deep);
  text-align: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border-color);
}

.bottom-space {
  height: 200rpx;
}

.bottom-btn-wrap {
  padding: 24rpx 40rpx 32rpx;
}

.confirm-btn {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-btn);
}

.confirm-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #179E90, 0 8rpx 20rpx rgba(44, 200, 184, 0.3);
}
