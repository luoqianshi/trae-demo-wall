<view class="result-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">识别结果</view>
    <view class="nav-right">
      <text class="nav-icon">⋯</text>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y>
    <view class="score-header">
      <view class="result-info">
        <text class="paper-name">{{result.paperName}}</text>
        <view class="score-row">
          <text class="score-main">{{result.score}}</text>
          <text class="score-full">/{{result.fullScore}}</text>
        </view>
        <view class="score-detail">
          <view class="score-dot green"></view>
          <text>正确 {{result.correctCount}} 题</text>
          <view class="score-dot red"></view>
          <text>错误 {{result.wrongCount}} 题</text>
        </view>
        <view class="result-tags">
          <view class="result-tag">{{result.grade}}</view>
          <view class="result-tag">{{result.subject}}</view>
          <view class="result-tag">用时 {{result.time}}分钟</view>
        </view>
      </view>
    </view>

    <view class="wrong-section">
      <view class="section-header">
        <view class="section-title">错题列表</view>
        <text class="section-count">共 {{result.wrongCount}} 题</text>
      </view>

      <view class="wrong-list">
        <view class="wrong-item" wx:for="{{result.wrongList}}" wx:key="id">
          <view class="wrong-item-top">
            <view class="wrong-num">{{item.id}}</view>
            <view class="wrong-q">
              <view class="wrong-q-text">{{item.question}}</view>
              <view class="wrong-answer">
                <text class="my-answer">你的答案：{{item.userAnswer}}</text>
                <text class="right-answer">正确答案：{{item.correctAnswer}}</text>
              </view>
            </view>
          </view>

          <view class="wrong-tags">
            <view class="kp-tag" wx:for="{{item.knowledgePoints}}" wx:for-item="kp" wx:key="*this">{{kp}}</view>
            <view class="reason-tag">{{item.reason}}</view>
          </view>

          <view wx:if="{{item.expanded}}" class="wrong-analysis">
            <view class="analysis-title">解析</view>
            <view class="analysis-text">{{item.analysis}}</view>
          </view>

          <view class="expand-hint" bindtap="toggleExpand" data-id="{{item.id}}">
            {{item.expanded ? '收起解析' : '查看解析'}}
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="bottom-btn-wrap">
    <view class="confirm-btn" bindtap="goToAnalysis">查看学情分析</view>
  </view>
</view>
