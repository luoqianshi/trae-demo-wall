.practice-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.subject-tabs {
  display: flex;
  gap: 16rpx;
  padding: 32rpx 40rpx;
  overflow-x: auto;
}

.subject-tab {
  padding: 16rpx 32rpx;
  background: var(--bg-white);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  flex-shrink: 0;
  box-shadow: var(--shadow-card);
}

.subject-tab.active {
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  color: #FFFFFF;
}

.content {
  padding: 0 40rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-deep);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 36rpx;
  background: var(--secondary);
  border-radius: 4rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.type-card {
  background: var(--bg-white);
  border-radius: var(--radius-card);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.type-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.type-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-deep);
  margin-bottom: 8rpx;
}

.type-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.practice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.practice-item {
  background: var(--bg-white);
  border-radius: var(--radius-card-sm);
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-card);
}

.practice-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--secondary);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.practice-info {
  flex: 1;
}

.practice-q {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
  margin-bottom: 8rpx;
}

.practice-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.practice-btn {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: var(--radius-btn);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 0 #179E90;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}
