<view class="practice-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar with-logo">
    <view class="nav-left">
      <view class="nav-logo">K</view>
      <view>
        <text class="nav-title-text">练习</text>
        <text class="nav-en">KNOWA</text>
      </view>
    </view>
    <view class="nav-right">
      <text class="nav-icon">⚙</text>
    </view>
  </view>

  <view class="subject-tabs">
    <view class="subject-tab {{currentSubject === item ? 'active' : ''}}" wx:for="{{subjects}}" wx:key="*this" bindtap="switchSubject" data-subject="{{item}}">{{item}}</view>
  </view>

  <view class="content">
    <view class="section-title">练习类型</view>
    <view class="type-grid">
      <view class="type-card" wx:for="{{types}}" wx:key="name">
        <view class="type-icon">{{item.icon}}</view>
        <view class="type-name">{{item.name}}</view>
        <view class="type-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="section-title">推荐练习</view>
    <view class="practice-list">
      <view class="practice-item" wx:for="{{practiceList}}" wx:key="id">
        <view class="practice-num">{{item.id}}</view>
        <view class="practice-info">
          <view class="practice-q">{{item.q}}</view>
          <view class="practice-meta">{{item.kp}} · {{item.level}}</view>
        </view>
        <view class="practice-btn">开始</view>
      </view>
    </view>
  </view>
</view>
