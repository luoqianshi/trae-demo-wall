.scanning-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  flex: 1;
  height: 0;
}

.scan-hero {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scan-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.scan-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-deep);
  margin-bottom: 16rpx;
}

.scan-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.scan-card {
  margin: 24rpx 40rpx;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card);
  padding: 48rpx;
  box-shadow: var(--shadow-card-cream);
}

.scan-preview {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-card-sm);
  overflow: hidden;
  margin-bottom: 40rpx;
}

.scan-preview-img {
  width: 100%;
  height: 100%;
}

.scan-area {
  position: relative;
  height: 280rpx;
  background: var(--bg-white);
  border-radius: var(--radius-card-sm);
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow-card);
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, transparent, var(--secondary), transparent);
  box-shadow: 0 0 20rpx var(--secondary);
  animation: scanMove 2s linear infinite;
}

@keyframes scanMove {
  0% { top: 0; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

.scan-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(44, 200, 184, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(44, 200, 184, 0.05) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
}

.progress-section {
  margin-bottom: 32rpx;
}

.progress-bar {
  height: 16rpx;
  background: var(--bg-white);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-percent {
  font-weight: 700;
  color: var(--secondary-deep);
}

.tip-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--secondary);
  flex-shrink: 0;
}

.tip-dot.active {
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.5); opacity: 0.6; }
}

.tip-text {
  flex: 1;
}

.bottom-space {
  height: 200rpx;
}

.scanning-content {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scanning-illust {
  width: 600rpx;
  height: 400rpx;
  position: relative;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card);
  margin-bottom: 48rpx;
}

.corner {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border: 8rpx solid var(--secondary);
}

.corner-tl {
  top: 32rpx;
  left: 32rpx;
  border-right: none;
  border-bottom: none;
}

.corner-tr {
  top: 32rpx;
  right: 32rpx;
  border-left: none;
  border-bottom: none;
}

.corner-bl {
  bottom: 32rpx;
  left: 32rpx;
  border-right: none;
  border-top: none;
}

.corner-br {
  bottom: 32rpx;
  right: 32rpx;
  border-left: none;
  border-top: none;
}

.scan-paper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 480rpx;
  height: 280rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.paper-lines {
  padding: 20rpx;
}

.p-line {
  height: 4rpx;
  background: #E0E0E0;
  margin-bottom: 28rpx;
  border-radius: 2rpx;
}

.p-line.short {
  width: 60%;
}

.scanning-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-deep);
  margin-bottom: 16rpx;
  text-align: center;
}

.scanning-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.progress-wrap {
  width: 100%;
  max-width: 520rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  width: 100%;
  max-width: 520rpx;
  margin-top: 16rpx;
}

.progress-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--secondary-deep);
}

.progress-time {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.scan-steps {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-light);
  border: 4rpx solid var(--border-color);
  flex-shrink: 0;
}

.step-item.done .step-dot {
  background: var(--secondary);
  color: #FFFFFF;
  border-color: var(--secondary-deep);
}

.step-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.step-item.done .step-text {
  color: var(--text-deep);
  font-weight: 500;
}
