<view class="scanning-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">识别中</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="content-scroll" scroll-y>
    <view class="scanning-content">
      <view class="scanning-illust">
        <view class="corner corner-tl"></view>
        <view class="corner corner-tr"></view>
        <view class="corner corner-bl"></view>
        <view class="corner corner-br"></view>
        <view class="scan-paper">
          <view class="paper-lines">
            <view class="p-line"></view>
            <view class="p-line"></view>
            <view class="p-line short"></view>
            <view class="p-line"></view>
            <view class="p-line short"></view>
            <view class="p-line"></view>
          </view>
        </view>
      </view>

      <view class="scanning-title">试卷智能识别中...</view>
      <view class="scanning-subtitle">AI正在逐题分析您的试卷，请稍候</view>

      <view class="progress-wrap">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progress}}%;"></view>
        </view>
        <view class="progress-info">
          <text class="progress-num">{{progress}}%</text>
          <text class="progress-time">预计剩余 {{estimatedTime}} 秒</text>
        </view>
      </view>
    </view>

    <view class="scan-steps">
      <view class="step-item {{index <= currentStep ? 'done' : ''}}" wx:for="{{steps}}" wx:key="*this">
        <view class="step-dot">
          <text wx:if="{{index < currentStep}}">✓</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        <view class="step-text">{{item}}</view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
