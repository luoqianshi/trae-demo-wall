<view class="profile-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar with-logo">
    <view class="nav-left">
      <view class="nav-logo">K</view>
      <view>
        <text class="nav-title-text">我的</text>
        <text class="nav-en">KNOWA</text>
      </view>
    </view>
    <view class="nav-right">
      <text class="nav-icon">⚙</text>
    </view>
  </view>

  <view class="profile-header">
    <view class="user-info">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
        <view wx:if="{{userInfo.avatarUrl}}" class="avatar">
          <image src="{{userInfo.avatarUrl}}" mode="aspectFill" class="avatar-img"/>
        </view>
        <view wx:else class="avatar-placeholder">👤</view>
      </button>
      <view class="user-detail">
        <input class="nickname-input" type="nickname" placeholder="点击设置昵称" value="{{userInfo.nickName}}" bindinput="onNickNameInput" placeholder-class="nickname-placeholder"/>
        <view class="user-desc">三年级 · 数学</view>
      </view>
    </view>

    <view class="stats-row">
      <view class="stats-col">
        <view class="stats-value">28</view>
        <view class="stats-label">诊断次数</view>
      </view>
      <view class="stats-col">
        <view class="stats-value">156</view>
        <view class="stats-label">错题数</view>
      </view>
      <view class="stats-col">
        <view class="stats-value">230</view>
        <view class="stats-label">练习题</view>
      </view>
      <view class="stats-col">
        <view class="stats-value">89</view>
        <view class="stats-label">已掌握</view>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="name" bindtap="goToMenu" data-name="{{item.name}}">
      <view class="menu-left">
        <view class="menu-icon">{{item.icon}}</view>
        <view class="menu-text">
          <view class="menu-name">{{item.name}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
