.profile-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.status-bar {
  width: 100%;
}

.profile-header {
  background: linear-gradient(180deg, var(--bg-card-cream) 0%, transparent 100%);
  padding: 32rpx 40rpx 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-btn {
  width: 128rpx;
  height: 128rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #FFFFFF;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #FFFFFF;
}

.user-detail {
  flex: 1;
}

.nickname-input {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-deep);
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 32rpx;
  background: var(--bg-white);
  border-radius: var(--radius-card);
  padding: 32rpx 16rpx;
  box-shadow: var(--shadow-card);
}

.stats-col {
  text-align: center;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--text-deep);
}

.stats-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.menu-section {
  padding: 0 40rpx;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-item {
  background: var(--bg-white);
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
}

.menu-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 44rpx;
}

.menu-text {
  display: flex;
  flex-direction: column;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-deep);
}

.menu-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-light);
}
