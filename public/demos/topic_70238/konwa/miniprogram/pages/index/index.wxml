<!-- 首页 -->
<view class="home-page">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部导航 -->
  <view class="top-nav">
    <view class="nav-left">
      <view class="nav-logo">知</view>
      <view class="nav-title">知缺学堂 <text class="nav-en">KNOWA</text></view>
    </view>
    <view class="nav-icon">
      <view class="msg-icon">💬</view>
    </view>
  </view>

  <!-- 今日学情 -->
  <view class="greeting-section">
    <view class="greeting-title">今日学情</view>
    <view class="greeting-subtitle">AI诊断后生成个性化补弱任务</view>
  </view>

  <!-- 学习概览卡片 -->
  <view class="overview-card">
    <view class="overview-header">
      <view class="overview-title">学习概览</view>
      <view class="overview-more">
        <text>更多</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="overview-stats">
      <view class="stat-item">
        <view class="stat-label">今日掌握度</view>
        <view class="stat-value">{{overview.masteryRate}}<text class="unit">%</text></view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">待完成任务</view>
        <view class="stat-value">{{overview.pendingTasks}}<text class="unit">项</text></view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">已诊断错题</view>
        <view class="stat-value">{{overview.wrongCount}}<text class="unit">题</text></view>
      </view>
    </view>
  </view>

  <!-- 主按钮 -->
  <view class="main-btn-section">
    <view class="main-btn" bindtap="goToCamera">
      <view class="btn-left">
        <view class="btn-icon">
          <text class="iconfont">📷</text>
        </view>
        <view class="btn-text">
          <view class="btn-main-text">拍照识别试卷</view>
        </view>
      </view>
      <view class="btn-right" catchtap="goToAlbum">
        <view class="btn-album-icon">📁</view>
        <view class="btn-album-text">从相册选择</view>
      </view>
    </view>
  </view>

  <!-- 三功能卡片 -->
  <view class="feature-section">
    <view class="feature-grid">
      <view 
        class="feature-card" 
        wx:for="{{features}}" 
        wx:key="id"
        data-path="{{item.path}}"
        bindtap="goToFeature"
      >
        <view class="feature-badge {{item.badgeType}}">{{item.badge}}</view>
        <view class="feature-icon-wrap {{item.bgType}}">
          <text class="feature-icon-text">{{item.icon}}</text>
        </view>
        <view class="feature-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 最近诊断 -->
  <view class="history-section" wx:if="{{historyList.length > 0}}">
    <view class="section-header">
      <view class="section-title">最近诊断</view>
      <view class="section-more">查看全部 ›</view>
    </view>
    <view class="history-list">
      <view 
        class="history-item" 
        wx:for="{{historyList}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goToDetail"
      >
        <view class="history-subject {{item.subject}}">
          <text wx:if="{{item.subject === 'math'}}">数</text>
          <text wx:elif="{{item.subject === 'chinese'}}">语</text>
          <text wx:elif="{{item.subject === 'english'}}">英</text>
          <text wx:else>📚</text>
        </view>
        <view class="history-info">
          <view class="history-name">{{item.paperName}}</view>
          <view class="history-meta">{{item.date}} · {{item.wrongCount}}道错题</view>
        </view>
        <view class="history-score">
          <view class="score-num {{item.score >= 85 ? 'good' : item.score >= 70 ? 'mid' : 'bad'}}">{{item.score}}</view>
          <view class="score-label">得分</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-space"></view>
</view>
