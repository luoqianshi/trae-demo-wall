.home-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9EF 0%, #FFF5E6 100%);
  padding-bottom: 120rpx;
}

.status-bar {
  width: 100%;
}

/* 顶部导航 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 48rpx 40rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nav-logo {
  width: 64rpx;
  height: 64rpx;
  background: #2CC8B8;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 800;
  font-size: 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0A2463;
}

.nav-en {
  color: #2CC8B8;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-left: 8rpx;
}

.nav-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-icon {
  font-size: 44rpx;
}

/* 今日学情 */
.greeting-section {
  padding: 16rpx 48rpx 48rpx;
}

.greeting-title {
  font-size: 88rpx;
  font-weight: 900;
  color: #0A2463;
  line-height: 1.2;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.greeting-subtitle {
  font-size: 34rpx;
  color: #333333;
  font-weight: 500;
}

/* 学习概览卡片 */
.overview-card {
  margin: 0 40rpx;
  background: #FFFBF2;
  border-radius: 56rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 40rpx rgba(26, 91, 216, 0.06);
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.overview-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0A2463;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.overview-title::before {
  content: '';
  width: 10rpx;
  height: 44rpx;
  background: #2CC8B8;
  border-radius: 6rpx;
}

.overview-more {
  font-size: 28rpx;
  color: #999999;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.arrow {
  font-size: 32rpx;
}

.overview-stats {
  display: flex;
  align-items: center;
  position: relative;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: #F0E6D2;
  flex-shrink: 0;
}

.stat-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.stat-value {
  font-size: 68rpx;
  font-weight: 800;
  color: #0A2463;
  line-height: 1;
}

.stat-value .unit {
  font-size: 36rpx;
  font-weight: 700;
  margin-left: 4rpx;
}

/* 主按钮 */
.main-btn-section {
  padding: 48rpx 40rpx;
}

.main-btn {
  width: 100%;
  height: 220rpx;
  background: linear-gradient(135deg, #2CC8B8 0%, #19B5A6 100%);
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 72rpx;
  box-shadow: 0 12rpx 0 #179E90, 0 24rpx 64rpx rgba(44, 200, 184, 0.35);
  position: relative;
  overflow: hidden;
}

.main-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 100%);
}

.btn-left {
  display: flex;
  align-items: center;
  gap: 36rpx;
  position: relative;
  z-index: 1;
}

.btn-icon {
  width: 116rpx;
  height: 116rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.iconfont {
  font-size: 56rpx;
}

.btn-text {
  color: #FFFFFF;
}

.btn-main-text {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.btn-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 1;
  color: #FFFFFF;
}

.btn-album-icon {
  font-size: 64rpx;
  opacity: 0.95;
}

.btn-album-text {
  font-size: 26rpx;
  opacity: 0.9;
  font-weight: 500;
}

/* 三功能卡片 */
.feature-section {
  padding: 0 40rpx;
}

.feature-grid {
  display: flex;
  gap: 32rpx;
}

.feature-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 48rpx 24rpx 40rpx;
  text-align: center;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(26, 91, 216, 0.06);
}

.feature-badge {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  min-width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 16rpx;
}

.feature-badge.teal {
  background: #2CC8B8;
}

.feature-badge.orange {
  background: #FF8A33;
}

.feature-badge.blue {
  background: #5B8DEF;
}

.feature-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  margin: 12rpx auto 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-wrap.teal {
  background: linear-gradient(135deg, #E6F7F5 0%, #CCF0EC 100%);
}

.feature-icon-wrap.orange {
  background: linear-gradient(135deg, #FFF1E6 0%, #FFE0CC 100%);
}

.feature-icon-wrap.blue {
  background: linear-gradient(135deg, #E6EEFF 0%, #CCDCFF 100%);
}

.feature-icon-text {
  font-size: 60rpx;
}

.feature-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #0A2463;
  letter-spacing: 2rpx;
}

/* 历史记录 */
.history-section {
  margin: 48rpx 40rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0A2463;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(26, 91, 216, 0.04);
}

.history-subject {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 600;
  font-size: 26rpx;
  flex-shrink: 0;
}

.history-subject.math {
  background: linear-gradient(135deg, #5B8DEF, #1A5BD8);
}

.history-subject.chinese {
  background: linear-gradient(135deg, #FFA95C, #FF8A33);
}

.history-subject.english {
  background: linear-gradient(135deg, #4DD9CC, #2CC8B8);
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-meta {
  font-size: 24rpx;
  color: #999999;
}

.history-score {
  text-align: right;
  flex-shrink: 0;
}

.score-num {
  font-size: 36rpx;
  font-weight: 700;
}

.score-num.good {
  color: #2CC8B8;
}

.score-num.mid {
  color: #FF8A33;
}

.score-num.bad {
  color: #F55555;
}

.score-label {
  font-size: 22rpx;
  color: #999999;
}

.bottom-space {
  height: 40rpx;
}
