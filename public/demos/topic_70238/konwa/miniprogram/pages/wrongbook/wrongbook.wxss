.wrongbook-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.stats-card {
  display: flex;
  align-items: center;
  margin: 32rpx 40rpx;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card);
  padding: 40rpx;
  box-shadow: var(--shadow-card-cream);
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--text-deep);
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.stats-divider {
  width: 2rpx;
  height: 80rpx;
  background: var(--border-color);
}

.subject-tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 40rpx;
  overflow-x: auto;
  margin-bottom: 32rpx;
}

.subject-tab {
  padding: 16rpx 32rpx;
  background: var(--bg-white);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  flex-shrink: 0;
  box-shadow: var(--shadow-card);
}

.subject-tab.active {
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  color: #FFFFFF;
}

.action-row {
  padding: 0 40rpx;
  margin-bottom: 32rpx;
}

.practice-btn {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-btn);
}

.wrong-list-scroll {
  height: calc(100vh - 500rpx);
}

.wrong-list {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.wrong-item {
  background: var(--bg-white);
  border-radius: var(--radius-card);
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-card);
}

.wrong-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wrong-info {
  flex: 1;
}

.wrong-q {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
  margin-bottom: 8rpx;
}

.wrong-tags {
  display: flex;
  gap: 12rpx;
}

.kp-tag {
  padding: 8rpx 16rpx;
  background: #F0FBFA;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  color: var(--secondary-deep);
}

.wrong-arrow {
  font-size: 40rpx;
  color: var(--text-light);
}
