<view class="wrongbook-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar with-logo">
    <view class="nav-left">
      <view class="nav-logo">K</view>
      <view>
        <text class="nav-title-text">错题本</text>
        <text class="nav-en">KNOWA</text>
      </view>
    </view>
    <view class="nav-right">
      <text class="nav-icon">⚙</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stats-item">
      <view class="stats-num">{{totalWrong}}</view>
      <view class="stats-label">错题总数</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-num">{{mastered}}</view>
      <view class="stats-label">已掌握</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-num">{{toMaster}}</view>
      <view class="stats-label">待攻克</view>
    </view>
  </view>

  <view class="subject-tabs">
    <view class="subject-tab {{currentSubject === item ? 'active' : ''}}" wx:for="{{subjects}}" wx:key="*this" bindtap="switchSubject" data-subject="{{item}}">{{item}}</view>
  </view>

  <view class="action-row">
    <view class="practice-btn">开始错题练习</view>
  </view>

  <scroll-view class="wrong-list-scroll" scroll-y>
    <view class="wrong-list">
      <view class="wrong-item" wx:for="{{wrongList}}" wx:key="id">
        <view class="wrong-num">{{item.id}}</view>
        <view class="wrong-info">
          <view class="wrong-q">{{item.q}}</view>
          <view class="wrong-tags">
            <view class="kp-tag" wx:for="{{item.kps}}" wx:for-item="kp" wx:key="*this">{{kp}}</view>
          </view>
        </view>
        <view class="wrong-arrow">›</view>
      </view>
    </view>
  </scroll-view>
</view>
