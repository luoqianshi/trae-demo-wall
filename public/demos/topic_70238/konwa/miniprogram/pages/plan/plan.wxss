.plan-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  flex: 1;
  height: 0;
}

.plan-hero {
  padding: 32rpx 40rpx;
  background: var(--bg-card-cream);
  margin: 16rpx 40rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card-cream);
}

.plan-hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-deep);
  margin-bottom: 16rpx;
}

.plan-hero-main {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-deep);
  margin-bottom: 12rpx;
}

.plan-hero-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.plan-card {
  margin: 0 40rpx 24rpx;
  background: var(--bg-white);
  border-radius: var(--radius-card);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.plan-card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.plan-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.plan-card-icon.target {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF4757 100%);
}

.plan-card-icon.practice {
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
}

.plan-card-icon.schedule {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
}

.plan-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-deep);
}

.plan-card-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.target-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.target-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card-sm);
}

.target-kp {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
}

.target-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.target-from {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--danger);
}

.target-arrow {
  font-size: 24rpx;
  color: var(--text-light);
}

.target-to {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--secondary-deep);
}

.practice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.practice-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card-sm);
}

.practice-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--secondary);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.practice-info {
  flex: 1;
}

.practice-q {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
  margin-bottom: 8rpx;
}

.practice-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.practice-btn {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: var(--radius-btn);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 0 #179E90;
}

.practice-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 0 #179E90;
}

.schedule-timeline {
  position: relative;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.timeline-line {
  position: absolute;
  left: 10rpx;
  width: 4rpx;
  background: var(--border-color);
  top: 36rpx;
  bottom: 0;
}

.timeline-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.timeline-day {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-deep);
  margin-bottom: 8rpx;
}

.timeline-task {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.bottom-space {
  height: 200rpx;
}

.bottom-btn-wrap {
  padding: 24rpx 40rpx 32rpx;
}

.confirm-btn {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-btn);
}

.confirm-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #179E90, 0 8rpx 20rpx rgba(44, 200, 184, 0.3);
}
