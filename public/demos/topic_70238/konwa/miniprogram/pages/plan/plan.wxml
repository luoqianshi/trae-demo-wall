<view class="plan-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">补弱方案</view>
    <view class="nav-right">
      <text class="nav-icon">⭐</text>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y>
    <view class="plan-hero">
      <view class="plan-hero-title">专属补弱方案</view>
      <view class="plan-hero-main">{{plan.planName}}</view>
      <view class="plan-hero-desc">{{plan.planDesc}}</view>
    </view>

    <view class="plan-card">
      <view class="plan-card-header">
        <view class="plan-card-icon target">🎯</view>
        <view>
          <view class="plan-card-title">突破目标</view>
          <view class="plan-card-sub">{{plan.targets.length}}个核心薄弱知识点</view>
        </view>
      </view>
      <view class="target-list">
        <view class="target-item" wx:for="{{plan.targets}}" wx:key="name">
          <text class="target-kp">{{item.name}}</text>
          <view class="target-progress">
            <text class="target-from">{{item.current}}%</text>
            <text class="target-arrow">→</text>
            <text class="target-to">{{item.target}}%</text>
          </view>
        </view>
      </view>
    </view>

    <view class="plan-card">
      <view class="plan-card-header">
        <view class="plan-card-icon practice">📝</view>
        <view>
          <view class="plan-card-title">推荐练习题</view>
          <view class="plan-card-sub">精选 {{plan.practices.length}} 道针对性题目</view>
        </view>
      </view>
      <view class="practice-list">
        <view class="practice-item" wx:for="{{plan.practices}}" wx:key="id">
          <view class="practice-num">{{index + 1}}</view>
          <view class="practice-info">
            <view class="practice-q">{{item.q}}</view>
            <view class="practice-meta">{{item.kp}} · {{item.level}}</view>
          </view>
          <view class="practice-btn">练习</view>
        </view>
      </view>
    </view>

    <view class="plan-card">
      <view class="plan-card-header">
        <view class="plan-card-icon schedule">📅</view>
        <view>
          <view class="plan-card-title">复习时间线</view>
          <view class="plan-card-sub">科学安排，持续巩固</view>
        </view>
      </view>
      <view class="schedule-timeline">
        <view class="timeline-item" wx:for="{{plan.schedule}}" wx:key="day">
          <view class="timeline-dot" style="background: {{item.color}};"></view>
          <view wx:if="{{index < plan.schedule.length - 1}}" class="timeline-line"></view>
          <view class="timeline-content">
            <view class="timeline-day">{{item.day}}</view>
            <view class="timeline-task">{{item.task}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="bottom-btn-wrap">
    <view class="confirm-btn" bindtap="startPractice">开始补弱练习</view>
  </view>
</view>
