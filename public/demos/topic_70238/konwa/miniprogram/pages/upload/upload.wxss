.upload-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  flex: 1;
  height: 0;
}

.preview-section {
  padding: 16rpx 40rpx 0;
}

.preview-card {
  height: 560rpx;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-card-cream);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.placeholder-icon {
  font-size: 100rpx;
  opacity: 0.4;
}

.placeholder-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.corner-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: var(--warning);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-tag);
  z-index: 10;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 40rpx 0;
}

.action-btn {
  flex: 1;
  height: 104rpx;
  background: var(--bg-white);
  border-radius: var(--radius-card-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
  box-shadow: var(--shadow-card);
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
}

.selector-section {
  margin: 36rpx 40rpx 0;
  background: var(--bg-card-cream);
  border-radius: var(--radius-card);
  padding: 40rpx;
  box-shadow: var(--shadow-card-cream);
}

.selector-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-deep);
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.selector-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: var(--secondary);
  border-radius: 4rpx;
}

.grade-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grade-tag {
  padding: 16rpx 28rpx;
  background: var(--bg-white);
  border-radius: var(--radius-btn);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 4rpx solid transparent;
  font-weight: 500;
}

.grade-tag.active {
  background: var(--secondary);
  color: #FFFFFF;
  border-color: var(--secondary-deep);
  font-weight: 600;
}

.subject-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.subject-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 8rpx;
  border-radius: var(--radius-card-sm);
  background: var(--bg-white);
  border: 4rpx solid transparent;
}

.subject-item.active {
  border-color: var(--secondary);
  background: #F0FBFA;
}

.subject-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

.subject-name {
  font-size: 24rpx;
  color: var(--text-primary);
}

.subject-item.active .subject-name {
  color: var(--secondary-deep);
  font-weight: 600;
}

.bottom-space {
  height: 200rpx;
}

.confirm-btn {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-btn);
}

.confirm-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #179E90, 0 8rpx 20rpx rgba(44, 200, 184, 0.3);
}
