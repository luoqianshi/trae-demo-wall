<view class="upload-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">上传试卷</view>
    <view class="nav-right">
      <text class="nav-icon">📖</text>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y>
    <view class="preview-section">
      <view class="preview-card" bindtap="chooseImage">
        <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" class="preview-image"/>
        <view wx:else class="preview-placeholder">
          <text class="placeholder-icon">📷</text>
          <text class="placeholder-text">点击上传试卷照片</text>
        </view>
        <view wx:if="{{imagePath}}" class="corner-tag">待识别</view>
      </view>
    </view>

    <view class="action-buttons">
      <view class="action-btn" bindtap="takePhoto">
        <text class="action-icon">📸</text>
        <text class="action-text">拍照上传</text>
      </view>
      <view class="action-btn" bindtap="chooseFromAlbum">
        <text class="action-icon">🖼</text>
        <text class="action-text">相册选择</text>
      </view>
    </view>

    <view class="selector-section">
      <view class="selector-title">选择年级</view>
      <view class="grade-list">
        <view class="grade-tag {{grade === item ? 'active' : ''}}" wx:for="{{grades}}" wx:key="*this" bindtap="selectGrade" data-grade="{{item}}">{{item}}</view>
      </view>
    </view>

    <view class="selector-section">
      <view class="selector-title">选择科目</view>
      <view class="subject-grid">
        <view class="subject-item {{subject === item.name ? 'active' : ''}}" wx:for="{{subjects}}" wx:key="name" bindtap="selectSubject" data-subject="{{item.name}}">
          <view class="subject-icon" style="background: {{item.color}};">{{item.icon}}</view>
          <text class="subject-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="bottom-btn-wrap">
    <view class="confirm-btn" bindtap="startAnalyze">开始识别分析</view>
  </view>
</view>
