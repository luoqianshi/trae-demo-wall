.analysis-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  flex: 1;
  height: 0;
}

.analysis-card {
  margin: 24rpx 40rpx;
  background: var(--bg-white);
  border-radius: var(--radius-card);
  padding: 40rpx;
  box-shadow: var(--shadow-card);
}

.chart-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-deep);
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chart-title::before {
  content: '';
  width: 8rpx;
  height: 36rpx;
  background: var(--secondary);
  border-radius: 4rpx;
}

.radar-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
}

.radar-canvas {
  width: 600rpx;
  height: 600rpx;
}

.kp-ranking {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.kp-rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.kp-rank-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.kp-rank-num.n1 { background: linear-gradient(135deg, #FF6B6B 0%, #FF4757 100%); }
.kp-rank-num.n2 { background: linear-gradient(135deg, #FF8A33 0%, #FF6B00 100%); }
.kp-rank-num.n3 { background: linear-gradient(135deg, #FFC107 0%, #FFA000 100%); }
.kp-rank-num.n4, .kp-rank-num.n5 { background: var(--border-color); color: var(--text-secondary); }

.kp-rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
  width: 180rpx;
  flex-shrink: 0;
}

.kp-rank-bar {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.kp-rank-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.kp-rank-fill.low { background: linear-gradient(90deg, var(--danger) 0%, var(--warning) 100%); }
.kp-rank-fill.mid { background: linear-gradient(90deg, var(--warning) 0%, #FFC107 100%); }
.kp-rank-fill.ok { background: linear-gradient(90deg, var(--secondary) 0%, var(--secondary-deep) 100%); }

.kp-rank-pct {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-deep);
  width: 80rpx;
  text-align: right;
}

.reason-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reason-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.reason-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-deep);
  width: 180rpx;
  flex-shrink: 0;
}

.reason-bar {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.reason-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.reason-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-deep);
  width: 100rpx;
  text-align: right;
}

.bottom-space {
  height: 200rpx;
}

.bottom-btn-wrap {
  padding: 24rpx 40rpx 32rpx;
}

.confirm-btn {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-deep) 100%);
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-btn);
}

.confirm-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #179E90, 0 8rpx 20rpx rgba(44, 200, 184, 0.3);
}
