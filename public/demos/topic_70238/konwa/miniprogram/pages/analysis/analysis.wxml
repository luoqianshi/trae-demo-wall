<view class="analysis-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">学情分析</view>
    <view class="nav-right">
      <text class="nav-icon">📊</text>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y>
    <view class="analysis-card">
      <view class="chart-title">知识点掌握雷达图</view>
      <view class="radar-wrap">
        <canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas>
      </view>
    </view>

    <view class="analysis-card">
      <view class="chart-title">薄弱考点TOP5</view>
      <view class="kp-ranking">
        <view class="kp-rank-item" wx:for="{{weakPoints}}" wx:key="name">
          <view class="kp-rank-num n{{index + 1}}">{{index + 1}}</view>
          <text class="kp-rank-name">{{item.name}}</text>
          <view class="kp-rank-bar">
            <view class="kp-rank-fill {{item.mastery < 40 ? 'low' : item.mastery < 70 ? 'mid' : 'ok'}}" style="width: {{item.mastery}}%;"></view>
          </view>
          <text class="kp-rank-pct">{{item.mastery}}%</text>
        </view>
      </view>
    </view>

    <view class="analysis-card">
      <view class="chart-title">错误原因分布</view>
      <view class="reason-list">
        <view class="reason-item" wx:for="{{reasons}}" wx:key="name">
          <view class="reason-dot" style="background: {{item.color}};"></view>
          <text class="reason-name">{{item.name}}</text>
          <view class="reason-bar">
            <view class="reason-fill" style="width: {{item.percent}}%; background: {{item.color}};"></view>
          </view>
          <text class="reason-count">{{item.count}}题</text>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <view class="bottom-btn-wrap">
    <view class="confirm-btn" bindtap="goToPlan">生成补弱方案</view>
  </view>
</view>
