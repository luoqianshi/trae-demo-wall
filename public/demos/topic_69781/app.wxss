/* ========================================
   健身饮食助手 - 莫兰迪色系全局样式
   参考fit-diet-app设计风格
   ======================================== */

page {
  /* 莫兰迪色系 - Morandi Palette */
  --bg: #F2ECEE;
  --card-bg: #FFFFFF;
  --border: #E0DBE3;
  --muted: #E5E0E5;
  --muted-fg: #666666;
  --text-fg: #424242;
  --primary: #A6A6B2;
  --sage-green: #96AD93;
  --lavender: #B5B5C1;
  --accent-orange: #E3A37D;
  --accent-rose: #CC858E;
  --accent-pink: #D49790;
  --accent-yellow: #F0C8A0;
  --accent-green: #5E9C87;

  /* 圆角 */
  --radius-lg: 24rpx;
  --radius-md: 20rpx;
  --radius-sm: 16rpx;
  --radius-pill: 9999rpx;

  /* 阴影 */
  --shadow-card: 0 6rpx 20rpx rgba(0,0,0,0.06);
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);

  /* 全局样式 */
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text-fg);
  line-height: 1.6;
}

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 180rpx;
}

/* 内容区域 */
.content-area {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ===== 卡片系统 ===== */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: var(--shadow-card);
}

/* ===== 进度条 ===== */
.bar-bg {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--muted);
}

.bar-fill {
  height: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--primary), var(--sage-green));
  transition: width 0.3s ease;
}

.bar-fill-orange {
  background: linear-gradient(90deg, var(--accent-orange), var(--accent-yellow));
}

.bar-fill-protein {
  background: var(--sage-green);
}

.bar-fill-carb {
  background: var(--accent-orange);
}

.bar-fill-fat {
  background: var(--accent-rose);
}

/* ===== 宏量营养素网格 ===== */
.macro-grid {
  display: flex;
  gap: 16rpx;
}

.macro-box {
  flex: 1;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.macro-box.protein { background: rgba(150, 173, 147, 0.2); }
.macro-box.carb { background: rgba(228, 163, 125, 0.2); }
.macro-box.fat { background: rgba(212, 152, 143, 0.2); }

.macro-box .name {
  font-size: 22rpx;
  color: var(--muted-fg);
}

.macro-box .value {
  font-size: 26rpx;
  font-weight: 600;
}

.macro-box.protein .value { color: var(--sage-green); }
.macro-box.carb .value { color: var(--accent-orange); }
.macro-box.fat .value { color: var(--accent-rose); }

/* ===== 快捷操作按钮 ===== */
.quick-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform 0.2s;
}

.action-btn:active { transform: scale(0.96); }

.action-btn.meal { background: rgba(150, 173, 147, 0.15); }
.action-btn.exercise { background: rgba(181, 181, 193, 0.15); }
.action-btn.recipe { background: rgba(228, 163, 125, 0.15); }

.action-btn .icon-circle {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.action-btn .label {
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.meal .label { color: var(--sage-green); }
.action-btn.exercise .label { color: var(--lavender); }
.action-btn.recipe .label { color: var(--accent-orange); }

/* ===== 餐食列表 ===== */
.meal-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meal-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg);
  transition: transform 0.2s;
}

.meal-item:active { transform: scale(0.98); }

.meal-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.meal-icon-wrap.bf { background: rgba(240, 200, 160, 0.3); }
.meal-icon-wrap.lunch { background: rgba(150, 173, 147, 0.3); }
.meal-icon-wrap.dinner { background: rgba(181, 181, 193, 0.3); }

.meal-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.meal-info .name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-fg);
}

.meal-info .detail {
  font-size: 22rpx;
  color: var(--muted-fg);
}

.meal-cal {
  font-size: 26rpx;
  font-weight: 600;
}

.meal-cal.bf { color: var(--accent-yellow); }
.meal-cal.lunch { color: var(--sage-green); }
.meal-cal.dinner { color: var(--lavender); }

/* ===== 标签系统 ===== */
.badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 600;
}

.badge.fat { background: rgba(150,173,147,0.2); color: var(--sage-green); }
.badge.muscle { background: rgba(228,163,125,0.2); color: var(--accent-orange); }
.badge.sugar { background: rgba(181,181,193,0.2); color: var(--lavender); }
.badge.special { background: rgba(212,152,143,0.2); color: var(--accent-rose); }

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 24rpx;
  gap: 16rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg);
}

.search-bar .search-icon {
  font-size: 32rpx;
  color: var(--muted-fg);
}

.search-bar input {
  flex: 1;
  border: none;
  background: none;
  font-size: 28rpx;
  color: var(--text-fg);
}

/* ===== 分段选择器 ===== */
.seg-item {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 0.2s;
}

.seg-item:active { transform: scale(0.96); }

.seg-item.bf { background: rgba(228, 163, 125, 0.4); color: var(--accent-orange); }
.seg-item.lunch { background: rgba(150, 173, 147, 0.4); color: var(--sage-green); }
.seg-item.dinner { background: rgba(181, 181, 193, 0.4); color: var(--lavender); }
.seg-item.snack { background: rgba(212, 152, 143, 0.4); color: var(--accent-rose); }

.seg-item.active {
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  transform: scale(1.02);
}

/* ===== 食物条目 ===== */
.food-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  gap: 20rpx;
  border-radius: var(--radius-sm);
  background: rgba(228, 163, 125, 0.1);
}

.food-item .name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-fg);
  flex: 1;
}

.food-item .gram {
  font-size: 24rpx;
  color: var(--muted-fg);
}

.food-item .cal {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent-orange);
}

/* ===== 营养对比行 ===== */
.nc-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nc-row .nc-label {
  font-size: 24rpx;
  color: var(--muted-fg);
  width: 100rpx;
}

.nc-row .bar-bg { flex: 1; }

.nc-row .nc-val {
  font-size: 22rpx;
  font-weight: 500;
  min-width: 120rpx;
  text-align: right;
}

.nc-row .nc-val.protein { color: var(--sage-green); }
.nc-row .nc-val.carb { color: var(--accent-orange); }
.nc-row .nc-val.fat { color: var(--accent-rose); }

/* ===== 分类Tab ===== */
.category-tabs {
  display: flex;
  gap: 16rpx;
}

.cat-item {
  flex: 1;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 0.2s;
}

.cat-item:active { transform: scale(0.96); }

.cat-item.fat-loss { background: rgba(150, 173, 147, 0.6); color: var(--sage-green); }
.cat-item.muscle { background: rgba(228, 163, 125, 0.6); color: var(--accent-orange); }
.cat-item.sugar { background: rgba(181, 181, 193, 0.6); color: var(--lavender); }
.cat-item.special { background: rgba(212, 152, 143, 0.6); color: var(--accent-rose); }

.cat-item.active {
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

/* ===== 食谱卡片 ===== */
.recipe-grid {
  display: flex;
  gap: 20rpx;
}

.recipe-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-radius: var(--radius-lg);
  background: var(--card-bg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: transform 0.2s;
}

.recipe-card:active { transform: scale(0.97); }

.recipe-img {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.recipe-img.sage { background: linear-gradient(135deg, var(--sage-green), #C6D1C4); }
.recipe-img.orange { background: linear-gradient(135deg, var(--accent-orange), #E8C8B2); }
.recipe-img.lavender { background: linear-gradient(135deg, var(--lavender), #CCC4D0); }
.recipe-img.rose { background: linear-gradient(135deg, var(--accent-rose), #E0C0C0); }

.recipe-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-fg);
}

.recipe-info {
  font-size: 22rpx;
  color: var(--muted-fg);
}

/* ===== 运动类型 ===== */
.ex-type-grid {
  display: flex;
  gap: 16rpx;
}

.ex-type-item {
  flex: 1;
  padding: 28rpx;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 36rpx;
  transition: transform 0.2s;
}

.ex-type-item:active { transform: scale(0.96); }

.ex-type-item.cardio { background: rgba(212,152,143,0.15); }
.ex-type-item.strength { background: rgba(181,181,193,0.15); }
.ex-type-item.hiit { background: rgba(228,163,125,0.15); }

.ex-type-item .type-label {
  font-size: 24rpx;
  font-weight: 500;
}

.ex-type-item.cardio .type-label { color: var(--accent-rose); }
.ex-type-item.strength .type-label { color: var(--lavender); }
.ex-type-item.hiit .type-label { color: var(--accent-orange); }

/* ===== 运动记录条目 ===== */
.ex-log-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg);
}

.ex-log-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.ex-log-icon.cardio { background: rgba(212,152,143,0.3); }
.ex-log-icon.strength { background: rgba(181,181,193,0.3); }

.ex-log-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.ex-log-info .name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-fg);
}

.ex-log-info .detail {
  font-size: 22rpx;
  color: var(--muted-fg);
}

.ex-log-cal {
  font-size: 28rpx;
  font-weight: 600;
}

.ex-log-cal.cardio { color: var(--accent-rose); }
.ex-log-cal.strength { color: var(--lavender); }

/* ===== 提示卡片 ===== */
.tip-card {
  padding: 28rpx;
  border-radius: var(--radius-md);
  background: rgba(150,173,147,0.12);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-card .tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sage-green);
}

.tip-card .tip-desc {
  font-size: 24rpx;
  color: var(--text-fg);
  line-height: 1.5;
}

/* ===== 通用标题 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-fg);
}

.section-subtitle {
  font-size: 26rpx;
  color: var(--muted-fg);
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--muted-fg);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

/* ===== 动画 ===== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease;
}
