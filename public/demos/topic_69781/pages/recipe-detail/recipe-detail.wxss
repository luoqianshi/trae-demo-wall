/* 食谱详情页面 - 莫兰迪色系 */
.recipe-detail-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding-bottom: 160rpx;
}

/* 食谱大图区域 */
.recipe-hero {
  position: relative;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 480rpx;
}

.hero-fallback {
  width: 100%;
  height: 480rpx;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx;
  background: rgba(0, 0, 0, 0.4);
}

.recipe-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 营养卡片 */
.nutrition-card {
  margin: 0 32rpx 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4E5969;
}

.servings-info {
  color: #A6A6B2;
  font-size: 26rpx;
}

.copy-btn {
  color: #96AD93;
  font-size: 26rpx;
  font-weight: 500;
}

.nutrition-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.nutrition-item {
  background: #F2ECEE;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
}

.nutrition-item.highlight {
  background: #E3A37D;
  width: 100%;
}

.nutrition-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4E5969;
  margin-bottom: 4rpx;
}

.nutrition-item.highlight .nutrition-value {
  color: #FFFFFF;
  font-size: 44rpx;
}

.nutrition-unit {
  display: block;
  font-size: 22rpx;
  color: #A6A6B2;
  margin-bottom: 4rpx;
}

.nutrition-item.highlight .nutrition-unit {
  color: rgba(255, 255, 255, 0.9);
}

.nutrition-label {
  display: block;
  font-size: 24rpx;
  color: #A6A6B2;
}

.nutrition-item.highlight .nutrition-label {
  color: rgba(255, 255, 255, 0.9);
}

.nutrition-value.protein {
  color: #96AD93;
}

.nutrition-value.carb {
  color: #E3A37D;
}

.nutrition-value.fat {
  color: #CC858E;
}

.time-info {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E0DBE3;
}

.time-item {
  font-size: 26rpx;
  color: #4E5969;
}

/* 卡片通用样式 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(166, 166, 178, 0.08);
}

/* 配料清单 */
.ingredients-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2ECEE;
}

.ingredient-item:last-child {
  border-bottom: none;
}

.ingredient-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #96AD93;
  border-radius: 50%;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.ingredient-info {
  flex: 1;
}

.ingredient-name {
  display: block;
  font-size: 29rpx;
  font-weight: 500;
  color: #4E5969;
  margin-bottom: 4rpx;
}

.ingredient-amount {
  font-size: 26rpx;
  color: #96AD93;
  font-weight: 600;
  margin-right: 12rpx;
}

.ingredient-note {
  font-size: 24rpx;
  color: #A6A6B2;
}

/* 制作步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.step-item {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.step-number-wrapper {
  width: 56rpx;
  height: 56rpx;
  background: #96AD93;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-number {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

.step-content {
  flex: 1;
  padding-top: 8rpx;
}

.step-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4E5969;
  margin-bottom: 8rpx;
}

.step-time {
  display: inline-block;
  font-size: 24rpx;
  color: #E3A37D;
  background: rgba(227, 163, 125, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

/* 小贴士 */
.tips-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-left: 4rpx solid #96AD93;
}

.tips-icon {
  font-size: 32rpx;
  color: #96AD93;
  font-weight: 700;
  flex-shrink: 0;
}

.tips-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.8;
  color: #4E5969;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(166, 166, 178, 0.08);
  z-index: 100;
}

.collect-btn,
.diet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.collect-btn {
  background: #F2ECEE;
  color: #4E5969;
}

.collect-btn.collected {
  background: #CC858E;
  color: #FFFFFF;
}

.diet-btn {
  background: #96AD93;
  color: #FFFFFF;
}

.collect-btn::after,
.diet-btn::after {
  border: none;
}
