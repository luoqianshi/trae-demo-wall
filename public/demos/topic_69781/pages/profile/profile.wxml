<!-- 我的档案 - 莫兰迪风格 -->
<view class="profile-page">
  <!-- 用户信息区 -->
  <view class="profile-header-section">
    <!-- 未登录状态 -->
    <block wx:if="{{!isLoggedIn}}">
      <view class="avatar-circle" bindtap="onTapLogin">
        <text class="avatar-text-login">登</text>
      </view>
      <view class="user-meta" bindtap="onTapLogin">
        <text class="login-tip">点击登录</text>
        <text class="login-sub">授权微信信息，开启个性化体验</text>
      </view>
    </block>
    <!-- 已登录状态 -->
    <block wx:else>
      <view class="avatar-circle">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="avatar-text">登</text>
        </button>
      </view>
      <view class="user-meta">
        <input class="nickname-input" type="nickname" placeholder="点击设置昵称" value="{{userInfo.nickName}}" bindinput="onNicknameInput" bindconfirm="onNicknameConfirm"/>
        <view class="goal-tag">
          <text class="goal-tag-text">{{fitnessGoal}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 我的社区卡片 -->
  <view class="card community-card">
    <view class="card-header">
      <text class="card-title">我的社区</text>
    </view>
    <view class="community-menu">
      <view
        wx:for="{{communityMenu}}"
        wx:key="key"
        class="community-menu-item"
        bindtap="onCommunityMenuTap"
        data-key="{{item.key}}"
      >
        <view class="community-menu-icon" style="background: {{item.color}}20">
          <text class="community-menu-emoji">{{item.icon}}</text>
        </view>
        <text class="community-menu-label">{{item.label}}</text>
        <text class="community-menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 身体数据卡片 -->
  <view class="card data-card">
    <view class="card-header">
      <text class="card-title">身体数据</text>
      <text class="edit-link" bindtap="onEdit" data-field="height">编辑</text>
    </view>
    <view class="data-grid">
      <view class="data-item" bindtap="onEdit" data-field="height">
        <text class="data-label">身高</text>
        <text class="data-value">{{bodyData.height}}<text class="data-unit">cm</text></text>
      </view>
      <view class="data-item" bindtap="onEdit" data-field="weight">
        <text class="data-label">体重</text>
        <text class="data-value">{{bodyData.weight}}<text class="data-unit">kg</text></text>
      </view>
      <view class="data-item" bindtap="onEdit" data-field="age">
        <text class="data-label">年龄</text>
        <text class="data-value">{{bodyData.age}}<text class="data-unit">岁</text></text>
      </view>
      <view class="data-item" bindtap="onEdit" data-field="gender">
        <text class="data-label">性别</text>
        <text class="data-value">{{bodyData.gender}}</text>
      </view>
    </view>
  </view>

  <!-- 健身目标卡片 -->
  <view class="card goals-card">
    <view class="card-header">
      <text class="card-title">健身目标</text>
    </view>
    <view class="goals-grid">
      <view
        wx:for="{{goals}}"
        wx:key="value"
        class="goal-item goal-{{item.value}} {{fitnessGoalValue === item.value ? 'active' : ''}}"
        bindtap="selectGoal"
        data-goal="{{item.value}}"
      >
        <view class="goal-icon-wrap">
          <text wx:if="{{item.value === 'loseFat'}}">🔥</text>
          <text wx:elif="{{item.value === 'gainMuscle'}}">💪</text>
          <text wx:elif="{{item.value === 'maintain'}}">⚖️</text>
          <text wx:else>🩺</text>
        </view>
        <text class="goal-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 营养目标卡片 -->
  <view class="card nutrition-card">
    <view class="card-header">
      <text class="card-title">每日营养目标</text>
    </view>
    <text class="card-subtitle">基于您的身体数据和目标自动计算</text>
    <view class="nutrition-list">
      <view class="nutrition-item calories-item">
        <view class="nutrition-left">
          <text class="nutrition-label">每日热量</text>
          <text class="nutrition-value">{{nutritionTargets.calories}}<text class="nutrition-unit"> kcal</text></text>
        </view>
        <view class="nutrition-bar-wrap">
          <view class="nutrition-bar-bg">
            <view class="nutrition-bar-fill sage" style="width: {{nutritionProgress.calories}}%"></view>
          </view>
        </view>
      </view>
      <view class="nutrition-item protein-item">
        <view class="nutrition-left">
          <text class="nutrition-label">蛋白质</text>
          <text class="nutrition-value">{{nutritionTargets.protein}}<text class="nutrition-unit"> g</text></text>
        </view>
        <view class="nutrition-bar-wrap">
          <view class="nutrition-bar-bg">
            <view class="nutrition-bar-fill rose" style="width: {{nutritionProgress.protein}}%"></view>
          </view>
        </view>
      </view>
      <view class="nutrition-item carbs-item">
        <view class="nutrition-left">
          <text class="nutrition-label">碳水</text>
          <text class="nutrition-value">{{nutritionTargets.carbs}}<text class="nutrition-unit"> g</text></text>
        </view>
        <view class="nutrition-bar-wrap">
          <view class="nutrition-bar-bg">
            <view class="nutrition-bar-fill orange" style="width: {{nutritionProgress.carbs}}%"></view>
          </view>
        </view>
      </view>
      <view class="nutrition-item fat-item">
        <view class="nutrition-left">
          <text class="nutrition-label">脂肪</text>
          <text class="nutrition-value">{{nutritionTargets.fat}}<text class="nutrition-unit"> g</text></text>
        </view>
        <view class="nutrition-bar-wrap">
          <view class="nutrition-bar-bg">
            <view class="nutrition-bar-fill lavender" style="width: {{nutritionProgress.fat}}%"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 体重记录 -->
  <view class="card weight-card">
    <view class="card-header">
      <text class="card-title">体重记录</text>
      <view class="add-weight-btn" bindtap="showAddWeight">
        <text class="add-weight-icon">+</text>
        <text class="add-weight-text">记录</text>
      </view>
    </view>
    <view class="weight-list" wx:if="{{weightRecords.length > 0}}">
      <view class="weight-item" wx:for="{{weightRecords}}" wx:key="date">
        <view class="timeline-dot"></view>
        <view class="timeline-line" wx:if="{{index < weightRecords.length - 1}}"></view>
        <view class="weight-content">
          <view class="weight-main">
            <text class="weight-value">{{item.weight}} kg</text>
            <text class="weight-date">{{item.date}}</text>
          </view>
          <view class="weight-actions">
            <view class="weight-trend">
              <text class="trend-icon" wx:if="{{index < weightRecords.length - 1 && item.weight < weightRecords[index + 1].weight}}">↓</text>
              <text class="trend-icon up" wx:elif="{{index < weightRecords.length - 1 && item.weight > weightRecords[index + 1].weight}}">↑</text>
              <text class="trend-icon stable" wx:elif="{{index < weightRecords.length - 1}}">→</text>
            </view>
            <text class="delete-btn" bindtap="deleteWeightRecord" data-index="{{index}}">删除</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无体重记录</text>
      <text class="empty-tip">点击上方按钮开始记录</text>
    </view>
  </view>

  <!-- 退出登录按钮（仅登录状态显示） -->
  <view class="logout-wrap" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onEditCancel"></view>
  <view class="modal-content" wx:if="{{showEditModal}}">
    <view class="modal-header">
      <text class="modal-title">修改{{editField === 'height' ? '身高' : editField === 'weight' ? '体重' : editField === 'age' ? '年龄' : editField === 'gender' ? '性别' : '活动水平'}}</text>
    </view>
    <input
      class="modal-input"
      type="text"
      value="{{editValue}}"
      bindinput="onEditInput"
      placeholder="请输入新值"
      focus="{{showEditModal}}"
    />
    <view class="modal-actions">
      <button class="modal-btn cancel" bindtap="onEditCancel">取消</button>
      <button class="modal-btn confirm" bindtap="onEditConfirm">确定</button>
    </view>
  </view>

  <!-- 添加体重弹窗 -->
  <view class="modal-mask" wx:if="{{showWeightModal}}" bindtap="cancelAddWeight"></view>
  <view class="modal-content" wx:if="{{showWeightModal}}">
    <view class="modal-header">
      <text class="modal-title">记录今日体重</text>
    </view>
    <input
      class="modal-input"
      type="digit"
      value="{{newWeight}}"
      bindinput="onWeightInput"
      placeholder="请输入体重(kg)"
      focus="{{showWeightModal}}"
    />
    <view class="modal-actions">
      <button class="modal-btn cancel" bindtap="cancelAddWeight">取消</button>
      <button class="modal-btn confirm" bindtap="addWeightRecord">确定</button>
    </view>
  </view>

  <!-- 微信登录弹窗 -->
  <view class="modal-mask" wx:if="{{showLoginModal}}" bindtap="hideLoginModal"></view>
  <view class="login-modal" wx:if="{{showLoginModal}}">
    <view class="modal-header">
      <text class="modal-title">微信登录</text>
      <text class="close-btn" bindtap="hideLoginModal">✕</text>
    </view>
    <view class="login-modal-body">
      <text class="login-desc">授权微信信息，获取个性化体验</text>
      <!-- 头像选择 -->
      <view class="login-field">
        <text class="login-label">选择头像</text>
        <button class="login-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onLoginChooseAvatar">
          <image wx:if="{{userInfo.avatarUrl}}" class="login-avatar-preview" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="login-avatar-placeholder">
            <text class="login-avatar-plus">+</text>
          </view>
        </button>
      </view>
      <!-- 昵称输入 -->
      <view class="login-field">
        <text class="login-label">输入昵称</text>
        <input class="login-nickname-input" type="nickname" placeholder="请输入昵称" value="{{userInfo.nickName}}" bindinput="onLoginNicknameInput" focus="{{showLoginModal}}" />
      </view>
    </view>
    <view class="login-modal-footer">
      <button class="login-confirm-btn" bindtap="onLoginConfirm">授权并登录</button>
    </view>
  </view>
</view>
