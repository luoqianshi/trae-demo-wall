/* 我的档案页面 - 莫兰迪风格 */
.profile-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding: 32rpx 32rpx 140rpx;
}

/* 用户信息区 */
.profile-header-section {
  display: flex;
  align-items: center;
  padding: 32rpx 0 40rpx;
}

.avatar-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #B5B5C1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 100%;
  height: 100%;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(181, 181, 193, 0.3);
}

.avatar-text {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #B5B5C1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 未登录状态头像 */
.avatar-text-login {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 点击登录提示 */
.login-tip {
  font-size: 36rpx;
  font-weight: 600;
  color: #A6A6B2;
}

.login-sub {
  font-size: 24rpx;
  color: #B5B5C1;
  margin-top: 4rpx;
  display: block;
}

/* ========== 微信登录弹窗 ========== */
.login-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  padding: 40rpx 32rpx 60rpx;
  box-shadow: 0 -8rpx 32rpx rgba(166, 166, 178, 0.2);
}

.login-modal-body {
  padding: 24rpx 0;
}

.login-desc {
  font-size: 28rpx;
  color: #A6A6B2;
  display: block;
  margin-bottom: 32rpx;
}

.login-field {
  margin-bottom: 28rpx;
}

.login-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4E5969;
  display: block;
  margin-bottom: 16rpx;
}

.login-avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F2ECEE;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.login-avatar-btn::after {
  border: none;
}

.login-avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.login-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-avatar-plus {
  font-size: 48rpx;
  color: #B5B5C1;
}

.login-nickname-input {
  width: 100%;
  height: 88rpx;
  background: #F2ECEE;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #4E5969;
  box-sizing: border-box;
}

.login-modal-footer {
  padding-top: 16rpx;
}

.login-confirm-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #96AD93 0%, #A6C4A0 100%);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(150, 173, 147, 0.3);
}

.login-confirm-btn::after {
  border: none;
}

.login-confirm-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.user-meta {
  flex: 1;
}

.nickname-input {
  color: #4A4A5A;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  background: transparent;
}

.goal-tag {
  display: flex;
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  background: rgba(150, 173, 147, 0.15);
  border-radius: 24rpx;
}

.goal-tag-text {
  font-size: 24rpx;
  color: #96AD93;
  font-weight: 600;
}

/* 我的社区卡片 */
.community-card {
  padding-bottom: 12rpx;
}

.community-menu {
  display: flex;
  flex-direction: column;
}

.community-menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 2rpx solid rgba(166, 166, 178, 0.1);
  transition: background 0.2s ease;
}

.community-menu-item:last-child {
  border-bottom: none;
}

.community-menu-item:active {
  background: rgba(150, 173, 147, 0.06);
}

.community-menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.community-menu-emoji {
  font-size: 36rpx;
}

.community-menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #4A4A5A;
  font-weight: 500;
}

.community-menu-arrow {
  font-size: 32rpx;
  color: #A6A6B2;
  font-weight: 300;
}

/* 退出登录按钮 */
.logout-wrap {
  margin-top: 16rpx;
  margin-bottom: 40rpx;
  padding: 0 16rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #CC858E;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(166, 166, 178, 0.08);
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: rgba(204, 133, 142, 0.08);
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(166, 166, 178, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A5A;
}

.card-subtitle {
  display: block;
  font-size: 24rpx;
  color: #A6A6B2;
  margin-bottom: 24rpx;
  margin-top: -12rpx;
}

.edit-link {
  font-size: 26rpx;
  color: #96AD93;
  font-weight: 500;
  padding: 4rpx 16rpx;
}

/* 身体数据网格 */
.data-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.data-item {
  background: #FAF7F9;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.data-item:active {
  background: rgba(150, 173, 147, 0.08);
}

.data-label {
  display: block;
  font-size: 24rpx;
  color: #A6A6B2;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.data-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #4A4A5A;
  line-height: 1.2;
}

.data-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: #A6A6B2;
  margin-left: 4rpx;
}

/* 健身目标 */
.goals-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.goal-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

/* 减脂 - 玫瑰色 */
.goal-loseFat {
  background: rgba(204, 133, 142, 0.1);
}

.goal-loseFat.active {
  background: rgba(204, 133, 142, 0.2);
  border-color: #CC858E;
}

/* 增肌 - 鼠尾草绿 */
.goal-gainMuscle {
  background: rgba(150, 173, 147, 0.1);
}

.goal-gainMuscle.active {
  background: rgba(150, 173, 147, 0.2);
  border-color: #96AD93;
}

/* 维持 - 薰衣草 */
.goal-maintain {
  background: rgba(181, 181, 193, 0.1);
}

.goal-maintain.active {
  background: rgba(181, 181, 193, 0.2);
  border-color: #B5B5C1;
}

/* 控糖 - 橙色 */
.goal-controlSugar {
  background: rgba(227, 163, 125, 0.1);
}

.goal-controlSugar.active {
  background: rgba(227, 163, 125, 0.2);
  border-color: #E3A37D;
}

.goal-icon-wrap {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.goal-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A4A5A;
}

.goal-item.active .goal-text {
  color: #4A4A5A;
  font-weight: 700;
}

/* 营养目标 */
.nutrition-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nutrition-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FAF7F9;
  border-radius: 16rpx;
}

.nutrition-left {
  flex: 1;
  margin-right: 24rpx;
}

.nutrition-label {
  display: block;
  font-size: 24rpx;
  color: #A6A6B2;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.nutrition-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A5A;
}

.nutrition-unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #A6A6B2;
  margin-left: 4rpx;
}

.nutrition-bar-wrap {
  width: 200rpx;
  flex-shrink: 0;
}

.nutrition-bar-bg {
  width: 100%;
  height: 12rpx;
  background: rgba(166, 166, 178, 0.15);
  border-radius: 6rpx;
  overflow: hidden;
}

.nutrition-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.nutrition-bar-fill.sage {
  background: linear-gradient(90deg, #A6A6B2, #96AD93);
}

.nutrition-bar-fill.rose {
  background: linear-gradient(90deg, #A6A6B2, #CC858E);
}

.nutrition-bar-fill.orange {
  background: linear-gradient(90deg, #A6A6B2, #E3A37D);
}

.nutrition-bar-fill.lavender {
  background: linear-gradient(90deg, #A6A6B2, #B5B5C1);
}

/* 体重记录 */
.weight-card {
  padding-bottom: 32rpx;
}

.add-weight-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(150, 173, 147, 0.15);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}

.add-weight-icon {
  font-size: 30rpx;
  font-weight: 700;
  color: #96AD93;
}

.add-weight-text {
  font-size: 24rpx;
  color: #96AD93;
  font-weight: 600;
}

.weight-list {
  margin-top: 8rpx;
}

.weight-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-left: 48rpx;
  margin-bottom: 24rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  background: #96AD93;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(150, 173, 147, 0.15);
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  width: 2rpx;
  height: calc(100% + 24rpx);
  background: linear-gradient(180deg, #96AD93, rgba(150, 173, 147, 0.2));
  z-index: 1;
}

.weight-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FAF7F9;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-left: 16rpx;
}

.weight-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.weight-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A4A5A;
}

.weight-date {
  font-size: 24rpx;
  color: #A6A6B2;
}

.weight-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.weight-trend {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(150, 173, 147, 0.12);
}

.trend-icon {
  font-size: 28rpx;
  color: #96AD93;
  font-weight: 700;
}

.trend-icon.up {
  color: #CC858E;
}

.trend-icon.stable {
  color: #A6A6B2;
}

.delete-btn {
  font-size: 22rpx;
  color: #CC858E;
  padding: 6rpx 16rpx;
  background: rgba(204, 133, 142, 0.1);
  border-radius: 12rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #4A4A5A;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #A6A6B2;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 74, 90, 0.4);
  z-index: 999;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  z-index: 1000;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(166, 166, 178, 0.2);
}

.modal-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A4A5A;
}

.modal-input {
  width: 100%;
  height: 96rpx;
  background: #FAF7F9;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: #4A4A5A;
  margin-bottom: 36rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(166, 166, 178, 0.2);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.modal-btn.cancel {
  background: #F2ECEE;
  color: #7A7A8A;
}

.modal-btn.confirm {
  background: #96AD93;
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(150, 173, 147, 0.3);
}

.modal-btn::after {
  border: none;
}
