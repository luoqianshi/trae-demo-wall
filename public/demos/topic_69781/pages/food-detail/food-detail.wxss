/* 食材详情页面 */
.food-detail-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 24rpx 32rpx 180rpx;
}

/* 食材头部信息 */
.food-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #00C853 0%, #69F0AE 100%);
  margin-bottom: 24rpx;
}

.food-icon {
  font-size: 80rpx;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  margin-right: 32rpx;
}

.food-basic {
  flex: 1;
}

.food-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.food-category {
  display: inline-block;
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}

.copy-btn {
  color: #00C853;
  font-size: 26rpx;
  font-weight: 500;
}

/* 营养成分表格 */
.nutrition-table {
  border-radius: 12rpx;
  overflow: hidden;
}

.nutrition-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.nutrition-row:last-child {
  border-bottom: none;
}

.header-row {
  background: #F7F8FA;
  font-size: 26rpx;
  font-weight: 600;
  color: #86909C;
}

.highlight-row {
  background: linear-gradient(135deg, rgba(255, 107, 53, 0.08) 0%, rgba(255, 138, 80, 0.08) 100%);
}

.nutrient-label {
  flex: 2;
  font-size: 28rpx;
  color: #4E5969;
}

.nutrient-value {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  font-weight: 700;
  color: #1D2129;
}

.nutrient-value.primary {
  color: #FF6B35;
  font-size: 36rpx;
}

.nutrient-value.protein {
  color: #00C853;
}

.nutrient-value.carb {
  color: #FFA940;
}

.nutrient-value.fat {
  color: #FF6B35;
}

.nutrient-unit {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #86909C;
}

/* GI卡片 */
.gi-card {
  text-align: center;
}

.gi-display {
  margin-bottom: 28rpx;
}

.gi-value {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.gi-value.low {
  color: #00C853;
}

.gi-value.medium {
  color: #FFA940;
}

.gi-value.high {
  color: #FF6B35;
}

.gi-level {
  display: block;
  font-size: 28rpx;
  color: #86909C;
  font-weight: 500;
}

.gi-scale {
  margin-top: 24rpx;
}

.scale-bar {
  height: 16rpx;
  background: linear-gradient(to right, #00C853 0%, #00C853 55%, #FFA940 55%, #FFA940 70%, #FF6B35 70%, #FF6B35 100%);
  border-radius: 8rpx;
  position: relative;
  overflow: hidden;
}

.scale-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8rpx;
}

.scale-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #86909C;
}

/* 重量换算 */
.conversion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.conversion-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.conversion-unit {
  font-size: 28rpx;
  color: #4E5969;
  font-weight: 500;
}

.conversion-weight {
  font-size: 30rpx;
  color: #00C853;
  font-weight: 700;
}

/* 描述文字 */
.description-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #4E5969;
  margin-bottom: 28rpx;
}

/* 益处列表 */
.benefits-section {
  margin-bottom: 28rpx;
}

.benefits-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}

.benefits-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.benefit-bullet {
  color: #00C853;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.8;
}

.benefit-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.8;
  color: #4E5969;
}

/* 食用建议 */
.tips-section {
  background: linear-gradient(135deg, rgba(0, 200, 83, 0.05) 0%, rgba(105, 240, 174, 0.05) 100%);
  border-left: 4rpx solid #00C853;
  padding: 24rpx;
  border-radius: 0 12rpx 12rpx 0;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #00C853;
  margin-bottom: 12rpx;
}

.tips-content {
  font-size: 27rpx;
  line-height: 1.8;
  color: #4E5969;
}

/* 底部按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.add-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #00C853 0%, #69F0AE 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 200, 83, 0.3);
}

.add-btn::after {
  border: none;
}

.add-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
