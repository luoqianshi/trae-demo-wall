<!-- 食材详情 -->
<view class="food-detail-page">
  <!-- 食材基本信息 -->
  <view class="card food-header">
    <view class="food-icon">{{foodInfo.icon}}</view>
    <view class="food-basic">
      <text class="food-name">{{foodInfo.name}}</text>
      <text class="food-category">{{foodInfo.category}}</text>
    </view>
  </view>

  <!-- 每100g营养成分表 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">营养成分（每100g）</text>
      <text class="copy-btn" bindtap="copyNutrition">📋 复制</text>
    </view>
    <view class="nutrition-table">
      <view class="nutrition-row header-row">
        <text class="nutrient-label">营养素</text>
        <text class="nutrient-value">含量</text>
        <text class="nutrient-unit">单位</text>
      </view>
      <view class="nutrition-row highlight-row">
        <text class="nutrient-label">热量</text>
        <text class="nutrient-value primary">{{foodInfo.nutritionPer100g.calories}}</text>
        <text class="nutrient-unit">kcal</text>
      </view>
      <view class="nutrition-row">
        <text class="nutrient-label">蛋白质</text>
        <text class="nutrient-value protein">{{foodInfo.nutritionPer100g.protein}}</text>
        <text class="nutrient-unit">g</text>
      </view>
      <view class="nutrition-row">
        <text class="nutrient-label">碳水化合物</text>
        <text class="nutrient-value carb">{{foodInfo.nutritionPer100g.carbs}}</text>
        <text class="nutrient-unit">g</text>
      </view>
      <view class="nutrition-row">
        <text class="nutrient-label">脂肪</text>
        <text class="nutrient-value fat">{{foodInfo.nutritionPer100g.fat}}</text>
        <text class="nutrient-unit">g</text>
      </view>
    </view>
  </view>

  <!-- 升糖指数 -->
  <view class="card gi-card">
    <view class="section-header">
      <text class="section-title">升糖指数 (GI)</text>
    </view>
    <view class="gi-display">
      <text class="gi-value {{foodInfo.giValue <= 55 ? 'low' : foodInfo.giValue <= 70 ? 'medium' : 'high'}}">{{foodInfo.giValue || '--'}}</text>
      <text class="gi-level">{{foodInfo.giLevel}}</text>
    </view>
    <view class="gi-scale" wx:if="{{foodInfo.giValue > 0}}">
      <view class="scale-bar">
        <view class="scale-fill" style="width: {{foodInfo.giValue > 100 ? 100 : foodInfo.giValue}}%"></view>
      </view>
      <view class="scale-labels">
        <text>低GI (≤55)</text>
        <text>中GI (56-69)</text>
        <text>高GI (≥70)</text>
      </view>
    </view>
  </view>

  <!-- 常见重量换算 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">常见重量换算</text>
    </view>
    <view class="conversion-list">
      <view class="conversion-item" wx:for="{{foodInfo.weightConversion}}" wx:key="unit">
        <text class="conversion-unit">{{item.unit}}</text>
        <text class="conversion-weight">≈ {{item.weight}}g</text>
      </view>
    </view>
  </view>

  <!-- 营养价值说明 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">营养价值说明</text>
    </view>
    <view class="description-text">
      <text>{{foodInfo.description}}</text>
    </view>

    <view class="benefits-section" wx:if="{{foodInfo.benefits.length > 0}}">
      <text class="benefits-title">✨ 主要益处</text>
      <view class="benefits-list">
        <view class="benefit-item" wx:for="{{foodInfo.benefits}}" wx:key="*this">
          <text class="benefit-bullet">•</text>
          <text class="benefit-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="tips-section" wx:if="{{foodInfo.tips}}">
      <text class="tips-title">💡 食用建议</text>
      <text class="tips-content">{{foodInfo.tips}}</text>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-action">
    <button class="add-btn" bindtap="addToDiet">
      ➕ 添加到饮食
    </button>
  </view>
</view>
