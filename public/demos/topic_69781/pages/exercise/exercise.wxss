/* 运动记录页面 - 莫兰迪风格 fit-diet-app */
.exercise-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding: 24rpx 32rpx 140rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: 32rpx;
  padding-top: 16rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A5A;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #A6A6B2;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(166, 166, 178, 0.08);
}

/* 热量缺口卡片 */
.deficit-card {
  padding: 36rpx 32rpx;
}

.def-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.def-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A5A;
}

.def-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #96AD93;
}

.def-detail {
  display: block;
  font-size: 24rpx;
  color: #A6A6B2;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.bar-bg {
  width: 100%;
  height: 12rpx;
  background: rgba(166, 166, 178, 0.15);
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #A6A6B2, #96AD93);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

/* 今日总消耗 */
.today-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(166, 166, 178, 0.12);
}

.summary-label {
  font-size: 26rpx;
  color: #7A7A8A;
  font-weight: 500;
}

.summary-value {
  font-size: 24rpx;
  color: #96AD93;
  font-weight: 600;
}

/* 区块标题 */
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A5A;
  margin-bottom: 24rpx;
}

/* 运动类型选择 - 3列flex */
.type-card {
  padding: 36rpx 32rpx 28rpx;
}

.ex-type-grid {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.ex-type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.ex-type-item.active {
  border-color: rgba(166, 166, 178, 0.3);
}

/* 有氧 - 粉色系 */
.ex-type-item.cardio {
  background: rgba(212, 152, 143, 0.15);
}

.ex-type-item.cardio.active {
  background: rgba(212, 152, 143, 0.25);
  border-color: rgba(212, 152, 143, 0.4);
}

/* 力量训练 - 薰衣草紫 */
.ex-type-item.strength {
  background: rgba(181, 181, 193, 0.15);
}

.ex-type-item.strength.active {
  background: rgba(181, 181, 193, 0.25);
  border-color: rgba(181, 181, 193, 0.4);
}

/* HIIT - 橙色系 */
.ex-type-item.hiit {
  background: rgba(228, 163, 125, 0.15);
}

.ex-type-item.hiit.active {
  background: rgba(228, 163, 125, 0.25);
  border-color: rgba(228, 163, 125, 0.4);
}

.type-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.type-icon-wrap.cardio-bg {
  background: rgba(212, 152, 143, 0.3);
}

.type-icon-wrap.strength-bg {
  background: rgba(181, 181, 193, 0.3);
}

.type-icon-wrap.hiit-bg {
  background: rgba(228, 163, 125, 0.3);
}

.type-emoji {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A5A;
}

.type-label {
  font-size: 24rpx;
  font-weight: 600;
}

.type-label.cardio-text {
  color: #D49790;
}

.type-label.strength-text {
  color: #B5B5C1;
}

.type-label.hiit-text {
  color: #E3A37D;
}

/* 上次运动列表（记忆模式） */
.last-exercise-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.last-exercise-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FAF7F9;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.last-exercise-item:active {
  background: rgba(150, 173, 147, 0.1);
}

.last-ex-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #4A4A5A;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.last-ex-icon.cardio {
  background: rgba(212, 152, 143, 0.3);
}

.last-ex-icon.strength {
  background: rgba(181, 181, 193, 0.3);
}

.last-ex-icon.hiit {
  background: rgba(228, 163, 125, 0.3);
}

.last-ex-info {
  flex: 1;
}

.last-ex-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A4A5A;
  margin-bottom: 4rpx;
}

.last-ex-detail {
  display: block;
  font-size: 22rpx;
  color: #A6A6B2;
}

.last-ex-add {
  font-size: 22rpx;
  color: #96AD93;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: rgba(150, 173, 147, 0.12);
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* 运动选择列表 */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.exercise-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FAF7F9;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.exercise-item.selected {
  background: rgba(150, 173, 147, 0.1);
  border-color: #96AD93;
}

.ex-item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A5A;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ex-item-icon.cardio {
  background: rgba(212, 152, 143, 0.3);
}

.ex-item-icon.strength {
  background: rgba(181, 181, 193, 0.3);
}

.ex-item-icon.hiit {
  background: rgba(228, 163, 125, 0.3);
}

.ex-item-info {
  flex: 1;
}

.ex-item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A5A;
  margin-bottom: 4rpx;
}

.ex-item-detail {
  display: block;
  font-size: 22rpx;
  color: #A6A6B2;
}

.ex-item-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #D5D5DD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  transition: all 0.3s ease;
}

.ex-item-check.checked {
  background: #96AD93;
  border-color: #96AD93;
}

/* 自定义运动按钮 */
.custom-exercise-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(181, 181, 193, 0.1);
  border: 2rpx dashed rgba(181, 181, 193, 0.4);
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.custom-exercise-btn:active {
  background: rgba(181, 181, 193, 0.2);
}

.custom-plus {
  font-size: 36rpx;
  color: #B5B5C1;
  font-weight: 300;
  line-height: 1;
}

.custom-label {
  font-size: 28rpx;
  color: #B5B5C1;
  font-weight: 500;
}

/* 添加按钮 */
.add-exercise-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #96AD93;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(150, 173, 147, 0.3);
}

.add-exercise-btn[disabled] {
  background: #C9CDD4;
  color: #FFFFFF;
  box-shadow: none;
}

.add-exercise-btn::after {
  border: none;
}

.add-exercise-btn:active:not([disabled]) {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 运动记录列表 */
.ex-log-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ex-log-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FAF7F9;
  border-radius: 16rpx;
}

.ex-log-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A5A;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ex-log-icon.cardio {
  background: rgba(212, 152, 143, 0.3);
}

.ex-log-icon.strength {
  background: rgba(181, 181, 193, 0.3);
}

.ex-log-icon.hiit {
  background: rgba(228, 163, 125, 0.3);
}

.ex-log-info {
  flex: 1;
}

.ex-log-info .name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A5A;
  margin-bottom: 4rpx;
}

.ex-log-info .detail {
  display: block;
  font-size: 22rpx;
  color: #A6A6B2;
}

.ex-log-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.ex-log-cal {
  font-size: 28rpx;
  font-weight: 700;
}

.ex-log-cal.cardio {
  color: #D49790;
}

.ex-log-cal.strength {
  color: #B5B5C1;
}

.ex-log-cal.hiit {
  color: #E3A37D;
}

.delete-btn {
  font-size: 22rpx;
  color: #CC858E;
  padding: 4rpx 16rpx;
  background: rgba(204, 133, 142, 0.1);
  border-radius: 12rpx;
}

/* 提示卡片 */
.tip-card {
  background: rgba(150, 173, 147, 0.12);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #96AD93;
  margin-bottom: 12rpx;
}

.tip-desc {
  display: block;
  font-size: 24rpx;
  color: #7A8A78;
  line-height: 1.6;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 74, 90, 0.4);
  z-index: 999;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  z-index: 1000;
  padding: 44rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(166, 166, 178, 0.2);
}

.modal-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #4A4A5A;
  margin-bottom: 8rpx;
}

.modal-sub {
  display: block;
  font-size: 26rpx;
  color: #A6A6B2;
}

.modal-body {
  margin-bottom: 32rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #7A7A8A;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.modal-input {
  width: 100%;
  height: 96rpx;
  background: #FAF7F9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #4A4A5A;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  font-weight: 600;
  text-align: center;
  border: 2rpx solid rgba(166, 166, 178, 0.2);
}

.calorie-preview {
  text-align: center;
  padding: 24rpx;
  background: rgba(150, 173, 147, 0.1);
  border-radius: 16rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #A6A6B2;
}

.preview-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #96AD93;
  margin-left: 12rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.modal-btn.cancel {
  background: #F2ECEE;
  color: #7A7A8A;
}

.modal-btn.confirm {
  background: #96AD93;
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(150, 173, 147, 0.3);
}

.modal-btn::after {
  border: none;
}

/* 自定义运动 - 分类选择 */
.custom-type-row {
  display: flex;
  gap: 16rpx;
}

.custom-type-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #7A7A8A;
  background: #FAF7F9;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.custom-type-item.active {
  font-weight: 600;
}

.custom-type-item.active.cardio-type {
  background: rgba(212, 152, 143, 0.2);
  border-color: rgba(212, 152, 143, 0.4);
  color: #D49790;
}

.custom-type-item.active.strength-type {
  background: rgba(181, 181, 193, 0.2);
  border-color: rgba(181, 181, 193, 0.4);
  color: #B5B5C1;
}

.custom-type-item.active.hiit-type {
  background: rgba(228, 163, 125, 0.2);
  border-color: rgba(228, 163, 125, 0.4);
  color: #E3A37D;
}
