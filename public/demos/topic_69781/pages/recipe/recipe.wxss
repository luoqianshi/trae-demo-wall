/* 食谱库页面 - 莫兰迪色系 */

.recipe-page {
  min-height: 100vh;
  background: #F2ECEE;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 12rpx;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-icon-s {
  font-size: 26rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #3A3A4A;
}

.search-placeholder {
  color: #B5B5C1;
  font-size: 28rpx;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clear-icon {
  font-size: 22rpx;
  color: #B5B5C1;
}

.search-btn {
  height: 72rpx;
  padding: 0 28rpx;
  background: #96AD93;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 滚动区域 */
.recipe-scroll {
  flex: 1;
  height: 0;
}

/* 区域标题 */
.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A3A4A;
}

.section-count {
  font-size: 24rpx;
  color: #A6A6B2;
}

/* 搜索中 */
.searching-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.searching-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(150, 173, 147, 0.2);
  border-top-color: #96AD93;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.searching-text {
  font-size: 28rpx;
  color: #3A3A4A;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.searching-sub {
  font-size: 24rpx;
  color: #B5B5C1;
}

/* 横向推荐 */
.recommend-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.recommend-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.recommend-card {
  width: 280rpx;
  flex-shrink: 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.recommend-img {
  width: 100%;
  height: 180rpx;
}

.recommend-info {
  padding: 12rpx 16rpx 16rpx;
}

.recommend-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #3A3A4A;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recommend-cal {
  font-size: 20rpx;
  color: #A6A6B2;
}

/* 迷你标签 */
.mini-badge {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.mb-loseFat {
  background: rgba(150, 173, 147, 0.2);
  color: #96AD93;
}

.mb-gainMuscle {
  background: rgba(227, 163, 125, 0.2);
  color: #E3A37D;
}

.mb-controlSugar {
  background: rgba(181, 181, 193, 0.2);
  color: #B5B5C1;
}

.mb-user {
  background: rgba(204, 133, 142, 0.2);
  color: #CC858E;
}

/* 食谱列表 - 单列紧凑 */
.recipe-list {
  padding: 0 32rpx;
}

.recipe-list-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  gap: 20rpx;
}

.list-item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.list-item-img-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #EDEBEF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-char {
  font-size: 40rpx;
  color: #B5B5C1;
  font-weight: 700;
}

.list-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.list-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A3A4A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.list-item-cal {
  font-size: 22rpx;
  color: #A6A6B2;
}

.list-item-detail {
  font-size: 22rpx;
  color: #B5B5C1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分享悬浮按钮 */
.share-fab {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background: #E3A37D;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(227, 163, 125, 0.4);
  z-index: 100;
}

.share-fab-icon {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.share-fab-text {
  font-size: 16rpx;
  color: #FFFFFF;
  margin-top: 2rpx;
}

/* 弹窗遮罩 */
.share-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

/* 分享弹窗 */
.share-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  display: flex;
  flex-direction: column;
}

.share-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0EDF0;
}

.share-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3A3A4A;
}

.share-modal-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-text {
  font-size: 28rpx;
  color: #A6A6B2;
}

.share-modal-body {
  flex: 1;
  padding: 20rpx 32rpx;
  max-height: 60vh;
}

.share-modal-footer {
  padding: 16rpx 32rpx 40rpx;
}

/* 上传区域 */
.share-upload-area {
  margin-bottom: 20rpx;
}

.share-media-list {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.share-media-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.share-media-thumb {
  width: 100%;
  height: 100%;
}

.share-media-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-text {
  font-size: 18rpx;
  color: #FFFFFF;
}

.share-media-type {
  position: absolute;
  bottom: 6rpx;
  left: 6rpx;
  padding: 2rpx 8rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 6rpx;
}

.type-text {
  font-size: 16rpx;
  color: #FFFFFF;
}

.share-media-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #D0CCD4;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.add-icon {
  font-size: 40rpx;
  color: #B5B5C1;
  line-height: 1;
}

.add-text {
  font-size: 18rpx;
  color: #B5B5C1;
}

/* 表单 */
.share-field {
  margin-bottom: 20rpx;
}

.share-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A3A4A;
  display: block;
  margin-bottom: 10rpx;
}

.share-input {
  width: 100%;
  height: 76rpx;
  background: #F8F6F9;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #3A3A4A;
  box-sizing: border-box;
}

.share-textarea {
  width: 100%;
  min-height: 100rpx;
  background: #F8F6F9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #3A3A4A;
  box-sizing: border-box;
}

/* 分类选择 */
.share-category-row {
  display: flex;
  gap: 12rpx;
}

.share-cat-item {
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #F8F6F9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-cat-text {
  font-size: 26rpx;
  color: #A6A6B2;
}

.share-cat-item.active.cat-fat {
  background: rgba(150, 173, 147, 0.25);
}

.share-cat-item.active.cat-fat .share-cat-text {
  color: #96AD93;
  font-weight: 700;
}

.share-cat-item.active.cat-muscle {
  background: rgba(227, 163, 125, 0.25);
}

.share-cat-item.active.cat-muscle .share-cat-text {
  color: #E3A37D;
  font-weight: 700;
}

.share-cat-item.active.cat-sugar {
  background: rgba(181, 181, 193, 0.25);
}

.share-cat-item.active.cat-sugar .share-cat-text {
  color: #B5B5C1;
  font-weight: 700;
}

/* 提交按钮 */
.share-submit-btn {
  width: 100%;
  height: 84rpx;
  background: #96AD93;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-submit-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
