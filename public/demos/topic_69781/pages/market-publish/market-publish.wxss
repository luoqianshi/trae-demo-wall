/* 发布商品页面 - 莫兰迪色系 */
.publish-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding: 24rpx 32rpx 180rpx;
}

/* 通用section标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #96AD93;
}

/* 图片上传区域 */
.upload-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.image-upload-area {
  margin-top: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 300;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #B5B5C1 0%, #A6A6B2 100%);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.upload-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.upload-count {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单区域 */
.form-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  color: #4E5969;
  font-weight: 500;
}

.required {
  color: #CC858E;
  margin-left: 8rpx;
  font-size: 28rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #C9CDD4;
}

/* 价格输入框 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.price-symbol {
  font-size: 32rpx;
  color: #E3A37D;
  font-weight: 600;
  margin-right: 8rpx;
}

.price-input {
  flex: 1;
  height: 100%;
  background: transparent;
  padding: 0;
}

/* 选择器 */
.form-picker {
  width: 100%;
  height: 88rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  color: #1D2129;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #C9CDD4;
}

.picker-arrow {
  font-size: 32rpx;
  color: #A6A6B2;
  font-weight: 600;
}

/* 多行文本框 */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #C9CDD4;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #A6A6B2;
  margin-top: 12rpx;
}

/* 发布按钮 */
.publish-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: 44rpx;
  background: #F2ECEE;
}

.publish-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E3A37D 0%, #CC858E 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(227, 163, 125, 0.4);
}

.publish-btn::after {
  border: none;
}

.publish-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 禁用状态 */
.publish-btn.disabled {
  background: #C9CDD4;
  box-shadow: none;
}