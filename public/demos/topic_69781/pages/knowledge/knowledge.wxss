/* 科普知识页面 */
.knowledge-page {
  min-height: 100vh;
  background: #F5F7FA;
}

/* 分类Tab */
.tabs-container {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tabs-scroll {
  white-space: nowrap;
  padding: 20rpx 32rpx;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 36rpx;
  margin-right: 16rpx;
  background: #F7F8FA;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #4E5969;
  font-weight: 500;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.tab-item.active {
  background: linear-gradient(135deg, #00C853 0%, #69F0AE 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 200, 83, 0.3);
}

/* 文章列表 */
.article-list {
  padding: 24rpx 32rpx;
}

/* 文章卡片 */
.article-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease;
}

.article-card:active {
  transform: scale(0.98);
}

.article-header {
  margin-bottom: 16rpx;
}

.article-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1D2129;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.article-summary {
  display: block;
  font-size: 27rpx;
  line-height: 1.7;
  color: #86909C;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  background: linear-gradient(135deg, rgba(0, 200, 83, 0.08) 0%, rgba(105, 240, 174, 0.08) 100%);
  color: #00C853;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.views {
  font-size: 24rpx;
  color: #86909C;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #86909C;
  font-size: 28rpx;
}

/* 详情页 */
.detail-page {
  min-height: 100vh;
  background: #FFFFFF;
}

.detail-header {
  padding: 32rpx;
  background: linear-gradient(135deg, #00C853 0%, #69F0AE 100%);
  margin-bottom: 24rpx;
}

.back-btn {
  display: inline-block;
  color: #FFFFFF;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.detail-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.views-count {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
}

.detail-tags .tag {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.detail-content {
  padding: 32rpx;
  font-size: 29rpx;
  line-height: 2;
  color: #4E5969;
}

/* 文章详情内容 - 标题 */
.detail-title-h2 {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D2129;
  margin: 32rpx 0 16rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #00C853;
}

/* 文章详情内容 - 段落 */
.detail-text {
  margin-bottom: 20rpx;
  line-height: 2;
  color: #4E5969;
}

/* 文章详情内容 - 加粗文本 */
.detail-strong {
  color: #1D2129;
  font-weight: 600;
}

/* 文章详情内容 - 列表 */
.detail-list {
  padding-left: 40rpx;
  margin-bottom: 20rpx;
}

.detail-list-item {
  margin-bottom: 12rpx;
  list-style: disc;
}

.detail-actions {
  position: sticky;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #00C853 0%, #69F0AE 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 200, 83, 0.3);
}

.action-btn::after {
  border: none;
}
