<!-- 饮食记录页面 - fit-diet-app Screen 2 莫兰迪风格 -->
<view class="diet-page">

  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <view class="back-arrow"></view>
    </view>
    <text class="nav-title">三餐营养记录</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 内容区域 -->
  <view class="content-area">

    <!-- 餐次分段选择器 -->
    <view class="meal-segment">
      <view
        wx:for="{{mealTypes}}"
        wx:key="value"
        class="seg-item seg-{{item.value}} {{currentMeal === item.value ? 'active' : ''}}"
        bindtap="switchMeal"
        data-type="{{item.value}}"
      >
        <text class="seg-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 餐次详情卡片 -->
    <view class="card meal-card">
      <view class="meal-header">
        <view class="meal-header-left">
          <text class="meal-title">{{currentMealLabel}}</text>
          <text class="meal-dot"></text>
          <text class="meal-status">{{currentMealFoods.length > 0 ? '已录入' : '未录入'}}</text>
        </view>
        <text class="meal-calories cal-{{currentMeal}}">{{currentMealCalories}} kcal</text>
      </view>

      <!-- 食物列表 -->
      <view class="food-list" wx:if="{{currentMealFoods.length > 0}}">
        <view
          wx:for="{{currentMealFoods}}"
          wx:key="id"
          class="food-item food-item-{{currentMeal}}"
        >
          <view class="food-info-area">
            <text class="food-name">{{item.name}}</text>
            <text class="food-gram" wx:if="{{item.displayAmount}}">{{item.displayAmount}}</text>
            <text class="food-gram" wx:else>{{item.amount}}g</text>
          </view>
          <text class="food-cal">{{item.calories}} kcal</text>
          <view class="food-delete" bindtap="deleteFood" data-id="{{item.id}}">
            <view class="delete-icon"></view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <view class="empty-line"></view>
        <text class="empty-text">暂无记录，点击下方添加</text>
      </view>

      <!-- 添加按钮 -->
      <view class="add-food-btn add-{{currentMeal}}" bindtap="showAddFood">
        <view class="add-plus"></view>
        <text class="add-label">添加食物</text>
      </view>
    </view>

    <!-- 营养对比卡片（6项） -->
    <view class="card nutrition-card">
      <text class="nc-title">营养对比</text>

      <view class="nc-row">
        <text class="nc-label">蛋白质</text>
        <view class="bar-track">
          <view class="bar-fill bar-protein" style="width: {{todayTotal.protein / nutritionTarget.protein * 100 > 100 ? 100 : todayTotal.protein / nutritionTarget.protein * 100}}%"></view>
        </view>
        <text class="nc-val val-protein">{{todayTotal.protein}}g/{{nutritionTarget.protein}}g</text>
      </view>

      <view class="nc-row">
        <text class="nc-label">碳水</text>
        <view class="bar-track">
          <view class="bar-fill bar-carb" style="width: {{todayTotal.carb / nutritionTarget.carb * 100 > 100 ? 100 : todayTotal.carb / nutritionTarget.carb * 100}}%"></view>
        </view>
        <text class="nc-val val-carb">{{todayTotal.carb}}g/{{nutritionTarget.carb}}g</text>
      </view>

      <view class="nc-row">
        <text class="nc-label">脂肪</text>
        <view class="bar-track">
          <view class="bar-fill bar-fat" style="width: {{todayTotal.fat / nutritionTarget.fat * 100 > 100 ? 100 : todayTotal.fat / nutritionTarget.fat * 100}}%"></view>
        </view>
        <text class="nc-val val-fat">{{todayTotal.fat}}g/{{nutritionTarget.fat}}g</text>
      </view>

      <view class="nc-row">
        <text class="nc-label">膳食纤维</text>
        <view class="bar-track">
          <view class="bar-fill bar-fiber" style="width: {{todayTotal.fiber / nutritionTarget.fiber * 100 > 100 ? 100 : todayTotal.fiber / nutritionTarget.fiber * 100}}%"></view>
        </view>
        <text class="nc-val val-fiber">{{todayTotal.fiber}}g/{{nutritionTarget.fiber}}g</text>
      </view>

      <view class="nc-row">
        <text class="nc-label">维生素C</text>
        <view class="bar-track">
          <view class="bar-fill bar-vitaminC" style="width: {{todayTotal.vitaminC / nutritionTarget.vitaminC * 100 > 100 ? 100 : todayTotal.vitaminC / nutritionTarget.vitaminC * 100}}%"></view>
        </view>
        <text class="nc-val val-vitaminC">{{todayTotal.vitaminC}}mg/{{nutritionTarget.vitaminC}}mg</text>
      </view>

      <view class="nc-row">
        <text class="nc-label">钙</text>
        <view class="bar-track">
          <view class="bar-fill bar-calcium" style="width: {{todayTotal.calcium / nutritionTarget.calcium * 100 > 100 ? 100 : todayTotal.calcium / nutritionTarget.calcium * 100}}%"></view>
        </view>
        <text class="nc-val val-calcium">{{todayTotal.calcium}}mg/{{nutritionTarget.calcium}}mg</text>
      </view>
    </view>

  </view>

  <!-- 底部安全区域 -->
  <view class="bottom-safe"></view>

</view>

<!-- 添加食物弹窗 -->
<view class="modal-mask {{showModal ? 'show' : ''}}" catchtap="hideModal"></view>
<view class="modal-content {{showModal ? 'show' : ''}}">
  <view class="modal-header">
    <text class="modal-title">拍照识别食物</text>
    <view class="modal-close" bindtap="hideModal">
      <view class="close-x"></view>
    </view>
  </view>

  <!-- 识别中 -->
  <block wx:if="{{recognizing}}">
    <view class="recognizing-area">
      <view class="recognizing-spinner"></view>
      <text class="recognizing-text">AI正在分析你的餐食...</text>
      <text class="recognizing-hint">识别食物种类及营养成分，通常3-8秒</text>
    </view>
  </block>

  <!-- 识别结果 -->
  <block wx:elif="{{recognizeResult}}">
    <scroll-view class="recognize-scroll" scroll-y>
      <!-- 整餐总览 -->
      <view class="recognize-meal-summary">
        <view class="recognize-ai-dot"></view>
        <text class="recognize-summary-title">AI识别结果</text>
        <text class="recognize-summary-total">总热量 {{recognizeResult.totalCalories}} kcal</text>
      </view>

      <!-- 变质警告 -->
      <view class="spoiled-warning" wx:if="{{recognizeResult.spoiledFoods && recognizeResult.spoiledFoods.length > 0}}">
        <view class="spoiled-warning-icon">
          <text class="spoiled-warning-excl">!</text>
        </view>
        <view class="spoiled-warning-content">
          <text class="spoiled-warning-title">检测到变质食物，请勿食用！</text>
          <text class="spoiled-warning-desc">以下食物疑似变质，建议丢弃：</text>
          <view class="spoiled-warning-items">
            <text class="spoiled-warning-item" wx:for="{{recognizeResult.spoiledFoods}}" wx:key="index">· {{item}}</text>
          </view>
        </view>
      </view>

      <!-- 食物列表 -->
      <view class="recognize-food-list">
        <view class="recognize-food-item {{item.isSpoiled ? 'spoiled' : ''}}" wx:for="{{recognizeResult.foods}}" wx:key="index">
          <view class="recognize-food-left">
            <text class="recognize-food-name">{{item.name}}</text>
            <text class="recognize-food-weight" wx:if="{{!item.isSpoiled}}">约{{item.estimatedWeight}}g</text>
            <text class="recognize-food-weight spoiled-tag" wx:else>疑似变质{{item.spoilReason ? '：' + item.spoilReason : ''}}</text>
          </view>
          <view class="recognize-food-right">
            <text class="recognize-food-cal" wx:if="{{!item.isSpoiled}}">{{item.totalCalories}} kcal</text>
            <text class="recognize-food-cal spoiled-tag" wx:else>请勿食用</text>
          </view>
        </view>
      </view>

      <!-- 营养明细 -->
      <view class="recognize-nutrition-card">
        <text class="recognize-nutrition-title">营养成分</text>
        <view class="recognize-nutrition-grid">
          <view class="recognize-nutrition-item">
            <text class="recognize-nutrition-val">{{recognizeResult.totalProtein}}g</text>
            <text class="recognize-nutrition-unit">蛋白质</text>
          </view>
          <view class="recognize-nutrition-item">
            <text class="recognize-nutrition-val">{{recognizeResult.totalCarb}}g</text>
            <text class="recognize-nutrition-unit">碳水</text>
          </view>
          <view class="recognize-nutrition-item">
            <text class="recognize-nutrition-val">{{recognizeResult.totalFat}}g</text>
            <text class="recognize-nutrition-unit">脂肪</text>
          </view>
          <view class="recognize-nutrition-item">
            <text class="recognize-nutrition-val">{{recognizeResult.totalFiber}}g</text>
            <text class="recognize-nutrition-unit">膳食纤维</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="recognize-actions">
        <view class="recognize-action-btn retake-btn" bindtap="retakePhoto">
          <text class="recognize-action-text">重新拍照</text>
        </view>
        <view class="recognize-action-btn use-btn" bindtap="confirmRecognizeResult">
          <text class="recognize-action-text">确认记录</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- 默认拍照区域 -->
  <block wx:else>
    <view class="camera-area" bindtap="onCameraTap">
      <view class="camera-icon-large"></view>
      <text class="camera-text">点击拍照识别</text>
      <text class="camera-hint">AI自动分析你这餐吃了什么</text>
      <text class="camera-hint-sub">识别食物种类、重量及卡路里</text>
    </view>
  </block>
</view>
