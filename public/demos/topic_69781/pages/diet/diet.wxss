/* 饮食记录页面样式 - fit-diet-app Screen 2 莫兰迪风格 */

/* ===== 色彩变量 ===== */
page {
  --bg: #F2ECEE;
  --card: #FFFFFF;
  --primary: #A6A6B2;
  --sage: #96AD93;
  --lavender: #B5B5C1;
  --orange: #E3A37D;
  --rose: #CC858E;
  --pink: #D49790;
  --yellow: #F0C8A0;
  --green: #5E9C87;
  --text: #424242;
  --text-secondary: #666666;
  --border: #E0DBE3;
  --light: #E5E0E5;
}

/* ===== 页面容器 ===== */
.diet-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 40rpx;
  padding-top: 20rpx;
  background: #F2ECEE;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #424242;
  border-bottom: 4rpx solid #424242;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #424242;
}

.nav-placeholder {
  width: 64rpx;
}

/* ===== 内容区域 ===== */
.content-area {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: 40rpx;
}

/* ===== 餐次分段选择器 ===== */
.meal-segment {
  display: flex;
  gap: 20rpx;
}

.seg-item {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.seg-label {
  font-size: 28rpx;
  font-weight: 500;
}

/* 早餐 - 橙色 */
.seg-breakfast {
  background: rgba(228, 163, 125, 0.15);
}
.seg-breakfast .seg-label {
  color: #C8926A;
}
.seg-breakfast.active {
  background: rgba(228, 163, 125, 0.4);
}
.seg-breakfast.active .seg-label {
  color: #E3A37D;
  font-weight: 600;
}

/* 午餐 - 绿色 */
.seg-lunch {
  background: rgba(150, 173, 147, 0.15);
}
.seg-lunch .seg-label {
  color: #7A9477;
}
.seg-lunch.active {
  background: rgba(150, 173, 147, 0.4);
}
.seg-lunch.active .seg-label {
  color: #96AD93;
  font-weight: 600;
}

/* 晚餐 - 紫色 */
.seg-dinner {
  background: rgba(181, 181, 193, 0.15);
}
.seg-dinner .seg-label {
  color: #9595A5;
}
.seg-dinner.active {
  background: rgba(181, 181, 193, 0.4);
}
.seg-dinner.active .seg-label {
  color: #B5B5C1;
  font-weight: 600;
}

/* ===== 通用卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}

/* ===== 餐次详情卡片 ===== */
.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.meal-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #424242;
}

.meal-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #E0DBE3;
}

.meal-status {
  font-size: 24rpx;
  color: #666666;
}

.meal-calories {
  font-size: 32rpx;
  font-weight: 700;
}

.cal-breakfast {
  color: #E3A37D;
}
.cal-lunch {
  color: #96AD93;
}
.cal-dinner {
  color: #B5B5C1;
}

/* ===== 食物列表 ===== */
.food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.food-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  gap: 16rpx;
}

/* 早餐食物行 - 浅橙背景 */
.food-item-breakfast {
  background: rgba(228, 163, 125, 0.1);
}

/* 午餐食物行 - 浅绿背景 */
.food-item-lunch {
  background: rgba(150, 173, 147, 0.1);
}

/* 晚餐食物行 - 浅紫背景 */
.food-item-dinner {
  background: rgba(181, 181, 193, 0.1);
}

.food-info-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.food-name {
  font-size: 28rpx;
  color: #424242;
  font-weight: 500;
}

.food-gram {
  font-size: 22rpx;
  color: #666666;
}

.food-cal {
  font-size: 26rpx;
  color: #424242;
  font-weight: 500;
  min-width: 120rpx;
  text-align: right;
}

.food-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.delete-icon {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.delete-icon::before,
.delete-icon::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: #CC858E;
  border-radius: 2rpx;
  top: 50%;
  left: 0;
}

.delete-icon::before {
  transform: rotate(45deg);
}

.delete-icon::after {
  transform: rotate(-45deg);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  margin-bottom: 24rpx;
}

.empty-line {
  width: 80rpx;
  height: 4rpx;
  background: #E0DBE3;
  border-radius: 2rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #666666;
}

/* ===== 添加食物按钮 ===== */
.add-food-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  border-radius: 16rpx;
  transition: all 0.25s ease;
}

.add-plus {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}

.add-plus::before,
.add-plus::after {
  content: '';
  position: absolute;
  border-radius: 2rpx;
}

.add-plus::before {
  width: 24rpx;
  height: 4rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.add-plus::after {
  width: 4rpx;
  height: 24rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.add-label {
  font-size: 28rpx;
  font-weight: 500;
}

/* 早餐添加按钮 */
.add-breakfast {
  background: rgba(228, 163, 125, 0.12);
}
.add-breakfast .add-plus::before,
.add-breakfast .add-plus::after {
  background: #E3A37D;
}
.add-breakfast .add-label {
  color: #E3A37D;
}

/* 午餐添加按钮 */
.add-lunch {
  background: rgba(150, 173, 147, 0.12);
}
.add-lunch .add-plus::before,
.add-lunch .add-plus::after {
  background: #96AD93;
}
.add-lunch .add-label {
  color: #96AD93;
}

/* 晚餐添加按钮 */
.add-dinner {
  background: rgba(181, 181, 193, 0.12);
}
.add-dinner .add-plus::before,
.add-dinner .add-plus::after {
  background: #B5B5C1;
}
.add-dinner .add-label {
  color: #B5B5C1;
}

/* ===== 营养对比卡片 ===== */
.nutrition-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #424242;
}

.nc-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nc-label {
  font-size: 24rpx;
  color: #666666;
  width: 80rpx;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 12rpx;
  background: #E5E0E5;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.bar-protein {
  background: #96AD93;
}

.bar-carb {
  background: #E3A37D;
}

.bar-fat {
  background: #CC858E;
}

.bar-fiber {
  background: #B5B5C1;
}

.bar-vitaminC {
  background: #F0C8A0;
}

.bar-calcium {
  background: #5E9C87;
}

.nc-val {
  font-size: 22rpx;
  font-weight: 500;
  width: 140rpx;
  text-align: right;
  flex-shrink: 0;
}

.val-protein {
  color: #96AD93;
}

.val-carb {
  color: #E3A37D;
}

.val-fat {
  color: #CC858E;
}

.val-fiber {
  color: #B5B5C1;
}

.val-vitaminC {
  color: #F0C8A0;
}

.val-calcium {
  color: #5E9C87;
}

/* ===== 底部安全区域 ===== */
.bottom-safe {
  height: 40rpx;
}

/* ===== 弹窗遮罩 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(66, 66, 66, 0.4);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

/* ===== 弹窗内容 ===== */
.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal-content.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #E0DBE3;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #424242;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-x {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.close-x::before,
.close-x::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 3rpx;
  background: #666666;
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
}

.close-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.close-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ===== 拍照识别区域 ===== */
.camera-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
  margin: 16rpx 32rpx;
  border-radius: 20rpx;
  background: #FAF7F9;
  border: 2rpx dashed rgba(181, 181, 193, 0.4);
}

.camera-icon-large {
  width: 80rpx;
  height: 64rpx;
  border: 4rpx solid #B5B5C1;
  border-radius: 12rpx;
  position: relative;
  margin-bottom: 20rpx;
}

.camera-icon-large::before {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #B5B5C1;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.camera-icon-large::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 10rpx;
  border: 3rpx solid #B5B5C1;
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
}

.camera-text {
  font-size: 28rpx;
  color: #424242;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.camera-hint {
  font-size: 24rpx;
  color: #A6A6B2;
}

/* ===== AI识别相关 ===== */
.dot-ai { background: #E3A37D; }

/* 识别中动画 */
.recognizing-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.recognizing-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E0DBE3;
  border-top: 6rpx solid #E3A37D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.recognizing-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #424242;
  margin-top: 24rpx;
}

.recognizing-hint {
  font-size: 24rpx;
  color: #A6A6B2;
  margin-top: 8rpx;
}

/* 识别结果滚动区 */
.recognize-scroll {
  width: 100%;
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 整餐总览 */
.recognize-meal-summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.recognize-ai-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E3A37D;
}

.recognize-summary-title {
  font-size: 26rpx;
  color: #A6A6B2;
  font-weight: 500;
  flex: 1;
}

.recognize-summary-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #E3A37D;
}

/* 食物列表 */
.recognize-food-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #E0DBE3;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.recognize-food-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F2ECEE;
}

.recognize-food-item:last-child {
  border-bottom: none;
}

.recognize-food-item.spoiled {
  background: #FFF8F7;
}

.spoiled-tag {
  color: #CC858E !important;
}

.recognize-food-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.recognize-food-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #424242;
}

.recognize-food-weight {
  font-size: 22rpx;
  color: #A6A6B2;
}

.recognize-food-right {
  display: flex;
  align-items: center;
}

.recognize-food-cal {
  font-size: 26rpx;
  font-weight: 600;
  color: #E3A37D;
}

/* 营养明细卡片 */
.recognize-nutrition-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #E0DBE3;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.recognize-nutrition-title {
  font-size: 24rpx;
  color: #A6A6B2;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.recognize-nutrition-grid {
  display: flex;
  justify-content: space-between;
}

.recognize-nutrition-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.recognize-nutrition-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #424242;
}

.recognize-nutrition-unit {
  font-size: 20rpx;
  color: #A6A6B2;
  margin-top: 4rpx;
}

/* 识别操作按钮 */
.recognize-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.recognize-action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.retake-btn {
  background: #F2ECEE;
}

.use-btn {
  background: #96AD93;
}

.recognize-action-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #4E5969;
}

.use-btn .recognize-action-text {
  color: #FFFFFF;
}

/* 拍照区域增强 */
.camera-hint-sub {
  font-size: 22rpx;
  color: #B5B5C1;
  margin-top: 4rpx;
}

/* 变质警告 */
.spoiled-warning {
  background: #FFF3F0;
  border: 2rpx solid #CC858E;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.spoiled-warning-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #CC858E;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.spoiled-warning-excl {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 40rpx;
}

.spoiled-warning-content {
  flex: 1;
}

.spoiled-warning-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #CC858E;
  display: block;
  margin-bottom: 8rpx;
}

.spoiled-warning-desc {
  font-size: 24rpx;
  color: #8C5559;
  display: block;
}

.spoiled-warning-items {
  margin-top: 8rpx;
}

.spoiled-warning-item {
  font-size: 24rpx;
  color: #CC858E;
  display: block;
  padding: 4rpx 0;
}
