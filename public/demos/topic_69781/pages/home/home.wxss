/* ========================================
   首页样式 - fit-diet-app Screen 1 莫兰迪风格
   ======================================== */

/* 莫兰迪色系变量 */
page {
  --morandi-bg: #F2ECEE;
  --morandi-card: #FFFFFF;
  --morandi-primary: #A6A6B2;
  --morandi-sage: #96AD93;
  --morandi-lavender: #B5B5C1;
  --morandi-orange: #E3A37D;
  --morandi-rose: #CC858E;
  --morandi-pink: #D49790;
  --morandi-yellow: #F0C8A0;
  --morandi-green: #5E9C87;
  --morandi-text: #424242;
  --morandi-text-secondary: #666666;
  --morandi-border: #E0DBE3;
  --morandi-light: #E5E0E5;
}

/* 页面容器 */
.home-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding: 40rpx;
  padding-top: 60rpx;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

/* 内容区域 - 确保居中 */
.home-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* ========================================
   1. 顶部问候区
   ======================================== */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
}

.greeting {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greeting-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #424242;
  line-height: 1.3;
}

.greeting-sub {
  font-size: 26rpx;
  color: #666666;
}

.greeting-sub.login-tip {
  color: #A6A6B2;
  font-style: italic;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #B5B5C1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.avatar-icon {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* ========================================
   2. 热量卡片
   ======================================== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.cal-card {
  /* 白色卡片，无渐变 */
}

.cal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #424242;
}

.cal-target {
  font-size: 24rpx;
  color: #666666;
}

.progress-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.cal-number {
  font-size: 64rpx;
  font-weight: 700;
  color: #424242;
  line-height: 1;
}

.cal-label {
  font-size: 26rpx;
  color: #666666;
}

/* 进度条 */
.bar-bg {
  height: 12rpx;
  border-radius: 6rpx;
  background: #E5E0E5;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #A6A6B2, #96AD93);
  transition: width 0.5s ease;
}

/* 宏量营养素网格 - 2行3列 */
.macro-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.macro-box {
  width: calc((100% - 32rpx) / 3);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.macro-box.protein {
  background: rgba(150, 173, 147, 0.2);
}

.macro-box.carb {
  background: rgba(228, 163, 125, 0.2);
}

.macro-box.fat {
  background: rgba(204, 133, 142, 0.2);
}

.macro-box.fiber {
  background: rgba(181, 181, 193, 0.2);
}

.macro-box.vitaminC {
  background: rgba(240, 200, 160, 0.2);
}

.macro-box.calcium {
  background: rgba(94, 156, 135, 0.2);
}

.macro-name {
  font-size: 22rpx;
  color: #666666;
}

.macro-value {
  font-size: 24rpx;
  font-weight: 600;
}

.protein-text {
  color: #96AD93;
}

.carb-text {
  color: #E3A37D;
}

.fat-text {
  color: #CC858E;
}

.fiber-text {
  color: #B5B5C1;
}

.vitaminC-text {
  color: #F0C8A0;
}

.calcium-text {
  color: #5E9C87;
}

/* ========================================
   3. 快捷操作
   ======================================== */
.quick-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
}

.action-btn.meal {
  background: rgba(150, 173, 147, 0.15);
}

.action-btn.exercise {
  background: rgba(181, 181, 193, 0.15);
}

.action-btn.recipe {
  background: rgba(228, 163, 125, 0.15);
}

.action-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meal-circle {
  background: rgba(150, 173, 147, 0.25);
}

.exercise-circle {
  background: rgba(181, 181, 193, 0.25);
}

.recipe-circle {
  background: rgba(228, 163, 125, 0.25);
}

.action-icon-text {
  font-size: 32rpx;
  font-weight: 600;
}

.meal-circle .action-icon-text {
  color: #96AD93;
}

.exercise-circle .action-icon-text {
  color: #B5B5C1;
}

.recipe-circle .action-icon-text {
  color: #E3A37D;
}

.action-label {
  font-size: 24rpx;
  font-weight: 500;
}

.meal-label {
  color: #96AD93;
}

.exercise-label {
  color: #B5B5C1;
}

.recipe-label {
  color: #E3A37D;
}

/* ========================================
   4. 今日三餐列表
   ======================================== */
.meal-section {
  /* 继承 .card 样式 */
}

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.meal-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #424242;
}

.add-btn {
  font-size: 26rpx;
  color: #A6A6B2;
  font-weight: 500;
}

.meal-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meal-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.meal-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.meal-icon-wrap.bf {
  background: rgba(240, 200, 160, 0.3);
}

.meal-icon-wrap.lunch {
  background: rgba(150, 173, 147, 0.3);
}

.meal-icon-wrap.dinner {
  background: rgba(181, 181, 193, 0.3);
}

.meal-icon-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #424242;
}

.meal-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #424242;
}

.meal-detail {
  font-size: 24rpx;
  color: #666666;
}

.meal-cal {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bf-cal {
  color: #F0C8A0;
}

.lunch-cal {
  color: #96AD93;
}

.dinner-cal {
  color: #B5B5C1;
}

/* ========================================
   5. 运动消耗卡片
   ======================================== */
.exercise-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ex-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(212, 152, 143, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ex-icon-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #D49790;
}

.ex-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ex-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #424242;
}

.ex-detail {
  font-size: 24rpx;
  color: #666666;
}

.ex-cal {
  font-size: 32rpx;
  font-weight: 700;
  color: #D49790;
  flex-shrink: 0;
}

/* ========================================
   底部安全区域
   ======================================== */
.safe-area-bottom {
  height: 40rpx;
}
