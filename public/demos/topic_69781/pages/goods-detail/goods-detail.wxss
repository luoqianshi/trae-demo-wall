/* 商品详情页面 */
.goods-detail-page {
  min-height: 100vh;
  background: #F2ECEE;
  padding-bottom: 180rpx;
}

/* 商品图片区 */
.goods-image-section {
  position: relative;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-image-section.sage {
  background: #96AD93;
}

.goods-image-section.lavender {
  background: #B5B5C1;
}

.goods-image-section.rose {
  background: #CC858E;
}

.goods-image-section.orange {
  background: #E3A37D;
}

.back-btn {
  position: absolute;
  top: 40rpx;
  left: 32rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
}

.back-icon {
  font-size: 36rpx;
  color: #A6A6B2;
  font-weight: 600;
}

.goods-image-placeholder {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 100rpx;
}

/* 卡片通用样式 */
.card {
  background: #FFFFFF;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(166, 166, 178, 0.1);
}

/* 区块标题 */
.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4E5969;
}

/* 商品信息卡片 */
.goods-info-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 5;
}

.goods-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.goods-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2129;
  flex: 1;
  margin-right: 20rpx;
}

.goods-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #E3A37D;
}

.goods-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-condition {
  background: rgba(150, 173, 147, 0.15);
  color: #96AD93;
}

.tag-category {
  background: rgba(181, 181, 193, 0.15);
  color: #B5B5C1;
}

.goods-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-icon {
  font-size: 24rpx;
}

.time-text {
  font-size: 26rpx;
  color: #A6A6B2;
}

/* 卖家信息卡片 */
.seller-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.seller-avatar {
  width: 100rpx;
  height: 100rpx;
  background: #E3A37D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-placeholder {
  font-size: 50rpx;
}

.seller-detail {
  flex: 1;
}

.seller-nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 12rpx;
}

.seller-contact {
  display: flex;
  align-items: center;
}

.contact-label {
  font-size: 26rpx;
  color: #A6A6B2;
}

.contact-value {
  font-size: 26rpx;
  color: #96AD93;
  font-weight: 500;
}

/* 商品描述卡片 */
.description-content {
  background: rgba(242, 236, 238, 0.5);
  border-radius: 16rpx;
  padding: 24rpx;
}

.description-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #4E5969;
}

/* 底部操作按钮区 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(166, 166, 178, 0.15);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.action-btn::after {
  border: none;
}

.collect-btn {
  background: rgba(166, 166, 178, 0.1);
  color: #A6A6B2;
}

.collect-btn.collected {
  background: rgba(204, 133, 142, 0.15);
  color: #CC858E;
}

.contact-btn {
  background: #96AD93;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(150, 173, 147, 0.3);
}

.buy-btn {
  background: #E3A37D;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(227, 163, 125, 0.4);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 30rpx;
}

.action-btn:active {
  opacity: 0.9;
}

/* ========== 同类推荐区域 ========== */
.similar-card {
  overflow: hidden;
}

.similar-scroll {
  white-space: nowrap;
  margin: 0 -8rpx;
}

.similar-list {
  display: flex;
  gap: 16rpx;
  padding: 0 8rpx;
  white-space: nowrap;
}

.similar-item {
  display: flex;
  flex-direction: column;
  width: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F2ECEE;
  flex-shrink: 0;
}

.similar-item:active {
  opacity: 0.8;
}

.similar-image {
  position: relative;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.similar-image.goods-image-sage {
  background: #96AD93;
}

.similar-image.goods-image-lavender {
  background: #B5B5C1;
}

.similar-image.goods-image-orange {
  background: #E3A37D;
}

.similar-image.goods-image-rose {
  background: #CC858E;
}

.similar-emoji {
  font-size: 56rpx;
}

.similar-condition {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #4E5969;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.similar-info {
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.similar-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #4E5969;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.similar-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #E3A37D;
}
