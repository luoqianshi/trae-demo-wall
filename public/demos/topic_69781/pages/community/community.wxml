<!-- 社区页面 - 莫兰迪风格 -->
<view class="community-page">
  <!-- 顶部Tab栏 -->
  <view class="tab-container">
    <view class="tab-wrapper">
      <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
        <text class="tab-text">动态</text>
      </view>
      <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
        <text class="tab-text">闲置市场</text>
      </view>
    </view>
  </view>

  <!-- 动态Tab内容 -->
  <view class="content-wrapper" wx:if="{{currentTab === 0}}">
    <view class="post-list">
      <view class="post-card" wx:for="{{posts}}" wx:key="id">
        <!-- 用户信息 -->
        <view class="post-header">
          <view class="avatar-text-wrap" style="background: {{item.avatarColor}}">
            <text class="avatar-letter">{{item.avatarText}}</text>
          </view>
          <view class="user-info">
            <text class="nickname">{{item.nickname}}</text>
            <text class="time">{{item.time}}</text>
          </view>
        </view>

        <!-- 内容 -->
        <view class="post-content">
          <text class="content-text">{{item.content}}</text>
        </view>

        <!-- 互动栏 -->
        <view class="post-actions">
          <view class="action-item" bindtap="toggleLike" data-index="{{index}}">
            <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="action-count {{item.isLiked ? 'liked' : ''}}">{{item.likes}}</text>
          </view>
          <view class="action-item" bindtap="showComment" data-index="{{index}}">
            <text class="action-icon">💬</text>
            <text class="action-count">{{item.comments}}</text>
          </view>
          <view class="action-item">
            <text class="action-icon">↗️</text>
            <text class="action-count">分享</text>
          </view>
        </view>

        <!-- 评论列表 -->
        <view class="comment-section" wx:if="{{item.commentList.length > 0}}">
          <view class="comment-item" wx:for="{{item.commentList}}" wx:key="cid" wx:for-item="comment">
            <text class="comment-user">{{comment.user}}：</text>
            <text class="comment-text">{{comment.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 发布打卡按钮 -->
    <view class="publish-btn" bindtap="showPublish">
      <text>✏️ 发布打卡</text>
    </view>
  </view>

  <!-- 闲置市场Tab内容 -->
  <view wx:if="{{currentTab === 1}}">
    <!-- 分类筛选 -->
    <scroll-view class="category-scroll" scroll-x="true">
      <view class="category-list">
        <view class="category-item {{selectedCategory === '全部' ? 'active' : ''}}" bindtap="selectCategory" data-category="全部">
          <text>全部</text>
        </view>
        <view class="category-item {{selectedCategory === '健身器材' ? 'active' : ''}}" bindtap="selectCategory" data-category="健身器材">
          <text>健身器材</text>
        </view>
        <view class="category-item {{selectedCategory === '运动服饰' ? 'active' : ''}}" bindtap="selectCategory" data-category="运动服饰">
          <text>运动服饰</text>
        </view>
        <view class="category-item {{selectedCategory === '营养补剂' ? 'active' : ''}}" bindtap="selectCategory" data-category="营养补剂">
          <text>营养补剂</text>
        </view>
        <view class="category-item {{selectedCategory === '其他' ? 'active' : ''}}" bindtap="selectCategory" data-category="其他">
          <text>其他</text>
        </view>
      </view>
    </scroll-view>

    <!-- 品牌推荐横幅区 -->
    <view class="brand-section">
      <view class="brand-header">
        <text class="brand-title">品牌好物推荐</text>
        <text class="brand-join-link" bindtap="showBrandJoin">入驻合作</text>
      </view>
      <scroll-view class="brand-scroll" scroll-x="true">
        <view class="brand-list">
          <view class="brand-card brand-sage" wx:for="{{brands}}" wx:key="id" wx:if="{{index === 0}}">
            <text class="brand-emoji">{{item.emoji}}</text>
            <text class="brand-name">{{item.name}}</text>
            <text class="brand-desc">{{item.desc}}</text>
            <view class="brand-enter-btn">
              <text class="brand-enter-text">进店看看</text>
            </view>
          </view>
          <view class="brand-card brand-orange" wx:for="{{brands}}" wx:key="id" wx:if="{{index === 1}}">
            <text class="brand-emoji">{{item.emoji}}</text>
            <text class="brand-name">{{item.name}}</text>
            <text class="brand-desc">{{item.desc}}</text>
            <view class="brand-enter-btn">
              <text class="brand-enter-text">进店看看</text>
            </view>
          </view>
          <view class="brand-card brand-lavender" wx:for="{{brands}}" wx:key="id" wx:if="{{index === 2}}">
            <text class="brand-emoji">{{item.emoji}}</text>
            <text class="brand-name">{{item.name}}</text>
            <text class="brand-desc">{{item.desc}}</text>
            <view class="brand-enter-btn">
              <text class="brand-enter-text">进店看看</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 商品列表 - 使用简单flex布局避免grid卡死 -->
    <view class="goods-container">
      <view class="goods-row">
        <view class="goods-item" wx:for="{{filteredGoods}}" wx:key="id" bindtap="goToGoodsDetail" data-id="{{item.id}}">
          <view class="goods-image goods-image-{{item.imgClass}}">
            <text class="goods-emoji">{{item.emoji}}</text>
            <text class="condition-tag">{{item.condition}}</text>
          </view>
          <view class="goods-info">
            <text class="goods-name">{{item.name}}</text>
            <view class="goods-meta">
              <text class="goods-price">¥{{item.price}}</text>
              <text class="goods-category">{{item.category}}</text>
            </view>
            <view class="seller-info">
              <text class="seller-name">{{item.seller}}</text>
              <text class="seller-time">{{item.time}}</text>
            </view>
            <view class="want-btn" catchtap="wantItem" data-id="{{item.id}}">
              <text>想要</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部占位，防止内容被按钮遮挡 -->
    <view class="bottom-spacer"></view>
  </view>

  <!-- 发布闲置物品悬浮按钮 -->
  <view class="fab-publish" wx:if="{{currentTab === 1}}" bindtap="publishGoods">
    <text class="fab-icon">+</text>
    <text class="fab-text">发布闲置</text>
  </view>

  <!-- 发布打卡弹窗 -->
  <view class="modal-mask" wx:if="{{showPublishModal}}" bindtap="cancelPublish"></view>
  <view class="publish-modal" wx:if="{{showPublishModal}}">
    <view class="modal-header">
      <text class="modal-title">发布打卡</text>
      <text class="close-btn" bindtap="cancelPublish">✕</text>
    </view>
    <textarea
      class="publish-textarea"
      value="{{newPostContent}}"
      bindinput="onContentInput"
      placeholder="分享你的健身日常..."
      maxlength="500"
      auto-height
      focus="{{showPublishModal}}"
    ></textarea>
    <!-- 图片上传区域 -->
    <view class="image-upload-area">
      <view class="image-upload-list">
        <view class="image-upload-item" wx:for="{{postImages}}" wx:key="index">
          <image class="upload-thumb" src="{{item}}" mode="aspectFill" bindtap="previewPostImage" data-index="{{index}}"></image>
          <view class="image-delete-btn" catchtap="deleteImage" data-index="{{index}}">✕</view>
        </view>
        <view class="image-upload-add" wx:if="{{postImages.length < maxImageCount}}" bindtap="chooseImage">
          <text class="add-icon">+</text>
          <text class="add-text">添加图片</text>
        </view>
      </view>
      <view class="image-count-tip">{{postImages.length}}/{{maxImageCount}}</view>
    </view>
    <view class="char-count">{{newPostContent.length}}/500</view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="cancelPublish">取消</button>
      <button class="submit-btn {{!newPostContent.trim() ? 'disabled' : ''}}" bindtap="publishPost">发布</button>
    </view>
  </view>

  <!-- 评论弹窗 -->
  <view class="modal-mask" wx:if="{{showCommentModal}}" bindtap="cancelComment"></view>
  <view class="comment-modal" wx:if="{{showCommentModal}}">
    <view class="modal-header">
      <text class="modal-title">发表评论</text>
      <text class="close-btn" bindtap="cancelComment">✕</text>
    </view>
    <input
      class="comment-input"
      value="{{newCommentContent}}"
      bindinput="onCommentInput"
      placeholder="写下你的评论..."
      focus="{{showCommentModal}}"
      confirm-type="send"
      bindconfirm="submitComment"
    />
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="cancelComment">取消</button>
      <button class="submit-btn {{!newCommentContent.trim() ? 'disabled' : ''}}" bindtap="submitComment">发送</button>
    </view>
  </view>

  <!-- 品牌入驻弹窗 -->
  <view class="modal-mask" wx:if="{{showBrandModal}}" bindtap="hideBrandModal"></view>
  <view class="brand-modal" wx:if="{{showBrandModal}}">
    <view class="modal-header">
      <text class="modal-title">品牌入驻合作</text>
      <text class="close-btn" bindtap="hideBrandModal">✕</text>
    </view>
    <view class="brand-modal-content">
      <view class="join-step">
        <view class="step-icon-wrap join-step-1">1</view>
        <view class="step-detail">
          <text class="step-title">提交入驻申请</text>
          <text class="step-desc">添加合作微信，提交品牌资料和营业执照</text>
        </view>
      </view>
      <view class="join-step">
        <view class="step-icon-wrap join-step-2">2</view>
        <view class="step-detail">
          <text class="step-title">资质审核</text>
          <text class="step-desc">1-3个工作日内完成审核</text>
        </view>
      </view>
      <view class="join-step">
        <view class="step-icon-wrap join-step-3">3</view>
        <view class="step-detail">
          <text class="step-title">上架商品</text>
          <text class="step-desc">审核通过后即可上架品牌商品</text>
        </view>
      </view>
      <view class="join-contact">
        <text class="join-contact-label">合作微信号：</text>
        <text class="join-contact-value">FitMarket_Brand</text>
      </view>
      <button class="join-copy-btn" bindtap="copyBrandWechat">复制微信号，联系入驻</button>
    </view>
  </view>
</view>
