<?xml version='1.0' encoding='utf-8'?>
<widget id="com.example.laohuangli" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>老黄历</name>
    <description>
        图文并茂的老黄历，大字号大图标，方便查看每日宜忌
    </description>
    <author email="dev@example.com" href="https://example.com">
        Dev Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />
    <preference name="BackgroundColor" value="#FFF8F0" />
</widget>
