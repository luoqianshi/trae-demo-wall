RewriteEngine On
# 如果部署在子目录，请将下一行改为对应路径，例如 RewriteBase /community/
RewriteBase /

# ★ 关键：Apache 默认剥离 Authorization 头，必须显式传递，否则 PHP 无法获取登录 token
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# 所有 /api/* 请求统一交给 api/index.php 处理（api/index.php 已处理 CORS 预检）
# 注意：不判断 !-f，防止直接访问 api/lib.php 等内部文件
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# 前端路由（如果以后需要单页应用路由可开启）
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ index.html [L]
