/* ===== 教师后台页 ===== */
.teacher-page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

/* 等级切换标签 */
.level-tabs {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.level-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.level-tab-active {
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255,107,74,0.3);
}

/* 数据总览卡片 */
.overview-section {
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.overview-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF6B4A;
  line-height: 1.2;
}

.overview-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.overview-divider {
  width: 2rpx;
  height: 60rpx;
  background: #f0f0f0;
}

/* 及格率卡片 */
.pass-rate-card {
  margin: 0 30rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.pass-rate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.pass-rate-title {
  font-size: 26rpx;
  color: #666;
}

.pass-rate-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #2ED573;
}

.pass-rate-bar-bg {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.pass-rate-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #2ED573, #7BED9F);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 校区数据列表 */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  padding: 10rpx 30rpx 20rpx;
}

.campus-list {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.campus-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: transform 0.2s;
}

.campus-card:active {
  transform: scale(0.98);
}

.campus-rank {
  width: 60rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 6rpx;
}

.campus-medal {
  font-size: 40rpx;
}

.campus-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #ccc;
}

.campus-info {
  flex: 1;
  min-width: 0;
}

.campus-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.campus-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.campus-more {
  font-size: 24rpx;
  color: #FF6B4A;
}

.campus-stats {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.campus-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #F5F7FA;
  padding: 12rpx 8rpx;
  border-radius: 10rpx;
}

.campus-stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.campus-stat-highlight {
  color: #FF6B4A;
}

.campus-stat-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 完成率进度条 */
.campus-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.campus-progress-label {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

.campus-progress-bar {
  flex: 1;
  height: 10rpx;
  background: #f0f0f0;
  border-radius: 5rpx;
  overflow: hidden;
}

.campus-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B4A, #FF8E6B);
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.campus-progress-text {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
  min-width: 50rpx;
  text-align: right;
}

/* 空状态 */
.empty-section {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #ccc;
}