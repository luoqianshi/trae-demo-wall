.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F0 0%, #FFFFFF 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 60rpx;
}

/* 顶部装饰 */
.header-decoration {
  width: 100%;
  height: 200rpx;
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  border-radius: 0 0 50% 50%;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -100rpx;
  margin-bottom: 40rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 74, 0.25);
  text-align: center;
  line-height: 120rpx;
}

.logo-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF6B4A;
  margin-top: 20rpx;
  letter-spacing: 6rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 10rpx;
  letter-spacing: 4rpx;
}

/* 表单卡片 */
.form-card {
  width: 85%;
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* 头像昵称区域 */
.avatar-section {
  display: flex;
  align-items: center;
  padding-bottom: 30rpx;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B4A;
}

.avatar-placeholder {
  background: #f0f0f0;
}

.avatar-btn {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #FF6B4A;
  background: none;
  border: none;
  padding: 0;
  line-height: 1.4;
}

.avatar-btn::after {
  border: none;
}

.nickname-wrapper {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}

.nickname-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.nickname-input {
  font-size: 32rpx;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #eee;
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  background: #FFF8F5;
  border: 2rpx solid #FFE8E0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
}

.picker-placeholder {
  color: #bbb;
}

.picker-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: bold;
}

.text-input {
  padding: 22rpx 28rpx;
  background: #FFF8F5;
  border: 2rpx solid #FFE8E0;
  border-radius: 16rpx;
  font-size: 30rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  margin-top: 40rpx;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 74, 0.35);
  letter-spacing: 4rpx;
}

.login-btn[disabled] {
  background: #ddd;
  box-shadow: none;
  color: #999;
}

.login-btn:not([disabled]):active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 底部说明 */
.footer-text {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 教师独立登录入口 */
.teacher-entry {
  margin-top: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  color: #aaa;
  border: 2rpx solid #e8e8e8;
  border-radius: 30rpx;
  text-align: center;
  transition: all 0.2s;
}

.teacher-entry:active {
  color: #FF6B4A;
  border-color: #FF6B4A;
  background: #FFF5F0;
}