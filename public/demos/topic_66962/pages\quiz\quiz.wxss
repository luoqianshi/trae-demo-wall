.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #FFF5F0;
}

/* 进度条 */
.progress-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.score-text {
  font-size: 30rpx;
  color: #FF6B4A;
  font-weight: 700;
}

.progress-bar-bg {
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B4A, #FF8E6B);
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

/* 题目区域 */
.question-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.question-tag {
  display: inline-block;
  background: #FFF3E0;
  color: #E65100;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 选项按钮 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  transition: all 0.25s ease;
  position: relative;
}

.option-item:active {
  transform: scale(0.98);
}

.option-item.selected {
  background: #FFF3E0;
  border-color: #FF6B4A;
}

.option-item.correct {
  background: #E8F5E9;
  border-color: #4CAF50;
}

.option-item.wrong {
  background: #FFEBEE;
  border-color: #F44336;
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #E0E0E0;
  color: #666;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-label.selected {
  background: #FF6B4A;
  color: #fff;
}

.option-label.correct {
  background: #4CAF50;
  color: #fff;
}

.option-label.wrong {
  background: #F44336;
  color: #fff;
}

.option-text {
  font-size: 32rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
}

.option-result-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.option-item.correct .option-result-icon {
  color: #4CAF50;
}

.option-item.wrong .option-result-icon {
  color: #F44336;
}

/* 反馈区域 */
.feedback-section {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  animation: fadeInUp 0.4s ease;
}

.feedback-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}

.feedback-title.correct {
  color: #2E7D32;
  background: #E8F5E9;
}

.feedback-title.wrong {
  color: #C62828;
  background: #FFEBEE;
}

.explain-box {
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 24rpx;
}

.explain-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #F57F17;
  display: block;
  margin-bottom: 12rpx;
}

.explain-text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.7;
}

/* 操作按钮 */
.action-section {
  margin-top: 36rpx;
  text-align: center;
}

.action-btn {
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 80rpx;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255,107,74,0.3);
  display: inline-block;
}

.action-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.result-btn {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  box-shadow: 0 6rpx 20rpx rgba(76,175,80,0.3);
}

/* 撒花动画 */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  top: -20rpx;
  width: 16rpx;
  height: 24rpx;
  border-radius: 4rpx;
  animation: confettiFall linear infinite;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes confettiFall {
  0% {
    transform: translateY(-40rpx) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(120vh) rotate(720deg);
    opacity: 0;
  }
}

/* 单题答对小撒花 */
.mini-confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
}

.mini-confetti-piece {
  position: absolute;
  border-radius: 50%;
  animation: miniPop 0.6s ease-out forwards;
}

@keyframes miniPop {
  0% { transform: scale(0) rotate(0deg); opacity: 1; }
  50% { transform: scale(1.5) rotate(180deg); opacity: 0.8; }
  100% { transform: scale(0) rotate(360deg); opacity: 0; }
}