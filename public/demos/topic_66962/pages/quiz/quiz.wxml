<view class="container">
  <!-- 顶部进度条 -->
  <view class="progress-section">
    <view class="progress-info">
      <text class="progress-text">第{{currentIndex + 1}}题 / 共{{totalQuestions}}题</text>
      <text class="score-text">得分：{{score}}分</text>
    </view>
    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <!-- 题目区域 -->
  <view class="question-section" wx:if="{{questions.length > 0 && currentIndex < totalQuestions}}">
    <view class="question-tag">{{currentQuestion.tag}}</view>
    <view class="question-text">{{currentQuestion.q}}</view>

    <!-- 选项按钮 -->
    <view class="options-list">
      <view 
        class="option-item {{optionClasses[index]}}"
        wx:for="{{currentQuestion.options}}" 
        wx:key="*this" 
        data-index="{{index}}"
        bindtap="selectOption"
      >
        <view class="option-label {{optionLabelClasses[index]}}">
          {{optionLabels[index]}}
        </view>
        <text class="option-text">{{item}}</text>
        <view class="option-result-icon" wx:if="{{answered}}">
          <text wx:if="{{index === currentQuestion.answer}}">✓</text>
          <text wx:elif="{{selectedIndex === index && index !== currentQuestion.answer}}">✗</text>
        </view>
      </view>
    </view>

    <!-- 答题反馈 -->
    <view class="feedback-section" wx:if="{{answered}}">
      <view class="feedback-title {{isCorrect ? 'correct' : 'wrong'}}">
        <text wx:if="{{isCorrect}}">回答正确！太棒了！</text>
        <text wx:else>答错了，看看解析吧~</text>
      </view>
      <view class="explain-box">
        <text class="explain-label">解析</text>
        <text class="explain-text">{{currentExplainText}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section" wx:if="{{answered}}">
      <button class="action-btn" wx:if="{{currentIndex < totalQuestions - 1}}" bindtap="nextQuestion">下一题</button>
      <button class="action-btn result-btn" wx:else bindtap="showResult">查看成绩</button>
    </view>
  </view>

  <!-- 撒花动画 -->
  <view class="confetti-container" wx:if="{{showConfetti}}">
    <view class="confetti-piece" wx:for="{{confettiPieces}}" wx:key="*this" style="left: {{item.left}}%; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s; background: {{item.color}};"></view>
  </view>

  <!-- 单题答对撒花（小规模） -->
  <view class="mini-confetti-container" wx:if="{{miniConfetti && miniConfetti.length > 0}}">
    <view class="mini-confetti-piece" wx:for="{{miniConfetti}}" wx:for-item="piece" wx:key="*this"
      style="left: {{piece.left}}%; top: {{piece.top}}%; width: {{piece.size}}rpx; height: {{piece.size}}rpx; background: {{piece.color}}; transform: rotate({{piece.rotate}}deg); animation-delay: {{piece.delay}}s;">
    </view>
  </view>
</view>