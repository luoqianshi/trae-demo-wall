.badge-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFF5EE 30%, #FFF0E8 100%);
  position: relative;
  overflow-x: hidden;
  padding-bottom: 40rpx;
}

/* 装饰背景 */
.badge-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.bgc-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.06;
}

.c1 { width: 400rpx; height: 400rpx; background: #FF6B4A; top: -100rpx; right: -80rpx; }
.c2 { width: 300rpx; height: 300rpx; background: #FFD54F; bottom: 300rpx; left: -120rpx; }
.c3 { width: 250rpx; height: 250rpx; background: #2EC4B6; bottom: -60rpx; right: -40rpx; }

/* 顶部标题 */
.badge-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx 16rpx;
  gap: 20rpx;
}

.badge-header-img {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.badge-header-text {
  flex: 1;
}

.badge-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #FF6B4A;
  display: block;
}

.badge-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 等级切换 - 参考效果图风格 */
.level-switch {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 0 30rpx 20rpx;
  gap: 16rpx;
}

.lv-tab {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #eee;
  transition: all 0.3s;
}

.lv-active {
  color: #FF6B4A;
  background: #FFF5F0;
  border-color: #FF6B4A;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 74, 0.12);
}

/* ===== 徽章网格 - 参考效果图 3列布局 ===== */
.badge-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.badge-item {
  width: calc(33.33% - 24rpx);
  margin: 12rpx;
  padding: 28rpx 10rpx 22rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  transition: transform 0.2s;
  min-height: 220rpx;
}

.badge-item:active {
  transform: scale(0.95);
}

/* 已点亮 - 参考效果图暖色风格 */
.badge-earned {
  background: linear-gradient(180deg, #FFF8E8 0%, #FFF0D0 100%);
  border: 3rpx solid #FFB74D;
  box-shadow: 0 4rpx 20rpx rgba(255, 183, 77, 0.2);
}

/* 未点亮 - 灰色系 */
.badge-locked {
  background: #fafafa;
  border: 2rpx solid #eee;
}

.badge-icon-box {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.badge-icon-text {
  font-size: 52rpx;
  display: block;
}

/* 已点亮徽章名 - 深色 */
.bdg-name {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bdg-name-on { color: #E65100; }
.bdg-name-off { color: #bbb; }

/* 课程名 - 小字 */
.bdg-course {
  font-size: 20rpx;
  margin-top: 6rpx;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bdg-course-on { color: #A1887F; }
.bdg-course-off { color: #ddd; }