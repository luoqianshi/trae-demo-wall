/* ===== 答题结果页 ===== */
.result-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 得分总览 */
.score-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(180deg, #FF6B4A 0%, #FF8E6B 100%);
  color: #fff;
}

.score-circle {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.score-inner {
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 30rpx;
}

.score-number {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
}

.score-total {
  font-size: 32rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}

.score-bar {
  width: 60%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.score-bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.6s ease;
}

.score-label {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 统计数据行 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  margin: 0 30rpx;
  padding: 30rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transform: translateY(-30rpx);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B4A;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: #f0f0f0;
}

/* 错题回顾 */
.review-section {
  padding: 0 30rpx;
  margin-top: 10rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding: 0 10rpx;
}

.section-title-icon {
  margin-right: 12rpx;
}

.section-title-count {
  font-size: 26rpx;
  font-weight: 400;
  color: #999;
  margin-left: auto;
}

.wrong-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wrong-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border-left: 8rpx solid #FF4757;
}

.wrong-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.wrong-number {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.wrong-tag {
  font-size: 22rpx;
  color: #fff;
  background: #FF4757;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.wrong-question {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.wrong-options {
  margin-bottom: 16rpx;
}

.option-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
  position: relative;
}

.option-label {
  font-size: 28rpx;
  color: #666;
  flex: 1;
  line-height: 1.5;
}

.option-correct {
  color: #2ED573;
  font-weight: 600;
}

.option-wrong {
  color: #FF4757;
  font-weight: 600;
  text-decoration: line-through;
}

.option-mark {
  font-size: 22rpx;
  margin-left: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.mark-correct {
  color: #2ED573;
}

.mark-wrong {
  color: #FF4757;
}

.wrong-explanation {
  background: #FFF8F0;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.explanation-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF8E6B;
}

.explanation-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 空状态 */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 操作按钮 */
.action-section {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}

/* 撒花容器 */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 999;
  overflow: hidden;
}

.confetti-item {
  position: absolute;
  top: -60rpx;
  font-size: 48rpx;
  animation: confetti-fall 2.5s ease-in forwards;
}

@keyframes confetti-fall {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(120vh) rotate(720deg);
    opacity: 0;
  }
}