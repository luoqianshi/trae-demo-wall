<view class="result-page">
  <!-- 撒花效果 -->
  <view class="confetti-container" wx:if="{{confettiItems}}">
    <view class="confetti-item" wx:for="{{confettiItems}}" wx:key="*this"
      style="left: {{item.left}}%; animation-delay: {{item.delay}}ms; animation-duration: {{item.duration}}ms;">
      {{item.emoji}}
    </view>
  </view>

  <!-- 得分总览区域 -->
  <view class="score-section">
    <view class="score-circle">
      <view class="score-inner">
        <text class="score-number">{{correct}}</text>
        <text class="score-total">/ {{total}}</text>
      </view>
    </view>
    <view class="score-bar">
      <view class="score-bar-fill" style="width: {{pct}}%"></view>
    </view>
    <text class="score-label">{{evaluation}}</text>
  </view>

  <!-- 统计数据 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-value">{{pct}}%</text>
      <text class="stat-label">正确率</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{score}}</text>
      <text class="stat-label">得分</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{wrongCount}}</text>
      <text class="stat-label">错题数</text>
    </view>
  </view>

  <!-- 错题回顾区域 -->
  <view class="review-section" wx:if="{{wrongList.length > 0}}">
    <view class="section-title">
      <text class="section-title-icon">📝</text>
      <text>错题回顾</text>
      <text class="section-title-count">共{{wrongList.length}}题</text>
    </view>

    <view class="wrong-list">
      <view class="wrong-card" wx:for="{{wrongList}}" wx:for-index="idx" wx:for-item="wrong" wx:key="index">
        <view class="wrong-header">
          <text class="wrong-number">第{{idx+1}}题</text>
          <text class="wrong-tag">答错</text>
        </view>
        <view class="wrong-question">{{wrong.question}}</view>
        <view class="wrong-options">
          <view class="option-row" wx:for="{{wrong.options}}" wx:for-index="optIdx" wx:for-item="optionItem" wx:key="optIdx">
            <text class="option-label {{optIdx === wrong.correctIndex ? 'option-correct' : (optIdx === wrong.userAnswer ? 'option-wrong' : '')}}">
              {{optionLabelMap[optIdx]}}. {{optionItem}}
            </text>
            <text class="option-mark {{optIdx === wrong.correctIndex ? 'mark-correct' : (optIdx === wrong.userAnswer ? 'mark-wrong' : '')}}" wx:if="{{optIdx === wrong.correctIndex || optIdx === wrong.userAnswer}}">
              {{optIdx === wrong.correctIndex ? '✓ 正确答案' : '✗ 你的选择'}}
            </text>
          </view>
        </view>
        <view class="wrong-explanation">
          <text class="explanation-label">💡 解析：</text>
          <text class="explanation-text">{{wrong.explanation}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态：没有错题 -->
  <view class="empty-section" wx:if="{{wrongList.length === 0}}">
    <view class="empty-icon">🎉</view>
    <view class="empty-text">全部答对，太厉害了！</view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="btn-primary action-btn" bindtap="onRetry">再做一遍</button>
    <button class="btn-secondary action-btn" bindtap="onBackToCourse">返回课程</button>
  </view>
</view>