.index-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0E8 0%, #FFF8F5 40%, #F8F9FF 100%);
  padding-bottom: 40rpx;
  position: relative;
  overflow-x: hidden;
}

/* ===== 装饰背景元素 ===== */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.bg-circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #FF6B4A;
  top: -120rpx;
  right: -80rpx;
}

.bg-circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #2EC4B6;
  bottom: 200rpx;
  left: -100rpx;
}

.bg-circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: #FFD54F;
  top: 50%;
  right: -50rpx;
}

.bg-star {
  position: absolute;
  font-size: 40rpx;
  animation: floatStar 3s ease-in-out infinite;
}

.bg-star-1 { top: 10%; left: 10%; animation-delay: 0s; }
.bg-star-2 { top: 15%; right: 15%; animation-delay: 1s; }
.bg-star-3 { top: 30%; left: 5%; animation-delay: 0.5s; }

@keyframes floatStar {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(15deg); }
}

/* ===== 用户信息栏 ===== */
.user-header {
  position: relative;
  padding: 50rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
  z-index: 1;
}

.user-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B, #FFB088);
  border-radius: 0 0 40rpx 40rpx;
  z-index: -1;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 74, 0.25);
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.user-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.user-detail {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

/* 头部装饰元素 */
.header-deco {
  position: absolute;
  font-size: 36rpx;
  animation: floatDeco 3s ease-in-out infinite;
}

.deco-1 { top: 20rpx; right: 50rpx; animation-delay: 0s; }
.deco-2 { bottom: 10rpx; right: 100rpx; animation-delay: 0.7s; }
.deco-3 { top: 45rpx; right: 20rpx; animation-delay: 1.4s; }

@keyframes floatDeco {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-12rpx) rotate(8deg); }
}

/* 设置按钮 - 内嵌在用户名旁 */
.settings-icon {
  font-size: 30rpx;
  opacity: 0.6;
  padding: 4rpx 0 4rpx 10rpx;
  transition: opacity 0.2s, transform 0.2s;
}

.settings-icon:active {
  opacity: 1;
  transform: scale(1.15);
}

.user-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* ===== 卡通形象区 ===== */
.mascot-section {
  position: relative;
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  z-index: 1;
}

.mascot-img {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  animation: mascotBounce 3s ease-in-out infinite;
}

@keyframes mascotBounce {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-12rpx) scale(1.03); }
}

.mascot-speech {
  margin-left: 20rpx;
  background: #fff;
  padding: 24rpx 30rpx;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative;
  flex: 1;
}

.mascot-speech::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 30rpx;
  width: 0;
  height: 0;
  border: 16rpx solid transparent;
  border-right-color: #fff;
  border-left: 0;
}

.mascot-speech-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.mascot-speech-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  margin-bottom: 20rpx;
}

.section-header-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.section-header-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

/* ===== 等级卡片区 ===== */
.level-section {
  padding: 10rpx 20rpx;
  z-index: 1;
  position: relative;
}

.level-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.level-card {
  border-radius: 28rpx;
  overflow: hidden;
  transition: transform 0.2s;
  position: relative;
}

.level-card:active {
  transform: scale(0.97);
}

.level-card-orange {
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B, #FFA07A);
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 74, 0.3);
}

.level-card-teal {
  background: linear-gradient(135deg, #2EC4B6, #4AD9C8, #6BE0D4);
  box-shadow: 0 8rpx 30rpx rgba(46, 196, 182, 0.3);
}

.level-card-top {
  padding: 28rpx 30rpx 16rpx;
}

.level-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.level-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
}

.level-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 300;
}

.level-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.level-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
  display: block;
}

.level-card-bottom {
  display: flex;
  align-items: center;
  padding: 0 30rpx 24rpx;
}

.progress-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.progress-fill-orange {
  background: #fff;
}

.progress-fill-teal {
  background: #fff;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 16rpx;
  white-space: nowrap;
}

.level-card-icon {
  font-size: 52rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  flex-shrink: 0;
}

/* ===== 学习数据区 ===== */
.stats-section {
  padding: 10rpx 20rpx;
  z-index: 1;
  position: relative;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  border-radius: 22rpx;
  padding: 28rpx 12rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s;
}

.stat-card:active {
  transform: scale(0.95);
}

.stat-card-1 {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
}

.stat-card-2 {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.stat-card-3 {
  background: linear-gradient(135deg, #FCE4EC, #F8BBD0);
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 800;
  color: #333;
}

.stat-card-1 .stat-number { color: #E65100; }
.stat-card-2 .stat-number { color: #2E7D32; }
.stat-card-3 .stat-number { color: #C62828; }
.stat-card-4 .stat-number { color: #E65100; }
.stat-card-4 {
  background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}