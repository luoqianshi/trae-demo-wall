<view class="index-page">
  <!-- 装饰性背景元素 -->
  <view class="bg-decoration">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
    <view class="bg-circle bg-circle-3"></view>
    <view class="bg-star bg-star-1">⭐</view>
    <view class="bg-star bg-star-2">🌟</view>
    <view class="bg-star bg-star-3">✨</view>
  </view>

  <!-- 顶部用户信息栏 -->
  <view class="user-header">
    <view class="user-header-bg"></view>
    <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info">
      <view class="user-name-row">
        <text class="user-name">{{userInfo.nickName || '文学小达人'}}</text>
        <text class="settings-icon" bindtap="onUserSettings">⚙️</text>
      </view>
      <text class="user-detail">{{userInfo.regionName || userInfo.province || '未知地区'}} · {{userInfo.grade || ''}}</text>
    </view>
    <!-- 装饰小元素 -->
    <view class="header-deco deco-1">🌸</view>
    <view class="header-deco deco-2">📚</view>
    <view class="header-deco deco-3">🎯</view>
  </view>

  <!-- 卡通形象区 -->
  <view class="mascot-section">
    <image class="mascot-img" src="/images/kid.png" mode="aspectFit" />
    <view class="mascot-speech">
      <text class="mascot-speech-text">欢迎回来，{{userInfo.realName || userInfo.nickName || '同学'}}！</text>
      <text class="mascot-speech-sub">今天也要继续加油哦 💪</text>
    </view>
  </view>

  <!-- 等级卡片选择区 -->
  <view class="level-section">
    <view class="section-header">
      <text class="section-header-icon">📖</text>
      <text class="section-header-text">选择课程</text>
    </view>

    <view class="level-cards">
      <!-- 文学一级 -->
      <view class="level-card level-card-orange" bindtap="goLevel1">
        <view class="level-card-top">
          <view class="level-badge-row">
            <text class="level-badge level-badge-orange">一级</text>
            <text class="level-arrow">›</text>
          </view>
          <text class="level-title">文学一级</text>
          <text class="level-desc">先秦至隋唐文学</text>
        </view>
        <view class="level-card-bottom">
          <view class="progress-wrapper">
            <view class="progress-bar">
              <view class="progress-fill progress-fill-orange" style="width: {{level1Progress}}%"></view>
            </view>
            <text class="progress-text">{{level1Completed}}/{{level1Total}} 已学</text>
          </view>
          <view class="level-card-icon">🏮</view>
        </view>
      </view>

      <!-- 文学二级 -->
      <view class="level-card level-card-teal" bindtap="goLevel2">
        <view class="level-card-top">
          <view class="level-badge-row">
            <text class="level-badge level-badge-teal">二级</text>
            <text class="level-arrow">›</text>
          </view>
          <text class="level-title">文学二级</text>
          <text class="level-desc">宋元至外国文学</text>
        </view>
        <view class="level-card-bottom">
          <view class="progress-wrapper">
            <view class="progress-bar">
              <view class="progress-fill progress-fill-teal" style="width: {{level2Progress}}%"></view>
            </view>
            <text class="progress-text">{{level2Completed}}/{{level2Total}} 已学</text>
          </view>
          <view class="level-card-icon">🌍</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 学习数据小卡片 -->
  <view class="stats-section">
    <view class="section-header">
      <text class="section-header-icon">📊</text>
      <text class="section-header-text">学习数据</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card stat-card-1">
        <view class="stat-icon">📝</view>
        <text class="stat-number">{{totalAnswers}}</text>
        <text class="stat-label">答题总数</text>
      </view>
      <view class="stat-card stat-card-2">
        <view class="stat-icon">🎯</view>
        <text class="stat-number">{{accuracyRate}}%</text>
        <text class="stat-label">正确率</text>
      </view>
      <view class="stat-card stat-card-3">
        <view class="stat-icon">🔥</view>
        <text class="stat-number">{{maxStreak}}</text>
        <text class="stat-label">连续答对</text>
      </view>
      <view class="stat-card stat-card-4" bindtap="goWrong">
        <view class="stat-icon">📕</view>
        <text class="stat-number">{{wrongCount}}</text>
        <text class="stat-label">错题汇总 ›</text>
      </view>
    </view>
  </view>
</view>