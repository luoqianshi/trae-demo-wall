.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F0 0%, #FFF8F5 40%, #F5F7FF 100%);
  padding: 20rpx 20rpx 40rpx;
}

/* ===== 页面标题栏（替代等级切换 Tab） ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255,255,255,0.7);
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.page-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.page-header-icon {
  font-size: 40rpx;
}

.page-header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.page-header-sub {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.page-header-count {
  font-size: 24rpx;
  color: #bbb;
  font-weight: 500;
}

/* ===== 课程网格 - 2列 ===== */
.course-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

/* ===== 方块卡片 ===== */
.course-card {
  display: flex;
  flex-direction: column;
  border-radius: 24rpx;
  overflow: hidden;
  aspect-ratio: 0.8;
  background: #fff;
  border: 2rpx solid rgba(0,0,0,0.06);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: transform 0.2s;
}

.course-card:active {
  transform: scale(0.96);
}

/* ===== 顶部：标题 + 状态 ===== */
.card-top {
  padding: 20rpx 18rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  font-weight: 500;
  align-self: flex-start;
}

.card-status.completed {
  color: #388E3C;
  background: rgba(76,175,80,0.12);
}

.card-status.in_progress {
  color: #E65100;
  background: rgba(255,152,0,0.12);
}

.card-status.not_started {
  color: #999;
  background: rgba(0,0,0,0.04);
}

/* ===== 中间：插图区域 ===== */
.card-img-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: contain;
}

/* ===== 底部：A组 / B组 ===== */
.card-sets {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  padding: 12rpx 18rpx 18rpx;
}

/* 未答题 - 灰色 */
.card-set {
  flex: 1;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 800;
  transition: all 0.2s;
  background: #fff;
  color: #bbb;
  border: 2rpx solid rgba(0,0,0,0.08);
}

.card-set:active {
  transform: scale(0.92);
  background: #f5f5f5;
  border-color: rgba(0,0,0,0.15);
}

/* 已答题 - 绿色点亮 */
.card-set.completed {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  border-color: #81C784;
  color: #2E7D32;
  box-shadow: 0 2rpx 8rpx rgba(76,175,80,0.15);
}

.card-set.completed:active {
  background: linear-gradient(135deg, #C8E6C9, #A5D6A7);
}