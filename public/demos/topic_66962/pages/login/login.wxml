<view class="login-page">
  <!-- 顶部装饰 -->
  <view class="header-decoration"></view>

  <!-- Logo/标题区域 -->
  <view class="logo-section">
    <view class="logo-icon">📖</view>
    <view class="logo-title">花开远方</view>
    <view class="logo-subtitle">文学知识小达人</view>
  </view>

  <!-- 登录表单卡片 -->
  <view class="form-card">
    <!-- 微信头像昵称获取 -->
    <view class="avatar-section">
      <view class="avatar-wrapper">
        <image class="avatar {{!avatarUrl ? 'avatar-placeholder' : ''}}" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          {{avatarUrl ? '更换头像' : '获取微信头像'}}
        </button>
      </view>
      <view class="nickname-wrapper">
        <text class="nickname-label">昵称</text>
        <input class="nickname-input" type="nickname" placeholder="请输入或使用微信昵称" value="{{nickName}}" bindinput="onNicknameInput" />
      </view>
    </view>

    <!-- 省份选择 -->
    <view class="form-item">
      <text class="form-label">省份</text>
      <picker mode="selector" range="{{provinceNames}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
        <view class="picker-box {{provinceIndex === -1 ? 'picker-placeholder' : ''}}">
          {{provinceIndex !== -1 ? provinceNames[provinceIndex] : '请选择省份'}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 城市选择 -->
    <view class="form-item">
      <text class="form-label">城市</text>
      <picker mode="selector" range="{{cityNames}}" value="{{cityIndex}}" bindchange="onCityChange" disabled="{{cityNames.length === 0}}">
        <view class="picker-box {{cityIndex === -1 ? 'picker-placeholder' : ''}}">
          {{cityIndex !== -1 ? cityNames[cityIndex] : '请先选择省份'}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 区/县选择 -->
    <view class="form-item">
      <text class="form-label">区/县</text>
      <picker mode="selector" range="{{districtNames}}" value="{{districtIndex}}" bindchange="onDistrictChange" disabled="{{districtNames.length === 0}}">
        <view class="picker-box {{districtIndex === -1 ? 'picker-placeholder' : ''}}">
          {{districtIndex !== -1 ? districtNames[districtIndex] : '请先选择城市'}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 年级选择 -->
    <view class="form-item">
      <text class="form-label">年级</text>
      <picker mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="onGradeChange">
        <view class="picker-box {{gradeIndex === -1 ? 'picker-placeholder' : ''}}">
          {{gradeIndex !== -1 ? grades[gradeIndex] : '请选择年级'}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 姓名输入 -->
    <view class="form-item">
      <text class="form-label">真实姓名</text>
      <input class="text-input" placeholder="请输入您的真实姓名" value="{{realName}}" bindinput="onRealNameInput" maxlength="20" />
    </view>

    <!-- 登录按钮 -->
    <button class="login-btn" bindtap="onLogin" disabled="{{!canLogin}}">
      开始学习
    </button>
  </view>

  <!-- 底部说明 -->
  <view class="footer-text">
    <text>登录即表示同意《用户服务协议》</text>
  </view>

  <!-- 教师独立登录入口 -->
  <view class="teacher-entry" bindtap="onTeacherLogin">
    <text>教师登录入口 ›</text>
  </view>
</view>