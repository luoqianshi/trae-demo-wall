<view class="ranking-page">
  <!-- 装饰背景 -->
  <view class="rank-bg-decoration">
    <view class="rank-bg-circle rbc-1"></view>
    <view class="rank-bg-circle rbc-2"></view>
  </view>

  <!-- 顶部卡通形象区 -->
  <view class="rank-header-section">
    <view class="rank-mascot">
      <image class="rank-mascot-img" src="/images/doctor.png" mode="aspectFit" />
      <view class="rank-mascot-speech">
        <text class="rank-mascot-text">看看谁最棒！</text>
      </view>
    </view>
    <view class="rank-title-area">
      <text class="rank-title-text">🏆 排行榜</text>
      <text class="rank-title-sub">每一次进步都值得被看见</text>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'personal' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="personal">
      <text>👤 个人</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'personal'}}"></view>
    </view>
    <view class="tab-item {{activeTab === 'campus' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="campus">
      <text>🏫 校区</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'campus'}}"></view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item">
      <text class="filter-label">等级</text>
      <picker mode="selector" range="{{levelOptions}}" value="{{selectedLevelIndex}}" bindchange="onLevelChange">
        <view class="filter-picker">
          {{levelOptions[selectedLevelIndex]}}
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
    </view>
    <view class="filter-item" wx:if="{{activeTab === 'personal'}}">
      <text class="filter-label">课程</text>
      <picker mode="selector" range="{{courseOptions}}" value="{{selectedCourseIndex}}" bindchange="onCourseChange">
        <view class="filter-picker">
          {{courseOptions[selectedCourseIndex]}}
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 个人排行 -->
  <view class="rank-list" wx:if="{{activeTab === 'personal'}}">
    <view class="rank-header">
      <text class="rank-header-rank">排名</text>
      <text class="rank-header-user">用户</text>
      <text class="rank-header-score">分数</text>
      <text class="rank-header-course">课程</text>
    </view>
    <view class="rank-item {{item.isMe ? 'rank-item-me' : ''}}" wx:for="{{personalList}}" wx:for-index="idx" wx:for-item="item" wx:key="key">
      <view class="rank-col-rank">
        <text class="rank-medal" wx:if="{{idx < 3}}">{{['🥇', '🥈', '🥉'][idx]}}</text>
        <text class="rank-number" wx:else>{{item.rank}}</text>
      </view>
      <view class="rank-col-user">
        <image class="rank-avatar" src="{{item.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="rank-user-info">
          <text class="rank-name">{{item.nickName}}</text>
          <text class="rank-campus">{{item.regionName || ''}}</text>
        </view>
      </view>
      <text class="rank-col-score">{{item.score}}</text>
      <text class="rank-col-course">{{item.courseName || ''}}</text>
    </view>
    <view class="rank-empty" wx:if="{{personalList.length === 0}}">
      <text class="rank-empty-icon">📋</text>
      <text class="rank-empty-text">暂无排行数据</text>
      <text class="rank-empty-hint">快去刷题吧！</text>
    </view>
  </view>

  <!-- 校区排行 -->
  <view class="rank-list" wx:if="{{activeTab === 'campus'}}">
    <view class="rank-header">
      <text class="rank-header-rank">排名</text>
      <text class="rank-header-user" style="flex:1.5">校区</text>
      <text class="rank-header-score">平均分</text>
      <text class="rank-header-course" style="flex:0.8">最高分</text>
      <text class="rank-header-course" style="flex:0.8">人数</text>
    </view>
    <view class="rank-item" wx:for="{{campusList}}" wx:for-index="idx" wx:for-item="item" wx:key="key">
      <view class="rank-col-rank">
        <text class="rank-medal" wx:if="{{idx < 3}}">{{['🥇', '🥈', '🥉'][idx]}}</text>
        <text class="rank-number" wx:else>{{item.rank}}</text>
      </view>
      <view class="rank-col-user rank-region-col" style="flex:1.5">
        <text class="rank-region-icon">🌍</text>
        <text class="rank-name">{{item.regionName}}</text>
      </view>
      <text class="rank-col-score">{{item.avgScore}}</text>
      <text class="rank-col-course" style="flex:0.8">{{item.maxScore}}</text>
      <text class="rank-col-course" style="flex:0.8">{{item.count}}人</text>
    </view>
    <view class="rank-empty" wx:if="{{campusList.length === 0}}">
      <text class="rank-empty-icon">📋</text>
      <text class="rank-empty-text">暂无排行数据</text>
      <text class="rank-empty-hint">快去刷题吧！</text>
    </view>
  </view>
</view>