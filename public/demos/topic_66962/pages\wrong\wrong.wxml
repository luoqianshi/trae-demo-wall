<view class="wrong-page">

  <!-- ===== 顶部标题区 ===== -->
  <view class="wrong-header">
    <view class="wrong-header-bg"></view>
    <view class="wrong-header-content">
      <view class="wrong-header-top">
        <view class="wrong-back" bindtap="exitRetry" wx:if="{{retryMode}}">
          <text class="back-arrow">‹</text>
          <text class="back-text">返回列表</text>
        </view>
        <text class="wrong-header-title" wx:else>错题汇总</text>
        <text class="wrong-header-count">共 {{wrongCount}} 道</text>
      </view>
      <!-- 总结信息 -->
      <view class="wrong-summary" wx:if="{{!retryMode}}">
        <view class="summary-item">
          <text class="summary-num">{{level1Wrong}}</text>
          <text class="summary-label">文学一级</text>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="summary-num">{{level2Wrong}}</text>
          <text class="summary-label">文学二级</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view class="empty-state" wx:if="{{isEmpty && !retryMode}}">
    <view class="empty-icon">🎉</view>
    <text class="empty-title">没有错题！</text>
    <text class="empty-desc">继续保持哦～</text>
  </view>

  <!-- ===== 重练模式 ===== -->
  <view class="retry-section" wx:if="{{retryMode && retryQuestion}}">
    <view class="retry-progress">重练第 {{retryIndex + 1}} / {{wrongCount}} 题</view>
    <view class="retry-tag">{{retryQuestion.tag || ''}}</view>
    <view class="retry-question">{{retryQuestion.question}}</view>

    <view class="retry-options">
      <view 
        class="retry-option {{retryOptionClasses[index]}}"
        wx:for="{{retryQuestion.options}}" wx:key="*this"
        data-index="{{index}}"
        bindtap="retrySelect"
      >
        <view class="retry-opt-label {{retryOptionClasses[index]}}">{{retryOptionLabels[index]}}</view>
        <text class="retry-opt-text">{{item}}</text>
      </view>
    </view>

    <view class="retry-feedback" wx:if="{{retryAnswered}}">
      <view class="retry-feedback-title {{retryCorrect ? 'correct' : 'wrong'}}">
        <text wx:if="{{retryCorrect}}">✅ 回答正确！已从错题本移除</text>
        <text wx:else>❌ 答错了，正确答案是 {{retryOptionLabels[retryQuestion.answer]}}</text>
      </view>
      <view class="retry-explain" wx:if="{{!retryCorrect}}">
        <text class="retry-explain-label">📖 解析</text>
        <text class="retry-explain-text">{{retryQuestion.explain}}</text>
      </view>
      <button class="retry-next-btn" wx:if="{{!retryCorrect}}" bindtap="retryNextOrExit">下一题</button>
    </view>
  </view>

  <!-- ===== 操作按钮 ===== -->
  <view class="wrong-actions" wx:if="{{!retryMode && !isEmpty}}">
    <view class="action-tabs">
      <view class="action-tab {{currentLevel === 1 ? 'tab-active-orange' : ''}}" data-level="1" bindtap="switchLevel">🏮 文学一级</view>
      <view class="action-tab {{currentLevel === 2 ? 'tab-active-teal' : ''}}" data-level="2" bindtap="switchLevel">🌍 文学二级</view>
    </view>
    <view class="action-btns">
      <view class="action-btn action-btn-clear" bindtap="clearWrong">
        <text class="action-btn-icon">🗑️</text>
        <text>清空错题</text>
      </view>
      <view class="action-btn action-btn-retry" bindtap="retryAll">
        <text class="action-btn-icon">🔄</text>
        <text>错题重练</text>
      </view>
    </view>
  </view>

  <!-- ===== 错题列表 ===== -->
  <view class="wrong-list" wx:if="{{!retryMode && !isEmpty}}">
    <view class="wrong-card" wx:for="{{wrongList}}" wx:for-index="idx" wx:for-item="item" wx:key="_key">
      <!-- 课程标题 -->
      <view class="wrong-card-header">
        <text class="wrong-card-course">{{getCourseTitle(item)}}</text>
        <text class="wrong-card-tag">{{item.tag || ''}}</text>
      </view>
      <!-- 题目 -->
      <view class="wrong-card-question">{{item.question}}</view>
      <!-- 错误答案 -->
      <view class="wrong-card-answer wrong-card-wrong">
        <text class="wrong-answer-label">❌ 你选了：</text>
        <text class="wrong-answer-text">{{item.selectedText}}</text>
      </view>
      <!-- 正确答案 -->
      <view class="wrong-card-answer wrong-card-correct">
        <text class="wrong-answer-label">✅ 正确答案：</text>
        <text class="wrong-answer-text">{{item.answerText}}</text>
      </view>
      <!-- 解析 -->
      <view class="wrong-card-explain" wx:if="{{item.explain}}">
        <text class="wrong-explain-label">📖 解析</text>
        <text class="wrong-explain-text">{{item.explain}}</text>
      </view>
      <!-- 重新练习按钮 -->
      <view class="wrong-card-action">
        <view class="wrong-retry-btn" data-idx="{{idx}}" bindtap="retrySingle">🔄 重新练习</view>
      </view>
    </view>
  </view>
</view>