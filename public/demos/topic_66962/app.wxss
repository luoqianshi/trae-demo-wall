page { background: #FFF5F0; font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif; color: #333; }

/* ===== 通用样式 ===== */
.btn-primary { background: linear-gradient(135deg, #FF6B4A, #FF8E6B); color: #fff; border: none; border-radius: 25px; padding: 14rpx 48rpx; font-size: 32rpx; font-weight: 500; box-shadow: 0 6rpx 20rpx rgba(255,107,74,0.3); }
.btn-primary:active { opacity: 0.85; }
.btn-secondary { background: #fff; color: #FF6B4A; border: 2rpx solid #FF6B4A; border-radius: 25rpx; padding: 12rpx 44rpx; font-size: 30rpx; }
.btn-small { padding: 8rpx 28rpx; font-size: 26rpx; border-radius: 20rpx; }

.blue-green .btn-primary { background: linear-gradient(135deg, #2EC4B6, #4AD9C8); box-shadow: 0 6rpx 20rpx rgba(46,196,182,0.3); }

.card { background: #fff; border-radius: 20rpx; padding: 30rpx; margin: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }

.section-title { font-size: 36rpx; font-weight: 700; margin: 30rpx 0 20rpx 30rpx; }