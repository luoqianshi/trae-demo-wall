<view class="container">
  <!-- 标题栏（替代等级切换 Tab，等级由主页传入固定） -->
  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-icon">{{currentLevel == 1 ? '🏮' : '🌍'}}</text>
      <text class="page-header-title">{{currentLevel == 1 ? '文学一级' : '文学二级'}}</text>
      <text class="page-header-sub">{{currentLevel == 1 ? '先秦至隋唐文学' : '宋元至外国文学'}}</text>
    </view>
    <text class="page-header-count">{{courses.length}}讲</text>
  </view>

  <!-- 课程网格 - 2列方块卡片 -->
  <view class="course-grid">
    <view class="course-card" wx:for="{{courses}}" wx:key="courseId" wx:for-index="idx">
      <!-- 顶部：标题 + 下方状态 -->
      <view class="card-top">
        <text class="card-title">{{item.title}}</text>
        <text class="card-status {{item._statusClass}}">
          {{item._statusText}}
        </text>
      </view>
      <!-- 中间：插图 -->
      <view class="card-img-area">
        <image class="card-img" 
               src="/images/lessons/level{{currentLevel}}_{{item.courseId}}.jpg" 
               mode="aspectFit"
               binderror="onImageError"></image>
      </view>
      <!-- 底部：A组 / B组 -->
      <view class="card-sets">
        <view class="card-set {{item._setAClass}}" 
              bindtap="goQuiz" data-courseid="{{item.courseId}}" data-setid="A">
          A组{{item._setASuffix}}
        </view>
        <view class="card-set {{item._setBClass}}" 
              bindtap="goQuiz" data-courseid="{{item.courseId}}" data-setid="B">
          B组{{item._setBSuffix}}
        </view>
      </view>
    </view>
  </view>
</view>