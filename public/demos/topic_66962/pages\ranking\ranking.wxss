/* ===== 排行榜页 ===== */
.ranking-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F0 0%, #F0F4FF 100%);
  position: relative;
  overflow-x: hidden;
}

/* 装饰背景 */
.rank-bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.rank-bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.rbc-1 {
  width: 500rpx;
  height: 500rpx;
  background: #FF6B4A;
  top: -200rpx;
  right: -150rpx;
}

.rbc-2 {
  width: 350rpx;
  height: 350rpx;
  background: #2EC4B6;
  bottom: -100rpx;
  left: -100rpx;
}

/* 顶部卡通形象区 */
.rank-header-section {
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, #5B86E5, #36D1DC);
  padding: 30rpx 30rpx 40rpx;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 8rpx 30rpx rgba(91, 134, 229, 0.3);
}

.rank-mascot {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rank-mascot-img {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  animation: rankMascotBounce 3s ease-in-out infinite;
}

@keyframes rankMascotBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.rank-mascot-speech {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 28rpx;
  border-radius: 40rpx 40rpx 40rpx 12rpx;
  margin-left: 16rpx;
}

.rank-mascot-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.rank-title-area {
  padding-left: 10rpx;
}

.rank-title-text {
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.rank-title-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
  display: block;
}

/* Tab切换栏 */
.tab-bar {
  display: flex;
  background: #fff;
  margin: 0 20rpx;
  border-radius: 20rpx;
  padding: 6rpx;
  position: relative;
  z-index: 1;
  top: -20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.3s;
}

.tab-active {
  color: #fff;
  background: linear-gradient(135deg, #5B86E5, #36D1DC);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(91, 134, 229, 0.3);
}

.tab-indicator {
  display: none;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  padding: 0 30rpx 16rpx;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #999;
  white-space: nowrap;
}

.filter-picker {
  font-size: 26rpx;
  color: #333;
  padding: 10rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 排行榜列表 */
.rank-list {
  padding: 0 20rpx 40rpx;
  position: relative;
  z-index: 1;
}

.rank-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(91, 134, 229, 0.06);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.rank-header-rank {
  width: 80rpx;
  font-size: 24rpx;
  color: #888;
  text-align: center;
  font-weight: 500;
}

.rank-header-user {
  flex: 1;
  font-size: 24rpx;
  color: #888;
  font-weight: 500;
}

.rank-header-score {
  width: 100rpx;
  font-size: 24rpx;
  color: #888;
  text-align: center;
  font-weight: 500;
}

.rank-header-course {
  width: 120rpx;
  font-size: 24rpx;
  color: #888;
  text-align: center;
  font-weight: 500;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 3rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.2s;
}

.rank-item:active {
  transform: scale(0.98);
}

.rank-item-me {
  background: linear-gradient(135deg, rgba(91, 134, 229, 0.06), rgba(54, 209, 220, 0.04));
  border: 2rpx solid rgba(91, 134, 229, 0.2);
}

.rank-col-rank {
  width: 80rpx;
  display: flex;
  justify-content: center;
}

.rank-medal {
  font-size: 44rpx;
}

.rank-number {
  font-size: 30rpx;
  color: #999;
  font-weight: 700;
}

.rank-col-user {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rank-region-col {
  gap: 10rpx;
}

.rank-region-icon {
  font-size: 30rpx;
  flex-shrink: 0;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
  border: 3rpx solid #f0f0f0;
}

.rank-user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-campus {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-col-score {
  width: 100rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #5B86E5;
  text-align: center;
}

.rank-col-course {
  width: 120rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.rank-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.rank-empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.rank-empty-text {
  font-size: 32rpx;
  color: #999;
  font-weight: 500;
}

.rank-empty-hint {
  font-size: 26rpx;
  color: #ccc;
  margin-top: 8rpx;
}