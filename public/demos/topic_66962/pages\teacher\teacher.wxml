<view class="teacher-page">
  <!-- 等级切换标签 -->
  <view class="level-tabs">
    <view class="level-tab {{selectedLevel === 1 ? 'level-tab-active' : ''}}" bindtap="switchLevel" data-level="1">
      <text>文学一级</text>
    </view>
    <view class="level-tab {{selectedLevel === 2 ? 'level-tab-active' : ''}}" bindtap="switchLevel" data-level="2">
      <text>文学二级</text>
    </view>
  </view>

  <!-- 数据总览卡片 -->
  <view class="overview-section">
    <view class="overview-card">
      <view class="overview-item">
        <text class="overview-value">{{overview.studentCount}}</text>
        <text class="overview-label">参与学生</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="overview-value">{{overview.testCount}}</text>
        <text class="overview-label">答题总次数</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="overview-value">{{overview.avgScore}}</text>
        <text class="overview-label">平均分</text>
      </view>
    </view>
  </view>

  <!-- 及格率卡片 -->
  <view class="pass-rate-card">
    <view class="pass-rate-header">
      <text class="pass-rate-title">及格率（≥60分）</text>
      <text class="pass-rate-number">{{overview.passRate}}%</text>
    </view>
    <view class="pass-rate-bar-bg">
      <view class="pass-rate-bar-fill" style="width: {{overview.passRate}}%"></view>
    </view>
  </view>

  <!-- 校区数据列表 -->
  <view class="section-title">
    <text>校区数据排行</text>
  </view>

  <view class="campus-list">
    <view class="campus-card" wx:for="{{regionStats}}" wx:for-index="idx" wx:for-item="item" wx:key="regionId" bindtap="onRegionTap" data-region="{{item}}">
      <view class="campus-rank">
        <text class="campus-medal" wx:if="{{idx < 3}}">{{['🥇', '🥈', '🥉'][idx]}}</text>
        <text class="campus-number" wx:else>{{idx + 1}}</text>
      </view>
      <view class="campus-info">
        <view class="campus-header">
          <text class="campus-name">{{item.regionName}}</text>
          <text class="campus-more">详情 ›</text>
        </view>
        <view class="campus-stats">
          <view class="campus-stat">
            <text class="campus-stat-value">{{item.studentCount}}</text>
            <text class="campus-stat-label">人数</text>
          </view>
          <view class="campus-stat">
            <text class="campus-stat-value">{{item.avgScore}}</text>
            <text class="campus-stat-label">平均分</text>
          </view>
          <view class="campus-stat">
            <text class="campus-stat-value campus-stat-highlight">{{item.maxScore}}</text>
            <text class="campus-stat-label">最高分</text>
          </view>
          <view class="campus-stat">
            <text class="campus-stat-value campus-stat-highlight">{{item.passRate}}%</text>
            <text class="campus-stat-label">及格率</text>
          </view>
        </view>
        <!-- 完成率进度条 -->
        <view class="campus-progress">
          <text class="campus-progress-label">完成率</text>
          <view class="campus-progress-bar">
            <view class="campus-progress-fill" style="width: {{item.completionRate}}%"></view>
          </view>
          <text class="campus-progress-text">{{item.completionRate}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-section" wx:if="{{regionStats.length === 0}}">
    <text class="empty-text">暂无答题数据</text>
  </view>
</view>