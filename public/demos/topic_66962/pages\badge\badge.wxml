<view class="badge-page">
  <!-- 装饰背景 -->
  <view class="badge-bg">
    <view class="bgc-circle c1"></view>
    <view class="bgc-circle c2"></view>
    <view class="bgc-circle c3"></view>
  </view>

  <!-- 顶部标题 -->
  <view class="badge-header">
    <image class="badge-header-img" src="/images/horse.png" mode="aspectFit"></image>
    <view class="badge-header-text">
      <text class="badge-title">🎯 课程徽章</text>
      <text class="badge-subtitle">已完成 {{earnedCount}}/{{totalCount}} 个徽章</text>
    </view>
  </view>

  <!-- 等级切换 -->
  <view class="level-switch">
    <view class="lv-tab {{currentLevel == 1 ? 'lv-active' : ''}}" bindtap="switchLevel" data-level="1">
      <text>🏮 文学一级</text>
    </view>
    <view class="lv-tab {{currentLevel == 2 ? 'lv-active' : ''}}" bindtap="switchLevel" data-level="2">
      <text>🌍 文学二级</text>
    </view>
  </view>

  <!-- 徽章网格 -->
  <view class="badge-grid">
    <view 
      class="badge-item {{badge.earned ? 'badge-earned' : 'badge-locked'}}" 
      wx:for="{{badgeList}}" 
      wx:key="courseId" 
      wx:for-index="idx" 
      wx:for-item="badge"
    >
      <view class="badge-icon-box">
        <text class="badge-icon-text" wx:if="{{badge.earned}}">🥇</text>
        <text class="badge-icon-text" wx:else>🔒</text>
      </view>
      <text class="bdg-name {{badge.earned ? 'bdg-name-on' : 'bdg-name-off'}}">{{badge.badgeName}}</text>
      <text class="bdg-course {{badge.earned ? 'bdg-course-on' : 'bdg-course-off'}}">{{badge.courseTitle}}</text>
    </view>
  </view>
</view>