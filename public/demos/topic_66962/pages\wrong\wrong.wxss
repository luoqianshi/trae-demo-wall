.wrong-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F0 0%, #FFF8F5 50%, #F5F7FF 100%);
  padding-bottom: 60rpx;
}

/* ===== 顶部标题区 ===== */
.wrong-header {
  position: relative;
  padding: 0 0 30rpx;
  overflow: hidden;
}

.wrong-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 260rpx;
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B, #FFB088);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 74, 0.2);
}

.wrong-header-content {
  position: relative;
  padding: 20rpx 30rpx;
  z-index: 1;
}

.wrong-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.wrong-back {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.back-arrow {
  font-size: 44rpx;
  color: #fff;
  font-weight: 300;
  margin-right: 6rpx;
}

.back-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
}

.wrong-header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.wrong-header-count {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.2);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 总结信息 */
.wrong-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.summary-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: bounce 1.5s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  margin-top: 10rpx;
}

/* ===== 操作按钮 ===== */
.wrong-actions {
  padding: 20rpx 20rpx 0;
  position: relative;
  z-index: 1;
}

.action-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.action-tab:active {
  transform: scale(0.96);
}

.tab-active-orange {
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255,107,74,0.3);
}

.tab-active-teal {
  background: linear-gradient(135deg, #2EC4B6, #4AD9C8);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(46,196,182,0.3);
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.96);
}

.action-btn-icon {
  font-size: 28rpx;
}

.action-btn-clear {
  background: #fff;
  color: #E65100;
  border: 2rpx solid #FFCC80;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.action-btn-retry {
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255,107,74,0.25);
}

/* ===== 错题列表 ===== */
.wrong-list {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wrong-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  transition: transform 0.2s;
}

.wrong-card:active {
  transform: scale(0.98);
}

.wrong-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.wrong-card-course {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF6B4A;
}

.wrong-card-tag {
  font-size: 22rpx;
  color: #999;
  background: #F5F5F5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.wrong-card-question {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.wrong-card-answer {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.wrong-answer-label {
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.wrong-answer-text {
  font-size: 26rpx;
  line-height: 1.5;
}

.wrong-card-wrong {
  background: #FFF0EE;
}

.wrong-card-wrong .wrong-answer-label {
  color: #D32F2F;
}

.wrong-card-wrong .wrong-answer-text {
  color: #C62828;
}

.wrong-card-correct {
  background: #E8F5E9;
}

.wrong-card-correct .wrong-answer-label {
  color: #2E7D32;
}

.wrong-card-correct .wrong-answer-text {
  color: #1B5E20;
}

.wrong-card-explain {
  background: #FFF8E1;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.wrong-explain-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #F57F17;
  display: block;
  margin-bottom: 6rpx;
}

.wrong-explain-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.wrong-card-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}

.wrong-retry-btn {
  padding: 12rpx 30rpx;
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255,107,74,0.2);
  transition: all 0.2s;
}

.wrong-retry-btn:active {
  transform: scale(0.92);
}

/* ===== 重练模式 ===== */
.retry-section {
  padding: 30rpx 20rpx;
}

.retry-progress {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  text-align: center;
}

.retry-tag {
  font-size: 24rpx;
  color: #FF6B4A;
  background: #FFF0E8;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.retry-question {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.retry-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.retry-option {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  border: 3rpx solid #f0f0f0;
  transition: all 0.2s;
}

.retry-option:active {
  transform: scale(0.97);
}

.retry-option.correct {
  border-color: #4CAF50;
  background: #E8F5E9;
}

.retry-option.wrong {
  border-color: #F44336;
  background: #FFEBEE;
}

.retry-opt-label {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5f5f5;
  font-size: 26rpx;
  font-weight: 700;
  color: #666;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.retry-opt-label.correct {
  background: #4CAF50;
  color: #fff;
}

.retry-opt-label.wrong {
  background: #F44336;
  color: #fff;
}

.retry-opt-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.retry-feedback {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.retry-feedback-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.retry-feedback-title.correct {
  color: #2E7D32;
}

.retry-feedback-title.wrong {
  color: #C62828;
}

.retry-explain {
  background: #FFF8E1;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.retry-explain-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #F57F17;
  display: block;
  margin-bottom: 6rpx;
}

.retry-explain-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.retry-next-btn {
  width: 100%;
  margin-top: 20rpx;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #FF6B4A, #FF8E6B);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255,107,74,0.25);
}

.retry-next-btn::after {
  border: none;
}