/* ===== 全局样式变量 ===== */
page {
  --bg: #0a0a1a;
  --bg2: #12122a;
  --bg3: #1a1a38;
  --ink: #e0e0f0;
  --muted: #8888aa;
  --rule: #2a2a50;
  --accent: #7c5cfc;
  --accent2: #f0c060;
  --accent3: #38bdf8;
  --success: #34d399;
  --danger: #f472b6;

  background: var(--bg);
  color: var(--ink);
  font-family:
    -apple-system, BlinkMacSystemFont,
    'PingFang SC', 'Helvetica Neue',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 通用容器 ===== */
.container {
  padding: 32rpx 28rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 卡片 ===== */
.card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-accent {
  border-color: var(--accent);
  background: rgba(124, 92, 252, 0.06);
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary[disabled] {
  opacity: 0.4;
}

.btn-secondary {
  background: var(--bg3);
  color: var(--ink);
  border: 1px solid var(--rule);
}

.btn-ghost {
  background: transparent;
  color: var(--accent);
  border: 1px solid var(--accent);
}

/* ===== 文本颜色 ===== */
.text-muted { color: var(--muted); }
.text-accent { color: var(--accent); }
.text-accent2 { color: var(--accent2); }
.text-center { text-align: center; }

/* ===== Flex 工具 ===== */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-wrap { flex-wrap: wrap; }

/* ===== 间距 ===== */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.p-24 { padding: 24rpx; }

/* ===== 分隔线 ===== */
.divider {
  height: 1px;
  background: var(--rule);
  margin: 24rpx 0;
}

/* ===== 头像 ===== */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg3);
}

.avatar-sm { width: 56rpx; height: 56rpx; }
.avatar-lg { width: 120rpx; height: 120rpx; }

/* ===== 标签/Badge ===== */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-locked {
  background: rgba(240, 192, 96, 0.15);
  color: var(--accent2);
}

.badge-unlocked {
  background: rgba(52, 211, 153, 0.15);
  color: var(--success);
}

/* ===== 骨架屏 ===== */
.skeleton {
  background: linear-gradient(90deg, var(--bg3) 25%, var(--bg2) 50%, var(--bg3) 75%);
  background-size: 200% 100%;
  animation: skeleton-shine 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-shine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
