<!-- 空状态组件 -->
<view class="empty-state">
  <text class="empty-icon">{{ icon }}</text>
  <text class="empty-title">{{ title }}</text>
  <text class="empty-desc text-muted" wx:if="{{ description }}">{{ description }}</text>
  <button wx:if="{{ showBtn }}" class="btn btn-primary empty-btn" bindtap="onAction">
    {{ btnText }}
  </button>
</view>
