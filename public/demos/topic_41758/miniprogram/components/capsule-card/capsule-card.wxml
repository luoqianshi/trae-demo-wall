<!-- 漂流瓶卡片组件 -->
<view class="bottle-card bottle-type-{{ type }}">
  <view class="type-badge">
    <text class="type-emoji">{{ typeEmoji }}</text>
  </view>

  <view class="card-body">
    <text class="card-title">{{ title }}</text>
    <text class="card-date" wx:if="{{ sealedAtText }}">{{ sealedAtText }}</text>
    <view class="card-meta" wx:if="{{ locationName || unlockAtText }}">
      <text class="text-muted" wx:if="{{ locationName }}">📍 {{ locationName }}</text>
      <text class="text-muted" wx:if="{{ unlockAtText }}">⏰ {{ unlockAtText }}</text>
    </view>
  </view>

  <view class="card-status status-{{ status }}">
    <text class="status-text">{{ statusText }}</text>
  </view>
</view>
