/* 漂流瓶卡片组件样式 */

.bottle-card {
  background: #1a1a38;
  border: 1px solid #2a2a50;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  position: relative;
}

/* 不同类型的卡片风格 */
.bottle-card.bottle-type-self {
  border-left: 6rpx solid #f0c060;
}
.bottle-card.bottle-type-location {
  border-left: 6rpx solid #38bdf8;
}
.bottle-card.bottle-type-user {
  border-left: 6rpx solid #a48cff;
}

/* 类型徽标 */
.type-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  z-index: 2;
}
.type-emoji {
  font-size: 28rpx;
}

/* 卡片主体 */
.card-body {
  padding: 28rpx 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-right: 80rpx;
}
.card-date {
  font-size: 22rpx;
  color: #8888aa;
  display: block;
  margin-top: 8rpx;
}

.card-meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.card-meta .text-muted {
  font-size: 24rpx;
  color: #8888aa;
}

/* 状态显示 */
.card-status {
  padding: 16rpx 32rpx;
  border-top: 1px solid #2a2a50;
  background: rgba(0, 0, 0, 0.2);
}
.status-text {
  font-size: 24rpx;
  font-weight: 600;
}
.status-sealed .status-text {
  color: #f0c060;
}
.status-available .status-text {
  color: #38bdf8;
}
.status-unlocked .status-text {
  color: #4ade80;
}

/* 工具样式 */
.text-muted { color: #8888aa; }
