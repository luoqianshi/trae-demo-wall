<view class="container import-chats-page">
  <text class="page-title">导入聊天记录</text>
  <text class="page-desc text-muted">上传微信的聊天记录导出文件，AI 将为你解析和保存</text>

  <!-- 隐私提醒 -->
  <view class="callout">
    <text class="callout-title">🔒 隐私提醒</text>
    <text class="callout-text text-muted">所有聊天记录加密存储，仅你本人可通过时光胶囊查看。我们不会将数据用于任何其他目的。</text>
  </view>

  <!-- 初始状态 -->
  <block wx:if="{{ uploadState === 'init' }}">
    <view class="empty-state">
      <text class="empty-emoji">💬</text>
      <text class="text-muted">请导出聊天记录后上传</text>
      <text class="text-muted text-xs">
        微信操作路径：我 → 设置 → 通用 → 聊天记录迁移与备份
      </text>
    </view>
    <button class="btn btn-primary" bindtap="chooseFile">选择聊天文件</button>
  </block>

  <!-- 已选择文件 -->
  <view wx:if="{{ uploadState === 'uploaded' }}" class="card file-card flex-row">
    <text class="file-icon">📄</text>
    <view class="flex-1">
      <text class="file-name">{{ fileName }}</text>
      <text class="text-muted file-size">{{ fileSizeText }}</text>
    </view>
    <text class="text-success">✓</text>
  </view>

  <button
    wx:if="{{ uploadState === 'uploaded' }}"
    class="btn btn-primary mt-24"
    bindtap="importChats"
  >开始导入</button>

  <!-- 导入中 -->
  <view wx:if="{{ uploadState === 'importing' }}" class="card loading-card text-center">
    <text class="loading-emoji">⏳</text>
    <text class="text-muted">正在解析聊天记录...</text>
    <text class="text-accent text-xs">这可能需要几分钟</text>
  </view>

  <!-- 导入完成 -->
  <view wx:if="{{ uploadState === 'done' }}" class="card result-card text-center">
    <text class="result-emoji">✅</text>
    <text class="result-title">导入完成</text>
    <view class="result-stats flex-row" style="justify-content:center;gap:48rpx;">
      <view class="stat-item">
        <text class="stat-num text-accent">{{ importedCount }}</text>
        <text class="text-muted">个会话</text>
      </view>
      <view class="stat-item">
        <text class="stat-num text-accent2">{{ totalMessages }}</text>
        <text class="text-muted">条消息</text>
      </view>
    </view>
    <button class="btn btn-primary mt-24" bindtap="finish">完成</button>
  </view>

  <text class="text-muted text-center mt-32" wx:if="{{ uploadState === 'init' }}">
    也可以跳过，稍后在"我的"页面再导入
  </text>
</view>
