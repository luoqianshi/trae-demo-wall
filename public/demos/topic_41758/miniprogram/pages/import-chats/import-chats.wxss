.page-title { font-size: 40rpx; font-weight: 800; color: #fff; display: block; margin-bottom: 12rpx; }
.page-desc { font-size: 26rpx; line-height: 1.6; margin-bottom: 24rpx; }

.callout { background: rgba(240,192,96,0.06); border: 1px solid rgba(240,192,96,0.2); border-radius: 16rpx; padding: 24rpx; margin-bottom: 32rpx; }
.callout-title { font-size: 26rpx; font-weight: 600; color: var(--accent2); display: block; margin-bottom: 8rpx; }
.callout-text { font-size: 24rpx; line-height: 1.6; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0 40rpx; }
.empty-emoji { font-size: 100rpx; margin-bottom: 24rpx; }
.text-xs { font-size: 22rpx !important; margin-top: 12rpx; }

.file-card { }
.file-icon { font-size: 52rpx; margin-right: 16rpx; }
.file-name { font-size: 28rpx; color: #fff; display: block; }
.file-size { font-size: 24rpx; }

.loading-card { padding: 60rpx 0; }
.loading-emoji { font-size: 72rpx; display: block; margin-bottom: 16rpx; }

.result-card { padding: 48rpx 0; }
.result-emoji { font-size: 72rpx; display: block; margin-bottom: 16rpx; }
.result-title { font-size: 36rpx; font-weight: 700; color: #fff; display: block; margin-bottom: 24rpx; }
.result-stats { padding: 16rpx 0; }
