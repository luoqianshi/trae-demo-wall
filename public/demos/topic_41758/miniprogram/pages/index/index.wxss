.index-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* 已登录欢迎区 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.welcome-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 20rpx;
}

.welcome-sub {
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* 区块标题 */
.section-header {
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.mt-24 {
  margin-top: 24rpx;
}

/* ============== 呵护提醒 ============== */
.care-skeleton {
  padding: 24rpx;
  background: var(--bg2);
  border-radius: 20rpx;
  border: 1px solid var(--rule);
}

.care-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.care-card {
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1px solid var(--rule);
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
}

.care-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 当天的呵护提醒：温暖渐变背景 */
.care-card-today {
  background: linear-gradient(145deg, rgba(124, 92, 252, 0.18), rgba(255, 107, 157, 0.1));
  border-color: rgba(124, 92, 252, 0.4);
}

/* 即将到来的提醒：淡色背景 */
.care-card-upcoming {
  background: var(--bg2);
  border-color: var(--rule);
}

/* 父亲主题：蓝色调 */
.care-card-father.care-card-today {
  background: linear-gradient(145deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.05));
  border-color: rgba(59, 130, 246, 0.4);
}

/* 母亲主题：粉色调 */
.care-card-mother.care-card-today {
  background: linear-gradient(145deg, rgba(236, 72, 153, 0.2), rgba(236, 72, 153, 0.05));
  border-color: rgba(236, 72, 153, 0.4);
}

.care-card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.care-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.care-emoji {
  font-size: 36rpx;
}

.care-title-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.care-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.care-days-badge {
  font-size: 22rpx;
  color: var(--accent2);
  background: rgba(240, 192, 96, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 600;
  align-self: flex-start;
}

.care-message {
  font-size: 26rpx;
  color: #c8c8e0;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.care-card-footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 小祝福语 */
.care-blessing {
  background: rgba(10, 10, 26, 0.4);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  border: 1px solid rgba(124, 92, 252, 0.2);
}

.care-card-father .care-blessing {
  border-color: rgba(59, 130, 246, 0.3);
}

.care-card-mother .care-blessing {
  border-color: rgba(236, 72, 153, 0.3);
}

.care-blessing-label {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.care-card-father .care-blessing-label {
  color: #60a5fa;
}

.care-card-mother .care-blessing-label {
  color: #f472b6;
}

.care-blessing-text {
  font-size: 24rpx;
  color: #e0e0f0;
  line-height: 1.6;
}

.care-action-row {
  display: flex;
  justify-content: flex-end;
}

.care-action-btn {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.care-card-father .care-action-btn {
  color: #60a5fa;
}

.care-card-mother .care-action-btn {
  color: #f472b6;
}

.no-holiday {
  padding: 32rpx 0;
  font-size: 26rpx;
}

/* ============== N年今日 ============== */
.on-this-day-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, rgba(124, 92, 252, 0.15), rgba(255, 107, 157, 0.08));
  border: 1px solid rgba(124, 92, 252, 0.3);
  position: relative;
  overflow: hidden;
}

.on-this-day-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(240, 192, 96, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.otd-header {
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.otd-date-col {
  display: flex;
  flex-direction: column;
}

.otd-date {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), #ff6b9d, var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.otd-weekday {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.otd-stats-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.otd-stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--accent2);
}

.otd-stat-label {
  font-size: 22rpx;
}

/* AI 总结 */
.otd-ai-summary {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(10, 10, 26, 0.5);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(124, 92, 252, 0.2);
}

.otd-ai-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.otd-ai-text {
  font-size: 26rpx;
  color: #e0e0f0;
  line-height: 1.6;
  flex: 1;
}

/* 预览区 */
.otd-preview {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.otd-year-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.otd-year-badge {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(124, 92, 252, 0.15);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
  flex-shrink: 0;
  min-width: 70rpx;
  text-align: center;
}

.otd-photo-row {
  display: flex;
  gap: 6rpx;
  flex: 1;
  align-items: center;
}

.otd-preview-photo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: var(--bg3);
}

.otd-more-photos {
  font-size: 20rpx;
  color: var(--muted);
  padding-left: 4rpx;
}

/* 底部 */
.otd-footer {
  font-size: 22rpx;
  text-align: center;
  padding-top: 8rpx;
  border-top: 1px solid rgba(124, 92, 252, 0.2);
  padding-top: 16rpx;
}

/* ============== 黑暗时刻档案馆 ============== */
.dark-moment-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, rgba(30, 30, 60, 0.8), rgba(124, 92, 252, 0.12));
  border: 1px solid rgba(124, 92, 252, 0.3);
  position: relative;
  overflow: hidden;
}

.dark-moment-card::before {
  content: '';
  position: absolute;
  top: -30%;
  left: -10%;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(52, 211, 153, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.dm-header {
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.dm-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(124, 92, 252, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dm-emoji {
  font-size: 36rpx;
}

.dm-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.dm-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.dm-desc {
  font-size: 22rpx;
}

/* 统计行 */
.dm-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(10, 10, 26, 0.5);
  border-radius: 14rpx;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.dm-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.dm-stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.dm-healing {
  color: var(--success);
}

.dm-archived {
  color: var(--accent2);
}

.dm-strict {
  color: #a78bfa;
  font-size: 24rpx;
}

.dm-stat-label {
  font-size: 20rpx;
  margin-top: 4rpx;
}

.dm-stat-divider {
  width: 1px;
  height: 40rpx;
  background: var(--rule);
}

/* 最近一段 */
.dm-latest {
  background: rgba(10, 10, 26, 0.5);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-top: 4rpx;
}

.dm-latest-label {
  font-size: 20rpx;
  color: var(--muted);
  display: block;
  margin-bottom: 4rpx;
}

.dm-latest-text {
  font-size: 24rpx;
  color: #e0e0f0;
}

/* ============== 暖心时刻 ============== */
.warm-moment-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, rgba(30, 30, 60, 0.8), rgba(240, 192, 96, 0.12));
  border: 1px solid rgba(240, 192, 96, 0.3);
  position: relative;
  overflow: hidden;
}

.warm-moment-card::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.wm-header {
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.wm-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(240, 192, 96, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wm-emoji {
  font-size: 36rpx;
}

.wm-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.wm-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.wm-desc {
  font-size: 22rpx;
}

.wm-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(10, 10, 26, 0.5);
  border-radius: 14rpx;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.wm-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.wm-stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.wm-strict {
  color: #f0c060;
  font-size: 24rpx;
}

.wm-stat-label {
  font-size: 20rpx;
  margin-top: 4rpx;
}

.wm-stat-divider {
  width: 1px;
  height: 40rpx;
  background: var(--rule);
}

.wm-latest {
  background: rgba(10, 10, 26, 0.5);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-top: 4rpx;
}

.wm-latest-label {
  font-size: 20rpx;
  color: var(--muted);
  display: block;
  margin-bottom: 4rpx;
}

.wm-latest-text {
  font-size: 24rpx;
  color: #e0e0f0;
}

/* ============== 快捷入口 ============== */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.action-card {
  flex: 1;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-card:active {
  border-color: var(--accent);
  background: rgba(124, 92, 252, 0.06);
}

.action-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.action-desc {
  font-size: 22rpx;
}

/* ============== 未登录 Hero ============== */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
}

.hero-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), #ff6b9d, var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: 32rpx;
  margin-top: 8rpx;
}

.hero-desc {
  font-size: 28rpx;
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.8;
  white-space: pre-line;
}

/* 功能介绍卡片 */
.feature-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.feature-card {
  flex: 1;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
}

.feature-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.feature-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  line-height: 1.5;
}

.login-btn {
  width: 100%;
  margin-top: 60rpx;
}

.login-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  margin-top: 20rpx;
}

/* ============== 最近解锁胶囊 ============== */
.empty-capsule {
  padding: 40rpx 0;
}

.empty-capsule .empty-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.capsule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.capsule-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  transition: all 0.2s ease;
}

.capsule-item:active {
  border-color: var(--accent);
  background: rgba(124, 92, 252, 0.06);
}

.capsule-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: var(--bg3);
  flex-shrink: 0;
}

.capsule-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.capsule-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.capsule-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta-tag {
  font-size: 22rpx;
}

.meta-location {
  color: var(--accent3);
}

.meta-date {
  color: var(--muted);
}

.capsule-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  margin-left: auto;
}

.status-unlocked {
  color: var(--success);
  background: rgba(52, 211, 153, 0.15);
}

/* ============== 情绪档案双栏 ============== */
.emotion-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.emotion-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  border: 1px solid var(--rule);
  background: var(--bg2);
  transition: all 0.2s ease;
}

.emotion-card:active {
  transform: scale(0.98);
}

.emotion-warm {
  border-color: rgba(240, 192, 96, 0.3);
  background: linear-gradient(160deg, var(--bg2), rgba(240, 192, 96, 0.08));
}

.emotion-dark {
  border-color: rgba(124, 92, 252, 0.3);
  background: linear-gradient(160deg, var(--bg2), rgba(124, 92, 252, 0.08));
}

.emotion-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.emotion-warm .emotion-icon-wrap {
  background: rgba(240, 192, 96, 0.2);
}

.emotion-dark .emotion-icon-wrap {
  background: rgba(124, 92, 252, 0.2);
}

.emotion-emoji {
  font-size: 32rpx;
}

.emotion-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.emotion-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.emotion-count {
  font-size: 20rpx;
}

.emotion-arrow {
  font-size: 24rpx;
  color: var(--muted);
  flex-shrink: 0;
}

/* 骨架屏 */
.skeleton-line {
  height: 24rpx;
  background: linear-gradient(90deg, var(--bg3), var(--rule), var(--bg3));
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  animation: shimmer 1.5s infinite;
}

.skeleton-wide {
  width: 80%;
}

.skeleton-short {
  width: 50%;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
