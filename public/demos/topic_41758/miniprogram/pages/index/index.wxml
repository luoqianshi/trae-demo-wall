<!-- 首页 - 已登录：主内容区 / 未登录：品牌展示 + 登录入口 -->
<view class="container index-page">

  <!-- 已登录 -->
  <block wx:if="{{ isLoggedIn }}">
    <!-- 顶部欢迎区 -->
    <view class="welcome-section">
      <image class="avatar avatar-lg" src="{{ userInfo.avatar_url }}" mode="aspectFill" />
      <text class="welcome-text">Hi, {{ userInfo.nickname }}</text>
      <text class="welcome-sub text-muted">今天也有新的记忆等你发现</text>
    </view>

    <!-- 呵护提醒 -->
    <view class="section-header flex-between">
      <text class="section-title">💝 呵护提醒</text>
    </view>

    <view wx:if="{{ holidayLoading }}" class="care-skeleton">
      <view class="skeleton-line skeleton-wide"></view>
      <view class="skeleton-line"></view>
    </view>

    <block wx:elif="{{ holidayReminders.length > 0 }}">
      <view class="care-card-list">
        <view
          wx:for="{{ holidayReminders }}"
          wx:key="id"
          class="care-card care-card-{{ item.category }} {{ item.is_today ? 'care-card-today' : 'care-card-upcoming' }}"
          data-reminder="{{ item }}"
          bindtap="tapReminder"
        >
          <view class="care-card-top">
            <view class="care-icon-wrap" style="background: {{ item.icon_bg }}">
              <text class="care-emoji">{{ item.emoji }}</text>
            </view>
            <view class="care-title-row">
              <text class="care-title">{{ item.title }}</text>
              <text wx:if="{{ !item.is_today }}" class="care-days-badge">{{ item.days_left }}天后</text>
            </view>
          </view>
          <text class="care-message">{{ item.care_message }}</text>
          <view class="care-card-footer">
            <view wx:if="{{ item.is_today && item.blessing_text }}" class="care-blessing">
              <text class="care-blessing-label">💌 小祝福</text>
              <text class="care-blessing-text">{{ item.blessing_text }}</text>
            </view>
            <view class="care-action-row">
              <text class="care-action-btn">{{ item.action_text }} →</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="no-holiday text-muted text-center">
      <text>今天是平凡但珍贵的一天 ✨</text>
    </view>

    <!-- 暖心时刻 + 黑暗时刻 双栏 -->
    <view class="section-header flex-between mt-24">
      <text class="section-title">情绪档案</text>
    </view>

    <view class="emotion-grid">
      <!-- 暖心时刻 -->
      <view class="emotion-card emotion-warm" bindtap="goWarmMoments">
        <view class="emotion-icon-wrap">
          <text class="emotion-emoji">☀️</text>
        </view>
        <view class="emotion-info">
          <text class="emotion-title">暖心时刻</text>
          <text class="emotion-count text-muted">{{ warmMomentOverview ? warmMomentOverview.year_count + ' 段今年' : '加载中' }}</text>
        </view>
        <text class="emotion-arrow">→</text>
      </view>

      <!-- 黑暗时刻 -->
      <view class="emotion-card emotion-dark" bindtap="goDarkMoments">
        <view class="emotion-icon-wrap">
          <text class="emotion-emoji">🌙</text>
        </view>
        <view class="emotion-info">
          <text class="emotion-title">黑暗时刻</text>
          <text class="emotion-count text-muted">{{ darkMomentOverview ? darkMomentOverview.year_count + ' 段今年' : '加载中' }}</text>
        </view>
        <text class="emotion-arrow">→</text>
      </view>
    </view>

    <!-- N年今日 -->
    <view class="section-header flex-between mt-24">
      <text class="section-title">📅 N年今日</text>
      <text class="text-accent" bindtap="goOnThisDay">查看全部 →</text>
    </view>

    <view wx:if="{{ onThisDayLoading }}" class="on-this-day-card card">
      <view class="skeleton-line skeleton-wide"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line skeleton-short"></view>
    </view>

    <block wx:elif="{{ onThisDay }}">
      <view class="on-this-day-card card" bindtap="goOnThisDay">
        <view class="otd-header flex-row">
          <view class="otd-date-col">
            <text class="otd-date">{{ onThisDay.date_text }}</text>
            <text class="otd-weekday text-muted">{{ onThisDay.weekday_text }}</text>
          </view>
          <view class="otd-stats-col">
            <text class="otd-stat-num">{{ onThisDay.total_memories }}</text>
            <text class="otd-stat-label text-muted">条记忆</text>
          </view>
        </view>
        <view class="otd-ai-summary">
          <text class="otd-ai-icon">✨</text>
          <text class="otd-ai-text">{{ onThisDay.ai_summary }}</text>
        </view>
        <view wx:if="{{ onThisDay.years_with_content > 0 }}" class="otd-preview">
          <block wx:for="{{ onThisDay.years }}" wx:key="years_ago">
            <view wx:if="{{ item.has_content }}" class="otd-year-preview">
              <text class="otd-year-badge">{{ item.years_ago }}年前</text>
              <view class="otd-photo-row">
                <image
                  wx:for="{{ item.photos }}"
                  wx:for-item="photo"
                  wx:for-index="pIdx"
                  wx:key="id"
                  class="otd-preview-photo"
                  src="{{ photo.url }}"
                  mode="aspectFill"
                  wx:if="{{ pIdx < 4 }}"
                />
                <view wx:if="{{ item.photo_count > 4 }}" class="otd-more-photos">+{{ item.photo_count - 4 }}</view>
              </view>
            </view>
          </block>
        </view>
        <view class="otd-footer text-muted">
          <text>点击查看每年今日的完整记忆 →</text>
        </view>
      </view>
    </block>

    <!-- 最近解锁胶囊 -->
    <view class="section-header flex-between mt-24">
      <text class="section-title">🔓 最近解锁</text>
      <text class="text-accent" bindtap="goCapsules">查看全部 →</text>
    </view>

    <view wx:if="{{ recentUnlocked.length === 0 }}" class="empty-capsule text-muted text-center">
      <text class="empty-icon">⏳</text>
      <text>暂无解锁胶囊，等待时间开启</text>
    </view>

    <view wx:else class="capsule-list">
      <view
        wx:for="{{ recentUnlocked }}"
        wx:key="id"
        class="capsule-item"
        data-id="{{ item.id }}"
        bindtap="onCapsuleTap"
      >
        <image class="capsule-cover" src="{{ item.cover_url }}" mode="aspectFill" />
        <view class="capsule-body flex-1">
          <text class="capsule-title">{{ item.title }}</text>
          <view class="capsule-meta">
            <text class="meta-tag meta-location" wx:if="{{ item.location_name }}">📍 {{ item.location_name }}</text>
            <text class="meta-tag meta-date">{{ item.unlocked_at_text }}</text>
          </view>
        </view>
        <view class="capsule-status status-unlocked">
          <text>已解锁</text>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="section-header flex-between mt-24">
      <text class="section-title">快捷入口</text>
    </view>

    <view class="quick-actions">
      <view class="action-card" bindtap="goCreate">
        <text class="action-icon">✍️</text>
        <text class="action-title">创建胶囊</text>
        <text class="action-desc text-muted">封存此刻的心情</text>
      </view>
      <view class="action-card" bindtap="goCapsules">
        <text class="action-icon">🫧</text>
        <text class="action-title">创建漂流瓶</text>
        <text class="action-desc text-muted">封存给未知的心意</text>
      </view>
      <view class="action-card" bindtap="goImport">
        <text class="action-icon">📸</text>
        <text class="action-title">导入记忆</text>
        <text class="action-desc text-muted">相册 / 聊天记录</text>
      </view>
    </view>
  </block>

  <!-- 未登录 -->
  <block wx:else>
    <view class="hero-section">
      <view class="hero-icon">⏳</view>
      <text class="hero-title">时光胶囊</text>
      <text class="hero-subtitle text-muted">AI 记忆管家</text>
      <text class="hero-desc text-muted">把此刻封存给未来{'\n'}让 AI 替你记住那些珍贵的瞬间</text>
    </view>

    <view class="feature-cards">
      <view class="feature-card">
        <text class="feature-icon">📸</text>
        <text class="feature-title">封存照片</text>
        <text class="feature-desc text-muted">从相册中挑选珍贵瞬间，封存至未来</text>
      </view>
      <view class="feature-card">
        <text class="feature-icon">💬</text>
        <text class="feature-title">封存对话</text>
        <text class="feature-desc text-muted">保存那些值得记住的聊天片段</text>
      </view>
      <view class="feature-card">
        <text class="feature-icon">🔓</text>
        <text class="feature-title">定时开启</text>
        <text class="feature-desc text-muted">一天/一月/一年后，胶囊自动解锁</text>
      </view>
    </view>

    <button
      class="btn btn-primary login-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{ loggingIn }}"
      disabled="{{ loggingIn }}"
    >📱 手机号一键登录</button>

    <text class="login-hint text-muted">登录即代表同意《用户协议》和《隐私政策》</text>
  </block>
</view>
