<view class="page">
  <view wx:if="{{loading && photos.length === 0}}" class="loading-text text-center text-muted">加载中...</view>

  <view class="header-info" wx:if="{{total > 0}}">
    <text class="total-label">共 {{total}} 张照片</text>
    <text class="sub-label text-muted">按时间倒序排列</text>
  </view>

  <view class="photo-grid" wx:if="{{photos.length > 0}}">
    <block wx:for="{{photos}}" wx:key="id">
      <image
        class="photo-item"
        src="{{item.url}}"
        mode="aspectFill"
        data-url="{{item.url}}"
        catchtap="previewPhoto"
      />
    </block>
  </view>

  <view wx:if="{{loading && photos.length > 0}}" class="loading-more text-muted">加载中...</view>
  <view wx:elif="{{noMore && photos.length > 0}}" class="loading-more text-muted">— 已显示全部 {{total}} 张 —</view>
  <view wx:elif="{{photos.length === 0 && !loading}}" class="empty-state text-center text-muted">暂无照片</view>
</view>
