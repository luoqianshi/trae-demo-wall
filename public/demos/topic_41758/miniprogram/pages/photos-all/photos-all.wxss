.page {
  padding: 20rpx 20rpx 60rpx;
  background: var(--bg);
  min-height: 100vh;
}

.header-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 4rpx 20rpx;
  margin-bottom: 8rpx;
}

.total-label {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.sub-label {
  font-size: 24rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  background: var(--bg2);
  display: block;
}

.loading-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
}

.loading-text {
  padding: 80rpx 0;
}

.empty-state {
  padding: 80rpx 0;
  font-size: 28rpx;
}

.text-muted {
  color: var(--muted);
}

.text-center {
  text-align: center;
}
