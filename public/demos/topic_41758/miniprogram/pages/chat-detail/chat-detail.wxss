.chat-detail-page {
  min-height: 100vh;
  padding: 20rpx 20rpx 60rpx;
  background: var(--bg);
}

.loading-text {
  padding: 80rpx 0;
}

/* AI 摘要卡 */
.summary-card {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.summary-body {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px dashed var(--rule);
  font-size: 26rpx;
  line-height: 1.7;
}

.summary-relation {
  margin-bottom: 8rpx;
}

.summary-topics {
  margin-top: 8rpx;
}

.topic-badge {
  margin-right: 12rpx;
  color: var(--muted);
}

.toggle-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
}

/* 消息列表 */
.message-list {
  padding: 8rpx 4rpx 24rpx;
}

.date-bubble {
  text-align: center;
  margin: 24rpx 0 12rpx;
}

.date-bubble-text {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: var(--bg2);
  color: var(--muted);
  border-radius: 20rpx;
  font-size: 22rpx;
}

.message-row {
  align-items: flex-start;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.message-row-me {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg3);
}

.msg-bubble {
  max-width: 520rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  position: relative;
  word-break: break-word;
}

.msg-bubble-other {
  background: var(--bg2);
  color: var(--ink);
  border: 1px solid var(--rule);
  border-top-left-radius: 8rpx;
}

.msg-bubble-me {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  border-top-right-radius: 8rpx;
}

.msg-text {
  display: block;
  color: inherit;
}

.msg-image {
  max-width: 400rpx;
  max-height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.msg-time {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
  opacity: 0.8;
}

.msg-bubble-me .msg-time {
  color: rgba(255,255,255,0.8);
}

/* AI 提问区 */
.ai-query {
  margin-top: 24rpx;
  padding: 24rpx;
}

.ai-query-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ai-input-row {
  margin-top: 16rpx;
  gap: 12rpx;
}

.ai-input {
  background: var(--bg3);
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.btn-ask {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.btn-ask[disabled] {
  opacity: 0.5;
}

.ai-answer {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: rgba(124, 92, 252, 0.1);
  border-left: 4rpx solid var(--accent);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
}

.text-xs {
  font-size: 22rpx;
}

/* 锚点标记（从聊天总结卡跳转到此处） */
.anchor-marker {
  text-align: center;
  margin: 28rpx 0 12rpx;
}
.anchor-text {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: linear-gradient(90deg, rgba(124, 92, 252, 0.25), rgba(52, 211, 153, 0.2));
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 1px solid rgba(124, 92, 252, 0.4);
}
