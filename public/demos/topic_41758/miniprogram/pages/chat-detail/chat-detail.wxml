<view class="chat-detail-page">
  <view wx:if="{{loading}}" class="loading-text text-center text-muted">加载中...</view>

  <block wx:else>
    <!-- 顶部 AI 摘要卡 -->
    <view wx:if="{{conversation}}" class="summary-card card" bindtap="toggleSummary">
      <view class="summary-title flex-row flex-between">
        <text>🔮 与「{{conversation.conversation_name}}」的对话</text>
        <text class="text-muted text-xs">共 {{conversation.message_count}} 条消息</text>
      </view>
      <block wx:if="{{showSummary}}">
        <text class="text-muted text-xs" wx:if="{{periodStart}}">已定位到 {{periodStart}} 时段 →</text>
        <text class="text-muted text-xs" wx:else>已自动按周/月聚合，查看上方"记忆"页面</text>
      </block>
      <text class="toggle-hint text-xs" wx:if="{{showSummary}}">▲ 点击收起</text>
      <text class="toggle-hint text-xs" wx:else>▼ 点击展开</text>
    </view>

    <!-- 消息流 -->
    <view class="message-list">
      <block wx:for="{{messages}}" wx:key="_id" wx:for-item="msg">
        <!-- 日期 -->
        <view wx:if="{{msg.type === 'date'}}" class="date-bubble" id="{{msg._id}}">
          <text class="date-bubble-text">{{msg.text}}</text>
        </view>

        <!-- 锚点标记（从聊天总结卡跳转进来时显示） -->
        <view wx:elif="{{msg.type === 'anchor_marker'}}" class="anchor-marker" id="{{msg._id}}">
          <text class="anchor-text">⬇ {{msg.text}}</text>
        </view>

        <!-- 对方消息 -->
        <view wx:elif="{{msg.sender && !msg.is_me}}" class="message-row flex-row" id="{{msg._id}}">
          <image class="msg-avatar" src="{{msg.avatar_url}}" mode="aspectFill" />
          <view class="msg-bubble msg-bubble-other">
            <image wx:if="{{msg.type === 'image_msg'}}" class="msg-image" src="{{msg.media_url}}" mode="widthFix" data-url="{{msg.media_url}}" catchtap="previewImage" />
            <text wx:else class="msg-text">{{msg.content}}</text>
            <text class="msg-time text-xs">{{msg.timestamp_text}}</text>
          </view>
        </view>

        <!-- 我方消息 -->
        <view wx:else class="message-row flex-row message-row-me" id="{{msg._id}}">
          <view class="msg-bubble msg-bubble-me">
            <image wx:if="{{msg.type === 'image_msg'}}" class="msg-image" src="{{msg.media_url}}" mode="widthFix" data-url="{{msg.media_url}}" catchtap="previewImage" />
            <text wx:else class="msg-text">{{msg.content}}</text>
            <text class="msg-time text-xs">{{msg.timestamp_text}}</text>
          </view>
          <image class="msg-avatar" src="{{msg.avatar_url}}" mode="aspectFill" />
        </view>
      </block>

      <view id="chat-end" style="height:40rpx"></view>
    </view>

    <!-- AI 提问区 -->
    <view class="ai-query card">
      <view class="ai-query-title flex-row">
        <text>🔮 跨时空对话</text>
      </view>
      <text class="text-muted text-xs">问问你的记忆：那阵子聊了什么？</text>
      <view class="ai-input-row flex-row">
        <input class="ai-input flex-1" placeholder="输入问题..." value="{{dialogInput}}" bindinput="onDialogInput" confirm-type="send" bindconfirm="askAI" />
        <button class="btn-ask" bindtap="askAI" disabled="{{aiThinking}}">{{aiThinking ? '思考中' : '问 AI'}}</button>
      </view>
      <view wx:if="{{aiAnswer}}" class="ai-answer">
        <text>{{aiAnswer}}</text>
      </view>
    </view>
  </block>
</view>
