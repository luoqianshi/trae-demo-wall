<view class="container import-photos-page">
  <text class="page-title">导入相册照片</text>
  <text class="page-desc text-muted">选择手机相册中的照片，上传后可在创建胶囊时选用</text>

  <!-- 已选照片网格 -->
  <view wx:if="{{ selectedPhotos.length > 0 }}" class="photo-grid">
    <view class="photo-item" wx:for="{{ selectedPhotos }}" wx:key="*this">
      <image src="{{ item.path }}" mode="aspectFill" />
      <view class="photo-remove" data-index="{{ index }}" catchtap="removePhoto">✕</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-hint">
    <text class="empty-emoji">📸</text>
    <text class="text-muted">点击下方按钮选择照片</text>
    <text class="text-muted" style="font-size:22rpx;margin-top:8rpx;">一次最多选择 500 张</text>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <button
      class="btn btn-secondary"
      bindtap="choosePhotos"
      disabled="{{ uploading }}"
      wx:if="{{ !uploadProgress.done }}"
    >选择照片</button>

    <button
      class="btn btn-primary"
      bindtap="startUpload"
      loading="{{ uploading }}"
      disabled="{{ uploading || selectedPhotos.length === 0 }}"
      wx:if="{{ !uploadProgress.done }}"
    >
      {{ uploading ? '上传中 ' + uploadProgress.current + '/' + uploadProgress.total : '开始上传' }}
    </button>

    <button
      class="btn btn-primary"
      bindtap="skip"
      wx:if="{{ uploadProgress.done }}"
    >完成</button>
  </view>

  <!-- 提示 -->
  <text class="text-muted text-center mt-32" wx:if="{{ !uploadProgress.done }}">
    也可以跳过，稍后在"我的"页面再导入
  </text>
</view>
