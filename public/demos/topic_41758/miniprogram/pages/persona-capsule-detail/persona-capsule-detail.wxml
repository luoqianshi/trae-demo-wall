<!-- 人设胶囊详情 -->
<view class="persona-detail-page">
  <block wx:if="{{ loading }}">
    <view class="loading-state">
      <text class="loading-spinner">⏳</text>
      <text class="loading-text text-muted">加载中...</text>
    </view>
  </block>

  <block wx:elif="{{ capsule }}">
    <!-- Persona Header -->
    <view class="persona-header">
      <view class="persona-avatar-wrap">
        <text class="persona-avatar">{{ capsule.avatar }}</text>
      </view>
      <text class="persona-name">{{ capsule.name }}</text>
      <text class="persona-desc text-muted">{{ capsule.description }}</text>
      <view class="persona-meta flex-row">
        <text class="meta-item text-muted">创建于 {{ capsule.createdAt }}</text>
        <text class="meta-dot text-muted">·</text>
        <text class="meta-item text-muted">{{ memoryCount }} 条记忆</text>
      </view>
      <view class="btn btn-primary btn-chat" bindtap="startChat">
        <text>开始对话</text>
      </view>
    </view>

    <!-- AI Persona Summary Card -->
    <view class="card card-accent ai-summary-card">
      <view class="flex-row ai-summary-head">
        <text class="ai-summary-icon">✨</text>
        <text class="ai-summary-title">AI 人设画像</text>
      </view>
      <text class="ai-summary-text">{{ capsule.aiSummary }}</text>
      <view class="trait-list flex-wrap" wx:if="{{ capsule.traits && capsule.traits.length > 0 }}">
        <block wx:for="{{ capsule.traits }}" wx:key="*this">
          <text class="trait-tag">{{ item }}</text>
        </block>
      </view>
    </view>

    <!-- Memory Sources Section -->
    <view class="memory-section">
      <view class="section-label">记忆来源</view>

      <!-- Tabs -->
      <view class="tab-bar">
        <block wx:for="{{ tabs }}" wx:key="key">
          <view
            class="tab-item {{ activeTab === item.key ? 'tab-active' : '' }}"
            data-key="{{ item.key }}"
            bindtap="switchTab"
          >
            <text class="tab-icon">{{ item.icon }}</text>
            <text class="tab-label">{{ item.label }}</text>
            <block wx:if="{{ item.key === 'photos' }}">
              <text class="tab-count">{{ photoCount }}</text>
            </block>
            <block wx:elif="{{ item.key === 'moments' }}">
              <text class="tab-count">{{ momentsCount }}</text>
            </block>
            <block wx:elif="{{ item.key === 'chats' }}">
              <text class="tab-count">{{ chatsCount }}</text>
            </block>
            <block wx:elif="{{ item.key === 'bottles' }}">
              <text class="tab-count">{{ bottlesCount }}</text>
            </block>
          </view>
        </block>
      </view>

      <!-- Photos Tab -->
      <block wx:if="{{ activeTab === 'photos' }}">
        <view class="photo-grid" wx:if="{{ photoCount > 0 }}">
          <block wx:for="{{ capsule.photos }}" wx:key="id" wx:for-item="photo">
            <view class="photo-cell" data-url="{{ photo.url }}" bindtap="previewPhoto">
              <image class="photo-img" src="{{ photo.url }}" mode="aspectFill" lazy-load/>
              <text class="photo-desc">{{ photo.desc }}</text>
            </view>
          </block>
        </view>
        <view class="empty-tab" wx:else>
          <text class="empty-tab-icon">📷</text>
          <text class="empty-tab-text text-muted">暂无照片</text>
        </view>
      </block>

      <!-- Moments Tab -->
      <block wx:elif="{{ activeTab === 'moments' }}">
        <view class="moments-list" wx:if="{{ momentsCount > 0 }}">
          <block wx:for="{{ capsule.moments }}" wx:key="id" wx:for-item="moment">
            <view class="moment-item">
              <text class="moment-content">{{ moment.content }}</text>
              <view class="flex-between mt-16">
                <text class="moment-date text-muted">{{ moment.date }}</text>
                <text class="moment-likes text-muted">❤ {{ moment.likes }}</text>
              </view>
            </view>
          </block>
        </view>
        <view class="empty-tab" wx:else>
          <text class="empty-tab-icon">📝</text>
          <text class="empty-tab-text text-muted">暂无朋友圈</text>
        </view>
      </block>

      <!-- Chats Tab -->
      <block wx:elif="{{ activeTab === 'chats' }}">
        <view class="chats-list" wx:if="{{ chatsCount > 0 }}">
          <block wx:for="{{ capsule.chats }}" wx:key="id" wx:for-item="chat">
            <view class="chat-item">
              <view class="flex-between">
                <text class="chat-title">{{ chat.title }}</text>
                <text class="chat-date text-muted">{{ chat.date }}</text>
              </view>
              <text class="chat-summary text-muted mt-8">{{ chat.summary }}</text>
              <text class="chat-badge">{{ chat.msgCount }} 条消息</text>
            </view>
          </block>
        </view>
        <view class="empty-tab" wx:else>
          <text class="empty-tab-icon">💬</text>
          <text class="empty-tab-text text-muted">暂无聊天记录</text>
        </view>
      </block>

      <!-- Bottles Tab -->
      <block wx:elif="{{ activeTab === 'bottles' }}">
        <view class="bottles-list" wx:if="{{ bottlesCount > 0 }}">
          <block wx:for="{{ capsule.bottles }}" wx:key="id" wx:for-item="bottle">
            <view class="bottle-item">
              <view class="flex-between">
                <text class="bottle-title">{{ bottle.title }}</text>
                <text class="bottle-date text-muted">{{ bottle.date }}</text>
              </view>
              <text class="bottle-content text-muted mt-8">{{ bottle.content }}</text>
            </view>
          </block>
        </view>
        <view class="empty-tab" wx:else>
          <text class="empty-tab-icon">🍾</text>
          <text class="empty-tab-text text-muted">暂无漂流瓶</text>
        </view>
      </block>
    </view>

    <!-- Action Buttons -->
    <view class="action-bar">
      <view class="btn btn-secondary btn-half" bindtap="editCapsule">
        <text>✏️ 编辑</text>
      </view>
      <view class="btn btn-secondary btn-half btn-danger-custom" bindtap="deleteCapsule">
        <text>🗑 删除胶囊</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="empty-state">
      <text class="empty-icon">🧩</text>
      <text class="empty-text text-muted">胶囊不存在</text>
      <view class="btn btn-primary btn-block" bindtap="goBack">
        <text>返回</text>
      </view>
    </view>
  </block>
</view>
