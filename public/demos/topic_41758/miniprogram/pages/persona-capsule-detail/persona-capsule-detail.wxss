/* ========== 人设胶囊详情页（Dark） ========== */

.persona-detail-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  background: var(--bg);
}

/* ========== Persona Header ========== */
.persona-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
  margin-bottom: 24rpx;
}

.persona-avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 92, 252, 0.3);
}

.persona-avatar {
  font-size: 80rpx;
  line-height: 1;
}

.persona-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.persona-desc {
  font-size: 26rpx;
  text-align: center;
  padding: 0 40rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.persona-meta {
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.meta-item {
  font-size: 24rpx;
}

.meta-dot {
  font-size: 24rpx;
}

.btn-chat {
  width: 80%;
  max-width: 480rpx;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(124, 92, 252, 0.35);
}

/* ========== AI Summary Card ========== */
.ai-summary-card {
  margin-bottom: 32rpx;
}

.ai-summary-head {
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.ai-summary-icon {
  font-size: 32rpx;
}

.ai-summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

.ai-summary-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--ink);
  display: block;
  margin-bottom: 20rpx;
}

.trait-list {
  display: flex;
  gap: 12rpx;
}

.trait-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(124, 92, 252, 0.12);
  color: var(--accent);
  border: 1px solid rgba(124, 92, 252, 0.25);
}

/* ========== Memory Section ========== */
.memory-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
}

.tab-item {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 12rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
  transition: all 0.2s;
}

.tab-item:active {
  background: var(--bg3);
}

.tab-active {
  background: rgba(124, 92, 252, 0.1);
  border-color: var(--accent);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.tab-label {
  font-size: 22rpx;
  color: var(--muted);
}

.tab-active .tab-label {
  color: var(--accent);
  font-weight: 600;
}

.tab-count {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.tab-active .tab-count {
  color: var(--accent);
}

/* ========== Photos Grid ========== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-cell {
  width: calc((100% - 24rpx) / 3);
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--bg2);
  border: 1px solid var(--rule);
}

.photo-cell:active {
  opacity: 0.8;
}

.photo-img {
  width: 100%;
  height: 200rpx;
  display: block;
}

.photo-desc {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== Moments List ========== */
.moments-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.moment-item {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 24rpx;
}

.moment-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  display: block;
  word-break: break-word;
}

.moment-date {
  font-size: 22rpx;
}

.moment-likes {
  font-size: 22rpx;
}

/* ========== Chats List ========== */
.chats-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chat-item {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 24rpx;
}

.chat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.chat-date {
  font-size: 22rpx;
  flex-shrink: 0;
}

.chat-summary {
  font-size: 26rpx;
  line-height: 1.6;
  display: block;
}

.chat-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: var(--accent);
  background: rgba(124, 92, 252, 0.1);
  border: 1px solid rgba(124, 92, 252, 0.2);
}

/* ========== Bottles List ========== */
.bottles-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bottle-item {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 24rpx;
}

.bottle-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.bottle-date {
  font-size: 22rpx;
  flex-shrink: 0;
}

.bottle-content {
  font-size: 26rpx;
  line-height: 1.6;
  display: block;
}

/* ========== Empty Tab State ========== */
.empty-tab {
  text-align: center;
  padding: 80rpx 40rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
}

.empty-tab-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-tab-text {
  font-size: 26rpx;
}

/* ========== Action Bar ========== */
.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn-half {
  flex: 1;
  height: 88rpx;
}

.btn-danger-custom {
  background: linear-gradient(135deg, rgba(244, 114, 182, 0.8), var(--danger));
  color: #fff;
  border: none;
}

/* ========== Loading & Empty States ========== */
.loading-state {
  text-align: center;
  padding: 150rpx 0;
}

.loading-spinner {
  font-size: 64rpx;
  display: block;
  margin-bottom: 20rpx;
  animation: spin 1.2s linear infinite;
}

.loading-text {
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 26rpx;
  display: block;
  margin-bottom: 32rpx;
}

.btn-block {
  width: auto;
  display: inline-flex;
  margin: 0 auto;
  padding: 0 48rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
