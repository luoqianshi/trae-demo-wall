<!-- 我的 -->
<view class="container import-page">

  <!-- 用户信息 -->
  <view class="user-header">
    <image class="avatar avatar-lg" src="{{ userInfo.avatar_url }}" mode="aspectFill" />
    <text class="user-name">{{ userInfo.nickname }}</text>
    <text class="user-bio text-muted">时光胶囊 · 收藏每一个此刻</text>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stat-item" bindtap="goPhotos">
      <text class="stat-num">{{ stats.totalPhotos || 0 }}</text>
      <text class="stat-label text-muted">照片</text>
    </view>
    <view class="stat-item" bindtap="goMoments">
      <text class="stat-num">{{ stats.totalMoments || 0 }}</text>
      <text class="stat-label text-muted">朋友圈</text>
    </view>
    <view class="stat-item" bindtap="goChats">
      <text class="stat-num">{{ stats.totalChats || 0 }}</text>
      <text class="stat-label text-muted">聊天</text>
    </view>
    <view class="stat-item" bindtap="goCapsules">
      <text class="stat-num">{{ stats.totalCapsules || 0 }}</text>
      <text class="stat-label text-muted">漂流瓶</text>
    </view>
  </view>

  <!-- 我的记忆 -->
  <view class="section-title mt-32">我的记忆</view>
  <view class="browse-grid">
    <view class="browse-card" bindtap="goMemories">
      <text class="browse-emoji">🗂️</text>
      <text class="browse-title">时间线</text>
      <text class="browse-desc text-muted">全部记忆按时间排列</text>
    </view>
    <view class="browse-card" bindtap="goPhotos">
      <text class="browse-emoji">📷</text>
      <text class="browse-title">照片</text>
      <text class="browse-desc text-muted">{{ stats.totalPhotos || 0 }} 张</text>
    </view>
    <view class="browse-card" bindtap="goMoments">
      <text class="browse-emoji">📝</text>
      <text class="browse-title">朋友圈</text>
      <text class="browse-desc text-muted">{{ stats.totalMoments || 0 }} 条</text>
    </view>
    <view class="browse-card" bindtap="goChats">
      <text class="browse-emoji">💬</text>
      <text class="browse-title">聊天</text>
      <text class="browse-desc text-muted">{{ stats.totalMessages || 0 }} 条消息</text>
    </view>
  </view>

  <!-- 记忆胶囊 -->
  <view class="section-title mt-32">记忆胶囊</view>
  <view class="browse-grid">
    <view class="browse-card browse-card-accent" bindtap="goPersonaCapsules">
      <text class="browse-emoji">🧬</text>
      <text class="browse-title">我的胶囊</text>
      <text class="browse-desc text-muted">封存记忆，生成 AI 人设</text>
    </view>
    <view class="browse-card" bindtap="goPersonaCapsuleCreate">
      <text class="browse-emoji">➕</text>
      <text class="browse-title">新建胶囊</text>
      <text class="browse-desc text-muted">选择记忆，封装新人设</text>
    </view>
  </view>

  <!-- 导入入口 -->
  <view class="section-title mt-32">导入更多记忆</view>
  <view class="import-grid">
    <view class="import-card" bindtap="goImportPhotos">
      <text class="import-icon">🖼️</text>
      <text class="import-title">导入相册照片</text>
      <text class="import-desc text-muted">从手机相册中选择照片封存</text>
      <text class="import-arrow text-accent">开始导入 →</text>
    </view>
    <view class="import-card" bindtap="goImportChats">
      <text class="import-icon">💬</text>
      <text class="import-title">导入聊天记录</text>
      <text class="import-desc text-muted">上传微信聊天记录导出文件</text>
      <text class="import-arrow text-accent">开始导入 →</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section-title mt-32">快捷入口</view>
  <view class="menu-card card" bindtap="goCapsules">
    <text class="menu-icon">🍾</text>
    <text class="flex-1">我的漂流瓶</text>
    <text class="text-muted">→</text>
  </view>
  <view class="menu-card card mt-16" bindtap="goPersonaCapsules">
    <text class="menu-icon">🧬</text>
    <text class="flex-1">记忆胶囊</text>
    <text class="text-muted">→</text>
  </view>

  <!-- 退出 -->
  <view class="logout-btn mt-32" bindtap="handleLogout">
    <text class="text-muted">退出登录</text>
  </view>
</view>
