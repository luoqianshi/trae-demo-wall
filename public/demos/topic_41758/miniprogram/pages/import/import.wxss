.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 16rpx;
}

.user-bio {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--rule);
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 12rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--accent);
}

.stat-label { font-size: 24rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 20rpx;
}

/* 浏览我的记忆 - 2x2 网格 */
.browse-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.browse-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.browse-card:active {
  border-color: var(--accent);
  background: rgba(124, 92, 252, 0.08);
}

.browse-emoji {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.browse-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  display: block;
}

.browse-desc {
  font-size: 22rpx;
  margin-top: 4rpx;
  display: block;
}

/* 导入卡片 */
.import-grid {
  display: flex;
  gap: 20rpx;
}

.import-card {
  flex: 1;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
}

.import-card:active {
  border-color: var(--accent);
}

.import-icon { font-size: 56rpx; display: block; margin-bottom: 16rpx; }
.import-title { font-size: 28rpx; font-weight: 600; color: #fff; display: block; margin-bottom: 8rpx; }
.import-desc { font-size: 24rpx; margin-bottom: 12rpx; }
.import-arrow { font-size: 24rpx; font-weight: 600; }

.menu-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-card:active {
  background: rgba(124, 92, 252, 0.06);
}

.menu-icon { font-size: 40rpx; }

/* 记忆胶囊高亮卡片 */
.browse-card-accent {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.15), rgba(124, 92, 252, 0.05));
  border-color: rgba(124, 92, 252, 0.4);
}

.browse-card-accent:active {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.25), rgba(124, 92, 252, 0.08));
  border-color: var(--accent);
}

.mt-16 { margin-top: 16rpx; }

.logout-btn {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
