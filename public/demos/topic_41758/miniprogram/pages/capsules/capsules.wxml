<!-- 漂流瓶列表 -->
<view class="container capsules-page">
  <view class="page-header">
    <text class="page-title-gradient">时光漂流瓶</text>
  </view>

  <!-- 类型 Tab（默认不选择，代表全部；点击选中，再次点击取消选中 -->
  <view class="tabs-row">
    <view class="tab-item {{ typeFilter === 'self' ? 'tab-active' : '' }}" data-type="self" bindtap="switchType">
      <text class="tab-icon">⏰</text>
      <text class="tab-text">给自己</text>
    </view>
    <view class="tab-item {{ typeFilter === 'user' ? 'tab-active' : '' }}" data-type="user" bindtap="switchType">
      <text class="tab-icon">💌</text>
      <text class="tab-text">给用户</text>
    </view>
    <view class="tab-item {{ typeFilter === 'location' ? 'tab-active' : '' }}" data-type="location" bindtap="switchType">
      <text class="tab-icon">📍</text>
      <text class="tab-text">给地点</text>
    </view>
  </view>

  <!-- 封存中数字卡片（仅显示封存数量，不显示开启时间 -->
  <view class="sealed-count-card" wx:if="{{ sealedOfTypeCount > 0 }}" bindtap="goSealedList">
    <view class="sealed-count-left">
      <text class="sealed-count-num">{{ sealedOfTypeCount }}</text>
      <text class="sealed-count-label text-muted">封存中 · 点击查看</text>
    </view>
    <text class="sealed-count-icon">🔒</text>
  </view>

  <!-- 已开启列表 -->
  <block wx:if="{{ loading }}">
    <view class="loading-state">
      <text class="loading-spinner">⏳</text>
      <text class="loading-text text-muted">加载中...</text>
    </view>
  </block>
  <block wx:elif="{{ filteredUnlocked.length === 0 }}">
    <view class="empty-state">
      <text class="empty-icon">🍾</text>
      <text class="empty-text text-muted">暂无已开启的漂流瓶</text>
      <view class="btn btn-primary btn-block" bindtap="goCreate"><text>封存第一个</text></view>
    </view>
  </block>
  <block wx:else>
    <view class="unlocked-list">
      <block wx:for="{{ filteredUnlocked }}" wx:key="id">
        <view class="bottle-card" data-id="{{ item.id }}" bindtap="onBottleTap">
          <view class="bottle-card-left">
            <text class="bottle-card-title">{{ item.title }}</text>
            <text class="bottle-card-date text-muted">{{ item.unlockAtText }} 已开启</text>
            <text class="bottle-card-meta text-muted" wx:if="{{ item.subInfo }}">{{ item.subInfo }}</text>
          </view>
          <text class="bottle-card-arrow">›</text>
        </view>
      </block>
    </view>
  </block>

  <!-- 创建漂流瓶悬浮按钮 -->
  <view class="fab" bindtap="goCreate">
    <text class="fab-icon">＋</text>
  </view>
</view>
