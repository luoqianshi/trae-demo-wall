/* ========== 时光漂流瓶 · 列表页（Dark · 简化） ========== */

.capsules-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 160rpx;
  background: var(--bg);
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.page-title-gradient {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  display: block;
  letter-spacing: 2rpx;
}

/* 类型 Tab */
.tabs-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
}

.tab-item:active {
  background: var(--bg3);
}

.tab-active {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.25), rgba(124, 92, 252, 0.1));
  border-color: var(--accent);
  box-shadow: 0 4rpx 20rpx rgba(124, 92, 252, 0.2);
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
}

/* 封存中数字卡片 */
.sealed-count-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, rgba(240, 192, 96, 0.15), rgba(240, 192, 96, 0.05));
  border: 1px solid rgba(240, 192, 96, 0.3);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.sealed-count-card:active {
  background: linear-gradient(135deg, rgba(240, 192, 96, 0.25), rgba(240, 192, 96, 0.08));
}

.sealed-count-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.sealed-count-num {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--accent2);
  line-height: 1;
  display: block;
  margin-bottom: 8rpx;
}

.sealed-count-label {
  font-size: 24rpx;
  display: block;
}

.sealed-count-icon {
  font-size: 56rpx;
  margin-left: 16rpx;
}

/* 已开启列表 */
.unlocked-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bottle-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
}

.bottle-card:active {
  background: var(--bg3);
}

.bottle-card-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.bottle-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
}

.bottle-card-date {
  font-size: 24rpx;
  display: block;
}

.bottle-card-meta {
  font-size: 22rpx;
  display: block;
  margin-top: 6rpx;
}

.bottle-card-arrow {
  font-size: 40rpx;
  color: var(--muted);
  margin-left: 12rpx;
}

/* 空状态 & 加载 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 26rpx;
  display: block;
  margin-bottom: 32rpx;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
}

.loading-spinner {
  font-size: 48rpx;
  display: block;
  margin-bottom: 14rpx;
  animation: spin 1.2s linear infinite;
}

.loading-text {
  font-size: 24rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* FAB */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: 80rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  box-shadow: 0 8rpx 32rpx rgba(124, 92, 252, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.fab-icon {
  color: #fff;
  font-size: 60rpx;
  line-height: 1;
  font-weight: 300;
}

/* 按钮 */
.btn-block {
  width: auto;
  display: inline-flex;
  margin: 0 auto;
  padding: 0 48rpx;
}
