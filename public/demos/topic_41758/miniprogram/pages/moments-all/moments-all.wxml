<view class="page">
  <view wx:if="{{loading && items.length === 0}}" class="loading-text text-center text-muted">加载中...</view>

  <view wx:if="{{total_available > 0}}" class="total-info text-muted">
    共 {{total_available}} 条朋友圈记录
  </view>

  <view class="moment-list">
    <block wx:for="{{items}}" wx:key="id">
      <view class="moment-card">
        <view class="moment-head flex-row">
          <view class="moment-date-wrap">
            <text class="moment-date">{{item.occurred_at_text}}</text>
            <text class="moment-location text-muted" wx:if="{{item.location_name}}">📍 {{item.location_name}}</text>
          </view>
          <view class="moment-mood" wx:if="{{item.ai && item.ai.mood}}">
            <text class="mood-tag">{{item.ai.mood}}</text>
          </view>
        </view>

        <text class="moment-text" wx:if="{{item.content.text}}">{{item.content.text}}</text>

        <view class="moment-media" wx:if="{{item.content.media && item.content.media.length}}">
          <block wx:for="{{item.content.media}}" wx:for-item="m" wx:for-index="idx" wx:key="*this">
            <image
              class="media-item {{item.content.media.length === 1 ? 'media-single' : ''}}"
              src="{{m}}"
              mode="aspectFill"
              data-url="{{m}}"
              data-urls="{{item.content.media}}"
              catchtap="previewPhoto"
            />
          </block>
        </view>

        <view class="moment-footer flex-row">
          <text class="like-count text-muted">👍 {{item.metadata.likes_count || 0}}</text>
          <text class="comment-count text-muted">💬 {{item.metadata.comments_count || 0}}</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{noMore && items.length > 0}}" class="end-text text-muted">—— 已显示全部 {{total}} 条 ——</view>
  <view wx:elif="{{items.length > 0}}" class="end-text text-muted">上拉加载更多</view>
</view>
