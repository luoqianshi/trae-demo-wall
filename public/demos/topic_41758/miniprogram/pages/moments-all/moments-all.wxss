.page {
  padding: 16rpx 20rpx 60rpx;
  background: var(--bg);
  min-height: 100vh;
}

.total-info {
  padding: 12rpx 8rpx 20rpx;
  font-size: 24rpx;
}

.moment-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.moment-head {
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.moment-date {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
  display: block;
}

.moment-location {
  font-size: 22rpx;
  display: block;
  margin-top: 4rpx;
}

.mood-tag {
  background: rgba(124, 92, 252, 0.15);
  color: var(--accent);
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.moment-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
  display: block;
  margin-bottom: 16rpx;
}

.moment-media {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
  margin-bottom: 16rpx;
}

.media-item {
  width: 100%;
  aspect-ratio: 1;
  background: var(--bg3);
  border-radius: 10rpx;
}

.media-single {
  grid-column: span 3;
  aspect-ratio: 1.6;
  height: 360rpx;
  width: 100%;
}

.moment-footer {
  justify-content: flex-start;
  gap: 24rpx;
  padding-top: 12rpx;
  border-top: 1px dashed var(--rule);
}

.like-count, .comment-count {
  font-size: 24rpx;
}

.end-text {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
}

.loading-text {
  padding: 80rpx 0;
}
