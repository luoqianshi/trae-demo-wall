<!-- 漂流瓶详情 -->
<view class="container capsule-detail-page">
  <block wx:if="{{ loading }}">
    <view class="loading-state">
      <text class="loading-spinner">⏳</text>
      <text class="loading-text text-muted">加载中...</text>
    </view>
  </block>

  <!-- 封存中：脱敏界面 -->
  <block wx:elif="{{ bottle && bottle.status === 'sealed' }}">
    <view class="sealed-view">
      <view class="sealed-lock-wrap">
        <text class="sealed-lock">🔒</text>
      </view>
      <text class="sealed-title-gradient">封存中</text>
      <text class="sealed-hint text-muted">内容已脱敏</text>

      <view class="sealed-info-card">
        <view class="info-row">
          <text class="info-key text-muted">封存时间</text>
          <text class="info-val">{{ bottle.sealed_at_text }}</text>
        </view>
      </view>

      <view class="sealed-blur-card">
        <text class="blur-line">· · · · · · · · · · · · · · ·</text>
        <text class="blur-line">· · · · · · · · · · · · · · ·</text>
        <text class="blur-line">· · · · · · · · · · · · · · ·</text>
      </view>

      <view class="btn btn-primary btn-block" bindtap="goBack">
        <text>返回列表</text>
      </view>
    </view>
  </block>

  <!-- 已开启：完整内容 -->
  <block wx:elif="{{ bottle }}">
    <text class="detail-title">{{ bottle.title }}</text>
    <text class="detail-date text-muted">已于 {{ bottle.unlock_at_text }} 开启</text>

    <view class="meta-card">
      <view class="meta-row" wx:if="{{ bottle.location_name }}">
        <text class="meta-key text-muted">📍 位置</text>
        <text class="meta-val">{{ bottle.location_name }}</text>
      </view>
      <view class="meta-row" wx:if="{{ bottle.target_user_name }}">
        <text class="meta-key text-muted">💌 指定用户</text>
        <text class="meta-val">{{ bottle.target_user_name }}</text>
      </view>
      <view class="meta-row">
        <text class="meta-key text-muted">⏰ 封存时间</text>
        <text class="meta-val">{{ bottle.sealed_at_text }}</text>
      </view>
    </view>

    <view class="content-card" wx:if="{{ bottle.content_text }}">
      <text class="content-text">{{ bottle.content_text }}</text>
    </view>

    <!-- 图片 -->
    <view class="photo-grid" wx:if="{{ bottle.photos && bottle.photos.length > 0 }}">
      <block wx:for="{{ bottle.photos }}" wx:key="id" wx:for-item="photo">
        <image class="photo-img" src="{{ photo.url }}" mode="aspectFill" data-url="{{ photo.url }}" bindtap="previewPhoto"/>
      </block>
    </view>

    <!-- 视频 -->
    <view class="video-list" wx:if="{{ bottle.videos && bottle.videos.length > 0 }}">
      <block wx:for="{{ bottle.videos }}" wx:key="id" wx:for-item="video">
        <view class="video-row" data-url="{{ video.url }}" bindtap="playVideo">
          <text class="video-emoji">🎬</text>
          <text class="video-label">视频 {{ index + 1 }}</text>
          <text class="video-arrow">›</text>
        </view>
      </block>
    </view>

    <!-- 位置型留言 -->
    <view class="comment-card" wx:if="{{ bottle.bottle_type === 'location' || bottle.type === 'location' }}">
      <view class="section-head">
        <text class="section-line"></text>
        <text class="section-title">💬 拾瓶留言 ({{ bottle.commentsCount }})</text>
        <text class="section-line"></text>
      </view>
      <view class="comment-input-row">
        <textarea class="comment-ta" placeholder="留下一句感悟再放回..." value="{{ commentInput }}" bindinput="onCommentInput" maxlength="200"></textarea>
        <view class="btn btn-primary btn-comment" bindtap="submitComment"><text>放回漂流瓶</text></view>
      </view>
      <view class="empty-comments text-muted" wx:if="{{ !bottle.comments || bottle.comments.length === 0 }}">
        <text>暂时还没有留言</text>
      </view>
      <view class="comment-list" wx:else>
        <block wx:for="{{ bottle.comments }}" wx:key="id" wx:for-item="c">
          <view class="comment-item">
            <text class="comment-user text-muted">匿名 · {{ c.created_at_text }}</text>
            <text class="comment-text">{{ c.text }}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="action-bar">
      <view class="btn btn-secondary btn-half" bindtap="shareBottle"><text>📤 分享</text></view>
      <view class="btn btn-primary btn-half btn-danger-custom" bindtap="deleteBottle"><text>🗑 删除</text></view>
    </view>
  </block>

  <block wx:else>
    <view class="empty-state">
      <text class="empty-icon">🍾</text>
      <text class="empty-text text-muted">漂流瓶不存在</text>
      <view class="btn btn-primary btn-block" bindtap="goBack"><text>返回</text></view>
    </view>
  </block>
</view>
