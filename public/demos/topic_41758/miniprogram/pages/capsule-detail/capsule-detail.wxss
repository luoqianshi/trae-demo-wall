/* ========== 时光漂流瓶 · 详情页（Dark · 简化） ========== */

.capsule-detail-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  background: var(--bg);
}

/* ========== 🔒 封存中界面 ========== */
.sealed-view {
  text-align: center;
  padding: 80rpx 20rpx 60rpx;
}

.sealed-lock-wrap {
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(240, 192, 96, 0.2), rgba(240, 192, 96, 0.08));
  border: 2px solid rgba(240, 192, 96, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sealed-lock {
  font-size: 90rpx;
  line-height: 1;
}

.sealed-title-gradient {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent2), #f5d780);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  display: block;
  margin-bottom: 12rpx;
}

.sealed-hint {
  font-size: 24rpx;
  display: block;
  margin-bottom: 60rpx;
}

/* 封存信息卡 */
.sealed-info-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.info-row-divider {
  border-top: 1px solid var(--rule);
}

.info-key {
  font-size: 26rpx;
}

.info-val {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 600;
}

/* 脱敏内容卡片 */
.sealed-blur-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 50rpx 30rpx;
  margin-bottom: 50rpx;
  opacity: 0.5;
}

.blur-line {
  font-size: 28rpx;
  color: var(--muted);
  letter-spacing: 8rpx;
  display: block;
  margin: 18rpx 0;
}

/* ========== 已开启界面 ========== */

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  display: block;
  margin-bottom: 12rpx;
  padding: 20rpx 20rpx 12rpx;
}

.detail-date {
  font-size: 24rpx;
  text-align: center;
  display: block;
  margin-bottom: 40rpx;
}

/* 元信息卡 */
.meta-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--rule);
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-key {
  font-size: 26rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.meta-val {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
  text-align: right;
  flex: 1;
}

/* 内容卡 */
.content-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
  display: block;
}

/* 图片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 10rpx 0;
  margin-bottom: 24rpx;
}

.photo-grid .photo-img {
  width: calc((100% - 20rpx) / 3);
  height: 200rpx;
  border-radius: 16rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
}

/* 视频列表 */
.video-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.video-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
}

.video-row:active {
  background: var(--bg3);
}

.video-emoji {
  font-size: 32rpx;
  margin-right: 14rpx;
}

.video-label {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}

.video-arrow {
  font-size: 32rpx;
  color: var(--muted);
}

/* 评论卡片 */
.comment-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.section-line {
  flex: 1;
  height: 1px;
  background: var(--rule);
}

.section-title {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: var(--accent);
}

.comment-input-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.comment-ta {
  width: 100%;
  padding: 20rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
  min-height: 120rpx;
  box-sizing: border-box;
}

.btn-comment {
  align-self: center;
  padding: 14rpx 60rpx;
  font-size: 26rpx;
}

.empty-comments {
  text-align: center;
  padding: 30rpx 0 10rpx;
  font-size: 24rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.comment-item {
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
}

.comment-user {
  font-size: 22rpx;
  display: block;
  margin-bottom: 8rpx;
}

.comment-text {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
  display: block;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.btn-half {
  flex: 1;
  height: 88rpx;
}

.btn-danger-custom {
  background: linear-gradient(135deg, rgba(244, 114, 182, 0.8), var(--danger));
  color: #fff;
  border: none;
}

/* 加载 & 空状态 */
.loading-state {
  text-align: center;
  padding: 150rpx 0;
}

.loading-spinner {
  font-size: 64rpx;
  display: block;
  margin-bottom: 20rpx;
  animation: spin 1.2s linear infinite;
}

.loading-text {
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 26rpx;
  display: block;
  margin-bottom: 32rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.btn-block {
  width: auto;
  display: inline-flex;
  margin: 0 auto;
  padding: 0 48rpx;
}
