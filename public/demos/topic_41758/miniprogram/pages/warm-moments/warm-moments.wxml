<!-- 暖心时刻 - AI 识别高能量温暖时刻 -->
<view class="container warm-moments-page">

  <!-- AI 总结区 -->
  <view wx:if="{{ !loading }}" class="ai-summary-section">
    <view class="ai-summary-card">
      <view class="ai-header">
        <text class="ai-icon">🤖</text>
        <text class="ai-label">AI 总结</text>
      </view>
      <text class="ai-summary-text">{{ aiSummary }}</text>

      <view class="ai-stats-row" wx:if="{{ stats.total_episodes > 0 }}">
        <view class="ai-stat">
          <text class="ai-stat-num">{{ stats.total_episodes }}</text>
          <text class="ai-stat-label">段时刻</text>
        </view>
        <view class="ai-stat-divider"></view>
        <view class="ai-stat">
          <text class="ai-stat-num">{{ stats.total_days }}</text>
          <text class="ai-stat-label">天累计</text>
        </view>
        <view class="ai-stat-divider"></view>
        <view class="ai-stat">
          <text class="ai-stat-num ai-stat-mood">{{ stats.best_mood }}</text>
          <text class="ai-stat-label">最佳情绪</text>
        </view>
      </view>
    </view>

    <view wx:if="{{ aiWarmMessage }}" class="ai-warm-card">
      <view class="warm-header">
        <text class="warm-icon">☀️</text>
        <text class="warm-label">温暖寄语</text>
      </view>
      <text class="warm-text">{{ aiWarmMessage }}</text>

      <view wx:if="{{ warmEvidence.length > 0 }}" class="evidence-list">
        <text class="evidence-title">📌 这些温暖来自你真实的记忆：</text>
        <view wx:for="{{ warmEvidence }}" wx:key="text" class="evidence-item">
          <text class="evidence-dot">•</text>
          <text class="evidence-text">{{ item.text }}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 标签切换 -->
  <view class="tab-row">
    <view class="tab-item {{ activeTab === 'year' ? 'tab-active' : '' }}" data-tab="year" bindtap="switchTab">
      今年暖心时刻
    </view>
    <view class="tab-item {{ activeTab === 'all' ? 'tab-active' : '' }}" data-tab="all" bindtap="switchTab">
      所有暖心时刻
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{ loading }}" class="loading-wrap text-center">
    <text class="text-muted">AI 正在寻找那些温暖的瞬间...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{ items.length === 0 }}" class="empty-wrap text-center">
    <text class="empty-emoji">☀️</text>
    <text class="empty-title">还没有暖心时刻</text>
    <text class="text-muted">去创造属于你的温暖吧</text>
  </view>

  <!-- 时刻列表 -->
  <block wx:else>
    <view class="episode-list">
      <view wx:for="{{ items }}" wx:key="id" class="episode-card {{ expandedId === item.id ? 'episode-expanded' : '' }}">
        <view class="episode-head" data-id="{{ item.id }}" bindtap="toggleExpand">
          <view class="episode-title-row">
            <text class="episode-title">{{ item.title }}</text>
            <text class="episode-period">{{ item.period }}</text>
          </view>
          <view class="episode-meta-row">
            <view class="mood-badge mood-{{ item.warmth_level }}">{{ item.mood_label }}</view>
            <text class="meta-item text-muted">持续 {{ item.duration_days }} 天</text>
            <text class="meta-item text-muted">情绪评分 {{ item.emotion_score }}</text>
          </view>
          <view class="episode-stats-row">
            <text class="ep-stat">📷 {{ item.photo_count }} 张</text>
            <text class="ep-stat">📝 {{ item.moment_count }} 条</text>
            <text class="ep-stat">💬 {{ item.chat_count }} 段</text>
            <text class="expand-arrow">{{ expandedId === item.id ? '收起 ▲' : '展开 ▼' }}</text>
          </view>
        </view>

        <view wx:if="{{ expandedId === item.id }}" class="episode-detail">
          <view class="detail-section">
            <text class="detail-label">🤖 AI 入选原因</text>
            <text class="detail-text">{{ item.ai_reason }}</text>
          </view>

          <view wx:if="{{ item.photos && item.photos.length > 0 }}" class="detail-section">
            <text class="detail-label">📷 照片</text>
            <view class="photo-grid">
              <image wx:for="{{ item.photos }}" wx:for-item="photo" wx:key="url" class="photo-item" src="{{ photo.url }}" mode="aspectFill" data-url="{{ photo.url }}" data-urls="{{ item.photo_urls }}" catchtap="previewPhoto" />
            </view>
            <view class="photo-captions">
              <text wx:for="{{ item.photos }}" wx:for-item="photo" wx:key="url" class="caption text-muted">{{ photo.caption }}</text>
            </view>
          </view>

          <view wx:if="{{ item.moments && item.moments.length > 0 }}" class="detail-section">
            <text class="detail-label">📝 朋友圈</text>
            <view class="moment-list">
              <view wx:for="{{ item.moments }}" wx:for-item="m" wx:key="text" class="moment-item">
                <text class="moment-text">{{ m.text }}</text>
                <view class="moment-meta flex-row">
                  <text class="text-muted" wx:if="{{ m.time }}">{{ m.time }}</text>
                  <text class="text-muted" wx:if="{{ m.location }}">📍 {{ m.location }}</text>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{ item.chats && item.chats.length > 0 }}" class="detail-section">
            <text class="detail-label">💬 聊天记录</text>
            <view class="chat-list">
              <view wx:for="{{ item.chats }}" wx:for-item="c" wx:key="name" class="chat-item">
                <text class="chat-name">{{ c.name }}</text>
                <text class="chat-excerpt text-muted">{{ c.excerpt }}</text>
                <text class="chat-count text-muted">{{ c.message_count }} 条消息</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-tip text-center text-muted">
      <text>—— AI 自动识别，情绪评分高于 0.7 才会入选 ——</text>
    </view>
  </block>
</view>
