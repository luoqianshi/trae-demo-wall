<view class="page">
  <view wx:if="{{loading}}" class="loading-text text-center text-muted">加载中...</view>

  <block wx:else>
    <!-- 顶部 AI 总结卡 -->
    <view class="ai-card">
      <view class="ai-head flex-row">
        <image class="chat-avatar" src="{{summary.avatar_url}}" mode="aspectFill" />
        <view class="ai-title flex-1">
          <text class="name">与 {{summary.conversation_name}}</text>
          <text class="period text-muted">{{summary.period_label}}</text>
        </view>
        <view class="msg-count">
          <text class="count-num">{{summary.message_count}}</text>
          <text class="text-muted text-xs">条消息</text>
        </view>
      </view>
      <text class="ai-caption">{{summary.ai_summary.caption}}</text>
      <view class="topic-row">
        <text wx:for="{{summary.ai_summary.topics}}" wx:for-item="topic" wx:key="*this" class="topic-tag">#{{topic}}</text>
      </view>
      <view class="action-row flex-row">
        <view class="action-btn" bindtap="askAI">🔮 查看 AI 摘要</view>
        <view class="action-btn action-primary" bindtap="goFullConversation">💬 查看完整会话 →</view>
      </view>
    </view>

    <!-- 这一时段的消息 -->
    <view class="section-title">这段时间的消息</view>

    <block wx:for="{{messages}}" wx:key="seq">
      <!-- 对方消息 -->
      <view wx:if="{{!item.is_me}}" class="msg-row flex-row">
        <image class="msg-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
        <view class="msg-bubble msg-bubble-other">
          <image wx:if="{{item.content_type === 'image'}}" class="msg-image" src="{{item.media_url}}" mode="widthFix" data-url="{{item.media_url}}" catchtap="previewImage" />
          <text wx:else class="msg-text">{{item.content}}</text>
          <text class="msg-time text-xs">{{item.timestamp_text}}</text>
        </view>
      </view>

      <!-- 我方消息 -->
      <view wx:else class="msg-row flex-row msg-row-me">
        <view class="msg-bubble msg-bubble-me">
          <image wx:if="{{item.content_type === 'image'}}" class="msg-image" src="{{item.media_url}}" mode="widthFix" data-url="{{item.media_url}}" catchtap="previewImage" />
          <text wx:else class="msg-text">{{item.content}}</text>
          <text class="msg-time text-xs">{{item.timestamp_text}}</text>
        </view>
        <image class="msg-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
      </view>
    </block>

    <view wx:if="{{messages.length === 0}}" class="empty-state text-muted text-center">这段时间没有消息记录</view>
  </block>
</view>
