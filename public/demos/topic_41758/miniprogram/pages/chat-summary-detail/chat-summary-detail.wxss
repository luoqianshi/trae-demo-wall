.page {
  padding: 20rpx 20rpx 60rpx;
  background: var(--bg);
  min-height: 100vh;
}

/* AI 总结卡 */
.ai-card {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.15), rgba(52, 211, 153, 0.1));
  border: 1px solid rgba(124, 92, 252, 0.3);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.ai-head {
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.chat-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg2);
}

.ai-title {
  display: flex;
  flex-direction: column;
  padding-left: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.period {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.msg-count {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 16rpx;
}

.count-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
}

.ai-caption {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
  display: block;
  margin-bottom: 16rpx;
}

.topic-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.topic-tag {
  background: rgba(255, 255, 255, 0.08);
  color: var(--accent);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.action-row {
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  background: var(--bg2);
  font-size: 26rpx;
  color: var(--ink);
}

.action-primary {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  font-weight: 600;
}

.section-title {
  font-size: 28rpx;
  color: var(--muted);
  padding: 12rpx 4rpx 16rpx;
}

/* 消息气泡 */
.msg-row {
  align-items: flex-start;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.msg-row-me {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg2);
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 520rpx;
  padding: 16rpx 22rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.msg-bubble-other {
  background: var(--bg2);
  color: var(--ink);
  border-top-left-radius: 8rpx;
}

.msg-bubble-me {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  border-top-right-radius: 8rpx;
}

.msg-text { display: block; }

.msg-image {
  max-width: 360rpx;
  max-height: 360rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.msg-time {
  display: block;
  font-size: 20rpx;
  margin-top: 8rpx;
  opacity: 0.7;
  color: var(--muted);
}

.msg-bubble-me .msg-time { color: rgba(255,255,255,0.75); }

.loading-text { padding: 80rpx 0; }
.empty-state { padding: 60rpx 0; font-size: 26rpx; }

.text-xs { font-size: 22rpx; }
