.on-this-day-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部日期区 */
.date-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.date-main {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), #ff6b9d, var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.date-weekday {
  font-size: 28rpx;
  margin-top: 8rpx;
}

.date-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 16rpx;
  opacity: 0.8;
}

/* 加载中 */
.loading-wrap {
  padding: 80rpx 0;
}

/* 年份区块 */
.year-section {
  margin-bottom: 32rpx;
}

/* 年份标签行 */
.year-label-row {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.year-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--accent), #9b7dff);
  min-width: 140rpx;
}

.year-badge-empty {
  background: var(--bg2);
  border: 1px solid var(--rule);
}

.years-ago {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
}

.year-badge-empty .years-ago {
  color: var(--muted);
}

.year-num {
  font-size: 32rpx;
  color: #fff;
  font-weight: 800;
}

.year-badge-empty .year-num {
  color: var(--muted);
}

.year-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, var(--accent), transparent);
  margin: 0 16rpx;
}

.year-line-empty {
  background: var(--rule);
}

.year-count {
  font-size: 24rpx;
  min-width: 120rpx;
  text-align: right;
}

/* 年份内容卡片 */
.year-content-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 24rpx;
  padding: 28rpx;
}

/* 空年份卡片 */
.empty-year-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: var(--bg2);
  border: 1px dashed var(--rule);
  border-radius: 20rpx;
  padding: 32rpx;
}

.empty-icon {
  font-size: 40rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
}

/* AI 总结 */
.ai-summary-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.15), rgba(240, 192, 96, 0.1));
  border: 1px solid rgba(124, 92, 252, 0.3);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.ai-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.ai-summary-text {
  font-size: 26rpx;
  color: #e0e0f0;
  line-height: 1.6;
  flex: 1;
}

/* 区块标题 */
.section-block {
  margin-bottom: 28rpx;
}

.section-block:last-child {
  margin-bottom: 0;
}

.block-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.block-icon {
  font-size: 28rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.block-count {
  font-size: 22rpx;
  margin-left: 8rpx;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.photo-item {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--bg3);
}

/* 朋友圈列表 */
.moment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.moment-item {
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
}

.moment-text {
  font-size: 26rpx;
  color: #e0e0f0;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.moment-photos {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.moment-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  background: var(--bg2);
}

.moment-footer {
  margin-top: 12rpx;
  gap: 16rpx;
}

.moment-location {
  font-size: 22rpx;
  flex: 1;
}

.moment-mood {
  font-size: 22rpx;
  color: var(--accent2);
  background: rgba(240, 192, 96, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

/* 聊天列表 */
.chat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chat-item {
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
}

.chat-head {
  gap: 16rpx;
  align-items: center;
}

.chat-avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg2);
}

.chat-info-sm {
  display: flex;
  flex-direction: column;
}

.chat-name-sm {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.chat-msg-count {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.chat-excerpts {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--rule);
}

.excerpt-line {
  font-size: 24rpx;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.excerpt-sender {
  color: var(--accent);
  font-weight: 600;
}

.excerpt-sender.excerpt-me {
  color: var(--accent3);
}

.excerpt-content {
  font-size: 24rpx;
}

/* 底部 */
.end-of-timeline {
  padding: 40rpx 0;
  font-size: 24rpx;
  opacity: 0.6;
}
