<!-- N年今日 - 详情页 -->
<view class="container on-this-day-page">

  <!-- 顶部日期区 -->
  <view class="date-header">
    <text class="date-main">{{ dateText }}</text>
    <text class="date-weekday text-muted">{{ weekdayText }}</text>
    <text class="date-desc">时间的回响，每一年的今天都值得回望</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{ loading }}" class="loading-wrap text-center">
    <text class="text-muted">正在回溯时光...</text>
  </view>

  <!-- 年份列表 -->
  <block wx:else>
    <view wx:for="{{ years }}" wx:key="years_ago" class="year-section">
      <!-- 年份标签 -->
      <view class="year-label-row">
        <view class="year-badge {{ item.has_content ? 'year-badge-active' : 'year-badge-empty' }}">
          <text class="years-ago">{{ item.years_ago }}年前</text>
          <text class="year-num">{{ item.year }}</text>
        </view>
        <view class="year-line {{ item.has_content ? '' : 'year-line-empty' }}"></view>
        <text class="year-count text-muted">
          <text wx:if="{{ item.has_content }}">{{ item.total_count }} 条记忆</text>
          <text wx:else>暂无记录</text>
        </text>
      </view>

      <!-- 有内容 -->
      <block wx:if="{{ item.has_content }}">
        <view class="year-content-card">
          <!-- AI 总结 -->
          <view class="ai-summary-box" wx:if="{{ item.ai_summary }}">
            <text class="ai-icon">✨</text>
            <text class="ai-summary-text">{{ item.ai_summary }}</text>
          </view>

          <!-- 照片 -->
          <view wx:if="{{ item.photos.length > 0 }}" class="section-block">
            <view class="block-title-row">
              <text class="block-icon">📷</text>
              <text class="block-title">照片</text>
              <text class="block-count text-muted">{{ item.photo_count }} 张</text>
            </view>
            <view class="photo-grid">
              <image
                wx:for="{{ item.photos }}"
                wx:for-item="photo"
                wx:key="id"
                class="photo-item"
                src="{{ photo.url }}"
                mode="aspectFill"
                data-url="{{ photo.url }}"
                data-urls="{{ item.photo_urls }}"
                catchtap="previewPhoto"
              />
            </view>
          </view>

          <!-- 朋友圈 -->
          <view wx:if="{{ item.moments.length > 0 }}" class="section-block">
            <view class="block-title-row">
              <text class="block-icon">📝</text>
              <text class="block-title">朋友圈</text>
              <text class="block-count text-muted">{{ item.moment_count }} 条</text>
            </view>
            <view class="moment-list">
              <view
                wx:for="{{ item.moments }}"
                wx:for-item="moment"
                wx:key="id"
                class="moment-item card"
                data-data="{{ moment }}"
                bindtap="tapMoment"
              >
                <text class="moment-text" wx:if="{{ moment.content.text }}">{{ moment.content.text }}</text>
                <view class="moment-photos" wx:if="{{ moment.content.media && moment.content.media.length }}">
                  <image
                    wx:for="{{ moment.content.media }}"
                    wx:for-item="m"
                    wx:key="*this"
                    class="moment-photo"
                    src="{{ m }}"
                    mode="aspectFill"
                    data-url="{{ m }}"
                    data-urls="{{ moment.content.media }}"
                    catchtap="previewPhoto"
                  />
                </view>
                <view class="moment-footer flex-row">
                  <text class="moment-location text-muted" wx:if="{{ moment.location_name }}">📍 {{ moment.location_name }}</text>
                  <text class="moment-mood" wx:if="{{ moment.ai && moment.ai.mood }}">{{ moment.ai.mood }}</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 聊天记录 -->
          <view wx:if="{{ item.chats.length > 0 }}" class="section-block">
            <view class="block-title-row">
              <text class="block-icon">💬</text>
              <text class="block-title">聊天</text>
              <text class="block-count text-muted">{{ item.chat_count }} 段对话</text>
            </view>
            <view class="chat-list">
              <view
                wx:for="{{ item.chats }}"
                wx:for-item="chat"
                wx:key="conversation_id"
                class="chat-item card"
                data-id="{{ chat.conversation_id }}"
                bindtap="tapChat"
              >
                <view class="chat-head flex-row">
                  <image class="chat-avatar-sm" src="{{ chat.avatar_url }}" mode="aspectFill" />
                  <view class="chat-info-sm flex-1">
                    <text class="chat-name-sm">与 {{ chat.conversation_name }}</text>
                    <text class="chat-msg-count text-muted">{{ chat.message_count }} 条消息</text>
                  </view>
                </view>
                <view class="chat-excerpts">
                  <view wx:for="{{ chat.excerpts }}" wx:for-item="excerpt" wx:key="content" class="excerpt-line">
                    <text class="excerpt-sender {{ excerpt.is_me ? 'excerpt-me' : '' }}">
                      {{ excerpt.is_me ? '我' : excerpt.sender }}：
                    </text>
                    <text class="excerpt-content text-muted">{{ excerpt.content }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 无内容 -->
      <block wx:else>
        <view class="empty-year-card">
          <text class="empty-icon">🕐</text>
          <text class="empty-text text-muted">这一年的今天没有留下记忆</text>
        </view>
      </block>
    </view>

    <!-- 到底了 -->
    <view class="end-of-timeline text-center text-muted">
      <text>—— 时光的尽头 ——</text>
    </view>
  </block>
</view>
