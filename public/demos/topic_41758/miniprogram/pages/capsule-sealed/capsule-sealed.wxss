/* ========== 封存列表页（Dark） ========== */

.sealed-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 120rpx;
  background: var(--bg);
}

.page-header {
  text-align: center;
  padding: 20rpx 0 60rpx;
}

.page-title-gradient {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 24rpx;
}

/* 封存列表 */
.sealed-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sealed-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
}

.sealed-item:active {
  background: var(--bg3);
}

.sealed-item-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.sealed-item-icon {
  font-size: 36rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg3);
  border: 1px solid var(--rule);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sealed-item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.sealed-item-date {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 6rpx;
}

.sealed-item-hint {
  font-size: 22rpx;
  display: block;
}

.sealed-item-arrow {
  font-size: 36rpx;
  color: var(--muted);
  margin-left: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 26rpx;
  display: block;
}
