<!-- 封存中漂流瓶列表（仅显示创建时间，内容脱敏 -->
<view class="container sealed-page">
  <view class="page-header">
    <text class="page-title-gradient">封存中</text>
    <text class="page-subtitle text-muted">共 {{ sealedList.length }} 个 · 内容均已脱敏</text>
  </view>

  <block wx:if="{{ sealedList.length === 0 }}">
    <view class="empty-state">
      <text class="empty-icon">🔒</text>
      <text class="empty-text text-muted">当前没有封存中的漂流瓶</text>
    </view>
  </block>

  <block wx:else>
    <view class="sealed-list">
      <block wx:for="{{ sealedList }}" wx:key="id">
        <view class="sealed-item" data-id="{{ item.id }}" bindtap="onSealedItemTap">
          <view class="sealed-item-left">
            <text class="sealed-item-icon">🔒</text>
            <view class="sealed-item-info">
              <text class="sealed-item-date">{{ item.sealedAtText }}</text>
              <text class="sealed-item-hint text-muted">封存时间</text>
            </view>
          </view>
          <text class="sealed-item-arrow">›</text>
        </view>
      </block>
    </view>
  </block>
</view>
