.dark-moments-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ============== AI 总结区 ============== */
.ai-summary-section {
  margin-bottom: 24rpx;
}

.ai-summary-card {
  background: linear-gradient(160deg, rgba(124, 92, 252, 0.2), rgba(30, 30, 60, 0.6));
  border: 1px solid rgba(124, 92, 252, 0.35);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.ai-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.ai-icon {
  font-size: 32rpx;
}

.ai-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #c4b5fd;
}

.ai-summary-text {
  font-size: 28rpx;
  color: #e8e8f8;
  line-height: 1.7;
  display: block;
}

/* AI 统计行 */
.ai-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(10, 10, 26, 0.5);
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-top: 20rpx;
}

.ai-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.ai-stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

.ai-stat-mood {
  font-size: 26rpx;
  color: #f472b6;
}

.ai-stat-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.ai-stat-divider {
  width: 1px;
  height: 48rpx;
  background: var(--rule);
}

/* AI 鼓励卡片 */
.ai-encourage-card {
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.12), rgba(56, 189, 248, 0.1));
  border: 1px solid rgba(52, 211, 153, 0.3);
  border-radius: 20rpx;
  padding: 24rpx;
}

.encourage-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.encourage-icon {
  font-size: 28rpx;
}

.encourage-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--success);
}

.encourage-text {
  font-size: 26rpx;
  color: #d8f5e5;
  line-height: 1.8;
  white-space: pre-line;
  display: block;
}

/* 积极证据 */
.evidence-list {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px dashed rgba(52, 211, 153, 0.25);
}

.evidence-title {
  font-size: 22rpx;
  color: var(--success);
  display: block;
  margin-bottom: 10rpx;
}

.evidence-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.evidence-dot {
  font-size: 20rpx;
  color: var(--success);
  flex-shrink: 0;
  line-height: 1.6;
}

.evidence-text {
  font-size: 22rpx;
  color: #b8e8d0;
  line-height: 1.6;
  flex: 1;
}

/* ============== 标签切换 ============== */
.tab-row {
  display: flex;
  background: var(--bg2);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  border: 1px solid var(--rule);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-active {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}

/* ============== 加载 & 空态 ============== */
.loading-wrap, .empty-wrap {
  padding: 80rpx 0;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

/* ============== 时刻卡片 ============== */
.episode-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.episode-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.episode-expanded {
  border-color: rgba(124, 92, 252, 0.4);
}

/* 卡片头部 */
.episode-head {
  padding: 24rpx;
}

.episode-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.episode-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.episode-period {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.episode-meta-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.mood-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.mood-high {
  color: #f472b6;
  background: rgba(244, 114, 182, 0.15);
}

.mood-medium {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.15);
}

.mood-low {
  color: #60a5fa;
  background: rgba(96, 165, 250, 0.15);
}

.meta-item {
  font-size: 22rpx;
}

.episode-stats-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ep-stat {
  font-size: 22rpx;
  color: var(--muted);
}

.expand-arrow {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--accent);
}

/* ============== 展开详情 ============== */
.episode-detail {
  padding: 0 24rpx 24rpx;
  border-top: 1px solid var(--rule);
  padding-top: 20rpx;
}

.detail-section {
  margin-bottom: 20rpx;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #c4b5fd;
  display: block;
  margin-bottom: 12rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #c8c8e0;
  line-height: 1.7;
  background: rgba(10, 10, 26, 0.4);
  border-radius: 12rpx;
  padding: 16rpx;
  display: block;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.photo-item {
  width: 100%;
  height: 140rpx;
  border-radius: 10rpx;
  background: var(--bg3);
}

.photo-captions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.caption {
  font-size: 20rpx;
  flex: 1;
  min-width: 45%;
}

/* 朋友圈列表 */
.moment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.moment-item {
  background: rgba(10, 10, 26, 0.4);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  border-left: 3rpx solid var(--accent);
}

.moment-text {
  font-size: 24rpx;
  color: #d0d0e8;
  line-height: 1.6;
  display: block;
}

.moment-meta {
  margin-top: 8rpx;
  gap: 16rpx;
}

.moment-meta text {
  font-size: 20rpx;
}

/* 聊天列表 */
.chat-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.chat-item {
  background: rgba(10, 10, 26, 0.4);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}

.chat-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 4rpx;
}

.chat-excerpt {
  font-size: 22rpx;
  line-height: 1.5;
  display: block;
  margin-bottom: 4rpx;
}

.chat-count {
  font-size: 20rpx;
}

/* 底部提示 */
.bottom-tip {
  padding: 32rpx 0 16rpx;
  font-size: 20rpx;
  opacity: 0.5;
}
