.memories-page {
  padding: 0 20rpx 60rpx;
  background: var(--bg);
  min-height: 100vh;
}

/* 顶部吸顶搜索条 */
.header-sticky {
  position: sticky;
  top: 0;
  background: linear-gradient(to bottom, var(--bg), rgba(10, 10, 26, 0.96));
  padding: 20rpx 0 16rpx;
  z-index: 10;
}

.search-row {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  color: var(--muted);
}

.search-input {
  color: var(--ink);
  font-size: 28rpx;
  background: transparent;
}

.clear-btn {
  color: var(--muted);
  font-size: 28rpx;
  padding: 0 8rpx;
}

/* 过滤 chip */
.filter-scroll {
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--bg2);
  border: 1px solid var(--rule);
}

.filter-chip-active {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  border-color: transparent;
  font-weight: 600;
}

.total-bar {
  font-size: 24rpx;
  padding: 16rpx 8rpx 8rpx;
}

/* 卡列表 */
.card-list {
  margin-top: 8rpx;
}

.card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card:active {
  background: var(--bg3);
}

/* 卡头 */
.card-head {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-icon {
  font-size: 24rpx;
}

.type-text {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.period-label {
  font-size: 24rpx;
  color: var(--muted);
}

/* AI 文案 */
.ai-caption {
  font-size: 30rpx;
  line-height: 1.65;
  color: var(--ink);
  display: block;
  margin-bottom: 16rpx;
}

/* ----------- 照片组卡 ----------- */
.photo-group-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 6rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.pg-left {
  display: flex;
}

.pg-img-big {
  width: 100%;
  height: 320rpx;
  background: var(--bg3);
  border-radius: 12rpx 0 0 12rpx;
}

.pg-right {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pg-img-small {
  width: 100%;
  height: 156rpx;
  background: var(--bg3);
  border-radius: 0 12rpx 0 0;
}

.pg-small-row {
  display: flex;
  gap: 6rpx;
  flex: 1;
  position: relative;
}

.pg-small-row .pg-img-small {
  border-radius: 0 0 12rpx 0;
  flex: 1;
}

.pg-more {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

/* ----------- 聊天总结卡 ----------- */
.chat-summary-card {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.1), rgba(52, 211, 153, 0.05));
  border-color: rgba(124, 92, 252, 0.25);
}

.chat-head {
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.chat-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg3);
}

.chat-info {
  min-width: 0;
}

.chat-top {
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.chat-count {
  margin-top: 4rpx;
  display: block;
}

.chat-topics {
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.topic-chip {
  background: rgba(124, 92, 252, 0.18);
  color: var(--accent);
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
}

/* ----------- 朋友圈卡 ----------- */
.moment-main-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
  display: block;
  margin-bottom: 16rpx;
}

.moment-photo-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.moment-photo {
  width: 100%;
  height: 180rpx;
  background: var(--bg3);
  border-radius: 6rpx;
}

.moment-photo-single {
  grid-column: span 3;
  height: 360rpx;
  width: 100%;
}

/* ----------- 卡 footer ----------- */
.card-footer {
  padding-top: 12rpx;
  border-top: 1px dashed var(--rule);
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta {
  font-size: 22rpx;
  color: var(--ink);
}

.meta-count {
  color: var(--accent);
  font-weight: 600;
}

.meta-enter {
  margin-left: auto;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.meta-highlight {
  color: var(--accent);
  font-weight: 600;
  font-size: 24rpx;
}

.mood-chip {
  background: rgba(240, 192, 96, 0.2);
  color: var(--accent2);
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  margin-left: auto;
}

/* 更多朋友圈入口 */
.more-moments {
  background: var(--bg2);
  border: 1px dashed var(--accent);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.more-moments text:first-child {
  font-size: 26rpx;
  color: var(--muted);
}

.more-link {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 空态 / 加载 */
.loading-text {
  padding: 100rpx 0;
}

.empty-state {
  padding: 80rpx 0 120rpx;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 12rpx;
}

/* 通用工具 */
.text-xs { font-size: 22rpx; }
.flex-row { display: flex; flex-direction: row; }
.flex-1 { flex: 1; }
.text-center { text-align: center; }
