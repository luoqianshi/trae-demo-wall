<view class="container memories-page">
  <!-- 顶部搜索 + 过滤 -->
  <view class="header-sticky">
    <view class="search-row flex-row">
      <text class="search-icon">🔍</text>
      <input
        class="search-input flex-1"
        placeholder="搜索记忆（地点、关键词）"
        confirm-type="search"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onKeywordConfirm"
      />
      <text wx:if="{{keyword}}" class="clear-btn" bindtap="clearKeyword">✕</text>
    </view>
    <scroll-view scroll-x="true" class="filter-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="filter-row">
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="filter-chip {{activeFilter === item.key ? 'filter-chip-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchFilter"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="loading-text text-center text-muted">加载中...</view>

  <!-- 记忆卡列表 -->
  <block wx:else>
    <view wx:if="{{total > 0}}" class="total-bar text-muted">
      共 {{total}} 条记忆记录
    </view>

    <view class="card-list">
      <block wx:for="{{items}}" wx:key="_id">
        <!-- 1. 照片组卡 -->
        <view wx:if="{{item.type === 'photo_group'}}" class="card photo-group-card" data-id="{{item.data.id}}" bindtap="tapPhotoGroup">
          <view class="card-head flex-row">
            <view class="card-type">
              <text class="type-icon">📷</text>
              <text class="type-text">照片组</text>
            </view>
            <text class="period-label">{{item.data.period_label}}</text>
          </view>

          <text class="ai-caption">{{item.data.ai_summary.caption}}</text>

          <view class="photo-group-grid">
            <view class="pg-left">
              <image wx:if="{{item.data.cover_urls[0]}}" class="pg-img-big" src="{{item.data.cover_urls[0]}}" mode="aspectFill" data-url="{{item.data.cover_urls[0]}}" data-urls="{{item.data.cover_urls}}" catchtap="previewPhoto" />
            </view>
            <view class="pg-right">
              <image wx:if="{{item.data.cover_urls[1]}}" class="pg-img-small" src="{{item.data.cover_urls[1]}}" mode="aspectFill" data-url="{{item.data.cover_urls[1]}}" data-urls="{{item.data.cover_urls}}" catchtap="previewPhoto" />
              <view class="pg-small-row">
                <image wx:if="{{item.data.cover_urls[2]}}" class="pg-img-small" src="{{item.data.cover_urls[2]}}" mode="aspectFill" data-url="{{item.data.cover_urls[2]}}" data-urls="{{item.data.cover_urls}}" catchtap="previewPhoto" />
                <view wx:if="{{item.data.photo_count > 3}}" class="pg-more">
                  <text class="pg-more-text">+{{item.data.photo_count - 3}}</text>
                </view>
              </view>
            </view>
          </view>

          <view class="card-footer flex-row">
            <text class="meta" wx:if="{{item.data.location_name}}">📍 {{item.data.location_name}}</text>
            <text class="meta meta-count">📷 {{item.data.photo_count}} 张</text>
            <text class="meta meta-enter">查看全部 →</text>
          </view>
        </view>

        <!-- 2. 聊天总结卡 -->
        <view wx:elif="{{item.type === 'chat_summary'}}" class="card chat-summary-card" data-id="{{item.data.id}}" bindtap="tapChatSummary">
          <view class="chat-head flex-row">
            <image class="chat-avatar" src="{{item.data.avatar_url}}" mode="aspectFill" />
            <view class="chat-info flex-1">
              <view class="chat-top flex-row">
                <text class="chat-name">与 {{item.data.conversation_name}}</text>
                <text class="text-muted text-xs">{{item.data.period_label}}</text>
              </view>
              <text class="chat-count text-muted text-xs">{{item.data.message_count}} 条消息</text>
            </view>
          </view>

          <text class="ai-caption">{{item.data.ai_summary.caption}}</text>

          <view class="chat-topics flex-row flex-wrap">
            <text wx:for="{{item.data.ai_summary.topics}}" wx:for-item="topic" wx:key="*this" class="topic-chip">#{{topic}}</text>
          </view>

          <view class="card-footer flex-row">
            <text class="meta meta-highlight">🔮 点击查看这段时间的对话</text>
          </view>
        </view>

        <!-- 3. 朋友圈单条卡 -->
        <view wx:elif="{{item.type === 'moment'}}" class="card moment-card" data-data="{{item.data}}" bindtap="tapMoment">
          <view class="card-head flex-row">
            <view class="card-type">
              <text class="type-icon">📝</text>
              <text class="type-text">朋友圈</text>
            </view>
            <text class="period-label">{{item.data.occurred_at_text}}</text>
          </view>

          <text class="moment-main-text" wx:if="{{item.data.content.text}}">{{item.data.content.text}}</text>

          <view class="moment-photo-row" wx:if="{{item.data.content.media && item.data.content.media.length}}">
            <block wx:for="{{item.data.content.media}}" wx:for-item="m" wx:for-index="idx" wx:key="*this">
              <image
                class="moment-photo {{item.data.content.media.length === 1 ? 'moment-photo-single' : ''}}"
                src="{{m}}"
                mode="aspectFill"
                data-url="{{m}}"
                data-urls="{{item.data.content.media}}"
                catchtap="previewPhoto"
              />
            </block>
          </view>

          <view class="card-footer flex-row">
            <text class="meta text-muted" wx:if="{{item.data.location_name}}">📍 {{item.data.location_name}}</text>
            <text class="meta text-muted">👍 {{item.data.metadata.likes_count || 0}}</text>
            <text class="meta text-muted">💬 {{item.data.metadata.comments_count || 0}}</text>
            <text wx:if="{{item.data.ai && item.data.ai.mood}}" class="mood-chip">{{item.data.ai.mood}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 查看全部朋友圈 -->
    <view wx:if="{{show_moments_more && (activeFilter === '' || activeFilter === 'moment')}}" class="more-moments" bindtap="goAllMoments">
      <text>时间线只展示了前 {{moments_on_timeline}} 条</text>
      <text class="more-link">查看全部 {{total_moments}} 条朋友圈 →</text>
    </view>

    <!-- 空态 -->
    <view wx:if="{{items.length === 0 && !loading}}" class="empty-state text-center">
      <text class="empty-emoji">🗂️</text>
      <text class="text-muted">暂无匹配的记忆</text>
    </view>
  </block>
</view>
