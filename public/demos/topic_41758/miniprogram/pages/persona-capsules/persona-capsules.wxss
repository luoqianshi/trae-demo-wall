/* ===== 与未来的我对话 — 快捷入口 ===== */
.future-me-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.2), rgba(240, 192, 96, 0.1));
  border: 1px solid rgba(124, 92, 252, 0.35);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 32rpx;
}

.future-me-card:active {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.3), rgba(240, 192, 96, 0.15));
  transform: scale(0.98);
}

.future-me-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.future-me-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.future-me-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.future-me-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 6rpx;
}

.future-me-desc {
  font-size: 24rpx;
  color: var(--muted);
  display: block;
  margin-bottom: 10rpx;
}

.future-me-sources {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.source-tag {
  font-size: 20rpx;
  color: var(--accent);
  background: rgba(124, 92, 252, 0.12);
  border: 1px solid rgba(124, 92, 252, 0.25);
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
}

.future-me-arrow {
  font-size: 40rpx;
  color: var(--accent);
  margin-left: 16rpx;
}

/* ===== 区块标题 ===== */
.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ===== 页面标题 ===== */
.page-title {
  font-size: 48rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ===== 统计栏 ===== */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1px;
  height: 48rpx;
  background: var(--rule);
}

/* ===== 胶囊卡片 ===== */
.capsule-list {
  padding-bottom: 120rpx;
}

.capsule-card {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  transition: transform 0.2s;
}

.capsule-card:active {
  transform: scale(0.98);
  border-color: var(--accent);
}

.capsule-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.capsule-info {
  min-width: 0;
}

.capsule-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.capsule-date {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.capsule-desc {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== 标签 ===== */
.capsule-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: var(--bg3);
  color: var(--muted);
  border: 1px solid var(--rule);
}

/* ===== 记忆数 & 对话按钮 ===== */
.memory-count {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.chat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.chat-btn:active {
  opacity: 0.8;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.6;
}

/* ===== 浮动按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(124, 92, 252, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* ===== 加载占位 ===== */
.loading-wrap {
  padding-bottom: 120rpx;
}
