<view class="container">
  <!-- 页面标题 -->
  <view class="page-title">记忆胶囊</view>

  <!-- 统计卡片 -->
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-num">{{ totalCount }}</text>
      <text class="stat-label">全部胶囊</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{ myCount }}</text>
      <text class="stat-label">关于我</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{ othersCount }}</text>
      <text class="stat-label">关于他人</text>
    </view>
  </view>

  <!-- 与未来的我对话 — 快捷入口 -->
  <view class="future-me-card" bindtap="onFutureMeTap">
    <view class="future-me-left">
      <view class="future-me-avatar">🚀</view>
      <view class="future-me-info">
        <text class="future-me-title">与未来的我对话</text>
        <text class="future-me-desc">基于今年的朋友圈、聊天、相册生成 AI 人设</text>
        <view class="future-me-sources">
          <text class="source-tag">📝 朋友圈</text>
          <text class="source-tag">💬 聊天</text>
          <text class="source-tag">📷 相册</text>
        </view>
      </view>
    </view>
    <text class="future-me-arrow">›</text>
  </view>

  <!-- 加载中 -->
  <block wx:if="{{ loading }}">
    <view class="loading-wrap">
      <view class="skeleton card" style="height: 180rpx; margin-bottom: 24rpx;"></view>
      <view class="skeleton card" style="height: 180rpx; margin-bottom: 24rpx;"></view>
      <view class="skeleton card" style="height: 180rpx; margin-bottom: 24rpx;"></view>
    </view>
  </block>

  <!-- 空状态 -->
  <block wx:elif="{{ capsules.length === 0 }}">
    <view class="empty-state">
      <view class="empty-icon">🫙</view>
      <view class="empty-title">还没有记忆胶囊</view>
      <view class="empty-desc">创建一个记忆胶囊，把珍贵的回忆封存起来</view>
      <view class="btn btn-primary mt-32" bindtap="onCreateTap">创建第一个胶囊</view>
    </view>
  </block>

  <!-- 胶囊列表 -->
  <block wx:else>
    <view class="section-header">
      <text class="section-title">我的胶囊</text>
    </view>
    <view class="capsule-list">
      <view
        class="capsule-card"
        wx:for="{{ capsules }}"
        wx:key="id"
        data-id="{{ item.id }}"
        bindtap="onCapsuleTap"
      >
        <view class="flex-row">
          <!-- 头像 -->
          <view class="capsule-avatar">{{ item.avatar }}</view>

          <!-- 信息区 -->
          <view class="flex-1 capsule-info">
            <view class="flex-between">
              <text class="capsule-name">{{ item.name }}</text>
              <text class="capsule-date">{{ item.createdAt }}</text>
            </view>
            <view class="capsule-desc">{{ item.description }}</view>

            <!-- 标签 -->
            <view class="capsule-tags">
              <view class="tag" wx:for="{{ item.tags }}" wx:for-item="tag" wx:key="label">
                <text>{{ tag.icon }}</text>
                <text>{{ tag.label }}</text>
              </view>
            </view>

            <!-- 底部信息 -->
            <view class="flex-between mt-16">
              <text class="memory-count">{{ item.memoryCount }} 条记忆</text>
              <view
                class="chat-btn"
                data-id="{{ item.id }}"
                catchtap="onChatTap"
              >
                <text>对话</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 浮动创建按钮 -->
  <block wx:if="{{ !loading }}">
    <view class="fab" bindtap="onCreateTap">
      <text class="fab-icon">+</text>
    </view>
  </block>
</view>
