<!-- 漂流瓶创建页 -->
<view class="container create-page">

  <!-- 顶部标题 -->
  <view class="page-header">
    <text class="page-title-gradient">封存一段时光</text>
    <text class="page-subtitle text-muted">写一封信，交给未来的时间</text>
  </view>

  <!-- 类型选择 -->
  <view class="form-card card">
    <text class="form-label">漂流瓶类型</text>
    <view class="type-options">
      <view class="type-option {{ bottleType === 'self' ? 'type-option-active' : ''}}" data-type="self" bindtap="switchType">
        <text class="type-emoji">⏰</text>
        <view class="type-info">
          <text class="type-name">给自己</text>
          <text class="type-desc text-muted">指定时间后开启</text>
        </view>
      </view>
      <view class="type-option {{ bottleType === 'location' ? 'type-option-active' : ''}}" data-type="location" bindtap="switchType">
        <text class="type-emoji">📍</text>
        <view class="type-info">
          <text class="type-name">给地点</text>
          <text class="type-desc text-muted">投放位置供他人获取</text>
        </view>
      </view>
      <view class="type-option {{ bottleType === 'user' ? 'type-option-active' : ''}}" data-type="user" bindtap="switchType">
        <text class="type-emoji">💌</text>
        <view class="type-info">
          <text class="type-name">给指定用户</text>
          <text class="type-desc text-muted">在指定时间送达</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 标题 -->
  <view class="form-card card">
    <text class="form-label">漂流瓶标题</text>
    <input class="form-input" placeholder="给这个漂流瓶起个名字" value="{{ title }}" bindinput="onTitleInput" maxlength="40" />
  </view>

  <!-- 位置选择 -->
  <view class="form-card card" wx:if="{{ bottleType === 'location' || bottleType === 'self' }}">
    <text class="form-label" wx:if="{{ bottleType === 'location' }}">投放位置</text>
    <text class="form-label" wx:else>可选 · 选择位置</text>
    <view class="picker-row" bindtap="chooseLocation">
      <text class="picker-icon">📍</text>
      <text class="picker-text" wx:if="{{ location_name }}">{{ location_name }}</text>
      <text class="picker-text text-muted" wx:else>点击选择位置</text>
      <text class="picker-arrow">›</text>
    </view>
    <view class="radius-row" wx:if="{{ location_name }}">
      <slider class="radius-slider" min="50" max="2000" step="50" value="{{ geo_radius }}" bindchange="onRadiusChange" activeColor="#7c5cfc" backgroundColor="#2a2a50" block-color="#7c5cfc"></slider>
      <text class="form-sub text-muted">附近范围：{{ geo_radius }} 米</text>
    </view>
  </view>

  <!-- 触发关键词（self 专属） -->
  <view class="form-card card" wx:if="{{ bottleType === 'self' }}">
    <text class="form-label">可选 · 触发关键词</text>
    <input class="form-input" placeholder="用空格分隔，如：梦想 坚持" value="{{ keywords_input }}" bindinput="onKeywordsInput" maxlength="100" />
    <view class="keyword-tags" wx:if="{{ trigger_keywords.length > 0 }}">
      <block wx:for="{{ trigger_keywords }}" wx:key="*this">
        <view class="keyword-tag"><text>{{ item }}</text></view>
      </block>
    </view>
  </view>

  <!-- 指定用户 -->
  <view class="form-card card" wx:if="{{ bottleType === 'user' }}">
    <text class="form-label">指定用户</text>
    <view class="picker-row" bindtap="chooseUser">
      <text class="picker-icon">💌</text>
      <text class="picker-text" wx:if="{{ target_user_name }}">{{ target_user_name }}</text>
      <text class="picker-text text-muted" wx:else>点击选择用户</text>
      <text class="picker-arrow">›</text>
    </view>
  </view>

  <!-- 开启时间 -->
  <view class="form-card card">
    <text class="form-label">{{ bottleType === 'self' ? '开启时间' : (bottleType === 'location' ? '可获取时间' : '送达时间') }}</text>
    <view class="picker-row" bindtap="chooseDate">
      <text class="picker-icon">📅</text>
      <text class="picker-text" wx:if="{{ unlock_date_display }}">{{ unlock_date_display }}</text>
      <text class="picker-text text-muted" wx:else>点击选择日期</text>
      <text class="picker-arrow">›</text>
    </view>
  </view>

  <!-- 正文 -->
  <view class="form-card card">
    <text class="form-label">文字内容</text>
    <textarea class="form-textarea" placeholder="此刻你想说的话..." value="{{ content }}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
  </view>

  <!-- 图片 -->
  <view class="form-card card">
    <text class="form-label">图片 ({{ photosCount }})</text>
    <view class="photo-grid">
      <block wx:for="{{ photos }}" wx:key="id">
        <view class="photo-item">
          <image class="photo-img" src="{{ item.url }}" mode="aspectFill" data-index="{{ index }}" bindtap="previewPhoto"/>
          <view class="photo-remove" data-index="{{ index }}" bindtap="removePhoto">✕</view>
        </view>
      </block>
      <view class="photo-item photo-add" bindtap="addPhoto" wx:if="{{ photos.length < 9 }}">
        <text class="photo-add-icon">＋</text>
        <text class="photo-add-text text-muted">添加</text>
      </view>
    </view>
  </view>

  <!-- 视频 -->
  <view class="form-card card">
    <text class="form-label">视频 ({{ videosCount }})</text>
    <view class="video-list" wx:if="{{ videos.length > 0 }}">
      <block wx:for="{{ videos }}" wx:key="id">
        <view class="video-item">
          <text class="video-icon">🎬</text>
          <text class="video-name">视频 {{ index + 1 }}</text>
          <view class="video-remove" data-index="{{ index }}" bindtap="removeVideo">✕</view>
        </view>
      </block>
    </view>
    <view class="btn btn-secondary btn-add-video" bindtap="addVideo" wx:if="{{ videos.length < 3 }}">
      <text>＋ 添加视频</text>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-row">
    <button class="btn btn-primary btn-submit" bindtap="submit" disabled="{{ submitting }}">
      <text wx:if="{{ submitting }}">封存中...</text>
      <text wx:else>🍾 封存漂流瓶</text>
    </button>
  </view>

</view>
