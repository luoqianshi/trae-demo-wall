/* ========== 时光漂流瓶 · 创建页（Dark） ========== */

.create-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 120rpx;
  background: var(--bg);
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 20rpx 0 40rpx;
}
.page-title-gradient {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.page-subtitle {
  font-size: 24rpx;
}

/* ========== 表单卡片 ========== */
.form-card {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 18rpx;
}
.form-sub {
  font-size: 22rpx;
  display: block;
  margin-top: 8rpx;
  text-align: center;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
  line-height: 88rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  box-sizing: border-box;
}

/* ========== 类型选择 ========== */
.type-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.type-option {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: var(--bg3);
  border-radius: 20rpx;
  border: 1px solid var(--rule);
  transition: all 0.2s;
}
.type-option-active {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.25), rgba(124, 92, 252, 0.1));
  border-color: var(--accent);
  box-shadow: 0 4rpx 20rpx rgba(124, 92, 252, 0.2);
}
.type-emoji {
  font-size: 36rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg2);
  border: 1px solid var(--rule);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.type-option-active .type-emoji {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  border-color: transparent;
}
.type-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 4rpx;
}
.type-desc {
  font-size: 22rpx;
  display: block;
}

/* ========== 选择器（Picker） ========== */
.picker-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 40rpx;
}
.picker-row:active {
  background: rgba(124, 92, 252, 0.1);
}
.picker-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}
.picker-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.picker-arrow {
  font-size: 32rpx;
  color: var(--accent);
}
.radius-row {
  margin-top: 20rpx;
}
.radius-slider {
  margin: 0 10rpx;
}

/* ========== 关键词标签 ========== */
.keyword-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}
.keyword-tag {
  padding: 10rpx 22rpx;
  background: rgba(124, 92, 252, 0.15);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--accent);
  border: 1px solid rgba(124, 92, 252, 0.3);
}

/* ========== 图片网格 ========== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0;
}
.photo-item {
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: var(--bg3);
  border: 1px solid var(--rule);
}
.photo-item .photo-img {
  width: 100%;
  height: 100%;
}
.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(10, 10, 26, 0.8);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--rule);
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--rule);
  background: var(--bg3);
}
.photo-add-icon {
  font-size: 48rpx;
  color: var(--accent);
  line-height: 1;
}
.photo-add-text {
  font-size: 22rpx;
  margin-top: 6rpx;
}

/* ========== 视频列表 ========== */
.video-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 4rpx 0 12rpx;
}
.video-list .video-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
  position: relative;
}
.video-list .video-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}
.video-list .video-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}
.video-list .video-remove {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(10, 10, 26, 0.6);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--rule);
}

.btn-add-video {
  padding: 18rpx 32rpx;
  font-size: 26rpx;
  margin-top: 12rpx;
}

/* ========== 提交按钮 ========== */
.submit-row {
  padding: 20rpx 4rpx 10rpx;
}
.btn-submit {
  width: 100%;
  height: 100rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  border-radius: 50rpx;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  border: none;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(124, 92, 252, 0.4);
}
.btn-submit[disabled] {
  opacity: 0.5;
  box-shadow: none;
}
