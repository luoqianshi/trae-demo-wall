.page {
  padding: 20rpx 20rpx 60rpx;
  background: var(--bg);
  min-height: 100vh;
}

/* AI 文案卡 */
.ai-card {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.15), rgba(240, 192, 96, 0.1));
  border: 1px solid rgba(124, 92, 252, 0.3);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.ai-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-label {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.period {
  font-size: 24rpx;
  color: var(--muted);
}

.ai-caption {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
  display: block;
  margin-bottom: 20rpx;
}

.ai-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.meta-badge {
  background: rgba(255, 255, 255, 0.08);
  color: var(--ink);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.meta-kw {
  color: var(--accent);
  font-size: 22rpx;
  margin-right: 8rpx;
}

/* 所有照片网格（三列，正方形，紧贴） */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  background: var(--bg2);
  display: block;
}

.loading-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
}

.loading-text {
  padding: 80rpx 0;
}

.empty-state {
  padding: 80rpx 0;
  font-size: 28rpx;
}

.text-muted {
  color: var(--muted);
}

.text-center {
  text-align: center;
}

/* 查看所有照片入口按钮 */
.all-photos-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.all-photos-label {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.all-photos-arrow {
  font-size: 40rpx;
  color: var(--muted);
  line-height: 1;
  margin-right: 4rpx;
}
