<view class="page">
  <view wx:if="{{loading}}" class="loading-text text-center text-muted">加载中...</view>

  <block wx:else>
    <!-- AI 文案卡 -->
    <view class="ai-card" wx:if="{{group}}">
      <view class="ai-head">
        <text class="ai-label">🔮 AI 记忆</text>
        <text class="period">{{group.period_label}}</text>
      </view>
      <text class="ai-caption">{{group.ai_summary.caption}}</text>
      <view class="ai-meta">
        <text class="meta-badge" wx:if="{{group.location_name}}">📍 {{group.location_name}}</text>
        <text class="meta-badge" wx:if="{{group.ai_summary.mood}}">💭 {{group.ai_summary.mood}}</text>
        <text class="meta-badge">📷 {{group.photo_count}} 张</text>
        <text wx:for="{{group.ai_summary.keywords}}" wx:for-item="kw" wx:key="*this" class="meta-kw">#{{kw}}</text>
      </view>
    </view>

    <!-- 「查看所有照片」入口 -->
    <view class="all-photos-btn" bindtap="goAllPhotos">
      <text class="all-photos-label">📚 查看所有记忆中的照片</text>
      <text class="all-photos-arrow">›</text>
    </view>

    <!-- 本组照片 -->
    <view class="photo-grid" wx:if="{{photos.length > 0}}">
      <block wx:for="{{photos}}" wx:key="id">
        <image
          class="photo-item"
          src="{{item.url}}"
          mode="aspectFill"
          data-url="{{item.url}}"
          catchtap="previewPhoto"
        />
      </block>
    </view>

    <view wx:if="{{photos.length < total}}" class="loading-more text-muted">上拉加载更多...</view>
    <view wx:elif="{{photos.length >= total && photos.length > 0}}" class="loading-more text-muted">— 已显示全部 {{total}} 张 —</view>
    <view wx:elif="{{total === 0}}" class="empty-state text-center text-muted">暂无照片</view>
  </block>
</view>
