/* ========== AI 人设聊天页（Dark Theme） ========== */

page {
  background: var(--bg);
  color: var(--ink);
}

/* ---------- 页面容器 ---------- */
.persona-chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ---------- 顶部导航栏 ---------- */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: var(--bg2);
  border-bottom: 1px solid var(--rule);
  flex-shrink: 0;
}

.header-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.header-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg3);
  border: 2rpx solid var(--accent);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.header-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.header-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.header-subtitle {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
  margin-top: 4rpx;
}

.header-info-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg3);
  border: 1px solid var(--rule);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.header-info-btn:active {
  background: var(--rule);
}

.info-icon {
  font-size: 28rpx;
  color: var(--muted);
}

/* ---------- 消息列表 ---------- */
.message-list {
  flex: 1;
  padding: 24rpx 28rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

/* 时间戳 */
.message-time {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin: 24rpx 0 16rpx;
}

/* 消息行 */
.message-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.message-row.ai {
  justify-content: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

/* AI 头像 */
.ai-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg3);
  border: 2rpx solid var(--accent);
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 消息气泡 */
.message-bubble {
  max-width: 70vw;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.message-bubble.ai {
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-left: 4rpx solid var(--accent);
  color: var(--ink);
  border-top-left-radius: 4rpx;
}

.message-bubble.user {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  border-top-right-radius: 4rpx;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 8rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  animation: typing-bounce 1.4s infinite ease-in-out both;
}

.typing-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.typing-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing-bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ---------- 快捷建议 ---------- */
.suggestion-bar {
  padding: 16rpx 28rpx;
  background: var(--bg);
  border-top: 1px solid var(--rule);
  flex-shrink: 0;
}

.suggestion-scroll {
  white-space: nowrap;
}

.suggestion-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: var(--bg2);
  border: 1px solid var(--rule);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--muted);
  margin-right: 16rpx;
  transition: all 0.2s;
}

.suggestion-chip:last-child {
  margin-right: 0;
}

.suggestion-chip:active {
  background: var(--bg3);
  border-color: var(--accent);
  color: var(--ink);
}

/* ---------- 输入区域 ---------- */
.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 40rpx;
  background: var(--bg2);
  border-top: 1px solid var(--rule);
  gap: 16rpx;
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 160rpx;
  padding: 16rpx 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: none;
  padding: 0;
}

.send-btn:active {
  opacity: 0.8;
}

.send-btn[disabled] {
  opacity: 0.4;
}

.send-icon {
  font-size: 32rpx;
  color: #fff;
}

/* ---------- 胶囊来源弹窗 ---------- */
.capsule-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.capsule-modal {
  width: 100%;
  background: var(--bg2);
  border-radius: 32rpx 32rpx 0 0;
  border-top: 1px solid var(--rule);
  padding: 32rpx 28rpx 60rpx;
  animation: slide-up 0.3s ease-out;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  display: block;
  margin-bottom: 32rpx;
}

.source-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.source-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
}

.source-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.source-info {
  flex: 1;
  min-width: 0;
}

.source-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  display: block;
}

.source-desc {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
  display: block;
}

.source-count {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
  flex-shrink: 0;
}

.modal-close-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 600;
}

.modal-close-btn:active {
  background: var(--rule);
}

/* ---------- 加载 & 空状态 ---------- */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  font-size: 64rpx;
  margin-bottom: 20rpx;
  animation: spin 1.2s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: var(--muted);
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--muted);
}
