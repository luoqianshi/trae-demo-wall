<view class="persona-chat-page">
  <block wx:if="{{ loading }}">
    <view class="loading-state">
      <text class="loading-spinner">⏳</text>
      <text class="loading-text text-muted">加载人设中...</text>
    </view>
  </block>

  <block wx:elif="{{ capsule }}">
    <!-- 聊天头部 -->
    <view class="chat-header">
      <view class="header-left">
        <image class="header-avatar" src="{{ persona.avatar }}" mode="aspectFill"/>
        <view class="header-info">
          <text class="header-name">{{ persona.name }}</text>
          <text class="header-subtitle">AI 模拟人设 · 基于记忆胶囊</text>
        </view>
      </view>
      <view class="header-info-btn" bindtap="showCapsuleInfo">
        <text class="info-icon">ℹ</text>
      </view>
    </view>

    <!-- 消息列表 -->
    <scroll-view class="message-list" scroll-y="true" scroll-into-view="{{ scrollToId }}" enhanced="true" show-scrollbar="false">
      <block wx:for="{{ messages }}" wx:key="id" wx:for-item="msg">
        <block wx:if="{{ msg.type === 'time' }}">
          <view class="message-time">{{ msg.text }}</view>
        </block>
        <block wx:else>
          <view id="msg-{{ msg.id }}" class="message-row {{ msg.sender }}">
            <block wx:if="{{ msg.sender === 'ai' }}">
              <image class="ai-avatar" src="{{ persona.avatar }}" mode="aspectFill"/>
              <view class="message-bubble ai">
                <text>{{ msg.text }}</text>
              </view>
            </block>
            <block wx:else>
              <view class="message-bubble user">
                <text>{{ msg.text }}</text>
              </view>
            </block>
          </view>
        </block>
      </block>

      <!-- 打字指示器 -->
      <block wx:if="{{ typing }}">
        <view class="message-row ai">
          <image class="ai-avatar" src="{{ persona.avatar }}" mode="aspectFill"/>
          <view class="message-bubble ai">
            <view class="typing-indicator">
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
              <view class="typing-dot"></view>
            </view>
          </view>
        </view>
      </block>

      <!-- 底部占位，确保滚动到底部 -->
      <view id="msg-bottom"></view>
    </scroll-view>

    <!-- 快捷建议 -->
    <block wx:if="{{ suggestions && suggestions.length > 0 }}">
      <view class="suggestion-bar">
        <scroll-view class="suggestion-scroll" scroll-x="true" show-scrollbar="false">
          <block wx:for="{{ suggestions }}" wx:key="*this" wx:for-item="chip">
            <view class="suggestion-chip" bindtap="sendSuggestion" data-text="{{ chip }}">{{ chip }}</view>
          </block>
        </scroll-view>
      </view>
    </block>

    <!-- 输入区域 -->
    <view class="input-area">
      <textarea
        class="chat-input"
        placeholder="和 {{ persona.name }} 说点什么..."
        placeholder-class="text-muted"
        value="{{ inputValue }}"
        bindinput="onInput"
        bindconfirm="sendMessage"
        confirm-type="send"
        maxlength="500"
        auto-height="true"
      />
      <button class="send-btn" bindtap="sendMessage" disabled="{{ !inputValue || inputValue.length === 0 || sending }}">
        <text class="send-icon">➤</text>
      </button>
    </view>
  </block>

  <block wx:else>
    <view class="empty-state">
      <text class="empty-icon">🤖</text>
      <text class="empty-text text-muted">未找到记忆胶囊</text>
    </view>
  </block>

  <!-- 胶囊来源弹窗 -->
  <block wx:if="{{ showModal }}">
    <view class="capsule-modal-mask" bindtap="hideCapsuleInfo">
      <view class="capsule-modal" catchtap="preventBubble">
        <text class="modal-title">记忆胶囊来源</text>
        <text class="modal-subtitle">{{ persona.name }} 的人设由以下记忆构建</text>
        <view class="source-list">
          <block wx:for="{{ capsule.sources }}" wx:key="type" wx:for-item="src">
            <view class="source-item">
              <text class="source-icon">{{ src.icon }}</text>
              <view class="source-info">
                <text class="source-name">{{ src.name }}</text>
                <text class="source-desc">{{ src.desc }}</text>
              </view>
              <text class="source-count">{{ src.count }} 条</text>
            </view>
          </block>
        </view>
        <view class="modal-close-btn" bindtap="hideCapsuleInfo">关闭</view>
      </view>
    </view>
  </block>
</view>
