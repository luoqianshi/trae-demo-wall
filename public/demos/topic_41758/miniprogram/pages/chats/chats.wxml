<view class="container chats-page">
  <view wx:if="{{!loading && total > 0}}" class="summary-bar">
    <text class="text-muted">共 {{total}} 个会话，已由 AI 自动摘要</text>
  </view>

  <view wx:if="{{loading}}" class="loading-text text-center text-muted">加载中...</view>

  <block wx:else>
    <view wx:if="{{conversations.length === 0}}" class="empty-state text-center">
      <text class="empty-emoji">💬</text>
      <text class="text-muted">还没有聊天记录</text>
      <button class="btn btn-primary mt-24" bindtap="goImport">去导入</button>
    </view>

    <view class="chat-list">
      <view
        wx:for="{{conversations}}"
        wx:key="id"
        class="chat-item card"
        data-id="{{item.id}}"
        data-name="{{item.conversation_name}}"
        bindtap="goDetail"
      >
        <image class="chat-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
        <view class="chat-info flex-1">
          <view class="chat-top flex-row flex-between">
            <text class="chat-name">{{item.conversation_name}}</text>
            <text class="chat-time text-muted text-xs">{{item.last_message_at_text}}</text>
          </view>
          <text class="chat-last text-muted">{{item.last_message}}</text>
          <view class="chat-summary" wx:if="{{item.ai_summary}}">
            <text class="summary-label text-xs">AI 摘要：</text>
            <text class="summary-relation text-xs">
              {{item.ai_summary.relationship}}
            </text>
            <view class="summary-topics flex-row flex-wrap">
              <text wx:for="{{item.ai_summary.key_topics}}" wx:for-item="topic" wx:key="*this" class="topic-tag text-xs">
                #{{topic}}
              </text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
