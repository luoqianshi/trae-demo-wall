.chats-page {
  padding: 24rpx 28rpx 48rpx;
}

.summary-bar {
  padding: 12rpx 0 24rpx;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.chat-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
}

.chat-item:active {
  background: var(--bg3);
}

.chat-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg3);
}

.chat-info {
  min-width: 0;
}

.chat-top {
  margin-bottom: 6rpx;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-time {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.chat-last {
  font-size: 26rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 10rpx;
}

.chat-summary {
  padding: 12rpx 16rpx;
  background: rgba(124, 92, 252, 0.08);
  border-radius: 12rpx;
  border: 1px dashed var(--rule);
}

.summary-label {
  color: var(--accent);
  font-weight: 600;
  margin-right: 8rpx;
}

.summary-relation {
  color: var(--accent2);
  font-weight: 600;
}

.summary-topics {
  margin-top: 8rpx;
  gap: 8rpx;
}

.topic-tag {
  color: var(--muted);
  margin-right: 12rpx;
}

.loading-text {
  padding: 80rpx 0;
}

.empty-state {
  padding: 80rpx 0;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.text-xs {
  font-size: 22rpx;
}
