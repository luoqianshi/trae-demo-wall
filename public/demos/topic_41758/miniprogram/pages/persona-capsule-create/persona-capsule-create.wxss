/* ========== 人设记忆胶囊 · 创建页（Dark） ========== */

.create-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 140rpx;
  background: var(--bg);
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 20rpx 0 40rpx;
}
.page-title-gradient {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: transparent;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.page-subtitle {
  font-size: 24rpx;
  display: block;
  line-height: 1.6;
}

/* ========== 步骤指示器 ========== */
.step-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  margin-top: 8rpx;
}
.step-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.step-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  flex: 1;
}
.step-count {
  font-size: 24rpx;
}

/* ========== 表单卡片 ========== */
.form-card {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 18rpx;
}

.form-input {
  width: 100%;
  padding: 22rpx 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 22rpx 24rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  box-sizing: border-box;
}

/* ========== 类型选择 ========== */
.type-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.type-option {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: var(--bg3);
  border-radius: 20rpx;
  border: 1px solid var(--rule);
  transition: all 0.2s;
}
.type-option-active {
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.25), rgba(124, 92, 252, 0.1));
  border-color: var(--accent);
  box-shadow: 0 4rpx 20rpx rgba(124, 92, 252, 0.2);
}
.type-emoji {
  font-size: 36rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg2);
  border: 1px solid var(--rule);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.type-option-active .type-emoji {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  border-color: transparent;
}
.type-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 4rpx;
}
.type-desc {
  font-size: 22rpx;
  display: block;
  line-height: 1.5;
}

/* ========== 记忆来源卡片 ========== */
.source-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
}
.source-header {
  margin-bottom: 16rpx;
}
.source-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}
.source-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.source-count {
  font-size: 24rpx;
}

/* ========== 记忆列表项 ========== */
.source-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.memory-item {
  padding: 18rpx 20rpx;
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 16rpx;
  transition: all 0.2s;
}
.memory-item:active {
  opacity: 0.85;
}
.memory-item-active {
  border-color: var(--accent);
  background: linear-gradient(135deg, rgba(124, 92, 252, 0.15), rgba(124, 92, 252, 0.05));
  box-shadow: 0 2rpx 12rpx rgba(124, 92, 252, 0.15);
}

.memory-content {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.memory-thumbnails {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--bg2);
  margin-right: 18rpx;
  flex-shrink: 0;
  border: 1px solid var(--rule);
}
.thumb-img {
  width: 100%;
  height: 100%;
}
.thumb-placeholder {
  width: 100%;
  height: 100%;
  font-size: 36rpx;
  background: var(--bg2);
}

.chat-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg2);
  margin-right: 18rpx;
  flex-shrink: 0;
  border: 1px solid var(--rule);
}

.memory-info {
  min-width: 0;
  justify-content: center;
}
.memory-title {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
.memory-meta {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ========== 复选框 ========== */
.checkbox-wrap {
  flex-shrink: 0;
}
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--rule);
  background: var(--bg2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.checkbox-checked {
  background: linear-gradient(135deg, var(--accent), #a48cff);
  border-color: var(--accent);
}
.checkbox-tick {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

/* ========== 空状态 mini ========== */
.empty-mini {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
}

/* ========== AI 预览卡片 ========== */
.preview-card {
  margin-bottom: 32rpx;
  overflow: hidden;
}

.preview-loading {
  padding: 60rpx 0;
  gap: 20rpx;
}
.preview-spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid var(--rule);
  border-top-color: var(--accent);
  animation: spin 1s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.preview-loading-text {
  font-size: 26rpx;
}

.preview-header {
  margin-bottom: 24rpx;
}
.preview-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.preview-header-info {
  justify-content: center;
  min-width: 0;
}
.preview-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}
.preview-type {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.preview-traits {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.trait-tag {
  padding: 8rpx 20rpx;
  background: rgba(124, 92, 252, 0.15);
  border: 1px solid rgba(124, 92, 252, 0.35);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.preview-divider {
  height: 1px;
  background: var(--rule);
  margin: 24rpx 0;
}

.preview-greeting {
  display: flex;
  flex-direction: column;
}
.greeting-label {
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.greeting-bubble {
  background: var(--bg3);
  border: 1px solid var(--rule);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  position: relative;
}
.greeting-bubble::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 24rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 10rpx solid var(--rule);
}
.greeting-text {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.7;
}

/* ========== 提交按钮 ========== */
.submit-row {
  padding: 20rpx 4rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.btn-submit {
  width: 100%;
  height: 100rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  border-radius: 50rpx;
  background: linear-gradient(135deg, var(--accent), #a48cff);
  color: #fff;
  border: none;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(124, 92, 252, 0.4);
}
.btn-submit[disabled] {
  opacity: 0.4;
  box-shadow: none;
}
.submit-hint {
  font-size: 22rpx;
  margin-top: 16rpx;
  text-align: center;
}
