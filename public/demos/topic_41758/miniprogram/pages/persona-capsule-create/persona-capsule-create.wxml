<view class="container create-page">

  <!-- 页面头部 -->
  <view class="page-header">
    <text class="page-title-gradient">封存记忆胶囊</text>
    <text class="page-subtitle text-muted">选择你的记忆片段，封装成一个 AI 人设胶囊</text>
    <text class="page-subtitle text-muted">未来可以随时与这个"你"对话</text>
  </view>

  <!-- Step 1: 基本信息 -->
  <view class="step-section">
    <view class="step-badge">1</view>
    <text class="step-title">基本信息</text>
  </view>

  <view class="form-card card">
    <text class="form-label">胶囊名称</text>
    <input class="form-input" placeholder="例如：2024年的我、大学室友小李" value="{{ capsuleName }}" bindinput="onNameInput" maxlength="30" />
  </view>

  <view class="form-card card">
    <text class="form-label">描述（可选）</text>
    <textarea class="form-textarea" placeholder="这个胶囊代表什么样的人设？" value="{{ capsuleDesc }}" bindinput="onDescInput" maxlength="200" auto-height />
  </view>

  <view class="form-card card">
    <text class="form-label">人设类型</text>
    <view class="type-options">
      <view class="type-option {{ personaType === 'self' ? 'type-option-active' : '' }}" data-type="self" bindtap="selectPersonaType">
        <text class="type-emoji">🧑‍🚀</text>
        <view class="type-info">
          <text class="type-name">我的记忆</text>
          <text class="type-desc text-muted">基于自己的照片、朋友圈、聊天记录构建的 AI 分身</text>
        </view>
      </view>
      <view class="type-option {{ personaType === 'other' ? 'type-option-active' : '' }}" data-type="other" bindtap="selectPersonaType">
        <text class="type-emoji">👤</text>
        <view class="type-info">
          <text class="type-name">他人的记忆</text>
          <text class="type-desc text-muted">基于与某人的聊天记录、共同回忆构建的 AI 形象</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Step 2: 选择记忆来源 -->
  <view class="step-section">
    <view class="step-badge">2</view>
    <text class="step-title">选择记忆来源</text>
    <text class="step-count text-muted" wx:if="{{ totalSelectedCount > 0 }}">已选 {{ totalSelectedCount }} 项</text>
  </view>

  <!-- 照片 -->
  <view class="source-card card">
    <view class="source-header flex-between">
      <view class="flex-row">
        <text class="source-icon">📷</text>
        <text class="source-name">照片</text>
      </view>
      <text class="source-count text-muted">{{ selectedPhotoCount }}/{{ photoGroupsCount }}</text>
    </view>
    <view class="source-list">
      <block wx:if="{{ photoGroupsCount === 0 }}">
        <view class="empty-mini text-muted">暂无照片数据</view>
      </block>
      <block wx:else>
        <view
          class="memory-item flex-between {{ selectedPhotoIds.indexOf(item.id) !== -1 ? 'memory-item-active' : '' }}"
          wx:for="{{ photoGroups }}"
          wx:key="id"
          data-id="{{ item.id }}"
          bindtap="togglePhoto"
        >
          <view class="flex-row memory-content">
            <view class="memory-thumbnails">
              <block wx:if="{{ item.cover_urls && item.cover_urls.length > 0 }}">
                <image class="thumb-img" src="{{ item.cover_urls[0] }}" mode="aspectFill" />
              </block>
              <block wx:else>
                <view class="thumb-placeholder flex-center">
                  <text>📷</text>
                </view>
              </block>
            </view>
            <view class="flex-col memory-info">
              <text class="memory-title">{{ item.period_label }}</text>
              <text class="memory-meta text-muted">{{ item.photo_count }} 张照片 · {{ item.location_name }}</text>
            </view>
          </view>
          <view class="checkbox-wrap">
            <view class="checkbox {{ selectedPhotoIds.indexOf(item.id) !== -1 ? 'checkbox-checked' : '' }}">
              <block wx:if="{{ selectedPhotoIds.indexOf(item.id) !== -1 }}">
                <text class="checkbox-tick">✓</text>
              </block>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 朋友圈 -->
  <view class="source-card card">
    <view class="source-header flex-between">
      <view class="flex-row">
        <text class="source-icon">📝</text>
        <text class="source-name">朋友圈</text>
      </view>
      <text class="source-count text-muted">{{ selectedMomentCount }}/{{ momentsCount }}</text>
    </view>
    <view class="source-list">
      <block wx:if="{{ momentsCount === 0 }}">
        <view class="empty-mini text-muted">暂无朋友圈数据</view>
      </block>
      <block wx:else>
        <view
          class="memory-item flex-between {{ selectedMomentIds.indexOf(item.id) !== -1 ? 'memory-item-active' : '' }}"
          wx:for="{{ moments }}"
          wx:key="id"
          data-id="{{ item.id }}"
          bindtap="toggleMoment"
        >
          <view class="flex-col memory-content">
            <text class="memory-title">{{ item.content.text }}</text>
            <text class="memory-meta text-muted">{{ item.occurred_at_text }} · {{ item.city }}</text>
          </view>
          <view class="checkbox-wrap">
            <view class="checkbox {{ selectedMomentIds.indexOf(item.id) !== -1 ? 'checkbox-checked' : '' }}">
              <block wx:if="{{ selectedMomentIds.indexOf(item.id) !== -1 }}">
                <text class="checkbox-tick">✓</text>
              </block>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 聊天记录 -->
  <view class="source-card card">
    <view class="source-header flex-between">
      <view class="flex-row">
        <text class="source-icon">💬</text>
        <text class="source-name">聊天记录</text>
      </view>
      <text class="source-count text-muted">{{ selectedChatCount }}/{{ chatsCount }}</text>
    </view>
    <view class="source-list">
      <block wx:if="{{ chatsCount === 0 }}">
        <view class="empty-mini text-muted">暂无聊天记录</view>
      </block>
      <block wx:else>
        <view
          class="memory-item flex-between {{ selectedChatIds.indexOf(item.id) !== -1 ? 'memory-item-active' : '' }}"
          wx:for="{{ chats }}"
          wx:key="id"
          data-id="{{ item.id }}"
          bindtap="toggleChat"
        >
          <view class="flex-row memory-content">
            <image class="chat-avatar" src="{{ item.avatar_url }}" mode="aspectFill" />
            <view class="flex-col memory-info">
              <text class="memory-title">{{ item.conversation_name }}</text>
              <text class="memory-meta text-muted">{{ item.message_count }} 条消息 · 最后对话 {{ item.last_message_at_text }}</text>
            </view>
          </view>
          <view class="checkbox-wrap">
            <view class="checkbox {{ selectedChatIds.indexOf(item.id) !== -1 ? 'checkbox-checked' : '' }}">
              <block wx:if="{{ selectedChatIds.indexOf(item.id) !== -1 }}">
                <text class="checkbox-tick">✓</text>
              </block>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 漂流瓶 -->
  <view class="source-card card">
    <view class="source-header flex-between">
      <view class="flex-row">
        <text class="source-icon">🍾</text>
        <text class="source-name">漂流瓶</text>
      </view>
      <text class="source-count text-muted">{{ selectedBottleCount }}/{{ bottlesCount }}</text>
    </view>
    <view class="source-list">
      <block wx:if="{{ bottlesCount === 0 }}">
        <view class="empty-mini text-muted">暂无漂流瓶</view>
      </block>
      <block wx:else>
        <view
          class="memory-item flex-between {{ selectedBottleIds.indexOf(item.id) !== -1 ? 'memory-item-active' : '' }}"
          wx:for="{{ bottles }}"
          wx:key="id"
          data-id="{{ item.id }}"
          bindtap="toggleBottle"
        >
          <view class="flex-col memory-content">
            <text class="memory-title">{{ item.title }}</text>
            <text class="memory-meta text-muted">{{ item.sealed_at_text }} · {{ item.status === 'sealed' ? '封存中' : '已开启' }}</text>
          </view>
          <view class="checkbox-wrap">
            <view class="checkbox {{ selectedBottleIds.indexOf(item.id) !== -1 ? 'checkbox-checked' : '' }}">
              <block wx:if="{{ selectedBottleIds.indexOf(item.id) !== -1 }}">
                <text class="checkbox-tick">✓</text>
              </block>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- Step 3: AI Persona 预览 -->
  <block wx:if="{{ showPreview }}">
    <view class="step-section">
      <view class="step-badge">3</view>
      <text class="step-title">AI 人设预览</text>
    </view>

    <view class="preview-card card">
      <block wx:if="{{ previewLoading }}">
        <view class="preview-loading flex-col flex-center">
          <view class="preview-spinner"></view>
          <text class="preview-loading-text text-muted">AI 正在分析记忆并生成人设...</text>
        </view>
      </block>
      <block wx:else>
        <view class="preview-header flex-row">
          <view class="preview-avatar flex-center">
            <text>{{ personaType === 'self' ? '🧑‍🚀' : '👤' }}</text>
          </view>
          <view class="flex-col preview-header-info">
            <text class="preview-name">{{ capsuleName || '未命名胶囊' }}</text>
            <text class="preview-type text-muted">{{ personaType === 'self' ? '我的记忆' : '他人的记忆' }}</text>
          </view>
        </view>

        <view class="preview-traits">
          <view class="trait-tag" wx:for="{{ previewTraits }}" wx:key="*this">
            <text>{{ item }}</text>
          </view>
        </view>

        <view class="preview-divider"></view>

        <view class="preview-greeting">
          <text class="greeting-label text-muted">预览问候</text>
          <view class="greeting-bubble">
            <text class="greeting-text">{{ previewGreeting }}</text>
          </view>
        </view>
      </block>
    </view>
  </block>

  <!-- 提交按钮 -->
  <view class="submit-row">
    <button
      class="btn btn-primary btn-submit"
      bindtap="submit"
      disabled="{{ !capsuleName.trim() || totalSelectedCount === 0 || submitting }}"
    >
      <block wx:if="{{ submitting }}">
        <text>封存中...</text>
      </block>
      <block wx:else>
        <text>封存胶囊</text>
      </block>
    </button>
    <text class="submit-hint text-muted" wx:if="{{ !capsuleName.trim() || totalSelectedCount === 0 }}">请填写名称并至少选择一项记忆</text>
  </view>

</view>
