{
  "manifest_version": 3,
  "name": "打工人的工具箱",
  "version": "1.0.0",
  "description": "一个像素风主题的多功能工具箱，包含二维码生成、JSON格式化、截屏、TODO、番茄钟等实用功能",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "打工人的工具箱",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
