{
  "version": "1.0.0",
  "description": "局点项目信息管理系统 - 数据库初始化模板",
  "fields": [
    { "key": "name", "label": "局点名称", "type": "text", "visible": 1, "orderIndex": 1, "options": [], "defaultValue": "", "showInQuickAdd": 1 },
    { "key": "customer", "label": "客户名称", "type": "text", "visible": 1, "orderIndex": 2, "options": [], "defaultValue": "", "showInQuickAdd": 1 },
    { "key": "region", "label": "地区", "type": "text", "visible": 1, "orderIndex": 3, "options": [], "defaultValue": "", "showInQuickAdd": 1 },
    { "key": "status", "label": "当前状态", "type": "select", "visible": 1, "orderIndex": 4, "options": ["进行中", "已完成", "暂停", "待启动"], "defaultValue": "", "showInQuickAdd": 1 },
    { "key": "currentPhase", "label": "当前阶段", "type": "text", "visible": 1, "orderIndex": 5, "options": [], "defaultValue": "", "showInQuickAdd": 0 },
    { "key": "nextAction", "label": "下一步操作", "type": "textarea", "visible": 1, "orderIndex": 6, "options": [], "defaultValue": "", "showInQuickAdd": 0 },
    { "key": "imGroup", "label": "关联 IM 群", "type": "jumper", "visible": 1, "orderIndex": 7, "options": [], "defaultValue": "", "showInQuickAdd": 0, "jumperMode": "group" },
    { "key": "imContact", "label": "关联 IM 个人", "type": "jumper", "visible": 1, "orderIndex": 8, "options": [], "defaultValue": "", "showInQuickAdd": 0, "jumperMode": "person" },
    { "key": "isRecent", "label": "近期需处理", "type": "select", "visible": 0, "orderIndex": 99, "options": ["是", "否"], "defaultValue": "否", "showInQuickAdd": 0 }
  ],
  "progressTemplates": [
    {
      "id": "tpl-data-map-light",
      "name": "数据地图点亮",
      "fields": [
        { "key": "range", "label": "点亮范围", "type": "text" },
        { "key": "status", "label": "完成状态", "type": "text" },
        { "key": "remark", "label": "备注", "type": "textarea" }
      ]
    },
    {
      "id": "tpl-data-map-maintain",
      "name": "数据地图维护",
      "fields": [
        { "key": "maintain", "label": "维护内容", "type": "textarea" },
        { "key": "issues", "label": "问题记录", "type": "textarea" },
        { "key": "next", "label": "下一步", "type": "text" }
      ]
    }
  ],
  "knowledgeCategories": [
    { "id": "kc-datamap", "name": "数据地图配置", "description": "数据地图相关配置操作", "orderIndex": 1 },
    { "id": "kc-network", "name": "网络配置", "description": "网络设备配置方法", "orderIndex": 2 },
    { "id": "kc-deploy", "name": "系统部署", "description": "系统安装部署操作", "orderIndex": 3 },
    { "id": "kc-trouble", "name": "问题排查", "description": "常见问题及解决方案", "orderIndex": 4 }
  ],
  "stats": [
    { "id": "stat-status", "name": "局点状态分布", "chartType": "pie", "dataSource": "project-status", "config": {}, "orderIndex": 1, "enabled": 1 },
    { "id": "stat-region", "name": "地区分布", "chartType": "bar", "dataSource": "project-region", "config": {}, "orderIndex": 2, "enabled": 1 },
    { "id": "stat-trend", "name": "进展趋势", "chartType": "line", "dataSource": "progress-trend", "config": {}, "orderIndex": 3, "enabled": 1 }
  ],
  "uiSettings": {
    "defaultPage": "quickAdd",
    "theme": "light",
    "tableDensity": "middle",
    "cardOpacity": 0.72,
    "auroraEnabled": 1,
    "cardOpacityAlpha": 0.82,
    "demoModeEnabled": 1
  },
  "aiConfig": {
    "apiUrl": "https://api.openai.com/v1/chat/completions",
    "apiKey": "",
    "model": "gpt-4o-mini",
    "promptTemplate": "请从以下 IM 聊天记录中提取项目进展信息，严格以 JSON 格式返回，不要包裹在代码块中：\n\n要求 JSON 结构：\n{\"summary\": \"进展摘要，简明概括本次沟通的核心内容\", \"currentStatus\": \"当前状态\", \"issues\": [\"关键问题1\", \"关键问题2\"], \"nextActions\": [\"下一步行动1\", \"下一步行动2\"]}\n\n聊天记录：\n{chat_records}\n\n请直接返回 JSON 对象。"
  },
  "jumperConfig": {
    "personTemplate": "",
    "groupTemplate": ""
  }
}
