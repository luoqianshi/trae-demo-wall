graph TD
    subgraph "可视化适配层 (Visualization Adaptation Layer)"
        VA[C API Interface]
        VA -->|calls| MG
        VA -->|calls| OP
        VA -->|calls| GEOM
    end

    subgraph "网格剖分层 (Mesh Generation Layer)"
        MG[MeshGenerator]
        MS[Simplification]
        MD[Subdivision]
        STL[STLExport]
        
        MG -->|uses| GEOM
        MS -->|uses| GEOM
        MD -->|uses| GEOM
        STL -->|uses| GEOM
    end

    subgraph "几何运算层 (Geometric Operations Layer)"
        OP[Operations]
        INT[Intersection]
        BOOL[Boolean]
        OFF[Offset]
        FIL[Fillet/Chamfer]
        ST[Stitch]
        DIS[Distance]
        
        INT -->|uses| GEOM
        BOOL -->|uses| GEOM
        OFF -->|uses| GEOM
        FIL -->|uses| GEOM
        ST -->|uses| GEOM
        DIS -->|uses| GEOM
    end

    subgraph "几何底层层 (Geometry Foundation Layer)"
        GEOM[Geometry]
        CURV[Curves]
        SURF[Surfaces]
        BREP[BRep Topology]
        MATH[Math]
        
        CURV -->|uses| MATH
        SURF -->|uses| MATH
        BREP -->|uses| CURV
        BREP -->|uses| SURF
        BREP -->|uses| MATH
    end

    subgraph "基础工具层 (Utility Layer)"
        UTIL[Utils]
        ERR[Error Handling]
        PREC[Precision Control]
        
        ERR --> UTIL
        PREC --> UTIL
    end

    MATH -->|uses| PREC
    GEOM -->|uses| PREC
    OP -->|uses| ERR
    OP -->|uses| PREC
    MG -->|uses| PREC
    VA -->|uses| ERR
    VA -->|uses| PREC

    style VA fill:#E1F5FE,stroke:#0288D1,stroke-width:2px
    style MG fill:#E8F5E9,stroke:#388E3C,stroke-width:2px
    style OP fill:#FFF3E0,stroke:#F57C00,stroke-width:2px
    style GEOM fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px
    style UTIL fill:#ECEFF1,stroke:#546E7A,stroke-width:2px

    subgraph "语言分工"
        RUST[Rust Layer]
        CPP[C++ Layer]
        CAPI[C API Layer]
        
        RUST -->|FFI| CPP
        CPP -->|C ABI| CAPI
    end

    style RUST fill:#DEA584,stroke:#B7410E,stroke-width:2px
    style CPP fill:#00599C,stroke:#003366,stroke-width:2px
    style CAPI fill:#D4D4D4,stroke:#666666,stroke-width:2px