# Rust 编译环境（Tauri + Yew WASM）
# 使用国内镜像加速
# 源码通过 volume 挂载，避免每次改动重建镜像
FROM rust:latest

# 安装 Tauri 系统依赖 + trunk 依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libwebkit2gtk-4.1-dev \
        libgtk-3-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        libssl-dev \
        pkg-config \
        build-essential \
        cmake \
        && rm -rf /var/lib/apt/lists/*

# 配置 cargo 国内镜像（中科大 USTC）
RUN mkdir -p /usr/local/cargo/.cargo && \
    echo '[source.crates-io]' > /usr/local/cargo/.cargo/config.toml && \
    echo 'replace-with = "ustc"' >> /usr/local/cargo/.cargo/config.toml && \
    echo '[source.ustc]' >> /usr/local/cargo/.cargo/config.toml && \
    echo 'registry = "sparse+https://mirrors.ustc.edu.cn/crates.io-index/"' >> /usr/local/cargo/.cargo/config.toml

# 配置 cargo 代理（可选，通过环境变量启用）
# ENV http_proxy=http://host.docker.internal:10808
# ENV https_proxy=http://host.docker.internal:10808

ENV CARGO_HOME=/usr/local/cargo/.cargo
ENV PATH="/usr/local/cargo/.cargo/bin:${PATH}"

# 添加 WASM 目标（用于 Yew 前端编译）
RUN rustup target add wasm32-unknown-unknown

# 安装 trunk（Yew WASM 构建工具）
RUN cargo install trunk --locked

# 设置工作目录
WORKDIR /app

# 默认命令：检查前后端编译
CMD ["cargo", "check", "--manifest-path", "src/AI_FileManager/src-tauri/Cargo.toml"]