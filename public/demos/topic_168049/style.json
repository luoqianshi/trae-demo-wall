{
  "version": 8,
  "name": "顺路 · 贴纸平涂风",
  "metadata": {
    "maputnik:renderer": "mlgl",
    "owner": "顺路 Shunlu",
    "description": "贴纸平涂卡通 · 暖色探索地图"
  },
  "sources": {
    "shanghai": {
      "type": "vector",
      "tiles": ["tiles/{z}/{x}/{y}.pbf"],
      "maxzoom": 14,
      "minzoom": 10,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#fcf6ea"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "shanghai",
      "source-layer": "park",
      "paint": {
        "fill-color": "#b8c9a8",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "shanghai",
      "source-layer": "water",
      "paint": {
        "fill-color": "#b8d4e0"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "shanghai",
      "source-layer": "building",
      "paint": {
        "fill-color": "#f2dcb8",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "shanghai",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#a07a4f",
        "line-width": {
          "stops": [[11, 3], [16, 10]]
        },
        "line-opacity": 0.6
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "shanghai",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#fffbf2",
        "line-width": {
          "stops": [[11, 2], [16, 8]]
        }
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "shanghai",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#8a6440",
        "line-width": {
          "stops": [[10, 4], [16, 12]]
        },
        "line-opacity": 0.6
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "shanghai",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#fffbf2",
        "line-width": {
          "stops": [[10, 3], [16, 10]]
        }
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "shanghai",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#8a6440",
        "line-width": {
          "stops": [[8, 3], [16, 14]]
        },
        "line-opacity": 0.5
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "shanghai",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#fffbf2",
        "line-width": {
          "stops": [[8, 2], [16, 12]]
        }
      }
    },
    {
      "id": "poi-tourism",
      "type": "circle",
      "source": "shanghai",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["==", "class", "tourism"],
      "paint": {
        "circle-radius": 6,
        "circle-color": "#f5bd00",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 3,
        "circle-opacity": 0.95
      }
    }
  ]
}
