page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #333;
}

/* 全局变量 */
:root {
  --primary: #c45d3e;
  --primary-light: #e07a5f;
  --secondary: #3e8c6e;
  --bg: #f5f5f5;
  --card-bg: #ffffff;
  --text: #333333;
  --text-secondary: #666666;
  --text-muted: #999999;
  --border: #eeeeee;
}

/* 通用样式 */
.container {
  padding: 0 16px;
}

.card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 12px;
}

.btn-primary {
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  color: #fff;
  border-radius: 22px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  border: none;
}

.btn-secondary {
  background: #f5f5f5;
  color: #333;
  border-radius: 22px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  border: none;
}

.tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  background: #f5f5f5;
  color: #888;
  margin-right: 6px;
}

.tag-highlight {
  background: rgba(196, 93, 62, 0.1);
  color: #c45d3e;
}

.price {
  color: #c45d3e;
  font-weight: 700;
}

/* 安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
