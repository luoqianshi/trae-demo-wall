.home-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.home-header {
  background: linear-gradient(135deg, #c45d3e 0%, #e07a5f 100%);
  padding: 12px 16px 20px;
  flex-shrink: 0;
}

.location {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 12px;
}

.location-icon {
  font-size: 14px;
}

.location-text {
  font-size: 14px;
  color: #fff;
}

.location-arrow {
  font-size: 10px;
  color: rgba(255,255,255,0.7);
}

.search-box {
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  height: 40px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 8px;
}

.search-icon {
  font-size: 14px;
  color: rgba(255,255,255,0.7);
}

.search-placeholder {
  font-size: 14px;
  color: rgba(255,255,255,0.6);
}

.filter-bar {
  display: flex;
  gap: 8px;
  padding: 12px 16px;
  background: #fff;
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-chip {
  display: inline-block;
  padding: 6px 14px;
  border-radius: 16px;
  background: #f5f5f5;
  font-size: 13px;
  color: #666;
  flex-shrink: 0;
}

.filter-chip.active {
  background: #c45d3e;
  color: #fff;
}

.house-list {
  flex: 1;
  padding: 12px 16px;
  overflow-y: auto;
}

.house-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.house-image {
  width: 100%;
  height: 200px;
  position: relative;
  background: linear-gradient(135deg, #e8ddd5 0%, #d4c4b5 100%);
}

.house-img {
  width: 100%;
  height: 100%;
}

.vr-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 8px;
}

.panorama-tag {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 12px;
  backdrop-filter: blur(4px);
}

.house-info {
  padding: 12px 14px;
}

.house-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 6px;
  line-height: 1.4;
}

.house-tags {
  display: flex;
  gap: 6px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}

.house-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
