<view class="home-container">
  <!-- 顶部搜索区 -->
  <view class="home-header">
    <view class="location" bindtap="onLocationTap">
      <text class="location-icon">📍</text>
      <text class="location-text">杭州市 西湖区</text>
      <text class="location-arrow">▼</text>
    </view>
    <view class="search-box" bindtap="onSearchTap">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索小区、商圈、地铁站</text>
    </view>
  </view>

  <!-- 筛选栏 -->
  <scroll-view class="filter-bar" scroll-x="true" show-scrollbar="false">
    <view class="filter-chip {{currentFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilterTap">全部</view>
    <view class="filter-chip {{currentFilter === 'whole' ? 'active' : ''}}" data-filter="whole" bindtap="onFilterTap">整租</view>
    <view class="filter-chip {{currentFilter === 'share' ? 'active' : ''}}" data-filter="share" bindtap="onFilterTap">合租</view>
    <view class="filter-chip {{currentFilter === '1room' ? 'active' : ''}}" data-filter="1room" bindtap="onFilterTap">一居室</view>
    <view class="filter-chip {{currentFilter === '2room' ? 'active' : ''}}" data-filter="2room" bindtap="onFilterTap">两居室</view>
    <view class="filter-chip {{currentFilter === '3room' ? 'active' : ''}}" data-filter="3room" bindtap="onFilterTap">三居室</view>
  </scroll-view>

  <!-- 房源列表 -->
  <scroll-view class="house-list" scroll-y="true" refresher-enabled="true" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="house-card" wx:for="{{houses}}" wx:key="id" data-id="{{item.id}}" bindtap="onHouseTap">
      <view class="house-image">
        <image class="house-img" src="{{item.images[0]}}" mode="aspectFill" lazy-load="true"/>
        <view class="vr-badge" wx:if="{{item.hasVR}}">VR 全景</view>
        <view class="panorama-tag" wx:if="{{item.hasVR}}">全景看房</view>
      </view>
      <view class="house-info">
        <view class="house-title">{{item.title}}</view>
        <view class="house-tags">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="house-price-row">
          <view>
            <text class="price" style="font-size: 20px;">{{item.price}}</text>
            <text style="font-size: 12px; color: #999;"> 元/月</text>
          </view>
          <text style="font-size: 12px; color: #999;">{{item.location}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
