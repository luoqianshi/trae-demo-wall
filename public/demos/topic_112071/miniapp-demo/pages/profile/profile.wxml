<view class="profile-container">
  <!-- 头部信息 -->
  <view class="profile-header">
    <view class="profile-user">
      <view class="profile-avatar">👤</view>
      <view>
        <view class="profile-name">租客用户</view>
        <view class="profile-role">已认证</view>
      </view>
    </view>
    <view class="profile-stats">
      <view class="profile-stat">
        <view class="stat-num">0</view>
        <view class="stat-label">我的收藏</view>
      </view>
      <view class="profile-stat">
        <view class="stat-num">1</view>
        <view class="stat-label">我的预定</view>
      </view>
      <view class="profile-stat">
        <view class="stat-num">3</view>
        <view class="stat-label">浏览记录</view>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-group">
    <view class="menu-item" bindtap="onMenuTap" data-page="myhouses">
      <view class="menu-icon" style="background: rgba(196,93,62,0.1); color: #c45d3e;">🏠</view>
      <view class="menu-text">我的房源</view>
      <view class="menu-badge">3</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-page="chat">
      <view class="menu-icon" style="background: rgba(62,140,110,0.1); color: #3e8c6e;">💬</view>
      <view class="menu-text">消息中心</view>
      <view class="menu-badge">5</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-page="contract">
      <view class="menu-icon" style="background: rgba(59,130,246,0.1); color: #3b82f6;">📄</view>
      <view class="menu-text">合同模板</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-page="guide">
      <view class="menu-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">📷</view>
      <view class="menu-text">拍摄指导</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item">
      <view class="menu-icon" style="background: rgba(139,92,246,0.1); color: #8b5cf6;">⚙️</view>
      <view class="menu-text">设置</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item">
      <view class="menu-icon" style="background: rgba(236,72,153,0.1); color: #ec4899;">❓</view>
      <view class="menu-text">帮助与反馈</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
