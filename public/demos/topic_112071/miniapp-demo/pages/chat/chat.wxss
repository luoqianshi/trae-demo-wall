.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.chat-house-card {
  background: #fff;
  padding: 12px 16px;
  display: flex;
  gap: 12px;
  border-bottom: 0.5px solid #eee;
  flex-shrink: 0;
}

.chat-house-img {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  background: #f0f0f0;
}

.chat-house-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.chat-house-title {
  font-size: 14px;
  color: #333;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-house-price {
  font-size: 15px;
  font-weight: 700;
  color: #c45d3e;
}

.chat-messages {
  flex: 1;
  padding: 16px;
  overflow-y: auto;
}

.message-time {
  text-align: center;
  font-size: 11px;
  color: #bbb;
  margin-bottom: 12px;
}

.message-row {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  margin-bottom: 16px;
}

.message-row.self {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  flex-shrink: 0;
}

.message-avatar.tenant {
  background: linear-gradient(135deg, #3e8c6e, #5aaa8a);
}

.message-bubble {
  max-width: 240px;
  padding: 10px 14px;
  border-radius: 16px;
  font-size: 14px;
  line-height: 1.5;
  word-break: break-word;
}

.message-bubble.landlord {
  background: #fff;
  color: #333;
  border-top-left-radius: 4px;
}

.message-bubble.tenant {
  background: #c45d3e;
  color: #fff;
  border-top-right-radius: 4px;
}

.bubble-house {
  width: 200px;
}

.bubble-house-img {
  width: 100%;
  height: 100px;
  border-radius: 8px;
  background: #f0f0f0;
  margin-bottom: 8px;
}

.bubble-house-title {
  font-size: 13px;
  font-weight: 600;
  color: inherit;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bubble-house-price {
  font-size: 14px;
  font-weight: 700;
  color: inherit;
}

.chat-input-bar {
  background: #fff;
  border-top: 0.5px solid #eee;
  padding: 8px 12px;
  padding-bottom: calc(8px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  height: 40px;
  background: #f5f5f5;
  border-radius: 20px;
  border: none;
  padding: 0 16px;
  font-size: 14px;
  outline: none;
}

.chat-send-btn {
  padding: 8px 16px;
  background: #c45d3e;
  color: #fff;
  border-radius: 16px;
  font-size: 14px;
  font-weight: 600;
  flex-shrink: 0;
}
