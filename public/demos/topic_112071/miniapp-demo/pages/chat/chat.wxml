<view class="chat-container">
  <!-- 房源卡片 -->
  <view class="chat-house-card" wx:if="{{currentHouse}}">
    <image class="chat-house-img" src="{{currentHouse.images[0]}}" mode="aspectFill"/>
    <view class="chat-house-info">
      <view class="chat-house-title">{{currentHouse.title}}</view>
      <view class="chat-house-price">{{currentHouse.price}}元/月</view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="chat-messages" scroll-y="true" scroll-into-view="msg-{{messages.length-1}}">
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{index}}">
      <view class="message-time" wx:if="{{index === 0 || item.time !== messages[index-1].time}}">{{item.time}}</view>
      
      <view class="message-row {{item.from === 'tenant' ? 'self' : ''}}">
        <view class="message-avatar {{item.from === 'tenant' ? 'tenant' : ''}}">{{item.from === 'tenant' ? '我' : '张'}}</view>
        <view class="message-bubble {{item.from}}">
          <!-- 房源卡片消息 -->
          <view wx:if="{{item.type === 'house'}}" class="bubble-house">
            <image class="bubble-house-img" src="{{item.house.images[0]}}" mode="aspectFill"/>
            <view class="bubble-house-title">{{item.house.title}}</view>
            <view class="bubble-house-price">{{item.house.price}}元/月</view>
          </view>
          <!-- 文字消息 -->
          <text wx:else>{{item.content}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="chat-input-bar">
    <input class="chat-input" placeholder="输入消息..." value="{{inputValue}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend"/>
    <view class="chat-send-btn" bindtap="onSend">发送</view>
  </view>
</view>
