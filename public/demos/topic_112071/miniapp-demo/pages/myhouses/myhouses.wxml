<view class="manage-container">
  <view class="manage-tabs">
    <view class="manage-tab {{currentTab === 'on' ? 'active' : ''}}" data-tab="on" bindtap="onTabTap">发布中 (2)</view>
    <view class="manage-tab {{currentTab === 'booked' ? 'active' : ''}}" data-tab="booked" bindtap="onTabTap">已预定 (0)</view>
    <view class="manage-tab {{currentTab === 'off' ? 'active' : ''}}" data-tab="off" bindtap="onTabTap">已成交 (1)</view>
  </view>

  <view class="manage-list">
    <view class="manage-card" wx:for="{{filteredHouses}}" wx:key="id">
      <view class="manage-card-img">
        <image src="{{item.images[0]}}" mode="aspectFill" style="width: 100%; height: 100%; border-radius: 8px;"/>
        <view class="status-tag {{item.status === 'available' ? 'on' : item.status === 'booked' ? 'booked' : 'off'}}">
          {{item.status === 'available' ? '发布中' : item.status === 'booked' ? '已预定' : '已成交'}}
        </view>
      </view>
      <view class="manage-card-info">
        <view class="manage-card-title">{{item.title}}</view>
        <view class="manage-card-price">{{item.price}}元/月</view>
        <view class="manage-card-actions">
          <button class="action-btn" size="mini" bindtap="onEdit" data-id="{{item.id}}">编辑</button>
          <button class="action-btn primary" size="mini" bindtap="onToggleStatus" data-id="{{item.id}}">
            {{item.status === 'available' ? '下架' : '上架'}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{filteredHouses.length === 0}}">
    <view class="empty-icon">🏠</view>
    <view class="empty-text">暂无房源</view>
  </view>
</view>
