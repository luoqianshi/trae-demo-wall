.manage-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.manage-tabs {
  display: flex;
  background: #fff;
  border-bottom: 0.5px solid #f0f0f0;
}

.manage-tab {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 14px;
  color: #666;
  position: relative;
}

.manage-tab.active {
  color: #c45d3e;
  font-weight: 600;
}

.manage-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 3px;
  background: #c45d3e;
  border-radius: 2px;
}

.manage-list {
  padding: 12px 16px;
}

.manage-card {
  background: #fff;
  border-radius: 12px;
  padding: 14px;
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.manage-card-img {
  width: 100px;
  height: 80px;
  border-radius: 8px;
  position: relative;
  flex-shrink: 0;
  background: #f0f0f0;
}

.status-tag {
  position: absolute;
  top: 6px;
  left: 6px;
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 600;
}

.status-tag.on {
  background: rgba(62, 140, 110, 0.15);
  color: #3e8c6e;
}

.status-tag.booked {
  background: rgba(196, 93, 62, 0.15);
  color: #c45d3e;
}

.status-tag.off {
  background: #f5f5f5;
  color: #999;
}

.manage-card-info {
  flex: 1;
}

.manage-card-title {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.manage-card-price {
  font-size: 16px;
  font-weight: 700;
  color: #c45d3e;
  margin-bottom: 8px;
}

.manage-card-actions {
  display: flex;
  gap: 8px;
}

.action-btn {
  margin: 0;
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 12px;
  border: 0.5px solid #ddd;
  background: #fff;
  color: #666;
  line-height: 1.5;
}

.action-btn.primary {
  background: #c45d3e;
  color: #fff;
  border-color: #c45d3e;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 14px;
  color: #999;
}
