.contract-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100px;
}

.contract-header {
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  padding: 30px 16px 40px;
  color: #fff;
  text-align: center;
}

.contract-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.contract-title {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 6px;
}

.contract-desc {
  font-size: 14px;
  opacity: 0.8;
}

.contract-preview {
  padding: 16px;
}

.preview-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
  margin-bottom: 12px;
}

.preview-content {
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.preview-line {
  font-size: 14px;
  color: #333;
  line-height: 1.8;
}

.preview-line.title {
  font-size: 18px;
  font-weight: 700;
  text-align: center;
  margin-bottom: 16px;
}

.preview-line.blank {
  height: 12px;
}

.contract-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 0.5px solid #eee;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
}

.btn-primary {
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  color: #fff;
  border-radius: 22px;
  height: 48px;
  line-height: 48px;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  border: none;
}
