<view class="contract-container">
  <view class="contract-header">
    <view class="contract-icon">📄</view>
    <view class="contract-title">租房合同模板</view>
    <view class="contract-desc">标准租房合同，下载后打印使用</view>
  </view>

  <view class="contract-preview">
    <view class="preview-title">合同预览</view>
    <view class="preview-content">
      <view class="preview-line title">房屋租赁合同</view>
      <view class="preview-line">出租方（甲方）：__________</view>
      <view class="preview-line">承租方（乙方）：__________</view>
      <view class="preview-line blank"></view>
      <view class="preview-line">一、房屋基本情况</view>
      <view class="preview-line">房屋地址：__________</view>
      <view class="preview-line">建筑面积：__________平方米</view>
      <view class="preview-line blank"></view>
      <view class="preview-line">二、租赁期限</view>
      <view class="preview-line">租赁期共____个月...</view>
      <view class="preview-line blank"></view>
      <view class="preview-line">三、租金及支付方式</view>
      <view class="preview-line">月租金：__________元</view>
      <view class="preview-line">支付方式：__________</view>
    </view>
  </view>

  <view class="contract-footer">
    <button class="btn-primary" bindtap="onDownload">下载合同模板</button>
  </view>
</view>
