<view class="guide-container">
  <!-- 头部 -->
  <view class="guide-header">
    <view class="guide-icon">📷</view>
    <view class="guide-title">全景拍摄指南</view>
    <view class="guide-subtitle">5 步拍出专业级全景照片</view>
  </view>

  <!-- 步骤列表 -->
  <view class="guide-steps">
    <view class="guide-step" wx:for="{{steps}}" wx:key="id">
      <view class="step-num">{{item.id}}</view>
      <view class="step-content">
        <view class="step-title">{{item.title}}</view>
        <view class="step-desc">{{item.desc}}</view>
        <view class="step-tips" wx:if="{{item.tips}}">
          <text class="tip-label">💡 小贴士：</text>
          <text>{{item.tips}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="guide-footer">
    <button class="btn-primary" bindtap="onGoPublish">我已了解，去发布房源</button>
  </view>
</view>
