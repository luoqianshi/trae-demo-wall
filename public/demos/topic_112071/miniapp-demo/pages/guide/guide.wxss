.guide-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100px;
}

.guide-header {
  background: linear-gradient(135deg, #3e8c6e 0%, #5aaa8a 100%);
  padding: 30px 16px 40px;
  color: #fff;
  text-align: center;
}

.guide-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.guide-title {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 6px;
}

.guide-subtitle {
  font-size: 14px;
  opacity: 0.8;
}

.guide-steps {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.guide-step {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  display: flex;
  gap: 14px;
  align-items: flex-start;
}

.step-num {
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 6px;
}

.step-desc {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8px;
}

.step-tips {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 13px;
  color: #888;
  line-height: 1.5;
}

.tip-label {
  color: #c45d3e;
  font-weight: 600;
}

.guide-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 0.5px solid #eee;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
}

.btn-primary {
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  color: #fff;
  border-radius: 22px;
  height: 48px;
  line-height: 48px;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  border: none;
}
