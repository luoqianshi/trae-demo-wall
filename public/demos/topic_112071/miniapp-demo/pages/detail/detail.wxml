<view class="detail-container">
  <!-- 图片轮播区 -->
  <swiper class="detail-swiper" indicator-dots="true" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#fff">
    <swiper-item wx:for="{{house.images}}" wx:key="*this">
      <view class="swiper-image" style="background: linear-gradient(135deg, #e8ddd5 0%, #c4b5a5 100%);">
        <image src="{{item}}" mode="aspectFill" style="width: 100%; height: 100%;"/>
      </view>
    </swiper-item>
  </swiper>

  <!-- VR 入口按钮 -->
  <view class="vr-entry" wx:if="{{house.hasVR}}" bindtap="onVRTap">
    <view class="vr-btn">
      <text class="vr-icon">▶</text>
      <text class="vr-text">点击体验全景看房</text>
    </view>
  </view>

  <!-- 房源信息 -->
  <view class="detail-section">
    <view class="detail-title">{{house.title}}</view>
    <view class="detail-price">
      <text style="font-size: 28px;">{{house.price}}</text>
      <text style="font-size: 14px; color: #999; font-weight: 400;"> 元/月</text>
    </view>
    <view class="detail-tags">
      <text class="tag tag-highlight">{{house.type}}</text>
      <text class="tag tag-highlight">{{house.decoration}}</text>
      <text class="tag" wx:for="{{house.tags}}" wx:for-item="tag" wx:key="*this" wx:if="{{index > 1}}">{{tag}}</text>
    </view>
    <view class="info-grid">
      <view class="info-item">
        <view class="info-label">面积</view>
        <view class="info-value">{{house.area}}m²</view>
      </view>
      <view class="info-item">
        <view class="info-label">户型</view>
        <view class="info-value">{{house.rooms}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">楼层</view>
        <view class="info-value">{{house.floor}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">朝向</view>
        <view class="info-value">{{house.direction}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">装修</view>
        <view class="info-value">{{house.decoration}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">入住</view>
        <view class="info-value">随时</view>
      </view>
    </view>
  </view>

  <!-- 配套设施 -->
  <view class="detail-section">
    <view class="section-title">配套设施</view>
    <view class="facility-grid">
      <view class="facility-item" wx:for="{{house.facilities}}" wx:key="*this">
        <view class="facility-icon">{{item === '停车位' ? '🚗' : item === '暖气' ? '♨️' : item === 'WiFi' ? '📶' : item === '热水器' ? '💧' : item === '厨房' ? '🍳' : item === '洗衣机' ? '🧺' : item === '空调' ? '❄️' : '📺'}}</view>
        <view class="facility-name">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 房源描述 -->
  <view class="detail-section">
    <view class="section-title">房源描述</view>
    <view class="description">{{house.description}}</view>
    <view class="landlord-row">
      <view class="landlord-avatar">{{house.landlord.avatar}}</view>
      <view class="landlord-info">
        <view class="landlord-name">{{house.landlord.name}}</view>
        <view class="landlord-meta">{{house.landlord.verified ? '✓ 已认证' : '未认证'}}</view>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 100px;"></view>
</view>

<!-- 底部操作栏 -->
<view class="detail-footer">
  <view class="footer-btn ghost" bindtap="onCollectTap">
    <text style="font-size: 20px;">{{isCollected ? '❤️' : '🤍'}}</text>
    <text style="font-size: 10px;">{{isCollected ? '已收藏' : '收藏'}}</text>
  </view>
  <view class="footer-btn secondary" bindtap="onChatTap">联系房东</view>
  <view class="footer-btn primary" bindtap="onBookTap">预定房源</view>
</view>
