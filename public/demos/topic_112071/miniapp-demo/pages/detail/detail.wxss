.detail-container {
  padding-bottom: 100px;
}

.detail-swiper {
  height: 280px;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.vr-entry {
  margin: -30px 16px 0;
  position: relative;
  z-index: 10;
}

.vr-btn {
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  border-radius: 12px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 4px 15px rgba(196, 93, 62, 0.3);
}

.vr-icon {
  width: 32px;
  height: 32px;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 14px;
}

.vr-text {
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}

.detail-section {
  background: #fff;
  padding: 16px;
  margin-bottom: 8px;
}

.detail-title {
  font-size: 18px;
  font-weight: 700;
  color: #333;
  margin-bottom: 8px;
  line-height: 1.4;
}

.detail-price {
  color: #c45d3e;
  font-weight: 700;
  margin-bottom: 12px;
}

.detail-tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  padding-top: 12px;
  border-top: 0.5px solid #f0f0f0;
}

.info-item {
  text-align: center;
}

.info-label {
  font-size: 12px;
  color: #999;
  margin-bottom: 4px;
}

.info-value {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
  margin-bottom: 12px;
}

.facility-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.facility-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.facility-icon {
  width: 40px;
  height: 40px;
  background: #f5f5f5;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.facility-name {
  font-size: 11px;
  color: #666;
}

.description {
  font-size: 14px;
  color: #666;
  line-height: 1.7;
}

.landlord-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-top: 0.5px solid #f0f0f0;
  margin-top: 12px;
}

.landlord-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 18px;
  font-weight: 600;
}

.landlord-info {
  flex: 1;
}

.landlord-name {
  font-size: 15px;
  font-weight: 600;
  color: #333;
  margin-bottom: 2px;
}

.landlord-meta {
  font-size: 12px;
  color: #999;
}

.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 0.5px solid #eee;
  padding: 8px 16px;
  padding-bottom: calc(8px + env(safe-area-inset-bottom));
  display: flex;
  gap: 12px;
  align-items: center;
  z-index: 100;
}

.footer-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 600;
}

.footer-btn.secondary {
  background: #f5f5f5;
  color: #333;
}

.footer-btn.primary {
  background: linear-gradient(135deg, #c45d3e, #e07a5f);
  color: #fff;
}

.footer-btn.ghost {
  width: 50px;
  flex: none;
  flex-direction: column;
  gap: 2px;
  background: transparent;
  font-size: 10px;
  color: #666;
  font-weight: 400;
}
