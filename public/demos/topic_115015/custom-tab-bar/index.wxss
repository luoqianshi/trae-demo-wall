.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  display: flex;
  background: #fbf9f5;
  border-top: 1rpx solid rgba(107, 78, 61, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 12rpx;
}

.tab-icon-wrap {
  width: 72rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.tab-icon-wrap-active {
  background: rgba(65, 103, 67, 0.12);
}

.tab-icon {
  font-size: 40rpx;
  opacity: 0.6;
}

.tab-icon-active {
  opacity: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #727970;
}

.tab-text-active {
  color: #416743;
  font-weight: 600;
}
