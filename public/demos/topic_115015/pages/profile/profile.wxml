<view class="container">
  <view class="profile-header">
    <view class="settings-icon" bindtap="goToSettings"><text>⚙️</text></view>
    <view class="avatar-wrap">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image src="{{userInfo.avatar}}" mode="aspectFill" class="avatar-img"></image>
        <view class="avatar-edit-hint"><text>📷</text></view>
      </button>
    </view>
    <view class="nickname-wrap">
      <input
        type="nickname"
        class="nickname-input {{userInfo.nickName ? '' : 'placeholder'}}"
        value="{{userInfo.nickName}}"
        placeholder="点击设置昵称"
        bindblur="onNicknameBlur"
        bindconfirm="onNicknameConfirm"
      />
    </view>
    <view class="signature">{{userInfo.signature}}</view>
  </view>

  <view class="stats-card">
    <view class="stat-item" wx:for="{{stats}}" wx:key="label">
      <view class="stat-value">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <view class="menu-list">
    <view
      class="menu-item"
      wx:for="{{menuItems}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goToMenu"
    >
      <view class="menu-icon"><text>{{item.icon}}</text></view>
      <view class="menu-title">{{item.title}}</view>
      <view class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
      <view class="menu-link" wx:if="{{item.linkText}}" catchtap="viewBadges">{{item.linkText}}</view>
      <view class="menu-arrow" wx:if="{{item.arrow}}">›</view>
    </view>
  </view>

  <view class="badges-section">
    <view class="badges-row">
      <view class="badge-item" wx:for="{{badges}}" wx:key="id">
        <text class="badge-icon">{{item.icon}}</text>
        <text class="badge-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="switch-account" bindtap="switchAccount">
    <text class="switch-icon">🔄</text>
    <text class="switch-text">切换账号</text>
  </view>
</view>
