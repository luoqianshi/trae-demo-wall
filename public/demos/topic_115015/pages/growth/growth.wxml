<view class="container">
  <view class="header">
    <view class="menu-icon"><text>☰</text></view>
    <view class="header-title">成长记录</view>
    <view class="search-icon"><text>🔍</text></view>
  </view>

  <view class="quote-section">
    <view class="quote-text">"万物生长，皆有定时。"</view>
  </view>

  <view class="page-title">见证生命的悄然绽放</view>

  <view class="plant-card">
    <view class="plant-avatar">
      <image src="/images/龟背竹.jpg" mode="aspectFill" class="avatar-img"></image>
      <view class="growth-badge">成长中</view>
    </view>
    <view class="plant-info">
      <view class="plant-name">{{plantName}}</view>
      <view class="plant-days">已陪伴你走过 {{days}} 天</view>
    </view>
    <view class="plant-add">+</view>
  </view>

  <view class="timeline">
    <view class="timeline-item" wx:for="{{records}}" wx:key="id">
      <view class="timeline-dot type-{{item.type}}"></view>
      <view class="timeline-content">
        <view class="timeline-header">
          <text class="timeline-date">{{item.date}}</text>
          <text class="timeline-weather">{{item.weatherIcon}} {{item.weather}}</text>
        </view>
        <view class="timeline-image-wrap">
          <image src="{{item.image}}" mode="aspectFill" class="timeline-image"></image>
        </view>
        <view class="timeline-text">{{item.content}}</view>
      </view>
    </view>
  </view>

  <view class="generate-btn" bindtap="generateVideo">
    <text>🎬</text> 生成成长视频
  </view>
  <view class="generate-tip">将你的记录编织成一段美好的回忆</view>
</view>

<view class="fab" bindtap="addRecord">
  <text>➕</text>
</view>
