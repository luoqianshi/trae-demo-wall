<view class="container">
  <view class="header">
    <view class="page-title">识草</view>
    <view class="page-subtitle">"万物静观皆自得。"</view>
  </view>

  <view wx:if="{{!hasResult && !imageUrl}}" class="upload-area" bindtap="chooseImage">
    <view class="upload-icon"><text>📷</text></view>
    <view class="upload-title">拍下你的植物</view>
    <view class="upload-desc">让我听听它在说什么</view>
  </view>

  <view wx:elif="{{hasResult}}" class="result-area">
    <view class="result-image-wrap">
      <image src="{{imageUrl}}" mode="aspectFill" class="result-image"></image>
      <view class="retry-btn" bindtap="resetImage">
        <text>↻</text>
      </view>
    </view>

    <view class="result-header">
      <view class="plant-name">{{plantName}}</view>
      <view class="plant-status status-{{status}}">{{statusText}}</view>
    </view>

    <view class="result-quote">
      <text class="quote-text">"{{result.quote}}"</text>
    </view>

    <view class="advice-section">
      <view class="advice-item">
        <view class="advice-icon"><text>💧</text></view>
        <view class="advice-content">
          <view class="advice-label">水分建议</view>
          <view class="advice-text">{{waterAdvice}}</view>
        </view>
      </view>
      <view class="advice-item">
        <view class="advice-icon"><text>☀️</text></view>
        <view class="advice-content">
          <view class="advice-label">光照建议</view>
          <view class="advice-text">{{lightAdvice}}</view>
        </view>
      </view>
    </view>

    <view class="action-btns">
      <view class="btn-primary" bindtap="addToCalendar">
        <text>📅</text> 记入日历
      </view>
      <view class="btn-secondary" bindtap="shareResult">
        <text>分享美丽</text>
      </view>
    </view>

    <view class="tip-section">
      <view class="tip-title">成长小贴士</view>
      <view class="tip-bar"></view>
      <view class="tip-content">
        <text class="tip-text">"{{tip}}"</text>
        <view class="tip-camera"><text>📷</text></view>
      </view>
    </view>
  </view>

  <view wx:else class="preview-area">
    <image src="{{imageUrl}}" mode="aspectFill" class="preview-image"></image>
    <view wx:if="{{loading}}" class="loading-overlay">
      <view class="loading-spinner"></view>
      <view class="loading-text">正在识别中...</view>
      <view class="loading-desc">让我仔细看看它的样子</view>
    </view>
    <view wx:else class="identify-btn" bindtap="identifyImage">
      <text>开始识别</text>
    </view>
  </view>

  <view class="encyclopedia-entry" bindtap="goToEncyclopedia">
    <view class="entry-content">
      <view class="entry-title">植物百科</view>
      <view class="entry-desc">探索更多植物的秘密</view>
    </view>
    <view class="entry-arrow">›</view>
  </view>
</view>
