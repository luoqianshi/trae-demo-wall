.header {
  padding-top: 20rpx;
  margin-bottom: 32rpx;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  background: #ffffff;
  border: 2rpx dashed #c2c8be;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.upload-title {
  font-size: 32rpx;
  color: #1b1c1a;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-desc {
  font-size: 26rpx;
  color: #727970;
}

.preview-area {
  position: relative;
  width: 100%;
  height: 500rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(27, 28, 26, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #7da67d;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.loading-desc {
  font-size: 24rpx;
  opacity: 0.7;
}

.identify-btn {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #416743;
  color: #ffffff;
  padding: 20rpx 64rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.result-area {
  padding-bottom: 48rpx;
}

.result-image-wrap {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.result-image {
  width: 100%;
  height: 100%;
}

.retry-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1b1c1a;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.plant-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1b1c1a;
}

.plant-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: rgba(107, 78, 61, 0.08);
}

.status-thirsty {
  background: rgba(154, 68, 45, 0.1);
  color: #9a442d;
}

.status-healthy {
  background: rgba(65, 103, 67, 0.1);
  color: #416743;
}

.status-growth {
  background: rgba(125, 86, 45, 0.1);
  color: #7d562d;
}

.status-overwater {
  background: rgba(33, 150, 243, 0.1);
  color: #1976d2;
}

.status-disease {
  background: rgba(186, 26, 26, 0.1);
  color: #ba1a1a;
}

.result-quote {
  background: rgba(107, 78, 61, 0.05);
  border-left: 4rpx solid #7da67d;
  border-radius: 0 12rpx 12rpx 0;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}

.quote-text {
  font-size: 28rpx;
  color: #6b4e3d;
  font-style: italic;
  line-height: 1.8;
}

.advice-section {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.advice-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(107, 78, 61, 0.06);
}

.advice-item:last-child {
  border-bottom: none;
}

.advice-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.advice-content {
  flex: 1;
}

.advice-label {
  font-size: 26rpx;
  color: #727970;
  margin-bottom: 6rpx;
}

.advice-text {
  font-size: 28rpx;
  color: #1b1c1a;
}

.action-btns {
  display: flex;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.action-btns .btn-primary {
  flex: 1;
}

.action-btns .btn-secondary {
  flex: 1;
}

.tip-section {
  background: #f5f3ef;
  border-radius: 20rpx;
  padding: 32rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 16rpx;
}

.tip-bar {
  height: 6rpx;
  background: linear-gradient(90deg, #7da67d 0%, #416743 100%);
  border-radius: 3rpx;
  margin-bottom: 20rpx;
  width: 100rpx;
}

.tip-content {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #6b4e3d;
  font-style: italic;
  line-height: 1.8;
}

.tip-camera {
  font-size: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.encyclopedia-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-top: 24rpx;
}

.entry-title {
  font-size: 28rpx;
  color: #1b1c1a;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: #727970;
}

.entry-arrow {
  font-size: 32rpx;
  color: #727970;
}
