.plant-image-section {
  position: relative;
  width: 100%;
  height: 500rpx;
  margin: 0 -24rpx 32rpx;
}

.plant-image {
  width: 100%;
  height: 100%;
  background: #f5f3ef;
}

.collect-btn {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #7d562d;
}

.plant-info {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
}

.plant-header {
  margin-bottom: 20rpx;
}

.plant-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 8rpx;
}

.plant-name-en {
  font-size: 26rpx;
  color: #727970;
  font-style: italic;
}

.plant-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: rgba(65, 103, 67, 0.1);
  color: #416743;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(107, 78, 61, 0.06);
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #727970;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1b1c1a;
}

.section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 16rpx;
}

.section-text {
  font-size: 28rpx;
  color: #294f2d;
  line-height: 1.8;
}

.care-list {
  background: #f5f3ef;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.care-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(107, 78, 61, 0.06);
}

.care-item:last-child {
  border-bottom: none;
}

.care-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.care-content {
  flex: 1;
}

.care-label {
  font-size: 24rpx;
  color: #727970;
  margin-bottom: 6rpx;
}

.care-text {
  font-size: 28rpx;
  color: #1b1c1a;
  line-height: 1.6;
}

.warning-section .section-title {
  color: #9a442d;
}

.warning-section .section-text {
  color: #9a442d;
  background: rgba(154, 68, 45, 0.05);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #9a442d;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.action-buttons .btn-primary {
  flex: 1;
  background: #416743;
  color: #ffffff;
  border-radius: 40rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.action-buttons .btn-secondary {
  flex: 1;
  background: #ffffff;
  color: #416743;
  border: 2rpx solid #416743;
  border-radius: 40rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}