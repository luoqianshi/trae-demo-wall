.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  margin-bottom: 16rpx;
}

.menu-icon,
.search-icon {
  font-size: 36rpx;
  color: #1b1c1a;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #416743;
}

.quote-section {
  margin-bottom: 32rpx;
}

.quote-text {
  font-size: 24rpx;
  color: #727970;
  font-style: italic;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid rgba(107, 78, 61, 0.15);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 40rpx;
}

.search-bar .search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #727970;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 24rpx;
  margin-top: 16rpx;
}

.category-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(125, 166, 125, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #1b1c1a;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  margin: 0;
}

.section-more {
  font-size: 24rpx;
  color: #727970;
}

.featured-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
  margin-bottom: 40rpx;
}

.featured-image-wrap {
  width: 260rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.featured-image {
  width: 100%;
  height: 100%;
  background: #f5f3ef;
}

.featured-info {
  flex: 1;
  padding: 24rpx;
}

.featured-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1a;
  margin-bottom: 8rpx;
}

.featured-subtitle {
  font-size: 24rpx;
  color: #727970;
}

.featured-arrow {
  padding-right: 24rpx;
  font-size: 32rpx;
  color: #416743;
}

.plant-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.plant-grid .plant-card {
  width: calc(50% - 12rpx);
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(107, 78, 61, 0.1);
}

.plant-image-wrap {
  width: 100%;
  height: 200rpx;
}

.plant-grid .plant-image {
  width: 100%;
  height: 100%;
  background: #f5f3ef;
}

.plant-grid .plant-info {
  padding: 20rpx;
}

.plant-grid .plant-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b1c1a;
  margin-bottom: 4rpx;
}

.plant-grid .plant-name-en {
  font-size: 22rpx;
  color: #727970;
  font-style: italic;
}
