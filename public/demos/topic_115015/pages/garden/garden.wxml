<view class="container">
  <view class="header">
    <view class="greeting">{{greeting}}</view>
    <view class="page-title">驼翁再世</view>
    <view class="page-subtitle">"草木有本心，何求美人折。"</view>
  </view>

  <view class="care-cards">
    <view class="care-card water-card" bindtap="goToSeason">
      <view class="care-icon">💧</view>
      <view class="care-content">
        <view class="care-label">待浇水</view>
        <view class="care-value">{{waterCount}}盆</view>
      </view>
    </view>
    <view class="care-card sun-card">
      <view class="care-icon">☀️</view>
      <view class="care-content">
        <view class="care-label">光照建议</view>
        <view class="care-value">{{sunLevel}}</view>
      </view>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">我的花园</text>
    <text class="section-more" bindtap="goToPlantList">全部 ›</text>
  </view>

  <view class="plant-card-list">
    <view class="plant-row-card" wx:for="{{plants}}" wx:key="id" data-id="{{item.id}}" bindtap="goToPlantDetail">
      <view class="plant-row-img">
        <image src="{{item.avatar}}" mode="aspectFill" class="plant-img"></image>
      </view>
      <view class="plant-row-info">
        <view class="plant-row-header">
          <text class="plant-row-name">{{item.name}}</text>
          <view class="plant-row-status status-{{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="plant-row-desc">{{item.quote}}</view>
        <view class="plant-row-footer">
          <text class="plant-row-days">{{item.days}}</text>
          <view wx:if="{{item.needWater}}" class="water-btn" catchtap="waterPlant">
            <text>💧 去浇水</text>
          </view>
          <view wx:else class="view-growth-btn">
            <text>查看成长 ›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="growth-banner" bindtap="goToGrowth">
    <view class="banner-bg"></view>
    <view class="banner-content">
      <view class="banner-label">本周成长</view>
      <view class="banner-title">新芽悄然萌发</view>
      <view class="banner-desc">将你的记录编织成一段美好的回忆</view>
    </view>
    <view class="banner-camera"><text>📷</text></view>
  </view>
</view>