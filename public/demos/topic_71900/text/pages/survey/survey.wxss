.survey-header {
  text-align: center;
  padding: 32rpx;
}

.survey-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 12rpx;
}

.survey-desc {
  display: block;
  font-size: 26rpx;
  color: #8A8A8A;
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2D2D2D, #5A5A5A);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #B0B0B0;
}

.question-container {
  margin-bottom: 20rpx;
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-number {
  width: 56rpx;
  height: 56rpx;
  background: #2D2D2D;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.question-title {
  display: block;
  font-size: 32rpx;
  color: #2D2D2D;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.options {
  padding-left: 10rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}

.option-item:active {
  transform: scale(0.98);
}

.option-item.selected {
  border-color: #2D2D2D;
  background: rgba(45, 45, 45, 0.05);
}

.option-label {
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid #DDD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background: #2D2D2D;
  border-color: #2D2D2D;
  color: white;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #2D2D2D;
  line-height: 1.5;
}

.option-check {
  width: 44rpx;
  height: 44rpx;
  background: #2D2D2D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  font-weight: bold;
  margin-left: 16rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.nav-btn.prev {
  background: #F5F5F5;
  color: #666;
}

.nav-btn.next {
  background: #2D2D2D;
  color: white;
}

.nav-btn.next.disabled {
  background: #DDD;
  color: #999;
}

.nav-btn.submit {
  background: #2D2D2D;
  color: white;
}

.nav-space {
  width: 20rpx;
}