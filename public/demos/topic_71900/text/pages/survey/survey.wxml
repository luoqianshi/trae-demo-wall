<view class="container">
  <view class="survey-header card">
    <text class="survey-title">{{survey.title}}</text>
    <text class="survey-desc">{{survey.description}}</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <text class="progress-text">{{currentIndex + 1}} / {{survey.questions.length}}</text>
  </view>

  <view class="question-container card" wx:if="{{currentQuestion}}">
    <view class="question-header">
      <text class="question-number">{{currentIndex + 1}}</text>
    </view>
    <text class="question-title">{{currentQuestion.title}}</text>

    <view class="options">
      <view 
        wx:for="{{currentQuestion.options}}" 
        wx:key="index"
        class="option-item {{currentQuestion.selected === index ? 'selected' : ''}}"
        bindtap="selectRadio"
        data-qid="{{currentQuestion.id}}"
        data-index="{{index}}"
      >
        <view class="option-label">{{['A', 'B', 'C', 'D'][index]}}</view>
        <text class="option-text">{{item}}</text>
        <view class="option-check" wx:if="{{currentQuestion.selected === index}}">✓</view>
      </view>
    </view>
  </view>

  <view class="bottom-bar safe-bottom">
    <view 
      class="nav-btn prev" 
      bindtap="prevQuestion"
      wx:if="{{currentIndex > 0}}"
    >
      <text>上一题</text>
    </view>
    <view class="nav-space" wx:if="{{currentIndex > 0}}"></view>
    <view 
      class="nav-btn next {{canNext ? '' : 'disabled'}}" 
      bindtap="nextQuestion"
      wx:if="{{currentIndex < survey.questions.length - 1}}"
    >
      <text>下一题</text>
    </view>
    <view 
      class="nav-btn submit" 
      bindtap="submitSurvey"
      wx:if="{{currentIndex === survey.questions.length - 1}}"
    >
      <text>查看结果</text>
    </view>
  </view>
</view>