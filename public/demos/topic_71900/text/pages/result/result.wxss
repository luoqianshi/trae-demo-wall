.main-card {
  text-align: center;
  padding: 60rpx 30rpx;
  margin-top: 40rpx;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 12rpx;
}

.result-animal {
  font-size: 28rpx;
  color: #8A8A8A;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D2D2D;
}

.desc-card {
  margin-bottom: 24rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #8A8A8A;
  line-height: 1.7;
  margin-bottom: 30rpx;
}

.traits-grid {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 24rpx;
}

.trait-box {
  text-align: center;
}

.trait-label {
  display: block;
  font-size: 26rpx;
  color: #B0B0B0;
  margin-bottom: 20rpx;
}

.trait-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.trait-item {
  padding: 12rpx 28rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.trait-text {
  font-size: 26rpx;
  color: #2D2D2D;
  font-weight: bold;
}

.analysis-card {
  margin-bottom: 24rpx;
}

.analysis-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.analysis-item {
  padding: 24rpx;
  border-radius: 16rpx;
}

.analysis-item.positive {
  background: #F0FFF4;
}

.analysis-item.negative {
  background: #FFF7F0;
}

.analysis-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 16rpx;
}

.analysis-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.analysis-text {
  font-size: 26rpx;
  color: #8A8A8A;
  line-height: 1.6;
}

.style-card {
  margin-bottom: 24rpx;
}

.style-info {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 24rpx;
}

.style-item {
  text-align: center;
}

.style-label {
  display: block;
  font-size: 24rpx;
  color: #B0B0B0;
  margin-bottom: 8rpx;
}

.style-value {
  font-size: 26rpx;
  color: #2D2D2D;
  font-weight: bold;
}

.tips-section {
  padding-left: 10rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
}

.tip-icon {
  font-size: 28rpx;
  color: #4CAF50;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #8A8A8A;
  line-height: 1.6;
}

.life-card {
  margin-bottom: 24rpx;
}

.life-content {
  font-size: 28rpx;
  color: #8A8A8A;
  line-height: 1.7;
}

.extra-card {
  margin-bottom: 24rpx;
}

.extra-content {
  font-size: 28rpx;
  color: #8A8A8A;
  line-height: 1.7;
}

.action-area {
  padding-bottom: 40rpx;
}

.action-area .btn-primary {
  width: 100%;
  margin-bottom: 20rpx;
  background: #2D2D2D;
}

.action-area .btn-outline {
  width: 100%;
  border-color: #2D2D2D;
  color: #2D2D2D;
}