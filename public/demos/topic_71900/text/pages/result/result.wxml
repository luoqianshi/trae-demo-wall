<view class="container">
  <view class="main-card card" style="border-top: 8rpx solid {{mainPersonality.color}};">
    <view class="result-icon">{{mainPersonality.icon}}</view>
    <text class="result-title">{{mainPersonality.name}}</text>
    <text class="result-animal">代表动物：{{mainPersonality.animal}}</text>
  </view>

  <view class="desc-card card">
    <view class="section-header">
      <text class="section-icon">🌟</text>
      <text class="section-title">性格分析</text>
    </view>
    <text class="desc-content">{{mainPersonality.description}}</text>
    
    <view class="traits-grid">
      <view class="trait-box">
        <text class="trait-label">性格特质</text>
        <view class="trait-list">
          <view class="trait-item" wx:for="{{mainPersonality.traits}}" wx:key="index">
            <text class="trait-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="analysis-card card">
    <view class="section-header">
      <text class="section-icon">⚡</text>
      <text class="section-title">优势与挑战</text>
    </view>
    
    <view class="analysis-grid">
      <view class="analysis-item positive">
        <text class="analysis-label">✨ 优势</text>
        <view class="analysis-list">
          <text class="analysis-text" wx:for="{{mainPersonality.strengths}}" wx:key="index">• {{item}}</text>
        </view>
      </view>
      <view class="analysis-item negative">
        <text class="analysis-label">💡 挑战</text>
        <view class="analysis-list">
          <text class="analysis-text" wx:for="{{mainPersonality.weaknesses}}" wx:key="index">• {{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="style-card card">
    <view class="section-header">
      <text class="section-icon">🏠</text>
      <text class="section-title">理想空间风格</text>
    </view>
    
    <view class="style-info">
      <view class="style-item">
        <text class="style-label">推荐风格</text>
        <text class="style-value">{{mainPersonality.interiorStyle}}</text>
      </view>
      <view class="style-item">
        <text class="style-label">色彩方案</text>
        <text class="style-value">{{mainPersonality.colorScheme}}</text>
      </view>
    </view>
    
    <view class="tips-section">
      <text class="tips-title">空间设计建议</text>
      <view class="tips-list">
        <view class="tip-item" wx:for="{{mainPersonality.spaceTips}}" wx:key="index">
          <text class="tip-icon">✓</text>
          <text class="tip-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="life-card card">
    <view class="section-header">
      <text class="section-icon">🌿</text>
      <text class="section-title">生活方式</text>
    </view>
    <text class="life-content">{{mainPersonality.lifeStyle}}</text>
  </view>

  <view class="extra-card card">
    <view class="section-header">
      <text class="section-icon">💼</text>
      <text class="section-title">职业适配</text>
    </view>
    <text class="extra-content">{{mainPersonality.careerFit}}</text>
  </view>

  <view class="extra-card card">
    <view class="section-header">
      <text class="section-icon">❤️</text>
      <text class="section-title">关系模式</text>
    </view>
    <text class="extra-content">{{mainPersonality.relationshipStyle}}</text>
  </view>

  <view class="action-area">
    <button class="btn-primary" bindtap="retry">再测一次</button>
    <button class="btn-outline" bindtap="share">分享结果</button>
  </view>
</view>