.hero-section {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  margin: -20rpx -20rpx 30rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFF4E6 100%);
}

.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8A8A8A;
  margin-bottom: 40rpx;
}

.sofa-illustration {
  width: 100%;
  max-width: 600rpx;
  margin: 0 auto;
}

.room-scene {
  position: relative;
  height: 400rpx;
}

.wall-art {
  position: absolute;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 100rpx;
  border: 6rpx solid #D4A574;
  border-radius: 8rpx;
}

.wall-art::before {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 30rpx;
  width: 60rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #E8D5C4;
}

.wall-art::after {
  content: '';
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  width: 40rpx;
  height: 30rpx;
  background: #D4A574;
  border-radius: 20rpx 20rpx 0 0;
}

.floor-lamp {
  position: absolute;
  right: 20rpx;
  top: 80rpx;
}

.lamp-base {
  width: 40rpx;
  height: 12rpx;
  background: #D4A574;
  border-radius: 6rpx;
  margin-left: 20rpx;
}

.lamp-pole {
  width: 8rpx;
  height: 120rpx;
  background: #D4A574;
  margin-left: 36rpx;
}

.lamp-shade {
  width: 80rpx;
  height: 50rpx;
  background: #F5E6D3;
  border-radius: 10rpx 10rpx 40rpx 40rpx;
  margin-left: 10rpx;
  margin-top: -10rpx;
}

.plant-left {
  position: absolute;
  left: 20rpx;
  bottom: 60rpx;
}

.plant-pot {
  width: 50rpx;
  height: 40rpx;
  background: #F5E6D3;
  border-radius: 0 0 25rpx 25rpx;
  border: 4rpx solid #E8D5C4;
}

.plant-leaves {
  position: relative;
  margin-top: -30rpx;
}

.leaf {
  position: absolute;
  width: 30rpx;
  height: 16rpx;
  background: #7CB342;
  border-radius: 50%;
}

.leaf-1 {
  top: -60rpx;
  left: 10rpx;
  transform: rotate(-30deg);
}

.leaf-2 {
  top: -45rpx;
  left: -5rpx;
  transform: rotate(-60deg);
}

.leaf-3 {
  top: -35rpx;
  left: 20rpx;
  transform: rotate(10deg);
}

.leaf-4 {
  top: -20rpx;
  left: -10rpx;
  transform: rotate(-80deg);
}

.leaf-5 {
  top: -10rpx;
  left: 25rpx;
  transform: rotate(20deg);
}

.sofa {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 50rpx;
}

.sofa-back {
  width: 320rpx;
  height: 80rpx;
  background: #F5E6D3;
  border-radius: 40rpx 40rpx 0 0;
  position: relative;
}

.sofa-back::before {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 80rpx;
  width: 30rpx;
  height: 40rpx;
  background: #E8D5C4;
  border-radius: 15rpx;
}

.sofa-back::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 80rpx;
  width: 30rpx;
  height: 40rpx;
  background: #E8D5C4;
  border-radius: 15rpx;
}

.sofa-seat {
  width: 340rpx;
  height: 60rpx;
  background: #F5E6D3;
  border-radius: 0 0 10rpx 10rpx;
  margin-top: -5rpx;
  margin-left: -10rpx;
}

.sofa-arm {
  width: 50rpx;
  height: 100rpx;
  background: #F5E6D3;
  position: absolute;
  top: 20rpx;
}

.sofa-arm-left {
  left: -20rpx;
  border-radius: 25rpx 0 0 25rpx;
}

.sofa-arm-right {
  right: -20rpx;
  border-radius: 0 25rpx 25rpx 0;
}

.sofa-leg {
  width: 16rpx;
  height: 25rpx;
  background: #8B6914;
  border-radius: 8rpx;
  position: absolute;
  bottom: -25rpx;
}

.sofa-leg-1 {
  left: 30rpx;
}

.sofa-leg-2 {
  left: 150rpx;
}

.sofa-leg-3 {
  right: 150rpx;
}

.sofa-leg-4 {
  right: 30rpx;
}

.sofa-cushion {
  position: absolute;
  right: 50rpx;
  top: 30rpx;
  width: 60rpx;
  height: 50rpx;
  background: #E8D5C4;
  border-radius: 30rpx;
}

.coffee-table {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 20rpx;
}

.table-top {
  width: 180rpx;
  height: 20rpx;
  background: #A0522D;
  border-radius: 4rpx;
}

.table-leg {
  width: 12rpx;
  height: 35rpx;
  background: #8B4513;
  position: absolute;
  top: 20rpx;
}

.table-leg-1 {
  left: 30rpx;
}

.table-leg-2 {
  left: 84rpx;
}

.table-leg-3 {
  right: 30rpx;
}

.table-items {
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
}

.cup {
  width: 24rpx;
  height: 24rpx;
  background: #D2691E;
  border-radius: 50%;
  position: absolute;
  left: -30rpx;
}

.cup::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 8rpx;
  background: #8B4513;
  border-radius: 4rpx;
}

.book {
  width: 30rpx;
  height: 6rpx;
  background: #FF6B6B;
  border-radius: 2rpx;
  position: absolute;
  right: -30rpx;
  top: 8rpx;
}

.book::after {
  content: '';
  position: absolute;
  top: 8rpx;
  width: 30rpx;
  height: 6rpx;
  background: #4ECDC4;
  border-radius: 2rpx;
}

.plant-right {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
}

.plant-pot-small {
  width: 35rpx;
  height: 28rpx;
  background: #F5E6D3;
  border-radius: 0 0 17rpx 17rpx;
  border: 3rpx solid #E8D5C4;
}

.plant-leaves-small {
  position: relative;
  margin-top: -20rpx;
}

.leaf-small {
  position: absolute;
  width: 22rpx;
  height: 12rpx;
  background: #8BC34A;
  border-radius: 50%;
}

.leaf-s1 {
  top: -40rpx;
  left: 6rpx;
  transform: rotate(-20deg);
}

.leaf-s2 {
  top: -25rpx;
  left: -5rpx;
  transform: rotate(-50deg);
}

.leaf-s3 {
  top: -20rpx;
  left: 15rpx;
  transform: rotate(15deg);
}

.rug {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 10rpx;
  width: 420rpx;
  height: 50rpx;
  background: #E8D5C4;
  border-radius: 25rpx;
}

.start-btn {
  width: 400rpx;
  height: 100rpx;
  background: #2D2D2D;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -50rpx auto 40rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(45, 45, 45, 0.15);
}

.start-btn:active {
  transform: scale(0.96);
  transition: transform 0.2s;
}

.btn-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.intro-card {
  text-align: center;
}

.intro-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 16rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: #8A8A8A;
  line-height: 1.7;
}

.footer {
  text-align: center;
  padding: 40rpx 0 60rpx;
  font-size: 24rpx;
  color: #B0B0B0;
}