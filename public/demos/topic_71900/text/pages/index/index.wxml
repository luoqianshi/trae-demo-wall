<view class="container">
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <text class="hero-title">家居人格测试</text>
      <text class="hero-subtitle">找到你的专属理想家居风格</text>
      
      <view class="sofa-illustration">
        <view class="room-scene">
          <view class="wall-art"></view>
          <view class="floor-lamp">
            <view class="lamp-base"></view>
            <view class="lamp-pole"></view>
            <view class="lamp-shade"></view>
          </view>
          <view class="plant-left">
            <view class="plant-pot"></view>
            <view class="plant-leaves">
              <view class="leaf leaf-1"></view>
              <view class="leaf leaf-2"></view>
              <view class="leaf leaf-3"></view>
              <view class="leaf leaf-4"></view>
              <view class="leaf leaf-5"></view>
            </view>
          </view>
          <view class="sofa">
            <view class="sofa-back"></view>
            <view class="sofa-seat"></view>
            <view class="sofa-arm sofa-arm-left"></view>
            <view class="sofa-arm sofa-arm-right"></view>
            <view class="sofa-leg sofa-leg-1"></view>
            <view class="sofa-leg sofa-leg-2"></view>
            <view class="sofa-leg sofa-leg-3"></view>
            <view class="sofa-leg sofa-leg-4"></view>
            <view class="sofa-cushion"></view>
          </view>
          <view class="coffee-table">
            <view class="table-top"></view>
            <view class="table-leg table-leg-1"></view>
            <view class="table-leg table-leg-2"></view>
            <view class="table-leg table-leg-3"></view>
            <view class="table-items">
              <view class="cup"></view>
              <view class="book"></view>
            </view>
          </view>
          <view class="plant-right">
            <view class="plant-pot-small"></view>
            <view class="plant-leaves-small">
              <view class="leaf-small leaf-s1"></view>
              <view class="leaf-small leaf-s2"></view>
              <view class="leaf-small leaf-s3"></view>
            </view>
          </view>
          <view class="rug"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="start-btn" bindtap="goToSurvey" data-id="1">
    <text class="btn-text">开始测试</text>
  </view>

  <view class="intro-card card">
    <text class="intro-title">了解你的空间性格</text>
    <text class="intro-desc">通过9个简单问题，发现你内心深处的家居人格类型，为您的空间设计提供专业参考。</text>
  </view>

  <view class="footer">
    <text>让空间成为你的延伸</text>
  </view>
</view>