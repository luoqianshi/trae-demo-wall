page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

.card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #2D2D2D;
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background: white;
  color: #2D2D2D;
  border: 2rpx solid #2D2D2D;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 12rpx;
}

.description {
  font-size: 26rpx;
  color: #8A8A8A;
  line-height: 1.6;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}