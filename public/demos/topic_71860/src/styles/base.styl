*
  margin 0
  padding 0
  box-sizing border-box

html, body, #app
  width 100%
  height 100%
  font-family $font-family
  background-color $bg-page
  -webkit-tap-highlight-color transparent

.page-container
  width 100%
  min-height 100vh
  background-color $bg-page
  position relative

.safe-bottom
  padding-bottom env(safe-area-inset-bottom, 20px)

.btn-primary
  width 100%
  height $btn-height
  background linear-gradient(135deg, $primary 0%, $primary-dark 100%)
  color $bg-white
  border none
  border-radius $radius-xl
  font-size 16px
  font-weight 500
  cursor pointer
  transition all 0.3s

  &:disabled
    background $border-dashed
    cursor not-allowed

  &:not(:disabled):active
    opacity 0.9
    transform scale(0.98)
