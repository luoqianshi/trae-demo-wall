// 颜色变量
$primary = #1677ff
$primary-dark = #0958d9
$success = #52c41a
$warning = #faad14
$danger = #f5222d
$text-primary = #333
$text-secondary = #666
$text-muted = #999
$border-color = #f0f0f0
$border-dashed = #d9d9d9
$bg-page = #f5f5f5
$bg-white = #fff

// 状态背景色
$bg-pending = #fffbe6
$bg-approved = #f6ffed
$bg-rejected = #fff2f0

// 尺寸
$nav-height = 44px
$tab-bar-height = 56px
$btn-height = 44px
$radius-sm = 4px
$radius-md = 8px
$radius-lg = 12px
$radius-xl = 22px

// 阴影
$shadow-card = 0 2px 8px rgba(0, 0, 0, 0.06)
$shadow-bar = 0 -2px 10px rgba(0, 0, 0, 0.05)

// 字体
$font-family = -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif

// 混合宏
flex-center()
  display flex
  align-items center
  justify-content center

flex-between()
  display flex
  align-items center
  justify-content space-between

nav-header()
  flex-between()
  padding 12px 16px
  background $bg-white
  border-bottom 1px solid $border-color
  position sticky
  top 0
  z-index 100

back-btn()
  font-size 28px
  color $text-primary
  cursor pointer
  width 40px

page-title()
  font-size 17px
  font-weight 600
  color $text-primary

placeholder()
  width 40px

btn-primary()
  width 100%
  height $btn-height
  background linear-gradient(135deg, $primary 0%, $primary-dark 100%)
  color $bg-white
  border none
  border-radius $radius-xl
  font-size 16px
  font-weight 500
  cursor pointer
  transition all 0.3s

  &:disabled
    background $border-dashed
    cursor not-allowed

  &:not(:disabled):active
    opacity 0.9
    transform scale(0.98)

card()
  background $bg-white
  border-radius $radius-lg
  padding 16px
  margin-bottom 12px
  box-shadow $shadow-card
